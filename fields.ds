				 map syncEmployeeIssuingFromItemIssuing(map input)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("msg","Unknown error");
                 	try 
                 	{
                 		voucher_id = input.get("Voucher");
                 		display_name_voucher = ifnull(input.get("Display_Name_Voucher"),"").trim();
                 		line_number = input.get("Line_Number");
                 		display_name_item = ifnull(input.get("Display_Name_Item"),"").trim();
                 		quantity = ifnull(input.get("Quantity"),0.0);
                 		cost = ifnull(input.get("Cost"),0.0);
                 		item_issuing_detail = ifnull(input.get("Item_Issuing_Detail"),"").toString().trim();
                 		source_record_id = input.get("Source_Record_ID");
                 		source_form = ifnull(input.get("Source_Form"),"Store Management - Item Issuing Details").trim();
                 		skip_existing = ifnull(input.get("Skip_Existing"),false);
                 		if(source_record_id == null || source_record_id.toString().trim() == "")
                 		{
                 			response.put("msg","Source_Record_ID is missing");
                 			response.put("action","error");
                 			return response;
                 		}
                 		source_record_id_num = source_record_id.toLong();
                 		rec = Employee_Issuing_Details[Source_Record_ID == source_record_id_num && Source_Form == source_form && Item_Issuing_Detail == item_issuing_detail];
                 		if(rec.ID != null)
                 		{
                 			if(skip_existing == true)
                 			{
                 				response.put("ok",true);
                 				response.put("msg","Existing Employee Issuing record skipped");
                 				response.put("action","skipped");
                 				response.put("skipped",true);
                 				response.put("Employee_Issuing_Details_ID",rec.ID);
                 				return response;
                 			}
                 			rec.Voucher=voucher_id;
                 			rec.Display_Name_Voucher=display_name_voucher;
                 			rec.Line_Number=line_number;
                 			rec.Display_Name_Item=display_name_item;
                 			rec.Quantity=quantity;
                 			rec.Cost=cost;
                 			rec.Item_Issuing_Detail=item_issuing_detail;
                 			rec.Source_Record_ID=source_record_id_num;
                 			rec.Source_Form=source_form;
                 			response.put("ok",true);
                 			response.put("msg","Updated existing Employee Issuing record");
                 			response.put("action","updated");
                 			response.put("Employee_Issuing_Details_ID",rec.ID);
                 			return response;
                 		}
                 		newRec = insert into Employee_Issuing_Details
                 		[
                 			Voucher=voucher_id
                 			Display_Name_Voucher=display_name_voucher
                 			Line_Number=line_number
                 			Display_Name_Item=display_name_item
                 			Quantity=quantity
                 			Cost=cost
                 			Item_Issuing_Detail=item_issuing_detail
                 			Source_Record_ID=source_record_id_num
                 			Source_Form=source_form
                 			Added_User=zoho.loginuser
                 		];
                 		response.put("ok",true);
                 		response.put("msg","Created missing Employee Issuing record");
                 		response.put("action","created");
                 		response.put("Employee_Issuing_Details_ID",newRec);
                 	}	catch (e)
                 	{
                 		info "syncEmployeeIssuingFromItemIssuing ERROR: " + e.toString();
                 		response.put("ok",false);
                 		response.put("msg",e.toString());
                 		response.put("action","error");
                 	}
                 	return response;
                 }
				 map syncEmployeeReceivingFromStore(map payload)
                 {
                 	resp = Map();
                 	resp.put("success",false);
                 	// ==================================================
                 	// 1. VALIDATE PAYLOAD
                 	// ==================================================
                 	if(payload == null || payload.isEmpty())
                 	{
                 		resp.put("message","Empty payload.");
                 		return resp;
                 	}
                 	source_id = ifnull(payload.get("Source_Record_ID"),"").toString().trim();
                 	// Always use one fixed sync marker
                 	source_form = "Store Management - Stock Receiving Details";
                 	voucher_id = payload.get("Voucher");
                 	if(source_id == "")
                 	{
                 		resp.put("message","Missing Source Record ID.");
                 		return resp;
                 	}
                 	if(voucher_id == null)
                 	{
                 		resp.put("message","Missing Voucher.");
                 		return resp;
                 	}
                 	// ==================================================
                 	// 2. FIND EXISTING SYNCED RECORD
                 	// ==================================================
                 	existing = Employee_Receiving_Details[Source_Record_ID == source_id && Source_Form == source_form];
                 	if(existing.ID != null)
                 	{
                 		// Update instead of just skipping
                 		existing.Voucher=voucher_id;
                 		existing.Display_Name_Voucher=ifnull(payload.get("Display_Name_Voucher"),"");
                 		existing.Line_Number=ifnull(payload.get("Line_Number"),0);
                 		existing.Display_Name_Item=ifnull(payload.get("Display_Name_Item"),"");
                 		existing.Quantity_Received=ifnull(payload.get("Quantity_Received"),0.0);
                 		existing.Stock_Receiving_Detail=ifnull(payload.get("Stock_Receiving_Detail"),"");
                 		existing.Source_Record_ID=source_id;
                 		existing.Source_Form=source_form;
                 		resp.put("success",true);
                 		resp.put("action","updated");
                 		resp.put("record_id",existing.ID);
                 		return resp;
                 	}
                 	// ==================================================
                 	// 3. CREATE NEW RECORD
                 	// ==================================================
                 	new_id = insert into Employee_Receiving_Details
                 	[
                 		Added_User=zoho.loginuser
                 		Voucher=voucher_id
                 		Display_Name_Voucher=ifnull(payload.get("Display_Name_Voucher"),"")
                 		Line_Number=ifnull(payload.get("Line_Number"),0)
                 		Display_Name_Item=ifnull(payload.get("Display_Name_Item"),"")
                 		Quantity_Received=ifnull(payload.get("Quantity_Received"),0.0)
                 		Stock_Receiving_Detail=ifnull(payload.get("Stock_Receiving_Detail"),"")
                 		Source_Record_ID=source_id
                 		Source_Form=source_form
                 	];
                 	resp.put("success",true);
                 	resp.put("action","created");
                 	resp.put("record_id",new_id);
                 	return resp;
                 }
				 map syncFreedomCityArenaVoucherTransferRegister(map input)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("msg","Unknown error");
                 	try 
                 	{
                 		case_no = ifnull(input.get("Case_Number"),"").trim();
                 		if(case_no == "")
                 		{
                 			response.put("msg","Case_Number is missing");
                 		}
                 		else
                 		{
                 			transport_dt = input.get("Transport_Date");
                 			if(transport_dt == null)
                 			{
                 				transport_dt = zoho.currenttime;
                 			}
                 			how_to_take = ifnull(input.get("How_To_Take_To_Head_Office"),"");
                 			from_site = ifnull(input.get("From_Site"),"");
                 			employee_take_name = ifnull(input.get("Employee_Taking_To_Head_Office"),"");
                 			source_record_id = input.get("Source_Record_ID");
                 			total_vouchers = ifnull(input.get("Number_Of_Vouchers"),0);
                 			if(source_record_id == null || source_record_id.toString().trim() == "")
                 			{
                 				response.put("msg","Source_Record_ID is missing");
                 			}
                 			else
                 			{
                 				source_record_id_num = source_record_id.toLong();
                 				u = thisapp.audit.getLoginAuditInfo();
                 				existingTR = Voucher_Transfer_Register[Case_Number == case_no && Source_Record_ID == source_record_id_num && Source_Form == "Freedom City Arena Management - Voucher Register"];
                 				if(existingTR.ID != null)
                 				{
                 					existingTR.Transport_Date=transport_dt;
                 					existingTR.How_To_Take_To_Head_Office=how_to_take;
                 					existingTR.From_Site=from_site;
                 					existingTR.Employee_Taking_To_Head_Office=employee_take_name;
                 					existingTR.To_Site="Freedom City Arena - Head Office";
                 					existingTR.Number_Of_Vouchers=total_vouchers;
                 					existingTR.Source_Form="Freedom City Arena Management - Voucher Register";
                 					existingTR.Source_Record_ID=source_record_id_num;
                 					existingTR.Case_Status="In Transit";
                 					existingTR.User_Name=u.get("name");
                 					existingTR.User_Email=u.get("email");
                 					existingTR.User_Role=u.get("role");
                 					existingTR.Updated_By_Name=u.get("name");
                 					existingTR.Updated_By_Email=u.get("email");
                 					existingTR.Updated_By_Time=zoho.currenttime;
                 					response.put("ok",true);
                 					response.put("msg","Updated existing transfer register");
                 					response.put("Voucher_Transfer_Register_ID",existingTR.ID);
                 				}
                 				else
                 				{
                 					insert into Voucher_Transfer_Register
                 					[
                 						Case_Number=case_no
                 						Transport_Date=transport_dt
                 						How_To_Take_To_Head_Office=how_to_take
                 						From_Site=from_site
                 						Employee_Taking_To_Head_Office=employee_take_name
                 						To_Site="Freedom City Arena - Head Office"
                 						Number_Of_Vouchers=total_vouchers
                 						Source_Form="Freedom City Arena Management - Voucher Register"
                 						Source_Record_ID=source_record_id_num
                 						Case_Status="In Transit"
                 						User_Name=u.get("name")
                 						User_Email=u.get("email")
                 						User_Role=u.get("role")
                 						Created_By_Name=u.get("name")
                 						Created_By_Email=u.get("email")
                 						Created_By_Time=zoho.currenttime
                 						Added_User=zoho.loginuser
                 					]
                 					response.put("ok",true);
                 					response.put("msg","Created transfer register");
                 				}
                 			}
                 		}
                 	}	catch (e)
                 	{
                 		response.put("ok",false);
                 		response.put("msg",e.toString());
                 	}
                 	return response;
                 }
