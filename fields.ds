                 		response.put("ok",false);
                 		response.put("msg",e.toString());
                 	}
                 	return response;
                 }
				 map syncItemIssuingFromStore(map input)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("msg","Unknown error");
                 	try 
                 	{
                 		voucher_id = input.get("Voucher");
                 		display_name_voucher = ifnull(input.get("Display_Name_Voucher"),"").trim();
                 		line_number = input.get("Line_Number");
                 		display_name_item = ifnull(input.get("Display_Name_Item"),"").trim();
                 		quantity = ifnull(input.get("Quantity"),0.0);
                 		cost = ifnull(input.get("Cost"),0.0);
                 		request_voucher = ifnull(input.get("Request_Voucher"),"").trim();
                 		source_record_id = input.get("Source_Record_ID");
                 		source_form = ifnull(input.get("Source_Form"),"Store Management - Item Issuing Details").trim();
                 		skip_existing = ifnull(input.get("Skip_Existing"),false);
                 		if(source_record_id == null || source_record_id.toString().trim() == "")
                 		{
                 			response.put("msg","Source_Record_ID is missing");
                 			response.put("action","error");
                 			return response;
                 		}
                 		source_record_id_num = source_record_id.toLong();
                 		existing = Item_Issuing_Details[Source_Record_ID == source_record_id_num && Source_Form == source_form];
                 		if(existing.ID != null)
                 		{
                 			if(skip_existing == true)
                 			{
                 				response.put("ok",true);
                 				response.put("msg","Existing item issuing detail skipped");
                 				response.put("action","skipped");
                 				response.put("skipped",true);
                 				response.put("Item_Issuing_Details_ID",existing.ID);
                 				return response;
                 			}
                 			existing.Voucher=voucher_id;
                 			existing.Display_Name_Voucher=display_name_voucher;
                 			existing.Line_Number=line_number;
                 			existing.Display_Name_Item=display_name_item;
                 			existing.Quantity=quantity;
                 			existing.Cost=cost;
                 			existing.Request_Voucher=request_voucher;
                 			existing.Source_Record_ID=source_record_id_num;
                 			existing.Source_Form=source_form;
                 			if(voucher_id != null)
                 			{
                 				thisapp.recalculateVoucherMaterialsCost(voucher_id);
                 			}
                 			response.put("ok",true);
                 			response.put("msg","Existing item issuing detail updated");
                 			response.put("action","updated");
                 			response.put("Item_Issuing_Details_ID",existing.ID);
                 			return response;
                 		}
                 		newRec = insert into Item_Issuing_Details
                 		[
                 			Voucher=voucher_id
                 			Display_Name_Voucher=display_name_voucher
                 			Line_Number=line_number
                 			Display_Name_Item=display_name_item
                 			Quantity=quantity
                 			Cost=cost
                 			Request_Voucher=request_voucher
                 			Source_Record_ID=source_record_id_num
                 			Source_Form=source_form
                 			Added_User=zoho.loginuser
                 		];
                 		if(newRec != null)
                 		{
                 			if(voucher_id != null)
                 			{
                 				thisapp.recalculateVoucherMaterialsCost(voucher_id);
                 			}
                 			response.put("ok",true);
                 			response.put("msg","Item issuing detail created");
                 			response.put("action","created");
                 			response.put("Item_Issuing_Details_ID",newRec);
                 			return response;
                 		}
                 		response.put("msg","Insert failed");
                 		response.put("action","error");
                 	}	catch (e)
                 	{
                 		info "syncItemIssuingFromStore ERROR: " + e.toString();
                 		response.put("ok",false);
                 		response.put("msg",e.toString());
                 		response.put("action","error");
                 	}
                 	return response;
                 }
				 map syncManagewiseVoucherTransferRegister(map input)
