			On_Item_Selected1 as "On Item Selected"
			{
				type =  form
				form = Stock_Sales

				record event = on add or edit

				on user input of Item
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// ON ITEM SELECTED
										// ===============================
										Reset_In_Progress = true;
										if(input.Item != null)
										{
											// 1) Display Item Name (Item Name - SKU)
											item_name = ifnull(input.Item.Item_Name,"").trim();
											sku = ifnull(input.Item.SKU,"").trim();
											if(sku != "")
											{
												sku = " - " + sku;
											}
											input.Display_Name_Item = item_name + sku;
											// 2) Set Base Unit
											if(input.Item.Base_Unit_Of_Measure != null)
											{
												input.Base_Unit_Of_Measure = input.Item.Base_Unit_Of_Measure;
												Display_Base_Unit_Of_Measure = ifnull(input.Item.Base_Unit_Of_Measure.get("Unit_Name"),"");
											}
											else
											{
												input.Base_Unit_Of_Measure = null;
												Display_Base_Unit_Of_Measure = null;
											}
											// 3) Update displayed unit dynamically based on Convert
											if(input.Convert == true && input.Unit_Of_Measure_Conversion != null)
											{
												// Show the selected conversion unit
												input.Unit_Of_Measure = ifnull(input.Unit_Of_Measure_Conversion.Display_Name_Alternate_Unit_Of_Measure + " - " + ifnull(input.Conversion_Factor,""),ifnull(input.Base_Unit_Of_Measure.get("Unit_Name"),""));
											}
											else
											{
												// Show Base Unit
												input.Unit_Of_Measure = Display_Base_Unit_Of_Measure;
											}
											// 4) Clear dependent input fields but keep conversion selection
											input.Quantity = null;
											input.Rate = null;
											input.Conversion_Factor = null;
											// Keep Unit_Of_Measure_Conversion selection for display
											input.Quantity_in_Base_Unit = null;
											input.Rate_in_Base_Unit = null;
										}
										else
										{
											// Item cleared → reset everything
											input.Display_Name_Item = null;
											input.Base_Unit_Of_Measure = null;
											Display_Base_Unit_Of_Measure = null;
											input.Unit_Of_Measure = null;
											input.Quantity = null;
											input.Rate = null;
											// Clear conversion completely
											input.Conversion_Factor = null;
											input.Unit_Of_Measure_Conversion = null;
											input.Convert = false;
											// Reset Convert toggle
											input.Quantity_in_Base_Unit = null;
											input.Rate_in_Base_Unit = null;
										}
										Reset_In_Progress = false;
						)
					}
				}

			}
			On_Base_Unit_of_Measure_S1 as "On Base Unit of Measure Selected"
			{
				type =  form
				form = Stock_Sales

				record event = on add or edit

				on user input of Base_Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											// Trigger: On user input of Unit of Measure (lookup)
										if(input.Base_Unit_Of_Measure != null)
										{
											// Access the linked record directly
											input.Unit_Of_Measure = input.Base_Unit_Of_Measure.Unit_Of_Measure_Name;
										}
										else
										{
											input.Unit_Of_Measure = "";
										}
										// ===============================
										// STOCK SALES → Handle Base & Alternate UoM
										// ===============================
										// 1) Basic checks
										if(input.Item == null || input.Base_Unit_Of_Measure == null || input.Quantity == null || input.Quantity <= 0)
										{
											//input.Quantity_in_Base_Unit = null;
											input.Rate_in_Base_Unit = null;
											// Display base UoM if item exists
											if(input.Item != null && input.Item.Base_Unit_Of_Measure != null)
											{
												Display_Base_Unit_Of_Measure = input.Item.Base_Unit_Of_Measure.Unit_Of_Measure_Name;
											}
											return;
										}
										// 2) Defaults
										conversion_factor = 1;
										is_allowed = false;
										base_uom = input.Item.Base_Unit_Of_Measure;
										// e.g., Liters
										// 3) Check if selected UoM is base
										if(input.Base_Unit_Of_Measure.get("ID") == base_uom.get("ID"))
										{
											is_allowed = true;
											conversion_factor = 1;
										}
										else
										{
											// 4) Check if Unit_of_Conversion exists
											if(input.Item.Unit_Conversion != null)
											{
												for each  row in input.Item
												{
													alt_uom = row.get("alternate_unit_of_measure");
													if(alt_uom != null && alt_uom.get("ID") == input.Base_Unit_Of_Measure.get("ID"))
													{
														is_allowed = true;
														factor = row.get("Conversion_To_Base");
														if(factor != null && factor > 0)
														{
															conversion_factor = factor;
														}
														break;
													}
												}
											}
										}
										// <<< This closes the else block properly
										// 5) Alert if UoM not allowed
										if(!is_allowed)
										{
											alert "The selected unit of measure is not valid for this item!";
											//input.Quantity_in_Base_Unit = null;
											input.Rate_in_Base_Unit = null;
											return;
										}
										// 6) Convert quantity to base unit
										//input.Quantity_in_Base_Unit = input.Quantity * conversion_factor;
										// 7) Convert rate to base unit
										if(input.Rate != null)
										{
											input.Rate_in_Base_Unit = input.Rate / conversion_factor;
										}
										else
										{
											input.Rate_in_Base_Unit = null;
										}
										// 8) Update display fields
										if(input.Base_Unit_Of_Measure != null)
										{
											input.Unit_Of_Measure = input.Base_Unit_Of_Measure.Unit_Of_Measure_Name;
										}
										if(Base_Unit_Of_Measure != null)
										{
											// input.Display_Base_Unit_Of_Measure = base_uom.Unit_Of_Measure_Name;
										}
						)
					}
				}

			}
			On_Convert_Selected as "On Convert Selected"
			{
				type =  form
				form = Stock_Sales

				record event = on add or edit

				on user input of Convert
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// ON CONVERT TOGGLE
										// ===============================
										// 1) Show/hide conversion fields and handle clearing
										if(input.Convert == true)
										{
											show Unit_Of_Measure_Conversion;
											show Conversion_Factor;
											// 2) Update displayed unit only if a conversion is picked
											if(input.Unit_Of_Measure_Conversion != null)
											{
												input.Unit_Of_Measure = ifnull(input.Unit_Of_Measure_Conversion.Display_Name_Alternate_Unit_Of_Measure + " - " + ifnull(input.Conversion_Factor.toString(),""),ifnull(input.Base_Unit_Of_Measure.get("Unit_Name"),""));
											}
											else
											{
												// Conversion cleared → restore base unit
												input.Unit_Of_Measure = ifnull(input.Base_Unit_Of_Measure.get("Unit_Name"),null);
												// Clear dependent fields
												input.Conversion_Factor = null;
												input.Quantity_in_Base_Unit = null;
												input.Rate_in_Base_Unit = null;
											}
										}
										else
										{
											// Convert toggled off → hide conversion fields, restore base unit, clear all conversion-related fields
											hide Unit_Of_Measure_Conversion;
											hide Conversion_Factor;
											// Restore base unit
											input.Unit_Of_Measure = ifnull(input.Base_Unit_Of_Measure.get("Unit_Name"),null);
											// Clear dependent fields and conversion selection
											input.Conversion_Factor = null;
											input.Unit_Of_Measure_Conversion = null;
											input.Quantity_in_Base_Unit = null;
											input.Rate_in_Base_Unit = null;
										}
										// ---------------------------
										// 3) Calculate Quantity and Rate in Base Unit
										// ---------------------------
										if(input.Quantity != null && input.Quantity > 0)
										{
											if(input.Convert == true && input.Conversion_Factor != null && input.Conversion_Factor > 0)
											{
												input.Quantity_in_Base_Unit = round(input.Quantity * input.Conversion_Factor,2);
											}
											else
											{
												input.Quantity_in_Base_Unit = round(input.Quantity,2);
											}
										}
										else
										{
											input.Quantity_in_Base_Unit = null;
										}
										if(input.Rate != null && input.Rate > 0)
										{
											if(input.Convert == true && input.Conversion_Factor != null && input.Conversion_Factor > 0)
											{
												input.Rate_in_Base_Unit = round(input.Rate / input.Conversion_Factor,2);
											}
											else
											{
												input.Rate_in_Base_Unit = round(input.Rate,2);
											}
										}
										else
										{
											input.Rate_in_Base_Unit = null;
										}
										// ---------------------------
										// 4) Update displayed unit
										// ---------------------------
										if(input.Convert == true && input.Unit_Of_Measure_Conversion != null)
										{
											input.Unit_Of_Measure = input.Unit_Of_Measure_Conversion.get("Unit_Name");
										}
										else
										{
											input.Unit_Of_Measure = ifnull(input.Base_Unit_Of_Measure.get("Unit_Name"),null);
										}
						)
					}
				}

			}
			Set_Up_Form20 as "Set Up Form"
			{
				type =  form
				form = Stock_Sales

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//HIDE FIELDS
										hide Conversion_Factor;
										hide Unit_Of_Measure_Conversion;
										hide Base_Unit_Of_Measure;
										//DISABLE FILEDS
										disable Conversion_Factor;
						)
					}
				}

			}
			On_Unit_of_Measure_Conver as "On Unit of Measure Conversion Selected"
			{
				type =  form
				form = Stock_Sales

				record event = on add or edit

				on user input of Unit_Of_Measure_Conversion
				{
					actions 
					{
						custom deluge script
						(
											// Trigger: On user input of Unit_Of_Measure_Conversion or Convert toggle
										if(input.Convert == true && input.Unit_Of_Measure_Conversion != null)
										{
											// 1) Get the conversion factor from the selected conversion record
											input.Conversion_Factor = input.Unit_Of_Measure_Conversion.Conversion_Factor;
											// 2) Update displayed unit: "Alternate Unit Name - Conversion Factor"
											input.Unit_Of_Measure = ifnull(input.Unit_Of_Measure_Conversion.Display_Name_Alternate_Unit_Of_Measure + " - " + input.Conversion_Factor.toString(),"");
										}
										else
										{
											// If Convert is false or no conversion selected, show Base Unit
											if(input.Base_Unit_Of_Measure != null)
											{
												input.Unit_Of_Measure = input.Base_Unit_Of_Measure.Unit_Of_Measure_Name;
											}
											else
											{
												input.Unit_Of_Measure = "";
											}
										}
						)
					}
				}

			}
			On_Rate_Selected3 as "On Rate Selected"
			{
				type =  form
				form = Stock_Sales

				record event = on add or edit

				on user input of Rate
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// RATE IN BASE UNIT (FINAL) — FIXED
										// ===============================
										// Only calculate if item exists and Rate is positive
										if(input.Item != null && input.Rate != null && input.Rate > 0)
										{
											if(input.Convert == true && input.Conversion_Factor != null && input.Conversion_Factor > 0)
											{
												// Convert → divide by factor
												input.Rate_in_Base_Unit = round(input.Rate / input.Conversion_Factor,2);
											}
											else
											{
												// No conversion
												input.Rate_in_Base_Unit = round(input.Rate,2);
											}
										}
										else
										{
											input.Rate_in_Base_Unit = null;
										}
						)
					}
				}

			}
			On_Quantity_Selected as "On Quantity Selected"
			{
				type =  form
				form = Stock_Sales

				record event = on add or edit

				on user input of Quantity
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// STOCK SALES → CALCULATION (Quantity )
										// ===============================
										if(input.Item == null)
										{
											// Item cleared → reset dependent fields
											input.Quantity_in_Base_Unit = null;
											input.Rate_in_Base_Unit = null;
											input.Unit_Of_Measure_Conversion = null;
											input.Conversion_Factor = null;
										}
										else
										{
											// 1) Quantity in Base Unit
											if(input.Quantity != null && input.Quantity > 0)
											{
												if(input.Convert == true && input.Conversion_Factor != null && input.Conversion_Factor > 0)
												{
													input.Quantity_in_Base_Unit = round(input.Quantity * input.Conversion_Factor,2);
												}
												else
												{
													input.Quantity_in_Base_Unit = round(input.Quantity,2);
												}
											}
											else
											{
												input.Quantity_in_Base_Unit = null;
											}
											// 2) Rate in Base Unit
											if(input.Rate != null && input.Rate > 0)
											{
												if(input.Convert == true && input.Conversion_Factor != null && input.Conversion_Factor > 0)
												{
													input.Rate_in_Base_Unit = round(input.Rate / input.Conversion_Factor,2);
												}
												else
												{
													input.Rate_in_Base_Unit = round(input.Rate,2);
												}
											}
											else
											{
												input.Rate_in_Base_Unit = null;
											}
										}
						)
					}
				}

			}
			Full_Validation19 as "Full Validation"
			{
				type =  form
				form = Stock_Sales

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// STOCK SALES → FULL VALIDATION
										// ===============================
										errors = "";
										// -------------------------------
										// 1) Item validation
										// -------------------------------
										if(input.Item == null)
										{
											errors = errors + "\n• Item is required.";
										}
										// -------------------------------
										// 2) Quantity validation
										// -------------------------------
										if(input.Quantity == null)
										{
											errors = errors + "\n• Quantity is required.";
										}
										else if(input.Quantity <= 0)
										{
											errors = errors + "\n• Quantity must be greater than 0.";
										}
										// -------------------------------
										// 3) Unit of Measure validation
										// -------------------------------
										if(input.Base_Unit_Of_Measure == null)
										{
											errors = errors + "\n• Unit of Measure is required.";
										}
										// -------------------------------
										// 4) Rate validation
										// -------------------------------
										if(input.Rate == null)
										{
											errors = errors + "\n• Rate is required.";
										}
										else if(input.Rate <= 0)
										{
											errors = errors + "\n• Rate must be greater than 0.";
										}
										// -------------------------------
										// 5) Conversion validation (ONLY if Convert = true)
										// -------------------------------
										if(input.Convert == true)
										{
											if(input.Conversion_Factor == null || input.Conversion_Factor <= 0)
											{
												errors = errors + "\n• Conversion Factor is required when Convert is selected.";
											}
											if(input.Quantity_in_Base_Unit == null || input.Quantity_in_Base_Unit <= 0)
											{
												errors = errors + "\n• Quantity in Base Unit is not calculated correctly.";
											}
											if(input.Rate_in_Base_Unit == null || input.Rate_in_Base_Unit <= 0)
											{
												errors = errors + "\n• Rate in Base Unit is not calculated correctly.";
											}
										}
										// -------------------------------
										// 6) Line Total validation
										// -------------------------------
										expected_total = 0;
										if(input.Convert == true)
										{
											expected_total = ifnull(input.Quantity_in_Base_Unit,0) * ifnull(input.Rate_in_Base_Unit,0);
										}
										else
										{
											expected_total = ifnull(input.Quantity,0) * ifnull(input.Rate,0);
										}
										if(input.Line_Total == null)
										{
											errors = errors + "\n• Line Total is missing.";
										}
										else if(abs(input.Line_Total - expected_total) > 0.01)
										{
											errors = errors + "\n• Line Total is incorrect. Please recheck calculations.";
										}
										// -------------------------------
										// 7) Final check
										// -------------------------------
										if(errors != "")
										{
											alert errors;
											cancel submit;
										}
						)
					}
				}

			}
			On_Convert_Selected1 as "On Convert Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Item_Sales.Convert
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// CONVERT
										// ===============================
										if(row.Convert == true)
										{
											show row.Unit_Of_Measure_Conversion;
											enable row.Unit_Of_Measure_Conversion;
											show row.Conversion_Factor;
											show row.Quantity_in_Base_Unit;
											show row.Rate_in_Base_Unit;
										}
										else
										{
											hide row.Unit_Of_Measure_Conversion;
											hide row.Conversion_Factor;
											hide row.Quantity_in_Base_Unit;
											hide row.Rate_in_Base_Unit;
										}
										// Ensure base unit exists
										if(row.Base_Unit_Of_Measure == null && row.Item != null)
										{
											row.Base_Unit_Of_Measure=row.Item.Base_Unit_Of_Measure;
										}
										// Convert ON
										if(row.Convert == true)
										{
											if(row.Unit_Of_Measure_Conversion != null)
											{
												row.Conversion_Factor=ifnull(row.Unit_Of_Measure_Conversion.Conversion_Factor,1);
												if(row.Unit_Of_Measure_Conversion.get("Unit_Name") != null)
												{
													row.Unit_Of_Measure=row.Unit_Of_Measure_Conversion.get("Unit_Name");
												}
												else
												{
													row.Unit_Of_Measure=null;
												}
											}
											else
											{
												row.Conversion_Factor=1;
												row.Unit_Of_Measure=null;
											}
										}
										else
										{
											row.Conversion_Factor=1;
											row.Unit_Of_Measure_Conversion=null;
											row.Quantity_in_Base_Unit=null;
											row.Rate_in_Base_Unit=null;
											if(row.Base_Unit_Of_Measure != null)
											{
												row.Unit_Of_Measure=row.Base_Unit_Of_Measure.Unit_Of_Measure_Name;
											}
											else
											{
												row.Unit_Of_Measure=null;
											}
										}
										// Quantity in base
										if(row.Quantity != null && row.Quantity > 0)
										{
											if(row.Convert == true && row.Conversion_Factor != null && row.Conversion_Factor > 0)
											{
												row.Quantity_in_Base_Unit=round(row.Quantity * row.Conversion_Factor,2);
											}
											else
											{
												row.Quantity_in_Base_Unit=round(row.Quantity,2);
											}
										}
										else
										{
											row.Quantity_in_Base_Unit=null;
										}
										// Rate in base
										if(row.Rate != null && row.Rate > 0)
										{
											if(row.Convert == true && row.Conversion_Factor != null && row.Conversion_Factor > 0)
											{
												row.Rate_in_Base_Unit=round(row.Rate / row.Conversion_Factor,2);
											}
											else
											{
												row.Rate_in_Base_Unit=round(row.Rate,2);
											}
										}
										else
										{
											row.Rate_in_Base_Unit=null;
										}
										// Line Total
										if(row.Quantity_in_Base_Unit != null && row.Rate_in_Base_Unit != null)
										{
											row.Line_Total=round(row.Quantity_in_Base_Unit * row.Rate_in_Base_Unit,2);
										}
										else
										{
											row.Line_Total=null;
										}
										// ===============================
										// RECALCULATE PARENT TOTALS
										// ===============================
										sand_total = ifnull(input.Rate_per_CBM,0) * ifnull(input.Truck_CBM,0);
										item_total = 0;
										for each  r in input.Item_Sales
										{
											item_total = item_total + ifnull(r.Line_Total,0);
										}
										input.Amount_Supposed_To_Pay_Sand_Sales = round(sand_total,2);
										input.Amount_Supposed_To_Pay_Item_Sales = round(item_total,2);
										input.Amount_Supposed_To_Pay = round(sand_total + item_total / 10000,2);
						)
					}
				}

			}
			On_Item_Selected2 as "On Item Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Item_Sales.Item
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// SUBFORM ON ITEM SELECTED
										// ===============================
										Reset_In_Progress = true;
										if(row.Item != null)
										{
											// 1) Display Item Name (Item Name - SKU)
											item_name = ifnull(row.Item.Item_Name,"").trim();
											sku = ifnull(row.Item.SKU,"").trim();
											if(sku != "")
											{
												sku = " - " + sku;
											}
											row.Display_Name_Item=item_name + sku;
											// 2) Set Base Unit
											display_base_uom = null;
											if(row.Item.Base_Unit_Of_Measure != null)
											{
												row.Base_Unit_Of_Measure=row.Item.Base_Unit_Of_Measure;
												display_base_uom = ifnull(row.Item.Base_Unit_Of_Measure.Unit_Of_Measure_Name,"");
											}
											else
											{
												row.Base_Unit_Of_Measure=null;
											}
											// 3) Set Unit + Conversion Factor
											if(row.Convert == true && row.Unit_Of_Measure_Conversion != null)
											{
												row.Conversion_Factor=ifnull(row.Unit_Of_Measure_Conversion.Conversion_Factor,1);
												row.Unit_Of_Measure=ifnull(row.Unit_Of_Measure_Conversion.Display_Name_Alternate_Unit_Of_Measure,display_base_uom);
											}
											else
											{
												// Base unit mode
												row.Convert=false;
												row.Unit_Of_Measure_Conversion=null;
												row.Conversion_Factor=1;
												row.Unit_Of_Measure=display_base_uom;
											}
											// 4) Clear dependent numeric fields
											row.Quantity=null;
											row.Rate=null;
											row.Quantity_in_Base_Unit=null;
											row.Rate_in_Base_Unit=null;
											row.Line_Total=null;
										}
										else
										{
											// Item cleared → reset but keep factor = 1
											row.Display_Name_Item=null;
											row.Base_Unit_Of_Measure=null;
											row.Unit_Of_Measure=null;
											row.Quantity=null;
											row.Rate=null;
											row.Conversion_Factor=1;
											row.Unit_Of_Measure_Conversion=null;
											row.Convert=false;
											row.Quantity_in_Base_Unit=null;
											row.Rate_in_Base_Unit=null;
											row.Line_Total=null;
										}
										Reset_In_Progress = false;
										// ===============================
										// RECALCULATE PARENT TOTALS
										// ===============================
										sand_total = ifnull(input.Rate_per_CBM,0) * ifnull(input.Truck_CBM,0);
										item_total = 0;
										for each  r in input.Item_Sales
										{
											item_total = item_total + ifnull(r.Line_Total,0);
										}
										input.Amount_Supposed_To_Pay_Sand_Sales = round(sand_total,2);
										input.Amount_Supposed_To_Pay_Item_Sales = round(item_total,2);
										input.Amount_Supposed_To_Pay = round(sand_total + item_total / 10000,2);
						)
					}
				}

			}
