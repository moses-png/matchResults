                 	if(incoming_status == "")
                 	{
                 		incoming_status = "Draft";
                 	}
                 	existing_issue = Asset_Issues[Source_Record_ID == source_record_id && Source_Form == source_form];
                 	if(existing_issue.ID != null)
                 	{
                 		existing_issue.Voucher=ifnull(p.get("Voucher"),"");
                 		existing_issue.Reported_By=ifnull(p.get("Reported_By"),"");
                 		existing_issue.Site=ifnull(p.get("Site"),"");
                 		existing_issue.Issue_Number=ifnull(p.get("Issue_Number"),"");
                 		existing_issue.Asset=p.get("Asset");
                 		existing_issue.Display_Name_Asset=ifnull(p.get("Display_Name_Asset"),"");
                 		existing_issue.Current_Site=ifnull(p.get("Current_Site"),"");
                 		existing_issue.Current_Custodian=ifnull(p.get("Current_Custodian"),"");
                 		existing_issue.Odometer_Reading=ifnull(p.get("Odometer_Reading"),0.0);
                 		existing_issue.Reported_Date=p.get("Reported_Date");
                 		existing_issue.Issue=ifnull(p.get("Issue"),"");
                 		existing_issue.Issue_Description=ifnull(p.get("Issue_Description"),"");
                 		existing_issue.Severity=ifnull(p.get("Severity"),"");
                 		existing_issue.Status=incoming_status;
                 		resp.put("ok",true);
                 		resp.put("Asset_Issue_ID",existing_issue.ID);
                 		resp.put("Source_Record_ID",source_record_id);
                 		resp.put("Status",incoming_status);
                 		resp.put("message","Asset Issue updated from Masaka Site Management.");
                 		return resp;
                 	}
                 	// -------------------------------------------------
                 	// 5) Create new Asset Issue
                 	// -------------------------------------------------
                 	new_issue_id = insert into Asset_Issues
                 	[
                 		Voucher=ifnull(p.get("Voucher"),"")
                 		Reported_By=ifnull(p.get("Reported_By"),"")
                 		Site=ifnull(p.get("Site"),"")
                 		Issue_Number=ifnull(p.get("Issue_Number"),"")
                 		Asset=p.get("Asset")
                 		Display_Name_Asset=ifnull(p.get("Display_Name_Asset"),"")
                 		Current_Site=ifnull(p.get("Current_Site"),"")
                 		Current_Custodian=ifnull(p.get("Current_Custodian"),"")
                 		Odometer_Reading=ifnull(p.get("Odometer_Reading"),0.0)
                 		Reported_Date=p.get("Reported_Date")
                 		Issue=ifnull(p.get("Issue"),"")
                 		Issue_Description=ifnull(p.get("Issue_Description"),"")
                 		Severity=ifnull(p.get("Severity"),"")
                 		Status=incoming_status
                 		Source_Record_ID=source_record_id
                 		Source_Form=source_form
                 		Added_User=zoho.loginuser
                 	];
                 	resp.put("ok",true);
                 	resp.put("Asset_Issue_ID",new_issue_id);
                 	resp.put("Source_Record_ID",source_record_id);
                 	resp.put("Status",incoming_status);
                 	resp.put("message","Asset Issue synced from Masaka Site Management.");
                 	return resp;
                 }
				 map syncMileageLogFromAssetIssue(map asset_payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	source_form = "Asset Issues";
                 	source_id = asset_payload.get("Source_Record_ID").toString();
                 	existingLogs = Asset_Mileage_Log[Odometer_Source_Form == source_form && Source_Record_ID == source_id];
                 	if(existingLogs.count() > 0)
                 	{
                 		for each  logRec in existingLogs
                 		{
                 			logRec.Asset=asset_payload.get("Asset_ID");
                 			logRec.Date_Time_Recorded=asset_payload.get("Date_Time_Recorded");
                 			logRec.Odometer_Reading=asset_payload.get("Odometer_Reading");
                 			logRec.Previous_Odometer=asset_payload.get("Previous_Odometer");
                 			logRec.Distance_Since_Last=asset_payload.get("Distance_Since_Last");
                 			logRec.Unit_of_Measure=asset_payload.get("Unit_of_Measure");
                 			logRec.Reference=asset_payload.get("Reference");
                 			logRec.Notes="Auto-updated from Asset Issue";
                 			resp.put("ok",true);
                 			resp.put("action","updated");
                 			resp.put("Asset_Mileage_Log_ID",logRec.ID);
                 			return resp;
                 		}
                 	}
                 	else
                 	{
                 		newLog = insert into Asset_Mileage_Log
                 		[
                 			Asset=asset_payload.get("Asset_ID")
                 			Date_Time_Recorded=asset_payload.get("Date_Time_Recorded")
                 			Odometer_Reading=asset_payload.get("Odometer_Reading")
                 			Previous_Odometer=asset_payload.get("Previous_Odometer")
                 			Distance_Since_Last=asset_payload.get("Distance_Since_Last")
                 			Unit_of_Measure=asset_payload.get("Unit_of_Measure")
                 			Odometer_Source_Form=source_form
                 			Source_Record_ID=source_id
                 			Reference=asset_payload.get("Reference")
                 			Notes="Auto-created from Asset Issue"
                 			Added_User=zoho.loginuser
                 		];
                 		resp.put("ok",true);
                 		resp.put("action","created");
                 		resp.put("Asset_Mileage_Log_ID",newLog);
                 		return resp;
                 	}
                 	return resp;
                 }
