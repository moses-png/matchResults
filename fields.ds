			On_Bill_Selected as "On Bill Selected"
			{
				type =  form
				form = Service_Details

				record event = on add or edit

				on user input of Bill
				{
					actions 
					{
						custom deluge script
						(
											if(input.Bill != null)
										{
											bill_rec = Bill[ID == input.Bill];
											if(bill_rec.ID != null)
											{
												input.Display_Name_Bill = bill_rec.Bill_Name + " - " + bill_rec.Bill_Number;
											}
											else
											{
												input.Display_Name_Bill = "";
											}
										}
										else
										{
											input.Display_Name_Bill = "";
										}
						)
					}
				}

			}
			On_Service_Selected as "On Service Selected"
			{
				type =  form
				form = Service_Details

				record event = on add or edit

				on user input of Service
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// ON USER INPUT: SERVICE
										// =====================================
										if(input.Service != null)
										{
											input.Display_Name_Service = ifnull(input.Service.Service_Name,"");
										}
										else
										{
											input.Display_Name_Service = "";
										}
						)
					}
				}

			}
