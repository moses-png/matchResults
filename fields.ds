										input.Updated_By_Time = zoho.currenttime;
										if(input.Resolve_Issue != true && input.Cancel_Work_Order != true)
										{
											if(input.Work_Order_Date == null)
											{
												input.Work_Order_Date = zoho.currenttime;
											}
											mile_log_resp = asset_management.logMileageFromKicks_Klean_Ug(input.Asset.ID,input.Odometer_Reading,input.Reported_Date,input.Issue_Number,"Asset Issues",input.ID.toString());
										}
						)
					}
				}

			}
			Set_Up_Form17 as "Set Up Form"
			{
				type =  form
				form = Asset_Issues

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable Voucher;
										disable Reported_By;
										disable Site;
										disable Current_Site;
										disable Current_Custodian;
										disable Number_Of_Work_Order_Tasks;
										disable Total_Service_Task_Cost;
										disable Display_Name_Asset;
										disable Issue_Status;
										disable Labour_Total;
										disable Parts_Total;
										disable Issue_Number;
										disable Work_Order_Number;
										disable Work_Order_Date;
										disable Overall_End_Date;
										disable Overall_Start_Date;
										disable Odometer_Reading_Ended;
										disable Odometer_Reading_Started;
										disable Work_Order_Status;
										disable Reported_Date;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										//HIDE FIELDS
										hide Voucher;
										hide Site;
										hide Number_Of_Work_Order_Tasks;
										hide Total_Service_Task_Cost;
										hide Display_Name_Asset;
										hide Material_Request_Vouchers;
										hide Work_Order_Tasks;
										hide Reported_By;
										hide Current_Site;
										hide Current_Custodian;
										hide Issue_Status;
										hide Reason_Why_Cancelled;
										hide Reason_Why_Resolved;
										hide Display_Name_Work_Order_in_Charge_Of;
										//hide Issue_Number;
										hide Back_End;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// -------- CREATE MODE --------
										if(input.ID == null)
										{
											hide Work_Order;
											hide Issue_Status1;
											hide Resolve_Issue;
											hide Reason_Why_Resolved;
											hide Work_Order_Number;
											hide Work_Order_Date;
											hide Work_Order_in_Charge_Of;
											hide Work_Order_Odometer_Reading;
											hide Work_Order_Status;
											hide Cancel_Work_Order;
											hide Reason_Why_Cancelled;
											hide Overall_Start_Date;
											hide Overall_End_Date;
											hide Odometer_Reading_Started;
											hide Odometer_Reading_Ended;
											if(isNull(input.Number_Of_Work_Order_Tasks))
											{
												input.Number_Of_Work_Order_Tasks = 0;
											}
											if(isNull(input.Total_Service_Task_Cost))
											{
												input.Total_Service_Task_Cost = 0.0;
											}
											if(input.Asset != null)
											{
												input.Display_Name_Asset = ifnull(input.Asset.Display_Name_Asset_Name,"");
											}
											else
											{
												input.Display_Name_Asset = "";
											}
										}
										else
										{
											show Work_Order;
											show Issue_Status1;
											show Work_Order_Odometer_Reading;
											show Resolve_Issue;
											show Work_Order_Number;
											show Work_Order_Date;
											show Work_Order_in_Charge_Of;
											show Work_Order_Status;
											show Cancel_Work_Order;
											show Overall_Start_Date;
											show Overall_End_Date;
											show Odometer_Reading_Started;
											show Odometer_Reading_Ended;
											show Current_Site;
											show Current_Custodian;
											show Issue_Status;
											disable Employee_Voucher;
											disable Issue_Description;
											disable Odometer_Reading;
											disable Issue;
											disable Severity;
											disable Asset;
											if(input.Resolve_Issue == true)
											{
												show Reason_Why_Resolved;
											}
											else
											{
												hide Reason_Why_Resolved;
											}
											hide Reason_Why_Cancelled;
											if((input.Asset != null && input.Display_Name_Asset == null) || input.Display_Name_Asset == "")
											{
												input.Display_Name_Asset = ifnull(input.Asset.Display_Name_Asset_Name,"");
											}
										}
										// ==================================
										// SYNC DETAILS — ON LOAD
										// ==================================
										hide Sync_Details;
										if(input.Asset != null && ifnull(input.Asset.Odometer_Unit_Of_Measure,"").trim().toLowerCase() == "days")
										{
											reported_day = zoho.currentdate;
											if(input.Reported_Date != null)
											{
												reported_day = input.Reported_Date.toDate();
											}
											odo_resp = asset_management.mileage.get_days_odometer_readings(input.Asset.ID,reported_day);
											if(odo_resp != null && odo_resp.get("ok") == true)
											{
												input.Odometer_Reading = ifnull(odo_resp.get("reported_odometer"),0.0);
												input.Work_Order_Odometer_Reading = ifnull(odo_resp.get("current_odometer"),0.0);
											}
											else
											{
												input.Odometer_Reading = 0.0;
												input.Work_Order_Odometer_Reading = 0.0;
												info odo_resp;
											}
											disable Odometer_Reading;
											disable Work_Order_Odometer_Reading;
										}
										else
										{
											enable Odometer_Reading;
											enable Work_Order_Odometer_Reading;
										}
						)
					}
				}

			}
			On_Asset_Selected as "On Asset Selected"
