			On_Item_Selected as "On Item Selected"
			{
				type =  form
				form = Parts_Consumables

				record event = on add or edit

				on user input of Item
				{
					actions 
					{
						custom deluge script
						(
											if(input.Item != null)
										{
											// Optional: force this row to be an Item row only
											input.Labour = null;
											input.Display_Name_Item_Labour = ifnull(input.Item.Item_Name,"");
											// NEW: default Unit Cost from Store Management → Items.Default_Cost
											default_cost = ifnull(input.Item.Default_Cost,null);
											if(default_cost != null)
											{
												input.Unit_Cost = default_cost;
											}
										}
										else
										{
											// If Item cleared, fall back to Labour if present
											if(input.Labour != null)
											{
												input.Display_Name_Item_Labour = ifnull(input.Labour.Labour_Name,"");
											}
											else
											{
												input.Display_Name_Item_Labour = "";
												// Optional: also clear Unit Cost if neither Item nor Labour is selected
												input.Unit_Cost = null;
											}
										}
						)
					}
				}

			}
