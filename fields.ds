											input.Site_Location_From = null;
											input.Pick_Up_From = "";
											input.Material_Cost = 0.0;
										}
										// =====================================================
										// CALCULATE LINE TOTAL
										// =====================================================
										input.Line_Total = round(ifnull(input.Material_Cost,0.0) + ifnull(input.Service_Cost,0.0) + ifnull(input.Fuel_Cost,0.0) + ifnull(input.Labour_Cost,0.0),2);
										// =====================================================
										// CALCULATE COST PER ODOMETER
										// =====================================================
										distance_travelled = ifnull(input.Line_Distance_Travelled,0.0);
										if(distance_travelled > 0)
										{
											input.Cost_Per_Odometer = round(input.Line_Total / distance_travelled,2);
										}
										else
										{
											input.Cost_Per_Odometer = 0.0;
										}
						)
					}
				}

			}
			On_Odometer_End_Selected2 as "On Odometer End Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Odometer_End
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ON ODOMETER END SELECTED
										// =====================================================
										if(input.Odometer_End != null)
										{
											if(input.Odometer_Start == null)
											{
												alert "Please enter Odometer Start first.";
												input.Odometer_End = null;
												input.Line_Distance_Travelled = 0.0;
											}
											else
											{
												distance = input.Odometer_End - input.Odometer_Start;
												if(distance < 0)
												{
													alert "Odometer End cannot be less than Odometer Start.";
													input.Odometer_End = null;
													input.Line_Distance_Travelled = 0.0;
												}
												else
												{
													input.Line_Distance_Travelled = round(distance,2);
												}
											}
										}
										else
										{
											input.Line_Distance_Travelled = 0.0;
										}
										// =====================================================
										// LINE TOTAL
										// =====================================================
										input.Line_Total = round(ifnull(input.Material_Cost,0.0) + ifnull(input.Service_Cost,0.0) + ifnull(input.Fuel_Cost,0.0) + ifnull(input.Labour_Cost,0.0),2);
										// =====================================================
										// COST PER ODOMETER
										// =====================================================
										if(ifnull(input.Line_Distance_Travelled,0.0) > 0)
										{
											input.Cost_Per_Odometer = round(input.Line_Total / input.Line_Distance_Travelled,2);
										}
										else
										{
											input.Cost_Per_Odometer = 0.0;
										}
						)
					}
				}

			}
			On_Odometer_Start_Selecte2 as "On Odometer Start Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Time_Start
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ON ODOMETER START SELECTED
										// =====================================================
										// =====================================================
										// 1. CALCULATE DISTANCE TRAVELLED
										// =====================================================
										if(input.Odometer_Start != null)
										{
											if(input.Odometer_End == null)
											{
												input.Line_Distance_Travelled = 0.0;
											}
											else
											{
												distance = input.Odometer_End - input.Odometer_Start;
												if(distance < 0)
												{
													alert "Odometer End cannot be less than Odometer Start.";
													input.Odometer_End = null;
													input.Line_Distance_Travelled = 0.0;
												}
												else
												{
													input.Line_Distance_Travelled = round(distance,2);
												}
											}
										}
										else
										{
											input.Line_Distance_Travelled = 0.0;
										}
										// =====================================================
										// 2. CALCULATE LINE TOTAL
										// =====================================================
										material_cost = ifnull(input.Material_Cost,0.0);
										service_cost = ifnull(input.Service_Cost,0.0);
										fuel_cost = ifnull(input.Fuel_Cost,0.0);
										labour_cost = ifnull(input.Labour_Cost,0.0);
										line_total = material_cost + service_cost + fuel_cost + labour_cost;
										input.Line_Total = round(line_total,2);
										// =====================================================
										// 3. CALCULATE COST PER ODOMETER
										// =====================================================
										distance_travelled = ifnull(input.Line_Distance_Travelled,0.0);
										if(distance_travelled > 0)
										{
											input.Cost_Per_Odometer = round(input.Line_Total / distance_travelled,2);
										}
										else
										{
											input.Cost_Per_Odometer = 0.0;
										}
						)
					}
				}

			}
			On_Party_From_Selected as "On Party From Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Party_From
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PARTY FROM
										// =====================================================
										if(input.Party_From != null)
										{
											customerName = ifnull(input.Party_From.Customer_Name,"").toString().trim();
											customerCode = ifnull(input.Party_From.Customer_Code,"").toString().trim();
											if(customerName != "" && customerCode != "")
											{
												input.Display_Name_Party_From = customerName + " - " + customerCode;
											}
											else if(customerName != "")
											{
												input.Display_Name_Party_From = customerName;
											}
											else if(customerCode != "")
											{
												input.Display_Name_Party_From = customerCode;
											}
											else
											{
												input.Display_Name_Party_From = "";
											}
											if(input.Party_Location_From != null)
											{
												locationName = ifnull(input.Party_Location_From.Location_Name,"").toString().trim();
												if(input.Display_Name_Party_From != "" && locationName != "")
												{
													input.Pick_Up_From = input.Display_Name_Party_From + " - " + locationName;
												}
												else if(input.Display_Name_Party_From != "")
												{
													input.Pick_Up_From = input.Display_Name_Party_From;
												}
												else
												{
													input.Pick_Up_From = locationName;
												}
											}
											else
											{
												input.Pick_Up_From = input.Display_Name_Party_From;
											}
										}
										else
										{
											input.Display_Name_Party_From = "";
											input.Party_Location_From = null;
											input.Pick_Up_From = "";
										}
						)
					}
				}

			}
			On_Document_Source_Select1 as "On Document Source Selected"
			{
				type =  form
				form = Asset_Transfer_Multiple_Voucher

				record event = on add or edit

				on user input of Document_Source
				{
					actions 
					{
						custom deluge script
						(
											input.Employee_Voucher = null;
										input.Asset_Transfer_Voucher = null;
										hide Asset_Transfer_Voucher;
										hide Employee_Voucher;
										if(input.Document_Source == "Employee Management")
										{
											show Asset_Transfer_Voucher;
										}
										else if(input.Document_Source == "Freedom City Management")
										{
											show Employee_Voucher;
