			On_Voucher_Type_Selected as "On Voucher Type Selected"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on user input of Voucher_Type
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// ON USER INPUT: Voucher_Type
										// ========================================
										if(input.Voucher_Type == null)
										{
											return;
										}
										voucherType = ifnull(input.Voucher_Type.Voucher_Type,"").trim();
