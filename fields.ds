				 string account.getCashAccountByEmployee(string employee_name)
                 {
                 	acc = Account[Account_Name == employee_name];
                 	if(acc.ID != null)
                 	{
                 		return acc.ID.toString();
                 	}
                 	return "";
                 }
				 map audit.getLoginAuditInfo()
                 {
                 	info = Map();
                 	info.put("name",zoho.loginuser);
                 	info.put("email",zoho.loginuserid);
                 	// role is optional (in case you add it later)
                 	try 
                 	{
                 		info.put("role",thisapp.permissions.roleForUser(zoho.loginuserid));
                 	}	catch (e)
                 	{
                 		info.put("role",thisapp.permissions.loginUserProfile());
                 	}
                 	return info;
                 }
				 map cashreceipt.createCashReceiptFromEmployeesoln(map payload)
                 {
                 	if(payload == null)
                 	{
                 		return {"ok":false,"msg":"payload is null"};
                 	}
                 	ref = ifnull(payload.get("Reference"),"");
                 	amt = ifnull(payload.get("Amount_Paid"),0).toDecimal();
                 	dt = payload.get("Payment_Date");
                 	grp = payload.get("Group");
                 	// NEW: Account comes from payload and maps to Display_Name_Account_Receiving
                 	acct = ifnull(payload.get("Account"),"");
                 	// default if missing
                 	if(ref == "" || amt <= 0 || dt == null)
                 	{
                 		return {"ok":false,"msg":"Missing/invalid values: Reference, Amount_Paid, or Payment_Date"};
                 	}
                 	// account required (since you want Display_Name_Account_Receiving = Account)
                 	if(acct == "")
                 	{
                 		return {"ok":false,"msg":"Missing/invalid value: Account"};
                 	}
                 	// Prevent duplicates by reference
                 	existing = Cash_Receipt_Details[Display_Name_Cash_Receipt_Voucher == ref];
                 	if(existing.count() > 0)
                 	{
                 		return {"ok":true,"msg":"Already exists","id":existing.ID};
                 	}
                 	newRec = insert into Cash_Receipt_Details
                 	[
                 		Display_Name_Cash_Receipt_Voucher=ref
                 		Amount_Received=amt
                 		Cash_Receipt_Date=dt
                 		Display_Name_Group=grp
                 		Added_User=zoho.loginuser
                 	];
                 	accRec = Account[Account_Name == acct];
                 	account_updated = false;
                 	new_credit = 0;
                 	if(accRec.count() > 0)
                 	{
                 		current_credit = ifnull(accRec.Total_Credit,0).toDecimal();
                 		new_credit = current_credit + amt;
                 		accRec.Total_Credit=new_credit;
                 		account_updated = true;
                 	}
                 	return {"ok":true,"id":newRec,"group":grp,"account":acct,"account_updated":account_updated,"new_total_credit":new_credit};
                 }
				 map cashreceipt.createCashReceiptFromPayment(map payload)
                 {
                 	if(payload == null)
                 	{
                 		return {"ok":false,"msg":"payload is null"};
                 	}
                 	ref = ifnull(payload.get("Reference"),"");
                 	amt = ifnull(payload.get("Amount_Paid"),0).toDecimal();
                 	dt = payload.get("Payment_Date");
                 	grp = ifnull(payload.get("Group"),"U");
                 	// default if missing
                 	if(amt <= 0 || dt == null)
                 	{
                 		return {"ok":false,"msg":"Missing/invalid values: Reference, Amount_Paid, or Payment_Date"};
                 	}
                 	// Prevent duplicates by reference
                 	// 	existing = Cash_Receipt[Reference_Number == ref];
                 	// 	if(existing.count() > 0)
                 	// 	{
                 	// 		return {"ok":true,"msg":"Already exists","id":existing.ID};
                 	// 	}
                 	newRec = insert into Cash_Receipt_Details
                 	[
                 		Display_Name_Cash_Receipt_Voucher=ref
                 		Amount_Received=amt
                 		Cash_Receipt_Date=dt
                 		Display_Name_Group=grp
                 		Added_User=zoho.loginuser
                 	];
                 	return {"ok":true,"id":newRec,"group":grp};
                 }
				 map cashreceipt.create_cash_receipt_from_payment_received(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("cash_receipt_voucher_id",null);
                 	resp.put("cash_receipt_details_id",null);
                 	payment_received_id = payload.get("payment_received_id");
                 	source_form_text = "Payment Received";
                 	if(payment_received_id == null)
                 	{
                 		resp.put("msg","Payment Received ID missing.");
                 		return resp;
                 	}
                 	payment_type = ifnull(payload.get("payment_type"),"").trim();
                 	if(payment_type == "Credit")
                 	{
                 		resp.put("msg","Credit payment. No Cash Receipt created.");
                 		return resp;
                 	}
                 	receipt_ref = ifnull(payload.get("receipt_ref"),"").trim();
                 	amount_received = ifnull(payload.get("amount_received"),0.0);
                 	account_receiving_id = payload.get("account_receiving_id");
                 	receipt_date = payload.get("payment_date");
                 	if(receipt_ref == "" || amount_received <= 0 || account_receiving_id == null)
                 	{
                 		resp.put("msg","Missing receipt reference, amount, or account.");
                 		return resp;
                 	}
                 	crv_id = null;
                 	crd_id = null;
                 	existing_voucher = Cash_Receipt_Voucher[Cash_Receipt_Number == receipt_ref];
                 	if(existing_voucher.count() > 0)
                 	{
                 		for each  crv in existing_voucher
                 		{
                 			crv.Cash_Receipt_Date=receipt_date;
                 			crv.Description=payload.get("description");
                 			crv.Account_Receiving=account_receiving_id;
                 			crv_id = crv.ID;
                 			break;
                 		}
                 	}
                 	else
                 	{
                 		crv_id = insert into Cash_Receipt_Voucher
                 		[
                 			Cash_Receipt_Number=receipt_ref
                 			Cash_Receipt_Date=receipt_date
                 			Description=payload.get("description")
                 			Account_Receiving=account_receiving_id
                 			Total_Amount_Received=0.0
                 			Total_Amount_Allocated=0.0
                 			Total_Amount_Not_Allocated=0.0
                 			Payment_Receipt_Voucher_Status="Unassigned"
                 			Added_User=zoho.loginuser
                 		];
                 	}
                 	// =====================================
                 	// FIND GROUP USING SITE
                 	// =====================================
                 	group_id = null;
                 	display_group = "";
                 	site_name = ifnull(payload.get("display_name_site"),"").trim();
                 	if(site_name != "")
                 	{
                 		group_rec = Group[Display_Name_Asset == site_name];
                 		if(group_rec.ID != null)
                 		{
                 			group_id = group_rec.ID;
                 			display_group = group_rec.Group_Number;
                 		}
                 	}
                 	existing_detail = Cash_Receipt_Details[Source_Record_ID == payment_received_id && Source_Form == source_form_text];
                 	if(existing_detail.count() > 0)
                 	{
                 		for each  crd in existing_detail
                 		{
                 			crd.Cash_Receipt_Voucher=crv_id;
                 			crd.Display_Name_Cash_Receipt_Voucher=receipt_ref;
                 			crd.Cash_Receipt_Date=receipt_date;
                 			crd.Line_Number=1;
                 			crd.System="Sales Management";
                 			crd.Sales_Voucher=payload.get("sales_voucher_id");
                 			crd.Invoice_Number=payload.get("invoice_number");
                 			crd.Amount_Due=payload.get("amount_due");
                 			crd.Amount_Received=amount_received;
                 			crd.Current_Site=payload.get("display_name_site");
                 			crd.Account=payload.get("display_name_site");
                 			// Fill Group fields
                 			crd.Group=group_id;
                 			crd.Display_Name_Group=display_group;
                 			crd.Source_Record_ID=payment_received_id;
                 			crd.Source_Form=source_form_text;
                 			crd_id = crd.ID;
                 			break;
                 		}
                 	}
                 	else
                 	{
                 		crd_id = insert into Cash_Receipt_Details
                 		[
                 			Cash_Receipt_Voucher=crv_id
                 			Display_Name_Cash_Receipt_Voucher=receipt_ref
                 			Cash_Receipt_Date=receipt_date
                 			Line_Number=1
                 			System="Sales Management"
                 			Sales_Voucher=payload.get("sales_voucher_id")
                 			Invoice_Number=payload.get("invoice_number")
                 			Amount_Due=payload.get("amount_due")
                 			Amount_Received=amount_received
                 			Current_Site=payload.get("display_name_site")
                 			Account=payload.get("display_name_site")
                 			Group=group_id
                 			Display_Name_Group=display_group
                 			Source_Record_ID=payment_received_id
                 			Source_Form=source_form_text
                 			Added_User=zoho.loginuser
                 		];
                 	}
                 	total_received = 0.0;
                 	all_details = Cash_Receipt_Details[Cash_Receipt_Voucher == crv_id];
                 	for each  d in all_details
                 	{
                 		total_received = total_received + ifnull(d.Amount_Received,0.0);
                 	}
                 	crv_total = Cash_Receipt_Voucher[ID == crv_id];
                 	if(crv_total.ID != null)
                 	{
                 		crv_total.Total_Amount_Received=total_received;
                 		crv_total.Total_Amount_Allocated=total_received;
                 		crv_total.Total_Amount_Not_Allocated=0.0;
                 		if(total_received > 0)
                 		{
                 			crv_total.Payment_Receipt_Voucher_Status="Fully Assigned";
                 		}
                 		else
                 		{
                 			crv_total.Payment_Receipt_Voucher_Status="Unassigned";
                 		}
                 	}
                 	resp.put("ok",true);
                 	resp.put("msg","Cash Receipt created/updated.");
                 	resp.put("cash_receipt_voucher_id",crv_id);
                 	resp.put("cash_receipt_details_id",crd_id);
                 	return resp;
                 }
				 map group.update_group_expense_from_sales_voucher(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	site_name = ifnull(payload.get("display_name_site"),"").trim();
                 	source_group = ifnull(payload.get("sales_type"),"").trim();
                 	payment_date = payload.get("payment_date");
                 	amount_to_receive = ifnull(payload.get("amount_to_receive"),0.0);
                 	if(payment_date == null)
                 	{
                 		payment_date = zoho.currentdate;
                 	}
                 	group_rec = Group[Display_Name_Asset == site_name];
                 	if(group_rec.ID == null)
                 	{
                 		resp.put("msg","No Group found for site.");
                 		return resp;
                 	}
                 	existing = Group_Accounts[Group == group_rec.ID && Payment_Date == payment_date && Source_Group == source_group];
                 	if(existing.ID != null)
                 	{
                 		existing.Amount_to_Receive=amount_to_receive;
                 	}
                 	else
                 	{
                 		insert into Group_Accounts
                 		[
                 			Payment_Date=payment_date
                 			Group=group_rec.ID
                 			Source_Group=source_group
                 			Amount_to_Receive=amount_to_receive
                 			Amount_Actually_Received=0.0
                 			Added_User=zoho.loginuser
                 		]
                 	}
                 	resp.put("ok",true);
                 	return resp;
                 }
				 map group.update_group_expense_from_store_bill(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	group_id = payload.get("group_id");
                 	source_group = ifnull(payload.get("source_group"),"Store Purchases").trim();
                 	payment_date = payload.get("payment_date");
                 	amount_to_pay = round(ifnull(payload.get("amount_to_pay"),0.0),2);
                 	if(payment_date == null)
                 	{
                 		payment_date = zoho.currentdate;
                 	}
                 	if(group_id == null)
                 	{
                 		resp.put("msg","Group is missing.");
                 		return resp;
                 	}
                 	group_rec = Group[ID == group_id];
                 	if(group_rec.ID == null)
                 	{
                 		resp.put("msg","No Group found.");
                 		return resp;
                 	}
                 	existing = Group_Accounts[Group == group_rec.ID && Payment_Date == payment_date && Source_Group == source_group];
                 	if(existing.ID != null)
                 	{
                 		existing.Amount_to_Pay=round(ifnull(existing.Amount_to_Pay,0.0) + amount_to_pay,2);
                 	}
                 	else
                 	{
                 		insert into Group_Accounts
                 		[
                 			Payment_Date=payment_date
                 			Group=group_rec.ID
                 			Source_Group=source_group
                 			Amount_to_Pay=amount_to_pay
                 			Amount_Actually_Paid=0.0
                 			Added_User=zoho.loginuser
                 		]
                 	}
                 	resp.put("ok",true);
                 	return resp;
                 }
				 map group.update_group_income_from_payment_received(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	site_name = ifnull(payload.get("display_name_site"),"").trim();
                 	sales_type = ifnull(payload.get("sales_type"),"").trim();
                 	amount_actual_received = ifnull(payload.get("amount_actual_received"),0.0);
                 	payment_date = payload.get("payment_date");
                 	if(site_name == "")
                 	{
                 		resp.put("msg","Site missing.");
                 		return resp;
                 	}
                 	if(sales_type == "")
                 	{
                 		resp.put("msg","Sales Type missing.");
                 		return resp;
                 	}
                 	if(payment_date == null)
                 	{
                 		payment_date = zoho.currentdate;
                 	}
                 	group_rec = Group[Display_Name_Asset == site_name];
                 	if(group_rec.ID == null)
                 	{
                 		resp.put("msg","No Group found for site.");
                 		return resp;
                 	}
                 	existing_group_exp = Group_Accounts[Group == group_rec.ID && Payment_Date == payment_date && Source_Group == sales_type];
                 	if(existing_group_exp.ID != null)
                 	{
                 		existing_group_exp.Amount_Actually_Received=amount_actual_received;
                 	}
                 	else
                 	{
                 		insert into Group_Accounts
                 		[
                 			Payment_Date=payment_date
                 			Group=group_rec.ID
                 			Source_Group=sales_type
                 			Amount_to_Receive=0.0
                 			Amount_Actually_Received=amount_actual_received
                 			Added_User=zoho.loginuser
                 		]
                 	}
                 	resp.put("ok",true);
                 	resp.put("msg","Group Expenses actual received updated.");
                 	return resp;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Set_Up_Form as "Set Up Form"
			{
				type =  form
				form = Account

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ==============================
										// HIDE / SHOW SECTIONS
										// ==============================
										hide Transactions;
										hide Back_End;
										if(input.ID == null)
										{
											hide Available_List;
											hide Transaction_Log;
											hide Account_Users;
										}
										// ==============================
										// LOCK ACCOUNT TOTAL FIELDS
										// ==============================
										disable Total_Credit;
										disable Total_Debit;
										disable Current_Balance;
										disable Unconfirmed_Total_Credit;
										disable Unconfirmed_Total_Debit;
										disable Unconfirmed_Total_Amount;
										// ==============================
										// CALCULATE CURRENT BALANCE
										// ==============================
										opening_bal = ifnull(input.Opening_Balance,0.0);
										input.Current_Balance = opening_bal + ifnull(input.Total_Debit,0.0) - ifnull(input.Total_Credit,0.0);
										// ==============================
										// AVAILABLE LIST SUBFORM
										// ==============================
										disable Available_List.Display_Name_List;
										disable Available_List.Display_Name_Account;
										// ==============================
										// TRANSACTION LOG SUBFORM
										// ==============================
										hide Transaction_Log.Display_Name_Account;
										hide Transaction_Log.Reference_Type;
										hide Transaction_Log.Balance_Before;
										disable Transaction_Log.Transaction_Type;
										disable Transaction_Log.Display_Name_Account;
										disable Transaction_Log.Application;
										disable Transaction_Log.Transaction_Date;
										disable Transaction_Log.Source_Form;
										disable Transaction_Log.Source_Record_ID;
										disable Transaction_Log.Reference_Number;
										disable Transaction_Log.Amount;
										disable Transaction_Log.Balance_After;
										// ==============================
										// TRANSACTION LOG BACK END
										// ==============================
										hide Transaction_Log.User_Name;
										hide Transaction_Log.User_Email;
										hide Transaction_Log.User_Role;
										hide Transaction_Log.Created_By_Name;
										hide Transaction_Log.Created_By_Email;
										hide Transaction_Log.Created_By_Time;
										hide Transaction_Log.Updated_By_Name;
										hide Transaction_Log.Updated_By_Email;
										hide Transaction_Log.Updated_By_Time;
										// ==============================
										// LOGIN AUDIT INFO
										// ==============================
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			On_Account_Name_Selected as "On Account Name Selected"
			{
				type =  form
				form = Account

				record event = on add or edit

				on user input of Account_Name
				{
					actions 
					{
						custom deluge script
						(
											if(!isNull(input.Account_Name))
										{
											for each  r in input.Available_List
											{
												r.Display_Name_Account=input.Account_Name;
											}
										}
						)
					}
				}

			}
			On_List_Selected as "On List Selected"
			{
				type =  form
				form = Account

				record event = on add or edit

				on user input of Available_List.List_field
				{
					actions 
					{
						custom deluge script
						(
											// Auto-fill Display Name - List Name
										if(!isNull(row.List_field))
										{
											list_rec = Lists[ID == row.List_field];
											if(list_rec.ID != null)
											{
												row.Display_Name_List=list_rec.List_Name;
											}
										}
										// Keep the account display name in sync with parent
										if(!isNull(input.Account_Name))
										{
											row.Display_Name_Account=input.Account_Name;
										}
						)
					}
				}

			}
			On_Addition_of_Row as "On Addition of Row"
			{
				type =  form
				form = Account

				record event = on add or edit

				on add row of Available_List
				{
					actions 
					{
						custom deluge script
						(
											// Mirror parent Account Name into new row's display column
										if(!isNull(input.Account_Name))
										{
											row.Display_Name_Account=input.Account_Name;
										}
						)
					}
				}

			}
			Full_Validation as "Full Validation"
			{
				type =  form
				form = Account

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Require Opening Balance Notes only when Opening Balance > 0
										ob = ifnull(input.Opening_Balance,0.0);
										if(ob > 0)
										{
											if(isNull(input.Opening_Balance_Notes) || trim(input.Opening_Balance_Notes) == "")
											{
												alert "Please enter the Opening Balance Notes because the Opening Balance is greater than zero.";
												cancel submit;
											}
										}
										// Recompute Current Balance using: opening + debit − credit
										opening = ifnull(input.Opening_Balance,0.0);
										credit = ifnull(input.Total_Credit,0.0);
										debit = ifnull(input.Total_Debit,0.0);
										input.Current_Balance = opening + debit - credit;
										// =====================================
										// ACCOUNT VALIDATION
										// =====================================
										// Required fields
										if(input.Provider == null)
										{
											alert "Provider is required.";
											cancel submit;
										}
										if(input.Account_Type == null)
										{
											alert "Account Type is required.";
											cancel submit;
										}
										if(input.Account_Name == null || input.Account_Name.trim() == "")
										{
											alert "Account Name is required.";
											cancel submit;
										}
										if(input.Account_Number == null || input.Account_Number.trim() == "")
										{
											alert "Account Number is required.";
											cancel submit;
										}
										if(input.Opening_Balance_Date_Time == null)
										{
											alert "Opening Balance Date-Time is required.";
											cancel submit;
										}
										if(input.Opening_Balance == null)
										{
											alert "Opening Balance is required.";
											cancel submit;
										}
										dup_name = Account[Account_Name == input.Account_Name.trim() && ID != input.ID];
										if(dup_name.ID != null)
										{
											alert "An account with this Account Name already exists.";
											cancel submit;
										}
										dup_number = Account[Account_Number == input.Account_Number.trim() && ID != input.ID];
										if(dup_number.ID != null)
										{
											alert "An account with this Account Number already exists.";
											cancel submit;
										}
						)
					}
				}

			}
			Finalize_On_Create1 as "Finalize On Create"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(!isNull(input.Account_Paying))
										{
											acc = Account[ID == input.Account_Paying];
											if(acc.ID != null)
											{
												// Payments are money OUT → increase Total_Credit
												acc.Total_Credit=ifnull(acc.Total_Credit,0.0) + ifnull(input.Total_Amount_Paid,0.0);
												// Recompute Current Balance = Opening + Total_Debit − Total_Credit
												opening = ifnull(acc.Opening_Balance,0.0);
												debit = ifnull(acc.Total_Debit,0.0);
												credit = ifnull(acc.Total_Credit,0.0);
												acc.Current_Balance=opening + debit - credit;
												// Soft warning if the resulting balance is negative
												if(acc.Current_Balance < 0)
												{
													info "⚠️ Warning: Account '" + acc.Account_Name + "' now has a negative balance (" + acc.Current_Balance + ").";
												}
											}
										}
										u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
						)
					}
				}

			}
			Full_Validation2 as "Full Validation"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(isNull(input.Total_Amount_Paid) || input.Total_Amount_Paid <= 0)
										{
											alert "Amount Paid must be greater than zero.";
											cancel submit;
										}
										// ============================================================
										// Workflow: Validate Overdraft (Sufficient Funds)
										// Trigger: On Submit → On Validate
										// Purpose: Block payment if it exceeds available funds (incl. overdraft)
										// Notes:
										//   - Uses Account.Allow_Overdraft and Account.Overdraft_Amount_Allowed
										//   - Available = Opening_Balance + Total_Debit − Total_Credit
										//   - If overdraft allowed, Available += Overdraft_Amount_Allowed
										// ============================================================
										if(isNull(input.Account_Paying))
										{
											alert "Please choose an Account Paying before submitting.";
											cancel submit;
										}
										acc = Account[ID == input.Account_Paying];
										if(acc.ID == null)
										{
											alert "Selected account could not be found. Please re-select.";
											cancel submit;
										}
										// Current available funds (before this voucher)
										opening = ifnull(acc.Opening_Balance,0.0);
										debit = ifnull(acc.Total_Debit,0.0);
										// money in
										credit = ifnull(acc.Total_Credit,0.0);
										// money out
										available = opening + debit - credit;
										// Overdraft allowance
										allow_od = ifnull(acc.Allow_Overdraft,false);
										od_limit = ifnull(acc.Overdraft_Amount_Allowed,0.0);
										// Effective spending capacity
										effective_available = if(allow_od,available + od_limit,available);
										// Amount to pay
										amt = ifnull(input.Total_Amount_Paid,0.0);
										// Block if exceeding allowed capacity
										if(amt > effective_available)
										{
											if(allow_od)
											{
												alert "Insufficient funds. This account allows overdraft up to " + od_limit + ", but the available balance including overdraft is " + effective_available + " which is less than the payment amount (" + amt + ").";
											}
											else
											{
												alert "Insufficient funds. Overdraft is NOT allowed for this account. " + "Available balance is " + available + ", which is less than the payment amount (" + amt + ").";
											}
											cancel submit;
										}
						)
					}
				}

			}
			Set_Up_Form_On_Edit1 as "Set Up Form On Edit"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Hidden fields in the form:
										// 1. Old_Amount_Paid (Currency)
										// 2. Old_Account_Paying (Lookup to Account)
										input.Old_Amount_Paid = ifnull(input.Total_Amount_Paid,0.0);
										input.Old_Account_Paying = input.Account_Paying;
						)
					}
				}

			}
			Finalize_On_Edit1 as "Finalize On Edit"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											old_amt = ifnull(input.Old_Amount_Paid,0.0);
										new_amt = ifnull(input.Total_Amount_Paid,0.0);
										old_accid = input.Old_Account_Paying;
										new_accid = input.Account_Paying;
										// ---------- CASE 1: Same account ----------
										if(old_accid == new_accid)
										{
											delta = new_amt - old_amt;
											if(delta != 0 && !isNull(new_accid))
											{
												acc = Account[ID == new_accid];
												if(acc.ID != null)
												{
													acc.Total_Credit=ifnull(acc.Total_Credit,0.0) + delta;
													opening = ifnull(acc.Opening_Balance,0.0);
													debit = ifnull(acc.Total_Debit,0.0);
													credit = ifnull(acc.Total_Credit,0.0);
													acc.Current_Balance=opening + debit - credit;
													if(acc.Current_Balance < 0)
													{
														info "⚠️ Warning: Account '" + acc.Account_Name + "' now has a negative balance (" + acc.Current_Balance + ").";
													}
												}
											}
										}
										// ---------- CASE 2: Account changed ----------
										else
										{
											// Reverse old account
											if(!isNull(old_accid))
											{
												acc_old = Account[ID == old_accid];
												if(acc_old.ID != null)
												{
													acc_old.Total_Credit=ifnull(acc_old.Total_Credit,0.0) - old_amt;
													opening_old = ifnull(acc_old.Opening_Balance,0.0);
													debit_old = ifnull(acc_old.Total_Debit,0.0);
													credit_old = ifnull(acc_old.Total_Credit,0.0);
													acc_old.Current_Balance=opening_old + debit_old - credit_old;
													if(acc_old.Current_Balance < 0)
													{
														info "⚠️ Warning: Account '" + acc_old.Account_Name + "' now has a negative balance (" + acc_old.Current_Balance + ").";
													}
												}
											}
											// Apply to new account
											if(!isNull(new_accid))
											{
												acc_new = Account[ID == new_accid];
												if(acc_new.ID != null)
												{
													acc_new.Total_Credit=ifnull(acc_new.Total_Credit,0.0) + new_amt;
													opening_new = ifnull(acc_new.Opening_Balance,0.0);
													debit_new = ifnull(acc_new.Total_Debit,0.0);
													credit_new = ifnull(acc_new.Total_Credit,0.0);
													acc_new.Current_Balance=opening_new + debit_new - credit_new;
													if(acc_new.Current_Balance < 0)
													{
														info "⚠️ Warning: Account '" + acc_new.Account_Name + "' now has a negative balance (" + acc_new.Current_Balance + ").";
													}
												}
											}
										}
										// Refresh stored old values
										input.Old_Amount_Paid = new_amt;
										input.Old_Account_Paying = new_accid;
										u = thisapp.audit.getLoginAuditInfo();
										input.Updated_By_Name = u.get("name");
										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
						)
					}
				}

			}
			Delete_Reverse_Payment_Vo as "Delete: Reverse Payment Voucher"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// 1) REVERSE PAYMENT DETAILS ROWS
										// ======================================
										for each  r in Payment_Made_Voucher_Details[Payment_Voucher == input.ID]
										{
											deleted_bill_no = ifnull(r.Bill_Number,"").trim();
											if(deleted_bill_no != "")
											{
												payload = Map();
												payload.put("Bill_Number",deleted_bill_no);
												payload.put("Total_Paid",0.0);
												payload.put("Payment_Date",ifnull(input.Payment_Voucher_Date,zoho.currentdate));
												if(r.System == "Asset Management")
												{
													asset_management.updateBillFromPayment(payload);
												}
												else if(r.System == "Store Management")
												{
													store_management.updateBillFromPayment(payload);
												}
												else if(r.System == "Employee Management")
												{
													employee_management.updateInvoiceFromReceipt(payload);
												}
											}
										}
										// ======================================
										// 2) REVERSE ACCOUNT PAYMENT
										// ======================================
										amt = ifnull(input.Total_Amount_Paid,0.0);
										accid = input.Account_Paying;
										if(!isNull(accid) && amt > 0)
										{
											acc = Account[ID == accid];
											if(acc.ID != null)
											{
												acc.Total_Credit=ifnull(acc.Total_Credit,0.0) - amt;
												opening = ifnull(acc.Opening_Balance,0.0);
												debit = ifnull(acc.Total_Debit,0.0);
												credit = ifnull(acc.Total_Credit,0.0);
												acc.Current_Balance=opening + debit - credit;
												info "Payment reversed. Account '" + acc.Account_Name + "' new balance: " + acc.Current_Balance + ".";
												if(acc.Current_Balance < 0)
												{
													info "⚠️ Warning: Account '" + acc.Account_Name + "' now has a negative balance (" + acc.Current_Balance + ").";
												}
											}
										}
						)
					}
				}

			}
			Full_Validation3 as "Full Validation"
			{
				type =  form
				form = Transfer_Funds

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(isNull(input.Amount_Transferred) || input.Amount_Transferred <= 0)
										{
											alert "Amount Transferred must be greater than zero.";
											cancel submit;
										}
										// 2️⃣ Ensure Account From ≠ Account To
										if(input.Account_From == input.Account_To)
										{
											alert "Account From and Account To cannot be the same.";
											cancel submit;
										}
										// 3️⃣ Fetch Account From record
										acc_from = Account[ID == input.Account_From];
										if(acc_from.ID == null)
										{
											alert "Selected 'Account From' could not be found. Please re-select.";
											cancel submit;
										}
										// 4️⃣ Compute available balance before transfer
										opening = ifnull(acc_from.Opening_Balance,0.0);
										debit = ifnull(acc_from.Total_Debit,0.0);
										// money in
										credit = ifnull(acc_from.Total_Credit,0.0);
										// money out
										available = opening + debit - credit;
										// 5️⃣ Handle overdraft
										allow_od = ifnull(acc_from.Allow_Overdraft,false);
										od_limit = ifnull(acc_from.Overdraft_Amount_Allowed,0.0);
										effective_available = if(allow_od,available + od_limit,available);
										// 6️⃣ Check funds availability
										amt = ifnull(input.Amount_Transferred,0.0);
										if(amt > effective_available)
										{
											if(allow_od)
											{
												alert "Insufficient funds. Overdraft allowed up to " + od_limit + ", but available including overdraft is " + effective_available + " which is less than the transfer amount (" + amt + ").";
											}
											else
											{
												alert "Insufficient funds. Overdraft is NOT allowed for this account. " + "Available balance is " + available + ", which is less than the transfer amount (" + amt + ").";
											}
											cancel submit;
										}
						)
					}
				}

			}
			Finalize_On_Create2 as "Finalize On Create"
			{
				type =  form
				form = Transfer_Funds

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(!isNull(input.Account_From))
										{
											acc_from = Account[ID == input.Account_From];
											if(acc_from.ID != null)
											{
												acc_from.Total_Credit=ifnull(acc_from.Total_Credit,0.0) + ifnull(input.Amount_Transferred,0.0);
												opening_f = ifnull(acc_from.Opening_Balance,0.0);
												debit_f = ifnull(acc_from.Total_Debit,0.0);
												credit_f = ifnull(acc_from.Total_Credit,0.0);
												acc_from.Current_Balance=opening_f + debit_f - credit_f;
											}
										}
										// To: increase Total_Debit (money in)
										if(!isNull(input.Account_To))
										{
											acc_to = Account[ID == input.Account_To];
											if(acc_to.ID != null)
											{
												acc_to.Total_Debit=ifnull(acc_to.Total_Debit,0.0) + ifnull(input.Amount_Transferred,0.0);
												opening_t = ifnull(acc_to.Opening_Balance,0.0);
												debit_t = ifnull(acc_to.Total_Debit,0.0);
												credit_t = ifnull(acc_to.Total_Credit,0.0);
												acc_to.Current_Balance=opening_t + debit_t - credit_t;
											}
										}
										info "Transfer completed: " + input.Amount_Transferred + " moved from '" + acc_from.Account_Name + "' to '" + acc_to.Account_Name + "'.";
										u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
						)
					}
				}

			}
			Set_Up_Form_On_Edit2 as "Set Up Form On Edit"
			{
				type =  form
				form = Transfer_Funds

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.Old_Amount_Transferred = ifnull(input.Amount_Transferred,0.0);
										input.Old_Account_From = input.Account_From;
										input.Old_Account_To = input.Account_To;
						)
					}
				}

			}
			Finalize_On_Edit2 as "Finalize On Edit"
			{
				type =  form
				form = Transfer_Funds

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											old_amt = ifnull(input.Old_Amount_Transferred,0.0);
										new_amt = ifnull(input.Amount_Transferred,0.0);
										old_from = input.Old_Account_From;
										old_to = input.Old_Account_To;
										new_from = input.Account_From;
										new_to = input.Account_To;
										// ---------- CASE 1: Same route (from & to unchanged) ----------
										if(old_from == new_from && old_to == new_to)
										{
											delta = new_amt - old_amt;
											if(delta != 0)
											{
												// Adjust From (Total_Credit)
												if(!isNull(new_from))
												{
													acc_f = Account[ID == new_from];
													if(acc_f.ID != null)
													{
														acc_f.Total_Credit=ifnull(acc_f.Total_Credit,0.0) + delta;
														opening_f = ifnull(acc_f.Opening_Balance,0.0);
														debit_f = ifnull(acc_f.Total_Debit,0.0);
														credit_f = ifnull(acc_f.Total_Credit,0.0);
														acc_f.Current_Balance=opening_f + debit_f - credit_f;
													}
												}
												// Adjust To (Total_Debit)
												if(!isNull(new_to))
												{
													acc_t = Account[ID == new_to];
													if(acc_t.ID != null)
													{
														acc_t.Total_Debit=ifnull(acc_t.Total_Debit,0.0) + delta;
														opening_t = ifnull(acc_t.Opening_Balance,0.0);
														debit_t = ifnull(acc_t.Total_Debit,0.0);
														credit_t = ifnull(acc_t.Total_Credit,0.0);
														acc_t.Current_Balance=opening_t + debit_t - credit_t;
													}
												}
											}
										}
										// ---------- CASE 2: Either account changed (reversal + repost) ----------
										else
										{
											// Reverse OLD posting
											if(!isNull(old_from))
											{
												acc_old_f = Account[ID == old_from];
												if(acc_old_f.ID != null)
												{
													acc_old_f.Total_Credit=ifnull(acc_old_f.Total_Credit,0.0) - old_amt;
													opening_of = ifnull(acc_old_f.Opening_Balance,0.0);
													debit_of = ifnull(acc_old_f.Total_Debit,0.0);
													credit_of = ifnull(acc_old_f.Total_Credit,0.0);
													acc_old_f.Current_Balance=opening_of + debit_of - credit_of;
												}
											}
											if(!isNull(old_to))
											{
												acc_old_t = Account[ID == old_to];
												if(acc_old_t.ID != null)
												{
													acc_old_t.Total_Debit=ifnull(acc_old_t.Total_Debit,0.0) - old_amt;
													opening_ot = ifnull(acc_old_t.Opening_Balance,0.0);
													debit_ot = ifnull(acc_old_t.Total_Debit,0.0);
													credit_ot = ifnull(acc_old_t.Total_Credit,0.0);
													acc_old_t.Current_Balance=opening_ot + debit_ot - credit_ot;
												}
											}
											// Apply NEW posting
											if(!isNull(new_from))
											{
												acc_new_f = Account[ID == new_from];
												if(acc_new_f.ID != null)
												{
													acc_new_f.Total_Credit=ifnull(acc_new_f.Total_Credit,0.0) + new_amt;
													opening_nf = ifnull(acc_new_f.Opening_Balance,0.0);
													debit_nf = ifnull(acc_new_f.Total_Debit,0.0);
													credit_nf = ifnull(acc_new_f.Total_Credit,0.0);
													acc_new_f.Current_Balance=opening_nf + debit_nf - credit_nf;
												}
											}
											if(!isNull(new_to))
											{
												acc_new_t = Account[ID == new_to];
												if(acc_new_t.ID != null)
												{
													acc_new_t.Total_Debit=ifnull(acc_new_t.Total_Debit,0.0) + new_amt;
													opening_nt = ifnull(acc_new_t.Opening_Balance,0.0);
													debit_nt = ifnull(acc_new_t.Total_Debit,0.0);
													credit_nt = ifnull(acc_new_t.Total_Credit,0.0);
													acc_new_t.Current_Balance=opening_nt + debit_nt - credit_nt;
												}
											}
										}
										// Refresh stored “old” values for the next edit
										input.Old_Amount_Transferred = new_amt;
										input.Old_Account_From = new_from;
										input.Old_Account_To = new_to;
										u = thisapp.audit.getLoginAuditInfo();
										input.Updated_By_Name = u.get("name");
										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
						)
					}
				}

			}
			Delete_Reverse_Transfer as "Delete: Reverse Transfer"
			{
				type =  form
				form = Transfer_Funds

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											amt = ifnull(input.Amount_Transferred,0.0);
										acc_f_id = input.Account_From;
										acc_t_id = input.Account_To;
										if(!isNull(acc_f_id) && amt > 0)
										{
											acc_f = Account[ID == acc_f_id];
											if(acc_f.ID != null)
											{
												acc_f.Total_Credit=ifnull(acc_f.Total_Credit,0.0) - amt;
												opening_f = ifnull(acc_f.Opening_Balance,0.0);
												debit_f = ifnull(acc_f.Total_Debit,0.0);
												credit_f = ifnull(acc_f.Total_Credit,0.0);
												acc_f.Current_Balance=opening_f + debit_f - credit_f;
											}
										}
										if(!isNull(acc_t_id) && amt > 0)
										{
											acc_t = Account[ID == acc_t_id];
											if(acc_t.ID != null)
											{
												acc_t.Total_Debit=ifnull(acc_t.Total_Debit,0.0) - amt;
												opening_t = ifnull(acc_t.Opening_Balance,0.0);
												debit_t = ifnull(acc_t.Total_Debit,0.0);
												credit_t = ifnull(acc_t.Total_Credit,0.0);
												acc_t.Current_Balance=opening_t + debit_t - credit_t;
											}
										}
										info "Transfer reversed. Amount " + amt + " undone between the two accounts.";
										payload = Map();
										payload.put("Application","Payment Management");
										payload.put("Source_Form","Transfer Funds");
										payload.put("Source_Record_ID",input.ID);
										resp = thisapp.deleteAccountTransactionLog(payload);
										info resp;
						)
					}
				}

			}
