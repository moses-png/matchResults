			On_Cancel_Voucher_Selecte2 as "On Cancel Voucher Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Cancel_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_Voucher == true)
										{
											show Reason_Why_Cancelled;
											input.Truck_Movement_Voucher_Status = "Cancelled";
											input.Odometer_End = null;
											input.Time_End = null;
											input.Line_Distance_Travelled = 0;
											input.Line_Duration_Minutes = 0;
											input.Cost_Per_Odometer = 0;
											input.Line_Total = 0;
											disable Odometer_End;
											disable Time_End;
											disable Party_To;
											disable Party_Location_To;
											disable Site_To;
											disable Site_Location_To;
											disable Delivery_To_Image;
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = null;
											input.Truck_Movement_Voucher_Status = "In Progress";
											enable Odometer_End;
											enable Time_End;
											enable Party_To;
											enable Party_Location_To;
											enable Site_To;
											enable Site_Location_To;
											enable Delivery_To_Image;
										}
						)
					}
				}

			}
			Set_Up_Form19 as "Set Up Form"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// TRUCK MOVEMENT VOUCHER - ON LOAD
										// ======================================
										is_create = input.ID == null;
										// =======================
										// 1. DISABLE DISPLAY / AUTO FIELDS
										// =======================
										disable Display_Name_Voucher;
										disable Display_Name_Employee;
										disable Display_Name_Site;
										disable Display_Name_Asset;
										disable Line_Number;
										disable Number_Plate_Truck_Register;
										disable Work_Done;
										// ======================================
										//Pick Up Section
										// ======================================
										disable Display_Name_Party_From;
										disable Display_Name_Site_From;
										disable Pick_Up_From;
										disable Time_Start;
										// ======================================
										//Delivery Section
										// ======================================
										disable Display_Name_Party_To;
										disable Display_Name_Site_To;
										disable Delivery_To;
										disable Time_End;
										disable Reason_Why_Cancelled;
										disable Truck_Movement_Voucher_Status;
										// ======================================
										//Line Summary
										// ======================================
										disable Cost_Per_Odometer;
										disable Line_Total;
										disable Line_Duration_Minutes;
										disable Line_Distance_Travelled;
										// ======================================
										//Back End
										// ======================================
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// =======================
										// 2. DEFAULT HIDE SECTIONS / JOB FIELDS
										// =======================
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										hide Display_Name_Site;
										hide Display_Name_Asset;
										hide Number_Plate_Truck_Register;
										hide Card_Source;
										hide Card_Masaka;
										hide Card_Clean_Sand;
										hide Display_Name_Card;
										hide Work_Order_Task_Source;
										hide Work_Order_Task_Masaka;
										hide Work_Order_Task_Freedom_City;
										hide Work_Order_Task_Concrete_Products;
										hide Work_Order_Task_Clean_Sand;
										hide Task_Location;
										hide Small_Notes;
										hide Batch_Number_Masaka;
										hide Truck_Movement_Voucher;
										hide Truck_Movement;
										// ======================================
										//Pick Up Section
										// ======================================
										hide Pick_Up_Section;
										hide Display_Name_Party_From;
										hide Display_Name_Site_From;
										//hide Time_Start;
										hide Display_Name_Job;
										hide Display_Name_Card;
										// ======================================
										//Delivery Section
										// ======================================
										hide Delivery_Section;
										hide Display_Name_Party_To;
										hide Display_Name_Site_To;
										//hide Time_End;
										hide Line_Summary;
										hide Batch_Number_To;
										//hide Back_End;
										hide Services;
										hide Services.Display_Name_Bill;
										hide Services.Bill;
										hide Services.Display_Name_Service;
										hide Services.Display_Name_Voucher;
										hide Services.Last_Synced_Group_Amount;
										hide Services.Last_Synced_Group_ID;
										hide Services.User_Role;
										hide Services.User_Email;
										hide Services.User_Name;
										hide Services.Created_By_Time;
										hide Services.Created_By_Name;
										hide Services.Created_By_Email;
										hide Services.Updated_By_Name;
										hide Services.Updated_By_Time;
										hide Services.Updated_By_Email;
										// =======================
										// 3. JOB CONTROL
										// =======================
										if(input.Job != null)
										{
											jobNo = input.Job.Job_No;
											if(jobNo == "TJS01")
											{
												show Pick_Up_Section;
												show Card_Source;
												enable Card_Source;
												if(input.Card_Source == "Masaka Sites")
												{
													show Card_Masaka;
													enable Card_Masaka;
													hide Card_Clean_Sand;
													disable Card_Clean_Sand;
													if(is_create)
													{
														input.Card_Clean_Sand = null;
													}
												}
												else if(input.Card_Source == "Clean Sand")
												{
													show Card_Clean_Sand;
													enable Card_Clean_Sand;
													hide Card_Masaka;
													disable Card_Masaka;
													if(is_create)
													{
														input.Card_Masaka = null;
													}
												}
												else
												{
													hide Card_Masaka;
													disable Card_Masaka;
													hide Card_Clean_Sand;
													disable Card_Clean_Sand;
													if(is_create)
													{
														input.Card_Masaka = null;
														input.Card_Clean_Sand = null;
													}
												}
												hide Work_Order_Task_Masaka;
												hide Batch_Number_From;
												hide Truck_Movement_Voucher;
												hide Task_Location;
												hide Small_Notes;
												show Site_From;
												disable Site_From;
												show Site_Location_From;
												enable Site_Location_From;
												hide Party_From;
												hide Party_Location_From;
												show Delivery_Section;
												show Delivery_Location;
												enable Delivery_Location;
												show Odometer_End;
												show Time_End;
												show Delivery_To_Image;
