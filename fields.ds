			On_Truck_Movement_Voucher as "On Truck Movement Voucher Selected"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on user input of Truck_Movement_Voucher
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// DRAGER WORK REPORT -> ON TRUCK MOVEMENT VOUCHER SELECTED
										// ========================================
										if(input.Truck_Movement_Voucher != null)
										{
											tmv = Truck_Movement_Voucher[ID == input.Truck_Movement_Voucher.ID];
											if(tmv.ID != null)
											{
												// Set TO first
												input.Batch_Number_To = tmv.Batch_Number_To;
												input.Batch_Number_From = tmv.Batch_Number_From;
												batchFrom = "";
												batchTo = "";
												locationName = "";
												if(input.Batch_Number_From != null)
												{
													batchFrom = ifnull(input.Batch_Number_From.Batch_Number,"");
													input.Display_Name_Batch_Number_From = batchFrom;
												}
												else
												{
													input.Display_Name_Batch_Number_From = "";
												}
												if(input.Batch_Number_To != null)
												{
													batchTo = ifnull(input.Batch_Number_To.Batch_Number,"");
													input.Display_Name_Batch_Number_To = batchTo;
												}
												else
												{
													input.Display_Name_Batch_Number_To = "";
													alert "Batch Number To is empty on the selected Truck Movement Voucher.";
												}
												if(input.Location != null)
												{
													locationName = ifnull(input.Location.Location_Name,"");
												}
												if(batchFrom != "" && batchTo != "")
												{
													if(locationName != "")
													{
														input.Work_Done = "Extracted material from " + batchFrom + " at " + locationName + " and moved to " + batchTo;
													}
													else
													{
														input.Work_Done = "Extracted material from " + batchFrom + " and moved to " + batchTo;
													}
												}
												else if(batchFrom != "")
												{
													input.Work_Done = "Extracted material from " + batchFrom;
												}
												else if(batchTo != "")
												{
													input.Work_Done = "Material moved to " + batchTo;
												}
												else
												{
													input.Work_Done = "";
												}
											}
										}
										else
										{
											input.Batch_Number_From = null;
											input.Batch_Number_To = null;
											input.Display_Name_Batch_Number_From = "";
											input.Display_Name_Batch_Number_To = "";
											input.Work_Done = "";
										}
						)
					}
				}

			}
			On_Voucher_Selected2 as "On Voucher Selected"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Voucher != null)
										{
											input.Display_Name_Voucher = input.Voucher.Voucher_Number;
											empName = ifnull(input.Voucher.Employee.Employee_Name,"").trim();
											empNo = ifnull(input.Voucher.Employee.Employee_Number,"").toString().trim();
											if(empName != "" && empNo != "")
											{
												input.Display_Name_Employee = empName + " - " + empNo;
											}
											else if(empName != "")
											{
												input.Display_Name_Employee = empName;
											}
											else
											{
												input.Display_Name_Employee = null;
											}
											input.Display_Name_Site = input.Voucher.Display_Name_Site;
											if(input.Voucher.Asset != null)
											{
												input.Display_Name_Asset = input.Voucher.Asset.Asset_Name + " - " + input.Voucher.Asset.Asset_ID;
											}
											else
											{
												input.Display_Name_Asset = null;
											}
											existing = Tractor_Work_Report[Voucher == input.Voucher];
											if(existing.count() > 0)
											{
												maxLine = 0;
												for each  rec in existing
												{
													if(rec.Line_Number != null && rec.Line_Number > maxLine)
													{
														maxLine = rec.Line_Number;
													}
												}
												input.Line_Number = maxLine + 1;
											}
											else
											{
												input.Line_Number = 1;
											}
										}
										else
										{
											input.Display_Name_Voucher = null;
											input.Display_Name_Employee = null;
											input.Display_Name_Site = null;
											input.Display_Name_Asset = null;
											input.Line_Number = null;
										}
						)
					}
				}

			}
