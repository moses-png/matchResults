			On_Frequency_Value as "On Frequency Value"
			{
				type =  form
				form = Routine_Issues

				record event = on add or edit

				on user input of Frequency_Value
				{
					actions 
					{
						custom deluge script
						(
											if(input.Last_Done_Date != null && input.Frequency_Value != null && input.Date_Frequency != null)
										{
											if(input.Date_Frequency == "Days")
											{
												input.Next_Done_Date = input.Last_Done_Date.addDay(input.Frequency_Value);
											}
											else if(input.Date_Frequency == "Weeks")
											{
												input.Next_Done_Date = input.Last_Done_Date.addDay(input.Frequency_Value * 7);
											}
											else if(input.Date_Frequency == "Months")
											{
												input.Next_Done_Date = input.Last_Done_Date.addMonth(input.Frequency_Value);
											}
											else
											{
												input.Next_Done_Date = null;
											}
										}
										else
										{
											input.Next_Done_Date = null;
										}
						)
					}
				}

			}
