			On_Customer_Selected2 as "On Customer Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											// Sales Voucher -> On Customer Selected
										if(input.Customer == null)
										{
											// Clear + hide everything when customer is removed
											input.Display_Name_Customer = null;
											input.Credit_Note = null;
											input.Delivery_Note = null;
											hide Credit_Note;
											hide Delivery_Note;
											return;
										}
										// 1) Auto-fill Display Name Customer
										// Customer is a lookup to Sand Customer; Display_Name_Customer is a single line field
										input.Display_Name_Customer = input.Customer.Display_Name_Customer;
										// 2) Decide show/hide based on Sand Customer settings
										// These are Decision Box fields on Sand Customer:
										// Credit_is_Allowed, Purchase_Order_Required, Delivery_Note_Required, Credit_Note_Required :contentReference[oaicite:2]{index=2}
										creditAllowed = ifnull(input.Customer.Credit_is_Allowed,false);
										dnRequired = ifnull(input.Customer.Delivery_Note_Required,false);
										cnRequired = ifnull(input.Customer.Credit_Note_Required,false);
										// --- Delivery Note ---
										if(dnRequired == true)
										{
											show Delivery_Note;
										}
										else
										{
											input.Delivery_Note = null;
											hide Delivery_Note;
										}
										// --- Credit Note ---
										// Credit Note should only appear if credit is allowed AND credit note is required
										if(creditAllowed == true && cnRequired == true)
										{
											show Credit_Note;
										}
										else
										{
											input.Credit_Note = null;
											hide Credit_Note;
										}
						)
					}
				}

			}
			Full_Validation_on_Create as "Full Validation on Create"
			{
				type =  form
				form = Sales_Voucher

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ===== Generate Card Number on Submit =====
										// Format: PREFIX + 3 digits (e.g. AB001)
										// Max allowed number: 999
										// Do not overwrite if already generated
										if(input.Card_Number != null && input.Card_Number.trim() != "")
										{
											return;
										}
										// Site is mandatory
										if(input.Site == null)
										{
											alert "Site is required to generate Card Number.";
											cancel submit;
										}
										// Fetch ACTIVE Card Control for this Site
										cc = Card_Control[Site == input.Site && Card_Status == "Active"];
										if(cc.count() == 0)
										{
											alert "No ACTIVE Card Control found for this Site.";
											cancel submit;
										}
										// Get next number
										nextNo = ifnull(cc.Next_Number,0);
										// Enforce valid range
										if(nextNo <= 0)
										{
											alert "Card Control Next Number must start from 1.";
											cancel submit;
										}
										if(nextNo > 999)
										{
											alert "Card Numbers exhausted for this prefix (limit 999 reached).";
											cancel submit;
										}
										// --- Zero-pad to 3 digits (Deluge-safe) ---
										numStr = nextNo.toString();
										if(nextNo < 10)
										{
											numStr = "00" + numStr;
										}
										else if(nextNo < 100)
										{
											numStr = "0" + numStr;
										}
										// else 100..999 stays as-is
										// Build Card Number → PREFIX001
										cardNo = cc.Prefix + numStr;
										// Final duplicate safety check
										dup = Sales_Voucher[Card_Number == cardNo];
										if(dup.count() > 0)
										{
											alert "Card Number collision detected. Please retry submission.";
											cancel submit;
										}
										// Assign Card Number
										input.Card_Number = cardNo;
										// Increment Card Control counter
										cc.Next_Number=nextNo + 1;
						)
					}
				}

			}
			Set_up_Form11 as "Set up Form"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// --------------------------------------------------
										// Detect CREATE vs EDIT
										// --------------------------------------------------
										is_create = input.ID == null;
										// --------------------------------------------------
										// HIDE EVERYTHING FIRST (safe reset)
										// --------------------------------------------------
										//DISABLE FIELDS
										//Voucher details
										disable Credit_Note_Date;
										//Customer Details
										disable Display_Name_Customer;
										//Truck Details
										disable Display_Name_Number_Plate;
										//Receipt Officer
										disable Made_By;
										//Cashier
										disable Card;
										disable Cashier_Envelope;
										//Status Details
										disable Credit_Note_Status;
										disable Notes;
										//Back End
										disable Back_End;
										disable User_Role;
										disable User_Name;
										disable User_Email;
										disable Created_By_Name;
										disable Created_By_Time;
										disable Created_By_Email;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										//HIDE FIELDS
										//Voucher Details
										hide Voucher_Details;
										hide Display_Name_Site;
										hide Credit_Note_Date;
										//Customer Details
										hide Display_Name_Customer;
										//Truck Details
										hide Display_Name_Number_Plate;
										hide TSF_Number;
										//Receipt Officer
										hide Made_By;
										//Cashier
										hide Cashier;
										hide Card;
										hide Cashier_Envelope;
										//Status Details
										hide Status_Details;
										hide Credit_Note_Status;
										hide Notes;
										//Back End
										hide Back_End;
										// --------------------------------------------------
										// CREATE MODE
										// --------------------------------------------------
										if(is_create)
										{
											// Show only required fields on create
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											show Voucher_Details;
											hide Credit_Note_Date;
											show Credit_Note_Number;
											show Customer;
											show Receipt_Officer_Voucher;
											show Truck_Details;
											show Number_Plate;
											show Driver_Name;
											show Receipt_Officer;
											show Confirmed_By;
											show How_have_you_confirmed;
											if(input.Credit_Note_Date == null)
											{
												input.Credit_Note_Date = zoho.currentdate;
											}
											// Optional: lock status on create
											input.Credit_Note_Status = "Draft";
											disable Credit_Note_Status;
										}
						)
					}
				}

			}
