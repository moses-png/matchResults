			On_Quantity_Ordered_Selec as "On Quantity Ordered Selected"
			{
				type =  form
				form = Sand_Purchase_Order

				record event = on add or edit

				on user input of Purchase_Order_Details.Quantity_Ordered
				{
					actions 
					{
						custom deluge script
						(
											for each  poRow in input.Purchase_Order_Details
										{
											if(poRow.Quantity_Ordered != null && poRow.Unit_Of_Measure != null)
											{
												uomName = poRow.Unit_Of_Measure.Unit_Of_Measure_Name;
												// <-- change field link name if yours differs
												if(uomName == "Cubic meters")
												{
													poRow.Quantity_Ordered_to_CBM=poRow.Quantity_Ordered;
												}
												else if(uomName == "Tonnes")
												{
													poRow.Quantity_Ordered_to_CBM=poRow.Quantity_Ordered / 1.6;
												}
												if(poRow.Rate != null)
												{
													poRow.Line_Total=poRow.Quantity_Ordered * poRow.Rate;
												}
												poRow.Quantity_Delivered=ifnull(poRow.Quantity_Delivered,0);
												poRow.Quantity_Remaining=poRow.Quantity_Ordered_to_CBM - poRow.Quantity_Delivered;
											}
										}
						)
					}
				}

			}
			On_Unit_Of_Measure_Select as "On Unit Of Measure Selected"
			{
				type =  form
				form = Sand_Purchase_Order

				record event = on add or edit

				on user input of Purchase_Order_Details.Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											for each  poRow in input.Purchase_Order_Details
										{
											if(poRow.Unit_Of_Measure != null && poRow.Quantity_Ordered != null)
											{
												// Because Unit_Of_Measure is a LOOKUP, use its display/name field
												uomName = poRow.Unit_Of_Measure.Unit_Of_Measure_Name;
												// change this if your name field link is different
												// Convert Quantity Ordered to CBM
												if(uomName == "Cubic meters")
												{
													poRow.Quantity_Ordered_to_CBM=poRow.Quantity_Ordered;
												}
												else if(uomName == "Tonnes")
												{
													poRow.Quantity_Ordered_to_CBM=poRow.Quantity_Ordered / 1.6;
												}
												else
												{
													// If other UOM types exist, clear or leave as-is (I suggest clear)
													poRow.Quantity_Ordered_to_CBM=null;
												}
												// Recalculate Line Total if Rate exists
												if(poRow.Rate != null)
												{
													poRow.Line_Total=poRow.Quantity_Ordered * poRow.Rate;
												}
												// Update remaining
												poRow.Quantity_Delivered=ifnull(poRow.Quantity_Delivered,0);
												poRow.Quantity_Remaining=poRow.Quantity_Ordered_to_CBM - poRow.Quantity_Delivered;
											}
										}
						)
					}
				}

			}
			On_Rate_Selected as "On Rate Selected"
			{
				type =  form
				form = Sand_Purchase_Order

				record event = on add or edit

				on user input of Purchase_Order_Details.Rate
				{
					actions 
					{
						custom deluge script
						(
											for each  poRow in input.Purchase_Order_Details
										{
											if(poRow.Rate != null && poRow.Quantity_Ordered != null)
											{
												// Line Total = Quantity Ordered * Rate
												poRow.Line_Total=poRow.Quantity_Ordered * poRow.Rate;
											}
											else
											{
												// If either is missing, clear the total
												poRow.Line_Total=null;
											}
											// Keep Remaining consistent (optional but useful)
											if(poRow.Quantity_Ordered != null)
											{
												poRow.Quantity_Delivered=ifnull(poRow.Quantity_Delivered,0);
												poRow.Quantity_Remaining=poRow.Quantity_Ordered_to_CBM - poRow.Quantity_Delivered;
											}
										}
						)
					}
				}

			}
			Full_Validation8 as "Full Validation"
			{
				type =  form
				form = Sand_Purchase_Order

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// Full Validation – Sand Purchase Order
										// ===============================
										// 1) Customer required
										if(input.Customer == null)
										{
											alert "Customer is required.";
											cancel submit;
										}
										// 2) Purchase Order Number required
										if(input.Purchase_Order_Number == null || input.Purchase_Order_Number.trim() == "")
										{
											alert "Purchase Order Number is required.";
											cancel submit;
										}
										// 3) Purchase Order Number no duplicates (exclude current record when editing)
										dupPO = Sand_Purchase_Order[Purchase_Order_Number == input.Purchase_Order_Number && ID != input.ID];
										if(dupPO.count() > 0)
										{
											alert "Purchase Order Number already exists. Please use a unique number.";
											cancel submit;
										}
										// 4) Purchase Order Date required and cannot be future
										if(input.Purchase_Order_Date == null)
										{
											alert "Purchase Order Date is required.";
											cancel submit;
										}
										if(input.Purchase_Order_Date > zoho.currentdate)
										{
											alert "Purchase Order Date cannot be in the future.";
											cancel submit;
										}
										// 5) At least one record in the subform (use count(), not size())
										if(input.Purchase_Order_Details == null || input.Purchase_Order_Details.count() == 0)
										{
											alert "Please add at least one item in Purchase Order Details.";
											cancel submit;
										}
										// 6) Subform row validations
										rowIndex = 1;
										for each  poRow in input.Purchase_Order_Details
										{
											// Item required
											if(poRow.Item == null)
											{
												alert "Row " + rowIndex + ": Item is required.";
												cancel submit;
											}
											// Quantity Ordered required and cannot be negative
											if(poRow.Quantity_Ordered == null)
											{
												alert "Row " + rowIndex + ": Quantity Ordered is required.";
												cancel submit;
											}
											if(poRow.Quantity_Ordered < 0)
											{
												alert "Row " + rowIndex + ": Quantity Ordered cannot be negative.";
												cancel submit;
											}
											// Unit Of Measure required
											if(poRow.Unit_Of_Measure == null)
											{
												alert "Row " + rowIndex + ": Unit Of Measure is required.";
												cancel submit;
											}
											// Rate required
											if(poRow.Rate == null)
											{
												alert "Row " + rowIndex + ": Rate is required.";
												cancel submit;
											}
											rowIndex = rowIndex + 1;
										}
						)
					}
				}

			}
			On_Purchase_Order_Selecte as "On Purchase Order Selected"
			{
				type =  form
				form = Delivery_Note

				record event = on add or edit

				on user input of Purchase_Order
