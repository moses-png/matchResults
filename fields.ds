 application "Employee Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Africa/Kampala"
 	time format = "24-hr"

 	forms
	{
		form Batch_Stock
		{
			displayname = "Batch Stock"
			success message = "Batch Stock Added Successfully"
			Batch_Stock_Details
			(
				type = section
				displayname = "Batch Stock Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Batch_Number
			(
				type = picklist	
				displayname = "Batch Number"
				values  = Stock_Production.ID
    			bidirectional = Batch_Stock_Details
    			displayformat = [Batch_Number + " - " + Materials_Produced]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Batch_Number
			(
    			type = text
				displayname = "Display Name Batch Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Line_Number
			(
				type = number
				displayname = "Line Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Batch_Time
			(
    			type = datetime
				displayname = "Batch Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Batch_Type
			(
				type = picklist
				displayname = "Batch Type"
				maxchar = 100
				values = {"In","Out"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reference
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Quantity
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Running_Balance
			(
				type = decimal
				displayname = "Running Balance"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source_Record_ID
			(
				type = number
				displayname = "Source Record ID"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source_Form
			(
    			type = text
				displayname = "Source Form"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Back_End
			(
				type = section
				displayname = "Back End"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			User_Role
			(
    			type = text
				displayname = "User Role"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Created_By_Nmae
			(
    			type = text
				displayname = "Created By Nmae"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Created_By_Email
			(
    			type = email
				displayname = "Created By Email"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Created_By_Time
			(
    			type = datetime
				displayname = "Created By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Updated_By_Name
			(
    			type = text
				displayname = "Updated By Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Updated_By_Email
			(
    			type = email
				displayname = "Updated By Email"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Updated_By_Time
			(
    			type = datetime
				displayname = "Updated By  Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Bill
		{
			success message = "Work Log Added Successfully"
			Work_Log_Header
			(
				type = section
				displayname = "Bill Header"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Bill_Date
			(
    			type = date
				displayname = "Bill Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vendor
			(
				type = picklist	
				values  = Employee_Register.ID
    			displayformat = [Employee_Name + " - " + Employee_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Bill_Name
			(
    			type = text
				displayname = "Bill Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Bill_Number
			(
    			type = text
				displayname = "Bill Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Bill_Total
			(
				displayname = "Bill Total"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Details
			(
				type = grid
				values  = Bill_Details.ID
    			bidirectional = Bill
				sorttype = fieldbased
				sort by
				(
					Details_Date ascending
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Log_Footer
			(
				type = section
				displayname = "Bill Footer"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Total_Amount
			(
				displayname = "Total Amount"
				type = UGX
				format = commadotwestern
	 			row = 3
	 			column = 1   
				width = medium
			)
			Amount_Due
			(
				displayname = "Amount Due"
				type = UGX
				format = commadotwestern
	 			row = 3
	 			column = 1   
				width = medium
			)
			Amount_Paid
			(
				displayname = "Amount Paid"
				type = UGX
				format = commadotwestern
	 			row = 3
	 			column = 1   
				width = medium
			)
			Balance_Due
			(
				displayname = "Balance Due"
				type = UGX
				format = commadotwestern
	 			row = 3
	 			column = 1   
				width = medium
			)
			Cancel_Bill
			(
    			type = checkbox
				displayname = "Cancel Bill"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Reason_Why_Cancelled
			(
    			type = textarea
				displayname = "Reason Why Cancelled"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Bill_Status
			(
				type = picklist
				displayname = "Bill Status"
				maxchar = 100
				values = {"Draft","Billed","Cancelled"}
				initial value = "Draft"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Payment_Status
			(
				type = picklist
				displayname = "Payment Status"
				maxchar = 100
				values = {"Not Paid","Partially Paid","Paid"}
				initial value = "Not Paid"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Back_End
			(
				type = section
				displayname = "Back End"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			User_Role
			(
    			type = text
				displayname = "User Role"
	 			row = 4
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 4
	 			column = 1   
				width = medium
				personal data = true
			)
			User_Role1
			(
    			type = text
				displayname = "User Role"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Created_By_Name
			(
    			type = text
				displayname = "Created By Name"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Created_By_Email
			(
    			type = email
				displayname = "Created By Email"
				maxchar = 80
	 			row = 4
	 			column = 1   
				width = medium
				personal data = true
			)
			Created_By_Time
			(
    			type = datetime
				displayname = "Created By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Updated_By_Name
			(
    			type = text
				displayname = "Updated By Name"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Updated_By_Email
			(
    			type = email
				displayname = "Updated By Email"
				maxchar = 80
	 			row = 4
	 			column = 1   
				width = medium
				personal data = true
			)
			Updated_By_Time
			(
    			type = datetime
				displayname = "Updated By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Bill_Details
		{
			displayname = "Bill Details"
			success message = "Work Log Detail Added Successfully"
			Bill_Details
			(
				type = section
				displayname = "Bill Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Bill
			(
				type = picklist	
				values  = Bill.ID
    			bidirectional = Details
    			displayformat = [Bill_Name + " - " + Bill_Number]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Bill
			(
    			type = text
				displayname = "Display Name Bill"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Details_Date
			(
    			type = date
				displayname = "Details Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reference
