			{
				type =  form
				form = Employee_Department

				record event = on add or edit

				on user input of Department_End_Date
				{
					actions 
					{
						custom deluge script
						(
											if(input.Department_End_Date != null)
										{
											// Validate dates
											if(input.Department_Start_Date != null && input.Department_End_Date < input.Department_Start_Date)
											{
												alert "Department End Date cannot be earlier than Department Start Date.";
												input.Department_End_Date = null;
												return;
											}
											// Auto status update
											if(input.Department_End_Date < zoho.currentdate)
											{
												input.Department_Status = "Inactive";
											}
											else
											{
												input.Department_Status = "Active";
											}
										}
										else
										{
											input.Department_Status = "Active";
										}
						)
					}
				}

			}
