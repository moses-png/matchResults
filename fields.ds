			Full_Validation4 as "Full Validation"
			{
				type =  form
				form = Debit

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// ACCOUNT DEBIT APPLICATION — ON VALIDATE
										// ======================================
										msg = "";
										// --------------------------------------
										// 1) Main form required fields
										// --------------------------------------
										if(input.Account_Debits == null)
										{
											msg = msg + "\n• Select Account Debit.";
										}
										rows = input.Debit_Payment_Application;
										if(rows == null || rows.isEmpty())
										{
											msg = msg + "\n• Add at least one Debit Payment Application row.";
										}
										if(msg != "")
										{
											alert "Fix the following:" + msg;
											cancel submit;
										}
										// --------------------------------------
										// 2) Load selected Account Debit
										// --------------------------------------
										debitRec = Account_Debits[ID == input.Account_Debits];
										if(debitRec == null)
										{
											alert "Selected Account Debit record was not found.";
											cancel submit;
										}
										// Adjust these field names if your Account_Debits form uses different ones
										debit_total = ifnull(debitRec.Amount_Paid,0).toDecimal();
										debit_applied = ifnull(debitRec.Applied_Amount,0).toDecimal();
										debit_balance = debitRec.Balance;
										// debit_balance = debit_total - debit_applied;
										// If your form already has a Balance field on Account_Debits, use that instead:
										// debit_balance = ifnull(debitRec.Balance,0).toDecimal();
										if(debit_balance <= 0)
										{
											alert "This Account Debit has no unapplied balance remaining.";
											cancel submit;
										}
										// --------------------------------------
										// 3) Validate subform rows
										// --------------------------------------
										total_apply = 0.0;
										seenPayments = List();
										validRowCount = 0;
										for each  r in rows
										{
											// Skip completely blank row
											if(r.Debit_Payment == null && ifnull(r.Amount_Paid,0) == 0 && r.Applied_Date == null && isNull(r.Reference))
											{
												continue;
											}
											validRowCount = validRowCount + 1;
											// Must select Debit Payment
											if(r.Debit_Payment == null)
											{
												msg = msg + "\n• Select Debit Payment for each filled row.";
												continue;
											}
											// Prevent duplicate Debit Payment in same submission
											// 	if(seenPayments.contains(r.Debit_Payment))
											// 	{
											// 		msg = msg + "\n• The same Debit Payment is selected more than once.";
											// 		continue;
											// 	}
											// 	seenPayments.add(r.Debit_Payment);
											// Applied Date required
											if(r.Applied_Date == null)
											{
												msg = msg + "\n• Applied Date is required for each filled row.";
											}
											// Amount must be > 0
											row_amt = ifnull(r.Amount_Paid,0).toDecimal();
											if(row_amt <= 0)
											{
												msg = msg + "\n• Amount Paid must be greater than 0 for each selected row.";
												continue;
											}
											// Load selected Debit Payment
											payRec = Account_Debits[Reference == r.Debit_Payment];
											if(payRec == null)
											{
												msg = msg + "\n• Selected Debit Payment record was not found.";
												continue;
											}
											// Compute payment balance
											pay_total = ifnull(payRec.Amount_Paid,0).toDecimal();
											pay_applied = ifnull(payRec.Applied_Amount,0).toDecimal();
											pay_balance = pay_total - pay_applied;
											// If your Debit_Payment form already has Balance, you can use:
											// pay_balance = ifnull(payRec.Balance,0).toDecimal();
											if(pay_balance <= 0)
											{
												msg = msg + "\n• Debit Payment '" + payRec.Reference + "' has no remaining balance.";
												continue;
											}
											// Do not over-apply the payment
											if(row_amt > pay_balance)
											{
												msg = msg + "\n• Amount Paid (" + row_amt + ") is greater than the selected Debit Payment balance (" + pay_balance + ") for reference '" + payRec.Reference + "'.";
												continue;
											}
											// Optional: enforce same account
											// Uncomment if both forms have matching Account fields
											/*
											if(payRec.Account != null && debitRec.Account != null && payRec.Account != debitRec.Account)
											{
												msg = msg + "\n• Debit Payment '" + payRec.Reference + "' does not belong to the same account as the selected Account Debit.";
												continue;
											}
											*/
											total_apply = total_apply + row_amt;
										}
										// --------------------------------------
										// 4) Must have at least one actual row
										// --------------------------------------
										if(validRowCount == 0)
										{
											msg = msg + "\n• Add at least one completed Debit Payment Application row.";
										}
										// --------------------------------------
										// 5) If row errors exist, stop
										// --------------------------------------
										if(msg != "")
										{
											alert "Fix the following:" + msg;
											cancel submit;
										}
										// --------------------------------------
										// 6) Do not exceed Account Debit balance
										// --------------------------------------
										if(total_apply > debit_balance)
										{
											alert "Total applied amount (" + total_apply + ") exceeds the Account Debit remaining balance (" + debit_balance + ").";
											cancel submit;
										}
										// --------------------------------------
										// 7) Optional: update main form total
										// --------------------------------------
										input.Applied_Amount = total_apply;
						)
					}
				}

			}
			Finalize3 as "Finalize"
			{
				type =  form
				form = Debit

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// ACCOUNT DEBIT APPLICATION (On Success)
										// Updates:
										// 1) Account_Debits.Applied_Amount
										// 2) Debit_Payment.Applied_Amount
										// 3) Optional statuses
										// ======================================
										// --------------------------------------
										// 1) Ensure Account Debit exists
										// --------------------------------------
										if(input.Account_Debits == null)
										{
											return;
										}
										debitRec = Account_Debits[ID == input.Account_Debits];
										if(debitRec == null)
										{
											return;
										}
										// --------------------------------------
										// 2) Total all subform row amounts
										// --------------------------------------
										total_applied_now = 0.0;
										for each  r in input.Debit_Payment_Application
										{
											if(r.Debit_Payment == null)
											{
												continue;
											}
											row_amt = ifnull(r.Amount_Paid,0).toDecimal();
											if(row_amt <= 0)
											{
												continue;
											}
											total_applied_now = total_applied_now + row_amt;
										}
										// --------------------------------------
										// 3) Update parent application total
										// --------------------------------------
										// input.Applied_Amount = total_applied_now;
										// --------------------------------------
										// 4) Update Account_Debits.Applied_Amount
										//    Add this submission's total to existing applied amount
										// --------------------------------------
										debit_total = ifnull(debitRec.Amount_Paid,0).toDecimal();
										debit_applied_existing = ifnull(debitRec.Applied_Amount,0).toDecimal();
										new_debit_applied = debit_applied_existing + total_applied_now;
										debit_balance = debit_total - new_debit_applied;
										if(debit_balance < 0)
										{
											debit_balance = 0;
										}
										debitRec.Applied_Amount=new_debit_applied;
										// If Account_Debits has a stored Balance field, keep it updated too
										// Remove this line if Balance is a formula field
										// debitRec.Balance = debit_balance;
										// Optional Account Debit status
										if(new_debit_applied <= 0)
										{
											debitRec.Status="Unapplied";
										}
										else if(new_debit_applied < debit_total)
										{
											debitRec.Status="Partially Applied";
										}
										else
										{
											debitRec.Status="Fully Applied";
										}
						)
					}
				}

			}
			On_Payment_Voucher_Select as "On Payment Voucher Selected"
