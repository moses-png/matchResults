			Finalize1 as "Finalize"
			{
				type =  form
				form = Asset_Transfer_Multiple_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Transfer_Vouchers != null && input.Transfer_Vouchers.count() > 0)
										{
											for each  row in input.Transfer_Vouchers
											{
												if(row.Asset != null)
												{
													all_vouchers = Asset_Transfer_Voucher[Asset == row.Asset];
													latest_voucher_id = null;
													latest_voucher_date = null;
													for each  v in all_vouchers
													{
														this_v_date = v.Transfer_Voucher_Date;
														this_v_id = v.ID;
														if(latest_voucher_date == null)
														{
															latest_voucher_date = this_v_date;
															latest_voucher_id = this_v_id;
														}
														else
														{
															if(this_v_date > latest_voucher_date)
															{
																latest_voucher_date = this_v_date;
																latest_voucher_id = this_v_id;
															}
															else if(this_v_date == latest_voucher_date)
															{
																if(this_v_id > latest_voucher_id)
																{
																	latest_voucher_id = this_v_id;
																	latest_voucher_date = this_v_date;
																}
															}
														}
													}
													should_update = false;
													if(latest_voucher_id != null && latest_voucher_date != null)
													{
														if(latest_voucher_id == row.ID)
														{
															should_update = true;
														}
													}
													if(should_update)
													{
														asset_rec = Asset_List[ID == row.Asset];
														if(asset_rec.ID != null)
														{
															if(row.Site_To != null)
															{
																asset_rec.Current_Site=row.Site_To.Asset_Name + " - " + row.Site_To.Asset_ID;
															}
															else
															{
																asset_rec.Current_Site="";
															}
															if(row.Custodian_To != null)
															{
																asset_rec.Current_Custodian=row.Custodian_To.Employee_Name + " - " + row.Custodian_To.Employee_Number;
															}
															else
															{
																asset_rec.Current_Custodian="";
															}
															asset_rec.Last_Transfer_Date=row.Transfer_Voucher_Date;
															asset_rec.Last_Transfer_Reference=row.Display_Name_Asset_Transfer_Voucher;
														}
														avail_rows = Available_Lists[Asset == row.Asset];
														for each  a in avail_rows
														{
															a.Current_Site=row.Site_To;
															a.Current_Custodian=row.Custodian_To;
															a.Last_Transfer_Date=row.Transfer_Voucher_Date;
															a.Last_Transfer_Reference=row.Display_Name_Asset_Transfer_Voucher;
														}
													}
												}
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete3 as "Finalize On Delete"
			{
				type =  form
				form = Asset_Transfer_Multiple_Voucher

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Transfer_Vouchers != null && input.Transfer_Vouchers.count() > 0)
										{
											for each  row in input.Transfer_Vouchers
											{
												if(row.Asset != null)
												{
													remaining_vouchers = Asset_Transfer_Voucher[Asset == row.Asset];
													latest_id = null;
													latest_date = null;
													latest_site_to = null;
													latest_custodian_to = null;
													latest_ref = null;
													for each  v in remaining_vouchers
													{
														this_id = v.ID;
														this_date = v.Transfer_Voucher_Date;
														if(latest_date == null)
														{
															latest_date = this_date;
															latest_id = this_id;
															latest_site_to = v.Site_To;
															latest_custodian_to = v.Custodian_To;
															latest_ref = v.Display_Name_Asset_Transfer_Voucher;
														}
														else
														{
															if(this_date > latest_date)
															{
																latest_date = this_date;
																latest_id = this_id;
																latest_site_to = v.Site_To;
																latest_custodian_to = v.Custodian_To;
																latest_ref = v.Display_Name_Asset_Transfer_Voucher;
															}
															else if(this_date == latest_date)
															{
																if(this_id > latest_id)
																{
																	latest_date = this_date;
																	latest_id = this_id;
																	latest_site_to = v.Site_To;
																	latest_custodian_to = v.Custodian_To;
																	latest_ref = v.Display_Name_Asset_Transfer_Voucher;
																}
															}
														}
													}
													if(latest_id != null)
													{
														site_text = "";
														custodian_text = "";
														if(latest_site_to != null)
														{
															site_text = ifnull(latest_site_to.Asset_Name,"") + " - " + ifnull(latest_site_to.Asset_ID,"");
														}
														if(latest_custodian_to != null)
														{
															custodian_text = ifnull(latest_custodian_to.Employee_Name,"") + " - " + ifnull(latest_custodian_to.Employee_Number,"");
														}
														asset_rec = Asset_List[ID == row.Asset];
														if(asset_rec.ID != null)
														{
															asset_rec.Current_Site=site_text;
															asset_rec.Current_Custodian=custodian_text;
															asset_rec.Last_Transfer_Date=latest_date;
															asset_rec.Last_Transfer_Reference=latest_ref;
														}
														avail_rows = Available_Lists[Asset == row.Asset];
														for each  a in avail_rows
														{
															a.Current_Site=latest_site_to;
															a.Current_Custodian=latest_custodian_to;
															a.Last_Transfer_Date=latest_date;
															a.Last_Transfer_Reference=latest_ref;
														}
													}
													else
													{
														asset_rec2 = Asset_List[ID == row.Asset];
														if(asset_rec2.ID != null)
														{
															asset_rec2.Current_Site=row.Old_Current_Site;
															asset_rec2.Current_Custodian=row.Old_Current_Custodian;
															asset_rec2.Last_Transfer_Date=row.Old_Last_Transfer_Date;
															asset_rec2.Last_Transfer_Reference=row.Old_Last_Transfer_Reference;
														}
														avail_rows2 = Available_Lists[Asset == row.Asset];
														for each  b in avail_rows2
														{
															b.Current_Site=row.Old_Current_Site;
															b.Current_Custodian=row.Old_Current_Custodian;
															b.Last_Transfer_Date=row.Old_Last_Transfer_Date;
															b.Last_Transfer_Reference=row.Old_Last_Transfer_Reference;
														}
													}
												}
											}
										}
						)
					}
				}

			}
			On_Asset_Selected5 as "On Asset Selected"
			{
				type =  form
				form = Asset_Transfer_Voucher

				record event = on add or edit

				on user input of Asset
				{
					actions 
					{
						custom deluge script
						(
											if(input.Asset != null)
										{
											asset_rec = Asset_List[ID == input.Asset];
											if(asset_rec.ID != null)
											{
												input.Display_Name_Asset = asset_rec.Asset_Name + " - " + asset_rec.Asset_ID;
												// Current Site text -> Asset_List lookup
												if(asset_rec.Current_Site != null && asset_rec.Current_Site != "")
												{
													site_rec = Asset_List[Display_Name_Asset_Name == asset_rec.Current_Site];
													if(site_rec.ID != null)
													{
														input.Old_Current_Site = site_rec.ID;
													}
													else
													{
														input.Old_Current_Site = null;
													}
												}
												else
												{
													input.Old_Current_Site = null;
												}
												// Leave custodian empty for now until correct Employee form link name is confirmed
												input.Old_Current_Custodian = null;
												input.Old_Last_Transfer_Date = asset_rec.Last_Transfer_Date;
												input.Old_Last_Transfer_Reference = asset_rec.Last_Transfer_Reference;
											}
											else
											{
												input.Display_Name_Asset = "";
												input.Old_Current_Site = null;
												input.Old_Current_Custodian = null;
												input.Old_Last_Transfer_Date = null;
												input.Old_Last_Transfer_Reference = "";
											}
										}
										else
										{
											input.Display_Name_Asset = "";
											input.Old_Current_Site = null;
											input.Old_Current_Custodian = null;
											input.Old_Last_Transfer_Date = null;
											input.Old_Last_Transfer_Reference = "";
										}
						)
					}
				}

			}
			Finalize_Snapshot_Safety as "Finalize Snapshot Safety"
			{
				type =  form
				form = Asset_Transfer_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Asset != null)
										{
											rec = Asset_Transfer_Voucher[ID == input.ID];
											if(rec.ID != null)
											{
												asset_rec = Asset_List[ID == input.Asset];
												if(asset_rec.ID != null)
												{
													if(rec.Old_Current_Site == null)
													{
														if(asset_rec.Current_Site != null && asset_rec.Current_Site != "")
														{
															site_rec = Asset_List[Display_Name_Asset_Name == asset_rec.Current_Site];
															if(site_rec.ID != null)
															{
																rec.Old_Current_Site=site_rec.ID;
															}
														}
													}
													if(rec.Old_Current_Custodian == null)
													{
														// leave blank for now until employee lookup conversion is confirmed
														rec.Old_Current_Custodian=null;
													}
													if(rec.Old_Last_Transfer_Date == null)
													{
														rec.Old_Last_Transfer_Date=asset_rec.Last_Transfer_Date;
													}
													if(rec.Old_Last_Transfer_Reference == null || rec.Old_Last_Transfer_Reference == "")
													{
														rec.Old_Last_Transfer_Reference=asset_rec.Last_Transfer_Reference;
													}
												}
											}
										}
						)
					}
				}

			}
			Set_Up_Form11 as "Set Up Form"
			{
				type =  form
				form = Asset_Transfer_Multiple_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ===== BACK END FIELDS =====
										hide User_Name;
										hide User_Email;
										hide User_Role;
										hide Created_By_Name;
										hide Created_By_Email;
										hide Created_By_Time;
										hide Updated_By_Name;
										hide Updated_By_Email;
										hide Updated_By_Time;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// ===== SUBFORM: Transfer_Vouchers =====
										hide Transfer_Vouchers.User_Name;
										hide Transfer_Vouchers.User_Email;
										hide Transfer_Vouchers.User_Role;
										hide Transfer_Vouchers.Created_By_Name;
										hide Transfer_Vouchers.Created_By_Email;
										hide Transfer_Vouchers.Created_By_Time;
										hide Transfer_Vouchers.Updated_By_Name;
										hide Transfer_Vouchers.Updated_By_Email;
										hide Transfer_Vouchers.Updated_By_Time;
										disable Transfer_Vouchers.User_Name;
										disable Transfer_Vouchers.User_Email;
										disable Transfer_Vouchers.User_Role;
										disable Transfer_Vouchers.Created_By_Name;
										disable Transfer_Vouchers.Created_By_Email;
										disable Transfer_Vouchers.Created_By_Time;
										disable Transfer_Vouchers.Updated_By_Name;
										disable Transfer_Vouchers.Updated_By_Email;
										disable Transfer_Vouchers.Updated_By_Time;
										//DISBALE FIELDS
										disable Display_Name_Asset_Transfer_Voucher;
										//HIDE FIELDS
										hide Display_Name_Asset_Transfer_Voucher;
										hide Asset_Transfer_Voucher;
										hide Employee_Voucher;
										//Transfer Vouchers
										//disable fields
										disable Transfer_Vouchers.Asset_Transfer_Voucher;
										disable Transfer_Vouchers.Display_Name_Asset_Transfer_Voucher;
										disable Transfer_Vouchers.Display_Name_Asset;
										disable Transfer_Vouchers.Transfer_Voucher_Date;
										disable Transfer_Vouchers.Site_From;
										disable Transfer_Vouchers.Details_From;
										disable Transfer_Vouchers.Custodian_From;
