											{
												row.Display_Name_Item_Labour="";
											}
										}
										// ===== RECALCULATE TOTALS (build LIST(Map) for your functions) =====
										parts_rows = List();
										for each  r in input.Parts_Consumables
										{
											m = Map();
											m.put("Item",r.Item);
											m.put("Labour",r.Labour);
											m.put("Quantity",r.Quantity);
											m.put("Unit Cost",r.Unit_Cost);
											parts_rows.add(m);
										}
										input.Parts_Total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
										input.Labour_Total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Parts_Total,input.Labour_Total);
						)
					}
				}

			}
			On_Unit_Cost_Selected1 as "On Unit Cost Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Parts_Consumables.Unit_Cost
				{
					actions 
					{
						custom deluge script
						(
											// 1) Always update THIS row line total
										row.Line_Total=thisapp.asset_calc.asset_calc_line_total(row.Quantity,row.Unit_Cost);
										// 2) Parent totals: only if the parent record already exists (Edit mode)
										if(input.ID != null)
										{
											rec = Work_Order_Tasks[ID == input.ID];
											// Only proceed if record exists
											if(rec.count() > 0)
											{
												parts_rows = List();
												for each  r in rec.Parts_Consumables
												{
													m = Map();
													m.put("Item",r.Item);
													m.put("Labour",r.Labour);
													m.put("Quantity",r.Quantity);
													m.put("Unit Cost",r.Unit_Cost);
													parts_rows.add(m);
												}
												parts_total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
												labour_total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
												grand_total = thisapp.asset_calc.asset_calc_grand_total(parts_total,labour_total);
												rec.Parts_Total=parts_total;
												rec.Labour_Total=labour_total;
												rec.Grand_Total=grand_total;
											}
										}
						)
					}
				}

			}
			Full_Validation2 as "Full Validation"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Work Order Tasks — Full Validation (Create + Edit)
										errors = "";
										is_create = input.ID == null;
										status = ifnull(input.Work_Order_Task_Status,"").trim();
										vst = ifnull(input.Vendor_Service_Type,"").trim();
										apply_required = false;
										if(is_create)
										{
											apply_required = true;
										}
										else if(status == "" || status == "Requested")
										{
											apply_required = true;
										}
										// 1) Cancel rule
										if(input.Cancel_This_Work_Order == true)
										{
											if(ifnull(input.Notes_why_Cancelled,"").trim() == "")
											{
												errors = errors + "\n• Notes why Cancelled is required when Cancel This Work Order is checked.";
											}
										}
										// 2) Approved odometer on edit
										if(input.ID != null)
										{
											if(input.Odometer_Reading_Approved == null)
											{
												errors = errors + "\n• Odometer Reading Approved is required on edit.";
											}
											else if(input.Odometer_Reading_Approved < 0)
											{
												errors = errors + "\n• Odometer Reading Approved cannot be negative.";
											}
										}
										// 3) Completed odometer
										if(input.ID != null && status == "Repairing")
										{
											if(input.Odometer_Reading_Completed == null)
											{
												errors = errors + "\n• Odometer Reading Completed is required when status is Repairing.";
											}
											else if(input.Odometer_Reading_Completed < 0)
											{
												errors = errors + "\n• Odometer Reading Completed cannot be negative.";
											}
										}
										// 4) Checking rules
										if(input.ID != null && status == "Checking")
										{
											if(input.Odometer_Reading_Checked == null)
											{
												errors = errors + "\n• Odometer Reading Checked is required when status is Checking.";
											}
											stc = input.Service_Task_Checkbox;
											if(stc == null || stc.size() != 3)
											{
												errors = errors + "\n• Service Task Checkbox: all items must be checked.";
											}
										}
										// 5) Required fields
										if(apply_required)
										{
											if(input.Asset == null)
											{
												errors = errors + "\n• Asset is required.";
											}
											if(input.Work_Order == null)
											{
												errors = errors + "\n• Work Order is required.";
											}
											if(vst == "")
											{
												errors = errors + "\n• Vendor Service Type is required.";
											}
											if(vst == "Items Only" && input.Store_Manager == null)
											{
												errors = errors + "\n• Store Manager is required.";
											}
											if(input.Odometer_Reading_Requested == null)
											{
												errors = errors + "\n• Odometer Reading Requested is required.";
											}
											if(vst == "Labour Only")
											{
												valid_labour_rows = 0;
												for each  r in input.Parts_Consumables
												{
													if(r.Labour != null)
													{
														valid_labour_rows = valid_labour_rows + 1;
													}
												}
												if(valid_labour_rows == 0)
												{
													errors = errors + "\n• At least one Labour row is required.";
												}
											}
										}
										// 6) Subform validation
										if(apply_required)
										{
											row_no = 0;
											for each  r in input.Parts_Consumables
											{
												row_no = row_no + 1;
												if(vst == "Items Only")
												{
													if(r.Item == null && r.Labour == null && r.Quantity == null && r.Unit_Cost == null && ifnull(r.Description,"").trim() == "")
													{
														continue;
													}
													if(r.Item == null)
													{
														errors = errors + "\n• Row " + row_no + ": Item is required (Items Only).";
													}
													if(r.Quantity == null)
													{
														errors = errors + "\n• Row " + row_no + ": Quantity is required (Items Only).";
													}
													else if(r.Quantity <= 0)
													{
														errors = errors + "\n• Row " + row_no + ": Quantity must be greater than 0 (Items Only).";
													}
													if(status != "Requested")
													{
														if(r.Unit_Cost == null)
														{
															errors = errors + "\n• Row " + row_no + ": Unit Cost is required (Items Only).";
														}
													}
													if(r.Unit_Cost != null && r.Unit_Cost < 0)
													{
														errors = errors + "\n• Row " + row_no + ": Unit Cost cannot be negative (Items Only).";
													}
												}
												else if(vst == "Labour Only")
												{
													if(r.Item == null && r.Labour == null && r.Quantity == null && r.Unit_Cost == null && ifnull(r.Description,"").trim() == "")
													{
														continue;
													}
													if(r.Labour == null)
													{
														errors = errors + "\n• Row " + row_no + ": Labour is required (Labour Only).";
													}
													if(r.Quantity == null)
													{
														errors = errors + "\n• Row " + row_no + ": Quantity is required (Labour Only).";
													}
													else if(r.Quantity <= 0)
													{
														errors = errors + "\n• Row " + row_no + ": Quantity must be greater than 0 (Labour Only).";
													}
													if(status != "Requested")
													{
														if(r.Unit_Cost == null)
														{
															errors = errors + "\n• Row " + row_no + ": Unit Cost is required (Labour Only).";
														}
													}
													if(r.Unit_Cost != null && r.Unit_Cost < 0)
													{
														errors = errors + "\n• Row " + row_no + ": Unit Cost cannot be negative (Labour Only).";
													}
												}
											}
										}
										// 7) Auto-calc totals
										parts_rows = List();
										for each  r in input.Parts_Consumables
										{
											if(r.Item != null || r.Labour != null && r.Quantity != null && r.Unit_Cost != null && r.Quantity > 0 && r.Unit_Cost >= 0)
											{
												r.Line_Total=thisapp.asset_calc.asset_calc_line_total(r.Quantity,r.Unit_Cost);
											}
											else
											{
												r.Line_Total=null;
											}
											m = Map();
											m.put("Item",r.Item);
											m.put("Labour",r.Labour);
											m.put("Quantity",r.Quantity);
											m.put("Unit Cost",r.Unit_Cost);
											parts_rows.add(m);
										}
										input.Parts_Total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
										input.Labour_Total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Parts_Total,input.Labour_Total);
										// 8) Odometer timeline validation
										if(input.Asset != null)
										{
											recorded_time = zoho.currenttime;
											if(input.Date_Time_Approved != null)
											{
												recorded_time = input.Date_Time_Approved;
											}
											else if(input.Date_Time_Work_Completed != null)
											{
												recorded_time = input.Date_Time_Work_Completed;
											}
											odo_val = 0.0;
											has_odo = false;
											if(input.Odometer_Reading_Approved != null)
											{
												odo_val = ifnull(input.Odometer_Reading_Approved,0.0).toDecimal();
												has_odo = true;
											}
											else if(input.Odometer_Reading_Completed != null)
											{
												odo_val = ifnull(input.Odometer_Reading_Completed,0.0).toDecimal();
												has_odo = true;
											}
											else if(input.Odometer_Reading_Requested != null)
											{
												odo_val = ifnull(input.Odometer_Reading_Requested,0.0).toDecimal();
												has_odo = true;
											}
											if(has_odo == true)
											{
												asset_rec = Asset_List[ID == input.Asset];
												unit_txt = "";
												if(asset_rec.ID != null)
												{
													unit_txt = ifnull(asset_rec.Odometer_Unit_Of_Measure,"").toLowerCase();
												}
												prev_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded < recorded_time && Void_Mileage == false || Void_Mileage == null] sort by Date_Time_Recorded desc;
												for each  prev in prev_logs
												{
													prev_odo = ifnull(prev.Odometer_Reading,0.0).toDecimal();
													if(odo_val < prev_odo)
													{
														errors = errors + "\n• Odometer cannot be less than previous valid mileage.";
													}
													diff = (odo_val - prev_odo).toDecimal();
													if(unit_txt == "hours" || unit_txt == "hour")
													{
														hours_passed_txt = prev.Date_Time_Recorded.hoursBetween(recorded_time);
														hours_passed_num = ifnull(hours_passed_txt.toDecimal(),0.0);
														if(hours_passed_num < 1.0)
														{
															hours_passed_num = 1.0;
														}
														if(diff > hours_passed_num)
														{
															errors = errors + "\n• Odometer is Beyond the Next Valid.";
														}
													}
													break;
												}
												next_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded > recorded_time && Void_Mileage == false || Void_Mileage == null] sort by Date_Time_Recorded asc;
												for each  nxt in next_logs
												{
													next_odo = ifnull(nxt.Odometer_Reading,0.0).toDecimal();
													if(odo_val > next_odo)
													{
														errors = errors + "\n• Odometer cannot be greater than next valid mileage.";
													}
													break;
												}
											}
										}
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize as "Finalize"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------------------------------------
										// BACK END AUDIT INFO
										// ------------------------------------------------------------
										u = thisapp.audit.getLoginAuditInfo();
										user_name_val = u.get("name");
										user_email_val = u.get("email");
										user_role_val = u.get("role");
										// ------------------------------------------------------------
										// Auto-fill Parts_Consumables.Display_Name_Work_Order_Task_Number
										// ------------------------------------------------------------
										taskNo = ifnull(input.Work_Order_Task_Number,"").trim();
										if(taskNo != "" && input.Parts_Consumables != null && input.Parts_Consumables.count() > 0)
										{
											for each  r in input.Parts_Consumables
											{
												r.Display_Name_Work_Order_Task_Number=taskNo;
											}
										}
										if(input.ID == null)
										{
											if(input.Work_Order != null)
											{
												thisapp.work_order_admin.update_work_order_totals(input.Work_Order.ID);
											}
											if(input.Issue != null)
											{
												thisapp.asset_issues.asset_issues_update_summary(input.Issue.ID);
											}
											return;
										}
										if(input.Cancel_This_Work_Order == true)
										{
											input.Work_Order_Task_Status = "Cancelled";
											input.Date_Time_Approved = zoho.currenttime;
											input.Approved_By_Email = u.get("email");
											if(input.Work_Order != null)
											{
												thisapp.work_order_admin.update_work_order_totals(input.Work_Order.ID);
											}
											if(input.Issue != null)
											{
												thisapp.asset_issues.asset_issues_update_summary(input.Issue.ID);
											}
											return;
										}
										current_status = ifnull(input.Work_Order_Task_Status,"Requested").trim();
										// ------------------------------------------------------------
										// 1) Requested -> Repairing
										// ------------------------------------------------------------
										if(current_status == "" || current_status == "Requested")
										{
											if(input.Odometer_Reading_Approved != null)
											{
												input.Work_Order_Task_Status = "Repairing";
												input.Date_Time_Approved = zoho.currenttime;
												input.Approved_By_Email = u.get("email");
												if(input.Asset != null)
												{
													source_form_text = "Work Order Task - Start";
													source_record_id_text = input.ID.toString();
													date_time_recorded = input.Date_Time_Approved;
													odometer_reading = ifnull(input.Odometer_Reading_Approved,0.0);
													reference_text = ifnull(input.Work_Order_Task_Number,"");
													notes_text = "Auto created from Work Order Task Start";
													unit_of_measure_text = ifnull(input.Asset.Odometer_Unit_Of_Measure,"");
													previous_odometer = 0.0;
													prev_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded < date_time_recorded] sort by Date_Time_Recorded desc;
													for each  pl in prev_logs
													{
														if(pl != null)
														{
															previous_odometer = ifnull(pl.Odometer_Reading,0.0);
															break;
														}
													}
													distance_since_last = odometer_reading - previous_odometer;
													if(distance_since_last < 0)
													{
														distance_since_last = 0.0;
													}
													existing_log = Asset_Mileage_Log[Odometer_Source_Form == source_form_text && Source_Record_ID == source_record_id_text];
													current_log_id = null;
													found_existing_log = false;
													for each  log_rec in existing_log
													{
														if(log_rec != null)
														{
															log_rec.Asset=input.Asset;
															log_rec.Date_Time_Recorded=date_time_recorded;
															log_rec.Odometer_Reading=odometer_reading;
															log_rec.Previous_Odometer=previous_odometer;
															log_rec.Distance_Since_Last=distance_since_last;
															log_rec.Reference=reference_text;
															log_rec.Notes=notes_text;
															log_rec.Unit_of_Measure=unit_of_measure_text;
															log_rec.User_Name=user_name_val;
															log_rec.User_Email=user_email_val;
															log_rec.User_Role=user_role_val;
															log_rec.Updated_By_Name=user_name_val;
															log_rec.Updated_By_Email=user_email_val;
															log_rec.Updated_By_Time=zoho.currenttime;
															current_log_id = log_rec.ID;
															found_existing_log = true;
															break;
														}
													}
													if(found_existing_log == false)
													{
														new_log = insert into Asset_Mileage_Log
														[
															Asset=input.Asset
															Date_Time_Recorded=date_time_recorded
															Odometer_Reading=odometer_reading
															Previous_Odometer=previous_odometer
															Distance_Since_Last=distance_since_last
															Reference=reference_text
															Notes=notes_text
															Odometer_Source_Form=source_form_text
															Source_Record_ID=source_record_id_text
															Unit_of_Measure=unit_of_measure_text
															User_Name=user_name_val
															User_Email=user_email_val
															User_Role=user_role_val
															Created_By_Name=user_name_val
															Created_By_Email=user_email_val
															Created_By_Time=zoho.currenttime
															Added_User=zoho.loginuser
														];
														current_log_id = new_log;
													}
													next_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded > date_time_recorded] sort by Date_Time_Recorded asc;
													for each  nx in next_logs
													{
														if(nx != null && nx.ID != current_log_id)
														{
															nx.Previous_Odometer=odometer_reading;
															new_next_distance = ifnull(nx.Odometer_Reading,0.0) - odometer_reading;
															if(new_next_distance < 0)
															{
																new_next_distance = 0.0;
															}
															nx.Distance_Since_Last=new_next_distance;
															break;
														}
													}
													asset_rec_for_start = Asset_List[ID == input.Asset];
													if(asset_rec_for_start.ID != null)
													{
														old_odo_start = ifnull(asset_rec_for_start.Odometer_Reading,0.0);
														if(odometer_reading > old_odo_start)
														{
															asset_rec_for_start.Odometer_Reading=odometer_reading;
															asset_rec_for_start.Date_Time_Odometer_Read=date_time_recorded;
														}
													}
												}
											}
										}
										// ------------------------------------------------------------
										// 2) Repairing -> Checking
										// ------------------------------------------------------------
										else if(current_status == "Repairing")
										{
											if(input.Odometer_Reading_Completed != null)
											{
												input.Work_Order_Task_Status = "Checking";
												input.Date_Time_Work_Completed = zoho.currenttime;
												input.Completed_By_Email = u.get("email");
												if(input.Asset != null)
												{
													source_form_text = "Work Order Task - Completed";
													source_record_id_text = input.ID.toString();
													date_time_recorded = input.Date_Time_Work_Completed;
													odometer_reading = ifnull(input.Odometer_Reading_Completed,0.0);
													reference_text = ifnull(input.Work_Order_Task_Number,"");
													notes_text = "Auto created from Work Order Task Completion";
													unit_of_measure_text = ifnull(input.Asset.Odometer_Unit_Of_Measure,"");
													previous_odometer = 0.0;
													prev_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded < date_time_recorded] sort by Date_Time_Recorded desc;
													for each  pl in prev_logs
													{
														if(pl != null)
														{
															previous_odometer = ifnull(pl.Odometer_Reading,0.0);
															break;
														}
													}
													distance_since_last = odometer_reading - previous_odometer;
													if(distance_since_last < 0)
													{
														distance_since_last = 0.0;
													}
													existing_log = Asset_Mileage_Log[Odometer_Source_Form == source_form_text && Source_Record_ID == source_record_id_text];
													current_log_id = null;
													found_existing_log = false;
													for each  log_rec in existing_log
													{
														if(log_rec != null)
														{
															log_rec.Asset=input.Asset;
															log_rec.Date_Time_Recorded=date_time_recorded;
															log_rec.Odometer_Reading=odometer_reading;
															log_rec.Previous_Odometer=previous_odometer;
															log_rec.Distance_Since_Last=distance_since_last;
															log_rec.Reference=reference_text;
															log_rec.Notes=notes_text;
															log_rec.Unit_of_Measure=unit_of_measure_text;
															log_rec.User_Name=user_name_val;
															log_rec.User_Email=user_email_val;
															log_rec.User_Role=user_role_val;
															log_rec.Updated_By_Name=user_name_val;
															log_rec.Updated_By_Email=user_email_val;
															log_rec.Updated_By_Time=zoho.currenttime;
															current_log_id = log_rec.ID;
															found_existing_log = true;
															break;
														}
													}
													if(found_existing_log == false)
													{
														new_log = insert into Asset_Mileage_Log
														[
															Asset=input.Asset
															Date_Time_Recorded=date_time_recorded
															Odometer_Reading=odometer_reading
															Previous_Odometer=previous_odometer
															Distance_Since_Last=distance_since_last
															Reference=reference_text
															Notes=notes_text
															Odometer_Source_Form=source_form_text
															Source_Record_ID=source_record_id_text
															Unit_of_Measure=unit_of_measure_text
															User_Name=user_name_val
															User_Email=user_email_val
															User_Role=user_role_val
															Created_By_Name=user_name_val
															Created_By_Email=user_email_val
															Created_By_Time=zoho.currenttime
															Added_User=zoho.loginuser
														];
														current_log_id = new_log;
													}
													next_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded > date_time_recorded] sort by Date_Time_Recorded asc;
													for each  nx in next_logs
													{
														if(nx != null && nx.ID != current_log_id)
														{
															nx.Previous_Odometer=odometer_reading;
															new_next_distance = ifnull(nx.Odometer_Reading,0.0) - odometer_reading;
															if(new_next_distance < 0)
															{
																new_next_distance = 0.0;
															}
															nx.Distance_Since_Last=new_next_distance;
															break;
														}
													}
													asset_rec_for_complete = Asset_List[ID == input.Asset];
													if(asset_rec_for_complete.ID != null)
													{
														old_odo_complete = ifnull(asset_rec_for_complete.Odometer_Reading,0.0);
														if(odometer_reading > old_odo_complete)
														{
															asset_rec_for_complete.Odometer_Reading=odometer_reading;
															asset_rec_for_complete.Date_Time_Odometer_Read=date_time_recorded;
														}
													}
												}
											}
										}
										// ------------------------------------------------------------
										// 3) Checking -> Invoicing
										// ------------------------------------------------------------
										else if(current_status == "Checking")
										{
											if(input.Odometer_Reading_Checked != null && input.Service_Task_Checkbox != null && input.Service_Task_Checkbox.size() == 3)
											{
												input.Work_Order_Task_Status = "Invoicing";
												input.Date_Time_Work_Checked = zoho.currenttime;
												input.Checked_By_Email = u.get("email");
												if(input.Issue != null)
												{
													thisapp.asset_issues.asset_issues_update_summary(input.Issue.ID);
												}
												// ------------------------------------------------------------
												// Insert Bill Details from Parts & Consumables
												// ------------------------------------------------------------
												if(input.Parts_Consumables != null && input.Parts_Consumables.count() > 0)
												{
													for each  pc_row in input.Parts_Consumables
													{
														if(pc_row.ID != null)
														{
															qty_val = ifnull(pc_row.Quantity,0.0);
															rate_val = ifnull(pc_row.Unit_Cost,0.0);
															line_total_val = round(qty_val * rate_val,2);
															source_text = ifnull(input.Work_Order_Task_Number,"") + " - Work Order Task";
															ref_text = "";
															if(input.Issue != null)
															{
																ref_text = "Issue Number = " + ifnull(input.Issue.Issue_Number,"") + " - " + ifnull(input.Issue.Issue,"");
															}
															if(input.Work_Order != null)
															{
																if(ref_text != "")
																{
																	ref_text = ref_text + ", ";
																}
																ref_text = ref_text + "Work Order Number = " + ifnull(input.Work_Order.Work_Order_Number,"");
															}
															account_text = "";
															current_site_text = "";
															if(input.Asset != null)
															{
																account_text = ifnull(input.Asset.Asset_Name,"") + " - " + ifnull(input.Asset.Asset_ID,"");
																current_site_text = ifnull(input.Asset.Current_Site,"");
															}
															existing_bd = Bill_Details[Parts_Consumables == pc_row.ID];
															if(existing_bd.count() > 0)
															{
																for each  bd in existing_bd
																{
																	bd.Source=source_text;
																	bd.Reference=ref_text;
																	bd.Parts_Consumables=pc_row.ID;
																	bd.Display_Name_Item=ifnull(pc_row.Display_Name_Item_Labour,"");
																	bd.Description=ifnull(pc_row.Description,"");
																	bd.Quantity=qty_val;
																	bd.Rate=rate_val;
																	bd.Line_Total=line_total_val;
																	bd.Account=account_text;
																	bd.Current_Site=current_site_text;
																	break;
																}
															}
															else
															{
																new_bd = insert into Bill_Details
																[
																	Source=source_text
																	Reference=ref_text
																	Parts_Consumables=pc_row.ID
																	Display_Name_Item=ifnull(pc_row.Display_Name_Item_Labour,"")
																	Description=ifnull(pc_row.Description,"")
																	Quantity=qty_val
																	Rate=rate_val
																	Line_Total=line_total_val
																	Account=account_text
																	Current_Site=current_site_text
																	Added_User=zoho.loginuser
																];
															}
															pc_row.Item_Status="Billed";
														}
													}
												}
												// ------------------------------------------------------------
												// Create / Update Asset Transaction Log
												// Checking -> Invoicing
												// ------------------------------------------------------------
												if(input.Asset != null)
												{
													amount_val = ifnull(input.Grand_Total,0.0);
													desc_text = "";
													desc_text = desc_text + "Work Order: " + ifnull(input.Work_Order.Work_Order_Number,"") + "\n";
													desc_text = desc_text + "Work Order Task: " + ifnull(input.Work_Order_Task_Number,"") + "\n";
													if(input.Issue != null)
													{
														desc_text = desc_text + "Issue: " + ifnull(input.Issue.Issue_Number,"") + " - " + ifnull(input.Issue.Issue,"") + "\n";
													}
													else
													{
														desc_text = desc_text + "Issue: \n";
													}
													desc_text = desc_text + "Vendor Service Type: " + ifnull(input.Vendor_Service_Type,"") + "\n";
													desc_text = desc_text + "Labour Total: " + ifnull(input.Labour_Total,0.0).toString() + "\n";
													desc_text = desc_text + "Parts Total: " + ifnull(input.Parts_Total,0.0).toString() + "\n";
													desc_text = desc_text + "Grand Total: " + amount_val.toString();
													payload = Map();
													payload.put("Transaction_Date",ifnull(input.Date_Time_Work_Checked,zoho.currenttime));
													payload.put("Transaction_Status","Posted");
													payload.put("Transaction_Description",desc_text);
													payload.put("Asset",input.Asset.ID);
													payload.put("Display_Name_Asset",ifnull(input.Display_Name_Asset,""));
													payload.put("Transaction_Direction","Expense");
													payload.put("Amount",amount_val);
													payload.put("Income",0.0);
													payload.put("Expenses",amount_val);
													payload.put("Application","Asset Management");
													payload.put("Source_Form","Work Order Tasks");
													payload.put("Source_Record_ID",input.ID);
													payload.put("Notes",ifnull(input.Work_Order_Task_Number,""));
													asset_txn_resp = thisapp.createOrUpdateAssetTransactionLog(payload);
													info asset_txn_resp;
												}
												// ------------------------------------------------------------
												// Finalize Asset Cost Summary
												// ------------------------------------------------------------
												if(input.Asset != null)
												{
													asset_summary_resp = thisapp.updateAssetCostSummaryFromConcrete(input.Asset.ID,input.Labour_Total,input.Parts_Total);
												}
												// ------------------------------------------------------------
												// Complete Work Order if all tasks are done
												// ------------------------------------------------------------
												if(input.Work_Order != null)
												{
													work_order_id_val = input.Work_Order.ID;
													wo_tasks = Work_Order_Tasks[Work_Order == work_order_id_val];
													total_wo_tasks = 0;
													open_wo_task_found = false;
													for each  wo_task_rec in wo_tasks
													{
														total_wo_tasks = total_wo_tasks + 1;
														wo_task_status = ifnull(wo_task_rec.Work_Order_Task_Status,"").trim();
														if(wo_task_rec.ID == input.ID)
														{
															wo_task_status = "Invoicing";
														}
														if(wo_task_status != "Invoicing" && wo_task_status != "Invoiced" && wo_task_status != "Cancelled")
														{
															open_wo_task_found = true;
														}
													}
													if(total_wo_tasks > 0 && open_wo_task_found == false)
													{
														wo_rec = Work_Order[ID == work_order_id_val];
														if(wo_rec.ID != null)
														{
															wo_rec.Status="Completed";
															wo_rec.Date_Completed=zoho.currenttime;
															wo_rec.Odometer_Reading_Completed=input.Odometer_Reading_Checked;
														}
													}
												}
												// ------------------------------------------------------------
												// Close Routine Issue if all issue tasks are invoicing
												// Also update matching Routine if this was a normal/emergency issue
												// ------------------------------------------------------------
												if(input.Issue != null)
												{
													issue_id_val = input.Issue.ID;
													all_tasks = Work_Order_Tasks[Issue == issue_id_val];
													total_tasks = 0;
													open_task_found = false;
													latest_odo = input.Odometer_Reading_Checked;
													for each  task_rec in all_tasks
													{
														total_tasks = total_tasks + 1;
														status_val = ifnull(task_rec.Work_Order_Task_Status,"").trim();
														if(task_rec.ID == input.ID)
														{
															status_val = "Invoicing";
														}
														if(status_val != "Invoicing" && status_val != "Invoiced" && status_val != "Cancelled")
														{
															open_task_found = true;
														}
														if(task_rec.Odometer_Reading_Checked != null)
														{
															latest_odo = task_rec.Odometer_Reading_Checked;
														}
													}
													if(total_tasks > 0 && open_task_found == false)
													{
														issue_rec = Asset_Issues[ID == issue_id_val];
														if(issue_rec.ID != null)
														{
															issue_rec.Status="Closed";
														}
														// ------------------------------------------------------------
														// A) Routine-created issue: update routine using Open_Issue_ID
														// ------------------------------------------------------------
														routine_rows = Routine_Issues[Open_Issue_ID == issue_id_val];
														for each  routine_rec in routine_rows
														{
															routine_rec.Open_Issue_ID=null;
															routine_rec.Last_Issue_Date=zoho.currentdate;
															routine_rec.Last_Done_Date=zoho.currentdate;
															if(latest_odo != null)
															{
																routine_rec.Last_Done_Odometer=latest_odo;
																if(routine_rec.Odometer_Frequency != null)
																{
																	routine_rec.Next_Done_Odometer=latest_odo + routine_rec.Odometer_Frequency;
																}
															}
															if(routine_rec.Frequency_Value != null && routine_rec.Date_Frequency != null)
															{
																if(routine_rec.Date_Frequency == "Days")
																{
																	routine_rec.Next_Done_Date=zoho.currentdate.addDay(routine_rec.Frequency_Value);
																}
																else if(routine_rec.Date_Frequency == "Weeks")
																{
																	routine_rec.Next_Done_Date=zoho.currentdate.addDay(routine_rec.Frequency_Value * 7);
																}
																else if(routine_rec.Date_Frequency == "Months")
																{
																	routine_rec.Next_Done_Date=zoho.currentdate.addMonth(routine_rec.Frequency_Value);
																}
																else if(routine_rec.Date_Frequency == "Years")
																{
																	routine_rec.Next_Done_Date=zoho.currentdate.addMonth(routine_rec.Frequency_Value * 12);
																}
															}
														}
														// ------------------------------------------------------------
														// B) Emergency/normal issue: update matching routine by Asset + Labour
														// ------------------------------------------------------------
														if(input.Asset != null && input.Parts_Consumables != null && input.Parts_Consumables.count() > 0)
														{
															for each  pc_row2 in input.Parts_Consumables
															{
																if(pc_row2.Labour != null)
																{
																	matching_routines = Routine_Issues[Asset == input.Asset && Labour == pc_row2.Labour && Status == "Active"];
																	for each  routine_rec2 in matching_routines
																	{
																		routine_rec2.Last_Issue_Date=zoho.currentdate;
																		routine_rec2.Last_Done_Date=zoho.currentdate;
																		if(latest_odo != null)
																		{
																			routine_rec2.Last_Done_Odometer=latest_odo;
																			if(routine_rec2.Odometer_Frequency != null)
																			{
																				routine_rec2.Next_Done_Odometer=latest_odo + routine_rec2.Odometer_Frequency;
																			}
																		}
																		if(routine_rec2.Frequency_Value != null && routine_rec2.Date_Frequency != null)
																		{
																			if(routine_rec2.Date_Frequency == "Days")
																			{
																				routine_rec2.Next_Done_Date=zoho.currentdate.addDay(routine_rec2.Frequency_Value);
																			}
																			else if(routine_rec2.Date_Frequency == "Weeks")
																			{
																				routine_rec2.Next_Done_Date=zoho.currentdate.addDay(routine_rec2.Frequency_Value * 7);
																			}
																			else if(routine_rec2.Date_Frequency == "Months")
																			{
																				routine_rec2.Next_Done_Date=zoho.currentdate.addMonth(routine_rec2.Frequency_Value);
																			}
																			else if(routine_rec2.Date_Frequency == "Years")
																			{
																				routine_rec2.Next_Done_Date=zoho.currentdate.addMonth(routine_rec2.Frequency_Value * 12);
																			}
																		}
																	}
																}
															}
														}
													}
												}
											}
										}
						)
					}
				}

			}
			On_Cancel_This_Work_Order as "On Cancel This Work Order Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Cancel_This_Work_Order
				{
					actions 
					{
						custom deluge script
						(
											if(Cancel_This_Work_Order == true)
										{
											enable Notes_why_Cancelled;
										}
						)
					}
				}

			}
			Full_Validation_On_Create2 as "Full Validation On Create"
			{
				type =  form
				form = Work_Order

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											prefix_key = "WAB";
										if(isNull(input.Work_Order_Number) || input.Work_Order_Number.trim() == "")
										{
											seq = Work_Order_Sequence[Prefix == prefix_key];
											if(seq.ID == null)
											{
												alert "Sequence not found for prefix " + prefix_key + ". Create it in Work_Order_Sequence.";
												cancel submit;
											}
											next_num = ifnull(seq.Next_Number,1);
											if(next_num > 999)
											{
												alert "Work Order numbers for " + prefix_key + " have reached the limit (999). Please update the prefix or reset the sequence.";
												cancel submit;
											}
											if(next_num < 10)
											{
												num_str = "00" + next_num;
											}
											else if(next_num < 100)
											{
												num_str = "0" + next_num;
											}
											else
											{
												num_str = "" + next_num;
											}
											new_wo = prefix_key + num_str;
											dupe = Work_Order[Work_Order_Number == new_wo];
											if(dupe.count() > 0)
											{
												alert "Duplicate detected (" + new_wo + "). Please try again.";
												cancel submit;
											}
											input.Work_Order_Number = new_wo;
											input.Work_Order_Date = zoho.currenttime;
											seq.Next_Number=next_num + 1;
										}
										// ======================================
										// WORK ORDER - ODOMETER VALIDATION
										// ======================================
										if(input.Asset != null && input.Odometer_Reading_Started != null)
										{
											recorded_time = zoho.currenttime;
											if(input.Work_Order_Date != null)
											{
												recorded_time = input.Work_Order_Date;
											}
											asset_rec = Asset_List[ID == input.Asset];
											unit_txt = "";
											if(asset_rec.ID != null)
											{
												unit_txt = ifnull(asset_rec.Odometer_Unit_Of_Measure,"").toLowerCase();
											}
											prev_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded < recorded_time && Void_Mileage == false || Void_Mileage == null] sort by Date_Time_Recorded desc;
											for each  prev in prev_logs
											{
												prev_odo = ifnull(prev.Odometer_Reading,0.0);
												if(input.Odometer_Reading_Started < prev_odo)
												{
													alert "Start Odometer cannot be less than previous valid mileage.";
													cancel submit;
												}
												diff = input.Odometer_Reading_Started - prev_odo;
												if(unit_txt == "hours" || unit_txt == "hour")
												{
													hours_passed = prev.Date_Time_Recorded.hoursBetween(recorded_time);
													if(hours_passed < 1)
													{
														hours_passed = 1;
													}
													if(diff > hours_passed)
													{
														alert "Odometer is Beyond the Next Valid.";
														cancel submit;
													}
												}
												break;
											}
										}
						)
					}
				}

			}
			Full_Validation_On_Create3 as "Full Validation On Create"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.ID == null)
										{
											prefix_value = "STF";
											seq_rec = Work_Order_Sequence[Prefix == prefix_value];
											if(seq_rec.count() == 0)
											{
												alert "Sequence not configured for STD in Work Order Sequence.";
												cancel submit;
											}
											// If you accidentally have multiple STD rows, stop
											if(seq_rec.count() > 1)
											{
												alert "Multiple STD rows found in Work Order Sequence. Keep only ONE.";
												cancel submit;
											}
											current_number = ifnull(seq_rec.Next_Number,1);
											if(current_number > 999)
											{
												alert "Maximum limit reached (STD999).";
												cancel submit;
											}
											formatted_number = current_number.toString();
											if(current_number < 10)
											{
												formatted_number = "00" + formatted_number;
											}
											else if(current_number < 100)
											{
												formatted_number = "0" + formatted_number;
											}
											input.Work_Order_Task_Number = prefix_value + formatted_number;
											seq_rec.Next_Number=current_number + 1;
										}
						)
					}
				}

			}
			Add_Row_Parts_Consumables as "Add Row Parts & Consumables"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on add row of Parts_Consumables
				{
					actions 
					{
						custom deluge script
						(
											// Display Work Order Task Number into the row (must exist in subform)
										row.Display_Name_Work_Order_Task_Number=input.Work_Order_Task_Number;
										// Line Number
										max_line = 0;
										for each  r in input.Parts_Consumables
										{
											if(r.Line_Number != null && r.Line_Number > max_line)
											{
												max_line = r.Line_Number;
											}
										}
										row.Line_Number=max_line + 1;
						)
					}
				}

			}
			Set_Up_Form8 as "Set Up Form"
			{
				type =  form
				form = Asset_Transfer_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ===== BACK END FIELDS =====
										hide User_Name;
										hide User_Email;
										hide User_Role;
										hide Created_By_Name;
