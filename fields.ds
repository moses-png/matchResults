				format = commadotwestern
	 			row = 5
	 			column = 1   
				width = medium
			)
			Amount_Due
			(
				displayname = "Amount Due"
				type = UGX
				format = commadotwestern
				decimalplace = 0
	 			row = 5
	 			column = 1   
				width = medium
			)
			Amount_Paid
			(
				displayname = "Amount Paid"
				type = UGX
				format = commadotwestern
	 			row = 5
	 			column = 1   
				width = medium
			)
			Balance_Due
			(
				displayname = "Balance Due"
				type = UGX
				format = commadotwestern
				decimalplace = 0
	 			row = 5
	 			column = 1   
				width = medium
			)
			Bill_Status
			(
				type = picklist
				displayname = "Bill Status"
				maxchar = 100
				values = {"Draft","Billed","Cancelled"}
				initial value = "Draft"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Payment_Status
			(
				type = picklist
				displayname = "Payment Status"
				maxchar = 100
				values = {"Not Paid","Partially Paid","Paid"}
