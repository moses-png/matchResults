			On_Transfer_Item_Selected as "On Transfer Item Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Transfer_Item
				{
					actions 
					{
						custom deluge script
						(
											if(input.Transfer_Item != null)
										{
											// =====================================================
											// DISPLAY NAME TRANSFER ITEM
											// =====================================================
											Display_Name_Transfer_Item = ifnull(input.Transfer_Item.Transfer_Number,"");
											// =====================================================
											// CLEAR FIELDS BEFORE FILLING
											// =====================================================
											input.Display_Name_Item = null;
											input.Quantity_to_Receive = null;
											input.Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_to_Receive = null;
											input.Quantity_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											// =====================================================
											// ITEM DISPLAY NAME
											// =====================================================
											input.Display_Name_Item = ifnull(input.Transfer_Item.Display_Name_Item,"");
											// Enrich display name from the linked item
											if(input.Transfer_Item.Item != null)
											{
												itemName = ifnull(input.Transfer_Item.Item.Item_Name,"");
												itemSKU = ifnull(input.Transfer_Item.Item.SKU,"");
												if(itemName != "" && itemSKU != "")
												{
													input.Display_Name_Item = itemName + " - " + itemSKU;
												}
												else if(itemName != "")
												{
													input.Display_Name_Item = itemName;
												}
											}
											// =====================================================
											// UNIT OF MEASURE
											// Use values already saved on Stock Transfer Form
											// =====================================================
											if(input.Transfer_Item.Unit_Of_Measure != null)
											{
												input.Unit_Of_Measure_Received = input.Transfer_Item.Unit_Of_Measure;
											}
											uom_display = ifnull(input.Transfer_Item.Display_Name_Unit_of_Measure,"");
											input.Display_Name_Unit_Of_Measure_Received = uom_display;
											input.Display_Name_Unit_Of_Measure_to_Receive = uom_display;
											// =====================================================
											// QUANTITY REMAINING
											// =====================================================
											qty_sent = ifnull(input.Transfer_Item.Quantity,0.0);
											qty_already_received = ifnull(input.Transfer_Item.Quantity_Received,0.0);
											qty_remaining = qty_sent - qty_already_received;
											if(qty_remaining < 0)
											{
												qty_remaining = 0.0;
											}
											if(qty_remaining > 0)
											{
												input.Quantity_to_Receive = qty_remaining;
											}
											else
											{
												input.Quantity_to_Receive = null;
												info "This transfer has already been fully received.";
											}
											// =====================================================
											// STOCK CONDITION
											// =====================================================
											transfer_condition = ifnull(input.Transfer_Item.Stock_Condition,"").trim();
											if(transfer_condition != "")
											{
												input.Stock_Condition = transfer_condition;
											}
											else
											{
												input.Stock_Condition = "New";
											}
											// =====================================================
											// USER ENTERS ACTUAL QUANTITY RECEIVED
											// =====================================================
											input.Quantity_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										}
										else
										{
											Display_Name_Transfer_Item = null;
											input.Display_Name_Item = null;
											input.Quantity_to_Receive = null;
											input.Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_to_Receive = null;
											input.Quantity_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Stock_Condition = null;
										}
						)
					}
				}

			}
			On_Unit_Of_Measure_Receiv as "On Unit Of Measure Received Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Unit_Of_Measure_Received
				{
					actions 
					{
						custom deluge script
						(
											// ----------------------------------------
										// ON UNIT OF MEASURE RECEIVED SELECTED
										// ----------------------------------------
										if(input.Unit_Of_Measure_Received != null)
										{
											input.Display_Name_Unit_Of_Measure_Received = input.Unit_Of_Measure_Received.Unit_Of_Measure_Name;
										}
										else
										{
											input.Display_Name_Unit_Of_Measure_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										// =====================================================
										// LOAD SOURCE DETAILS
										// =====================================================
										issue_rec = null;
										if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
										}
										// =====================================================
										// INTERNAL TRANSFER UOM VALIDATION
										// =====================================================
										if(input.Receiving_Type == "Internal Transfer")
										{
											if(input.Transfer_Item == null)
											{
												alert "Stock Transfer Item is required.";
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
											transfer_uom_id = input.Transfer_Item.Unit_Of_Measure;
											transfer_display_uom = ifnull(input.Transfer_Item.Display_Name_Unit_of_Measure,"");
											if(transfer_uom_id != null && input.Unit_Of_Measure_Received != transfer_uom_id)
											{
												alert "For Internal Transfer, Unit Of Measure Received must be the same as the transferred Unit Of Measure.";
												input.Unit_Of_Measure_Received = transfer_uom_id;
												input.Display_Name_Unit_Of_Measure_Received = transfer_display_uom;
												input.Display_Name_Unit_Of_Measure_to_Receive = transfer_display_uom;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										// =====================================================
										// STOCK RETURN / TOOL RETURN UOM VALIDATION
										// =====================================================
										else if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return")
										{
											if(issue_rec != null && issue_rec.ID != null && issue_rec.Unit_Of_Measure != null && input.Unit_Of_Measure_Received != issue_rec.Unit_Of_Measure)
											{
												alert "For " + input.Receiving_Type + ", Unit Of Measure Received must be the same as the issued Unit Of Measure.";
												input.Unit_Of_Measure_Received = issue_rec.Unit_Of_Measure;
												input.Display_Name_Unit_Of_Measure_Received = issue_rec.Unit_Of_Measure.Unit_Of_Measure_Name;
												input.Display_Name_Unit_Of_Measure_to_Receive = issue_rec.Unit_Of_Measure.Unit_Of_Measure_Name;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										// =====================================================
										// GET ACTUAL ITEM ID
										// =====================================================
										item_id = null;
										// -----------------------------------------------------
										// PURCHASE ORDER
										// -----------------------------------------------------
										if(input.Receiving_Type == "Purchase Order")
										{
											if(input.Item != null)
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID != null && po_det.Item != null)
												{
													item_id = po_det.Item;
												}
											}
										}
										// -----------------------------------------------------
										// INTERNAL TRANSFER
										// -----------------------------------------------------
										else if(input.Receiving_Type == "Internal Transfer")
										{
											if(input.Transfer_Item != null && input.Transfer_Item.Item != null)
											{
												item_id = input.Transfer_Item.Item;
											}
										}
										// -----------------------------------------------------
										// STOCK RETURN / TOOL RETURN
										// -----------------------------------------------------
										else if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return")
										{
											if(issue_rec != null && issue_rec.ID != null && issue_rec.Item != null)
											{
												item_id = issue_rec.Item;
											}
										}
										// -----------------------------------------------------
										// OTHER RECEIVING TYPES
										// -----------------------------------------------------
										else
										{
											if(input.Item != null)
											{
												item_id = input.Item;
											}
										}
										// =====================================================
										// CONVERT RECEIVED QUANTITY TO BASE UOM
										// =====================================================
										if(item_id != null && input.Unit_Of_Measure_Received != null && input.Quantity_Received != null && input.Quantity_Received > 0)
										{
											check = store_management.po.check_uom_conversion_from_masaka_site_management(item_id,input.Unit_Of_Measure_Received);
											if(check != null && check.get("ok") == true)
											{
												recalc_resp = store_management.po.recalculate_po_detail_line_from_masaka_site_management(item_id,input.Unit_Of_Measure_Received,input.Quantity_Received,ifnull(input.Rate,0.0));
												if(recalc_resp != null)
												{
													base_qty = ifnull(recalc_resp.get("qty_in_base"),0.0);
													if(base_qty > 0)
													{
														input.Quantity_in_Base_Unit_Of_Measure_Received = base_qty.round(2);
													}
													else
													{
														input.Quantity_in_Base_Unit_Of_Measure_Received = null;
													}
												}
												else
												{
													alert "No response was returned while converting the received quantity.";
													input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												}
											}
											else
											{
												error_message = "UOM conversion failed.";
												if(check != null)
												{
													error_message = ifnull(check.get("message"),error_message);
												}
												alert error_message;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											}
										}
										else
										{
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										}
										// =====================================================
										// INTERNAL TRANSFER QUANTITY SAFETY
										// =====================================================
										if(input.Receiving_Type == "Internal Transfer" && input.Transfer_Item != null && input.Quantity_Received != null && input.Quantity_Received > 0)
										{
											quantity_sent = ifnull(input.Transfer_Item.Quantity,0.0);
											quantity_already_received = ifnull(input.Transfer_Item.Quantity_Received,0.0);
											quantity_remaining = quantity_sent - quantity_already_received;
											if(quantity_remaining < 0)
											{
												quantity_remaining = 0.0;
											}
											if(input.Quantity_Received > quantity_remaining)
											{
												alert "Quantity Received cannot exceed the remaining transferred quantity of " + quantity_remaining + ".";
												input.Quantity_Received = null;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										// =====================================================
										// LINE TOTAL
										// =====================================================
										if(input.Quantity_Received != null && input.Quantity_Received > 0 && input.Rate != null && input.Rate >= 0)
										{
											input.Line_Total = (input.Quantity_Received * input.Rate).round(2);
										}
										else
										{
											input.Line_Total = null;
										}
						)
					}
				}

			}
			Full_Validation13 as "Full Validation"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// STOCK RECEIVING DETAILS
										// FULL VALIDATION
										// =======================================
										errors = List();
										rtype = ifnull(input.Receiving_Type,"").trim();
										stock_cond = ifnull(input.Stock_Condition,"").trim();
										qty_received = ifnull(input.Quantity_Received,0.0);
										old_rec = null;
										if(input.ID != null)
										{
											old_rec = Stock_Receiving_Details[ID == input.ID];
										}
										if(input.Stock_Receiving_Voucher == null)
										{
											errors.add("• Please select the Stock Receiving Voucher.");
										}
										else
										{
											srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
											if(srv.ID == null || srv.Store == null)
											{
												errors.add("• The selected Stock Receiving Voucher has no destination Store.");
											}
											else
											{
												destination_store = srv.Store;
											}
										}
										if(input.Stock_Receiving_Voucher_Number == null || input.Stock_Receiving_Voucher_Number <= 0)
										{
											errors.add("• Stock Receiving Voucher Number is required.");
										}
										if(input.Stock_Receiving_Voucher != null && input.Stock_Receiving_Voucher_Number != null)
										{
											dup = Stock_Receiving_Details[Stock_Receiving_Voucher == input.Stock_Receiving_Voucher && Stock_Receiving_Voucher_Number == input.Stock_Receiving_Voucher_Number && ID != input.ID];
											if(dup.count() > 0)
											{
												errors.add("• This Stock Receiving Voucher Number has already been.");
											}
										}
										if(rtype == "")
										{
											errors.add("• Please select Receiving Type.");
										}
										if(stock_cond == "")
										{
											errors.add("• Stock Condition is required.");
										}
										if(qty_received <= 0)
										{
											errors.add("• Quantity Received must be greater than zero.");
										}
										if(input.Unit_Of_Measure_Received == null)
										{
											errors.add("• Unit Of Measure Received is required.");
										}
										actual_item_id = null;
										actual_item_rec = null;
										po_det = null;
										issue_rec = null;
										selected_issue_id = null;
										// =======================================
										// RECEIVING TYPE VALIDATION
										// =======================================
										if(rtype == "Purchase Order")
										{
											if(input.Purchase_Order == null)
											{
												errors.add("• Purchase Order is required.");
											}
											else if(input.Item == null)
											{
												errors.add("• Purchase Order line Item is required.");
											}
											else
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID == null || po_det.Item == null)
												{
													errors.add("• The selected Purchase Order line is invalid.");
												}
												else
												{
													actual_item_id = po_det.Item;
													po_stock_cond = ifnull(po_det.Stock_Condition,"").trim();
													if(po_stock_cond == "")
													{
														errors.add("• The selected Purchase Order line has no Stock Condition.");
													}
													else if(stock_cond != po_stock_cond)
													{
														errors.add("• Stock Condition must match PO line. PO has: " + po_stock_cond + ".");
													}
												}
											}
											if(input.Voucher != null || input.Internal_Transfer_Number != null || input.Stock_Return_Number != null || input.Tool_Return_Number != null || input.Transfer_Item != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Purchase Order, only Purchase Order fields should be filled.");
											}
										}
										// -----------------------------------------------------
										// INTERNAL TRANSFER
										// -----------------------------------------------------
										else if(rtype == "Internal Transfer")
										{
											if(input.Internal_Transfer_Number == null)
											{
												errors.add("• Internal Transfer Number is required.");
											}
											else if(input.Transfer_Item == null)
											{
												errors.add("• Stock Transfer Item is required.");
											}
											else
											{
												transfer_qty = ifnull(input.Transfer_Item.Quantity,0.0);
												transfer_received_qty = ifnull(input.Transfer_Item.Quantity_Received,0.0);
												transfer_remaining_qty = transfer_qty - transfer_received_qty;
												if(transfer_remaining_qty < 0)
												{
													transfer_remaining_qty = 0.0;
												}
												transfer_base_qty = ifnull(input.Transfer_Item.Quantity_in_Base_Unit_Of_Measure,0.0);
												transfer_base_received_qty = ifnull(input.Transfer_Item.Quantity_Received_in_Base_Unit_Of_Measure,0.0);
												transfer_base_remaining_qty = transfer_base_qty - transfer_base_received_qty;
												if(transfer_base_remaining_qty < 0)
												{
													transfer_base_remaining_qty = 0.0;
												}
												transfer_uom_id = input.Transfer_Item.Unit_Of_Measure;
												transfer_status = ifnull(input.Transfer_Item.Receiving_Status,"Not Received");
												source_store = input.Transfer_Item.Issuing_Store;
												transfer_stock_condition = ifnull(input.Transfer_Item.Stock_Condition,"");
												actual_item_id = input.Transfer_Item.Item;
											}
											if(input.Purchase_Order != null || input.Item != null || input.Voucher != null || input.Stock_Return_Number != null || input.Tool_Return_Number != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Internal Transfer receiving, only Internal Transfer fields should be filled.");
											}
										}
										else if(rtype == "Stock Return")
										{
											if(input.Stock_Return_Number == null)
											{
												errors.add("• Stock Return Number is required.");
											}
											else if(input.Item_Issuing_Details == null)
											{
												errors.add("• Stock Return Item Issuing Details is required.");
											}
											else
											{
												selected_issue_id = input.Item_Issuing_Details;
												issue_rec = Item_Issuing_Details[ID == selected_issue_id];
												if(issue_rec.ID == null || issue_rec.Item == null)
												{
													errors.add("• The selected Stock Return Item Issuing Details record is invalid.");
												}
												else
												{
													actual_item_id = issue_rec.Item;
												}
											}
											if(input.Purchase_Order != null || input.Item != null || input.Voucher != null || input.Internal_Transfer_Number != null || input.Tool_Return_Number != null || input.Transfer_Item != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Stock Return, only Stock Return fields should be filled.");
											}
										}
										else if(rtype == "Tool Return")
										{
											if(input.Tool_Return_Number == null)
											{
												errors.add("• Tool Return Number is required.");
											}
											else if(input.Item_Issuing_Details == null)
											{
												errors.add("• Tool Return Item Issuing Details is required.");
											}
											else
											{
												selected_issue_id = input.Item_Issuing_Details;
												issue_rec = Item_Issuing_Details[ID == selected_issue_id];
												if(issue_rec.ID == null || issue_rec.Item == null)
												{
													errors.add("• The selected Tool Return Item Issuing Details record is invalid.");
												}
												else
												{
													actual_item_id = issue_rec.Item;
												}
											}
											if(input.Purchase_Order != null || input.Item != null || input.Voucher != null || input.Internal_Transfer_Number != null || input.Stock_Return_Number != null || input.Transfer_Item != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Tool Return, only Tool Return fields should be filled.");
											}
										}
										else if(rtype != "")
										{
											errors.add("• Unsupported Receiving Type.");
										}
										base_qty = null;
										input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										if(actual_item_id != null && input.Unit_Of_Measure_Received != null && qty_received > 0)
										{
											check = store_management.po.check_uom_conversion_from_concrete(actual_item_id,input.Unit_Of_Measure_Received);
											if(check == null || check.get("ok") != true)
											{
												errors.add("• " + ifnull(check.get("message"),"UOM conversion failed."));
											}
											else
											{
												base_qty = store_management.po.convert_to_base_qty_from_concrete(actual_item_id,input.Unit_Of_Measure_Received,input.Quantity_Received);
												if(base_qty == null || base_qty <= 0)
												{
													errors.add("• Calculated base quantity is invalid.");
												}
												else
												{
													input.Quantity_in_Base_Unit_Of_Measure_Received = base_qty;
												}
											}
										}
										if(rtype == "Purchase Order" && po_det != null && po_det.ID != null)
										{
											qty_remaining = ifnull(po_det.Quantity_Remaining,0.0);
											old_qty_this_row = 0.0;
											if(old_rec != null && old_rec.ID != null)
											{
												old_qty_this_row = ifnull(old_rec.Quantity_Received,0.0);
											}
											max_allowed = qty_remaining + old_qty_this_row;
											if(qty_received > max_allowed)
											{
												errors.add("• You cannot receive more than Quantity Remaining. Maximum allowed: " + max_allowed + ".");
											}
										}
										is_transfer_return = false;
										if(rtype == "Internal Transfer")
										{
											is_transfer_return = true;
										}
										else if(rtype == "Stock Return")
										{
											is_transfer_return = true;
										}
										else if(rtype == "Tool Return")
										{
											is_transfer_return = true;
										}
										if(is_transfer_return == true && issue_rec != null && issue_rec.ID != null)
										{
											if(ifnull(issue_rec.Status,"") == "Cancelled")
											{
												errors.add("• Cancelled issuing records cannot be received.");
											}
											issued_qty = ifnull(issue_rec.Quantity,0.0);
											returned_qty = ifnull(issue_rec.Quantity_Returned,0.0);
											remaining_issue_qty = issued_qty - returned_qty;
											if(remaining_issue_qty < 0)
											{
												remaining_issue_qty = 0.0;
											}
											if(remaining_issue_qty <= 0)
											{
												errors.add("• This issuing record has already been fully received.");
											}
											else if(qty_received > remaining_issue_qty)
											{
												errors.add("• You cannot receive more than the remaining issued quantity.");
											}
											if(issue_rec.Unit_Of_Measure != null && input.Unit_Of_Measure_Received != null && input.Unit_Of_Measure_Received != issue_rec.Unit_Of_Measure)
											{
												errors.add("• Unit Of Measure Received must match the issued Unit Of Measure.");
											}
											if(rtype == "Internal Transfer")
											{
												existing_transfer = Stock_Receiving_Details[Receiving_Type == "Internal Transfer" && Transfer_Item == selected_issue_id && ID != input.ID];
												if(existing_transfer.count() > 0)
												{
													errors.add("• This Item Issuing Details record has already been received as an Internal Transfer.");
												}
												if(input.Quantity_to_Receive != null && qty_received != input.Quantity_to_Receive)
												{
													errors.add("• For Internal Transfer, Quantity Received must exactly match Quantity to Receive.");
												}
												source_store = "";
												destination_store_name = "";
												if(issue_rec.Issuing_Voucher != null)
												{
													iss_hdr = Item_Issuing_Voucher[ID == issue_rec.Issuing_Voucher];
													if(iss_hdr.ID != null)
													{
														source_store = ifnull(iss_hdr.Display_Name_Store,"").trim();
													}
												}
												if(srv != null && srv.ID != null)
												{
													destination_store_name = ifnull(srv.Display_Name_Store,"").trim();
												}
												if(source_store == "")
												{
													errors.add("• The source Item Issuing Voucher has no Store.");
												}
												else if(destination_store_name != "" && source_store == destination_store_name)
												{
													errors.add("• Source Store and Destination Store cannot be the same for Internal Transfer.");
												}
											}
											else if(rtype == "Stock Return")
											{
											}
											else if(rtype == "Tool Return")
											{
												if(stock_cond == "New")
												{
													errors.add("• Tool Return cannot be received as New.");
												}
											}
										}
										if(errors.size() > 0)
										{
											msg = "Please fix the following:\n\n";
											for each  err_msg in errors
											{
												msg = msg + err_msg + "\n";
											}
											alert msg;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize_On_Create19 as "Finalize On Create"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// STOCK RECEIVING DETAILS - FINALIZE
										// ======================================================
										// 1) AUDIT
										u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
										// 2) RESOLVE RECEIVING HEADER / STORE
										srv_found = false;
										store_id = null;
										srv_name = "";
										srv_store_display = "";
										srv_received_by = "";
										for each  srv in Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher]
										{
											srv_found = true;
											store_id = srv.Store;
											srv_name = ifnull(srv.Display_Name_Stock_Receiving_Book,"").trim();
											srv_store_display = ifnull(srv.Display_Name_Store,"");
											srv_received_by = ifnull(srv.Received_By,"");
											break;
										}
										if(srv_found == false || store_id == null)
										{
											return;
										}
										// 3) BUILD RECEIVING VOUCHER NUMBER
										num_txt = "";
										if(input.Stock_Receiving_Voucher_Number != null && input.Stock_Receiving_Voucher_Number > 0)
										{
											if(input.Stock_Receiving_Voucher_Number < 10)
											{
												num_txt = "0" + input.Stock_Receiving_Voucher_Number.toString();
											}
											else
											{
												num_txt = input.Stock_Receiving_Voucher_Number.toString();
											}
										}
										if(srv_name != "" && num_txt != "")
										{
											input.Stock_Receiving_Voucher_and_Number = srv_name + "-" + num_txt;
										}
										else if(srv_name != "")
										{
											input.Stock_Receiving_Voucher_and_Number = srv_name;
										}
										else
										{
											input.Stock_Receiving_Voucher_and_Number = null;
										}
										ref_no = ifnull(input.Stock_Receiving_Voucher_and_Number,"").trim();
										if(ref_no == "")
										{
											ref_no = input.ID.toString();
										}
										// 4) REFRESH DISPLAY FIELDS
										input.Display_Name_Stock_Receiving_Voucher = srv_name;
										input.Store = srv_store_display;
										input.Display_Name_Received_By = srv_received_by;
										// 5) COMMON VALUES
										rtype = ifnull(input.Receiving_Type,"").trim();
										qty = ifnull(input.Quantity_Received,0.0);
										uom_id = input.Unit_Of_Measure_Received;
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
										}
										if(qty <= 0 || uom_id == null)
										{
											return;
										}
										// =====================================================
										// 6) RESOLVE ACTUAL ITEM + COST SOURCE
										// =====================================================
										actual_item_id = null;
										po_detail_id = null;
										po_unit_cost = 0.0;
										base_uom_name = "";
										// -----------------------------------------------------
										// PURCHASE ORDER
										// -----------------------------------------------------
										if(rtype == "Purchase Order" && input.Item != null)
										{
											po_det = Purchase_Order_Details[ID == input.Item];
											if(po_det.ID != null && po_det.Item != null)
											{
												po_detail_id = po_det.ID;
												actual_item_id = po_det.Item;
												po_unit_cost = ifnull(po_det.Unit_Cost,0.0);
												base_uom_name = ifnull(po_det.Display_Name_Unit_Of_Measure,"");
											}
										}
										// -----------------------------------------------------
										// INTERNAL TRANSFER
										// -----------------------------------------------------
										else if(rtype == "Internal Transfer" && input.Transfer_Item != null)
										{
											transfer_id_val = input.Transfer_Item.ID;
											if(transfer_id_val == null || transfer_id_val <= 0)
											{
												info "Stock Transfer ID is invalid.";
												return;
											}
											if(input.Transfer_Item.Item != null)
											{
												actual_item_id = input.Transfer_Item.Item;
											}
											else
											{
												info "The selected Stock Transfer record has no Item.";
												return;
											}
											receive_payload = Map();
											receive_payload.put("Transfer_ID",transfer_id_val);
											receive_payload.put("Receiving_Number",ifnull(input.Stock_Receiving_Voucher_and_Number,""));
											receive_payload.put("Receive_Date",zoho.currentdate);
											receive_payload.put("Receiving_Store",input.Store);
											receive_payload.put("Quantity_Received",qty);
											receive_payload.put("Unit_Of_Measure_Received",uom_id);
											receive_payload.put("Quantity_Received_in_Base_Unit_Of_Measure",ifnull(input.Quantity_in_Base_Unit_Of_Measure_Received,0.0));
											receive_payload.put("Received_By",ifnull(srv_received_by,""));
											receive_payload.put("Receive_Application","Kicks Klean Ug");
											receive_payload.put("Receive_Source_Form","Stock Receiving Details");
											receive_payload.put("Receive_Source_Record_ID",input.ID);
											receive_resp = store_management.stock_transfer.update_transfer_receiving_details(receive_payload);
											info receive_resp;
											if(receive_resp == null || receive_resp.get("ok") != true)
											{
												error_message = "Stock Transfer receiving synchronization failed.";
												if(receive_resp != null)
												{
													error_message = ifnull(receive_resp.get("message"),error_message);
												}
												info error_message;
												return;
											}
											if(receive_resp.get("base_quantity_received") != null)
											{
												input.Quantity_in_Base_Unit_Of_Measure_Received = receive_resp.get("base_quantity_received").toDecimal();
											}
											if(receive_resp.get("unit_cost_base") != null)
											{
												po_unit_cost = receive_resp.get("unit_cost_base").toDecimal();
											}
											else if(input.Transfer_Item.Unit_Cost != null)
											{
												po_unit_cost = ifnull(input.Transfer_Item.Unit_Cost,0.0);
											}
											else
											{
												po_unit_cost = ifnull(input.Rate,0.0);
											}
										}
										// -----------------------------------------------------
										// STOCK RETURN / TOOL RETURN
										// -----------------------------------------------------
										else if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_item_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_item_rec.ID != null)
											{
												actual_item_id = issue_item_rec.Item;
											}
										}
										// -----------------------------------------------------
										// FINAL ITEM CHECK
										// -----------------------------------------------------
										if(actual_item_id == null)
										{
											info "Actual item could not be resolved for receiving type: " + rtype;
											return;
										}
										// 7) RESOLVE COST
										cost_for_store_default = 0.0;
										if(rtype == "Purchase Order")
										{
											cost_for_store_default = po_unit_cost;
										}
										else if(rtype == "Internal Transfer")
										{
											cost_for_store_default = ifnull(input.Rate,0.0);
										}
										else if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_cost_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_cost_rec.ID != null)
											{
												cost_for_store_default = ifnull(issue_cost_rec.Cost,0.0);
											}
										}
										else
										{
											cost_for_store_default = ifnull(input.Rate,0.0);
										}
										input.Rate = cost_for_store_default;
										input.Line_Total = (qty * cost_for_store_default).round(2);
										resp = store_management.stock.receive_stock_from_Kicksklean(actual_item_id,store_id,srv_store_display,qty,uom_id,cond,cost_for_store_default,ref_no,input.ID);
										info resp;
										if(resp == null || resp.get("ok") != true)
										{
											if(resp != null)
											{
												info resp.get("message");
											}
											input.Stock_Receiving_Details_Status = "Draft";
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure_Received = ifnull(resp.get("base_qty"),0.0);
										input.Stock_Receiving_Details_Status = "Received";
										// 8b) CREATE BILL DETAILS FOR PURCHASE ORDERS
										if(rtype == "Purchase Order" && cond != "Used")
										{
											details_date_val = zoho.currentdate;
											details_val = "";
											if(input.Display_Name_Voucher != null && input.Display_Name_Voucher != "")
											{
												details_val = "Purchase Order: " + input.Display_Name_Voucher;
											}
											if(srv_store_display != null && srv_store_display != "")
											{
												if(details_val != "")
												{
													details_val = details_val + "\n";
												}
												details_val = details_val + "Store: " + srv_store_display;
											}
											if(input.Display_Name_Received_By != null && input.Display_Name_Received_By != "")
											{
												if(details_val != "")
												{
													details_val = details_val + "\n";
												}
												details_val = details_val + "Received By: " + input.Display_Name_Received_By;
											}
											if(input.Receiving_Type != null && input.Receiving_Type != "")
											{
												if(details_val != "")
												{
													details_val = details_val + "\n";
												}
												details_val = details_val + "Receiving Type: " + input.Receiving_Type;
											}
											bd_exists = false;
											for each  bd_chk in Bill_Details[Stock_Receiving_Details == input.ID]
											{
												bd_exists = true;
												break;
											}
											if(bd_exists == false)
											{
												insert into Bill_Details
												[
													Stock_Receiving_Details=input.ID
													Item=input.Item
													Display_Name_Item=input.Display_Name_Item
													Details_Date=details_date_val
													Details=details_val
													Quantity=input.Quantity_Received
													Unit_Of_Measure=input.Unit_Of_Measure_Received
													Display_Name_Unit_Of_Measure=input.Display_Name_Unit_Of_Measure_Received
													Quantity_Billable=input.Quantity_Received
													Base_Unit_Of_Measure=base_uom_name
													Quantity_In_Base_Unit=input.Quantity_in_Base_Unit_Of_Measure_Received
													Account=srv_store_display
													Current_Site=srv_store_display
													Reference=input.Stock_Receiving_Voucher_and_Number
													Source_Record_ID=input.ID
													Source_Form="Stock Receiving Details"
													Bill_Details_Status="Draft"
													Created_By_Name=u.get("name")
													Created_By_Email=u.get("email")
													Created_By_Time=zoho.currenttime
													Added_User=zoho.loginuser
												]
											}
										}
										// 9) UPDATE CONCRETE PO DETAIL + HEADER
										if(rtype == "Purchase Order" && po_detail_id != null)
										{
											po_det_status = Purchase_Order_Details[ID == po_detail_id];
											if(po_det_status.ID != null)
											{
												old_received = ifnull(po_det_status.Quantity_Received,0.0);
												new_received = old_received + ifnull(input.Quantity_Received,0.0);
												po_det_status.Quantity_Received=new_received;
												po_det_status.Quantity_Remaining=ifnull(po_det_status.Quantity_Ordered,0.0) - new_received;
												if(po_det_status.Quantity_Remaining < 0)
												{
													po_det_status.Quantity_Remaining=0.0;
												}
												if(new_received <= 0)
												{
													po_det_status.Receiving_Status="Not Received";
												}
												else if(new_received >= ifnull(po_det_status.Quantity_Ordered,0.0))
												{
													po_det_status.Receiving_Status="Fully Received";
												}
												else
												{
													po_det_status.Receiving_Status="Partially Received";
												}
												po_det_status.Quantity_Billable=new_received;
												po_det_status.Quantity_Unbilled=new_received - ifnull(po_det_status.Quantity_Billed,0.0);
												if(po_det_status.Quantity_Unbilled < 0)
												{
													po_det_status.Quantity_Unbilled=0.0;
												}
												if(po_det_status.Purchase_Order != null)
												{
													thisapp.po.update_po_receiving_status(po_det_status.Purchase_Order);
													po_rec_status = Purchase_Order[ID == po_det_status.Purchase_Order];
													if(po_rec_status.ID != null)
													{
														employee_voucher_text = ifnull(po_rec_status.Display_Name_Employee_Voucher,"").trim();
														store_resp = store_management.po.receive_po_detail_from_freedom(po_rec_status.PO_Number,po_rec_status.PO_Date,po_rec_status.Display_Name_Employee_Voucher,po_det_status.Purchase_Order_Details_Number,input.Quantity_Received,ifnull(po_det_status.Unit_Cost,0.0));
														info store_resp;
													}
												}
											}
										}
						)
					}
				}

			}
			Full_Validation_On_Create3 as "Full Validation On Create"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Work_Order_Task_Number == null || input.Work_Order_Task_Number.trim() == "")
										{
											doc_key = Document_Key[Voucher_Type == "Work Order Task" && Document_Key_Status == "Active"];
											if(doc_key.ID == null)
											{
												alert "Document Key for Work Order Task is not configured.";
												cancel submit;
											}
											prefix_value = ifnull(doc_key.Prefix,"STL");
											next_no = ifnull(doc_key.Next_Number,1);
											if(next_no > 999)
											{
												alert "Work Order Task numbering has reached the maximum of 999.";
												cancel submit;
											}
											if(next_no < 10)
											{
												num_text = "00" + next_no;
											}
											else if(next_no < 100)
											{
												num_text = "0" + next_no;
											}
											else
											{
												num_text = next_no.toString();
											}
											input.Work_Order_Task_Number = prefix_value + num_text;
											doc_key.Next_Number=next_no + 1;
										}
						)
					}
				}

			}
			Finalize_On_Edit19 as "Finalize On Edit"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// STOCK RECEIVING DETAILS - FINALIZE ON EDIT
										// ======================================================
										// ------------------------------------------------------
										// 1) AUDIT
										// ------------------------------------------------------
										u = thisapp.audit.getLoginAuditInfo();
										input.Updated_By_Name = u.get("name");
										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
										// ------------------------------------------------------
										// 2) RESOLVE RECEIVING HEADER / STORE
										// ------------------------------------------------------
										if(input.Stock_Receiving_Voucher == null)
										{
											return;
										}
										srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
										if(srv.ID == null || srv.Store == null)
										{
											return;
										}
										store_id = srv.Store;
										srv_name = ifnull(srv.Display_Name_Stock_Receiving_Book,"").trim();
										srv_store_display = ifnull(srv.Display_Name_Store,"");
										srv_received_by = ifnull(srv.Received_By,"");
										// ------------------------------------------------------
										// 3) BUILD RECEIVING VOUCHER NUMBER
										// ------------------------------------------------------
										num_txt = "";
										if(input.Stock_Receiving_Voucher_Number != null && input.Stock_Receiving_Voucher_Number > 0)
										{
											if(input.Stock_Receiving_Voucher_Number < 10)
											{
												num_txt = "0" + input.Stock_Receiving_Voucher_Number.toString();
											}
											else
											{
												num_txt = input.Stock_Receiving_Voucher_Number.toString();
											}
										}
										if(srv_name != "" && num_txt != "")
										{
											input.Stock_Receiving_Voucher_and_Number = srv_name + "-" + num_txt;
										}
										else if(srv_name != "")
										{
											input.Stock_Receiving_Voucher_and_Number = srv_name;
										}
										else
										{
											input.Stock_Receiving_Voucher_and_Number = null;
										}
										ref_no = ifnull(input.Stock_Receiving_Voucher_and_Number,"").trim();
										if(ref_no == "")
										{
											ref_no = input.ID.toString();
										}
										// ------------------------------------------------------
										// 4) REFRESH DISPLAY FIELDS
										// ------------------------------------------------------
										input.Display_Name_Stock_Receiving_Voucher = srv_name;
										input.Store = srv_store_display;
										input.Display_Name_Received_By = srv_received_by;
										// ------------------------------------------------------
										// 5) COMMON VALUES
										// ------------------------------------------------------
										rtype = ifnull(input.Receiving_Type,"").trim();
										qty = ifnull(input.Quantity_Received,0.0);
										uom_id = input.Unit_Of_Measure_Received;
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = "New";
										}
										if(rtype == "Tool Return" && cond == "New")
										{
											cond = "In Service";
											input.Stock_Condition = "In Service";
										}
										if(qty <= 0)
										{
											input.Stock_Receiving_Details_Status = "Draft";
											info "Quantity Received must be greater than zero.";
											return;
										}
										if(uom_id == null)
										{
											input.Stock_Receiving_Details_Status = "Draft";
											info "Unit of Measure Received is required.";
											return;
										}
										// ------------------------------------------------------
										// 6) RESOLVE ACTUAL ITEM
										// ------------------------------------------------------
										actual_item_id = null;
										po_detail_id = null;
										po_unit_cost = 0.0;
										base_uom_name = "";
										transfer_resp = Map();
										transfer_loaded = false;
										// ======================================================
										// PURCHASE ORDER
										// ======================================================
										if(rtype == "Purchase Order" && input.Item != null)
										{
											po_det = Purchase_Order_Details[ID == input.Item];
											if(po_det.ID != null && po_det.Item != null)
											{
												po_detail_id = po_det.ID;
												actual_item_id = po_det.Item;
												po_unit_cost = ifnull(po_det.Unit_Cost,0.0);
												base_uom_name = ifnull(po_det.Display_Name_Unit_Of_Measure,"");
											}
										}
										// ======================================================
										// INTERNAL TRANSFER
										// ======================================================
										else if(rtype == "Internal Transfer" && input.Transfer_Item != null)
										{
											transfer_id_val = input.Transfer_Item.ID;
											if(transfer_id_val == null || transfer_id_val <= 0)
											{
												info "Stock Transfer ID is invalid.";
												input.Stock_Receiving_Details_Status = "Draft";
												return;
											}
											transfer_payload = Map();
											transfer_payload.put("Transfer_ID",transfer_id_val);
											transfer_payload.put("Receiving_Number",ifnull(input.Stock_Receiving_Voucher_and_Number,""));
											transfer_payload.put("Receive_Date",zoho.currentdate);
											transfer_payload.put("Receiving_Store",input.Store);
											transfer_payload.put("Quantity_Received",ifnull(input.Quantity_Received,0.0));
											transfer_payload.put("Unit_Of_Measure_Received",input.Unit_Of_Measure_Received);
											transfer_payload.put("Quantity_Received_in_Base_Unit_Of_Measure",ifnull(input.Quantity_in_Base_Unit_Of_Measure_Received,0.0));
											transfer_payload.put("Received_By",ifnull(srv_received_by,""));
											transfer_payload.put("Receive_Application","Kicks Klean Ug");
											transfer_payload.put("Receive_Source_Form","Stock Receiving Details");
											transfer_payload.put("Receive_Source_Record_ID",input.ID);
											transfer_resp = store_management.stock_transfer.update_transfer_receiving_details(transfer_payload);
											info transfer_resp;
											if(transfer_resp == null || transfer_resp.get("ok") != true)
											{
												error_message = "Unable to synchronize Stock Transfer receiving details.";
												if(transfer_resp != null)
												{
													error_message = ifnull(transfer_resp.get("message"),error_message);
												}
												info error_message;
												input.Stock_Receiving_Details_Status = "Draft";
												return;
											}
											transfer_loaded = true;
											if(transfer_resp.get("item_id") != null)
											{
												actual_item_id = transfer_resp.get("item_id").toLong();
											}
											else if(input.Transfer_Item.Item != null)
											{
												actual_item_id = input.Transfer_Item.Item;
											}
											base_uom_name = ifnull(transfer_resp.get("display_uom"),"");
											input.Display_Name_Item = ifnull(transfer_resp.get("display_name_item"),ifnull(input.Display_Name_Item,""));
											transfer_condition = ifnull(transfer_resp.get("stock_condition"),"New").trim();
											if(transfer_condition == "")
											{
												transfer_condition = "New";
											}
											input.Stock_Condition = transfer_condition;
											cond = transfer_condition;
											transfer_rate = ifnull(transfer_resp.get("unit_cost"),ifnull(input.Rate,0.0));
											input.Rate = transfer_rate;
										}
										// ======================================================
										// STOCK RETURN / TOOL RETURN
										// ======================================================
										else if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_rec.ID != null && issue_rec.Item != null)
											{
												actual_item_id = issue_rec.Item;
												base_uom_name = ifnull(issue_rec.Display_Name_Unit_Of_Measure,"");
											}
										}
										// ======================================================
										// OTHER RECEIVING TYPES
										// ======================================================
										else if(input.Item != null)
										{
											actual_item_id = input.Item;
										}
										// ------------------------------------------------------
										// 7) ENSURE ITEM WAS RESOLVED
										// ------------------------------------------------------
										if(actual_item_id == null)
										{
											info "Unable to resolve the actual item.";
											input.Stock_Receiving_Details_Status = "Draft";
											return;
										}
										// ------------------------------------------------------
										// 8) RESOLVE COST FOR STORE POSTING
										// ------------------------------------------------------
										cost_for_store_default = 0.0;
										if(rtype == "Purchase Order")
										{
											cost_for_store_default = po_unit_cost;
										}
										else if(rtype == "Internal Transfer" && transfer_loaded == true)
										{
											cost_for_store_default = ifnull(transfer_resp.get("unit_cost"),ifnull(input.Rate,0.0));
										}
										else
										{
											cost_for_store_default = ifnull(input.Rate,0.0);
										}
										// ------------------------------------------------------
										// 9) POST STOCK INTO STORE MANAGEMENT
										// ------------------------------------------------------
										resp = store_management.stock.receive_stock_from_Kicksklean(actual_item_id,store_id,srv_store_display,qty,uom_id,cond,cost_for_store_default,ref_no,input.ID);
										info resp;
										if(resp == null || resp.get("ok") != true)
										{
											if(resp != null)
											{
												info ifnull(resp.get("message"),"Stock receiving failed.");
											}
											input.Stock_Receiving_Details_Status = "Draft";
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure_Received = ifnull(resp.get("base_qty"),0.0);
										input.Stock_Receiving_Details_Status = "Received";
										// ======================================================
										// A) PURCHASE ORDER RECEIVING
										// ======================================================
										if(rtype == "Purchase Order" && po_detail_id != null)
										{
											po_det_status = Purchase_Order_Details[ID == po_detail_id];
											if(po_det_status.ID != null)
											{
												total_received = 0.0;
												all_receive_rows = Stock_Receiving_Details[Receiving_Type == "Purchase Order" && Item == po_detail_id && Stock_Receiving_Details_Status == "Received"];
												for each  rec_row in all_receive_rows
												{
													total_received = total_received + ifnull(rec_row.Quantity_Received,0.0);
												}
												qty_ordered = ifnull(po_det_status.Quantity_Ordered,0.0);
												qty_remaining = qty_ordered - total_received;
												if(qty_remaining < 0)
												{
													qty_remaining = 0.0;
												}
												po_det_status.Quantity_Received=total_received;
												po_det_status.Quantity_Remaining=qty_remaining;
												if(total_received <= 0)
												{
													po_det_status.Receiving_Status="Not Received";
												}
												else if(qty_remaining > 0)
												{
													po_det_status.Receiving_Status="Partially Received";
												}
												else
												{
													po_det_status.Receiving_Status="Fully Received";
												}
												po_det_status.Quantity_Billable=total_received;
												po_det_status.Quantity_Unbilled=total_received - ifnull(po_det_status.Quantity_Billed,0.0);
												if(po_det_status.Quantity_Unbilled < 0)
												{
													po_det_status.Quantity_Unbilled=0.0;
												}
												if(po_det_status.Purchase_Order != null)
												{
													thisapp.po.update_po_receiving_status(po_det_status.Purchase_Order);
												}
											}
										}
										// ======================================================
										// B) CREATE / UPDATE BILL DETAILS FOR PURCHASE ORDERS
										// ======================================================
										if(rtype == "Purchase Order")
										{
											existing_bd = Bill_Details[Stock_Receiving_Details == input.ID];
											if(cond != "Used")
											{
												if(existing_bd.ID != null)
												{
													existing_bd.Item=input.Item;
													existing_bd.Display_Name_Item=input.Display_Name_Item;
													existing_bd.Quantity=input.Quantity_Received;
													existing_bd.Unit_Of_Measure=input.Unit_Of_Measure_Received;
													existing_bd.Display_Name_Unit_Of_Measure=input.Display_Name_Unit_Of_Measure_Received;
													existing_bd.Quantity_Billable=input.Quantity_Received;
													existing_bd.Base_Unit_Of_Measure=base_uom_name;
													existing_bd.Quantity_In_Base_Unit=input.Quantity_in_Base_Unit_Of_Measure_Received;
													existing_bd.Account=srv_store_display;
													existing_bd.Current_Site=srv_store_display;
													existing_bd.Source_Record_ID=input.ID;
													existing_bd.Source_Form="Stock Receiving Details";
													existing_bd.Updated_By_Name=u.get("name");
													existing_bd.Updated_By_Email=u.get("email");
													existing_bd.Updated_By_Time=zoho.currenttime;
												}
												else
												{
													insert into Bill_Details
													[
														Stock_Receiving_Details=input.ID
														Item=input.Item
														Display_Name_Item=input.Display_Name_Item
														Quantity=input.Quantity_Received
														Unit_Of_Measure=input.Unit_Of_Measure_Received
														Display_Name_Unit_Of_Measure=input.Display_Name_Unit_Of_Measure_Received
														Quantity_Billable=input.Quantity_Received
														Base_Unit_Of_Measure=base_uom_name
														Quantity_In_Base_Unit=input.Quantity_in_Base_Unit_Of_Measure_Received
														Account=srv_store_display
														Current_Site=srv_store_display
														Source_Record_ID=input.ID
														Source_Form="Stock Receiving Details"
														Created_By_Name=u.get("name")
														Created_By_Email=u.get("email")
														Created_By_Time=zoho.currenttime
														Added_User=zoho.loginuser
													]
												}
											}
											else
											{
												if(existing_bd.ID != null)
												{
													delete from Bill_Details[ID == existing_bd.ID];
												}
											}
										}
										// ======================================================
										// C) STOCK RETURN / TOOL RETURN STATUS UPDATE
										// ======================================================
										if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_ret = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_ret.ID != null)
											{
												total_returned = 0.0;
												total_returned_base = 0.0;
												return_rows = Stock_Receiving_Details[Receiving_Type == "Stock Return" || Receiving_Type == "Tool Return" && Item_Issuing_Details == input.Item_Issuing_Details && Stock_Receiving_Details_Status == "Received"];
												for each  ret in return_rows
												{
													total_returned = total_returned + ifnull(ret.Quantity_Received,0.0);
													total_returned_base = total_returned_base + ifnull(ret.Quantity_in_Base_Unit_Of_Measure_Received,0.0);
												}
												issue_ret.Quantity_Returned=total_returned;
												issue_ret.Quantity_Returned_in_Base_Unit_Of_Measure=total_returned_base;
												issued_base = ifnull(issue_ret.Quantity_in_Base_Unit_Of_Measure,0.0);
												if(total_returned_base >= issued_base && issued_base > 0)
												{
													issue_ret.Status="Returned";
												}
												else
												{
													if(rtype == "Tool Return")
													{
														issue_ret.Status="Borrowed";
													}
													else
													{
														issue_ret.Status="Issued";
													}
												}
											}
										}
										// ======================================================
										// D) INTERNAL TRANSFER STATUS UPDATE
										// ======================================================
										if(rtype == "Internal Transfer" && input.Transfer_Item != null)
										{
											transfer_id_val = input.Transfer_Item.ID;
											if(transfer_id_val == null || transfer_id_val <= 0)
											{
												info "Stock Transfer ID is invalid.";
											}
											else
											{
												transfer_update_resp = store_management.stock_transfer.mark_transfer_received(transfer_id_val,ifnull(input.Quantity_Received,0.0),ifnull(input.Quantity_in_Base_Unit_Of_Measure_Received,0.0),input.Unit_Of_Measure_Received,ifnull(input.Store,""),ifnull(srv_received_by,""),ifnull(ref_no,""),input.ID);
												info transfer_update_resp;
												if(transfer_update_resp == null || transfer_update_resp.get("ok") != true)
												{
													if(transfer_update_resp != null)
													{
														info ifnull(transfer_update_resp.get("message"),"Unable to update Stock Transfer.");
													}
													else
													{
														info "Stock Transfer update returned no response.";
													}
												}
											}
										}
						)
					}
				}

			}
			Finalize_On_Create20 as "Finalize On Create"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										Created_Time = zoho.currenttime;
						)
					}
				}

			}
			Finalize_On_Delete3 as "Finalize On Delete"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// STOCK RECEIVING DETAILS - FINALIZE ON DELETE
										// ======================================================
										// ---------------------------------------
										// 1) GET SRV HEADER
										// ---------------------------------------
										if(input.Stock_Receiving_Voucher == null)
										{
											return;
										}
										srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
										if(srv.ID == null || srv.Store == null)
										{
											return;
										}
										store_id = srv.Store;
										ref_no = ifnull(input.Stock_Receiving_Voucher_and_Number,"").trim();
										if(ref_no == "")
										{
											ref_no = ifnull(srv.Display_Name_Stock_Receiving_Book,"").trim();
										}
										if(ref_no == "")
										{
											ref_no = input.ID.toString();
										}
										// ---------------------------------------
										// 2) COMMON VALUES
										// ---------------------------------------
										rtype = ifnull(input.Receiving_Type,"").trim();
										recv_qty = ifnull(input.Quantity_Received,0.0);
										recv_base_qty = ifnull(input.Quantity_in_Base_Unit_Of_Measure_Received,0.0);
										// ---------------------------------------
										// 3) RESOLVE RECORDS
										// ---------------------------------------
										if(rtype == "Purchase Order" && input.Item != null)
										{
											po_det_resolve = Purchase_Order_Details[ID == input.Item];
											if(po_det_resolve.ID == null)
											{
												info "Purchase Order Detail could not be found.";
											}
										}
										else if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_resolve = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_resolve.ID == null)
											{
												info "Item Issuing Detail could not be found.";
											}
										}
										// ---------------------------------------
										// 4) REVERSE STORE STOCK POSTED
										// ---------------------------------------
										store_reverse_resp = store_management.delete_stock_receiving_from_Kicksklean(input.ID);
										info store_reverse_resp;
										// ======================================================
										// A) PURCHASE ORDER DELETE REVERSAL
										// ======================================================
										if(rtype == "Purchase Order" && input.Item != null)
										{
											po_det = Purchase_Order_Details[ID == input.Item];
											if(po_det.ID != null && po_det.Item != null)
											{
												bill_rows = Bill_Details[Stock_Receiving_Details == input.ID];
												for each  bd in bill_rows
												{
													delete from Bill_Details[ID == bd.ID];
												}
												total_received = 0.0;
												remaining_rows = Stock_Receiving_Details[Receiving_Type == "Purchase Order" && Item == input.Item && ID != input.ID && Stock_Receiving_Details_Status == "Received"];
												for each  rr in remaining_rows
												{
													total_received = total_received + ifnull(rr.Quantity_Received,0.0);
												}
												qty_ordered = ifnull(po_det.Quantity_Ordered,0.0);
												qty_remaining = qty_ordered - total_received;
												if(qty_remaining < 0)
												{
													qty_remaining = 0.0;
												}
												po_det.Quantity_Received=total_received;
												po_det.Quantity_Remaining=qty_remaining;
												po_det.Quantity_Billable=total_received;
												po_det.Quantity_Unbilled=total_received - ifnull(po_det.Quantity_Billed,0.0);
												if(po_det.Quantity_Unbilled < 0)
												{
													po_det.Quantity_Unbilled=0.0;
												}
												if(total_received <= 0)
												{
													po_det.Receiving_Status="Not Received";
												}
												else if(qty_remaining > 0)
												{
													po_det.Receiving_Status="Partially Received";
												}
												else
												{
													po_det.Receiving_Status="Fully Received";
												}
												if(po_det.Purchase_Order != null)
												{
													thisapp.po.update_po_receiving_status(po_det.Purchase_Order);
												}
											}
										}
										// ======================================================
										// B) TOOL RETURN / STOCK RETURN DELETE REVERSAL
										// ======================================================
										else if(rtype == "Tool Return" || rtype == "Stock Return" && input.Item_Issuing_Details != null)
										{
											issue_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_rec.ID != null)
											{
												total_returned = 0.0;
												total_returned_base = 0.0;
												return_rows = Stock_Receiving_Details[Receiving_Type == "Tool Return" || Receiving_Type == "Stock Return" && Item_Issuing_Details == input.Item_Issuing_Details && ID != input.ID && Stock_Receiving_Details_Status == "Received"];
												for each  ret in return_rows
												{
													total_returned = total_returned + ifnull(ret.Quantity_Received,0.0);
													total_returned_base = total_returned_base + ifnull(ret.Quantity_in_Base_Unit_Of_Measure_Received,0.0);
												}
												issue_rec.Quantity_Returned=total_returned;
												issue_rec.Quantity_Returned_in_Base_Unit_Of_Measure=total_returned_base;
												issued_base = ifnull(issue_rec.Quantity_in_Base_Unit_Of_Measure,0.0);
												if(total_returned_base >= issued_base && issued_base > 0)
												{
													issue_rec.Status="Returned";
												}
												else if(rtype == "Tool Return")
												{
													issue_rec.Status="Borrowed";
												}
												else
												{
													issue_rec.Status="Issued";
												}
											}
										}
										else if(rtype == "Internal Transfer")
										{
											reverse_payload = Map();
											reverse_payload.put("Receive_Source_Record_ID",input.ID);
											reverse_payload.put("Receive_Source_Form","Stock Receiving Details");
											reverse_payload.put("Receive_Application","Kicks Klean Ug");
											transfer_reverse_resp = store_management.stock_transfer.reverse_transfer_receiving(reverse_payload);
											info transfer_reverse_resp;
											if(transfer_reverse_resp == null || transfer_reverse_resp.get("ok") != true)
											{
												if(transfer_reverse_resp != null)
												{
													info ifnull(transfer_reverse_resp.get("message"),"Internal Transfer receiving reversal failed.");
												}
												else
												{
													info "Internal Transfer receiving reversal returned no response.";
												}
											}
										}
										info "Stock Receiving Details delete reversal completed.";
						)
					}
				}

			}
