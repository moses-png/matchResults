												v.Asset=null;
												v.Odometer_Start=null;
												v.Start_Time=null;
												// Clear end values too (if you also push them)
												v.Odometer_End=null;
												v.End_Time=null;
												// Optional: reset voucher status if you have it
												// v.Voucher_Status = "Open";
											}
										}
						)
					}
				}

			}
