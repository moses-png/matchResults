				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Employee_Voucher
			(
				type = picklist	
				displayname = "Employee Voucher"
				values  = employee_management.Voucher[Voucher_Status == "Issued"].ID
    			displayformat = [Voucher_Number + " - " + Display_Name_Employee]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Voucher
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reported_By
			(
    			type = text
