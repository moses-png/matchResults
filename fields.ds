			Finalize_On_Delete8 as "Finalize On Delete"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											mile_delete_resp = asset_management.deleteMileageLogFromKicks_Klean_Ug("Kicks Klean Ug - Work Order Task Start",input.ID.toString());
										info mile_delete_resp;
										mile_delete_resp2 = asset_management.deleteMileageLogFromKicks_Klean_Ug("Kicks Klean Ug - Work Order Task Completed",input.ID.toString());
										info mile_delete_resp2;
										mile_delete_resp3 = asset_management.deleteMileageLogFromKicks_Klean_Ug("Kicks Klean Ug - Work Order Task Checked",input.ID.toString());
										info mile_delete_resp3;
										if(input.Asset != null)
										{
											asset_id_val = input.Asset;
											cost_resp = asset_management.updateAssetCostSummaryFromKicks_Klean_Ug(asset_id_val,0.0,0.0);
											info cost_resp;
										}
						)
					}
				}

			}
