			Finalize12 as "Finalize"
			{
				type =  form
				form = Bill_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// BILL DETAILS -> FINALIZE
										// ======================================
										// 1) Calculate Line Total
										qty = ifnull(input.Quantity,0.0);
										rateVal = ifnull(input.Rate,0.0);
										input.Line_Total = round(qty * rateVal,2);
										// 2) Control Bill Details Status
										if(ifnull(input.Line_Total,0.0) > 0)
										{
											input.Bill_Details_Status = "Billed";
										}
										else
										{
											input.Bill_Details_Status = "Draft";
										}
										// 3) Recalculate parent Bill totals + parent Bill Status
										if(input.Bill != null)
										{
											billRec = Bill[ID == input.Bill.ID];
											if(billRec.ID != null)
											{
												total_amount = 0.0;
												bill_rows = Bill_Details[Bill == billRec.ID];
												for each  br in bill_rows
												{
													total_amount = total_amount + ifnull(br.Line_Total,0.0);
												}
												total_amount = round(total_amount,2);
												amount_paid = round(ifnull(billRec.Amount_Paid,0.0),2);
												amount_due = round(total_amount,2);
												balance_due = round(amount_due - amount_paid,2);
												if(balance_due < 0)
												{
													balance_due = 0.0;
												}
												payment_status = "Not Paid";
												if(amount_paid <= 0)
												{
													payment_status = "Not Paid";
												}
												else if(balance_due > 0)
												{
													payment_status = "Partially Paid";
												}
												else
												{
													payment_status = "Paid";
												}
												bill_status = "Draft";
												if(total_amount > 0)
												{
													bill_status = "Due";
												}
												if(payment_status == "Partially Paid")
												{
													bill_status = "Partially Paid";
												}
												else if(payment_status == "Paid" && total_amount > 0)
												{
													bill_status = "Paid";
												}
												if(billRec.Cancel_Bill == true)
												{
													bill_status = "Cancelled";
												}
												billRec.Total_Amount=total_amount;
												billRec.Amount_Due=amount_due;
												billRec.Amount_Paid=amount_paid;
												billRec.Balance_Due=balance_due;
												billRec.Payment_Status=payment_status;
												billRec.Bill_Status=bill_status;
											}
										}
										// 4) Sync Group Expense
										info "===== BILL DETAILS GROUP SYNC START =====";
										info "Bill Detail ID: " + input.ID;
										info "Group: " + input.Group;
										info "Group ID: " + if(input.Group != null,input.Group.ID.toString(),"null");
										info "Quantity: " + ifnull(input.Quantity,0);
										info "Rate: " + ifnull(input.Rate,0);
										info "Line Total: " + ifnull(input.Line_Total,0);
										info "Last Synced Group Amount: " + ifnull(input.Last_Synced_Group_Amount,0);
										if(input.Group != null && ifnull(input.Line_Total,0.0) > 0)
										{
											new_amount = round(ifnull(input.Line_Total,0.0),2);
											old_amount = round(ifnull(input.Last_Synced_Group_Amount,0.0),2);
											delta_amount = round(new_amount - old_amount,2);
											info "New Amount: " + new_amount;
											info "Old Amount: " + old_amount;
											info "Delta Amount: " + delta_amount;
											if(delta_amount != 0)
											{
												pay_date = zoho.currentdate;
												if(input.Details_Date != null)
												{
													pay_date = input.Details_Date;
												}
												else if(input.Bill != null && input.Bill.Bill_Date != null)
												{
													pay_date = input.Bill.Bill_Date;
												}
												payload = Map();
												payload.put("Group_ID",input.Group.ID);
												payload.put("Amount_Delta",delta_amount);
												payload.put("Payment_Date",pay_date);
												payload.put("Source_Group","Employee Expenses");
												info "Payload: " + payload.toString();
												resp = payment_management.createGroupExpenseFromEmployeeBill(payload);
												info "Response: " + resp;
												if(resp != null && resp.get("ok") == true)
												{
													input.Last_Synced_Group_Amount = new_amount;
													info "Group sync successful.";
												}
												else
												{
													info "Group sync failed.";
												}
											}
											else
											{
												info "Skipped sync because delta amount is 0.";
											}
										}
										else
										{
											info "Skipped sync because Group is null or Line Total is 0.";
										}
										info "===== BILL DETAILS GROUP SYNC END =====";
						)
					}
				}

			}
