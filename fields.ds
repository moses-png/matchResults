										// -------------------------
										hide Line_Number;
										hide Display_Name_Voucher;
										hide Receipt_Officer;
										hide Display_Name_Site;
										hide Phone_Used_Site;
										hide Display_Name_Number_Plate;
										// measured (you want it shown on Create + Head Office, so hide first then show later)
										hide Back_End;
										hide Bed_Length;
										hide Bed_Width;
										hide Bed_Height;
										hide Bed_Height_2;
										hide Truck_Size_1;
										hide Truck_Size_2;
										hide Time_Measured;
										// confirmed (you want it shown for Manager + Head Office)
										hide Bed_Length_Confirmed;
										hide Bed_Width_Confirmed;
										hide Bed_Height_Confirmed;
										hide Bed_Height_2_Confirmed;
										hide Truck_Size_1_Confirmed;
										hide Truck_Size_2_Confirmed;
										hide Time_Confirmed;
										// differences (Head Office only)
										hide Bed_Length_Difference;
										hide Bed_Width_Difference;
										hide Bed_Height_Difference;
										hide Bed_Height_2_Difference;
										hide Truck_Size_1_Difference;
										hide Truck_Size_2_Difference;
										// Head Office verification (Head Office only)
										hide Measurement_Checkbox;
										hide Time_Checked;
										hide Head_Office_Supervisor;
										// Status/stage (Head Office only, per your list)
										hide Measurement_Status;
										hide Document_Stage;
										// -------------------------
										// 4) CREATE MODE
										// -------------------------
										if(input.ID == null)
