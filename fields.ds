											input.Amount_Due = ifnull(input.Employee_Management_Bill.Amount_Due,0.0);
										}
										else
										{
											input.Bill_Number = "";
											input.Amount_Due = 0.0;
										}
						)
					}
				}

			}
			On_Cash_Receipt_Voucher_S as "On Cash Receipt Voucher Selected"
			{
				type =  form
				form = Cash_Receipt_Details

				record event = on add or edit

				on user input of Cash_Receipt_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cash_Receipt_Voucher != null)
										{
											// Display Name
											input.Display_Name_Cash_Receipt_Voucher = input.Cash_Receipt_Voucher.Cash_Receipt_Number;
											// Cash Receipt Date
											input.Cash_Receipt_Date = input.Cash_Receipt_Voucher.Cash_Receipt_Date;
											// Next Line Number
											if(input.Line_Number == null)
											{
												max_line = 0;
												existing_rows = Cash_Receipt_Details[Cash_Receipt_Voucher == input.Cash_Receipt_Voucher];
												for each  rec in existing_rows
												{
													if(ifnull(rec.Line_Number,0) > max_line)
													{
														max_line = rec.Line_Number;
													}
												}
												input.Line_Number = max_line + 1;
											}
										}
										else
										{
											input.Display_Name_Cash_Receipt_Voucher = "";
											input.Cash_Receipt_Date = null;
											input.Line_Number = null;
										}
						)
					}
				}

			}
			On_System_Selected1 as "On System Selected"
			{
				type =  form
				form = Cash_Receipt_Details

				record event = on add or edit

				on user input of System
				{
					actions 
					{
						custom deluge script
						(
											if(input.System == "Store Management")
										{
											hide Employee_Management_Invoice;
											//hide Asset_Management_Invoice;
											//show Store_Management_Invoice;
											input.Employee_Management_Invoice = null;
											Asset_Management_Invoice = null;
										}
										else if(input.System == "Asset Management")
										{
											hide Employee_Management_Invoice;
											//hide Store_Management_Invoice;
											//show Asset_Management_Invoice;
											input.Employee_Management_Invoice = null;
											Store_Management_Invoice = null;
										}
										else if(input.System == "Employee Management")
										{
											//hide Asset_Management_Invoice;
											//hide Store_Management_Invoice;
											show Employee_Management_Invoice;
											Asset_Management_Invoice = null;
											Store_Management_Invoice = null;
										}
										else
										{
											hide Employee_Management_Invoice;
											//hide Asset_Management_Invoice;
											//hide Store_Management_Invoice;
											input.Employee_Management_Invoice = null;
											Asset_Management_Invoice = null;
											Store_Management_Invoice = null;
										}
						)
					}
				}

			}
			On_Employee_Management_In as "On Employee Management Invoice Selected"
			{
				type =  form
				form = Cash_Receipt_Details

				record event = on add or edit

				on user input of Employee_Management_Invoice
				{
					actions 
					{
						custom deluge script
						(
											if(input.Employee_Management_Invoice != null)
										{
											// Autofill Invoice Number
											input.Invoice_Number = input.Employee_Management_Invoice.Invoice_Number;
											// Autofill Amount Due
											input.Amount_Due = ifnull(input.Employee_Management_Invoice.Balance_Due,0.0);
										}
										else
										{
											input.Invoice_Number = "";
											input.Amount_Due = 0.0;
										}
						)
					}
				}

			}
			Finalize1 as "Finalize"
			{
				type =  form
				form = Cash_Receipt_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											emp_resp = null;
										// ==================================================
										// 0) SMALL HELPERS
										// ==================================================
										current_invoice_no = ifnull(input.Invoice_Number,"").trim();
										old_invoice_no = ifnull(input.Old_Invoice_Number,"").trim();
										// Always use detail date first
										receipt_date_val = null;
										if(input.Cash_Receipt_Date != null)
										{
											receipt_date_val = input.Cash_Receipt_Date;
										}
										else if(input.Cash_Receipt_Voucher != null && input.Cash_Receipt_Voucher.Cash_Receipt_Date != null)
										{
											receipt_date_val = input.Cash_Receipt_Voucher.Cash_Receipt_Date;
										}
										else
										{
											receipt_date_val = zoho.currentdate;
										}
										// ==================================================
										// 1) IF INVOICE CHANGED ON EDIT, FIRST RECOMPUTE THE OLD INVOICE
										// ==================================================
										if(input.System == "Employee Management" && old_invoice_no != "" && old_invoice_no != current_invoice_no)
										{
											old_invoice_total_received = 0.0;
											old_invoice_rows = Cash_Receipt_Details[System == "Employee Management" && Invoice_Number == old_invoice_no];
											for each  old_row in old_invoice_rows
											{
												old_row_amt = round(ifnull(old_row.Amount_Received,0.0),2);
												if(old_row_amt > 0)
												{
													old_invoice_total_received = round(old_invoice_total_received + old_row_amt,2);
												}
											}
											old_payload = Map();
											old_payload.put("Invoice_Number",old_invoice_no);
											old_payload.put("Total_Received",old_invoice_total_received);
											old_payload.put("Receipt_Date",receipt_date_val);
											// Create this function in Employee Management
											old_resp = employee_management.updateInvoiceFromReceipt(old_payload);
											if(old_resp == null)
											{
												info "Old Employee invoice sync failed: no response";
											}
											else if(old_resp.get("ok") != true)
											{
												info "Old Employee invoice sync failed: " + ifnull(old_resp.get("msg"),"unknown error");
											}
										}
										// ==================================================
										// 2) MAIN SYNC FOR CURRENT INVOICE
										// ==================================================
										if(input.System == "Employee Management" && input.Employee_Management_Invoice != null && current_invoice_no != "")
										{
											// ----------------------------------------------
											// A. RECOMPUTE TOTAL RECEIVED FOR CURRENT INVOICE
											// ----------------------------------------------
											recomputed_total = 0.0;
											receipt_rows = Cash_Receipt_Details[System == "Employee Management" && Invoice_Number == current_invoice_no];
											for each  rec_row in receipt_rows
											{
												row_amt = round(ifnull(rec_row.Amount_Received,0.0),2);
												if(row_amt > 0)
												{
													recomputed_total = round(recomputed_total + row_amt,2);
												}
											}
											// ----------------------------------------------
											// B. PUSH RECOMPUTED INVOICE RECEIPT TO EMPLOYEE
											// ----------------------------------------------
											payload = Map();
											payload.put("Invoice_Number",current_invoice_no);
											payload.put("Total_Received",recomputed_total);
											payload.put("Receipt_Date",receipt_date_val);
											// Create this function in Employee Management
											emp_resp = employee_management.updateInvoiceFromReceipt(payload);
											if(emp_resp == null)
											{
												info "Employee invoice sync failed: no response";
											}
											else if(emp_resp.get("ok") != true)
											{
												info "Employee invoice sync failed: " + ifnull(emp_resp.get("msg"),"unknown error");
											}
											else
											{
												// ----------------------------------------------
												// C. REVERSE OLD POSTED GROUP ALLOCATIONS
												// ----------------------------------------------
												old_alloc_text = ifnull(input.Old_Group_Allocations_Text,"");
												old_receipt_date = input.Old_Group_Alloc_Payment_Date;
												if(old_alloc_text != "" && old_receipt_date != null)
												{
													old_rows = old_alloc_text.toList("||");
													for each  old_snapshot_row in old_rows
													{
														if(old_snapshot_row != null && old_snapshot_row.trim() != "")
														{
															parts = old_snapshot_row.toList("=");
															if(parts.size() == 2)
															{
																old_group_id_text = parts.get(0);
																old_amt_text = parts.get(1);
																if(old_group_id_text != "" && old_amt_text != "")
																{
																	old_group_id = old_group_id_text.toLong();
																	old_amt = round(old_amt_text.toDecimal(),2);
																	old_grp_rec = Group_Accounts[Group == old_group_id && Payment_Date == old_receipt_date && Source_Group == "Employee Income"];
																	if(old_grp_rec.ID != null)
																	{
																		new_old_total = round(ifnull(old_grp_rec.Amount_Actually_Received,0.0) - old_amt,2);
																		if(new_old_total < 0)
																		{
																			new_old_total = 0.0;
																		}
																		old_grp_rec.Amount_Actually_Received=new_old_total;
																	}
																}
															}
														}
													}
												}
												// ----------------------------------------------
												// D. APPLY NEW GROUP ALLOCATIONS
												// ----------------------------------------------
												group_allocs = emp_resp.get("group_allocations");
												new_alloc_text = "";
												if(group_allocs != null)
												{
													merged_group_totals = Map();
													for each  ga_map in group_allocs
													{
														group_id_val = ga_map.get("group_id");
														amount_received_val = round(ifnull(ga_map.get("amount_actually_received"),0.0),2);
														if(group_id_val != null)
														{
															group_key = group_id_val.toString();
															existing_total = round(ifnull(merged_group_totals.get(group_key),0.0),2);
															merged_group_totals.put(group_key,round(existing_total + amount_received_val,2));
														}
													}
													for each  group_key in merged_group_totals.keys()
													{
														group_id_num = group_key.toLong();
														final_amt = round(ifnull(merged_group_totals.get(group_key),0.0),2);
														existing_grp = Group_Accounts[Group == group_id_num && Payment_Date == receipt_date_val && Source_Group == "Employee Income"];
														if(existing_grp.ID != null)
														{
															existing_grp.Amount_Actually_Received=round(ifnull(existing_grp.Amount_Actually_Received,0.0) + final_amt,2);
														}
														else
														{
															insert into Group_Accounts
															[
																Payment_Date=receipt_date_val
																Group=group_id_num
																Source_Group="Employee Income"
																Amount_Actually_Received=final_amt
																Added_User=zoho.loginuser
															]
														}
														if(new_alloc_text != "")
														{
															new_alloc_text = new_alloc_text + "||";
														}
														new_alloc_text = new_alloc_text + group_key + "=" + final_amt.toString();
													}
												}
												// ----------------------------------------------
												// E. SAVE NEW SNAPSHOT FOR FUTURE EDITS
												// ----------------------------------------------
												input.Old_Group_Allocations_Text = new_alloc_text;
												input.Old_Group_Alloc_Payment_Date = receipt_date_val;
												input.Old_Invoice_Number = current_invoice_no;
												info "Employee Invoice Updated -> Received: " + emp_resp.get("invoice_amount_paid") + " | Status: " + emp_resp.get("payment_status");
											}
										}
										else
										{
											// ==================================================
											// 3) IF INVOICE WAS CLEARED ON EDIT, KEEP OLD INVOICE IN SYNC
											// ==================================================
											if(old_invoice_no != "")
											{
												if(input.System == "Employee Management")
												{
													old_invoice_total_received = 0.0;
													old_invoice_rows2 = Cash_Receipt_Details[System == "Employee Management" && Invoice_Number == old_invoice_no];
													for each  old_row2 in old_invoice_rows2
													{
														old_row_amt2 = round(ifnull(old_row2.Amount_Received,0.0),2);
														if(old_row_amt2 > 0)
														{
															old_invoice_total_received = round(old_invoice_total_received + old_row_amt2,2);
														}
													}
													old_payload2 = Map();
													old_payload2.put("Invoice_Number",old_invoice_no);
													old_payload2.put("Total_Received",old_invoice_total_received);
													old_payload2.put("Receipt_Date",receipt_date_val);
													old_resp2 = employee_management.updateInvoiceFromReceipt(old_payload2);
													if(old_resp2 == null)
													{
														info "Old Employee invoice clear-sync failed: no response";
													}
													else if(old_resp2.get("ok") != true)
													{
														info "Old Employee invoice clear-sync failed: " + ifnull(old_resp2.get("msg"),"unknown error");
													}
												}
											}
											input.Old_Group_Allocations_Text = "";
											input.Old_Group_Alloc_Payment_Date = null;
											input.Old_Invoice_Number = "";
										}
										// ==================================================
										// FINAL STEP: UPDATE CASH RECEIPT VOUCHER TOTALS
										// ==================================================
										if(input.Cash_Receipt_Voucher != null)
										{
											crv = Cash_Receipt_Voucher[ID == input.Cash_Receipt_Voucher];
											if(crv.ID != null)
											{
												total_assigned = 0.0;
												all_rows = Cash_Receipt_Details[Cash_Receipt_Voucher == crv.ID];
												for each  r in all_rows
												{
													amt = round(ifnull(r.Amount_Received,0.0),2);
													if(amt > 0)
													{
														total_assigned = round(total_assigned + amt,2);
													}
												}
												total_received = round(ifnull(crv.Total_Amount_Received,0.0),2);
												balance_not_assigned = round(total_received - total_assigned,2);
												if(balance_not_assigned < 0)
												{
													balance_not_assigned = 0.0;
												}
												crv.Total_Amount_Allocated=total_assigned;
												crv.Total_Amount_Not_Allocated=balance_not_assigned;
												if(total_received <= 0)
												{
													crv.Payment_Receipt_Voucher_Status="Draft";
												}
												else if(total_assigned <= 0)
												{
													crv.Payment_Receipt_Voucher_Status="Unassigned";
												}
												else if(balance_not_assigned > 0)
												{
													crv.Payment_Receipt_Voucher_Status="Partially Assigned";
												}
												else
												{
													crv.Payment_Receipt_Voucher_Status="Fully Assigned";
												}
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete1 as "Finalize On Delete"
			{
				type =  form
				form = Cash_Receipt_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ==================================================
										// CASH RECEIPT DETAILS -> FINALIZE ON DELETE
										// ==================================================
										deleted_invoice_no = ifnull(input.Old_Invoice_Number,"").trim();
										if(deleted_invoice_no == "")
										{
											deleted_invoice_no = ifnull(input.Invoice_Number,"").trim();
										}
										receipt_date_val = null;
										if(input.Old_Group_Alloc_Payment_Date != null)
										{
											receipt_date_val = input.Old_Group_Alloc_Payment_Date;
										}
										else if(input.Cash_Receipt_Date != null)
										{
											receipt_date_val = input.Cash_Receipt_Date;
										}
										else
										{
											receipt_date_val = zoho.currentdate;
										}
										// ==================================================
										// 1) REVERSE OLD GROUP ALLOCATIONS FOR THE DELETED ROW
										// ==================================================
										old_alloc_text = ifnull(input.Old_Group_Allocations_Text,"");
										old_receipt_date = input.Old_Group_Alloc_Payment_Date;
										if(old_alloc_text != "" && old_receipt_date != null)
										{
											old_rows = old_alloc_text.toList("||");
											for each  old_snapshot_row in old_rows
											{
												if(old_snapshot_row != null && old_snapshot_row.trim() != "")
												{
													parts = old_snapshot_row.toList("=");
													if(parts.size() == 2)
													{
														old_group_id_text = parts.get(0);
														old_amt_text = parts.get(1);
														if(old_group_id_text != "" && old_amt_text != "")
														{
															old_group_id = old_group_id_text.toLong();
															old_amt = round(old_amt_text.toDecimal(),2);
															old_grp_rec = Group_Accounts[Group == old_group_id && Payment_Date == old_receipt_date && Source_Group == "Employee Income"];
															if(old_grp_rec.ID != null)
															{
																new_old_total = round(ifnull(old_grp_rec.Amount_Actually_Received,0.0) - old_amt,2);
																if(new_old_total < 0)
																{
																	new_old_total = 0.0;
																}
																old_grp_rec.Amount_Actually_Received=new_old_total;
															}
														}
													}
												}
											}
										}
										// ==================================================
										// 2) RECOMPUTE THE INVOICE AFTER DELETE
										// ==================================================
										if(input.System == "Employee Management" && deleted_invoice_no != "")
										{
											recomputed_total = 0.0;
											remaining_rows = Cash_Receipt_Details[System == "Employee Management" && Invoice_Number == deleted_invoice_no];
											for each  rec_row in remaining_rows
											{
												row_amt = round(ifnull(rec_row.Amount_Received,0.0),2);
												if(row_amt > 0)
												{
													recomputed_total = round(recomputed_total + row_amt,2);
												}
											}
											payload = Map();
											payload.put("Invoice_Number",deleted_invoice_no);
											payload.put("Total_Received",recomputed_total);
											payload.put("Receipt_Date",receipt_date_val);
											emp_resp = employee_management.updateInvoiceFromReceipt(payload);
											if(emp_resp == null)
											{
												info "Employee invoice delete-sync failed: no response";
											}
											else if(emp_resp.get("ok") != true)
											{
												info "Employee invoice delete-sync failed: " + ifnull(emp_resp.get("msg"),"unknown error");
											}
											else
											{
												info "Employee Invoice Updated After Delete -> Received: " + emp_resp.get("invoice_amount_paid") + " | Status: " + emp_resp.get("payment_status");
											}
										}
										// ==================================================
										// 3) UPDATE CASH RECEIPT VOUCHER TOTALS AFTER DELETE
										// IMPORTANT:
										// In delete actions, lookup access may fail.
										// So only do this if the parent ID is stored safely.
										// ==================================================
						)
					}
				}

			}
			Set_Up_Form2 as "Set Up Form"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// PAYMENT VOUCHER - SET UP FORM
										// Parent Form: Payment_Voucher
										// Event: Load of the form
										// ======================================
										// --------------------------------------
										// DISABLE SYSTEM / CALCULATED FIELDS
										// --------------------------------------
										disable Amount_Assigned;
										disable Balance_Not_Assigned;
										disable Payment_Voucher_Status;
										disable Old_Amount_Paid;
										disable Old_Account_Paying;
										// --------------------------------------
										// HIDE INTERNAL OLD VALUE FIELDS
										// --------------------------------------
										hide Old_Amount_Paid;
										hide Old_Account_Paying;
										// --------------------------------------
										// DISABLE SUBFORM SYSTEM FIELDS
										// Subform: Payment_Details
										// --------------------------------------
										disable Payment_Details.Payment_Voucher_Date;
										disable Payment_Details.Line_Number;
										disable Payment_Details.Display_Name_Payment_Voucher;
										disable Payment_Details.Bill_Number;
										disable Payment_Details.Amount_Due;
										disable Payment_Details.Old_Amount_Paid;
										disable Payment_Details.Old_Bill_Number;
										disable Payment_Details.Old_Group_Allocations_Text;
										disable Payment_Details.Old_Group_Alloc_Payment_Date;
										// --------------------------------------
										// DO NOT HIDE BILL LOOKUP FIELDS HERE
										// They are controlled dynamically by:
										// Payment_Details → On user input of System
										// --------------------------------------
										show Payment_Details.Store_Management_Bill;
										show Payment_Details.Asset_Management_Bill;
										show Payment_Details.Employee_Management_Bill;
										// --------------------------------------
										// HIDE SUBFORM INTERNAL FIELDS
										// --------------------------------------
										hide Payment_Details.Display_Name_Payment_Voucher;
										hide Payment_Details.Old_Amount_Paid;
										hide Payment_Details.Old_Bill_Number;
										hide Payment_Details.Old_Group_Allocations_Text;
										hide Payment_Details.Old_Group_Alloc_Payment_Date;
										// --------------------------------------
										// DEFAULT VALUES ON NEW RECORD
										// --------------------------------------
										if(input.ID == null)
										{
											input.Payment_Voucher_Date = zoho.currentdate;
											input.Amount_Assigned = 0.0;
											input.Balance_Not_Assigned = ifnull(input.Total_Amount_Paid,0.0);
											input.Payment_Voucher_Status = "Draft";
										}
										// --------------------------------------
										// SAVE OLD VALUES ON EDIT
										// --------------------------------------
										if(input.ID != null)
										{
											input.Old_Amount_Paid = ifnull(input.Total_Amount_Paid,0.0);
											input.Old_Account_Paying = input.Account_Paying;
										}
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			On_Asset_Management_Bill_1 as "On Asset Management Bill Selected"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on user input of Payment_Details.Asset_Management_Bill
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// PAYMENT DETAILS SUBFORM
										// On user input of Asset_Management_Bill
										// Parent Form: Payment_Voucher
										// Subform: Payment_Details
										// ======================================
										if(row.Asset_Management_Bill != null)
										{
											row.Bill_Number=ifnull(row.Asset_Management_Bill.Bill_Number,"");
											row.Amount_Due=ifnull(row.Asset_Management_Bill.Balance_Due,0.0);
										}
										else
										{
											row.Bill_Number="";
											row.Amount_Due=0.0;
										}
						)
					}
				}

			}
			On_Employee_Management_Bi1 as "On Employee Management Bill Selected"
			{
				type =  form
