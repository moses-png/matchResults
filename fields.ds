			On_Customer_Selected3 as "On Customer Selected"
			{
				type =  form
				form = Delivery_Note

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// DELIVERY NOTE → ON CUSTOMER SELECTED
										// =====================================
										// If customer is cleared
										if(input.Customer == null)
										{
											input.Display_Name_Customer = null;
											input.Purchase_Order = null;
											input.Purchase_Order_Details = null;
											input.Location = null;
											hide Purchase_Order;
											hide Purchase_Order_Details;
											hide Location;
											hide Delivery_Note_Date;
											return;
										}
										// Auto-fill Display Name Customer
										input.Display_Name_Customer = input.Customer.Display_Name_Customer;
										// Customer-specific rule
										custName = ifnull(input.Customer.Display_Name_Customer,"").trim();
										if(custName == "Mrsand - 20" || custName == "Grapes Trucks - 18")
										{
											input.Purchase_Order = null;
											input.Purchase_Order_Details = null;
											input.Location = null;
											hide Purchase_Order;
											hide Purchase_Order_Details;
											hide Location;
											hide Delivery_Note_Date;
										}
										else
										{
											show Purchase_Order;
											show Purchase_Order_Details;
											show Location;
											show Delivery_Note_Date;
										}
						)
					}
				}

			}
