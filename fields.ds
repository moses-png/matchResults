			On_Asset_Selected6 as "On Asset Selected"
			{
				type =  form
				form = Asset_Transfer_Multiple_Voucher

				record event = on add or edit

				on user input of Transfer_Vouchers.Asset
				{
					actions 
					{
						custom deluge script
						(
											for each  r in input.Transfer_Vouchers
										{
											if(r.Asset != null)
											{
												asset_rec = Asset_List[ID == r.Asset];
												if(asset_rec.ID != null)
												{
													r.Display_Name_Asset=asset_rec.Asset_Name + " - " + asset_rec.Asset_ID;
													if(asset_rec.Current_Site != null && asset_rec.Current_Site != "")
													{
														site_rec = Asset_List[Display_Name_Asset_Name == asset_rec.Current_Site];
														if(site_rec.ID != null)
														{
															r.Old_Current_Site=site_rec.ID;
														}
														else
														{
															r.Old_Current_Site=null;
														}
													}
													else
													{
														r.Old_Current_Site=null;
													}
													r.Old_Current_Custodian=null;
													r.Old_Last_Transfer_Date=asset_rec.Last_Transfer_Date;
													r.Old_Last_Transfer_Reference=asset_rec.Last_Transfer_Reference;
												}
												else
												{
													r.Display_Name_Asset="";
													r.Old_Current_Site=null;
													r.Old_Current_Custodian=null;
													r.Old_Last_Transfer_Date=null;
													r.Old_Last_Transfer_Reference="";
												}
											}
											else
											{
												r.Display_Name_Asset="";
												r.Old_Current_Site=null;
												r.Old_Current_Custodian=null;
												r.Old_Last_Transfer_Date=null;
												r.Old_Last_Transfer_Reference="";
											}
										}
						)
					}
				}

			}
			Finalize5 as "Finalize"
			{
				type =  form
				form = Bill_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ====================================================
										// 0) Always recalculate this Bill Detail line total first
										// ====================================================
										input.Line_Total = round(ifnull(input.Quantity,0.0) * ifnull(input.Rate,0.0),2);
										// ====================================================
										// 1) Update Work Order Task billing status
										// ====================================================
										if(input.Parts_Consumables != null)
										{
											pc = Parts_Consumables[ID == input.Parts_Consumables];
											if(pc.ID != null && pc.Work_Order_Task_Number != null)
											{
												wot = Work_Order_Tasks[ID == pc.Work_Order_Task_Number.ID];
												if(wot.ID != null)
												{
													all_billed = true;
													for each  r in wot.Parts_Consumables
													{
														row_has_bill = false;
														if(r.ID != null)
														{
															bd_list = Bill_Details[Parts_Consumables == r.ID];
															for each  bd in bd_list
															{
																if(bd.Bill != null)
																{
																	row_has_bill = true;
																	break;
																}
															}
														}
														if(row_has_bill == false)
														{
															all_billed = false;
															break;
														}
													}
													if(all_billed)
													{
														wot.Work_Order_Task_Status="Invoiced";
													}
													else
													{
														wot.Work_Order_Task_Status="Invoicing";
													}
												}
											}
										}
										// ====================================================
										// 2) Recalculate parent Bill totals
										// ====================================================
										if(input.Bill != null)
										{
											billRec = Bill[ID == input.Bill.ID];
											if(billRec.ID != null)
											{
												total_amount = 0.0;
												bill_rows = Bill_Details[Bill == billRec.ID];
												for each  br in bill_rows
												{
													total_amount = total_amount + ifnull(br.Line_Total,0.0);
												}
												total_amount = round(total_amount,2);
												bill_total = round(ifnull(billRec.Bill_Total,0.0),2);
												tax_amount = round(ifnull(billRec.Tax_Amount,0.0),2);
												discount_amount = round(ifnull(billRec.Discount_Amount,0.0),2);
												amount_paid = round(ifnull(billRec.Amount_Paid,0.0),2);
												amount_due = round(total_amount + tax_amount - discount_amount,2);
												payment_status = "Not Paid";
												if(amount_paid <= 0)
												{
													payment_status = "Not Paid";
												}
												else if(amount_paid < amount_due)
												{
													payment_status = "Partially Paid";
												}
												else
												{
													payment_status = "Paid";
												}
												bill_status = "Draft";
												if(abs(bill_total - total_amount) <= 0.01)
												{
													bill_status = "Billed";
												}
												billRec.Total_Amount=total_amount;
												billRec.Amount_Paid=amount_paid;
												billRec.Amount_Due=amount_due;
												billRec.Payment_Status=payment_status;
												billRec.Bill_Status=bill_status;
											}
										}
										// ====================================================
										// 3) Send Group Expense delta to Payment Management
										// ====================================================
										if(input.Group != null)
										{
											new_amount = round(ifnull(input.Line_Total,0.0),2);
											old_amount = round(ifnull(input.Last_Synced_Group_Amount,0.0),2);
											delta_amount = round(new_amount - old_amount,2);
											if(delta_amount != 0)
											{
												source_group = "Asset Bill";
												// Fuel
												if(input.Source != null && input.Source.contains("Fuel Receiving Voucher"))
												{
													source_group = "Fuel";
												}
												// Asset Transfer
												else if(input.Source != null && input.Source.contains("Asset Transfer"))
												{
													source_group = "Service Expenses";
												}
												// Work Order Task / Service Expenses
												else if(input.Parts_Consumables != null)
												{
													pc_for_source = Parts_Consumables[ID == input.Parts_Consumables];
													if(pc_for_source.ID != null && pc_for_source.Work_Order_Task_Number != null)
													{
														source_group = "Service Expenses";
													}
												}
												payload = Map();
												payload.put("Group_ID",input.Group.ID);
												payload.put("Amount_Delta",delta_amount);
												payload.put("Source_Group",source_group);
												payload.put("Source_Bill_Detail_ID",input.ID);
												if(input.Bill != null)
												{
													payload.put("Source_Bill_ID",input.Bill.ID);
												}
												pay_date = zoho.currentdate;
												if(input.Bill != null && input.Bill.Bill_Date != null)
												{
													pay_date = input.Bill.Bill_Date;
												}
												payload.put("Payment_Date",pay_date);
												resp = payment_management.createGroupExpenseFromAssetBill(payload);
												info resp;
												input.Last_Synced_Group_Amount = new_amount;
											}
										}
										// ====================================================
										// 4) Push Bill Detail changes back to Fuel Receiving Voucher
										// ====================================================
										if(input.Source != null && input.Source.contains("Fuel Receiving Voucher"))
										{
											if(input.Reference != null && input.Reference.trim() != "")
											{
												fuel_rec = Fuel_Receiving_Voucher[Fuel_Voucher == input.Reference];
												if(fuel_rec.ID != null)
												{
													fuel_rec.Rate=round(ifnull(input.Rate,0.0),2);
													fuel_rec.Status="Billed";
													asset_log = Asset_Transaction_Log[Source_Form == "Fuel Receiving Voucher" && Source_Record_ID == fuel_rec.ID];
													if(asset_log.ID != null)
													{
														asset_log.Transaction_Status="Posted";
														asset_log.Amount=ifnull(input.Line_Total,0.0);
														asset_log.Expenses=ifnull(input.Line_Total,0.0);
														asset_log.Income=0.0;
													}
												}
											}
										}
						)
					}
				}

			}
			On_Bill_Selected1 as "On Bill Selected"
			{
				type =  form
				form = Bill_Details

				record event = on add or edit

				on user input of Bill
				{
					actions 
					{
						custom deluge script
						(
											if(input.Bill != null)
										{
											input.Display_Name_Bill = ifnull(input.Bill.Bill_Name + " - " + input.Bill.Bill_Number,"");
											//Find existing Bill Details for this Bill
											rows = Bill_Details[Bill == input.Bill];
											max_line = 0;
											for each  r in rows
											{
												if(ifnull(r.Line_Number,0) > max_line)
												{
													max_line = r.Line_Number;
												}
											}
											//Set next line number
											input.Line_Number = max_line + 1;
										}
										else
										{
											input.Display_Name_Bill = "";
											input.Line_Number = null;
										}
						)
					}
				}

			}
