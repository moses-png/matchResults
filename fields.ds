			On_Stock_Production_Selec as "On Stock Production Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Batch_Number_From
				{
					actions 
					{
						custom deluge script
						(
											// Truck Movement Voucher
										// On User Input of Stock_Production
										if(input.Batch_Number_From != null)
										{
											sp = Stock_Production[ID == input.Batch_Number_From];
											if(sp.ID != null)
											{
												// =========================
												// FROM SITE
												// =========================
												input.Site_From = sp.Site;
												input.Display_Name_Site_From = ifnull(sp.Display_Name_Site,"");
												// =========================
												// WORK DONE
												// =========================
												input.Work_Done = ifnull(sp.Materials_Produced,"");
												// =========================
												// PICK UP TEXT (SITE ONLY)
												// =========================
												input.Pick_Up_From = ifnull(input.Display_Name_Site_From,"");
												// =========================
												// DELIVER TO TEXT (SITE ONLY)
												// =========================
												Deliver_To = ifnull(input.Display_Name_Site_To,"");
											}
										}
										else
										{
											// =========================
											// CLEAR FROM
											// =========================
											input.Site_From = null;
											input.Display_Name_Site_From = "";
											input.Pick_Up_From = "";
											// DO NOT CLEAR Site_Location_From
											// =========================
											// CLEAR TO
											// =========================
											input.Site_To = null;
											input.Display_Name_Site_To = "";
											Deliver_To = "";
											// DO NOT CLEAR Site_Location_To
											// =========================
											// CLEAR WORK DONE
											// =========================
											input.Work_Done = "";
										}
						)
					}
				}

			}
			On_Truck_Movement_Voucher as "On Truck Movement Voucher Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Truck_Movement_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Truck_Movement_Voucher != null)
										{
											oldMove = Truck_Movement_Voucher[ID == input.Truck_Movement_Voucher];
											if(oldMove.ID != null)
											{
												// Pickup comes from previous delivery
												input.Party_From = oldMove.Party_To;
												input.Display_Name_Party_From = oldMove.Display_Name_Party_To;
												input.Party_Location_From = oldMove.Party_Location_To;
												input.Pick_Up_From = oldMove.Delivery_To;
												// Work done
												input.Work_Done = "Return Truck To Site";
												// Optional note
												input.Small_Notes = "Returning truck from previous delivery: " + oldMove.Display_Name_Voucher;
											}
										}
										else
										{
											input.Party_From = null;
											input.Display_Name_Party_From = "";
											input.Party_Location_From = null;
											input.Pick_Up_From = "";
											input.Work_Done = "";
											input.Small_Notes = "";
										}
						)
					}
				}

			}
			Set_Up_Form22 as "Set Up Form"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// DRAGER WORK REPORT -> SET UP FORM
										// ========================================
										// SAVE VALUES THAT MUST NOT CLEAR ON EDIT
										oldWorkDone = input.Work_Done;
										oldBatchFrom = input.Batch_Number_From;
										oldDisplayBatchFrom = input.Display_Name_Batch_Number_From;
										// DISABLE FIELDS
										disable Display_Name_Voucher;
										disable Display_Name_Employee;
										disable Display_Name_Site;
										disable Display_Name_Asset;
										disable Line_Number;
										disable Display_Name_Batch_Number_From;
										disable Work_Done;
										disable Display_Name_Batch_Number_To;
										disable Time_Start;
										disable Time_End;
										disable Reason_Why_Cancelled;
										disable Line_Duration_Minutes;
										disable Line_Hours_Worked;
										disable Drager_Work_Report_Status;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// HIDE DEFAULT FIELDS
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										hide Display_Name_Site;
										hide Display_Name_Asset;
										hide Line_Number;
										hide Display_Name_Batch_Number_From;
										hide Display_Name_Batch_Number_To;
										hide Work_Order_Task;
										hide Batch_Number_From;
										hide Batch_Number_To;
										hide Truck_Movement_Voucher;
										hide Drager_Work_Report;
										hide Time_Start;
										hide Odometer_End;
										hide Time_End;
										hide Image_After;
										hide Cancelled;
										hide Reason_Why_Cancelled;
										hide Line_Summary;
										hide Cost_Per_Odometer;
										hide Total;
										hide Line_Duration_Minutes;
										hide Line_Hours_Worked;
										hide Drager_Work_Report_Status;
										hide Back_End;
										// ========================================
										// CREATE MODE
										// ========================================
										if(input.ID == null)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											show Voucher;
											show Location;
											show Job;
											show Work_Done;
											show Image_Before;
											show Odometer_Start;
											hide Work_Order_Task;
											hide Batch_Number_From;
											hide Batch_Number_To;
											hide Truck_Movement_Voucher;
											hide Odometer_End;
											hide Time_Start;
											hide Time_End;
											hide Image_After;
											hide Cancelled;
											hide Reason_Why_Cancelled;
										}
										// ========================================
										// EDIT MODE
										// ========================================
										else
										{
											show Voucher;
											show Line_Number;
											show Location;
											show Job;
											show Work_Done;
											show Image_Before;
											show Odometer_Start;
											show Cancelled;
											show Drager_Work_Report_Status;
											disable Voucher;
											disable Location;
											disable Job;
											disable Odometer_Start;
											// ========================================
											// CANCELLED CHECKBOX
											// ========================================
											if(input.Cancelled == true)
											{
												show Reason_Why_Cancelled;
												enable Reason_Why_Cancelled;
											}
											else
											{
												hide Reason_Why_Cancelled;
												input.Reason_Why_Cancelled = null;
											}
											// ========================================
											// JOB-BASED SHOW / HIDE
											// DO NOT CLEAR SAVED LOOKUPS ON EDIT
											// ========================================
											hide Work_Order_Task;
											hide Batch_Number_From;
											hide Batch_Number_To;
											hide Truck_Movement_Voucher;
											if(input.Job != null)
											{
												jobNo = input.Job.Job_No;
												if(jobNo == "TJS01")
												{
													show Batch_Number_From;
													enable Batch_Number_From;
												}
												else if(jobNo == "TJS02")
												{
													show Work_Order_Task;
													enable Work_Order_Task;
												}
												else if(jobNo == "TJS03")
												{
													show Batch_Number_To;
													enable Batch_Number_To;
												}
												else if(jobNo == "TJS04")
												{
													show Truck_Movement_Voucher;
													enable Truck_Movement_Voucher;
												}
											}
											// RESTORE IMPORTANT VALUES
											if(input.Batch_Number_From == null && oldBatchFrom != null)
											{
												input.Batch_Number_From = oldBatchFrom;
											}
											if(ifnull(input.Display_Name_Batch_Number_From,"") == "" && ifnull(oldDisplayBatchFrom,"") != "")
											{
												input.Display_Name_Batch_Number_From = oldDisplayBatchFrom;
											}
											if(ifnull(input.Work_Done,"") == "" && ifnull(oldWorkDone,"") != "")
											{
												input.Work_Done = oldWorkDone;
											}
											// ========================================
											// STATUS: IN PROGRESS
											// ========================================
											if(input.Drager_Work_Report_Status == "In Progress")
											{
												show Work_Done;
												hide Image_Before;
												disable Image_Before;
												show Image_After;
												show Odometer_End;
												enable Image_After;
												enable Odometer_End;
											}
											// ========================================
											// STATUS: COMPLETED
											// ========================================
											else if(input.Drager_Work_Report_Status == "Completed")
											{
												show Work_Done;
												show Image_Before;
												show Image_After;
												show Odometer_End;
												show Time_Start;
												show Time_End;
												show Line_Duration_Minutes;
												show Line_Hours_Worked;
												show Cost_Per_Odometer;
												show Total;
												disable Voucher;
												disable Location;
												disable Job;
												disable Work_Done;
												disable Odometer_Start;
												disable Odometer_End;
												disable Work_Order_Task;
												disable Batch_Number_From;
												disable Batch_Number_To;
												disable Truck_Movement_Voucher;
												disable Time_Start;
												disable Time_End;
												disable Image_Before;
												disable Image_After;
												disable Cancelled;
											}
											// ========================================
											// STATUS: CANCELLED
											// ========================================
											else if(input.Drager_Work_Report_Status == "Cancelled")
											{
												show Reason_Why_Cancelled;
												disable Voucher;
												disable Location;
												disable Job;
												disable Work_Done;
												disable Odometer_Start;
												disable Odometer_End;
												disable Work_Order_Task;
												disable Batch_Number_From;
												disable Batch_Number_To;
												disable Truck_Movement_Voucher;
												disable Image_Before;
												disable Image_After;
												disable Time_Start;
												disable Time_End;
											}
											// FINAL PROTECTION
											if(input.Batch_Number_From == null && oldBatchFrom != null)
											{
												input.Batch_Number_From = oldBatchFrom;
											}
											if(ifnull(input.Display_Name_Batch_Number_From,"") == "" && ifnull(oldDisplayBatchFrom,"") != "")
											{
												input.Display_Name_Batch_Number_From = oldDisplayBatchFrom;
											}
											if(ifnull(input.Work_Done,"") == "" && ifnull(oldWorkDone,"") != "")
											{
												input.Work_Done = oldWorkDone;
											}
										}
						)
					}
				}

			}
			Finalize_On_Create12 as "Finalize On Create"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
						)
					}
				}

			}
