			Full_Validation11 as "Full Validation"
			{
				type =  form
				form = Routine_Issues

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Routine Issues - Validation on Form Submission
										errors = "";
										if(input.Asset == null)
										{
											errors = errors + "\n• Asset is required.";
										}
										if(input.Labour == null)
										{
											errors = errors + "\n• Labour is required.";
										}
										// At least one schedule required
										if(input.Odometer_Frequency == null && input.Frequency_Value == null || input.Date_Frequency == null)
										{
											errors = errors + "\n• Enter Odometer Frequency or Date Frequency with Frequency Value.";
										}
										// Odometer checks
										if(input.Odometer_Frequency != null && input.Odometer_Frequency <= 0)
										{
											errors = errors + "\n• Odometer Frequency must be greater than 0.";
										}
										if(input.Last_Done_Odometer != null && input.Last_Done_Odometer < 0)
										{
											errors = errors + "\n• Last Done Odometer cannot be negative.";
										}
										// Date schedule checks
										if(input.Frequency_Value == null && input.Date_Frequency != null)
										{
											errors = errors + "\n• Frequency Value is required.";
										}
										if(input.Frequency_Value != null && input.Date_Frequency == null)
										{
											errors = errors + "\n• Date Frequency is required.";
										}
										if(input.Frequency_Value != null && input.Frequency_Value <= 0)
										{
											errors = errors + "\n• Frequency Value must be greater than 0.";
										}
										// Date check
										if(input.Last_Done_Date != null && input.Last_Done_Date > zoho.currentdate)
										{
											errors = errors + "\n• Last Done Date cannot be in the future.";
										}
										// Duplicate rule
										if(input.Asset != null && input.Labour != null)
										{
											dup = Routine_Issues[ID != input.ID && Asset == input.Asset && Labour == input.Labour];
											if(dup.count() > 0)
											{
												errors = errors + "\n• This asset already has this labour routine.";
											}
										}
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
