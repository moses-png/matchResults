			Full_Validation24 as "Full Validation"
			{
				type =  form
				form = Employment_Status

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------
										// Employee is required
										// ------------------------------
										if(input.Employee == null)
										{
											alert "Employee is required.";
											cancel submit;
										}
										// ------------------------------
										// Employee Status Date is required
										// ------------------------------
										if(input.Employee_Status_Date == null)
										{
											alert "Employee Status Date is required.";
											cancel submit;
										}
										// ------------------------------
										// Date Started is required
										// ------------------------------
										if(input.Date_Started == null)
										{
											alert "Date Started is required.";
											cancel submit;
										}
										// ------------------------------
										// Date Ended cannot be before Date Started
										// ------------------------------
										if(input.Date_Ended != null && input.Date_Started != null)
										{
											if(input.Date_Ended < input.Date_Started)
											{
												alert "Date Ended cannot be before Date Started.";
												cancel submit;
											}
										}
										// ------------------------------
										// Inactive status requires Date Ended
										// ------------------------------
										if(input.Employment_Status == "Inactive" && input.Date_Ended == null)
										{
											alert "Date Ended is required when Employment Status is Inactive.";
											cancel submit;
										}
										// ------------------------------
										// Active status should not have Date Ended
										// ------------------------------
										if(input.Employment_Status == "Active" && input.Date_Ended != null)
										{
											alert "Date Ended should be empty when Employment Status is Active.";
											cancel submit;
										}
										// ------------------------------
										// Prevent overlapping employment periods
										// ------------------------------
										current_start = input.Date_Started;
										current_end = input.Date_Ended;
										if(current_end == null)
										{
											current_end = zoho.currentdate.addYear(100);
										}
										existing_records = Employment_Status[Employee == input.Employee && ID != input.ID];
										for each  rec in existing_records
										{
											existing_start = rec.Date_Started;
											existing_end = rec.Date_Ended;
											if(existing_end == null)
											{
												existing_end = zoho.currentdate.addYear(100);
											}
											if(existing_start != null)
											{
												if(current_start <= existing_end && current_end >= existing_start)
												{
													alert "This employment period overlaps with another employment status record for this employee.";
													cancel submit;
												}
											}
										}
										// ------------------------------
										// Salary and allowance validation
										// ------------------------------
										if(input.Daily_Allowance != null && input.Daily_Allowance < 0)
										{
											alert "Daily Allowance cannot be negative.";
											cancel submit;
										}
										if(input.Weekly_Allowance != null && input.Weekly_Allowance < 0)
										{
											alert "Weekly Allowance cannot be negative.";
											cancel submit;
										}
										if(input.Monthly_Salary != null && input.Monthly_Salary < 0)
										{
											alert "Monthly Salary cannot be negative.";
											cancel submit;
										}
										// ------------------------------
										// Calculate estimated take
										// ------------------------------
										daily_allowance = ifnull(input.Daily_Allowance,0);
										weekly_allowance = ifnull(input.Weekly_Allowance,0);
										monthly_salary = ifnull(input.Monthly_Salary,0);
										input.Estimated_Take_per_day = daily_allowance + weekly_allowance / 7 + monthly_salary / 30;
										input.Estimated_Take_per_month = input.Estimated_Take_per_day * 30;
										// ------------------------------
										// Display Name Employee sync
										// ------------------------------
										if(input.Employee != null)
										{
											input.Display_Name_Employee = input.Employee.Employee_Name + " - " + input.Employee.Employee_Number;
										}
										else
										{
											input.Display_Name_Employee = "";
										}
						)
					}
				}

			}
			Finalize17 as "Finalize"
			{
				type =  form
				form = Employment_Status

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------
										// Final sync after successful submission
										// ------------------------------
										if(input.Employee != null)
										{
											employee_rec = Employee_Register[ID == input.Employee];
											if(employee_rec.ID != null)
											{
												employee_rec.Employment_Status=input.Employment_Status;
											}
										}
										// ------------------------------
										// Close overlapping / previous active records
										// ------------------------------
										if(input.Employment_Status == "Active" && input.Employee != null)
										{
											old_records = Employment_Status[Employee == input.Employee && Employment_Status == "Active" && ID != input.ID];
											for each  rec in old_records
											{
												rec.Employment_Status="Inactive";
												if(rec.Date_Ended == null)
												{
													rec.Date_Ended=input.Date_Started;
												}
											}
										}
						)
					}
				}

			}
			On_Date_Started_Selected as "On Date Started Selected"
			{
				type =  form
				form = Employment_Status

				record event = on add or edit

				on user input of Date_Started
				{
					actions 
					{
						custom deluge script
						(
											// Date Started must not be blank
										if(input.Date_Started == null)
										{
											alert "Date Started is required.";
										}
										// Date Started cannot be after Date Ended
										if(input.Date_Started != null && input.Date_Ended != null)
										{
											if(input.Date_Started > input.Date_Ended)
											{
												alert "Date Started cannot be after Date Ended.";
												input.Date_Ended = null;
											}
										}
										// If Active, Date Ended should stay empty
										if(input.Employment_Status == "Active")
										{
											input.Date_Ended = null;
										}
										// If this is a new record, use Date Started as Employee Status Date
										if(input.Employee_Status_Date == null && input.Date_Started != null)
										{
											input.Employee_Status_Date = input.Date_Started;
										}
						)
					}
				}

			}
			On_Date_Ended_Selected as "On Date Ended Selected"
			{
				type =  form
				form = Employment_Status

				record event = on add or edit

				on user input of Date_Ended
				{
					actions 
					{
						custom deluge script
						(
											// Date Ended cannot be before Date Started
										if(input.Date_Ended != null && input.Date_Started != null)
										{
											if(input.Date_Ended < input.Date_Started)
											{
												alert "Date Ended cannot be before Date Started.";
												input.Date_Ended = null;
											}
										}
										// If Date Ended is entered, status should become Inactive
										if(input.Date_Ended != null)
										{
											input.Employment_Status = "Inactive";
										}
										// If Date Ended is cleared, status can remain Active
										if(input.Date_Ended == null && input.Employment_Status == "Inactive")
										{
											input.Employment_Status = "Active";
										}
						)
					}
				}

			}
