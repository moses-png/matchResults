			Full_Validation_On_Create4 as "Full Validation On Create"
			{
				type =  form
				form = Asset_Issues

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(isNull(input.Issue_Number) || input.Issue_Number.trim() == "")
										{
											prefix_key = "ZC-ISSUE";
											seq = Work_Order_Sequence[Prefix == prefix_key];
											if(seq.ID == null)
											{
												alert "Sequence not found for prefix " + prefix_key + ". Create it in Work_Order_Sequence.";
												cancel submit;
											}
											next_num = ifnull(seq.Next_Number,1);
											if(next_num > 9999)
											{
												alert "Issue numbers for " + prefix_key + " have reached the limit (9999). Please update the prefix or reset the sequence.";
												cancel submit;
											}
											if(next_num < 10)
											{
												num_str = "000" + next_num;
											}
											else if(next_num < 100)
											{
												num_str = "00" + next_num;
											}
											else if(next_num < 1000)
											{
												num_str = "0" + next_num;
											}
											else
											{
												num_str = "" + next_num;
											}
											new_issue = prefix_key + "-" + num_str;
											dupe = Asset_Issues[Issue_Number == new_issue];
											if(dupe.count() > 0)
											{
												alert "Duplicate detected (" + new_issue + "). Please try again.";
												cancel submit;
											}
											input.Issue_Number = new_issue;
											seq.Next_Number=next_num + 1;
										}
						)
					}
				}

			}
