										}
						)
					}
				}

			}
			Set_Up_Form_On_Edit3 as "Set Up Form On Edit"
			{
				type =  form
				form = Payment_Made_Voucher_Details

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.Old_Amount_Paid = ifnull(input.Amount_Paid,0.0);
										Old_Asset_Management_Bill = input.Asset_Management_Bill;
						)
					}
				}

			}
			Finalize_On_Delete as "Finalize On Delete"
			{
				type =  form
				form = Payment_Made_Voucher_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PAYMENT VOUCHER DETAILS - FINALIZE ON DELETE
										// =====================================================
										// ---------------------------------------------
										// 0) Helpers
										// ---------------------------------------------
										bill_no = ifnull(input.Old_Bill_Number,"").trim();
										if(bill_no == "")
										{
											bill_no = ifnull(input.Bill_Number,"").trim();
										}
										old_alloc_text = ifnull(input.Old_Group_Allocations_Text,"");
										old_pay_date = input.Old_Group_Alloc_Payment_Date;
										pay_date_val = zoho.currentdate;
										if(old_pay_date != null)
										{
											pay_date_val = old_pay_date;
										}
										else if(input.Payment_Voucher_Date != null)
										{
											pay_date_val = input.Payment_Voucher_Date;
										}
										// ---------------------------------------------
										// 1) Reverse old Group_Expenses allocations
										// ---------------------------------------------
										if(old_alloc_text != "" && old_pay_date != null)
										{
											old_rows = old_alloc_text.toList("||");
											for each  old_row in old_rows
											{
												if(old_row != null && old_row.trim() != "")
												{
													parts = old_row.toList("=");
													if(parts.size() == 2)
													{
														old_group_id_text = parts.get(0);
														old_amt_text = parts.get(1);
														if(old_group_id_text != "" && old_amt_text != "")
														{
															old_group_id = old_group_id_text.toLong();
															old_amt = round(old_amt_text.toDecimal(),2);
															if(input.System == "Store Management")
															{
																old_grp_rec = Group_Accounts[Group == old_group_id && Payment_Date == old_pay_date && Source_Group == "Store Purchases"];
															}
															else if(input.System == "Employee Management")
															{
																old_grp_rec = Group_Accounts[Group == old_group_id && Payment_Date == old_pay_date && Source_Group == "Employee Expenses"];
															}
															else
															{
																old_grp_rec = Group_Accounts[Group == old_group_id && Payment_Date == old_pay_date];
															}
															if(old_grp_rec.ID != null)
															{
																new_total = round(ifnull(old_grp_rec.Amount_Actually_Paid,0.0) - old_amt,2);
																if(new_total < 0)
																{
																	new_total = 0.0;
																}
																old_grp_rec.Amount_Actually_Paid=new_total;
															}
														}
													}
												}
											}
										}
										// ---------------------------------------------
										// 2) Recompute remaining total for deleted Bill
										// ---------------------------------------------
										if(bill_no != "")
										{
											recomputed_total = 0.0;
											payment_rows = Payment_Made_Voucher_Details[System == input.System && Bill_Number == bill_no];
											for each  pay_row in payment_rows
											{
												row_amt = round(ifnull(pay_row.Amount_Paid,0.0),2);
												if(row_amt > 0)
												{
													recomputed_total = round(recomputed_total + row_amt,2);
												}
											}
											payload = Map();
											payload.put("Bill_Number",bill_no);
											payload.put("Total_Paid",recomputed_total);
											payload.put("Payment_Date",pay_date_val);
											resp = null;
											if(input.System == "Store Management")
											{
												resp = store_management.updateBillFromPayment(payload);
											}
											else if(input.System == "Asset Management")
											{
												resp = asset_management.updateBillFromPayment(payload);
											}
											else if(input.System == "Employee Management")
											{
												resp = employee_management.updateInvoiceFromReceipt(payload);
											}
											if(resp == null)
											{
												info "Delete bill sync failed: no response";
											}
											else if(resp.get("ok") != true)
											{
												info "Delete bill sync failed: " + ifnull(resp.get("msg"),"error");
											}
											else
											{
												info "Delete bill sync success.";
												if(input.System == "Store Management")
												{
													po_resp = store_management.recheckPurchaseOrdersFromBill(bill_no);
													info po_resp;
												}
											}
										}
										// ---------------------------------------------
										// 3) Recompute parent Payment Voucher totals
										// ---------------------------------------------
										if(input.Payment_Voucher != null)
										{
											pv = Payment_Made_Voucher[ID == input.Payment_Voucher];
											if(pv.ID != null)
											{
												total_assigned = 0.0;
												all_rows = Payment_Made_Voucher_Details[Payment_Voucher == pv.ID];
												for each  r in all_rows
												{
													amt = round(ifnull(r.Amount_Paid,0.0),2);
													if(amt > 0)
													{
														total_assigned = round(total_assigned + amt,2);
													}
												}
												total_paid = round(ifnull(pv.Total_Amount_Paid,0.0),2);
												balance_not_assigned = round(total_paid - total_assigned,2);
												if(balance_not_assigned < 0)
												{
													balance_not_assigned = 0.0;
												}
												pv.Amount_Assigned=total_assigned;
												pv.Balance_Not_Assigned=balance_not_assigned;
												if(total_paid <= 0)
												{
													pv.Payment_Voucher_Status="Draft";
												}
												else if(total_assigned <= 0)
												{
													pv.Payment_Voucher_Status="Unassigned";
												}
												else if(balance_not_assigned > 0)
												{
													pv.Payment_Voucher_Status="Partially Assigned";
												}
												else
												{
													pv.Payment_Voucher_Status="Fully Assigned";
												}
											}
										}
						)
					}
				}

			}
			Set_Up_Form1 as "Set Up Form"
			{
				type =  form
				form = Payment_Made_Voucher_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//DISABLE FIELDS
										disable Payment_Voucher_Date;
										disable Line_Number;
										disable Display_Name_Payment_Voucher;
										disable Bill_Number;
										disable Amount_Due;
										disable Old_Amount_Paid;
										disable Old_Bill_Number;
										disable Old_Group_Allocations_Text;
										disable Old_Group_Alloc_Payment_Date;
										//HIDE FIELDS
										hide Display_Name_Payment_Voucher;
										hide Store_Management_Bill;
										hide Asset_Management_Bill;
										hide Employee_Management_Bill;
										hide Old_Amount_Paid;
										hide Old_Bill_Number;
										hide Old_Group_Allocations_Text;
										hide Old_Group_Alloc_Payment_Date;
										if(input.ID != null)
										{
											if(input.Old_Group_Allocations_Text == null)
											{
												input.Old_Group_Allocations_Text = "";
											}
											if(input.Old_Group_Alloc_Payment_Date == null && input.Payment_Voucher != null)
											{
												input.Old_Group_Alloc_Payment_Date = input.Payment_Voucher.Payment_Voucher_Date;
											}
										}
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
						)
					}
				}

			}
			On_Employee_Management_Bi as "On Employee Management Bill Selected"
			{
				type =  form
				form = Payment_Made_Voucher_Details

				record event = on add or edit

				on user input of Employee_Management_Bill
				{
