
 application "Payment Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Africa/Kampala"
 	time format = "24-hr"

 	forms
	{
		form Account
		{
			success message = "Payment Account Added Successfully"
			Account_Details
			(
				type = section
				displayname = "Account Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Provider
			(
				type = picklist	
				values  = Provider.ID
    			displayformat = [Provider_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account_Type
			(
				type = picklist	
				displayname = "Account Type"
				values  = Account_Types.ID
    			displayformat = [Account_Type_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account_Name
			(
    			type = text
				displayname = "Account Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account_Number
			(
    			type = text
				displayname = "Account Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Opening_Balance_Date_Time
			(
    			type = datetime
				displayname = "Opening Balance Date-Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Opening_Balance_Notes
			(
    			type = textarea
				displayname = "Opening Balance Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Opening_Balance
			(
				displayname = "Opening Balance"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Credit
			(
				displayname = "Total Credit"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Debit
			(
				displayname = "Total Debit"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Balance
			(
				displayname = "Current Balance"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account_Status
			(
				type = picklist
				displayname = "Account Status"
				maxchar = 100
				values = {"Active","Inactive"}
				initial value = "Active"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Allow_Overdraft
			(
    			type = checkbox
				displayname = "Allow Overdraft"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Overdraft_Amount_Allowed
			(
				displayname = "Overdraft Amount Allowed"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Unconfirmed_Totals
			(
				type = section
				displayname = "Unconfirmed Totals"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Unconfirmed_Total_Credit
			(
				displayname = "Unconfirmed Total Credit"
				type = UGX
				format = commadotwestern
	 			row = 2
	 			column = 1   
				width = medium
			)
			Unconfirmed_Total_Debit
			(
				displayname = "Unconfirmed Total Debit"
				type = UGX
				format = commadotwestern
	 			row = 2
	 			column = 1   
				width = medium
			)
			Unconfirmed_Total_Amount
			(
				displayname = "Unconfirmed Total Amount"
				type = UGX
				format = commadotwestern
	 			row = 2
	 			column = 1   
				width = medium
			)
			Available_List
			(
				type = grid
				displayname = "Available List"
				values  = Account_Available_List.ID
    			bidirectional = Account
	 			row = 3
	 			column = 1   
				width = medium
			)
			Transaction_Log
			(
				type = grid
				displayname = "Transaction Log"
				values  = Account_Transaction_Log.ID
    			bidirectional = Account
				sorttype = fieldbased
				sort by
				(
					Transaction_Date ascending
				)
	 			row = 4
	 			column = 1   
				width = medium
			)
			Transactions
			(
				type = grid
				values  = Payment_Voucher2.ID
    			bidirectional = Account
				sorttype = fieldbased
				sort by
				(
					Payment_Date ascending
				)
	 			row = 5
	 			column = 1   
				width = medium
			)
			Account_Users
			(
				type = grid
				displayname = "Account Users"
				values  = Account_User.ID
    			bidirectional = Account
	 			row = 6
	 			column = 1   
				width = medium
			)
			Back_End
			(
				type = section
				displayname = "Back End"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 7
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 7
	 			column = 1   
				width = medium
				personal data = true
			)
			User_Role
			(
    			type = text
				displayname = "User Role"
	 			row = 7
	 			column = 1   
				width = medium
			)
			Created_By_Name
			(
    			type = text
				displayname = "Created By Name"
	 			row = 7
	 			column = 1   
				width = medium
			)
			Created_By_Email
			(
    			type = email
				displayname = "Created By Email"
				maxchar = 80
	 			row = 7
	 			column = 1   
				width = medium
				personal data = true
			)
			Created_By_Time
			(
    			type = datetime
				displayname = "Created By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 7
	 			column = 1   
				width = medium
			)
			Updated_By_Name
			(
    			type = text
				displayname = "Updated By Name"
	 			row = 7
	 			column = 1   
				width = medium
			)
			Updated_By_Email
			(
    			type = email
				displayname = "Updated By Email"
				maxchar = 80
	 			row = 7
	 			column = 1   
				width = medium
				personal data = true
			)
			Updated_By_Time
			(
    			type = datetime
				displayname = "Updated By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 7
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Account_Available_List
		{
			displayname = "Account Available List"
			success message = "Data Added Successfully!"
			Account_Available_List_Details
			(
				type = section
				displayname = "Account Available List Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			List_field
			(
				type = picklist	
				displayname = "List"
				values  = Lists.ID
    			displayformat = [List_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account
			(
				type = picklist	
				values  = Account.ID
    			bidirectional = Available_List
    			displayformat = [Account_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_List
			(
    			type = text
				displayname = "Display Name List"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Account
			(
    			type = text
				displayname = "Display Name Account"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status_Details
			(
				type = section
				displayname = "Status Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Active","Inactive"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Back_End
			(
				type = section
				displayname = "Back End"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 3
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			User_Role
			(
    			type = text
				displayname = "User Role"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Created_By_Name
			(
    			type = text
				displayname = "Created By Name"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Created_By_Email
			(
    			type = email
				displayname = "Created By Email"
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Created_By_Time
			(
    			type = datetime
				displayname = "Created By Email"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Updated_By_Name
			(
    			type = text
				displayname = "Updated By Name"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Updated_By_Email
			(
    			type = email
				displayname = "Updated By Email"
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Updated_By_Time
			(
    			type = datetime
				displayname = "Updated By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Account_Debits
		{
			displayname = "Account Debits"
			success message = "Account Credit Added Successfully"
			Account_Debits_Details
			(
				type = section
				displayname = "Account Debits Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Payment_Date
			(
    			type = date
				displayname = "Payment Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account
			(
				type = picklist	
				values  = Account.ID
    			displayformat = [Account_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Account_Name
			(
    			type = text
				displayname = "Display Account Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Amount_Paid
			(
				displayname = "Amount Paid"
				type = UGX
				format = commadotwestern
				maxchar = 8
	 			row = 1
	 			column = 1   
				width = medium
			)
			Applied_Amount
			(
				displayname = "Applied Amount"
				type = UGX
				format = commadotwestern
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Balance
			(
    			type = formula
				value =  input.Amount_Paid - input.Applied_Amount
				visibility = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reference
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Payment_Type
			(
				type = picklist
				displayname = "Payment Type"
				maxchar = 100
				values = {"Materials & Supplies","Maintenance","Repairs","Construction"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status_Details
			(
				type = section
				displayname = "Status Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Unapplied","Fully Applied","Partially Applied"}
				initial value = "Unapplied"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Back_End
			(
				type = section
				displayname = "Back End"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 3
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			User_Role
			(
    			type = text
				displayname = "User Role"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Created_By_Name
			(
    			type = text
				displayname = "Created By Name"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Created_By_Email
			(
    			type = email
				displayname = "Created By Email"
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Created_By_Time
			(
    			type = datetime
				displayname = "Created By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Updated_By_Name
			(
    			type = text
				displayname = "Created By Time"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Updated_By_Email
			(
    			type = email
				displayname = "Updated By Email"
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Updated_By_Time
			(
    			type = datetime
				displayname = "Updated By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Account_Transaction_Log
		{
			displayname = "Account Transaction Log"
			success message = "Data Added Successfully!"
			Account_Details
			(
				type = section
				displayname = "Account Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Transaction_Date
			(
    			type = datetime
				displayname = "Transaction Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account
			(
				type = picklist	
				values  = Account.ID
    			bidirectional = Transaction_Log
    			displayformat = [Account_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Account
			(
    			type = text
				displayname = "Display Name Account"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Transaction_Type
			(
				type = picklist
				displayname = "Transaction Type"
				maxchar = 100
				values = {"Debit","Credit"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reference_Type
			(
				type = picklist
				displayname = "Reference Type"
				maxchar = 100
				values = {"Payment Receipt Voucher","Payment Made Voucher","Transfer Funds","Opening Balance","Charges"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reference_Number
			(
    			type = text
				displayname = "Reference Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account_Totals
			(
				type = section
				displayname = "Account Totals"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Amount
			(
				type = UGX
				format = commadotwestern
	 			row = 2
	 			column = 1   
				width = medium
			)
			Balance_Before
			(
				displayname = "Balance Before"
				type = UGX
				format = commadotwestern
	 			row = 2
	 			column = 1   
				width = medium
			)
			Balance_After
			(
				displayname = "Balance After"
				type = UGX
				format = commadotwestern
	 			row = 2
	 			column = 1   
				width = medium
			)
			Integration_Details
			(
				type = section
				displayname = "Integration Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Application
			(
    			type = text
	 			row = 3
	 			column = 1   
				width = medium
			)
			Source_Form
			(
    			type = text
				displayname = "Source Form"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Source_Record_ID
			(
				type = number
				displayname = "Source Record ID"
				maxchar = 19
	 			row = 3
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Back_End
			(
				type = section
				displayname = "Back End "
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 4
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 4
	 			column = 1   
				width = medium
				personal data = true
			)
			User_Role
			(
    			type = text
				displayname = "User Role"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Created_By_Name
			(
    			type = text
				displayname = "Created By Name"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Created_By_Email
			(
    			type = email
				displayname = "Created By Email"
				maxchar = 80
	 			row = 4
	 			column = 1   
				width = medium
				personal data = true
			)
			Created_By_Time
			(
    			type = datetime
				displayname = "Created By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Updated_By_Name
			(
    			type = text
				displayname = "Updated By Name"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Updated_By_Time
			(
