		form Bill_Details
		{
			displayname = "Bill Details"
			success message = "Data Added Successfully!"
			Bill_Details
			(
				type = section
				displayname = "Bill Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Stock_Receiving_Details
			(
				type = picklist	
				displayname = "Stock Receiving Details"
				values  = Stock_Receiving_Details.ID
    			displayformat = [Stock_Receiving_Voucher_and_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Bill
			(
				type = picklist	
				values  = Bill[Payment_Status != "Paid"].ID
    			bidirectional = Bill_Details
    			displayformat = [Bill_Name + " - " + Bill_Number]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Bill
			(
    			type = text
				displayname = "Display Name Bill"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Details_Date
			(
    			type = date
				displayname = "Details Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Line_Number
			(
				type = number
				displayname = "Line Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reference
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Parts_Consumables
			(
				type = picklist	
				displayname = "Parts & Consumables"
				values  = Parts_Consumables.ID
    			bidirectional = bi
    			displayformat = [Display_Name_Item_Labour + " - " + Display_Name_Work_Order_Task_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Item
			(
				type = picklist	
				values  = Purchase_Order_Details.ID
    			displayformat = [Display_Name_Item + " - " + Quantity_Billable]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Item
			(
    			type = text
				displayname = "Display Name Item"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expense_Type
			(
				type = picklist
				displayname = "Expense Type"
