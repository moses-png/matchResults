											enable Document_Type;
											show Voucher_Type;
											enable Voucher_Type;
											enable Physical_Voucher_Type;
											enable Digital_Voucher_Type;
											show Voucher_Number;
											enable Voucher_Number;
											show Employee;
											show Date_Time_In;
											enable Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											enable Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											if(input.Voucher_Type == "Stock Receiving Note" || input.Voucher_Type == "Stock Bundling Note")
											{
												hide Employee_Issuing_Details;
												show Voucher_Header;
												show Asset;
												show Item;
												show Quantity_To_Be_Created;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												disable Asset;
												disable Item;
												disable Quantity_To_Be_Created;
												show Notes;
												show Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
												}
											}
											show Manager_Section;
											show Cancel_Voucher;
											enable Cancel_Voucher;
										}
										// =====================================================
										// ON EDIT + Status = AUDITED
										// =====================================================
										else if(!is_create && st == "Audited")
										{
											if(input.Voucher_Type == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											enable Voucher_Status;
											if(input.Voucher_Type == "Stock Receiving Note" || input.Voucher_Type == "Stock Bundling Note")
											{
												hide Employee_Issuing_Details;
												show Voucher_Header;
												show Asset;
												show Item;
												show Quantity_To_Be_Created;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												disable Asset;
												disable Item;
												disable Quantity_To_Be_Created;
												show Notes;
												show Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
												}
											}
											show Voucher_Cost;
											show End_Time;
											show Odometer_End;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											if(input.Cancel_Voucher == true)
											{
												show Cancellation_Reason;
											}
											else
											{
												hide Cancellation_Reason;
											}
											show Head_Office;
											show Seen;
											if(input.Seen == true)
											{
												hide Reason_for_not_Seen;
											}
											else
											{
												show Reason_for_not_Seen;
											}
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
											show Back_End;
											show User_Name;
											show User_Email;
											show User_Role;
											show Created_By_Name;
											show Created_By_Email;
											show Created_By_Time;
											show Updated_By_Name;
											show Updated_By_Email;
											show Updated_By_Time;
										}
										// =====================================================
										// ON EDIT + Status = CLEARED
										// =====================================================
										else if(!is_create && st == "Cleared")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Shift_Voucher_Summary;
											show Opening_Vouchers;
											show Vouchers_Issued;
											show Vouchers_Returned;
											show Outstanding_Vouchers;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											show Head_Office;
											show Seen;
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
											show Back_End;
										}
										// =====================================
										// FINAL NOTES CONTROL
										// Only Stock Receiving Note / Stock Bundling Note
										// =====================================
										if(input.Voucher_Type == "Stock Receiving Note" || input.Voucher_Type == "Stock Bundling Note")
										{
											show Notes;
											show Not_Created;
											if(input.Not_Created == true)
											{
												show Reason_Why_Not_Created;
												enable Reason_Why_Not_Created;
											}
											else
											{
												hide Reason_Why_Not_Created;
												disable Reason_Why_Not_Created;
											}
										}
										else
										{
											hide Notes;
											hide Not_Created;
											hide Reason_Why_Not_Created;
											disable Reason_Why_Not_Created;
										}
										// =====================================
										// FORCE SHOW EXISTING IMPORTED DETAILS
										// =====================================
										if(input.Employee_Issuing_Details.count() > 0)
										{
											show Employee_Issuing_Details;
										}
										if(input.Item_Issuing_Details.count() > 0)
										{
											show Item_Issuing_Details;
										}
										if(input.Stock_Receiving_Details.count() > 0)
										{
											show Stock_Receiving_Details;
										}
										if(input.Fuel_Receiving_Details.count() > 0)
										{
											show Fuel_Receiving_Details;
										}
						)
					}
				}

			}
			On_Not_Created_Selected as "On Not Created Selected"
			{
				type =  form
				form = Voucher

				record event = on edit

				on user input of Not_Created
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// USER INPUT OF NOT CREATED
										// Show reason only when Not Created is ticked
										// =====================================
										if(input.Not_Created == true)
										{
											show Reason_Why_Not_Created;
											enable Reason_Why_Not_Created;
										}
										else
										{
											input.Reason_Why_Not_Created = "";
											hide Reason_Why_Not_Created;
											disable Reason_Why_Not_Created;
										}
						)
					}
				}

			}
