			Full_Validation18 as "Full Validation"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// TRUCK MOVEMENT VOUCHER
										// FULL VALIDATION - CREATE OR EDIT
										// =====================================================
										errors = "";
										jobNo = "";
										is_cancelled = input.Cancel_Voucher == true;
										delivery_started = false;
										if(input.Job != null)
										{
											jobNo = ifnull(input.Job.Job_No,"").trim();
										}
										if(input.Truck_Movement_Voucher_Status == "Delivered" || input.Time_End != null || input.Odometer_End != null)
										{
											delivery_started = true;
										}
										// =====================================================
										// 1. JOB VALIDATION
										// =====================================================
										if(input.Job == null)
										{
											errors = errors + "\n• Job is required.";
										}
										else
										{
											// =================================================
											// TJS01 - CARD SALES
											// =================================================
											if(jobNo == "TJS01")
											{
												if(input.Card_Source == null || input.Card_Source.trim() == "")
												{
													errors = errors + "\n• Card Source is required for Card Sales.";
												}
												else if(input.Card_Source == "Masaka Sites")
												{
													if(input.Card_Masaka == null)
													{
														errors = errors + "\n• Masaka Sales Card is required.";
													}
												}
												else if(input.Card_Source == "Clean Sand")
												{
													if(input.Card_Clean_Sand == null)
													{
														errors = errors + "\n• Clean Sand Sales Card is required.";
													}
												}
											}
											// =================================================
											// TJS02 - SERVICE TASK
											// =================================================
											else if(jobNo == "TJS02")
											{
												if(input.Work_Order_Task_Source == null || input.Work_Order_Task_Source.trim() == "")
												{
													errors = errors + "\n• Work Order Task Source is required.";
												}
												else if(input.Work_Order_Task_Source == "Masaka Sites")
												{
													if(input.Work_Order_Task_Masaka == null)
													{
														errors = errors + "\n• Masaka Work Order Task is required.";
													}
												}
												else if(input.Work_Order_Task_Source == "Freedom City")
												{
													if(input.Work_Order_Task_Freedom_City == null)
													{
														errors = errors + "\n• Freedom City Work Order Task is required.";
													}
												}
												else if(input.Work_Order_Task_Source == "Concrete Products")
												{
													if(input.Work_Order_Task_Concrete_Products == null)
													{
														errors = errors + "\n• Concrete Products Work Order Task is required.";
													}
												}
												else if(input.Work_Order_Task_Source == "Clean Sand")
												{
													if(input.Work_Order_Task_Clean_Sand == null)
													{
														errors = errors + "\n• Clean Sand Work Order Task is required.";
													}
												}
												else
												{
													errors = errors + "\n• Select a valid Work Order Task Source.";
												}
												if(input.Task_Location == null || input.Task_Location.trim() == "")
												{
													errors = errors + "\n• Task Location is required for Service Task.";
												}
												if(input.Small_Notes == null || input.Small_Notes.trim() == "")
												{
													errors = errors + "\n• Small Notes are required for Service Task.";
												}
											}
											// =================================================
											// TJS03 - STOCK PRODUCTION
											// =================================================
											else if(jobNo == "TJS03")
											{
												if(input.Batch_Number_Masaka == null)
												{
													errors = errors + "\n• Stock Production Batch Number is required.";
												}
											}
											// =================================================
											// TJS04 - RETURN TRUCK TO SITE
											// =================================================
											else if(jobNo == "TJS04")
											{
												if(input.Truck_Movement_Voucher == null)
												{
													errors = errors + "\n• Original Truck Movement Voucher is required.";
												}
												if(input.Small_Notes == null || input.Small_Notes.trim() == "")
												{
													errors = errors + "\n• Small Notes are required for Return Truck To Site.";
												}
											}
										}
										// =====================================================
										// 2. PICKUP VALIDATION
										// =====================================================
										if(input.Job != null)
										{
											if(jobNo == "TJS04")
											{
												if(input.Party_From == null)
												{
													errors = errors + "\n• Party From is required.";
												}
												if(input.Party_Location_From == null)
												{
													errors = errors + "\n• Party Location From is required.";
												}
											}
											else if(jobNo == "TJS02")
											{
												if(input.Task_Location == "Suppliers")
												{
													if(input.Party_From == null)
													{
														errors = errors + "\n• Party From is required.";
													}
													if(input.Party_Location_From == null)
													{
														errors = errors + "\n• Party Location From is required.";
													}
												}
												else if(input.Task_Location == "Company Sites")
												{
													if(input.Site_From == null)
													{
														errors = errors + "\n• Site From is required.";
													}
													if(input.Site_Location_From == null)
													{
														errors = errors + "\n• Site Location From is required.";
													}
												}
											}
											else if(jobNo == "TJS01" || jobNo == "TJS03")
											{
												if(input.Site_From == null)
												{
													errors = errors + "\n• Site From is required.";
												}
												if(input.Site_Location_From == null)
												{
													errors = errors + "\n• Site Location From is required.";
												}
											}
										}
										// =====================================================
										// 3. STARTING DETAILS
										// =====================================================
										if(input.Odometer_Start == null)
										{
											errors = errors + "\n• Odometer Start is required.";
										}
										if(isNull(input.Pick_Up_Image))
										{
											errors = errors + "\n• Pick Up Image is required.";
										}
										// =====================================================
										// 4. CANCELLATION VALIDATION
										// =====================================================
										if(is_cancelled)
										{
											if(input.Reason_Why_Cancelled == null || input.Reason_Why_Cancelled.trim() == "")
											{
												errors = errors + "\n• Reason Why Cancelled is required.";
											}
										}
										// =====================================================
										// 5. DELIVERY VALIDATION
										// =====================================================
										if(delivery_started && !is_cancelled)
										{
											if(jobNo == "TJS01")
											{
												if(input.Delivery_Location == null || input.Delivery_Location.trim() == "")
												{
													errors = errors + "\n• Delivery Location is required.";
												}
												else if(input.Delivery_Location == "Company Sites")
												{
													if(input.Site_To == null)
													{
														errors = errors + "\n• Site To is required.";
													}
													if(input.Site_Location_To == null)
													{
														errors = errors + "\n• Site Location To is required.";
													}
												}
												else if(input.Delivery_Location == "Suppliers")
												{
													if(input.Party_To == null)
													{
														errors = errors + "\n• Party To is required.";
													}
													if(input.Party_Location_To == null)
													{
														errors = errors + "\n• Party Location To is required.";
													}
												}
											}
											else if(jobNo == "TJS02" || jobNo == "TJS03" || jobNo == "TJS04")
											{
												if(input.Site_To == null)
												{
													errors = errors + "\n• Site To is required.";
												}
												if(input.Site_Location_To == null)
												{
													errors = errors + "\n• Site Location To is required.";
												}
											}
											else
											{
												if(input.Site_To == null && input.Party_To == null)
												{
													errors = errors + "\n• Delivery destination is required.";
												}
												if(input.Site_To != null && input.Site_Location_To == null)
												{
													errors = errors + "\n• Site Location To is required.";
												}
												if(input.Party_To != null && input.Party_Location_To == null)
												{
													errors = errors + "\n• Party Location To is required.";
												}
											}
											if(input.Odometer_End == null)
											{
												errors = errors + "\n• Odometer End is required.";
											}
											if(isNull(input.Delivery_To_Image))
											{
												errors = errors + "\n• Delivery To Image is required.";
											}
											if(input.Time_End == null)
											{
												errors = errors + "\n• Time End is required.";
											}
											if(input.Odometer_Start != null && input.Odometer_End != null)
											{
												if(input.Odometer_End < input.Odometer_Start)
												{
													errors = errors + "\n• Odometer End cannot be less than Odometer Start.";
												}
											}
											if(input.Time_Start != null && input.Time_End != null)
											{
												if(input.Time_End < input.Time_Start)
												{
													errors = errors + "\n• Time End cannot be before Time Start.";
												}
											}
										}
										// =====================================================
										// 6. STOP SUBMISSION
										// =====================================================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			On_Work_Order_Task_Select1 as "On Work Order Task Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Work_Order_Task_Masaka
				{
					actions 
					{
						custom deluge script
						(
											if(input.Work_Order_Task_Masaka != null)
										{
											taskNo = ifnull(input.Work_Order_Task_Masaka.Work_Order_Task_Number,"").trim();
											taskDesc = ifnull(input.Work_Order_Task_Masaka.Task_Description,"").trim();
											if(taskNo != "" && taskDesc != "")
											{
												input.Work_Done = taskNo + " - " + taskDesc;
											}
											else if(taskDesc != "")
											{
												input.Work_Done = taskDesc;
											}
											else if(taskNo != "")
											{
												input.Work_Done = taskNo;
											}
											else
											{
												input.Work_Done = null;
											}
										}
										else
										{
											input.Work_Done = null;
										}
						)
					}
				}

			}
		}

		schedule
		{
			Create_Asset_Issue_from_R as "Create Asset Issue from Routine Issues"
			{
				type =  schedule
				start = "2026-04-29 01:00:09"
				frequency = daily
				time zone = "Africa/Kampala"
				on start
				{
					actions 
					{
					on load
					(
						// ======================================
										// SCHEDULE: CREATE ASSET ISSUES FROM ROUTINE ISSUES
										// ======================================
										today_date = zoho.currentdate;
										routine_list = Routine_Issues[Status == "Active"];
										for each  r in routine_list
										{
											if(r.Open_Issue_ID != null)
											{
												continue;
											}
											if(r.Asset == null)
											{
												continue;
											}
											asset_rec = Asset_List[ID == r.Asset.ID];
											if(asset_rec.ID == null)
											{
												continue;
											}
											current_odo = ifnull(asset_rec.Odometer_Reading,0.0);
											create_issue = false;
											if(r.Next_Done_Odometer != null && r.Next_Done_Odometer > 0)
											{
												if(current_odo >= r.Next_Done_Odometer)
												{
													create_issue = true;
												}
											}
											if(r.Next_Done_Date != null)
											{
												if(r.Next_Done_Date <= today_date)
												{
													create_issue = true;
												}
											}
											if(create_issue == false)
											{
												continue;
											}
											prefix_key = "RTN-ISSUE";
											seq = Work_Order_Sequence[Prefix == prefix_key];
											if(seq.ID == null)
											{
												info "Sequence missing: " + prefix_key;
												continue;
											}
											next_num = ifnull(seq.Next_Number,1);
											if(next_num < 10)
											{
												num_str = "000" + next_num;
											}
											else if(next_num < 100)
											{
												num_str = "00" + next_num;
											}
											else if(next_num < 1000)
											{
												num_str = "0" + next_num;
											}
											else
											{
												num_str = next_num.toString();
											}
											issue_no = prefix_key + "-" + num_str;
											dupe = Asset_Issues[Issue_Number == issue_no];
											if(dupe.count() > 0)
											{
												info "Duplicate issue number: " + issue_no;
												continue;
											}
											issue_title = ifnull(r.Display_Name_Labour,"Routine Maintenance") + " Due";
											issue_desc = "Auto-created from Routine Issue.\nAsset: " + ifnull(r.Display_Name_Asset,"") + "\nRoutine: " + ifnull(r.Display_Name_Labour,"") + "\nCurrent Odometer: " + current_odo + "\nNext Done Odometer: " + ifnull(r.Next_Done_Odometer,0) + "\nNext Done Date: " + ifnull(r.Next_Done_Date,"");
											new_issue_id = insert into Asset_Issues
											[
												Issue_Number=issue_no
												Asset=r.Asset
												Display_Name_Asset=ifnull(asset_rec.Display_Name_Asset_Name,"")
												Current_Site=ifnull(asset_rec.Current_Site,"")
												Current_Custodian=ifnull(asset_rec.Current_Custodian,"")
												Odometer_Reading=current_odo
												Reported_Date=zoho.currenttime
												Issue=issue_title
												Issue_Description=issue_desc
												Severity="Medium"
												Status="Open"
												Added_User=zoho.loginuser
											];
											site_name = ifnull(asset_rec.Current_Site,"").trim();
											site_name_lower = site_name.toLowerCase();
											sync_done = false;
											info "Routine schedule site_name: [" + site_name + "]";
											// -------------------------------
											// Concrete Products Sync
											// -------------------------------
											if(site_name_lower.contains("kabuusu") || site_name_lower.contains("concrete products"))
											{
												sync_payload = Map();
												sync_payload.put("Source_Record_ID",new_issue_id);
												sync_payload.put("Source_Form","Asset Management Asset Issues");
												sync_payload.put("Issue_Number",issue_no);
												sync_payload.put("Asset",r.Asset);
												sync_payload.put("Display_Name_Asset",ifnull(asset_rec.Display_Name_Asset_Name,""));
												sync_payload.put("Current_Site",ifnull(asset_rec.Current_Site,""));
												sync_payload.put("Current_Custodian",ifnull(asset_rec.Current_Custodian,""));
												sync_payload.put("Odometer_Reading",current_odo);
												sync_payload.put("Reported_Date",zoho.currenttime);
												sync_payload.put("Issue",issue_title);
												sync_payload.put("Issue_Description",issue_desc);
												sync_payload.put("Severity","Medium");
												sync_payload.put("Status","Open");
												concrete_products_management.create_asset_issue_from_asset_management_payload(sync_payload);
												sync_done = true;
												info "Called Concrete Products sync for: " + issue_no;
											}
											// -------------------------------
											// Masaka Site Management Sync
											// -------------------------------
											if(site_name_lower.contains("china site - ara073") || site_name_lower.contains("gomba site - ara075") || site_name_lower.contains("kankobe site - ara071") || site_name_lower.contains("kakoni site - ara070"))
											{
												masaka_payload = Map();
												masaka_payload.put("Source_Record_ID",new_issue_id);
												masaka_payload.put("Source_Form","Asset Management Asset Issues");
												masaka_payload.put("Issue_Number",issue_no);
												masaka_payload.put("Asset",r.Asset);
												masaka_payload.put("Display_Name_Asset",ifnull(asset_rec.Display_Name_Asset_Name,""));
												masaka_payload.put("Current_Site",ifnull(asset_rec.Current_Site,""));
												masaka_payload.put("Current_Custodian",ifnull(asset_rec.Current_Custodian,""));
												masaka_payload.put("Odometer_Reading",current_odo);
												masaka_payload.put("Reported_Date",zoho.currenttime);
												masaka_payload.put("Issue",issue_title);
												masaka_payload.put("Issue_Description",issue_desc);
												masaka_payload.put("Severity","Medium");
												masaka_payload.put("Status","Open");
												masaka_site_management.create_asset_issue_from_asset_management_payload(masaka_payload);
												sync_done = true;
												info "Called Masaka Site Management sync for: " + issue_no;
											}
											// -------------------------------
											// Freedom City Management Sync
											// -------------------------------
											if(site_name_lower.contains("freedom city mall - ara338"))
											{
												freedom_payload = Map();
												freedom_payload.put("Source_Record_ID",new_issue_id);
												freedom_payload.put("Source_Form","Asset Management Asset Issues");
												freedom_payload.put("Issue_Number",issue_no);
												freedom_payload.put("Asset",r.Asset);
												freedom_payload.put("Display_Name_Asset",ifnull(asset_rec.Display_Name_Asset_Name,""));
												freedom_payload.put("Current_Site",ifnull(asset_rec.Current_Site,""));
												freedom_payload.put("Current_Custodian",ifnull(asset_rec.Current_Custodian,""));
												freedom_payload.put("Odometer_Reading",current_odo);
												freedom_payload.put("Reported_Date",zoho.currenttime);
												freedom_payload.put("Issue",issue_title);
												freedom_payload.put("Issue_Description",issue_desc);
												freedom_payload.put("Severity","Medium");
												freedom_payload.put("Status","Open");
												freedom_city_management.create_asset_issue_from_asset_management_payload(freedom_payload);
												sync_done = true;
												info "Called Freedom City Management sync for: " + issue_no;
											}
											// -------------------------------
											// Kicks Klean Ug Sync
											// -------------------------------
											if(site_name_lower.contains("kicks klean ug") || site_name_lower.contains("kicks klean") || site_name_lower.contains("fa025"))
											{
												kicks_payload = Map();
												kicks_payload.put("Source_Record_ID",new_issue_id);
												kicks_payload.put("Source_Form","Asset Management Asset Issues");
												kicks_payload.put("Issue_Number",issue_no);
												kicks_payload.put("Asset",r.Asset);
												kicks_payload.put("Display_Name_Asset",ifnull(asset_rec.Display_Name_Asset_Name,""));
												kicks_payload.put("Current_Site",ifnull(asset_rec.Current_Site,""));
												kicks_payload.put("Current_Custodian",ifnull(asset_rec.Current_Custodian,""));
												kicks_payload.put("Odometer_Reading",current_odo);
												kicks_payload.put("Reported_Date",zoho.currenttime);
												kicks_payload.put("Issue",issue_title);
												kicks_payload.put("Issue_Description",issue_desc);
												kicks_payload.put("Severity","Medium");
												kicks_payload.put("Status","Open");
												kicks_klean_ug.create_asset_issue_from_asset_management_payload(kicks_payload);
												sync_done = true;
												info "Called Kicks Klean Ug sync for: " + issue_no;
											}
											if(sync_done == false)
											{
												info "External site sync skipped. Site did not match: [" + site_name + "]";
											}
											r.Open_Issue_ID=new_issue_id;
											r.Last_Issue_Date=zoho.currenttime;
											seq.Next_Number=next_num + 1;
											info "Created routine issue: " + issue_no;
										}
					)
					}
				}
			}
			Create_Mileage_Log_ as "Create Mileage Log "
			{
				type =  schedule
				start = "2026-04-30 01:00:00"
				frequency = daily
				time zone = "Africa/Kampala"
				on start
				{
					actions 
					{
					on load
					(
						// Daily Schedule Function
										// Runs once per day
										u = thisapp.audit.getLoginAuditInfo();
										user_name_val = u.get("name");
										user_email_val = u.get("email");
										user_role_val = u.get("role");
										assets = Asset_List[Odometer_Unit_Of_Measure == "days"];
										for each  asset_rec in assets
										{
											if(asset_rec.Date_Time_Odometer_Read != null)
											{
												start_date = asset_rec.Date_Time_Odometer_Read.toDate();
												today_date = zoho.currentdate;
												if(today_date >= start_date)
												{
													today_start = today_date.toDateTime();
													today_end = today_start.addDay(1);
													existing_today = Asset_Mileage_Log[Asset == asset_rec.ID && Date_Time_Recorded >= today_start && Date_Time_Recorded < today_end && Odometer_Source_Form == "Daily Schedule"];
													if(existing_today.count() == 0)
													{
														prev_reading = ifnull(asset_rec.Odometer_Reading,0.0);
														new_reading = prev_reading + 1;
														insert into Asset_Mileage_Log
														[
															Asset=asset_rec.ID
															Date_Time_Recorded=zoho.currenttime
															Odometer_Reading=new_reading
															Previous_Odometer=prev_reading
															Distance_Since_Last=1
															Unit_of_Measure=asset_rec.Odometer_Unit_Of_Measure
															Odometer_Source_Form="Daily Schedule"
															Source_Record_ID=asset_rec.ID.toString()
															Reference=asset_rec.Display_Name_Asset_Name
															Notes="Auto daily usage from purchase/start date"
															User_Name=user_name_val
															User_Email=user_email_val
															User_Role=user_role_val
															Created_By_Name=user_name_val
															Created_By_Email=user_email_val
															Created_By_Time=zoho.currenttime
															Added_User=zoho.loginuser
														]
														asset_rec.Odometer_Reading=new_reading;
													}
												}
											}
										}
					)
					}
				}
			}
		}




	}
