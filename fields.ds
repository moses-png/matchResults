			Full_Validation15 as "Full Validation"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Item Issuing Details - Full Validation
										// =======================================
										errors = List();
										hdr = null;
										old_rec = null;
										req_type = "";
										stock_cond = "";
										qty_val = 0.0;
										new_base_qty = null;
										old_base_qty = 0.0;
										extra_needed = 0.0;
										store_stock = 0.0;
										is_tool = false;
										current_status = ifnull(input.Status,"").trim();
										saved_status = "";
										if(input.ID != null)
										{
											old_rec = Item_Issuing_Details[ID == input.ID];
											if(old_rec.ID != null)
											{
												saved_status = ifnull(old_rec.Status,"").trim();
											}
										}
										// 1) ISSUING VOUCHER
										if(input.Issuing_Voucher == null)
										{
											errors.add("• Please select the Issuing Voucher.");
										}
										else
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID == null)
											{
												errors.add("• Selected Issuing Voucher was not found.");
											}
											else if(hdr.Store == null)
											{
												errors.add("• The selected Issuing Voucher has no Store.");
											}
										}
										// 2) LINE NUMBER
										if(input.Line_Number == null || input.Line_Number <= 0)
										{
											errors.add("• Line Number is required.");
										}
										// 3) DUPLICATE LINE NUMBER
										if(input.Issuing_Voucher != null && input.Line_Number != null && input.Line_Number > 0)
										{
											dup = Item_Issuing_Details[Issuing_Voucher == input.Issuing_Voucher && Line_Number == input.Line_Number && ID != input.ID];
											if(dup.count() > 0)
											{
												errors.add("• Line Number " + input.Line_Number + " is already used.");
											}
										}
										// 4) REQUEST VOUCHER TYPE
										req_type = ifnull(input.Request_Voucher_Type,"").trim();
										if(req_type == "")
										{
											errors.add("• Please select Request Voucher Type.");
										}
										// 5) SOURCE VALIDATION
										if(req_type == "Employee Voucher" && input.Employee_Voucher == null)
										{
											errors.add("• Please select Employee Voucher.");
										}
										else if(req_type == "Work Order Task" && input.Work_Order_Task == null)
										{
											errors.add("• Please select Work Order Task.");
										}
										if(req_type == "Sales Voucher" || req_type == "Sand Sales" || req_type == "Stock Sales")
										{
											if(input.Sales_Voucher == null)
											{
												alert "Sales Voucher is required.";
												cancel submit;
											}
											if(input.Item_Taken == null)
											{
												alert "Item Taken is required.";
												cancel submit;
											}
											if(input.Items_Image == null)
											{
												alert "Items Image is required.";
												cancel submit;
											}
											if(input.Item == null)
											{
												alert "Item could not be resolved from Item Taken.";
												cancel submit;
											}
											if(input.Stock_Condition == null || input.Stock_Condition.trim() == "")
											{
												alert "Stock Condition is required.";
												cancel submit;
											}
											if(input.Unit_Of_Measure == null)
											{
												alert "Unit Of Measure is required.";
												cancel submit;
											}
											if(input.Cost == null || input.Cost < 0)
											{
												alert "Cost is required.";
												cancel submit;
											}
											if(input.Store_Available_Stock == null)
											{
												alert "Store Available Stock is missing.";
												cancel submit;
											}
											if(input.Global_Available_Stock == null)
											{
												alert "Global Available Stock is missing.";
												cancel submit;
											}
										}
										// 6) ITEM
										if(input.Item == null)
										{
											errors.add("• Please select the Item.");
										}
										// 7) STOCK CONDITION DEFAULT
										stock_cond = ifnull(input.Stock_Condition,"").trim();
										if(stock_cond == "")
										{
											input.Stock_Condition = "New";
											stock_cond = "New";
										}
										// 8) UNIT OF MEASURE
										if(input.Unit_Of_Measure == null)
										{
											errors.add("• Please select Unit Of Measure.");
										}
										// 9) QUANTITY
										if(input.Quantity == null)
										{
											errors.add("• Quantity must be greater than zero.");
										}
										else
										{
											qty_val = input.Quantity.toDecimal();
											if(qty_val <= 0)
											{
												errors.add("• Quantity must be greater than zero.");
											}
										}
										// 10) TAKEN BY
										if(input.Taken_By == null)
										{
											errors.add("• Please select who took the item.");
										}
										// 11) UOM CONVERSION + BASE QTY
										if(input.Item != null && input.Unit_Of_Measure != null && input.Quantity != null && qty_val > 0)
										{
											check = store_management.po.check_uom_conversion_from_masaka_site_management(input.Item,input.Unit_Of_Measure);
											if(check == null || check.get("ok") != true)
											{
												errors.add("• " + ifnull(check.get("message"),"UOM conversion failed."));
											}
											else
											{
												tmp_base_qty = store_management.po.convert_to_base_qty_from_masaka_site_management(input.Item,input.Unit_Of_Measure,input.Quantity);
												if(tmp_base_qty == null)
												{
													errors.add("• Calculated base quantity is invalid.");
												}
												else
												{
													new_base_qty = tmp_base_qty.toDecimal();
													if(new_base_qty <= 0)
													{
														errors.add("• Calculated base quantity is invalid.");
													}
													else
													{
														input.Quantity_in_Base_Unit_Of_Measure = new_base_qty;
													}
												}
											}
										}
										// 12) STOCK VALIDATION
										should_validate_stock = false;
										if(req_type == "Employee Voucher")
										{
											if(input.ID == null)
											{
												should_validate_stock = true;
											}
											else if(current_status == "Approved" || current_status == "Issued" || current_status == "Borrowed")
											{
												should_validate_stock = true;
											}
										}
										else
										{
											if(input.ID != null && saved_status == "Approved" && current_status == "Approved")
											{
												should_validate_stock = true;
											}
										}
										if(should_validate_stock == true)
										{
											if(hdr != null && hdr.ID != null && hdr.Store != null && input.Item != null && new_base_qty != null && new_base_qty > 0)
											{
												stock_map = store_management.po.get_item_store_cost_from_masaka_site_management(input.Item,hdr.Store,stock_cond);
												store_stock = ifnull(stock_map.get("store_stock"),0.0).toDecimal();
												input.Store_Available_Stock = store_stock;
												input.Global_Available_Stock = ifnull(stock_map.get("global_stock"),0.0);
												old_base_qty = 0.0;
												if(input.ID != null && old_rec != null && old_rec.ID != null)
												{
													old_base_qty = ifnull(old_rec.Quantity_in_Base_Unit_Of_Measure,0.0).toDecimal();
												}
												if(req_type != "Employee Voucher" && saved_status == "Approved")
												{
													old_base_qty = 0.0;
												}
												extra_needed = new_base_qty - old_base_qty;
												if(extra_needed < 0)
												{
													extra_needed = 0.0;
												}
												if(extra_needed > 0)
												{
													if(store_stock <= 0)
													{
														errors.add("• No stock available in this Store for " + stock_cond + " condition.");
													}
													else if(extra_needed > store_stock)
													{
														errors.add("• Insufficient store stock. Required: " + extra_needed + " (Base UoM). Available: " + store_stock + " (Base UoM).");
													}
												}
											}
										}
										// 13) TOOL CHECK
										if(input.Item != null)
										{
											if(input.Item.Is_Tool == true)
											{
												is_tool = true;
											}
										}
										// 14) LINE TOTAL VALIDATION
										calc_line_total = ifnull(input.Quantity,0.0) * ifnull(input.Cost,0.0);
										if(is_tool == false && stock_cond != "Used")
										{
											if(calc_line_total <= 0)
											{
												errors.add("• Line Total cannot be zero. Please check Quantity or Cost.");
											}
										}
										else
										{
											if(input.Line_Total == null)
											{
												input.Line_Total = 0.0;
											}
										}
										// 15) TOOL RETURN DATE VALIDATION
										if(is_tool && req_type != "Internal Transfer" && input.Expected_Return_Date == null)
										{
											errors.add("• Expected Return Date is required for tools unless Request Voucher Type is Internal Transfer.");
										}
										// 16) EDIT ONLY CANCELLATION VALIDATION
										if(input.ID != null && input.Cancel_This_Line_Item == true)
										{
											if(input.Reason_Why_Cancelled == null || input.Reason_Why_Cancelled.trim() == "")
											{
												errors.add("• Please enter the reason why this line item was cancelled.");
											}
										}
										// FINAL
										if(errors.isEmpty() == false)
										{
											msg = "Please fix the following:\n\n";
											for each  err in errors
											{
												msg = msg + err + "\n";
											}
											alert msg;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize_On_Create22 as "Finalize On Create"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ITEM ISSUING DETAILS - FINALIZE ON CREATE
										// =====================================================
										// 1) AUDIT + DEFAULT RETURNS
										// =====================================================
										u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
										input.Quantity_Returned = 0.0;
										input.Quantity_Returned_in_Base_Unit_Of_Measure = 0.0;
										// =====================================================
										// 2) NON-ISSUING REQUEST TYPES
										// =====================================================
										if(input.Request_Voucher_Type != "Employee Voucher" && input.Request_Voucher_Type != "Sales Voucher" && input.Request_Voucher_Type != "Internal Transfer")
										{
											input.Status = "Draft";
											if(input.Item != null && input.Unit_Of_Measure != null && input.Quantity != null && input.Quantity > 0)
											{
												base_qty_create = store_management.po.convert_to_base_qty_from_masaka_site_management(input.Item,input.Unit_Of_Measure,input.Quantity);
												if(base_qty_create != null && base_qty_create > 0)
												{
													input.Quantity_in_Base_Unit_Of_Measure = base_qty_create;
													input.Line_Total = (base_qty_create * ifnull(input.Cost,0.0)).round(2);
												}
											}
											info "Created as Draft. Request Type does not issue stock.";
											return;
										}
										// =====================================================
										// 3) REQUIRED FIELD CHECKS
										// =====================================================
										if(input.Issuing_Voucher == null)
										{
											info "Issuing Voucher is required.";
											return;
										}
										if(input.Request_Voucher_Type == "Employee Voucher" && input.Employee_Voucher == null)
										{
											info "Employee Voucher is required.";
											return;
										}
										if(input.Request_Voucher_Type == "Sales Voucher")
										{
											if(input.Sales_Voucher == null)
											{
												info "Sales Voucher is required.";
												return;
											}
											if(input.Item_Taken == null)
											{
												info "Item Taken is required.";
												return;
											}
										}
										if(input.Item == null || input.Unit_Of_Measure == null || input.Quantity == null || input.Quantity <= 0)
										{
											info "Item, Unit of Measure and Quantity are required.";
											return;
										}
										// =====================================================
										// 4) LOAD ISSUING HEADER + STORE
										// =====================================================
										hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
										if(hdr.ID == null || hdr.Store == null)
										{
											info "Header missing or Store missing.";
											return;
										}
										store_id = hdr.Store;
										// =====================================================
										// 5) STOCK CONDITION
										// =====================================================
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = "New";
										}
										// =====================================================
										// 6) REFERENCE NUMBER
										// =====================================================
										ref_no = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim();
										if(ref_no == "")
										{
											ref_no = hdr.ID.toString();
										}
										// =====================================================
										// 7) UOM CHECK + BASE QUANTITY
										// =====================================================
										check = store_management.po.check_uom_conversion_from_masaka_site_management(input.Item,input.Unit_Of_Measure);
										if(check == null || check.get("ok") != true)
										{
											info ifnull(check.get("message"),"UOM conversion failed.");
											return;
										}
										base_qty = store_management.po.convert_to_base_qty_from_masaka_site_management(input.Item,input.Unit_Of_Measure,input.Quantity);
										if(base_qty == null || base_qty <= 0)
										{
											info "Invalid base quantity.";
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure = base_qty;
										// =====================================================
										// 8) LINE TOTAL
										// =====================================================
										line_total_val = (base_qty * ifnull(input.Cost,0.0)).round(2);
										input.Line_Total = line_total_val;
										// =====================================================
										// 9) TOOL CHECK + FINAL STATUS
										// =====================================================
										is_tool_item = false;
										if(input.Item != null && input.Item.Is_Tool == true)
										{
											is_tool_item = true;
										}
										if(input.Request_Voucher_Type == "Internal Transfer")
										{
											input.Status = "Transferring";
											input.Expected_Return_Date = null;
										}
										else if(is_tool_item == true)
										{
											input.Status = "Borrowed";
										}
										else
										{
											input.Status = "Issued";
											input.Expected_Return_Date = null;
										}
										// =====================================================
										// 10) ISSUE STOCK IN STORE MANAGEMENT
										// =====================================================
										stock_resp = store_management.stock.issue_stock_from_Kicksklean(input.Item,store_id,input.Quantity,input.Unit_Of_Measure,cond,line_total_val,ref_no,input.ID);
										info stock_resp;
										if(stock_resp == null || stock_resp.get("ok") != true)
										{
											input.Status = "Draft";
											info "Stock issue failed: " + ifnull(stock_resp.get("message"),"No response from Store Management.");
											return;
										}
										// =====================================================
										// 11) UPDATE STOCK PREVIEW FROM RESPONSE
										// =====================================================
										input.Quantity_in_Base_Unit_Of_Measure = ifnull(stock_resp.get("base_qty"),base_qty);
										input.Store_Available_Stock = ifnull(stock_resp.get("store_stock"),0.0);
										input.Global_Available_Stock = ifnull(stock_resp.get("global_stock"),0.0);
										// =====================================================
										// 12) INTERNAL TRANSFER ONLY
										// =====================================================
										if(input.Request_Voucher_Type == "Internal Transfer")
										{
											transfer_payload = Map();
											transfer_payload.put("Source_Record_ID",input.ID);
											transfer_payload.put("Source_Form","Item Issuing Details");
											transfer_payload.put("Source_Application","Kicks Klean Ug");
											transfer_payload.put("Transfer_Number",ifnull(input.Item_Issuing_Number,""));
											transfer_payload.put("Transfer_Date",zoho.currentdate);
											transfer_payload.put("Issuing_Store",input.Store);
											transfer_payload.put("Item",input.Item);
											transfer_payload.put("Display_Name_Item",ifnull(input.Display_Name_Item,""));
											transfer_payload.put("Quantity",ifnull(input.Quantity,0.0));
											transfer_payload.put("Unit_Of_Measure",input.Unit_Of_Measure);
											transfer_payload.put("Display_Name_Unit_Of_Measure",ifnull(input.Display_Name_Unit_Of_Measure,""));
											transfer_payload.put("Quantity_in_Base_Unit_Of_Measure",ifnull(input.Quantity_in_Base_Unit_Of_Measure,0.0));
											transfer_payload.put("Issued_By",ifnull(input.Display_Name_Issued_By,""));
											transfer_payload.put("Stock_Condition",cond);
											transfer_payload.put("Unit_Cost",ifnull(input.Cost,0.0));
											transfer_payload.put("Transfer_Status","Not Received");
											transfer_resp = store_management.stock_transfer.create_transfer_from_item_issuing(transfer_payload);
											info transfer_resp;
											if(transfer_resp == null || transfer_resp.get("ok") != true)
											{
												info "Stock was deducted, but Stock Transfer creation failed: " + ifnull(transfer_resp.get("message"),"No response from Store Management.");
												return;
											}
										}
										// =====================================================
										// 12) UPDATE SALES VOUCHER DETAILS ISSUE STATUS
										// =====================================================
										if(input.Request_Voucher_Type == "Sales Voucher" && input.Item_Taken != null)
										{
											svd = Sales_Voucher_Details[ID == input.Item_Taken];
											if(svd.ID != null)
											{
												total_issued_base = 0.0;
												for each  issue in Item_Issuing_Details[Item_Taken == svd.ID]
												{
													total_issued_base = total_issued_base + ifnull(issue.Quantity_in_Base_Unit_Of_Measure,0.0);
												}
												required_base = ifnull(svd.Quantity_in_Base_Unit_Of_Measure,0.0);
												svd.Quantity_Issued_in_Base_Unit_Of_Measure=total_issued_base;
												not_issued_base = required_base - total_issued_base;
												if(not_issued_base < 0)
												{
													not_issued_base = 0.0;
												}
												svd.Quantity_Not_Issued_in_Base_Unit_Of_Measure=not_issued_base;
												if(total_issued_base <= 0)
												{
													svd.Issue_Status="Not Issued";
												}
												else if(total_issued_base >= required_base)
												{
													svd.Issue_Status="Fully Issued";
												}
												else
												{
													svd.Issue_Status="Partially Issued";
												}
											}
										}
										info "Item Issuing Details finalized on create. Final Status = " + input.Status;
						)
					}
				}

			}
			Finalize_On_Edit22 as "Finalize On Edit"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ITEM ISSUING DETAILS - FINALIZE ON EDIT
										// =====================================================
										// 1) LOAD SAVED RECORD
										saved_rec = Item_Issuing_Details[ID == input.ID];
										if(saved_rec.ID == null)
										{
											info "Saved Item Issuing Details not found.";
											return;
										}
										saved_status = ifnull(saved_rec.Status,"").trim();
										current_status = ifnull(input.Status,"").trim();
										// 2) EDIT AUDIT
										u = thisapp.audit.getLoginAuditInfo();
										input.Updated_By_Name = u.get("name");
										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
										// 3) CANCEL LINE
										if(input.Cancel_This_Line_Item == true)
										{
											input.Status = "Cancelled";
											info "Line item cancelled. No stock change.";
											return;
										}
										// 4) PRESERVE IMPORTANT FIELDS
										if(input.Item == null)
										{
											input.Item = saved_rec.Item;
										}
										if(input.Display_Name_Item == null || input.Display_Name_Item.trim() == "")
										{
											input.Display_Name_Item = saved_rec.Display_Name_Item;
										}
										if(input.Unit_Of_Measure == null)
										{
											input.Unit_Of_Measure = saved_rec.Unit_Of_Measure;
										}
										if(input.Display_Name_Unit_Of_Measure == null || input.Display_Name_Unit_Of_Measure.trim() == "")
										{
											input.Display_Name_Unit_Of_Measure = saved_rec.Display_Name_Unit_Of_Measure;
										}
										if(input.Quantity == null)
										{
											input.Quantity = saved_rec.Quantity;
										}
										if(input.Cost == null)
										{
											input.Cost = ifnull(saved_rec.Cost,0.0);
										}
										if(input.Stock_Condition == null || input.Stock_Condition.trim() == "")
										{
											input.Stock_Condition = ifnull(saved_rec.Stock_Condition,"New");
										}
										if(input.Request_Voucher_Type == null || input.Request_Voucher_Type.trim() == "")
										{
											input.Request_Voucher_Type = ifnull(saved_rec.Request_Voucher_Type,"");
										}
										if(input.Employee_Voucher == null)
										{
											input.Employee_Voucher = saved_rec.Employee_Voucher;
										}
										if(input.Work_Order_Task == null)
										{
											input.Work_Order_Task = saved_rec.Work_Order_Task;
										}
										if(input.Line_Number == null)
										{
											input.Line_Number = saved_rec.Line_Number;
										}
										if(input.Item_Issuing_Number == null || input.Item_Issuing_Number.trim() == "")
										{
											input.Item_Issuing_Number = saved_rec.Item_Issuing_Number;
										}
										if(input.Quantity_Returned == null)
										{
											input.Quantity_Returned = ifnull(saved_rec.Quantity_Returned,0.0);
										}
										if(input.Quantity_Returned_in_Base_Unit_Of_Measure == null)
										{
											input.Quantity_Returned_in_Base_Unit_Of_Measure = ifnull(saved_rec.Quantity_Returned_in_Base_Unit_Of_Measure,0.0);
										}
										// 5) NON-EMPLOYEE VOUCHER TYPES
										if(input.Request_Voucher_Type != "Employee Voucher")
										{
											if(current_status == "Draft" || current_status == "")
											{
												input.Status = "Approved";
												info "Draft moved to Approved. No stock deducted.";
												return;
											}
											if(current_status == "Approved")
											{
												input.Status = "Issued";
												current_status = "Issued";
											}
											else if(current_status != "Issued")
											{
												info "No activities run. Status is " + current_status;
												return;
											}
											if(input.Issuing_Voucher == null)
											{
												info "Issuing Voucher is required.";
												return;
											}
											if(input.Item == null || input.Unit_Of_Measure == null || input.Quantity == null || input.Quantity <= 0)
											{
												info "Item, Unit of Measure and Quantity are required.";
												return;
											}
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID == null || hdr.Store == null)
											{
												info "Header missing or Store missing.";
												return;
											}
											store_id = hdr.Store;
											cond = ifnull(input.Stock_Condition,"New").trim();
											if(cond == "")
											{
												cond = "New";
												input.Stock_Condition = "New";
											}
											check = store_management.po.check_uom_conversion_from_masaka_site_management(input.Item,input.Unit_Of_Measure);
											if(check == null || check.get("ok") != true)
											{
												info ifnull(check.get("message"),"UOM conversion failed.");
												return;
											}
											base_qty_create = store_management.po.convert_to_base_qty_from_masaka_site_management(input.Item,input.Unit_Of_Measure,input.Quantity);
											if(base_qty_create == null || base_qty_create <= 0)
											{
												info "Invalid base quantity.";
												return;
											}
											input.Quantity_in_Base_Unit_Of_Measure = base_qty_create;
											line_total_val = (base_qty_create * ifnull(input.Cost,0.0)).round(2);
											input.Line_Total = line_total_val;
											// Deduct stock only when moving Approved -> Issued
											if(saved_status == "Approved" && input.Status == "Issued")
											{
												ref_no = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim();
												if(ref_no == "")
												{
													ref_no = hdr.ID.toString();
												}
												stock_resp = store_management.stock.issue_stock_from_Kicksklean(input.Item,store_id,input.Quantity,input.Unit_Of_Measure,cond,line_total_val,ref_no,input.ID);
												info stock_resp;
												if(stock_resp == null || stock_resp.get("ok") != true)
												{
													input.Status = saved_status;
													info "Stock issue failed: " + ifnull(stock_resp.get("message"),"No response from Store Management.");
													return;
												}
												input.Quantity_in_Base_Unit_Of_Measure = ifnull(stock_resp.get("base_qty"),base_qty_create);
												input.Store_Available_Stock = ifnull(stock_resp.get("store_stock"),0.0);
												input.Global_Available_Stock = ifnull(stock_resp.get("global_stock"),0.0);
											}
											else
											{
												info "No stock deduction. Stock only deducts when saved status is Approved and final status becomes Issued.";
											}
											if(input.Request_Voucher_Type == "Work Order Task" && input.Work_Order_Task != null)
											{
												qty_selected = ifnull(input.Quantity,0.0);
												qty_base = ifnull(input.Quantity_in_Base_Unit_Of_Measure,0.0);
												base_unit_cost = ifnull(input.Cost,0.0);
												selected_uom_name = ifnull(input.Display_Name_Unit_Of_Measure,"");
												if(qty_base <= 0)
												{
													qty_base = base_qty_create;
													input.Quantity_in_Base_Unit_Of_Measure = qty_base;
												}
												rate_base = base_unit_cost;
												line_total_val = (qty_base * base_unit_cost).round(2);
												input.Line_Total = line_total_val;
												description_txt = "";
												description_txt = description_txt + "Issued By: " + ifnull(input.Display_Name_Issued_By,"");
												description_txt = description_txt + "\nStore: " + ifnull(input.Store,"");
												description_txt = description_txt + "\nItem Issuing Number: " + ifnull(input.Item_Issuing_Number,"");
												description_txt = description_txt + "\nTaken By: " + ifnull(input.Display_Name_Taken_By,"");
												description_txt = description_txt + "\nIssued Quantity: " + qty_selected + " " + selected_uom_name;
												pc_exists = false;
												for each  pc_chk in Parts_Consumables[Source_Record_ID == input.ID && Source_Form == "Item Issuing Details"]
												{
													pc_exists = true;
													pc_chk.Work_Order_Task_Number=input.Work_Order_Task;
													pc_chk.Display_Name_Work_Order_Task_Number=ifnull(input.Work_Order_Task.Work_Order_Task_Number,"");
													pc_chk.Line_Number=input.Line_Number;
													pc_chk.Item=input.Item;
													pc_chk.Display_Name_Item_Labour=ifnull(input.Display_Name_Item,"");
													pc_chk.Description=description_txt;
													pc_chk.Quantity=qty_selected;
													pc_chk.Quantity_In_Base_Unit=qty_base;
													pc_chk.Unit_Of_Measure=selected_uom_name;
													pc_chk.Unit_Cost=base_unit_cost;
													pc_chk.Rate_In_Base_Unit=base_unit_cost;
													pc_chk.Line_Total=line_total_val;
													pc_chk.Item_Issuing_Detail=input.ID;
													pc_chk.Item_Status=input.Status;
													break;
												}
												if(pc_exists == false)
												{
													insert into Parts_Consumables
													[
														Work_Order_Task_Number=input.Work_Order_Task
														Display_Name_Work_Order_Task_Number=ifnull(input.Work_Order_Task.Work_Order_Task_Number,"")
														Line_Number=input.Line_Number
														Item=input.Item
														Display_Name_Item_Labour=ifnull(input.Display_Name_Item,"")
														Description=description_txt
														Quantity=qty_selected
														Quantity_In_Base_Unit=qty_base
														Unit_Of_Measure=selected_uom_name
														Unit_Cost=base_unit_cost
														Rate_In_Base_Unit=base_unit_cost
														Line_Total=line_total_val
														Item_Issuing_Detail=input.ID
														Item_Status=input.Status
														Source_Record_ID=input.ID.toString()
														Source_Form="Item Issuing Details"
														Added_User=zoho.loginuser
													]
												}
											}
											info "Masaka non-employee request finalized. Final status = " + input.Status;
											return;
										}
										// 6) EMPLOYEE VOUCHER REQUIRED FIELDS
										if(input.Issuing_Voucher == null)
										{
											info "Issuing Voucher is required.";
											return;
										}
										if(input.Employee_Voucher == null)
										{
											info "Employee Voucher is required.";
											return;
										}
										if(input.Item == null || input.Unit_Of_Measure == null || input.Quantity == null || input.Quantity <= 0)
										{
											info "Item, Unit of Measure and Quantity are required.";
											return;
										}
										// 7) LOAD ISSUING HEADER + STORE
										hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
										if(hdr.ID == null || hdr.Store == null)
										{
											info "Header missing or Store missing.";
											return;
										}
										store_id = hdr.Store;
										// 8) STOCK CONDITION
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = "New";
										}
										// 9) UOM CHECK + BASE QUANTITY
										check = store_management.po.check_uom_conversion_from_masaka_site_management(input.Item,input.Unit_Of_Measure);
										if(check == null || check.get("ok") != true)
										{
											info ifnull(check.get("message"),"UOM conversion failed.");
											return;
										}
										base_qty = store_management.po.convert_to_base_qty_from_masaka_site_management(input.Item,input.Unit_Of_Measure,input.Quantity);
										if(base_qty == null || base_qty <= 0)
										{
											info "Invalid base quantity.";
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure = base_qty;
										// 10) LINE TOTAL
										line_total_val = (base_qty * ifnull(input.Cost,0.0)).round(2);
										input.Line_Total = line_total_val;
										// 11) TOOL CHECK + FINAL STATUS
										is_tool_item = false;
										if(input.Item != null && input.Item.Is_Tool == true)
										{
											is_tool_item = true;
										}
										if(is_tool_item == true)
										{
											if(input.Didn_t_Come_Back == true)
											{
												input.Status = "Out of Service";
												input.Expected_Return_Date = null;
											}
											else
											{
												issued_base = ifnull(input.Quantity_in_Base_Unit_Of_Measure,0.0);
												returned_base = ifnull(input.Quantity_Returned_in_Base_Unit_Of_Measure,0.0);
												if(issued_base > 0 && returned_base >= issued_base)
												{
													input.Status = "Returned";
													input.Expected_Return_Date = null;
												}
												else
												{
													input.Status = "Borrowed";
												}
											}
										}
										else
										{
											input.Status = "Issued";
											input.Expected_Return_Date = null;
										}
										// 12) REFERENCE NUMBER
										ref_no = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim();
										if(ref_no == "")
										{
											ref_no = hdr.ID.toString();
										}
										// 13) ISSUE STOCK IN STORE MANAGEMENT
										stock_resp = store_management.stock.issue_stock_from_Kicksklean(input.Item,store_id,input.Quantity,input.Unit_Of_Measure,cond,line_total_val,ref_no,input.ID);
										info stock_resp;
										if(stock_resp == null || stock_resp.get("ok") != true)
										{
											input.Status = saved_status;
											info "Stock issue failed: " + ifnull(stock_resp.get("message"),"No response from Store Management.");
											return;
										}
										// 14) UPDATE STOCK PREVIEW FROM RESPONSE
										input.Quantity_in_Base_Unit_Of_Measure = ifnull(stock_resp.get("base_qty"),base_qty);
										input.Store_Available_Stock = ifnull(stock_resp.get("store_stock"),0.0);
										input.Global_Available_Stock = ifnull(stock_resp.get("global_stock"),0.0);
										// 16) DONE
										info "Masaka Item Issuing Details finalized on edit. Final status = " + input.Status;
						)
					}
				}

			}
			Finalize_On_Delete4 as "Finalize On Delete"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// ITEM ISSUING DETAILS - FINALIZE ON DELETE
										// =====================================
										source_form_val = "Kicks Klean Ug - Item Issuing Details";
										// -------------------------------------
										// 1) Reverse Store stock posted from Masaka Site Management
										// -------------------------------------
										store_reverse_resp = store_management.delete_item_issuing_from_Kicksklean(input.ID);
										info store_reverse_resp;
										pc_rows = Parts_Consumables[Source_Record_ID == input.ID && Source_Form == source_form_val];
										for each  pc in pc_rows
										{
											delete from Parts_Consumables[ID == pc.ID];
										}
						)
					}
				}

			}
