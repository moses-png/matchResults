			Finalize3 as "Finalize"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ====================================================
										// BACK END AUDIT INFO
										// ====================================================
										u = thisapp.audit.getLoginAuditInfo();
										user_name_val = u.get("name");
										user_email_val = u.get("email");
										user_role_val = u.get("role");
										// ====================================================
										// 1) Auto-fill Fuel Issuing Time (on create only)
										// ====================================================
										if(input.ID == null)
										{
											if(input.Fuel_Issuing_Time == null)
											{
												input.Fuel_Issuing_Time = zoho.currenttime;
											}
										}
										// ====================================================
										// 2) Prepare values for Bill Details
										// ====================================================
										account_text = "";
										current_site_text = "";
										description_text = "";
										line_total_val = round(ifnull(input.Quantity,0) * ifnull(input.Rate,0),2);
										if(input.Asset != null)
										{
											account_text = ifnull(input.Asset.Asset_Name,"") + " - " + ifnull(input.Asset.Asset_ID,"");
											current_site_text = ifnull(input.Asset.Current_Site,"");
										}
										if(input.Fuel_Issuing_Time != null)
										{
											description_text = input.Fuel_Issuing_Time.toString();
										}
										// ====================================================
										// 3) Create or Update Bill Details
										// ====================================================
										source_text = input.Fuel_Voucher + " - Fuel Receiving Voucher";
										existing_bd = Bill_Details[Reference == input.Fuel_Voucher && Source == source_text];
										for each  bd in existing_bd
										{
											bd.Source=source_text;
											bd.Reference=input.Fuel_Voucher;
											bd.Display_Name_Item="Fuel";
											bd.Description=description_text;
											bd.Quantity=ifnull(input.Quantity,0);
											bd.Rate=ifnull(input.Rate,0);
											bd.Line_Total=line_total_val;
											bd.Account=account_text;
											bd.Current_Site=current_site_text;
											break;
										}
										if(existing_bd.count() == 0)
										{
											insert into Bill_Details
											[
												Source=source_text
												Reference=input.Fuel_Voucher
												Display_Name_Item="Fuel"
												Description=description_text
												Quantity=ifnull(input.Quantity,0)
												Rate=ifnull(input.Rate,0)
												Line_Total=line_total_val
												Account=account_text
												Current_Site=current_site_text
												Added_User=zoho.loginuser
											]
										}
										// ====================================================
										// 4) Create or Update Asset Mileage Log
										// Handles backdated entries correctly
										// ====================================================
										if(input.Asset != null && input.Fuel_Issuing_Time != null)
										{
											date_time_recorded = input.Fuel_Issuing_Time;
											odometer_reading = ifnull(input.Odometer,0.0);
											reference_text = ifnull(input.Fuel_Voucher,"");
											notes_text = "Auto created from Fuel Receiving Voucher";
											source_form_text = "Fuel Receiving Voucher";
											source_record_id_text = ifnull(input.ID,"").toString();
											unit_of_measure_text = ifnull(input.Asset.Odometer_Unit_Of_Measure,"");
											previous_odometer = 0.0;
											// ----------------------------------------------------
											// A) Find the nearest EARLIER mileage log for this asset
											// ----------------------------------------------------
											prev_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded < date_time_recorded] sort by Date_Time_Recorded desc;
											for each  pl in prev_logs
											{
												if(pl != null)
												{
													previous_odometer = ifnull(pl.Odometer_Reading,0.0);
													break;
												}
											}
											distance_since_last = odometer_reading - previous_odometer;
											if(distance_since_last < 0)
											{
												distance_since_last = 0.0;
											}
											// ----------------------------------------------------
											// B) Create or update the current mileage log row
											// ----------------------------------------------------
											existing_log = Asset_Mileage_Log[Odometer_Source_Form == source_form_text && Source_Record_ID == source_record_id_text];
											current_log_id = null;
											found_existing_log = false;
											for each  log_rec in existing_log
											{
												if(log_rec != null)
												{
													log_rec.Asset=input.Asset;
													log_rec.Date_Time_Recorded=date_time_recorded;
													log_rec.Odometer_Reading=odometer_reading;
													log_rec.Previous_Odometer=previous_odometer;
													log_rec.Distance_Since_Last=distance_since_last;
													log_rec.Reference=reference_text;
													log_rec.Notes=notes_text;
													log_rec.Unit_of_Measure=unit_of_measure_text;
													// Back End update audit
													log_rec.User_Name=user_name_val;
													log_rec.User_Email=user_email_val;
													log_rec.User_Role=user_role_val;
													log_rec.Updated_By_Name=user_name_val;
													log_rec.Updated_By_Email=user_email_val;
													log_rec.Updated_By_Time=zoho.currenttime;
													current_log_id = log_rec.ID;
													found_existing_log = true;
													break;
												}
											}
											if(found_existing_log == false)
											{
												new_log = insert into Asset_Mileage_Log
												[
													Asset=input.Asset
													Date_Time_Recorded=date_time_recorded
													Odometer_Reading=odometer_reading
													Previous_Odometer=previous_odometer
													Distance_Since_Last=distance_since_last
													Reference=reference_text
													Notes=notes_text
													Odometer_Source_Form=source_form_text
													Source_Record_ID=source_record_id_text
													Unit_of_Measure=unit_of_measure_text
													User_Name=user_name_val
													User_Email=user_email_val
													User_Role=user_role_val
													Created_By_Name=user_name_val
													Created_By_Email=user_email_val
													Created_By_Time=zoho.currenttime
													Added_User=zoho.loginuser
												];
												current_log_id = new_log;
											}
											// ----------------------------------------------------
											// C) Fix the nearest NEXT mileage log after this one
											// Because a backdated insert changes its Previous_Odometer
											// ----------------------------------------------------
											next_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded > date_time_recorded] sort by Date_Time_Recorded asc;
											for each  nx in next_logs
											{
												if(nx != null && nx.ID != current_log_id)
												{
													nx.Previous_Odometer=odometer_reading;
													new_next_distance = ifnull(nx.Odometer_Reading,0.0) - odometer_reading;
													if(new_next_distance < 0)
													{
														new_next_distance = 0.0;
													}
													nx.Distance_Since_Last=new_next_distance;
													break;
												}
											}
										}
										// ====================================================
										// 5) Update Asset -> Total Fuel Costs
										// RECOMPUTE SAFE (won't double count on edit)
										// ====================================================
										if(input.Asset != null)
										{
											total_fuel_costs = 0.0;
											fuel_rows = Fuel_Receiving_Voucher[Asset == input.Asset];
											for each  fr in fuel_rows
											{
												row_total = round(ifnull(fr.Quantity,0.0) * ifnull(fr.Rate,0.0),2);
												total_fuel_costs = total_fuel_costs + row_total;
											}
											total_fuel_costs = round(total_fuel_costs,2);
											asset_rec = Asset_List[ID == input.Asset];
											if(asset_rec.ID != null)
											{
												asset_rec.Total_Fuel_Costs=total_fuel_costs;
												odo_val = ifnull(asset_rec.Odometer_Reading,0.0);
												if(odo_val > 0)
												{
													asset_rec.Fuel_Cost_Per_Odometer=round(total_fuel_costs / odo_val,2);
												}
												else
												{
													asset_rec.Fuel_Cost_Per_Odometer=0.0;
												}
											}
										}
										thisapp.asset.refresh_asset_costs(input.Asset.ID);
										// ====================================================
										// 6) Send Fuel Receiving Voucher to Employee Management
										// ====================================================
										if(input.Voucher != null)
										{
											payload = Map();
											payload.put("asset_fuel_id",input.ID);
											payload.put("voucher_id",input.Voucher.ID);
											payload.put("fuel_issuing_time",input.Fuel_Issuing_Time);
											payload.put("issued_by",input.Issued_By);
											payload.put("supplied_by",input.Supplied_By);
											payload.put("quantity",ifnull(input.Quantity,0.0));
											payload.put("rate",ifnull(input.Rate,0.0));
											payload.put("fuel_level_before",input.Fuel_Level_Before);
											payload.put("fuel_level_after",input.Fuel_Level_After);
											// ✅ ADD THIS
											payload.put("source_record_id",input.ID);
											payload.put("source_form","Fuel Receiving Voucher");
											employee_management.create_fuel_receiving_from_asset(payload);
										}
										if(input.Asset != null)
										{
											amount_val = 0.0;
											income_val = 0.0;
											expense_val = 0.0;
											issued_by_text = ifnull(input.Issued_By,"");
											supplied_by_text = ifnull(input.Supplied_By,"");
											voucher_text = ifnull(input.Fuel_Voucher,"");
											desc_text = "";
											desc_text = desc_text + "Issued By: " + issued_by_text + "\n";
											desc_text = desc_text + "Supplied By: " + supplied_by_text + "\n";
											desc_text = desc_text + "Voucher: " + voucher_text + "\n";
											desc_text = desc_text + "Odometer: " + ifnull(input.Odometer,0.0).toString() + "\n";
											desc_text = desc_text + "Quantity: " + ifnull(input.Quantity,0.0).toString();
											payload = Map();
											payload.put("Transaction_Date",ifnull(input.Fuel_Issuing_Time,zoho.currenttime));
											payload.put("Transaction_Status","Draft");
											payload.put("Transaction_Description",desc_text);
											payload.put("Asset",input.Asset.ID);
											payload.put("Display_Name_Asset",ifnull(input.Display_Name_Asset,""));
											payload.put("Transaction_Direction","Expense");
											payload.put("Amount",amount_val);
											payload.put("Income",income_val);
											payload.put("Expenses",expense_val);
											payload.put("Application","Asset Management");
											payload.put("Source_Form","Fuel Receiving Voucher");
											payload.put("Source_Record_ID",input.ID);
											payload.put("Notes",voucher_text);
											resp = thisapp.createOrUpdateAssetTransactionLog(payload);
											info resp;
										}
						)
					}
				}

			}
			On_Is_Purchased_Selected as "On Is Purchased Selected"
			{
				type =  form
				form = Asset_List

				record event = on add or edit

				on user input of Is_Purchased
				{
					actions 
					{
						custom deluge script
						(
											if(input.Is_Purchased == true)
										{
											show Item;
											show Purchase_Cost;
										}
										else
										{
											hide Item;
											hide Purchase_Cost;
