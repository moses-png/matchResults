				}

			}
			On_Employee_Voucher_Selec2 as "On Employee Voucher Selected"
			{
				type =  form
				form = Asset_Transfer_Multiple_Voucher

				record event = on add or edit

				on user input of Employee_Voucher
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ON EMPLOYEE VOUCHER SELECTED
										// =====================================================
										if(input.Employee_Voucher != null)
										{
											voucher_number = ifnull(input.Employee_Voucher.Voucher_Number,"").trim();
											employee_name = ifnull(input.Employee_Voucher.Display_Name_Employee,"").trim();
											if(voucher_number != "" && employee_name != "")
											{
												Display_Name_Employee_Voucher = voucher_number + " - " + employee_name;
											}
											else if(voucher_number != "")
											{
												Display_Name_Employee_Voucher = voucher_number;
											}
											else if(employee_name != "")
											{
												Display_Name_Employee_Voucher = employee_name;
											}
											else
											{
												Display_Name_Employee_Voucher = "";
											}
											// Copy into existing subform rows
											for each  r in input.Transfer_Vouchers
											{
												r.Voucher=input.Employee_Voucher;
												r.Display_Name_Asset_Transfer_Voucher=Display_Name_Employee_Voucher;
											}
										}
										else
										{
											Display_Name_Employee_Voucher = "";
											for each  r in input.Transfer_Vouchers
											{
												r.Voucher=null;
												r.Display_Name_Asset_Transfer_Voucher="";
											}
										}
						)
					}
				}

			}
			On_Party_Location_From_Se as "On Party Location From Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Party_Location_From
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PARTY LOCATION FROM
										// USER INPUT
										// =====================================================
										if(input.Party_Location_From != null)
										{
											locationName = ifnull(input.Party_Location_From.Location_Name,"").toString().trim();
											if(input.Party_From != null)
											{
												customerName = ifnull(input.Party_From.Customer_Name,"").toString().trim();
												customerCode = ifnull(input.Party_From.Customer_Code,"").toString().trim();
												if(customerName != "" && customerCode != "")
												{
													input.Display_Name_Party_From = customerName + " - " + customerCode;
												}
												else if(customerName != "")
												{
													input.Display_Name_Party_From = customerName;
												}
												else if(customerCode != "")
												{
													input.Display_Name_Party_From = customerCode;
												}
												else
												{
													input.Display_Name_Party_From = "";
												}
												if(input.Display_Name_Party_From != "" && locationName != "")
												{
													input.Pick_Up_From = input.Display_Name_Party_From + " - " + locationName;
												}
												else if(input.Display_Name_Party_From != "")
												{
													input.Pick_Up_From = input.Display_Name_Party_From;
												}
												else
												{
													input.Pick_Up_From = locationName;
												}
											}
											else
											{
												input.Display_Name_Party_From = "";
												input.Pick_Up_From = locationName;
											}
										}
										else
										{
											if(input.Party_From != null)
											{
												customerName = ifnull(input.Party_From.Customer_Name,"").toString().trim();
												customerCode = ifnull(input.Party_From.Customer_Code,"").toString().trim();
												if(customerName != "" && customerCode != "")
												{
													input.Display_Name_Party_From = customerName + " - " + customerCode;
												}
												else if(customerName != "")
												{
													input.Display_Name_Party_From = customerName;
												}
												else if(customerCode != "")
												{
													input.Display_Name_Party_From = customerCode;
												}
												else
												{
													input.Display_Name_Party_From = "";
												}
												input.Pick_Up_From = input.Display_Name_Party_From;
											}
											else
											{
												input.Display_Name_Party_From = "";
												input.Pick_Up_From = "";
											}
										}
						)
					}
				}

			}
