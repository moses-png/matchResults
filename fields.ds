				 void finalizeVoucher(int voucherID)
                 {
                 	v = Voucher[ID == voucherID];
                 	if(v != null)
                 	{
                 		now_ts = zoho.currenttime;
                 		// Only finalize vouchers at Human Resource
                 		if(v.Voucher_Status == "Human Resource")
                 		{
                 			if(v.Hr_Time_Checked == null)
                 			{
                 				v.Hr_Time_Checked=now_ts;
                 			}
                 			// Example final status
                 			v.Voucher_Status="Audited";
                 		}
                 	}
                 }
				 void fixPaymentReceivedDates()
                 {
                 	// ---------------------------------------------
                 	// Get all records with empty Payment Date
                 	// ---------------------------------------------
                 	records = Payment_Received[Payment_Date == null];
                 	updated_count = 0;
                 	skipped_count = 0;
                 	// ---------------------------------------------
                 	// Loop through records
                 	// ---------------------------------------------
                 	for each  rec in records
                 	{
                 		try 
                 		{
                 			// -------------------------------------
                 			// Ensure Created_By_Time exists
                 			// -------------------------------------
                 			if(rec.Created_By_Time != null)
                 			{
                 				// ---------------------------------
                 				// IF Payment_Date is DATE FIELD
                 				// ---------------------------------
                 				rec.Payment_Date=rec.Created_By_Time.toDate();
                 				// ---------------------------------
                 				// IF Payment_Date is DATE-TIME FIELD
                 				// Use this instead:
                 				//
                 				// rec.Payment_Date = rec.Created_By_Time;
                 				// ---------------------------------
                 				updated_count = updated_count + 1;
                 				info "Updated Record ID: " + rec.ID;
                 			}
                 			else
                 			{
                 				skipped_count = skipped_count + 1;
                 				info "Skipped Record ID: " + rec.ID + " (Created_By_Time is empty)";
                 			}
                 		}
                 		catch (e)
                 		{
                 			info "Error on Record ID: " + rec.ID;
                 			info e;
                 		}
                 	}
                 	// ---------------------------------------------
                 	// Final Summary
                 	// ---------------------------------------------
                 	info "=================================";
                 	info "PAYMENT DATE FIX COMPLETED";
                 	info "Updated Records: " + updated_count;
                 	info "Skipped Records: " + skipped_count;
                 	info "=================================";
                 }
				 string Generate_Voucher_Number(int documentKeyId)
                 {
                 	dk = Document_Key[ID == documentKeyId && Document_Type == "Digital Voucher" && Document__Status == "Active"];
                 	if(dk.ID == null)
                 	{
                 		return "";
                 	}
                 	// ---- Prefix: EXACTLY 3 letters ----
                 	prefix = ifnull(dk.Prefix,"").trim().toUpperCase();
                 	if(!prefix.matches("^[A-Z]{3}$"))
                 	{
                 		return "";
                 	}
                 	// ---- Next number ----
                 	nextNo = ifnull(dk.Next_Number,0);
                 	if(nextNo <= 0)
                 	{
                 		nextNo = 1;
                 	}
                 	// ---- HARD STOP at 999 ----
                 	if(nextNo > 999)
                 	{
                 		return "LIMIT_REACHED";
                 	}
                 	// ---- Pad to 3 digits ----
                 	numStr = nextNo.toString();
                 	if(numStr.length() == 1)
                 	{
                 		numStr = "00" + numStr;
                 	}
                 	else if(numStr.length() == 2)
                 	{
                 		numStr = "0" + numStr;
                 	}
                 	voucherNo = prefix + numStr;
                 	// ---- Increment counter ----
                 	dk.Next_Number=nextNo + 1;
                 	return voucherNo;
                 }
				 map getEmployeeActiveAllowance(map input)
