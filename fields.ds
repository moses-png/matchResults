	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Service_Task_Cost
			(
				displayname = "Total Service Task Cost"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Work_Orders
			(
				type = grid
				displayname = "Work Orders"
				values  = Work_Order.ID
