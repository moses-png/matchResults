			Full_Validation6 as "Full Validation"
			{
				type =  form
				form = Card_Control

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Card Control -> Full Validation (Submit)
										errors = "";
										// Site required
										if(input.Site == null)
										{
											errors = errors + "\n• Site is required.";
										}
										// Prefix required
										if(input.Prefix == null || input.Prefix.trim() == "")
										{
											errors = errors + "\n• Prefix is required.";
										}
										// Next Number: REQUIRED + must NOT be negative
										if(input.Next_Number == null)
										{
											errors = errors + "\n• Next Number is required.";
										}
										else if(input.Next_Number < 0)
										{
											errors = errors + "\n• Next Number cannot be negative.";
										}
										// Card Status required
										if(input.Card_Status == null || input.Card_Status.trim() == "")
										{
											errors = errors + "\n• Card Status is required.";
										}
										// Rate per CBM required + not negative
										if(input.Rate_per_CBM == null)
										{
											errors = errors + "\n• Rate per CBM is required.";
										}
										else if(input.Rate_per_CBM < 0)
										{
											errors = errors + "\n• Rate per CBM cannot be negative.";
										}
										// Prevent duplicate Site + Prefix
										dup = Card_Control[Site == input.Site && Prefix == input.Prefix && ID != input.ID];
										if(dup.count() > 0)
										{
											errors = errors + "\n• Card Control already exists for this Site and Prefix.";
										}
										if(errors != "")
										{
											alert errors;
											cancel submit;
										}
						)
					}
				}

			}
			On_Truck_Size_Selected as "On Truck Size Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Truck_Size
				{
					actions 
					{
						custom deluge script
						(
											// 0) Guard: if Truck_Size not chosen, clear outputs
										if(input.Truck_Size == null)
										{
											input.Truck_CBM = null;
											itemTotal = 0;
											for each  r in input.Item_Sales
											{
												itemTotal = itemTotal + ifnull(r.Line_Total,0);
											}
											sandAmt = 0;
											input.Amount_Supposed_To_Pay_Sand_Sales = round(sandAmt,2);
											input.Amount_Supposed_To_Pay_Item_Sales = round(itemTotal,2);
											input.Amount_Supposed_To_Pay = round(sandAmt + itemTotal,2);
											return;
										}
										// 1) Pick CBM based on selected Truck Size
										cbm = 0.0;
										if(input.Truck_Size == "Truck Size 1")
										{
											cbm = ifnull(input.Truck_Size_1,0.0);
										}
										else if(input.Truck_Size == "Truck Size 2")
										{
											cbm = ifnull(input.Truck_Size_2,0.0);
										}
										else
										{
											// Unexpected value - clear to be safe
											input.Truck_CBM = null;
											itemTotal = 0;
											for each  r in input.Item_Sales
											{
												itemTotal = itemTotal + ifnull(r.Line_Total,0);
											}
											sandAmt = 0;
											input.Amount_Supposed_To_Pay_Sand_Sales = round(sandAmt,2);
											input.Amount_Supposed_To_Pay_Item_Sales = round(itemTotal,2);
											input.Amount_Supposed_To_Pay = round(sandAmt + itemTotal,2);
											return;
										}
										// 2) Round CBM to 1 decimal point and set Truck_CBM
										input.Truck_CBM = round(cbm,1);
										// 3) Recalculate totals
										sand_total = ifnull(input.Rate_per_CBM,0) * ifnull(input.Truck_CBM,0);
										item_total = 0;
										for each  r in input.Item_Sales
										{
											item_total = item_total + ifnull(r.Line_Total,0);
										}
										input.Amount_Supposed_To_Pay_Sand_Sales = round(sand_total,2);
										input.Amount_Supposed_To_Pay_Item_Sales = round(item_total,2);
										input.Amount_Supposed_To_Pay = round(sand_total + item_total / 10000,2);
						)
					}
				}

			}
			On_Customer_Selected1 as "On Customer Selected"
			{
				type =  form
				form = Sand_Customer

				record event = on add or edit

