			On_Receipt_Officer_Daily_ as "On Receipt Officer Daily Voucher Selected"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on user input of Receipt_Officer_Voucher
				{
					actions 
					{
						custom deluge script
						(
											// Ensure voucher is selected
										if(input.Receipt_Officer_Voucher != null)
										{
											// Auto-fill Site from Voucher
											if(input.Receipt_Officer_Voucher.Site != null)
