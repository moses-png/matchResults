			On_Date_Time_Out_Selected1 as "On Date-Time Out Selected"
			{
				type =  form
				form = Voucher

				record event = on add or edit

				on user input of Date_Time_Out
				{
					actions 
					{
						custom deluge script
						(
											// Voucher → On Date_Time_Out
										// If cleared
										if(input.Date_Time_Out == null)
										{
											input.Hours_Worked = null;
											return;
										}
										// Must have In first
										if(input.Date_Time_In == null)
										{
											alert "Please enter Date-Time In first.";
											input.Date_Time_Out = null;
											input.Hours_Worked = null;
											return;
										}
										// Validate ordering
										if(input.Date_Time_Out < input.Date_Time_In)
										{
											alert "Date-Time Out cannot be earlier than Date-Time In.";
											input.Date_Time_Out = null;
											input.Hours_Worked = null;
											return;
										}
										// Compute hours
										ms = input.Date_Time_Out.toLong() - input.Date_Time_In.toLong();
										input.Hours_Worked = (ms / (1000.0 * 60.0 * 60.0)).round(2);
						)
					}
				}

			}
			Set_up_Form6 as "Set up Form"
			{
				type =  form
				form = Visitors_Register

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Detect mode
										is_create = input.ID == null;
										// ---------------------------------------
										// DISABLE FIELDS (always disabled fields)
										// ---------------------------------------
										disable Display_Name_Voucher;
										disable Time_In;
										disable Line_Number;
										disable Display_Name_Site;
										disable Reference;
										disable Line_Status;
										// ---------------------------------------
										// BACK END (disable audit fields)
										// ---------------------------------------
										disable User_Email;
										disable User_Name;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// ---------------------------------------
										// HIDE FIELDS (base / default)
										// ---------------------------------------
										hide Back_End;
										hide Display_Name_Voucher;
										hide Line_Number;
										hide Display_Name_Site;
										hide Reference;
										hide Line_Status;
										hide Exit_Pass;
										// ---------------------------------------
										// Logged-in user info
										// ---------------------------------------
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										email = ifnull(input.User_Email,"").toLowerCase();
										// "TABLE": prefix → site
										siteMap = Map();
										siteMap.put("phmaa001","Gomba Site - ARA075");
										siteMap.put("phmab001","Kakoni Site - ARA070");
										siteMap.put("phmac001","Freedom City Mall - ARA338");
										siteMap.put("xenotime","Gomba Site - ARA075");
										siteMap.put("phmae001","China Site - ARA073");
										siteMap.put("phmaf001","Seeta Site - ARA068");
										// Lookup + assign
										input.Display_Name_Site = null;
										// optional reset
										for each  prefix in siteMap.keys()
										{
											if(email.startsWith(prefix))
											{
												input.Display_Name_Site = siteMap.get(prefix);
												break;
											}
										}
										// Helper: Entry_By UI toggle (show/hide only)
										entry = ifnull(input.Entry_By,"").trim();
										if(entry == "")
										{
											hide Card;
											hide Gate_Pass;
										}
										else if(entry == "Gate Pass")
										{
											show Gate_Pass;
											hide Card;
										}
										else if(entry == "Card")
										{
											show Card;
											hide Gate_Pass;
										}
										else
										{
											hide Card;
											hide Gate_Pass;
										}
										// ===================================================
										// ON CREATE
										// ===================================================
										if(is_create)
										{
											// Hide Time In + Time Out on create
											hide Time_In;
											hide Time_Out;
											hide Exit_Pass;
											// On create, user can choose Entry_By and related field
											enable Voucher;
											enable Entry_By;
											enable Card;
											enable Gate_Pass;
										}
										// ===================================================
										// ON EDIT
										// ===================================================
										else
										{
											// -------------------------------
											// EDIT + Line Status = IN
											// -------------------------------
											if(input.Line_Status == "In")
											{
												// Lock entry fields
												disable Voucher;
												disable Entry_By;
												disable Card;
												disable Gate_Pass;
												disable Number_Plate;
												// Show checkout fields
												show Exit_Pass;
												show Time_Out;
												disable Time_Out;
											}
											// -------------------------------
											// EDIT + Line Status = OUT
											// -------------------------------
											else if(input.Line_Status == "Out")
											{
												// Out = can edit anything (entry fields enabled)
												enable Voucher;
												enable Entry_By;
												enable Card;
												enable Gate_Pass;
												disable Number_Plate;
												// Show sections/fields you want visible on Out
												show Gate_Pass_Section;
												// keep if this is your section link name
												show Exit_Pass;
												show Time_In;
												show Time_Out;
												// (Optional) If you want display fields visible on Out, uncomment:
												// show Display_Name_Voucher;
												// show Line_Number;
												// show Display_Name_Site;
												// show Reference;
												// show Line_Status;
											}
											else
											{
												// Safety: if Line_Status is blank or unexpected
												show Exit_Pass;
												show Time_Out;
											}
										}
						)
					}
				}

			}
