			Finalize_On_Delete6 as "Finalize On Delete"
			{
				type =  form
				form = Bill_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ====================================================
										// 1) Recalculate parent Bill totals AFTER delete
										// ====================================================
										if(input.Bill != null)
										{
											billRec = Bill[ID == input.Bill];
											if(billRec.ID != null)
											{
												total_amount = 0.0;
												bill_rows = Bill_Details[Bill == billRec.ID];
												for each  br in bill_rows
												{
													total_amount = total_amount + ifnull(br.Line_Total,0.0);
												}
												total_amount = round(total_amount,2);
												bill_total = round(ifnull(billRec.Bill_Total,0.0),2);
												tax_amount = round(ifnull(billRec.Tax_Amount,0.0),2);
												discount_amount = round(ifnull(billRec.Discount_Amount,0.0),2);
												amount_paid = round(ifnull(billRec.Amount_Paid,0.0),2);
												amount_due = round(total_amount + tax_amount - discount_amount,2);
												payment_status = "Not Paid";
												if(amount_paid <= 0)
												{
													payment_status = "Not Paid";
												}
												else if(amount_paid < amount_due)
												{
													payment_status = "Partially Paid";
												}
												else
												{
													payment_status = "Paid";
												}
												bill_status = "Draft";
												if(abs(bill_total - total_amount) <= 0.01 && total_amount > 0)
												{
													bill_status = "Billed";
												}
												billRec.Total_Amount=total_amount;
												billRec.Amount_Due=amount_due;
												billRec.Payment_Status=payment_status;
												billRec.Bill_Status=bill_status;
											}
										}
										// ====================================================
										// 2) Update Work Order Task billing status
										// ====================================================
										if(input.Parts_Consumables != null)
										{
											pc = Parts_Consumables[ID == input.Parts_Consumables];
											if(pc.ID != null && pc.Work_Order_Task_Number != null)
											{
												wot = Work_Order_Tasks[ID == pc.Work_Order_Task_Number];
												if(wot.ID != null)
												{
													all_billed = true;
													for each  r in wot.Parts_Consumables
													{
														row_has_bill = false;
														if(r.ID != null)
														{
															bd_list = Bill_Details[Parts_Consumables == r.ID];
															for each  bd in bd_list
															{
																if(bd.Bill != null)
																{
																	row_has_bill = true;
																	break;
																}
															}
														}
														if(row_has_bill == false)
														{
															all_billed = false;
															break;
														}
													}
													if(all_billed)
													{
														wot.Work_Order_Task_Status="Invoiced";
													}
													else
													{
														wot.Work_Order_Task_Status="Invoicing";
													}
												}
											}
										}
										// ====================================================
										// 3) Reverse Group Expense
										// ====================================================
										if(input.Group != null)
										{
											old_amount = round(ifnull(input.Line_Total,0.0),2);
											if(old_amount != 0)
											{
												payload = Map();
												payload.put("Group_ID",input.Group);
												payload.put("Amount_Delta",-1 * old_amount);
												payload.put("Source_Bill_Detail_ID",input.ID);
												if(input.Bill != null)
												{
													payload.put("Source_Bill_ID",input.Bill);
												}
												payload.put("Payment_Date",zoho.currentdate);
												resp = payment_management.createGroupExpenseFromAssetBill(payload);
												info resp;
											}
										}
										// ====================================================
										// 4) Update Fuel Receiving Voucher status AFTER delete
										// ====================================================
										if(input.Source == "Fuel Receiving Voucher")
										{
											if(input.Reference != null && input.Reference.trim() != "")
											{
												fuel_rec = Fuel_Receiving_Voucher[Fuel_Voucher == input.Reference];
												if(fuel_rec.ID != null)
												{
													bd_list = Bill_Details[Reference == input.Reference && Source == "Fuel Receiving Voucher"];
													has_bill = false;
													for each  bd in bd_list
													{
														if(bd.Bill != null)
														{
															has_bill = true;
															break;
														}
													}
													if(has_bill)
													{
														fuel_rec.Status="Billed";
													}
													else
													{
														fuel_rec.Status="Draft";
													}
												}
											}
										}
						)
					}
				}

			}
			Full_Validation9 as "Full Validation"
			{
				type =  form
				form = Bill

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ====================================================
										// Bill - Full Validation
										// ====================================================
										// 1) Required main fields
										if(input.Bill_Date == null)
										{
											alert "Bill Date is required.";
											cancel submit;
										}
										if(input.Vendor == null)
										{
											alert "Vendor is required.";
											cancel submit;
										}
										if(input.Bill_Name == null || input.Bill_Name.trim() == "")
										{
											alert "Bill Name is required.";
											cancel submit;
										}
										if(input.Bill_Number == null || input.Bill_Number.trim() == "")
										{
											alert "Bill Number is required.";
											cancel submit;
										}
										if(input.Bill_Total == null || input.Bill_Total < 0)
										{
											alert "Bill Total is required and must be 0 or greater.";
											cancel submit;
										}
										// 2) Recalculate Total Amount from Bill Details
										total_amount = 0.0;
										if(input.ID != null)
										{
											bill_rows = Bill_Details[Bill == input.ID];
											for each  br in bill_rows
											{
												total_amount = total_amount + ifnull(br.Line_Total,0.0);
											}
										}
										total_amount = round(total_amount,2);
										// 3) Normalize tax / discount / paid
										tax_amount = round(ifnull(input.Tax_Amount,0.0),2);
										discount_amount = round(ifnull(input.Discount_Amount,0.0),2);
										amount_paid = round(ifnull(input.Amount_Paid,0.0),2);
										if(tax_amount < 0)
										{
											alert "Tax Amount cannot be negative.";
											cancel submit;
										}
										if(discount_amount < 0)
										{
											alert "Discount Amount cannot be negative.";
											cancel submit;
										}
										if(amount_paid < 0)
										{
											alert "Amount Paid cannot be negative.";
											cancel submit;
										}
										// 4) Compute Amount Due
										amount_due = round(total_amount + tax_amount - discount_amount,2);
										if(amount_due < 0)
										{
											alert "Amount Due cannot be negative. Please check Total Amount, Tax Amount, and Discount Amount.";
											cancel submit;
										}
										// 5) Amount Paid cannot exceed Amount Due
										if(amount_paid > amount_due)
										{
											alert "Amount Paid cannot exceed Amount Due.";
											cancel submit;
										}
										// 6) Bill Total must match Total Amount before Bill can be Billed
										bill_total = round(ifnull(input.Bill_Total,0.0),2);
										if(abs(bill_total - total_amount) <= 0.01)
										{
											input.Bill_Status = "Billed";
										}
										else
										{
											input.Bill_Status = "Draft";
										}
										// 7) Payment Status
										if(amount_paid <= 0)
										{
											input.Payment_Status = "Not Paid";
										}
										else if(amount_paid < amount_due)
										{
											input.Payment_Status = "Partially Paid";
										}
										else
										{
											input.Payment_Status = "Paid";
										}
										// 8) Push computed values back
										input.Total_Amount = total_amount;
										input.Amount_Due = amount_due;
										input.Amount_Paid = amount_paid;
						)
					}
				}

			}
