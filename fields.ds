			Set_Up_Form3 as "Set Up Form"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// TRACTOR WORK REPORT -> SET UP FORM
										// ========================================
										// =======================
										// DISABLE FIELDS
										// =======================
										disable Display_Name_Voucher;
										disable Display_Name_Employee;
										disable Display_Name_Site;
										disable Display_Name_Asset;
										disable Line_Number;
										disable Work_Done;
										disable Time_Start;
										disable Time_End;
										disable Reason_Why_Cancelled;
										disable Line_Duration_Minutes;
										disable Line_Hours_Worked;
										disable Tractor_Work_Report_Status;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// =======================
										// HIDE FIELDS DEFAULT
										// =======================
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										hide Display_Name_Site;
										hide Display_Name_Asset;
										hide Card;
										hide Work_Order_Task;
										hide Batch_Number;
										hide Time_Start;
										hide Odometer_End;
										hide Time_End;
										hide Image_After;
										hide Cancelled;
										hide Reason_Why_Cancelled;
										hide Line_Summary;
										hide Cost_Per_Odometer;
										hide Total_Cost;
										hide Line_Duration_Minutes;
										hide Line_Hours_Worked;
										hide Tractor_Work_Report_Status;
										hide Back_End;
										hide Line_Number;
										// =======================
										// CREATE MODE
										// =======================
										if(input.ID == null)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											show Voucher;
											show Location;
											show Job;
											show Work_Done;
											show Odometer_Start;
											hide Card;
											hide Work_Order_Task;
											hide Batch_Number;
											hide Odometer_End;
											hide Time_Start;
											hide Time_End;
											hide Line_Duration_Minutes;
											hide Line_Hours_Worked;
											hide Tractor_Work_Report_Status;
										}
										// =======================
										// EDIT MODE
										// =======================
										else
										{
											show Voucher;
											show Line_Number;
											show Location;
											show Job;
											show Work_Done;
											show Odometer_Start;
											show Odometer_End;
											show Cancelled;
											show Tractor_Work_Report_Status;
											disable Voucher;
											disable Location;
											disable Job;
											disable Odometer_Start;
											// IMPORTANT: Control Work_Done properly
											if(input.Tractor_Work_Report_Status == "Completed")
											{
												disable Work_Done;
											}
											else
											{
												enable Work_Done;
											}
											if(input.Cancelled == true)
											{
												show Reason_Why_Cancelled;
											}
											// =======================
											// JOB-BASED SHOW / HIDE
											// =======================
											if(input.Job != null)
											{
												jobNo = input.Job.Job_No;
												if(jobNo == "TJS01")
												{
													show Card;
													show Batch_Number;
													enable Card;
													enable Batch_Number;
													hide Work_Order_Task;
												}
												else if(jobNo == "TJS02")
												{
													show Work_Order_Task;
													enable Work_Order_Task;
													hide Card;
													hide Batch_Number;
												}
												else if(jobNo == "TJS03")
												{
													show Batch_Number;
													enable Batch_Number;
													hide Card;
													hide Work_Order_Task;
												}
												else
												{
													hide Card;
													hide Work_Order_Task;
													hide Batch_Number;
												}
											}
											else
											{
												hide Card;
												hide Work_Order_Task;
												hide Batch_Number;
											}
											// =======================
											// STATUS: IN PROGRESS
											// =======================
											if(input.Tractor_Work_Report_Status == "In Progress")
											{
												disable Image_Before;
												hide Image_Before;
												disable Card;
												disable Batch_Number;
												disable Work_Done;
												show Image_After;
												show Odometer_End;
												show Time_End;
											}
											// =======================
											// STATUS: COMPLETED
											// =======================
											if(input.Tractor_Work_Report_Status == "Completed")
											{
												show Image_Before;
												show Image_After;
												show Odometer_End;
												show Time_Start;
												show Time_End;
												show Line_Duration_Minutes;
												show Line_Hours_Worked;
												disable Voucher;
												enable Location;
												enable Job;
												disable Odometer_Start;
												disable Odometer_End;
												disable Card;
												disable Work_Order_Task;
												disable Time_Start;
												disable Time_End;
											}
										}
						)
					}
				}

			}
			On_Cancelled_Selected as "On Cancelled Selected"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on user input of Cancelled
				{
