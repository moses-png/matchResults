				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Voucher
			(
				type = picklist	
				values  = Voucher_Register[Voucher_Status == "Issued" && Display_Name_Voucher_Type == "Cashier Voucher"].ID
    			bidirectional = Sales_Vouchers
    			displayformat = [Voucher_Number + " - " + Display_Name_Employee]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Site
			(
    			type = text
				displayname = "Display Name Site"
