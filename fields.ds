			Add_Row_Transfer_Vouchers as "Add Row Transfer Vouchers"
			{
				type =  form
				form = Asset_Transfer_Multiple_Voucher

				record event = on add or edit

				on add row of Transfer_Vouchers
				{
					actions 
					{
						custom deluge script
						(
											if(row != null)
										{
											row.Application=input.Document_Source;
											row.Voucher=input.Employee_Voucher;
											row.Asset_Transfer_Voucher=input.Asset_Transfer_Voucher;
											row.Display_Name_Asset_Transfer_Voucher=input.Display_Name_Asset_Transfer_Voucher;
											row.Transfer_Voucher_Date=input.Transfer_Voucher_Date;
											row.Site_From=input.Site_From;
											row.Details_From=input.Details_From;
											row.Custodian_From=input.Custodian_From;
											row.Transit_in_Charge_of=input.Transit_in_Charge_of;
											row.Notes_From=input.Notes_From;
											row.Site_To=input.Site_To;
											row.Details_To=input.Details_To;
											row.Custodian_To=input.Custodian_To;
											row.Notes_To=input.Notes_To;
											row.Received_By=input.Received_By;
											if(row.Asset != null)
											{
												asset_rec = Asset_List[ID == row.Asset];
												if(asset_rec.ID != null)
