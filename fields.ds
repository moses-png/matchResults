			Full_Validation18 as "Full Validation"
			{
				type =  form
				form = Vendor_Register

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Vendor_Type == null || input.Vendor_Type == "")
										{
											alert "Please select Vendor Type.";
											cancel submit;
										}
										if(input.Vendor_Type == "Cash")
										{
											if(input.Vendor_Name == null || input.Vendor_Name.trim() == "")
											{
												alert "Please enter Vendor Name.";
												cancel submit;
											}
											input.Vendor = null;
											input.Credit_Allowed = false;
											input.Credit_Limit = 0;
											input.Credit_Days_Allowed = 0;
											input.Current_Outstanding_Balance = 0;
											input.Available_Credit = 0;
											input.Credit_Status = "Good Standing";
										}
										if(input.Vendor_Type == "Credit")
										{
											if(input.Vendor == null)
											{
												alert "Please select Vendor.";
												cancel submit;
											}
											input.Vendor_Name = input.Vendor.Party_Name_ID;
											input.Display_Name_Vendor = input.Vendor.Party_Name_ID;
											input.Vendor_Code = "";
										}
										if(input.Vendor_Type == "Cash")
										{
											input.Display_Name_Vendor = input.Vendor_Name + " - " + input.Vendor_Code;
										}
										else if(input.Vendor_Type == "Credit")
										{
											input.Display_Name_Vendor = input.Vendor_Name;
										}
										if(input.Tax_Invoice_Required == true)
										{
											if(input.TIN_Number == null || input.TIN_Number.trim() == "")
											{
												alert "Please enter TIN Number because Tax Invoice is required.";
												cancel submit;
											}
										}
										else
										{
											input.TIN_Number = "";
										}
										input.Current_Outstanding_Balance = ifnull(input.Current_Outstanding_Balance,0);
										input.Credit_Limit = ifnull(input.Credit_Limit,0);
										input.Available_Credit = input.Credit_Limit - input.Current_Outstanding_Balance;
										if(input.Credit_Allowed == true)
										{
											if(input.Current_Outstanding_Balance > input.Credit_Limit)
											{
												input.Credit_Status = "Over Limit";
											}
											else
											{
												input.Credit_Status = "Good Standing";
											}
										}
										else
										{
											input.Credit_Status = "On Hold";
										}
						)
					}
				}

			}
			On_Amount_Allocated_Selec as "On Amount Allocated Selected"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on user input of Amount_Allocated
				{
					actions 
					{
						custom deluge script
						(
											amount_allocated = ifnull(input.Amount_Allocated,0.0);
										if(input.Payment_Receipt_Voucher != null)
										{
											voucher_total = ifnull(input.Payment_Receipt_Voucher.Total_Amount_Received,0.0);
											already_allocated = 0.0;
											for each  rec in Payment_Receipt_Details[Payment_Receipt_Voucher == input.Payment_Receipt_Voucher && ID != input.ID]
											{
												already_allocated = already_allocated + ifnull(rec.Amount_Allocated,0.0);
											}
											available = voucher_total - already_allocated;
											if(available < 0)
											{
												available = 0.0;
											}
											input.Amount_Not_Allocated = available;
											if(amount_allocated > available)
											{
												alert "Amount Allocated cannot exceed Amount Not Allocated. Available amount is: " + available;
												input.Amount_Allocated = available;
												amount_allocated = available;
											}
										}
						)
					}
				}

			}
			Full_Validation7 as "Full Validation"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// PAYMENT RECEIPT DETAILS VALIDATION
										// =====================================
										// -------------------------------------
										// Payment Receipt Voucher
										// -------------------------------------
										if(input.Payment_Receipt_Voucher == null)
										{
											alert "Please select Payment Receipt Voucher.";
											cancel submit;
										}
										// -------------------------------------
										// Sales Voucher
										// -------------------------------------
										if(input.Sales_Voucher == null)
										{
											alert "Please select Sales Voucher.";
											cancel submit;
										}
										// -------------------------------------
										// Amount Allocated
										// -------------------------------------
										if(input.Amount_Allocated == null || input.Amount_Allocated <= 0)
										{
											alert "Amount Allocated is required and must be greater than zero.";
											cancel submit;
										}
										// =====================================
										// AVAILABLE AMOUNT VALIDATION
										// =====================================
										available_amount = ifnull(input.Amount_Not_Allocated,0.0);
										previous_allocation = 0.0;
										// When editing, fetch the saved value from the database.
										if(input.ID != null)
										{
											existing_detail = Payment_Receipt_Details[ID == input.ID];
											if(existing_detail.ID != null)
											{
												previous_allocation = ifnull(existing_detail.Amount_Allocated,0.0);
											}
										}
										// Restore this record's existing allocation because it is already
										// excluded from Amount Not Allocated.
										available_amount = available_amount + previous_allocation;
										if(input.Amount_Allocated > available_amount)
										{
											alert "Amount Allocated cannot exceed the available amount of " + available_amount.toString();
											cancel submit;
										}
						)
					}
				}

			}
