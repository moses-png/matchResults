		 functions
		 {
			 Deluge
			 {
				 void closeIssueAndUpdateRoutineFromCleanSand(map payload)
                 {
                 	freedom_issue_id_val = payload.get("CleanSand_Issue_ID");
                 	if(freedom_issue_id_val == null)
                 	{
                 		info "AM routine update stopped: CleanSand_Issue_ID is null";
                 		return;
                 	}
                 	freedom_issue_id = freedom_issue_id_val.toLong();
                 	issue_number = ifnull(payload.get("Issue_Number"),"");
                 	latest_odo = payload.get("Odometer_Reading_Checked");
                 	issue_rec = null;
                 	issues = Asset_Issues[Source_Record_ID == freedom_issue_id && Source_Form == "Clean Sand Management - Asset Issues"];
                 	for each  i in issues
                 	{
                 		issue_rec = i;
                 		break;
                 	}
                 	if(issue_rec == null && issue_number != "")
                 	{
                 		issues_by_no = Asset_Issues[Issue_Number == issue_number];
                 		for each  i2 in issues_by_no
                 		{
                 			issue_rec = i2;
                 			break;
                 		}
                 	}
                 	if(issue_rec == null)
                 	{
                 		info "AM routine update stopped: matching Asset Issue not found for Clean Sand Issue ID " + freedom_issue_id + " / Issue Number " + issue_number;
                 		return;
                 	}
                 	issue_rec.Status="Closed";
                 	routine_rows = Routine_Issues[Open_Issue_ID == issue_rec.ID];
                 	for each  routine_rec in routine_rows
                 	{
                 		routine_rec.Open_Issue_ID=null;
                 		routine_rec.Last_Issue_Date=zoho.currentdate;
                 		routine_rec.Last_Done_Date=zoho.currentdate;
