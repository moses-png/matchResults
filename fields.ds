			On_Date_Time_In_Selected as "On Date-Time In Selected"
			{
				type =  form
				form = Voucher

				record event = on add or edit

				on user input of Date_Time_In
				{
					actions 
					{
						custom deluge script
						(
											// ---- CONFIGURE DAY WINDOW HERE ----
										START_DAY_HOUR = 6;
										// 06:00 inclusive
										END_DAY_HOUR = 18;
										// 18:00 exclusive
										// If Date-Time In is cleared, clear dependent fields
										if(input.Date_Time_In == null)
										{
											input.Shift = null;
											input.Hours_Worked = null;
										}
										else
										{
											// -------------------------
											// 1) Shift
											// -------------------------
											hr = input.Date_Time_In.toString("HH").toLong();
											if(hr >= START_DAY_HOUR && hr < END_DAY_HOUR)
											{
												input.Shift = "Day Shift";
											}
											else
											{
												input.Shift = "Night Shift";
											}
											// -------------------------
											// 2) Hours Worked (only if Out exists)
											// -------------------------
											if(input.Date_Time_Out != null)
											{
												// Validate ordering
												if(input.Date_Time_Out < input.Date_Time_In)
												{
													alert "Date-Time Out cannot be earlier than Date-Time In.";
													input.Date_Time_Out = null;
													input.Hours_Worked = null;
												}
												else
												{
													ms = input.Date_Time_Out.toLong() - input.Date_Time_In.toLong();
													input.Hours_Worked = (ms / (1000.0 * 60.0 * 60.0)).round(2);
												}
											}
											else
											{
												input.Hours_Worked = null;
											}
										}
						)
					}
				}

			}
			On_Employee_Selected as "On Employee Selected"
			{
				type =  form
				form = Voucher

				record event = on add or edit

				on user input of Employee
				{
					actions 
					{
						custom deluge script
						(
											if(input.Employee != null)
										{
											// UPDATED: no Employee_ID; use Employee Name - Employee Number
											if(input.Employee.Employee_Name != null && input.Employee.Employee_Number != null)
											{
												input.Display_Name_Employee = input.Employee.Employee_Name.trim() + " - " + input.Employee.Employee_Number.toString();
											}
											else
											{
												input.Display_Name_Employee = null;
											}
										}
										else
										{
											input.Display_Name_Employee = null;
										}
						)
					}
				}

			}
			Finalize1 as "Finalize"
			{
				type =  form
				form = Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// NOW TIME
										// =====================================================
										now_ts = zoho.currenttime;
										case_no = "";
										case_no_final = "";
										detailText = "";
										transport_dt = now_ts;
										// =====================================================
										// SAFE CANCEL CHECK
										// =====================================================
										cancel_now = false;
										if(input.Cancel_Voucher != null && input.Cancel_Voucher == true)
										{
											cancel_now = true;
										}
										// =====================================================
										// DEFAULT DATE TIME IN
										// =====================================================
										if(input.Date_Time_In == null)
										{
											input.Date_Time_In = now_ts;
										}
										// =====================================================
										// DETECT CREATE
										// =====================================================
										is_create = false;
										if(input.Added_Time != null && input.Modified_Time != null)
										{
											if(input.Added_Time.toLong() == input.Modified_Time.toLong())
											{
												is_create = true;
											}
										}
										// =====================================================
										// DEFAULT STATUS ON CREATE
										// =====================================================
										if(is_create)
										{
											input.Voucher_Status = "Issued";
										}
										// =====================================================
										// DISPLAY NAMES
										// =====================================================
										if(input.Issued_By != null)
										{
											input.Display_Name_Issued_By = input.Issued_By.Issued_By;
										}
										else
										{
											input.Display_Name_Issued_By = null;
										}
										if(input.Site != null)
										{
											input.Display_Name_Site = input.Site.Display_Name_Asset_Name;
										}
										else
										{
											input.Display_Name_Site = null;
										}
										if(input.Employee != null && input.Employee.Employee_Name != null && input.Employee.Employee_Number != null)
										{
											input.Display_Name_Employee = input.Employee.Employee_Name.trim() + " - " + input.Employee.Employee_Number.toString();
										}
										else
										{
											input.Display_Name_Employee = null;
										}
										// =====================================================
										// SHIFT
										// =====================================================
										if(input.Date_Time_In != null)
										{
											hr = input.Date_Time_In.toString("HH").toLong();
											if(hr >= 6 && hr < 18)
											{
												input.Shift = "Day Shift";
											}
											else
											{
												input.Shift = "Night Shift";
											}
										}
										else
										{
											input.Shift = null;
										}
										// =====================================================
										// EDIT FLOW
										// =====================================================
										if(!is_create)
										{
											oldRec = Voucher[ID == input.ID];
											original_status = "Issued";
											if(oldRec.ID != null)
											{
												original_status = ifnull(oldRec.Voucher_Status,"Issued");
											}
											if(original_status == "Cancelled")
											{
												return;
											}
											if(original_status == "Issued")
											{
												if(input.Date_Time_Out == null)
												{
													input.Date_Time_Out = now_ts;
												}
												if(input.Date_Time_In != null && input.Date_Time_Out != null)
												{
													ms = input.Date_Time_Out.toLong() - input.Date_Time_In.toLong();
													if(ms >= 0)
													{
														input.Hours_Worked = (ms / (1000.0 * 60.0 * 60.0)).round(2);
													}
													else
													{
														input.Hours_Worked = null;
													}
												}
												else
												{
													input.Hours_Worked = null;
												}
												if(input.Voucher_Type == "Supervisor Voucher")
												{
													input.Voucher_Status = "Closed";
												}
												else if(input.Voucher_Type == "Stock Bundling Note")
												{
													bad_rows = Stock_Bundling_Note[Voucher == input.ID && Stock_Status == "Pending" || Stock_Status == "Partially Received"];
													if(bad_rows.count() > 0 && input.Not_Created != true)
													{
														input.Voucher_Status = "Issued";
														info "Stock Bundling Note remains Issued because some rows are Pending or Partially Received.";
													}
													else
													{
														input.Voucher_Status = "Returned";
													}
												}
												else
												{
													input.Voucher_Status = "Returned";
												}
											}
											else if(original_status == "Closed")
											{
												if(cancel_now == true)
												{
													input.Voucher_Status = "Cancelled";
													Cancelled_By = zoho.loginuser;
													Cancelled_Time = now_ts;
													return;
												}
												if(input.Voucher_Type == "Supervisor Voucher")
												{
													if(input.Manager_Time == null)
													{
														input.Manager_Time = now_ts;
													}
													if(input.Time_Sent_to_Head_Office == null)
													{
														input.Time_Sent_to_Head_Office = now_ts;
													}
													case_no = ifnull(input.Case_Number,"").trim();
													case_no_final = case_no;
													if(case_no != "")
													{
														attached_count = 0;
														detailText = "";
														transport_dt = input.Time_Sent_to_Head_Office;
														attachedVouchers = Voucher[Issued_By.Voucher_Number == input.Voucher_Number];
														for each  av in attachedVouchers
														{
															av.Case_Number=case_no;
															attached_count = attached_count + 1;
															detailText = detailText + ifnull(av.Voucher_Number,"") + " - " + ifnull(av.Voucher_Type,"") + " - " + ifnull(av.Display_Name_Employee,"") + "\n";
														}
														total_vouchers = attached_count + 1;
														employee_take_name = "";
														if(input.Employee_Taking_To_Head_Office != null)
														{
															employee_take_name = ifnull(input.Employee_Taking_To_Head_Office.Employee_Name,"") + " - " + ifnull(input.Employee_Taking_To_Head_Office.Employee_Number,"");
														}
														u = thisapp.audit.getLoginAuditInfo();
														existingTR = Voucher_Transfer_Register[Case_Number == case_no];
														if(existingTR.ID != null)
														{
															existingTR.Transport_Date=transport_dt;
															existingTR.How_To_Take_To_Head_Office=ifnull(input.How_to_Take_to_Head_Office,"");
															existingTR.From_Site=ifnull(input.Display_Name_Site,"");
															existingTR.Employee_Taking_To_Head_Office=employee_take_name;
															existingTR.To_Site="Freedom City - Head Office";
															existingTR.Number_Of_Vouchers=total_vouchers;
															existingTR.Source_Form="Employee Management - Voucher";
															existingTR.Source_Record_ID=input.ID;
															existingTR.Case_Status="In Transit";
															existingTR.User_Name=u.get("name");
															existingTR.User_Email=u.get("email");
															existingTR.User_Role=u.get("role");
															existingTR.Updated_By_Name=u.get("name");
															existingTR.Updated_By_Email=u.get("email");
															existingTR.Updated_By_Time=now_ts;
														}
														else
														{
															insert into Voucher_Transfer_Register
															[
																Case_Number=case_no
																Transport_Date=transport_dt
																How_To_Take_To_Head_Office=ifnull(input.How_to_Take_to_Head_Office,"")
																From_Site=ifnull(input.Display_Name_Site,"")
																Employee_Taking_To_Head_Office=employee_take_name
																To_Site="Freedom City - Head Office"
																Number_Of_Vouchers=total_vouchers
																Source_Form="Employee Management - Voucher"
																Source_Record_ID=input.ID
																Case_Status="In Transit"
																User_Name=u.get("name")
																User_Email=u.get("email")
																User_Role=u.get("role")
																Created_By_Name=u.get("name")
																Created_By_Email=u.get("email")
																Created_By_Time=now_ts
																Added_User=zoho.loginuser
															]
														}
													}
													if(input.How_to_Take_to_Head_Office == "Transport Required")
													{
														if(input.Employee_Taking_To_Head_Office != null)
														{
															refVal = input.Voucher_Number + " - " + input.Employee_Taking_To_Head_Office.Employee_Name + " - " + input.Employee_Taking_To_Head_Office.Employee_Number;
															existingBD = Bill_Details[Reference == refVal && Source_Record_ID == input.ID && Source_Form == "Employee Management - Supervisor Voucher"];
															if(existingBD.count() == 0)
															{
																if(detailText == null || detailText == "")
																{
																	detailText = "";
																	issuedVouchers = Voucher[Issued_By.Voucher_Number == input.Voucher_Number];
																	for each  v in issuedVouchers
																	{
																		detailText = detailText + ifnull(v.Voucher_Number,"") + " - " + ifnull(v.Voucher_Type,"") + " - " + ifnull(v.Display_Name_Employee,"") + "\n";
																	}
																}
																insert into Bill_Details
																[
																	Details_Date=input.Time_Sent_to_Head_Office.toDate()
																	Reference=refVal
																	Details=detailText
																	Expense_Type="Document Transport"
																	Quantity=1.00
																	Source="Supervisor"
																	Source_Record_ID=input.ID
																	Source_Form="Employee Management - Supervisor Voucher"
																	Account=input.Display_Name_Site
																	Current_Site=input.Display_Name_Site
																	Bill_Details_Status="Draft"
																	Added_User=zoho.loginuser
																]
															}
														}
													}
													input.Voucher_Status = "Head Office";
												}
											}
											else if(original_status == "Returned")
											{
												if(cancel_now == true)
												{
													input.Voucher_Status = "Cancelled";
													Cancelled_By = zoho.loginuser;
													Cancelled_Time = now_ts;
													return;
												}
												if(input.Manager_Time == null)
												{
													input.Manager_Time = now_ts;
												}
												input.Voucher_Status = "Head Office";
											}
											else if(original_status == "Head Office")
											{
												if(input.Time_Checked == null)
												{
													input.Time_Checked = now_ts;
												}
												if(input.Seen == true)
												{
													input.Reason_for_not_Seen = null;
													input.Voucher_Status = "Human Resource";
												}
												else
												{
													if(input.Reason_for_not_Seen == null || input.Reason_for_not_Seen.trim() == "")
													{
														input.Voucher_Status = "Head Office";
														return;
													}
													else
													{
														input.Voucher_Status = "Human Resource";
													}
												}
											}
											else if(original_status == "Human Resource")
											{
												if(input.Hr_Time_Checked == null)
												{
													input.Hr_Time_Checked = now_ts;
												}
												if(input.Employee != null)
												{
													vDate = zoho.currentdate;
													if(input.Date_Time_In != null)
													{
														vDate = input.Date_Time_In.toDate();
													}
													sourceVal = ifnull(input.Display_Name_Employee,"").trim();
													accountVal = ifnull(input.Display_Name_Site,"").trim();
													siteVal = ifnull(input.Display_Name_Site,"").trim();
													if(accountVal == "")
													{
														accountVal = "Unassigned Account";
													}
													empName = ifnull(input.Employee.Employee_Name,"").trim();
													billVendor = input.Employee;
													billName = empName;
													empStatus = Employment_Status[Employee == input.Employee && Employment_Status == "Active"];
													dailyAllowance = 0.0;
													weeklyAllowance = 0.0;
													monthlySalary = 0.0;
													if(empStatus.ID != null)
													{
														dailyAllowance = ifnull(empStatus.Daily_Allowance,0.0);
														weeklyAllowance = ifnull(empStatus.Weekly_Allowance,0.0);
														monthlySalary = ifnull(empStatus.Monthly_Salary,0.0);
													}
													billPeriod = "";
													if(dailyAllowance > 0 || weeklyAllowance > 0)
													{
														billPeriod = "Weekly";
													}
													else if(monthlySalary > 0)
													{
														billPeriod = "Monthly";
													}
													if(billPeriod != "")
													{
														billDate = vDate;
														billNumber = "";
														if(billPeriod == "Weekly")
														{
															weekDate = vDate;
															dayNum = weekDate.getDayOfWeek();
															daysToMonday = 0;
															if(dayNum == 1)
															{
																daysToMonday = 1;
															}
															else if(dayNum == 2)
															{
																daysToMonday = 0;
															}
															else if(dayNum == 3)
															{
																daysToMonday = -1;
															}
															else if(dayNum == 4)
															{
																daysToMonday = -2;
															}
															else if(dayNum == 5)
															{
																daysToMonday = -3;
															}
															else if(dayNum == 6)
															{
																daysToMonday = -4;
															}
															else if(dayNum == 7)
															{
																daysToMonday = -5;
															}
															billDate = weekDate.addDay(daysToMonday);
															weekNo = billDate.getWeekOfYear();
															weekTxt = weekNo.toString();
															if(weekNo < 10)
															{
																weekTxt = "0" + weekTxt;
															}
															billNumber = billDate.getYear().toString() + " Week " + weekTxt;
														}
														else if(billPeriod == "Monthly")
														{
															monthTxt = vDate.toString("MM");
															yearTxt = vDate.toString("yyyy");
															billDate = vDate;
															billNumber = yearTxt + " Month " + monthTxt;
														}
														employeeBill = null;
														existingBill = Bill[Vendor == billVendor && Bill_Number == billNumber];
														if(existingBill.ID != null)
														{
															employeeBill = existingBill;
														}
														else
														{
															insert into Bill
															[
																Bill_Date=billDate
																Vendor=billVendor
																Bill_Name=billName
																Bill_Number=billNumber
																Bill_Status="Draft"
																Payment_Status="Not Paid"
																Added_User=zoho.loginuser
															]
															employeeBill = Bill[Vendor == billVendor && Bill_Number == billNumber];
														}
														if(ifnull(input.Voucher_Type,"").trim() == "Truck Movement Voucher")
														{
															if(employeeBill.ID != null)
															{
																lineNo = 0;
																for each  tmv in input.Truck_Movement_Details
																{
																	lineNo = lineNo + 1;
																	refVal = input.Voucher_Number + " - " + lineNo.toString();
																	existingBD = Bill_Details[Bill == employeeBill.ID && Reference == refVal && Source_Form == "Employee Management - Voucher" && Expense_Type == billPeriod + "Payment"];
																	if(existingBD.count() == 0)
																	{
																		detailText = "";
																		if(tmv.Work_Order_Task != null)
																		{
																			detailText = detailText + "Job Type: Service Task";
																			detailText = detailText + "\nJob: " + ifnull(tmv.Job.Job_No,"") + " - " + ifnull(tmv.Job.Job_Name,"");
																			detailText = detailText + "\nWork Order Task: " + ifnull(tmv.Work_Order_Task.Work_Order_Task_Number,"");
																			detailText = detailText + "\nTask Description: " + ifnull(tmv.Work_Order_Task.Task_Description,"");
																			detailText = detailText + "\nWork Done: " + ifnull(tmv.Work_Done,"");
																		}
																		else if(tmv.Batch_Number_From != null || ifnull(tmv.Job.Job_Name,"").contains("Stock Production"))
																		{
																			detailText = detailText + "Job Type: Stock Production";
																			detailText = detailText + "\nJob: " + ifnull(tmv.Job.Job_No,"") + " - " + ifnull(tmv.Job.Job_Name,"");
																			detailText = detailText + "\nWork Done: " + ifnull(tmv.Work_Done,"");
																			if(tmv.Tractor_Work_Report != null)
																			{
																				detailText = detailText + "\nTractor Work Report: " + ifnull(tmv.Tractor_Work_Report.Display_Name_Voucher,"") + " - " + ifnull(tmv.Tractor_Work_Report.Line_Number,"").toString();
																			}
																			if(tmv.Batch_Number_From != null)
																			{
																				detailText = detailText + "\nBatch Number From: " + ifnull(tmv.Batch_Number_From.Batch_Number,"");
																			}
																		}
																		else if(tmv.Job != null)
																		{
																			detailText = detailText + "Job Type: " + ifnull(tmv.Job.Job_Name,"");
																			detailText = detailText + "\nJob: " + ifnull(tmv.Job.Job_No,"") + " - " + ifnull(tmv.Job.Job_Name,"");
																			detailText = detailText + "\nWork Done: " + ifnull(tmv.Work_Done,"");
																		}
																		else
																		{
																			detailText = detailText + "Job Type: Truck Movement";
																			detailText = detailText + "\nWork Done: " + ifnull(tmv.Work_Done,"");
																		}
																		detailText = detailText + "\nNumber Plate: " + ifnull(tmv.Number_Plate_Truck_Register,"");
																		detailText = detailText + "\nPick Up From: " + ifnull(tmv.Pick_Up_From,"");
																		detailText = detailText + "\nDelivery To: " + ifnull(tmv.Delivery_To,"");
																		detailText = detailText + "\nOdometer Start: " + ifnull(tmv.Odometer_Start,0).toString();
																		detailText = detailText + "\nOdometer End: " + ifnull(tmv.Odometer_End,0).toString();
																		detailText = detailText + "\nDistance: " + ifnull(tmv.Line_Distance_Travelled,0).toString();
																		insert into Bill_Details
																		[
																			Bill=employeeBill.ID
																			Display_Name_Bill=input.Employee.Employee_Name + " - " + billNumber
																			Details_Date=vDate
																			Source=sourceVal
																			Reference=refVal
																			Details=detailText
																			Expense_Type=billPeriod + "Payment"
																			Quantity=1.00
																			Account=accountVal
																			Current_Site=siteVal
																			Source_Record_ID=input.ID
																			Source_Form="Employee Management - Voucher"
																			Bill_Details_Status="Draft"
																			Added_User=zoho.loginuser
																		]
																	}
																}
															}
														}
													}
												}
												input.Voucher_Status = "Audited";
											}
										}
										// =====================================================
										// CLOSE VOUCHER TRANSFER REGISTER IF ALL CASE VOUCHERS MOVED FROM HEAD OFFICE
										// =====================================================
										case_no_final = ifnull(input.Case_Number,"").trim();
										if(case_no_final != "")
										{
											still_at_head_office = 0;
											case_vouchers = Voucher[Case_Number == case_no_final];
											for each  cv in case_vouchers
											{
												if(cv.ID == input.ID)
												{
													if(input.Voucher_Status == "Head Office")
													{
														still_at_head_office = still_at_head_office + 1;
													}
												}
												else
												{
													if(cv.Voucher_Status == "Head Office")
													{
														still_at_head_office = still_at_head_office + 1;
													}
												}
											}
											tr_list = Voucher_Transfer_Register[Case_Number == case_no_final && Case_Status == "In Transit"];
											for each  tr in tr_list
											{
												if(still_at_head_office == 0)
												{
													tr.Case_Status="Closed";
												}
												else
												{
													tr.Case_Status="In Transit";
												}
											}
										}
										// =====================================================
										// RECALCULATE VOUCHER COSTS / QUANTITIES
										// =====================================================
										if(input.ID != null)
										{
											thisapp.recalculateVoucherMaterialsCost(input.ID);
											thisapp.updateVoucherQuantityCreated(input.ID);
											if(case_no_final != "")
											{
												thisapp.updateVoucherTransferRegisterCount(case_no_final,transport_dt.toDate());
											}
										}
										// =====================================================
										// EMPLOYEE VOUCHER -> CONCRETE VOUCHER SYNC
										// =====================================================
										if(input.Source_Record_ID != null && input.Source_Form == "Concrete Products - Voucher Register")
										{
											date_time_out_txt = "";
											end_time_txt = "";
											manager_time_txt = "";
											time_checked_txt = "";
											hr_time_checked_txt = "";
											if(input.Date_Time_Out != null)
											{
												date_time_out_txt = input.Date_Time_Out.toString("dd-MMM-yyyy HH:mm:ss");
											}
											if(input.End_Time != null)
											{
												end_time_txt = input.End_Time.toString("dd-MMM-yyyy HH:mm:ss");
											}
											if(input.Manager_Time != null)
											{
												manager_time_txt = input.Manager_Time.toString("dd-MMM-yyyy HH:mm:ss");
											}
											if(input.Time_Checked != null)
											{
												time_checked_txt = input.Time_Checked.toString("dd-MMM-yyyy HH:mm:ss");
											}
											if(input.Hr_Time_Checked != null)
											{
												hr_time_checked_txt = input.Hr_Time_Checked.toString("dd-MMM-yyyy HH:mm:ss");
											}
											payload = Map();
											payload.put("Concrete_Record_ID",input.Source_Record_ID);
											payload.put("Source_Record_ID",input.ID);
											payload.put("Source_Form","Employee Management - Voucher");
											payload.put("Date_Time_Out",date_time_out_txt);
											payload.put("Hours_Worked",input.Hours_Worked);
											payload.put("Voucher_Status",ifnull(input.Voucher_Status,""));
											payload.put("End_Time",end_time_txt);
											payload.put("Odometer_End",input.Odometer_End);
											payload.put("Fuel_End_Level",input.Fuel_End_Level);
											payload.put("Manager_Time",manager_time_txt);
											payload.put("Cancel_Voucher",input.Cancel_Voucher);
											payload.put("Cancellation_Reason",ifnull(input.Cancellation_Reason,""));
											payload.put("Seen",input.Seen);
											payload.put("Reason_for_not_Seen",ifnull(input.Reason_for_not_Seen,""));
											payload.put("Time_Checked",time_checked_txt);
											payload.put("Hr_Time_Checked",hr_time_checked_txt);
											sync_resp = concrete_products_management.syncVoucherFromEmployee(payload);
											info sync_resp;
										}
						)
					}
				}

			}
			On_Site_Selected2 as "On Site Selected"
			{
				type =  form
				form = Employee_Register

				record event = on add or edit

				on user input of Site_Assigned.Site
				{
					actions 
					{
						custom deluge script
						(
											if(row != null)
										{
											// 1) Display Name - Site
											if(row.Site != null)
											{
												row.Display_Name_Site=row.Site.Display_Name_Asset_Name;
											}
											else
											{
												row.Display_Name_Site=null;
											}
											// 2) Ensure this row is tied to the parent Employee
											if(row.Employee == null && input.ID != null)
											{
												row.Employee=input.ID;
											}
											// 3) Display Name - Employee (Employee_Name_ID from Employee form)
											if(row.Employee != null)
											{
												row.Display_Name_Employee=row.Employee.Employee_Name + " - " + row.Employee.Employee_Number;
											}
											else
											{
												row.Display_Name_Employee=null;
											}
											// 4) Sync Employment Status from Employee header into this Site_Assigned row
											if(input.Employment_Status != null)
											{
												row.Employment_Status=input.Employment_Status;
											}
											else
											{
												// if header is empty, you can either leave null,
												// or later extend this to derive from Employee_Status_Details
												row.Employment_Status=null;
											}
										}
						)
					}
				}

			}
