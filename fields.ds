			Set_Up_Form21 as "Set Up Form"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// TRUCK MOVEMENT VOUCHER - ON LOAD
										// ======================================
										is_create = input.ID == null;
										// =======================
										// 1. DISABLE DISPLAY / AUTO FIELDS
										// =======================
										disable Display_Name_Voucher;
										disable Display_Name_Employee;
										disable Display_Name_Site;
										disable Display_Name_Asset;
										disable Line_Number;
										disable Number_Plate_Truck_Register;
										disable Work_Done;
										//Pick Up Section
										disable Display_Name_Party_From;
										disable Display_Name_Site_From;
										disable Pick_Up_From;
										disable Time_Start;
										//Delivery Section
										disable Display_Name_Party_To;
										disable Display_Name_Site_To;
										disable Delivery_To;
										disable Time_End;
										disable Reason_Why_Cancelled;
										disable Truck_Movement_Voucher_Status;
										//Line Summary
										disable Cost_Per_Odometer;
										disable Total_Cost;
										disable Line_Duration_Minutes;
										disable Line_Distance_Travelled;
										//Back End
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// =======================
										// 2. DEFAULT HIDE SECTIONS / JOB FIELDS
										// =======================
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										hide Display_Name_Site;
										hide Display_Name_Asset;
										hide Line_Number;
										hide Number_Plate_Truck_Register;
										hide Card;
										hide Work_Order_Task;
										hide Batch_Number_From;
										hide Truck_Movement_Voucher;
										hide Task_Location;
										hide Small_Notes;
										//Pick Up Section
										hide Pick_Up_Section;
										hide Display_Name_Party_From;
										hide Display_Name_Site_From;
										hide Time_Start;
										//Delivery Section
										hide Delivery_Section;
										hide Display_Name_Party_To;
										hide Display_Name_Site_To;
										hide Time_End;
										//Line Summary
										hide Line_Summary;
										//Back End
										hide Back_End;
										// =======================
										// 3. JOB CONTROL
										// =======================
										if(input.Job != null)
										{
											jobNo = input.Job.Job_No;
											if(jobNo == "TJS01")
											{
												show Pick_Up_Section;
												show Card;
												enable Card;
												hide Work_Order_Task;
												hide Batch_Number_From;
												hide Truck_Movement_Voucher;
												hide Task_Location;
												hide Small_Notes;
												if(is_create)
												{
													input.Work_Order_Task = null;
													input.Batch_Number_From = null;
													input.Truck_Movement_Voucher = null;
													input.Task_Location = null;
													input.Small_Notes = null;
													input.Party_From = null;
													input.Party_Location_From = null;
													input.Site_To = null;
													input.Site_Location_To = null;
												}
												show Site_From;
												show Site_Location_From;
												disable Site_From;
												enable Site_Location_From;
												hide Party_From;
												hide Party_Location_From;
												show Party_To;
												show Party_Location_To;
												enable Party_To;
												enable Party_Location_To;
												hide Site_To;
												hide Site_Location_To;
											}
											else if(jobNo == "TJS02")
											{
												show Pick_Up_Section;
												show Work_Order_Task;
												enable Work_Order_Task;
												show Task_Location;
												enable Task_Location;
												show Small_Notes;
												enable Small_Notes;
												hide Card;
												hide Batch_Number_From;
												hide Truck_Movement_Voucher;
												if(is_create)
												{
													input.Card = null;
													input.Batch_Number_From = null;
													input.Truck_Movement_Voucher = null;
													input.Party_To = null;
													input.Party_Location_To = null;
												}
												// Pickup depends on Task Location
												if(input.Task_Location == "Suppliers")
												{
													show Party_From;
													show Party_Location_From;
													enable Party_From;
													enable Party_Location_From;
													hide Site_From;
													hide Site_Location_From;
													if(is_create)
													{
														input.Site_From = null;
														input.Site_Location_From = null;
													}
												}
												else
												{
													show Site_From;
													show Site_Location_From;
													enable Site_From;
													enable Site_Location_From;
													hide Party_From;
													hide Party_Location_From;
													if(is_create)
													{
														input.Party_From = null;
														input.Party_Location_From = null;
													}
												}
												// Delivery is Site To
												show Site_To;
												show Site_Location_To;
												enable Site_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
											}
											else if(jobNo == "TJS03")
											{
												show Pick_Up_Section;
												show Batch_Number_From;
												show Tractor_Work_Report;
												hide Card;
												hide Work_Order_Task;
												hide Truck_Movement_Voucher;
												hide Task_Location;
												hide Small_Notes;
												if(is_create)
												{
													input.Card = null;
													input.Work_Order_Task = null;
													input.Truck_Movement_Voucher = null;
													input.Task_Location = null;
													input.Small_Notes = null;
													input.Party_From = null;
													input.Party_Location_From = null;
													input.Party_To = null;
													input.Party_Location_To = null;
												}
												show Site_From;
												disable Site_From;
												show Site_Location_From;
												enable Site_Location_From;
												hide Party_From;
												hide Party_Location_From;
												show Site_To;
												disable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
											}
											else if(jobNo == "TJS04")
											{
												show Pick_Up_Section;
												show Truck_Movement_Voucher;
												enable Truck_Movement_Voucher;
												hide Card;
												hide Work_Order_Task;
												hide Batch_Number_From;
												hide Task_Location;
												show Small_Notes;
												enable Small_Notes;
												if(is_create)
												{
													input.Card = null;
													input.Work_Order_Task = null;
													input.Batch_Number_From = null;
													input.Task_Location = null;
													input.Site_From = null;
													input.Site_Location_From = null;
													input.Party_To = null;
													input.Party_Location_To = null;
												}
												show Party_From;
												disable Party_From;
												show Party_Location_From;
												enable Party_Location_From;
												hide Site_From;
												hide Site_Location_From;
												show Site_To;
												enable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
											}
										}
										else
										{
											hide Pick_Up_Section;
											hide Delivery_Section;
											hide Line_Summary;
											hide Card;
											hide Work_Order_Task;
											hide Batch_Number_From;
											hide Truck_Movement_Voucher;
											hide Task_Location;
											hide Small_Notes;
											if(is_create)
											{
												input.Card = null;
												input.Work_Order_Task = null;
												input.Batch_Number_From = null;
												input.Truck_Movement_Voucher = null;
												input.Task_Location = null;
												input.Small_Notes = null;
											}
										}
										// =======================
										// 4. CREATE MODE
										// SHOW PICKUP ONLY
										// =======================
										if(is_create)
										{
											hide Delivery_Section;
											hide Party_To;
											hide Party_Location_To;
											hide Site_To;
											hide Site_Location_To;
											hide Delivery_To;
											hide Odometer_End;
											hide Time_End;
											hide Delivery_To_Image;
											hide Cancelled;
											hide Reason_Why_Cancelled;
											hide Truck_Movement_Voucher_Status;
											hide Line_Summary;
										}
										// =======================
										// 5. EDIT MODE BY STATUS
										// =======================
										else
										{
											if(input.Truck_Movement_Voucher_Status == "In Progress")
											{
												disable Voucher;
												disable Job;
												disable Card;
												disable Work_Done;
												disable Odometer_Start;
												disable Pick_Up_Image;
												show Pick_Up_Section;
												show Delivery_Section;
												if(input.Job != null)
												{
													jobNo2 = input.Job.Job_No;
													if(jobNo2 == "TJS01")
													{
														hide Task_Location;
														hide Small_Notes;
														show Party_To;
														show Party_Location_To;
														enable Party_To;
														enable Party_Location_To;
														hide Site_To;
														hide Site_Location_To;
														disable Site_Location_From;
													}
													else if(jobNo2 == "TJS02")
													{
														show Work_Order_Task;
														disable Work_Order_Task;
														show Task_Location;
														disable Task_Location;
														show Small_Notes;
														disable Small_Notes;
														// Pickup depends on Task Location
														if(input.Task_Location == "Suppliers")
														{
															show Party_From;
															show Party_Location_From;
															disable Party_From;
															disable Party_Location_From;
															hide Site_From;
															hide Site_Location_From;
														}
														else
														{
															show Site_From;
															show Site_Location_From;
															disable Site_From;
															disable Site_Location_From;
															hide Party_From;
															hide Party_Location_From;
														}
														// Delivery is Site To
														show Site_To;
														show Site_Location_To;
														enable Site_To;
														enable Site_Location_To;
														hide Party_To;
														hide Party_Location_To;
													}
													else if(jobNo2 == "TJS03")
													{
														hide Task_Location;
														hide Small_Notes;
														show Batch_Number_From;
														disable Batch_Number_From;
														show Site_From;
														disable Site_From;
														show Site_Location_From;
														disable Site_Location_From;
														show Batch_Number_To;
														show Site_To;
														disable Site_To;
														show Site_Location_To;
														enable Site_Location_To;
														hide Party_To;
														hide Party_Location_To;
														hide Party_From;
														hide Party_Location_From;
													}
													else if(jobNo2 == "TJS04")
													{
														show Truck_Movement_Voucher;
														disable Truck_Movement_Voucher;
														show Small_Notes;
														disable Small_Notes;
														show Party_From;
														disable Party_From;
														show Party_Location_From;
														disable Party_Location_From;
														hide Site_From;
														hide Site_Location_From;
														show Site_To;
														enable Site_To;
														show Site_Location_To;
														enable Site_Location_To;
														hide Party_To;
														hide Party_Location_To;
													}
												}
												show Odometer_End;
												show Delivery_To_Image;
												show Cancelled;
												enable Cancelled;
												hide Reason_Why_Cancelled;
												hide Line_Summary;
											}
											else if(input.Truck_Movement_Voucher_Status == "Completed")
											{
												show Pick_Up_Section;
												show Delivery_Section;
												show Line_Summary;
												hide Reason_Why_Cancelled;
												if(input.Job != null && input.Job.Job_No == "TJS02")
												{
													show Task_Location;
													show Small_Notes;
													disable Task_Location;
													disable Small_Notes;
													if(input.Task_Location == "Suppliers")
													{
														show Party_From;
														show Party_Location_From;
														disable Party_From;
														disable Party_Location_From;
														hide Site_From;
														hide Site_Location_From;
													}
													else
													{
														show Site_From;
														show Site_Location_From;
														disable Site_From;
														disable Site_Location_From;
														hide Party_From;
														hide Party_Location_From;
													}
												}
												else if(input.Job != null && input.Job.Job_No == "TJS04")
												{
													show Truck_Movement_Voucher;
													disable Truck_Movement_Voucher;
													show Small_Notes;
													disable Small_Notes;
												}
												else
												{
													hide Task_Location;
													hide Small_Notes;
												}
												disable Job;
												disable Card;
												disable Work_Order_Task;
												disable Batch_Number_From;
												disable Truck_Movement_Voucher;
												disable Work_Done;
												disable Task_Location;
												disable Small_Notes;
												disable Party_From;
												disable Party_Location_From;
												disable Site_From;
												disable Site_Location_From;
												disable Party_To;
												disable Party_Location_To;
												disable Site_To;
												disable Site_Location_To;
												disable Odometer_Start;
												disable Time_Start;
												disable Pick_Up_Image;
												disable Odometer_End;
												disable Time_End;
												disable Delivery_To_Image;
												show Cancelled;
												disable Cancelled;
												disable Truck_Movement_Voucher_Status;
											}
											else if(input.Truck_Movement_Voucher_Status == "Cancelled")
											{
												show Pick_Up_Section;
												show Delivery_Section;
												show Reason_Why_Cancelled;
												show Cancelled;
												if(input.Job != null && input.Job.Job_No == "TJS02")
												{
													show Task_Location;
													show Small_Notes;
													disable Task_Location;
													disable Small_Notes;
													if(input.Task_Location == "Suppliers")
													{
														show Party_From;
														show Party_Location_From;
														disable Party_From;
														disable Party_Location_From;
														hide Site_From;
														hide Site_Location_From;
													}
													else
													{
														show Site_From;
														show Site_Location_From;
														disable Site_From;
														disable Site_Location_From;
														hide Party_From;
														hide Party_Location_From;
													}
												}
												else if(input.Job != null && input.Job.Job_No == "TJS04")
												{
													show Truck_Movement_Voucher;
													disable Truck_Movement_Voucher;
													show Small_Notes;
													disable Small_Notes;
												}
												else
												{
													hide Task_Location;
													hide Small_Notes;
												}
												disable Cancelled;
												disable Job;
												disable Card;
												disable Work_Order_Task;
												disable Batch_Number_From;
												disable Truck_Movement_Voucher;
												disable Work_Done;
												disable Task_Location;
												disable Small_Notes;
												disable Party_From;
												disable Party_Location_From;
												disable Site_From;
												disable Site_Location_From;
												disable Party_To;
												disable Party_Location_To;
												disable Site_To;
												disable Site_Location_To;
												disable Odometer_Start;
												disable Time_Start;
												disable Pick_Up_Image;
												disable Odometer_End;
												disable Time_End;
												disable Delivery_To_Image;
												disable Reason_Why_Cancelled;
												disable Truck_Movement_Voucher_Status;
												hide Line_Summary;
											}
										}
						)
					}
				}

			}
			Full_Validation18 as "Full Validation"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// TRUCK MOVEMENT VOUCHER
										// FULL VALIDATION - CREATE OR EDIT
										errors = "";
										// =======================
										// 1. JOB REQUIRED
										// =======================
										if(input.Job == null)
										{
											errors = errors + "\n• Job is required.";
										}
										else
										{
											jobNo = input.Job.Job_No;
											if(jobNo == "TJS01")
											{
												if(input.Card == null)
												{
													errors = errors + "\n• Card is required for Card Sales.";
												}
											}
											else if(jobNo == "TJS02")
											{
												if(input.Work_Order_Task == null)
												{
													errors = errors + "\n• Work Order Task is required for Service Task.";
												}
												if(input.Task_Location == null)
												{
													errors = errors + "\n• Task Location is required for Service Task.";
												}
												if(input.Small_Notes == null || input.Small_Notes.trim() == "")
												{
													errors = errors + "\n• Small Notes is required for Service Task.";
												}
											}
											else if(jobNo == "TJS03")
											{
												if(input.Batch_Number_From == null)
												{
													errors = errors + "\n• Stock Production is required for Stock Production.";
												}
											}
											else if(jobNo == "TJS04")
											{
												if(input.Truck_Movement_Voucher == null)
												{
													errors = errors + "\n• Truck Movement Voucher is required for Return Truck To Site.";
												}
												if(input.Small_Notes == null || input.Small_Notes.trim() == "")
												{
													errors = errors + "\n• Small Notes is required for Return Truck To Site.";
												}
											}
										}
										// =======================
										// 2. PICKUP REQUIRED
										// =======================
										if(input.Job != null && input.Job.Job_No == "TJS04")
										{
											if(input.Party_From == null)
											{
												errors = errors + "\n• Party From is required for Return Truck To Site.";
											}
											if(input.Party_Location_From == null)
											{
												errors = errors + "\n• Party Location From is required for Return Truck To Site.";
											}
										}
										else if(input.Job != null && input.Job.Job_No == "TJS02" && input.Task_Location == "Suppliers")
										{
											if(input.Party_From == null)
											{
												errors = errors + "\n• Party From is required.";
											}
											if(input.Party_Location_From == null)
											{
												errors = errors + "\n• Party Location From is required.";
											}
										}
										else
										{
											if(input.Site_From == null)
											{
												errors = errors + "\n• Site From is required.";
											}
											if(input.Site_Location_From == null)
											{
												errors = errors + "\n• Site Location From is required.";
											}
										}
										if(input.Odometer_Start == null)
										{
											errors = errors + "\n• Odometer Start is required.";
										}
										// IMAGE VALIDATION FIX
										if(isNull(input.Pick_Up_Image))
										{
											errors = errors + "\n• Pick Up Image is required.";
										}
										// =======================
										// 3. CANCEL VALIDATION
										// =======================
										if(input.Cancelled == true)
										{
											if(input.Reason_Why_Cancelled == null || input.Reason_Why_Cancelled.trim() == "")
											{
												errors = errors + "\n• Reason Why Cancelled is required.";
											}
										}
										// =======================
										// 4. EDIT DELIVERY VALIDATION
										// =======================
										if(input.ID != null && input.Cancelled != true)
										{
											if(input.Job != null && input.Job.Job_No == "TJS04")
											{
												if(input.Site_To == null)
												{
													errors = errors + "\n• Site To is required for Return Truck To Site.";
												}
												if(input.Site_Location_To == null)
												{
													errors = errors + "\n• Site Location To is required for Return Truck To Site.";
												}
											}
											else
											{
												if(input.Party_To == null && input.Site_To == null)
												{
													errors = errors + "\n• Delivery destination is required.";
												}
												if(input.Site_To != null && input.Site_Location_To == null)
												{
													errors = errors + "\n• Site Location To is required.";
												}
												if(input.Party_To != null && input.Party_Location_To == null)
												{
													errors = errors + "\n• Party Location To is required.";
												}
											}
											if(input.Odometer_End == null)
											{
												errors = errors + "\n• Odometer End is required.";
											}
											// IMAGE VALIDATION FIX
											if(isNull(input.Delivery_To_Image))
											{
												errors = errors + "\n• Delivery To Image is required.";
											}
											if(input.Odometer_Start != null && input.Odometer_End != null)
											{
												if(input.Odometer_End < input.Odometer_Start)
												{
													errors = errors + "\n• Odometer End cannot be less than Odometer Start.";
												}
											}
											if(input.Time_Start != null && input.Time_End != null)
											{
												if(input.Time_End < input.Time_Start)
												{
													errors = errors + "\n• Time End cannot be before Time Start.";
												}
											}
										}
										// =======================
										// 5. STOP SUBMISSION
										// =======================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			On_Cancelled_Selected1 as "On Cancelled Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Cancelled
				{
					actions 
					{
						custom deluge script
						(
											// TRUCK MOVEMENT VOUCHER
										// ON CANCELLED SELECTED
										if(input.Cancelled == true)
										{
											show Reason_Why_Cancelled;
											input.Truck_Movement_Voucher_Status = "Cancelled";
											// Clear delivery completion values
											input.Odometer_End = null;
											input.Time_End = null;
											// Clear summary values
											input.Line_Distance_Travelled = 0;
											input.Line_Duration_Minutes = 0;
											input.Cost_Per_Odometer = 0;
											input.Total_Cost = 0;
											// Lock fields that should not continue after cancellation
											disable Odometer_End;
											disable Time_End;
											disable Party_To;
											disable Party_Location_To;
											disable Site_To;
											disable Site_Location_To;
											disable Delivery_To_Image;
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = null;
											// Return to active status
											input.Truck_Movement_Voucher_Status = "In Progress";
											enable Odometer_End;
											enable Time_End;
											enable Party_To;
											enable Party_Location_To;
											enable Site_To;
											enable Site_Location_To;
											enable Delivery_To_Image;
										}
						)
					}
				}

			}
			On_Task_Location_Selected as "On Task Location Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Task_Location
				{
					actions 
					{
						custom deluge script
						(
											if(input.Job != null && input.Job.Job_No == "TJS02")
										{
											show Pick_Up_Section;
											show Work_Order_Task;
											enable Work_Order_Task;
											show Task_Location;
											enable Task_Location;
											show Small_Notes;
											enable Small_Notes;
											hide Card;
											hide Batch_Number_From;
											// Delivery is always Site To
											show Site_To;
											show Site_Location_To;
											enable Site_To;
											enable Site_Location_To;
											hide Party_To;
											hide Party_Location_To;
											if(input.Task_Location == "Company Sites")
											{
												show Site_From;
												show Site_Location_From;
												enable Site_From;
												enable Site_Location_From;
												hide Party_From;
												hide Party_Location_From;
											}
											else if(input.Task_Location == "Suppliers")
											{
												show Party_From;
												show Party_Location_From;
												enable Party_From;
												enable Party_Location_From;
												hide Site_From;
												hide Site_Location_From;
											}
											else
											{
												hide Site_From;
												hide Site_Location_From;
												hide Party_From;
												hide Party_Location_From;
												input.Site_From = null;
												input.Site_Location_From = null;
												input.Party_From = null;
												input.Party_Location_From = null;
											}
										}
						)
					}
				}

			}
