			On_Picked_Selected as "On Picked Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Shoe_Services.Picked
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// ON USER INPUT OF PICKED
										// ===============================
										trackVal = ifnull(row.Display_Name_Sales_Voucher,input.Sales_Voucher_Number);
										pd = Production_Details[Tracking_Number == trackVal && Line_Number == row.Line_Number];
										if(pd == null)
										{
											alert "Production Details record not found for this shoe line.";
											row.Picked=false;
											row.Pick_Up_Date=null;
										}
										else
										{
											if(row.Picked == true)
											{
												if(ifnull(input.Balance_Due,0) > 0)
												{
													alert "This intake is not fully paid. Please clear the balance before marking Picked.";
													row.Picked=false;
													row.Pick_Up_Date=null;
												}
												else
												{
													if(pd.In_Store_Stage != "Ready")
													{
														alert "You can only tick Picked when the shoe is Ready (Line " + row.Line_Number + ").";
														row.Picked=false;
														row.Pick_Up_Date=null;
													}
													else
													{
														if(row.Pick_Up_Date == null)
														{
															row.Pick_Up_Date=zoho.currenttime;
														}
														sd = Shoe_Services[Display_Name_Sales_Voucher == trackVal && Line_Number == row.Line_Number];
														if(sd != null)
														{
															sd.Picked=true;
															sd.Pick_Up_Date=row.Pick_Up_Date;
															sd.In_Store_Stage="Delivered";
														}
														pd.In_Store_Stage="Delivered";
													}
												}
											}
											// ===============================
											// WHEN PICKED = FALSE
											// ===============================
											else
											{
												row.Pick_Up_Date=null;
												sd = Shoe_Services[Display_Name_Sales_Voucher == trackVal && Line_Number == row.Line_Number];
												if(sd != null)
												{
													sd.Picked=false;
													sd.Pick_Up_Date=null;
													sd.In_Store_Stage="Ready";
												}
												pd.In_Store_Stage="Ready";
											}
										}
										intakeTrack = ifnull(input.Sales_Voucher_Number,trackVal);
										allDelivered = true;
										if(input.Shoe_Services.isEmpty())
										{
											allDelivered = false;
										}
										else
										{
											for each  rr in input.Shoe_Services
											{
												rowTrack = ifnull(rr.Display_Name_Sales_Voucher,intakeTrack);
												pd2 = Production_Details[Tracking_Number == rowTrack && Line_Number == rr.Line_Number];
												if(pd2 == null || pd2.In_Store_Stage != "Delivered")
												{
													allDelivered = false;
													break;
												}
											}
										}
										if(allDelivered)
										{
											input.Status = "Closed";
										}
										else
										{
											if(input.Status != "Closed")
											{
												input.Status = "Open";
											}
										}
						)
					}
				}

			}
