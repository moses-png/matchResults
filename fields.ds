			Add_Row_Service_Items as "Add Row Service Items"
			{
				type =  form
				form = Service

				record event = on add or edit

				on add row of Service_Items
				{
					actions 
					{
						custom deluge script
						(
											for each  itemRow in input.Service_Items
										{
											if(itemRow.Display_Name_Service == null || itemRow.Display_Name_Service == "" && input.Service_Name != null)
											{
												itemRow.Display_Name_Service=input.Service_Name;
											}
										}
						)
					}
				}

			}
			On_Item_Selected1 as "On Item Selected"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Service_Items.Item
				{
					actions 
					{
						custom deluge script
						(
											total_items_cost = 0;
										for each  itemRow in input.Service_Items
										{
											// 1) Auto-fill Display Service name (optional but helpful)
											if(itemRow.Display_Name_Service == null || itemRow.Display_Name_Service == "" && input.Service_Name != null)
											{
												itemRow.Display_Name_Service=input.Service_Name;
											}
											// 2) If Item is selected
											if(itemRow.Item != null)
											{
												// Display Name Item
												itemRow.Display_Name_Item=ifnull(itemRow.Item.Item_Name,"") + " - " + ifnull(itemRow.Item.SKU,"");
												// Unit of Measure
												itemRow.Unit_Of_Measure=itemRow.Item.Display_Name_Base_Unit_Of_Measure;
												// Rate: only set if empty/zero (prevents overwriting manual edits)
												if(itemRow.Rate == null || itemRow.Rate == 0)
												{
													itemRow.Rate=ifnull(itemRow.Item.Default_Cost,0);
												}
												// Line total
												itemRow.Line_Total=ifnull(itemRow.Rate,0) * ifnull(itemRow.Quantity_Needed,0);
											}
											else
											{
												// 3) If Item cleared, reset row values
												itemRow.Display_Name_Item="";
												itemRow.Unit_Of_Measure=null;
												itemRow.Rate=0;
												itemRow.Quantity_Needed=0;
												itemRow.Line_Total=0;
											}
											// 4) Add to parent total
											total_items_cost = total_items_cost + ifnull(itemRow.Line_Total,0);
										}
										// 5) Update parent totals
										input.Total_Cost = total_items_cost;
										input.Total_Cost = total_items_cost;
										// input.Rate = total_items_cost;  // keep Rate manual/fixed
						)
					}
				}

			}
			On_Quantity_Needed_Select1 as "On Quantity Needed Selected"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Service_Items.Quantity_Needed
				{
					actions 
					{
						custom deluge script
						(
											total_items_cost = 0;
										for each  itemRow in input.Service_Items
										{
											// Recalculate the row line total (safe even if Quantity didn’t change)
											itemRow.Line_Total=ifnull(itemRow.Rate,0) * ifnull(itemRow.Quantity_Needed,0);
											// Sum into parent
											total_items_cost = total_items_cost + ifnull(itemRow.Line_Total,0);
										}
										// Update parent totals
										input.Total_Cost = total_items_cost;
										// Optional: if you want Rate to follow Total_Cost
										// input.Rate = total_items_cost;
						)
					}
				}

			}
