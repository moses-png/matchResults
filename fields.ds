			Full_Validation_On_Create as "Full Validation On Create"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											prefix_value = "FAA";
										if(input.ID == null && input.Fuel_Voucher == null || input.Fuel_Voucher.trim() == "")
										{
											seq_rec = Sequences[Sequence_Key == prefix_value];
											if(seq_rec.ID == null)
											{
												alert "Sequence not configured for " + prefix_value + " in Sequences form.";
												cancel submit;
											}
											current_number = ifnull(seq_rec.Next_Number,1);
											if(current_number > 999)
											{
												alert "Maximum limit reached (" + prefix_value + "999).";
												cancel submit;
											}
											formatted_number = current_number.toString();
											if(current_number < 10)
											{
												formatted_number = "00" + formatted_number;
											}
											else if(current_number < 100)
											{
												formatted_number = "0" + formatted_number;
											}
											new_voucher = prefix_value + formatted_number;
											dupe = Fuel_Receiving_Voucher[Fuel_Voucher == new_voucher];
											if(dupe.count() > 0)
											{
												alert "Duplicate detected (" + new_voucher + "). Please try again.";
												cancel submit;
											}
											input.Fuel_Voucher = new_voucher;
											seq_rec.Next_Number=current_number + 1;
										}
										errors = "";
										errors = "";
										// =============================
										// 1) REQUIRED MAIN FIELDS
										// =============================
										if(input.Issued_By == null || input.Issued_By.toString().trim() == "")
										{
											errors = errors + "\n• Issued By is required.";
										}
										if(input.Fuel_Issuing_Time == null)
										{
											errors = errors + "\n• Fuel Issuing Time is required.";
										}
										if(input.Voucher == null)
										{
											errors = errors + "\n• Voucher is required.";
										}
										if(input.Asset == null)
										{
											errors = errors + "\n• Asset is required.";
										}
										if(input.Odometer == null)
										{
											errors = errors + "\n• Odometer is required.";
										}
										else if(input.Odometer < 0)
										{
											errors = errors + "\n• Odometer cannot be negative.";
										}
										if(input.Quantity == null)
										{
											errors = errors + "\n• Quantity is required.";
										}
										else if(input.Quantity <= 0)
										{
											errors = errors + "\n• Quantity must be greater than 0.";
										}
										if(input.Rate != null && input.Rate < 0)
										{
											errors = errors + "\n• Rate cannot be negative.";
										}
										// =============================
										// 2) CONDITIONAL RULES
										// =============================
										if(input.Issued_By == "Vendor")
										{
											if(input.Vendor == null)
											{
												errors = errors + "\n• Vendor is required.";
											}
											if(input.Store != null)
											{
												errors = errors + "\n• Store must be empty when Issued By is Vendor.";
											}
										}
										else if(input.Issued_By == "Fuel Tank")
										{
											if(input.Store == null)
											{
												errors = errors + "\n• Store is required.";
											}
											if(input.Vendor != null)
											{
												errors = errors + "\n• Vendor must be empty when Issued By is Fuel Tank.";
											}
											if(input.Item_Issuing_Details == null)
											{
												errors = errors + "\n• Item Issuing Details is required when Issued By is Fuel Tank.";
											}
										}
										// =============================
										// 3) ODOMETER DATE RANGE VALIDATION
										// =============================
										//if(input.Asset != null && input.Fuel_Issuing_Time != null && input.Odometer != null)
										//{
										//prev_odo = null;
										////next_odo = null;
										//prev_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded < input.Fuel_Issuing_Time] sort by Date_Time_Recorded desc;
										//for each  pl in prev_logs
										//{
										//prev_odo = ifnull(pl.Odometer_Reading,0.0);
										//break;
										//}
										//next_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded > input.Fuel_Issuing_Time] sort by Date_Time_Recorded asc;
										//for each  nx in next_logs
										//{
										//next_odo = ifnull(nx.Odometer_Reading,0.0);
										//break;
										//}
										//if(prev_odo != null && input.Odometer < prev_odo)
										//{
										//errors = errors + "\n• Odometer cannot be less than the previous mileage log (" + prev_odo + ").";
										//}
										//if(next_odo != null && input.Odometer > next_odo)
										//{
										//errors = errors + "\n• Odometer cannot be greater than the next mileage log (" + next_odo + ").";
