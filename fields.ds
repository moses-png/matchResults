                 		response.put("ok",true);
                 		response.put("msg","No amount to post");
                 		response.put("Amount_Added",0);
                 		return response;
                 	}
                 	if(payDate == null)
                 	{
                 		payDate = zoho.currentdate;
                 	}
                 	grp = Group[ID == groupId];
                 	if(grp.ID == null)
                 	{
                 		response.put("msg","Group not found");
                 		return response;
                 	}
                 	// ONE record per Group per Date per Source Group
                 	existing = Group_Accounts[Group == grp.ID && Payment_Date == payDate && Source_Group == sourceGroup];
                 	if(existing.ID != null)
                 	{
                 		existing.Amount_to_Pay=round(ifnull(existing.Amount_to_Pay,0.0) + amt,2);
                 		response.put("ok",true);
                 		response.put("msg","Existing group expense updated");
                 		response.put("Group_Expenses_ID",existing.ID);
                 		response.put("Amount_Added",amt);
                 		response.put("New_Amount_to_Pay",existing.Amount_to_Pay);
                 		return response;
                 	}
                 	newRec = insert into Group_Accounts
                 	[
                 		Group=grp.ID
                 		Payment_Date=payDate
                 		Source_Group=sourceGroup
                 		Amount_to_Pay=amt
                 		Amount_Actually_Paid=0
                 		Added_User=zoho.loginuser
                 	];
                 	if(newRec != null)
                 	{
                 		response.put("ok",true);
                 		response.put("msg","Group expense created");
                 		response.put("Group_Expenses_ID",newRec);
                 		response.put("Amount_Added",amt);
                 	}
                 	else
                 	{
                 		response.put("msg","Failed to create group expense");
                 	}
                 	return response;
                 }
				 map createGroupExpenseFromInvoice(map payload)
                 {
                 	resp = {"ok":false,"message":"Unknown error"};
                 	group_id = payload.get("Group_ID");
                 	amount_delta = ifnull(payload.get("Amount_Delta"),0.0);
                 	pay_date = payload.get("Payment_Date");
                 	source_group = ifnull(payload.get("Source_Group"),"Invoice Income");
                 	if(group_id == null)
                 	{
                 		resp.put("message","Group_ID is required.");
                 		return resp;
                 	}
                 	if(pay_date == null)
                 	{
                 		resp.put("message","Payment_Date is required.");
                 		return resp;
                 	}
                 	if(amount_delta == 0)
                 	{
                 		resp.put("ok",true);
                 		resp.put("message","No change needed.");
                 		return resp;
                 	}
                 	// Resolve the lookup record first
                 	group_rec = Group[ID == group_id];
                 	if(group_rec.ID == null)
                 	{
                 		resp.put("message","Group record not found for ID: " + group_id);
                 		return resp;
                 	}
                 	existing = Group_Accounts[Group == group_rec && Payment_Date == pay_date && Source_Group == source_group];
                 	if(existing.count() > 0)
                 	{
                 		for each  rec in existing
                 		{
                 			rec.Amount_to_Receive=round(ifnull(rec.Amount_to_Receive,0.0) + amount_delta,2);
                 			resp.put("ok",true);
                 			resp.put("message","Updated existing Group Expense.");
                 			resp.put("id",rec.ID);
                 			return resp;
                 		}
                 	}
                 	else
                 	{
                 		insert into Group_Accounts
                 		[
                 			Group=group_rec
                 			Payment_Date=pay_date
                 			Source_Group=source_group
                 			Amount_to_Receive=round(amount_delta,2)
                 			Added_User=zoho.loginuser
                 		]
                 		resp.put("ok",true);
                 		resp.put("message","Created new Group Expense.");
                 		return resp;
                 	}
                 	return resp;
                 }
				 map createGroupExpenseFromStoreBill(map payload)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	group_id = payload.get("Group_ID");
                 	amount_delta = round(ifnull(payload.get("Amount_Delta"),0.0),2);
                 	payment_date = payload.get("Payment_Date");
                 	source_group = ifnull(payload.get("Source_Group"),"Store Purchases");
                 	if(group_id == null)
                 	{
                 		result.put("message","Group_ID is required.");
                 		return result;
                 	}
                 	if(amount_delta == 0)
                 	{
                 		result.put("ok",true);
                 		result.put("message","No change in amount.");
                 		return result;
                 	}
                 	if(payment_date == null)
                 	{
                 		payment_date = zoho.currentdate;
                 	}
                 	group_rec = Group[ID == group_id];
                 	if(group_rec.ID == null)
                 	{
                 		result.put("message","Selected Group was not found.");
                 		return result;
                 	}
                 	// ======================================
                 	// ? KEY FIX: MERGE INSTEAD OF INSERT
                 	// ======================================
                 	existing = Group_Accounts[Group == group_id && Payment_Date == payment_date && Source_Group == source_group];
                 	if(existing.ID != null)
                 	{
                 		// UPDATE existing record
                 		new_amt = round(ifnull(existing.Amount_to_Pay,0.0) + amount_delta,2);
                 		if(new_amt < 0)
                 		{
                 			new_amt = 0.0;
                 		}
                 		existing.Amount_to_Pay=new_amt;
                 		result.put("ok",true);
                 		result.put("message","Group Expense updated.");
                 		result.put("group_expense_id",existing.ID);
                 	}
                 	else
                 	{
                 		// INSERT new record
                 		insert into Group_Accounts
                 		[
                 			Payment_Date=payment_date
                 			Group=group_id
                 			Source_Group=source_group
                 			Amount_to_Pay=amount_delta
                 			Amount_Actually_Paid=0.0
                 			Added_User=zoho.loginuser
                 		]
                 		result.put("ok",true);
                 		result.put("message","Group Expense created.");
                 	}
                 	return result;
                 }
				 map createOrUpdateAccountTransactionLog(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	source_form = ifnull(payload.get("Source_Form"),"");
                 	source_record_id = ifnull(payload.get("Source_Record_ID"),0);
                 	application_name = ifnull(payload.get("Application"),"");
                 	transaction_type = ifnull(payload.get("Transaction_Type"),"");
                 	account_id = payload.get("Account");
                 	transaction_dt_time = payload.get("Transaction_Date_Time");
                 	if(transaction_dt_time == null)
                 	{
                 		transaction_dt_time = payload.get("Transaction_Date");
                 	}
                 	if(transaction_dt_time == null)
                 	{
                 		transaction_dt_time = zoho.currenttime;
                 	}
                 	if(source_form == "" || source_record_id == 0 || application_name == "" || transaction_type == "")
                 	{
                 		resp.put("message","Missing Source Form, Source Record ID, Application, or Transaction Type.");
                 		return resp;
                 	}
                 	if(account_id == null)
                 	{
                 		resp.put("message","Account is required.");
                 		return resp;
                 	}
                 	log = Account_Transaction_Log[Source_Form == source_form && Source_Record_ID == source_record_id && Application == application_name && Transaction_Type == transaction_type];
                 	if(log.ID != null)
                 	{
                 		old_account_id = log.Account;
                 		log.Transaction_Date=transaction_dt_time;
                 		log.Account=account_id;
                 		log.Display_Name_Account=ifnull(payload.get("Display_Name_Account"),"");
                 		log.Transaction_Type=transaction_type;
                 		log.Amount=ifnull(payload.get("Amount"),0.0);
                 		log.Reference_Type=ifnull(payload.get("Reference_Type"),"");
                 		log.Reference_Number=ifnull(payload.get("Reference_Number"),"");
                 		log.Application=application_name;
                 		log.Source_Form=source_form;
                 		log.Source_Record_ID=source_record_id;
                 		log.Notes=ifnull(payload.get("Notes"),"");
                 		log.User_Name=ifnull(payload.get("User_Name"),"");
                 		log.User_Email=ifnull(payload.get("User_Email"),"");
                 		log.User_Role=ifnull(payload.get("User_Role"),"");
                 		log.Created_By_Name=ifnull(payload.get("Created_By_Name"),"");
                 		log.Created_By_Email=ifnull(payload.get("Created_By_Email"),"");
                 		log.Created_By_Time=payload.get("Created_By_Time");
                 		log.Updated_By_Name=ifnull(payload.get("Updated_By_Name"),"");
                 		log.Updated_By_Email=ifnull(payload.get("Updated_By_Email"),"");
                 		log.Updated_By_Time=payload.get("Updated_By_Time");
                 		refresh_resp = thisapp.refreshAccountTransactionLog(account_id.toLong());
                 		if(old_account_id != null && old_account_id != account_id)
                 		{
                 			old_refresh_resp = thisapp.refreshAccountTransactionLog(old_account_id.toLong());
                 		}
                 		resp.put("ok",true);
                 		resp.put("created",false);
                 		resp.put("account_id",account_id);
                 		resp.put("refresh_response",refresh_resp);
                 		resp.put("message","Transaction log updated and account refreshed.");
                 		return resp;
                 	}
                 	new_log_id = insert into Account_Transaction_Log
                 	[
                 		Transaction_Date=transaction_dt_time
                 		Account=account_id
                 		Display_Name_Account=ifnull(payload.get("Display_Name_Account"),"")
                 		Transaction_Type=transaction_type
                 		Amount=ifnull(payload.get("Amount"),0.0)
                 		Reference_Type=ifnull(payload.get("Reference_Type"),"")
                 		Reference_Number=ifnull(payload.get("Reference_Number"),"")
                 		Application=application_name
                 		Source_Form=source_form
                 		Source_Record_ID=source_record_id
                 		Notes=ifnull(payload.get("Notes"),"")
                 		User_Name=ifnull(payload.get("User_Name"),"")
                 		User_Email=ifnull(payload.get("User_Email"),"")
                 		User_Role=ifnull(payload.get("User_Role"),"")
                 		Created_By_Name=ifnull(payload.get("Created_By_Name"),"")
                 		Created_By_Email=ifnull(payload.get("Created_By_Email"),"")
                 		Created_By_Time=payload.get("Created_By_Time")
                 		Updated_By_Name=ifnull(payload.get("Updated_By_Name"),"")
                 		Updated_By_Email=ifnull(payload.get("Updated_By_Email"),"")
                 		Updated_By_Time=payload.get("Updated_By_Time")
                 		Added_User=zoho.loginuser
                 	];
                 	refresh_resp = thisapp.refreshAccountTransactionLog(account_id.toLong());
                 	resp.put("ok",true);
                 	resp.put("created",true);
                 	resp.put("transaction_log_id",new_log_id);
                 	resp.put("account_id",account_id);
                 	resp.put("refresh_response",refresh_resp);
                 	resp.put("message","Transaction log created and account refreshed.");
                 	return resp;
                 }
				 void Deduct_From_Unconfirmed(int paymentVoucherID)
                 {
                 	pv = Payment_Voucher2[ID == paymentVoucherID];
                 	if(pv.ID == null)
                 	{
                 		return;
                 	}
                 	acc = Account[ID == pv.Account];
                 	if(acc.ID == null)
                 	{
                 		return;
                 	}
                 	amt = 0.0;
                 	if(pv.Transaction_Type == "Debit")
                 	{
                 		amt = ifnull(pv.Total_Amount_Received,0.0);
                 		acc.Unconfirmed_Total_Debit=ifnull(acc.Unconfirmed_Total_Debit,0.0) - amt;
                 	}
                 	else if(pv.Transaction_Type == "Credit")
                 	{
                 		amt = ifnull(pv.Total_Amount_Paid,0.0);
                 		acc.Unconfirmed_Total_Credit=ifnull(acc.Unconfirmed_Total_Credit,0.0) - amt;
                 	}
                 	acc.Unconfirmed_Total_Amount=ifnull(acc.Unconfirmed_Total_Debit,0.0) + ifnull(acc.Unconfirmed_Total_Credit,0.0);
                 }
				 map deleteAccountTransactionLog(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	source_form = ifnull(payload.get("Source_Form"),"").trim();
                 	source_record_id = ifnull(payload.get("Source_Record_ID"),0);
                 	if(source_form == "" || source_record_id == 0)
                 	{
                 		resp.put("message","Missing Source Form or Source Record ID.");
                 		return resp;
                 	}
                 	account_ids = List();
                 	matching_logs = Account_Transaction_Log[Source_Form == source_form && Source_Record_ID == source_record_id];
                 	for each  log_rec in matching_logs
                 	{
                 		if(log_rec.Account != null)
                 		{
                 			account_id = log_rec.Account.ID;
                 			if(!account_ids.contains(account_id))
                 			{
                 				account_ids.add(account_id);
                 			}
                 		}
                 	}
                 	delete from Account_Transaction_Log[Source_Form == source_form && Source_Record_ID == source_record_id];
                 	for each  account_id in account_ids
                 	{
                 		thisapp.refreshAccountTransactionLog(account_id);
                 	}
                 	resp.put("ok",true);
                 	resp.put("message","Transaction log deleted and affected account balances refreshed.");
                 	resp.put("accounts_refreshed",account_ids.size());
                 	return resp;
                 }
				 map deletePaymentChargesFromCleanSand(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	if(payload == null)
                 	{
                 		resp.put("message","Payload is null.");
                 		return resp;
                 	}
                 	source_record_id = payload.get("Source_Record_ID");
                 	source_form = ifnull(payload.get("Source_Form"),"Payment Charges");
                 	if(source_record_id == null)
                 	{
                 		resp.put("message","Source Record ID missing.");
                 		return resp;
                 	}
                 	existing_list = Payment_Details[Source_Record_ID == source_record_id && Source_Form == source_form];
                 	if(existing_list.count() == 0)
                 	{
                 		resp.put("ok",true);
                 		resp.put("message","No synced Payment Charge found.");
                 		return resp;
                 	}
                 	pv_id = null;
                 	for each  d in existing_list
                 	{
                 		pv_id = d.Voucher;
                 		delete from Payment_Details[ID == d.ID];
                 	}
                 	if(pv_id != null)
                 	{
                 		pv = Payment_Voucher2[ID == pv_id];
                 		if(pv.ID != null)
                 		{
                 			total_amount = 0.0;
                 			for each  d2 in Payment_Details[Voucher == pv.ID]
                 			{
                 				total_amount = total_amount + ifnull(d2.Amount_Allocated,0.0);
                 			}
                 			pv.Total_Amount=total_amount;
                 		}
                 	}
                 	resp.put("ok",true);
                 	resp.put("message","Payment Charge deleted and Payment Voucher total recalculated.");
                 	resp.put("payment_voucher_id",pv_id);
                 	return resp;
                 }
