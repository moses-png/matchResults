			Set_Up_Form10 as "Set Up Form"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// WORK ORDER TASKS -> SET UP FORM / ON LOAD
										// =====================================================
										isLabourService = false;
										isItemsService = false;
										if(input.Vendor_Service_Type == "Labour Only" || input.Vendor_Service_Type == "Tractor Work Report" || input.Vendor_Service_Type == "Truck Movement Voucher")
										{
											isLabourService = true;
										}
										if(input.Vendor_Service_Type == "Items Only")
										{
											isItemsService = true;
										}
										// -------------------------
										// HIDE FIELDS DEFAULT
										// -------------------------
										hide Display_Name_Asset;
										hide Display_Name_Work_Order;
										hide Parts_Consumables;
										hide Parts_Consumables.Display_Name_Work_Order_Task_Number;
										hide Parts_Consumables.Line_Number;
										hide Parts_Consumables.Item_Issuing;
										hide Parts_Consumables.Bill_Details;
										hide Parts_Consumables.Item_Status;
										hide Parts_Consumables.Source_Record_ID;
										hide Parts_Consumables.Source_Form;
										hide Approved_Task_Status;
										hide After_Repair_Section;
										hide Checked_Section;
										hide Work_Order_Task_Totals;
										hide Labour_Total;
										hide Parts_Total;
										hide Grand_Total;
										hide Store_Manager;
										hide Display_Name_Store_Manager;
										hide Parts_Consumables.Quantity_In_Base_Unit;
										hide Parts_Consumables.Rate_In_Base_Unit;
										hide Source_Form;
										hide Source_Details;
										hide Source_Record_ID;
										// -------------------------
										// DISABLE FIELDS DEFAULT
										// -------------------------
										disable Labour_Total;
										disable Parts_Total;
										disable Grand_Total;
										disable Issue;
										disable Parts_Consumables.Item;
										disable Parts_Consumables.Line_Total;
										disable Parts_Consumables.Display_Name_Item_Labour;
										disable Parts_Consumables.Unit_of_Measure;
										disable Parts_Consumables.Bill_Details;
										disable Parts_Consumables.Item_Status;
										disable Parts_Consumables.Source_Record_ID;
										disable Parts_Consumables.Source_Form;
										disable Notes_why_Cancelled;
										disable Date_Time_Approved;
										disable Approved_By_Email;
										disable Work_Order_Task_Number;
										disable Work_Order_Task_Status;
										disable Display_Name_Store_Manager;
										// -------------------------
										// MODE / STATUS
										// -------------------------
										status = ifnull(input.Work_Order_Task_Status,"");
										is_create = input.ID == null;
										if(is_create)
										{
											hide Cancel_This_Work_Order;
											hide Notes_why_Cancelled;
											hide Odometer_Reading_Approved;
											hide Date_Time_Approved;
											hide Approved_By_Email;
											if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												show Display_Name_Store_Manager;
												enable Store_Manager;
											}
											else if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
												input.Store_Manager = null;
												input.Display_Name_Store_Manager = "";
											}
										}
										// =====================================================
										// A) REQUESTED
										// =====================================================
										if((!is_create && status == "") || (!is_create && status == "Requested"))
										{
											disable Work_Order_Task_Number;
											disable Asset;
											disable Before_Image;
											disable Odometer_Reading_Requested;
											disable Work_Order;
											if(isLabourService)
											{
												show Work_Order_Task_Totals;
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												disable Parts_Consumables.Unit_Cost;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
												input.Store_Manager = null;
												input.Display_Name_Store_Manager = "";
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												//show Display_Name_Store_Manager;
												enable Store_Manager;
											}
											show Approved_Task_Status;
											show Cancel_This_Work_Order;
											show Notes_why_Cancelled;
											show Odometer_Reading_Approved;
											show Date_Time_Approved;
											show Approved_By_Email;
										}
										// =====================================================
										// B) CANCELLED
										// =====================================================
										else if(!is_create && status == "Cancelled")
										{
											show Work_Order_Task_Totals;
											disable Asset;
											disable Odometer_Reading_Requested;
											disable Work_Order;
											disable Vendor_Service_Type;
											disable Parts_Consumables.Item;
											disable Parts_Consumables.Labour;
											disable Parts_Consumables.Description;
											disable Parts_Consumables.Quantity;
											disable Parts_Consumables.Unit_Cost;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												//show Display_Name_Store_Manager;
												disable Store_Manager;
											}
											disable Work_Order_Task_Status;
											show Approved_Task_Status;
											show Cancel_This_Work_Order;
											show Notes_why_Cancelled;
											disable Odometer_Reading_Approved;
										}
										// =====================================================
										// C) REPAIRING
										// =====================================================
										else if(status == "Repairing")
										{
											show Work_Order_Task_Totals;
											disable Asset;
											hide Odometer_Reading_Requested;
											disable Before_Image;
											disable Task_Description;
											disable Work_Order;
											disable Parts_Consumables.Item;
											disable Parts_Consumables.Labour;
											disable Parts_Consumables.Description;
											disable Parts_Consumables.Quantity;
											hide Parts_Consumables.Unit_Cost;
											hide Parts_Consumables.Line_Total;
											disable Vendor_Service_Type;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												show Parts_Consumables.Unit_Cost;
												show Parts_Consumables.Line_Total;
												disable Parts_Consumables.Unit_Cost;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												//show Display_Name_Store_Manager;
												disable Store_Manager;
											}
											show After_Repair_Section;
											disable Date_Time_Work_Completed;
											disable Completed_By_Email;
										}
										// =====================================================
										// D) CHECKING
										// =====================================================
										else if(status == "Checking")
										{
											show Work_Order_Task_Totals;
											disable Asset;
											hide Odometer_Reading_Requested;
											disable Work_Order;
											disable Parts_Consumables.Item;
											disable Parts_Consumables.Labour;
											disable Parts_Consumables.Description;
											disable Parts_Consumables.Quantity;
											hide Parts_Consumables.Unit_Cost;
											hide Parts_Consumables.Line_Total;
											disable Vendor_Service_Type;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												show Parts_Consumables.Unit_Cost;
												enable Parts_Consumables.Unit_Cost;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Consumables.Line_Total;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												//show Display_Name_Store_Manager;
												disable Store_Manager;
											}
											show Checked_Section;
											disable Date_Time_Work_Checked;
											disable Checked_By_Email;
										}
										// =====================================================
										// E) INVOICING
										// =====================================================
										else if(status == "Invoicing")
										{
											disable Asset;
											hide Odometer_Reading_Requested;
											disable Parts_Consumables.Item;
											disable Parts_Consumables.Labour;
											disable Parts_Consumables.Description;
											disable Vendor_Service_Type;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												show Parts_Consumables.Unit_Cost;
												enable Parts_Consumables.Unit_Cost;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												//show Display_Name_Store_Manager;
												disable Store_Manager;
											}
										}
										// =====================================================
										// F) INVOICED
										// =====================================================
										else if(status == "Invoiced")
										{
											disable Asset;
											disable Odometer_Reading_Requested;
											disable Work_Order;
											disable Vendor_Service_Type;
											show Parts_Consumables;
											hide Parts_Consumables.Item;
											hide Parts_Consumables.Labour;
											show Parts_Consumables.Display_Name_Item_Labour;
											disable Parts_Consumables.Description;
											disable Parts_Consumables.Quantity;
											disable Parts_Consumables.Unit_Cost;
											show Labour_Total;
											show Parts_Total;
											show Grand_Total;
											if(isItemsService)
											{
												show Store_Manager;
												show Display_Name_Store_Manager;
												disable Store_Manager;
											}
											else
											{
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											show Approved_Task_Status;
											disable Cancel_This_Work_Order;
											disable Notes_why_Cancelled;
											disable Odometer_Reading_Approved;
											show After_Repair_Section;
											disable Date_Time_Work_Completed;
											disable Completed_By_Email;
											disable Odometer_Reading_Completed;
											show Checked_Section;
											disable Odometer_Reading_Checked;
											disable Date_Time_Work_Checked;
											disable Service_Task_Checkbox;
											disable Checked_By_Email;
										}
										// =====================================================
										// G) ADMIN
										// =====================================================
										else if(status == "Admin")
										{
											enable Asset;
											enable Odometer_Reading_Requested;
											enable Work_Order;
											enable Task_Description;
											enable Odometer_Reading_Approved;
											show Approved_Task_Status;
											show Odometer_Reading_Approved;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												//show Display_Name_Store_Manager;
												enable Store_Manager;
											}
										}
										// =====================================================
										// DISPLAY NAME STORE MANAGER
										// =====================================================
										if(input.Store_Manager != null)
										{
											input.Display_Name_Store_Manager = input.Store_Manager.Employee_Name + " - " + ifnull(input.Store_Manager.Employee_Number,"");
										}
										else
										{
											input.Display_Name_Store_Manager = "";
										}
										// =====================================================
										// DAYS ODOMETER AUTO-FILL
										// =====================================================
										status = ifnull(input.Work_Order_Task_Status,"Requested").trim();
										if(input.Asset != null && input.Asset.Odometer_Unit_Of_Measure == "days")
										{
											last_odo = ifnull(input.Asset.Odometer_Reading,0);
											odo_today = last_odo;
											if(input.Asset.Date_Time_Odometer_Read != null)
											{
												last_date = input.Asset.Date_Time_Odometer_Read.toDate();
												days_passed = daysBetween(last_date,zoho.currentdate);
												odo_today = last_odo + days_passed;
											}
											if(status == "Requested" && input.Odometer_Reading_Approved == null)
											{
												input.Odometer_Reading_Approved = odo_today;
												disable Odometer_Reading_Approved;
											}
											else if(status == "Repairing" && input.Odometer_Reading_Completed == null)
											{
												input.Odometer_Reading_Completed = odo_today;
												disable Odometer_Reading_Completed;
											}
											else if(status == "Checking" && input.Odometer_Reading_Checked == null)
											{
												input.Odometer_Reading_Checked = odo_today;
												disable Odometer_Reading_Checked;
											}
										}
										hide Back_End;
						)
					}
				}

			}
			On_Asset_Selected3 as "On Asset Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Asset
				{
					actions 
					{
						custom deluge script
						(
											if(input.Asset != null)
										{
											input.Display_Name_Asset = ifnull(input.Asset.Asset_Name + " - " + input.Asset.Asset_ID,"");
											Asset_Type = ifnull(input.Asset.Display_Name_Asset_Type,"");
											// Fill ONLY requested odometer at creation/request stage
											if(input.Asset.Odometer_Unit_Of_Measure == "days")
											{
												input.Odometer_Reading_Requested = input.Asset.Odometer_Reading;
												disable Odometer_Reading_Requested;
											}
											else
											{
												input.Odometer_Reading_Requested = null;
												enable Odometer_Reading_Requested;
											}
											// Do NOT fill next stage odometers here
											input.Odometer_Reading_Approved = null;
											input.Odometer_Reading_Completed = null;
											input.Odometer_Reading_Checked = null;
										}
										else
										{
											input.Display_Name_Asset = "";
											Asset_Type = "";
											input.Odometer_Reading_Requested = null;
											input.Odometer_Reading_Approved = null;
											input.Odometer_Reading_Completed = null;
											input.Odometer_Reading_Checked = null;
											enable Odometer_Reading_Requested;
											enable Odometer_Reading_Approved;
											enable Odometer_Reading_Completed;
											enable Odometer_Reading_Checked;
										}
						)
					}
				}

			}
			On_Vendor_Service_Type_Se as "On Vendor Service Type Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Vendor_Service_Type
				{
					actions 
					{
						custom deluge script
						(
											// User input of Vendor_Service_Type (Work_Order_Tasks)
										isLabourService = false;
										isItemsService = false;
										if(input.Vendor_Service_Type == "Labour Only" || input.Vendor_Service_Type == "Tractor Work Report" || input.Vendor_Service_Type == "Truck Movement Voucher")
										{
											isLabourService = true;
										}
										else if(input.Vendor_Service_Type == "Items Only")
										{
											isItemsService = true;
										}
										if(isLabourService)
										{
											show Parts_Consumables;
											show Parts_Consumables.Labour;
											hide Parts_Consumables.Item;
											hide Parts_Total;
											show Labour_Total;
											show Grand_Total;
											hide Store_Manager;
											hide Display_Name_Store_Manager;
											input.Store_Manager = null;
											input.Display_Name_Store_Manager = "";
											for each  r in input.Parts_Consumables
											{
												if(r.Item != null)
												{
													r.Item=null;
													r.Display_Name_Item_Labour="";
													r.Quantity=null;
													r.Unit_Cost=null;
													r.Unit_of_Measure="";
													r.Line_Total=null;
												}
											}
										}
										else if(isItemsService)
										{
											show Parts_Consumables;
											show Parts_Consumables.Item;
											hide Parts_Consumables.Labour;
											show Parts_Total;
											hide Labour_Total;
											show Grand_Total;
											show Store_Manager;
											//show Display_Name_Store_Manager;
											enable Store_Manager;
											if(input.Store_Manager != null)
											{
												input.Display_Name_Store_Manager = input.Store_Manager.Employee_Name + " - " + ifnull(input.Store_Manager.Employee_Number,"");
											}
											else
											{
												input.Display_Name_Store_Manager = "";
											}
											for each  r in input.Parts_Consumables
											{
												if(r.Labour != null)
												{
													r.Labour=null;
													r.Display_Name_Item_Labour="";
													r.Quantity=null;
													r.Unit_Cost=null;
													r.Unit_of_Measure="";
													r.Line_Total=null;
												}
											}
										}
										else
										{
											hide Parts_Consumables;
											hide Parts_Total;
											hide Labour_Total;
											hide Grand_Total;
											hide Store_Manager;
											hide Display_Name_Store_Manager;
											input.Store_Manager = null;
											input.Display_Name_Store_Manager = "";
										}
										// ---- Recalculate totals ----
										parts_rows = List();
										for each  rr in input.Parts_Consumables
										{
											m = Map();
											m.put("Item",rr.Item);
											m.put("Labour",rr.Labour);
											m.put("Quantity",rr.Quantity);
											m.put("Unit Cost",rr.Unit_Cost);
											parts_rows.add(m);
										}
										input.Parts_Total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
										input.Labour_Total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Parts_Total,input.Labour_Total);
						)
					}
				}

			}
			On_Quantity_Selected1 as "On Quantity Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Parts_Consumables.Quantity
				{
					actions 
					{
						custom deluge script
						(
											// 1) Always update THIS row line total
										row.Line_Total=thisapp.asset_calc.asset_calc_line_total(row.Quantity,row.Unit_Cost);
										// 2) Parent totals: only if the parent record already exists (Edit mode)
										if(input.ID != null)
										{
											rec = Work_Order_Tasks[ID == input.ID];
											// Only proceed if record exists
											if(rec.count() > 0)
											{
												parts_rows = List();
												for each  r in rec.Parts_Consumables
												{
													m = Map();
													m.put("Item",r.Item);
													m.put("Labour",r.Labour);
													m.put("Quantity",r.Quantity);
													m.put("Unit Cost",r.Unit_Cost);
													parts_rows.add(m);
												}
												parts_total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
												labour_total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
												grand_total = thisapp.asset_calc.asset_calc_grand_total(parts_total,labour_total);
												rec.Parts_Total=parts_total;
												rec.Labour_Total=labour_total;
												rec.Grand_Total=grand_total;
											}
										}
						)
					}
				}

			}
			On_Item_Selected1 as "On Item Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Parts_Consumables.Item
				{
					actions 
					{
						custom deluge script
						(
											// ===== ITEM SELECTED =====
										if(row.Item != null)
										{
											row.Labour=null;
											row.Display_Name_Item_Labour=ifnull(row.Item.Item_Name,"") + " - " + ifnull(row.Item.SKU,"");
											row.Unit_Cost=ifnull(row.Item.Default_Cost,0);
											// Use the UOM display field available on imported Item
											row.Unit_of_Measure=ifnull(row.Item.Display_Name_Base_Unit_Of_Measure,"");
											row.Quantity=null;
											row.Line_Total=null;
										}
										else
										{
											row.Unit_Cost=null;
											row.Unit_of_Measure="";
											row.Quantity=null;
											row.Line_Total=null;
											if(row.Labour == null)
											{
												row.Display_Name_Item_Labour="";
											}
										}
										// ===== RECALCULATE TOTALS =====
										parts_rows = List();
										for each  r in input.Parts_Consumables
										{
											m = Map();
											m.put("Item",r.Item);
											m.put("Labour",r.Labour);
											m.put("Quantity",r.Quantity);
											m.put("Unit Cost",r.Unit_Cost);
											parts_rows.add(m);
										}
										input.Parts_Total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
										input.Labour_Total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Parts_Total,input.Labour_Total);
						)
					}
				}

			}
			On_Labour_Selected1 as "On Labour Selected"
