			On_Number_Plate_Selected1 as "On Number Plate Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Number_Plate
				{
					actions 
					{
						custom deluge script
						(
											// Sales Voucher -> On Number Plate Selected
										if(input.Number_Plate == null)
										{
											// Clear base fields
											input.Display_Name_Number_Plate = null;
											input.Truck_Type = null;
											// Clear dependent fields
											input.Truck_Measurement = null;
											input.Truck_Size_1 = null;
											input.Truck_Size_2 = null;
											input.Truck_Size = null;
											input.Truck_CBM = null;
											// Recalculate totals safely
											itemTotal = 0;
											for each  r in input.Item_Sales
											{
												itemTotal = itemTotal + ifnull(r.Line_Total,0);
											}
											sandAmt = 0;
											input.Amount_Supposed_To_Pay_Sand_Sales = round(sandAmt,2);
											input.Amount_Supposed_To_Pay_Item_Sales = round(itemTotal,2);
											input.Amount_Supposed_To_Pay = round(sandAmt + itemTotal,2);
											return;
										}
										// 1) Auto-fill from Number Plate
										input.Display_Name_Number_Plate = input.Number_Plate.Number_Plate + " - " + input.Number_Plate.TSF_Number;
										input.Truck_Type = input.Number_Plate.Display_Name_Truck_Type;
										// 2) Reset anything that depends on the truck
										// (Prevents old measurement/CBM/amount from a different truck)
										input.Truck_Measurement = null;
										input.Truck_Size_1 = null;
										input.Truck_Size_2 = null;
										input.Truck_Size = null;
										input.Truck_CBM = null;
										// 3) Recalculate totals after truck reset
										sand_total = ifnull(input.Rate_per_CBM,0) * ifnull(input.Truck_CBM,0);
										item_total = 0;
										for each  r in input.Item_Sales
										{
											item_total = item_total + ifnull(r.Line_Total,0);
										}
										input.Amount_Supposed_To_Pay_Sand_Sales = round(sand_total,2);
										input.Amount_Supposed_To_Pay_Item_Sales = round(item_total,2);
										input.Amount_Supposed_To_Pay = round(sand_total + item_total / 10000,2);
						)
					}
				}

			}
			On_Truck_Type_Selected as "On Truck Type Selected"
			{
				type =  form
				form = Truck_Register

				record event = on add or edit

