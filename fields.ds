						custom deluge script
						(
											// ======================================
										// PAYMENT DETAILS SUBFORM
										// On user input of Employee_Management_Bill
										// Parent Form: Payment_Voucher
										// Subform: Payment_Details
										// ======================================
										if(row.Employee_Management_Bill != null)
