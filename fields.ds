			On_Item_Selected8 as "On Item Selected"
			{
				type =  form
				form = Sales_Voucher_Details

				record event = on add or edit

				on user input of Item
				{
					actions 
					{
						custom deluge script
						(
											if(input.Item != null)
										{
											input.Display_Name_Item = input.Item.Item_Name + " - " + input.Item.SKU;
											if(input.Item.Base_Unit_Of_Measure != null)
											{
												input.Base_Unit_Of_Measure = input.Item.Base_Unit_Of_Measure;
												input.Display_Name_Base_Unit_Of_Measure = input.Item.Base_Unit_Of_Measure.Unit_Of_Measure_Name;
											}
											else
											{
												input.Base_Unit_Of_Measure = null;
												input.Display_Name_Base_Unit_Of_Measure = "";
											}
											if(input.Item.Item_Category != null && input.Item.Item_Category.Division != null)
											{
												input.Display_Name_Division = input.Item.Item_Category.Division.Division_Letter;
											}
											else
											{
												input.Display_Name_Division = "";
											}
											input.Business_Division = null;
											input.Display_Name_Business_Division = "";
											input.Quantity_Available = ifnull(input.Item.Stock_On_Hand,0);
											input.Quantity = 0;
											input.Quantity_in_Base_Unit_Of_Measure = 0;
											input.Unit_Price = 0;
											input.Line_Total = 0;
											input.Tax_Amount = 0;
										}
										else
										{
											input.Display_Name_Item = "";
											input.Display_Name_Division = "";
											input.Business_Division = null;
											input.Display_Name_Business_Division = "";
											input.Base_Unit_Of_Measure = null;
											input.Display_Name_Base_Unit_Of_Measure = "";
											input.Quantity_Available = 0;
											input.Quantity = 0;
											input.Quantity_in_Base_Unit_Of_Measure = 0;
											input.Unit_Price = 0;
											input.Line_Total = 0;
											input.Tax_Amount = 0;
										}
						)
					}
				}

			}
			On_Quantity_Selected2 as "On Quantity Selected"
			{
				type =  form
				form = Sales_Voucher_Details

				record event = on add or edit

				on user input of Quantity
				{
					actions 
					{
						custom deluge script
						(
											if(input.Quantity != null && input.Quantity_Available != null)
										{
											if(input.Quantity > input.Quantity_Available)
											{
												alert "Quantity cannot be greater than Quantity Available.";
												input.Quantity = null;
												input.Quantity_in_Base_Unit_Of_Measure = 0;
												input.Line_Total = 0;
												input.Tax_Amount = 0;
												return;
											}
										}
										if(input.Item != null && input.Unit_Of_Measure != null && input.Quantity != null)
										{
											base_qty = store_management.uom.convert_to_base_qty(input.Item,input.Unit_Of_Measure.Alternate_Unit_Of_Measure,input.Quantity);
											if(base_qty != null)
											{
												input.Quantity_in_Base_Unit_Of_Measure = base_qty;
											}
											else
											{
												alert "No Unit Of Measure conversion found for this Item and Unit Of Measure.";
												input.Quantity_in_Base_Unit_Of_Measure = 0;
											}
										}
										else
										{
											input.Quantity_in_Base_Unit_Of_Measure = 0;
										}
										input.Line_Total = ifnull(input.Quantity,0) * ifnull(input.Unit_Price,0);
										if(input.Tax_Type != null)
										{
											input.Tax_Amount = input.Line_Total * ifnull(input.Tax_Type.Tax_Rate,0) / 100;
										}
										else
										{
											input.Tax_Amount = 0;
										}
						)
					}
				}

			}
