				 map postAssetTransactionFromBill(string source_form, int source_record_id, decimal amount_val)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	if(source_form == null || source_form.trim() == "")
                 	{
                 		resp.put("message","Source Form is required.");
                 		return resp;
                 	}
                 	if(source_record_id == null)
                 	{
                 		resp.put("message","Source Record ID is required.");
                 		return resp;
                 	}
                 	asset_log = Asset_Transaction_Log[Source_Form == source_form && Source_Record_ID == source_record_id];
                 	if(asset_log.ID == null)
                 	{
                 		resp.put("message","Asset Transaction Log not found.");
                 		return resp;
                 	}
                 	amount_posted = round(ifnull(amount_val,0.0),2);
                 	asset_log.Transaction_Status="Posted";
                 	asset_log.Amount=amount_posted;
                 	asset_log.Expenses=amount_posted;
                 	asset_log.Income=0.0;
                 	resp.put("ok",true);
                 	resp.put("message","Asset Transaction Log updated successfully.");
                 	resp.put("Log_ID",asset_log.ID);
                 	resp.put("Amount",amount_posted);
                 	return resp;
                 }
				 map recalculateFuelCosts(int asset_id)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	if(asset_id == null)
                 	{
                 		resp.put("message","Asset is required.");
                 		return resp;
                 	}
                 	asset_rec = Asset_List[ID == asset_id];
                 	if(asset_rec.ID == null)
                 	{
                 		resp.put("message","Asset not found.");
                 		return resp;
                 	}
                 	total_fuel_costs = 0.0;
                 	fuel_rows = Fuel_Receiving_Voucher[Asset == asset_id];
                 	for each  fr in fuel_rows
                 	{
                 		row_total = round(ifnull(fr.Quantity,0.0) * ifnull(fr.Rate,0.0),2);
                 		total_fuel_costs = total_fuel_costs + row_total;
                 	}
                 	total_fuel_costs = round(total_fuel_costs,2);
                 	asset_rec.Total_Fuel_Costs=total_fuel_costs;
                 	odo_val = ifnull(asset_rec.Odometer_Reading,0.0);
                 	if(odo_val > 0)
                 	{
                 		asset_rec.Fuel_Cost_Per_Odometer=round(total_fuel_costs / odo_val,2);
                 	}
                 	else
                 	{
                 		asset_rec.Fuel_Cost_Per_Odometer=0.0;
                 	}
                 	resp.put("ok",true);
                 	resp.put("message","Fuel costs recalculated.");
                 	resp.put("Total_Fuel_Costs",total_fuel_costs);
                 	return resp;
                 }
				 map syncAssetIssueFromCleanSand(map p)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	// =====================================================
                 	// 1) SOURCE INFORMATION
                 	// =====================================================
                 	source_record_id_text = ifnull(p.get("Source_Record_ID"),"").toString().trim();
                 	source_form = ifnull(p.get("Source_Form"),"").toString().trim();
                 	if(source_record_id_text == "")
                 	{
                 		resp.put("message","Source_Record_ID is required.");
                 		return resp;
                 	}
                 	if(source_form == "")
                 	{
                 		source_form = "Clean Sand Management - Asset Issues";
                 	}
                 	if(source_form != "Clean Sand Management - Asset Issues")
                 	{
                 		resp.put("message","Invalid Source_Form for Clean Sand Asset Issue synchronization.");
                 		return resp;
                 	}
                 	source_record_id = 0;
                 	try 
                 	{
                 		source_record_id = source_record_id_text.toLong();
                 	}	catch (error)
                 	{
                 		resp.put("message","Source_Record_ID must be a valid number.");
                 		return resp;
                 	}
                 	incoming_status = ifnull(p.get("Status"),"").toString().trim();
                 	if(incoming_status == "")
                 	{
                 		incoming_status = "Draft";
                 	}
                 	existing_issue = Asset_Issues[Source_Record_ID == source_record_id && Source_Form == source_form];
                 	if(existing_issue.ID != null)
                 	{
                 		existing_issue.Voucher=ifnull(p.get("Voucher"),"");
                 		existing_issue.Reported_By=ifnull(p.get("Reported_By"),"");
                 		existing_issue.Site=ifnull(p.get("Site"),"");
                 		existing_issue.Issue_Number=ifnull(p.get("Issue_Number"),"");
                 		existing_issue.Asset=p.get("Asset");
                 		existing_issue.Display_Name_Asset=ifnull(p.get("Display_Name_Asset"),"");
                 		existing_issue.Current_Site=ifnull(p.get("Current_Site"),"");
                 		existing_issue.Current_Custodian=ifnull(p.get("Current_Custodian"),"");
                 		existing_issue.Odometer_Reading=ifnull(p.get("Odometer_Reading"),0.0);
                 		existing_issue.Reported_Date=p.get("Reported_Date");
                 		existing_issue.Issue=ifnull(p.get("Issue"),"");
                 		existing_issue.Issue_Description=ifnull(p.get("Issue_Description"),"");
                 		existing_issue.Severity=ifnull(p.get("Severity"),"");
                 		current_status = ifnull(existing_issue.Status,"").toString().trim();
                 		stored_status = current_status;
                 		if(incoming_status != "Draft" || current_status == "" || current_status == "Draft")
                 		{
                 			existing_issue.Status=incoming_status;
                 			stored_status = incoming_status;
                 		}
                 		else
                 		{
                 			info "Clean Sand Asset Issue status preserved as " + current_status + ". Incoming Draft status was ignored.";
                 		}
                 		resp.put("ok",true);
                 		resp.put("Asset_Issue_ID",existing_issue.ID);
                 		resp.put("Source_Record_ID",source_record_id);
                 		resp.put("Incoming_Status",incoming_status);
                 		resp.put("Stored_Status",stored_status);
                 		resp.put("message","Asset Issue updated from Clean Sand Management.");
                 		return resp;
                 	}
                 	new_issue_id = insert into Asset_Issues
                 	[
                 		Voucher=ifnull(p.get("Voucher"),"")
                 		Reported_By=ifnull(p.get("Reported_By"),"")
                 		Site=ifnull(p.get("Site"),"")
                 		Issue_Number=ifnull(p.get("Issue_Number"),"")
                 		Asset=p.get("Asset")
                 		Display_Name_Asset=ifnull(p.get("Display_Name_Asset"),"")
                 		Current_Site=ifnull(p.get("Current_Site"),"")
                 		Current_Custodian=ifnull(p.get("Current_Custodian"),"")
                 		Odometer_Reading=ifnull(p.get("Odometer_Reading"),0.0)
                 		Reported_Date=p.get("Reported_Date")
                 		Issue=ifnull(p.get("Issue"),"")
                 		Issue_Description=ifnull(p.get("Issue_Description"),"")
                 		Severity=ifnull(p.get("Severity"),"")
                 		Status=incoming_status
                 		Source_Record_ID=source_record_id
                 		Source_Form=source_form
                 		Added_User=zoho.loginuser
                 	];
                 	resp.put("ok",true);
                 	resp.put("Asset_Issue_ID",new_issue_id);
                 	resp.put("Source_Record_ID",source_record_id);
                 	resp.put("Incoming_Status",incoming_status);
                 	resp.put("Stored_Status",incoming_status);
                 	resp.put("message","Asset Issue synced from Clean Sand Management.");
                 	return resp;
                 }
				 map syncAssetIssueFromConcreteProducts(map p)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	// =====================================================
                 	// 1) SOURCE INFORMATION
                 	// =====================================================
                 	source_record_id_text = ifnull(p.get("Source_Record_ID"),"").toString().trim();
                 	source_form = ifnull(p.get("Source_Form"),"").toString().trim();
                 	if(source_record_id_text == "")
