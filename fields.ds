			Add_Row_Purchase_Order_De as "Add Row Purchase Order Details"
			{
				type =  form
				form = Sand_Purchase_Order

				record event = on add or edit

				on add row of Purchase_Order_Details
				{
					actions 
					{
						custom deluge script
						(
											lineNo = 1;
										for each  poRow in input.Purchase_Order_Details
										{
											// Auto-fill Display Name Purchase Order
											poRow.Display_Name_Purchase_Order=input.Purchase_Order_Number;
											// Auto-fill Display Name Customer
											poRow.Display_Name_Customer=input.Display_Name_Customer;
											// Auto-fill Line Number
											poRow.Line_Number=lineNo;
											lineNo = lineNo + 1;
										}
						)
					}
				}

			}
			Delete_Row_Purchase_Order as "Delete Row Purchase Order Details"
			{
				type =  form
				form = Sand_Purchase_Order

				record event = on add or edit

				on delete row of Purchase_Order_Details
				{
					actions 
					{
						custom deluge script
						(
											lineNo = 1;
										for each  poRow in input.Purchase_Order_Details
										{
											// Auto-fill Display Name Purchase Order
											poRow.Display_Name_Purchase_Order=input.Purchase_Order_Number;
											// Auto-fill Line Number
											poRow.Line_Number=lineNo;
											lineNo = lineNo + 1;
										}
						)
					}
				}

			}
