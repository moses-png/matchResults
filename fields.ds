			On_Job_Selected2 as "On Job Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Job
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// TRUCK MOVEMENT VOUCHER
										// JOB - ON USER INPUT
										// =====================================================
										// =====================================================
										// 1. CLEAR JOB-SPECIFIC VALUES FIRST
										// =====================================================
										input.Card_Source = null;
										input.Card_Masaka = null;
										input.Card_Clean_Sand = null;
										input.Work_Order_Task_Source = null;
										input.Work_Order_Task_Masaka = null;
										input.Work_Order_Task_Freedom_City = null;
										input.Work_Order_Task_Concrete_Products = null;
										input.Work_Order_Task_Clean_Sand = null;
										input.Batch_Number_Masaka = null;
										input.Batch_Number_From = null;
										input.Truck_Movement_Voucher = null;
										input.Task_Location = null;
										input.Small_Notes = null;
										// =====================================================
										// 2. HIDE JOB-SPECIFIC FIELDS
										// =====================================================
										hide Card_Source;
										disable Card_Source;
										hide Card_Masaka;
										disable Card_Masaka;
										hide Card_Clean_Sand;
										disable Card_Clean_Sand;
										hide Work_Order_Task_Source;
										disable Work_Order_Task_Source;
										hide Work_Order_Task_Masaka;
										disable Work_Order_Task_Masaka;
										hide Work_Order_Task_Freedom_City;
										disable Work_Order_Task_Freedom_City;
										hide Work_Order_Task_Concrete_Products;
										disable Work_Order_Task_Concrete_Products;
										hide Work_Order_Task_Clean_Sand;
										disable Work_Order_Task_Clean_Sand;
										hide Batch_Number_Masaka;
										disable Batch_Number_Masaka;
										hide Batch_Number_From;
										disable Batch_Number_From;
										hide Truck_Movement_Voucher;
										disable Truck_Movement_Voucher;
										hide Task_Location;
										disable Task_Location;
										hide Small_Notes;
										disable Small_Notes;
										// =====================================================
										// 3. RESET PICKUP SOURCE
										// =====================================================
										input.Site_From = null;
										input.Site_Location_From = null;
										input.Party_From = null;
										input.Party_Location_From = null;
										input.Display_Name_Site_From = "";
										input.Display_Name_Party_From = "";
										input.Pick_Up_From = "";
										hide Site_From;
										disable Site_From;
										hide Site_Location_From;
										disable Site_Location_From;
										hide Party_From;
										disable Party_From;
										hide Party_Location_From;
										disable Party_Location_From;
										// =====================================================
										// 4. RESET DELIVERY DESTINATION
										// =====================================================
										input.Site_To = null;
										input.Site_Location_To = null;
										input.Party_To = null;
										input.Party_Location_To = null;
										input.Display_Name_Site_To = "";
										input.Display_Name_Party_To = "";
										input.Delivery_To = "";
										hide Site_To;
										disable Site_To;
										hide Site_Location_To;
										disable Site_Location_To;
										hide Party_To;
										disable Party_To;
										hide Party_Location_To;
										disable Party_Location_To;
										// =====================================================
										// 5. JOB SELECTED
										// =====================================================
										if(input.Job != null)
										{
											job_number = ifnull(input.Job.Job_No,"").trim();
											job_name = ifnull(input.Job.Job_Name,"").trim();
											if(job_number != "" && job_name != "")
											{
												input.Display_Name_Job = job_number + " - " + job_name;
											}
											else if(job_number != "")
											{
												input.Display_Name_Job = job_number;
											}
											else
											{
												input.Display_Name_Job = job_name;
											}
											jobNo = job_number;
											show Pick_Up_Section;
											// =================================================
											// TJS01 - CARD SALES
											// =================================================
											if(jobNo == "TJS01")
											{
												show Card_Source;
												enable Card_Source;
												hide Card_Masaka;
												disable Card_Masaka;
												hide Card_Clean_Sand;
												disable Card_Clean_Sand;
												show Site_From;
												disable Site_From;
												show Site_Location_From;
												enable Site_Location_From;
												hide Party_From;
												disable Party_From;
												hide Party_Location_From;
												disable Party_Location_From;
												show Site_To;
												disable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_To;
												disable Party_To;
												hide Party_Location_To;
												disable Party_Location_To;
											}
											// =================================================
											// TJS02 - SERVICE TASK
											// =================================================
											else if(jobNo == "TJS02")
											{
												show Work_Order_Task_Source;
												enable Work_Order_Task_Source;
												hide Work_Order_Task_Masaka;
												disable Work_Order_Task_Masaka;
												hide Work_Order_Task_Freedom_City;
												disable Work_Order_Task_Freedom_City;
												hide Work_Order_Task_Concrete_Products;
												disable Work_Order_Task_Concrete_Products;
												hide Work_Order_Task_Clean_Sand;
												disable Work_Order_Task_Clean_Sand;
												show Task_Location;
												enable Task_Location;
												show Small_Notes;
												enable Small_Notes;
												hide Site_From;
												disable Site_From;
												hide Site_Location_From;
												disable Site_Location_From;
												hide Party_From;
												disable Party_From;
												hide Party_Location_From;
												disable Party_Location_From;
												show Site_To;
												enable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_To;
												disable Party_To;
												hide Party_Location_To;
												disable Party_Location_To;
												hide Work_Order_Task_Masaka;
												disable Work_Order_Task_Masaka;
												hide Work_Order_Task_Freedom_City;
												disable Work_Order_Task_Freedom_City;
												hide Work_Order_Task_Concrete_Products;
												disable Work_Order_Task_Concrete_Products;
												hide Work_Order_Task_Clean_Sand;
												disable Work_Order_Task_Clean_Sand;
											}
											// =================================================
											// TJS03 - STOCK PRODUCTION
											// =================================================
											else if(jobNo == "TJS03")
											{
												show Batch_Number_Masaka;
												enable Batch_Number_Masaka;
												show Site_From;
												disable Site_From;
												show Site_Location_From;
												enable Site_Location_From;
												hide Party_From;
												disable Party_From;
												hide Party_Location_From;
												disable Party_Location_From;
												show Site_To;
												disable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_To;
												disable Party_To;
												hide Party_Location_To;
												disable Party_Location_To;
											}
											// =================================================
											// TJS04 - RETURN TRUCK TO SITE
											// =================================================
											else if(jobNo == "TJS04")
											{
												show Truck_Movement_Voucher;
												enable Truck_Movement_Voucher;
												show Party_From;
												disable Party_From;
												show Party_Location_From;
												enable Party_Location_From;
												hide Site_From;
												disable Site_From;
												hide Site_Location_From;
												disable Site_Location_From;
												show Site_To;
												enable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_To;
												disable Party_To;
												hide Party_Location_To;
												disable Party_Location_To;
											}
											// =================================================
											// OTHER JOBS
											// =================================================
											else
											{
												show Site_From;
												enable Site_From;
												show Site_Location_From;
												enable Site_Location_From;
												show Party_From;
												enable Party_From;
												show Party_Location_From;
												enable Party_Location_From;
												show Site_To;
												enable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												show Party_To;
												enable Party_To;
												show Party_Location_To;
												enable Party_Location_To;
											}
										}
										// =====================================================
										// 6. NO JOB SELECTED
										// =====================================================
										else
										{
											input.Display_Name_Job = "";
											hide Pick_Up_Section;
											show Site_From;
											enable Site_From;
											show Site_Location_From;
											enable Site_Location_From;
											show Party_From;
											enable Party_From;
											show Party_Location_From;
											enable Party_Location_From;
											show Site_To;
											enable Site_To;
											show Site_Location_To;
											enable Site_Location_To;
											show Party_To;
											enable Party_To;
											show Party_Location_To;
											enable Party_Location_To;
										}
										// =====================================================
										// 7. FINAL WORK ORDER TASK VISIBILITY ENFORCEMENT
										// =====================================================
										hide Work_Order_Task_Masaka;
										disable Work_Order_Task_Masaka;
										hide Work_Order_Task_Freedom_City;
										disable Work_Order_Task_Freedom_City;
										hide Work_Order_Task_Concrete_Products;
										disable Work_Order_Task_Concrete_Products;
										hide Work_Order_Task_Clean_Sand;
										disable Work_Order_Task_Clean_Sand;
										if(input.Job != null && ifnull(input.Job.Job_No,"").trim() == "TJS02")
										{
											show Work_Order_Task_Source;
											enable Work_Order_Task_Source;
										}
										else
										{
											hide Work_Order_Task_Source;
											disable Work_Order_Task_Source;
										}
						)
					}
				}

			}
			On_Card_Selected1 as "On Card Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Card_Masaka
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// USER INPUT: SALES VOUCHER
										// =====================================================
										if(input.Card_Masaka != null)
										{
											salesVoucherNo = ifnull(input.Card_Masaka.Sales_Voucher_Number,"").trim();
											numberPlate = ifnull(input.Card_Masaka.Display_Name_Number_Plate,"").trim();
											if(salesVoucherNo != "" && numberPlate != "")
											{
												input.Display_Name_Card = salesVoucherNo + " - " + numberPlate;
												input.Work_Done = "Truck Movement for Sales Voucher " + salesVoucherNo + " - " + numberPlate;
											}
											else if(salesVoucherNo != "")
											{
												input.Display_Name_Card = salesVoucherNo;
												input.Work_Done = "Truck Movement for Sales Voucher " + salesVoucherNo;
											}
											else if(numberPlate != "")
											{
												input.Display_Name_Card = numberPlate;
												input.Work_Done = "Truck Movement for " + numberPlate;
											}
											else
											{
												input.Display_Name_Card = "";
												input.Work_Done = "";
											}
											input.Display_Name_Site_From = ifnull(input.Card_Masaka.Display_Name_Site,"");
											input.Pick_Up_From = ifnull(input.Card_Masaka.Display_Name_Site,"");
											if(input.Card_Masaka.Voucher != null)
											{
												input.Site_From = input.Card_Masaka.Voucher.Site;
											}
											else
											{
												input.Site_From = null;
											}
											// =====================================================
											// SALES VOUCHER GRAND TOTAL AS MATERIAL COST
											// =====================================================
											input.Material_Cost = ifnull(input.Card_Masaka.Grand_Total,0.0);
										}
										else
										{
											input.Display_Name_Card = "";
											input.Work_Done = "";
											input.Site_From = null;
											input.Display_Name_Site_From = "";
											input.Site_Location_From = null;
											input.Pick_Up_From = "";
											input.Material_Cost = 0.0;
										}
										// =====================================================
										// CALCULATE LINE TOTAL
										// =====================================================
										input.Line_Total = round(ifnull(input.Material_Cost,0.0) + ifnull(input.Service_Cost,0.0) + ifnull(input.Fuel_Cost,0.0) + ifnull(input.Labour_Cost,0.0),2);
										// =====================================================
										// CALCULATE COST PER ODOMETER
										// =====================================================
										distance_travelled = ifnull(input.Line_Distance_Travelled,0.0);
										if(distance_travelled > 0)
										{
											input.Cost_Per_Odometer = round(input.Line_Total / distance_travelled,2);
										}
										else
										{
											input.Cost_Per_Odometer = 0.0;
										}
						)
					}
				}

			}
