			Set_Up_Form5 as "Set Up Form"
			{
				type =  form
				form = Document_Key

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// BACK END (CREATE & EDIT)
										// =====================================================
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// =====================================================
										// BACK END USER NAME
										// =====================================================
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			Finalize_On_Edit20 as "Finalize On Edit"
			{
				type =  form
				form = Voucher_Transfer_Register

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// Voucher Transfer Register
										// Finalize On Edit
										// Record Event: Edited
										// Form Event: Successful form submission
										// =====================================
										u = thisapp.audit.getLoginAuditInfo();
										input.Updated_By_Name = u.get("name");
										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
						)
					}
				}

			}
			Set_Up_Form17 as "Set Up Form"
			{
				type =  form
				form = Voucher_Transfer_Register

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// VOUCHER TRANSFER REGISTER
										// SET UP FORM
										// =====================================
										// HIDE BACK END SECTION
										hide Back_End;
										// DISABLE BACK END FIELDS
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// DISABLE SYSTEM CONTROL FIELD
										disable Case_Status;
										// CREATE MODE
										if(input.ID == null)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
										}
										// EDIT MODE
										if(input.ID != null)
										{
											disable Case_Number;
											disable Transport_Date;
											disable How_To_Take_To_Head_Office;
											disable From_Site;
											disable Number_Of_Vouchers;
											disable Source_Form;
											disable Source_Record_ID;
											disable Employee_Taking_To_Head_Office;
											disable To_Site;
										}
						)
					}
				}

			}
			Finalize as "Finalize"
			{
				type =  form
				form = Voucher_Transfer_Register

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// VOUCHER TRANSFER REGISTER
										// FINALIZE ON EDIT
										input.Case_Status = "Open";
										input.Transport_Date = null;
										input.How_To_Take_To_Head_Office = "";
										input.From_Site = "";
										input.Employee_Taking_To_Head_Office = null;
										input.To_Site = "";
										input.Number_Of_Vouchers = null;
										input.Source_Form = "";
										input.Source_Record_ID = null;
										input.Notes = "";
						)
					}
				}

			}
			Full_Validation4 as "Full Validation"
			{
				type =  form
				form = Voucher_Transfer_Register

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.ID != null)
										{
											oldRec = Voucher_Transfer_Register[ID == input.ID];
											if(oldRec.ID != null)
											{
												// Cannot reopen/edit if In Transit
												if(oldRec.Case_Status == "In Transit")
												{
													alert "This Case is currently In Transit and Cannot be Reopened.";
													cancel submit;
												}
												// If it was Closed, reopen it and clear the fields
												if(oldRec.Case_Status == "Closed")
												{
													input.Case_Status = "Open";
													input.Transport_Date = null;
													input.How_To_Take_To_Head_Office = "";
													input.From_Site = "";
													input.Employee_Taking_To_Head_Office = null;
													input.To_Site = "";
													input.Number_Of_Vouchers = null;
													input.Source_Form = "";
													input.Source_Record_ID = null;
													input.Notes = "";
												}
											}
										}
						)
					}
				}

			}
			On_Document_Type_Selected1 as "On Document Type Selected"
			{
				type =  form
				form = Document_Key

				record event = on add or edit

				on user input of Document_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Document_Type == "Physical Voucher")
										{
											input.Next_Number = null;
											disable Next_Number;
										}
										else if(input.Document_Type == "Digital Voucher")
										{
											if(input.Next_Number == null)
											{
												input.Next_Number = 1;
											}
											enable Next_Number;
										}
										else
										{
											input.Next_Number = null;
											disable Next_Number;
										}
						)
					}
				}

			}
