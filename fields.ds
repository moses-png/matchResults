			Set_Up_Form24 as "Set Up Form"
			{
				type =  form
				form = Contact_Email_Update

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Back_End;
										// Disable auto fields
										disable Display_Name_Employee;
										disable Display_Name_Contact_Name_Email;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// Autofill backend fields ONLY on create
										if(input.ID == null)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											input.Created_By_Name = u.get("name");
											input.Created_By_Email = u.get("email");
											input.Created_By_Time = zoho.currenttime;
										}
										// Show/Hide fields
										if(input.Update_Type == "Contact")
										{
											show Contact;
											show Contact_Names;
											hide Email;
										}
										else if(input.Update_Type == "Email")
										{
											show Email;
											hide Contact;
											hide Contact_Names;
										}
										else
										{
											hide Contact;
											hide Contact_Names;
											hide Email;
										}
						)
					}
				}

			}
