		reports
		{
			report All_Employees
			{
				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Employee_Name as "Employee Name"
								Employee_Number as "Employee Number"
								Employee_Type as "Employee Type"
								Gender
								Date_of_Birth as "Date of Birth"
								Father_s_Name as "Father's Name"
								Mother_s_Name as "Mother's Name"
								Date_of_Joining as "Date of Joining"
								Next_of_Kin as "Next of Kin"
								Next_of_Kin_Contact as "Next of Kin Contact"
								National_Identification_Number as "National Identification Number"
								NSSF_Number as "NSSF Number"
								Tax_Identification_Number as "Tax Identification Number"
								Employment_Status as "Employment Status"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock4
						(
		     				title = "Identification"
							fields
							(
								Employee_Number as "Employee Number"
								Employee_Name as "Employee Name"
								Images
								Display_Name_Employee as "Display Name Employee"
								Employee_Type as "Employee Type"
								Employment_Status as "Employment Status"
							)
						)
						datablock5
						(
		     				title = "Personal Details"
							fields
							(
								Images
								Gender
								Date_of_Birth as "Date of Birth"
								Religion
								Father_s_Name as "Father's Name"
								Mother_s_Name as "Mother's Name"
							)
						)
						datablock6
						(
		     				title = "Address & Joining"
							fields
							(
								Home_Address as "Home Address"
								Date_of_Joining as "Date of Joining"
							)
						)
						datablock7
						(
		     				title = "Legal & Statutory"
							fields
							(
								National_Identification_Number as "National Identification Number"
								NSSF_Number as "NSSF Number"
								Tax_Identification_Number as "Tax Identification Number"
							)
						)
						datablock8
						(
		     				title = "Personal Reference"
							fields
							(
								Next_of_Kin as "Next of Kin"
								Next_of_Kin_Contact as "Next of Kin Contact"
								Relationship
							)
						)
						datablock9
						(
							layout type = -1
		     				title = "Contact / Email Update Details"
		     				related field = Contact_Email_Update_Details
							fields
							(
								Update_Date as "Update Date"
								Update_Voucher_Number as "Update Voucher Number"
								Update_Type as "Update Type"
								Contact
								Email
								Contact_Names as "Contact Names"
								Display_Name_Contact_Name_Email as "Display Name Contact Names Email"
								Contact_Email_Status as "Contact Email Status"
							)
						)
						datablock10
						(
							layout type = -1
		     				title = "Employee Department Details"
		     				related field = Employee_Department_Details
							fields
							(
								Company
								Display_Name_Company as "Display Name Company"
								Employee_Department as "Employee Department"
								Display_Name_Employee_Department as "Display Name Employee Department"
								Department_Start_Date as "Department Start Date"
								Department_End_Date as "Department End Date"
								Department_Status as "Department Status"
							)
						)
						datablock11
						(
							layout type = -1
		     				title = "Employee Status Details"
		     				related field = Employee_Status_Details
							fields
							(
								Employee_Status_Voucher_Number as "Employee Status Voucher Number"
								Employee_Status_Date as "Employee Status Date"
								Date_Started as "Date Started"
								Date_Ended as "Date Ended"
								Employee_Registration_Status as "Employee Registration Status"
								Daily_Allowance as "Daily Allowance"
								Weekly_Allowance as "Weekly Allowance"
								Monthly_Salary as "Monthly Salary"
								Estimated_Take_per_day as "Estimated Take per day"
								Estimated_Take_per_month as "Estimated Take per month"
							)
						)
						datablock12
