	 			row = 1
	 			column = 1   
				width = medium
			)
			Odometer_Reading
			(
				type = decimal
				displayname = "Odometer Reading"
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reported_Date
			(
    			type = datetime
				displayname = "Reported Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Description
			(
    			type = textarea
				displayname = "Issue Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Severity
			(
				type = picklist
				maxchar = 100
				values = {"Low","Medium","High","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Draft","Open","In Progress","Resolved","Closed"}
