			Full_Validation6 as "Full Validation"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// VOUCHER REGISTER VALIDATION + STATUS MOVEMENT
										// =====================================================
										errors = "";
										is_create = input.ID == null;
										now_ts = zoho.currenttime;
										ADMIN_EMAIL = "xenotime15@gmail.com";
										is_admin = zoho.loginuser == ADMIN_EMAIL;
										// =====================================================
										// 1. GET VOUCHER TYPE
										// =====================================================
										voucherType = "";
										if(input.Voucher_Type != null)
										{
											voucherType = ifnull(input.Voucher_Type.Voucher_Type,"").trim();
										}
										input.Display_Name_Voucher_Type = voucherType;
										// =====================================================
										// 2. LOAD OLD RECORD DETAILS
										// =====================================================
										oldRec = null;
										original_status = "Issued";
										if(!is_create)
										{
											oldRec = Voucher_Register[ID == input.ID];
											if(oldRec.ID != null)
											{
												original_status = ifnull(oldRec.Voucher_Status,"Issued");
											}
										}
										// =====================================================
										// 3. BASIC VALIDATIONS
										// =====================================================
										if(!is_admin)
										{
											if(input.Site == null)
											{
												errors = errors + "\n• Site is required.";
											}
											if(input.Document_Type == null || input.Document_Type.trim() == "")
											{
												errors = errors + "\n• Document Type is required.";
											}
											if(input.Voucher_Type == null)
											{
												errors = errors + "\n• Voucher Type is required.";
											}
											if(input.Employee == null)
											{
												errors = errors + "\n• Employee is required.";
											}
											if(is_create && voucherType != "Supervisor Voucher")
											{
												if(input.Issued_By == null)
												{
													errors = errors + "\n• Issued By is required.";
												}
											}
										}
										// =====================================================
										// 3A. PREVENT DUPLICATE VOUCHER NUMBERS
										// =====================================================
										voucher_number_text = ifnull(input.Voucher_Number,"").trim();
										if(voucher_number_text != "")
										{
											duplicate_found = false;
											if(is_create)
											{
												duplicate_voucher = Voucher_Register[Voucher_Number == voucher_number_text];
												if(duplicate_voucher.ID != null)
												{
													duplicate_found = true;
												}
											}
											else
											{
												duplicate_voucher = Voucher_Register[Voucher_Number == voucher_number_text && ID != input.ID];
												if(duplicate_voucher.ID != null)
												{
													duplicate_found = true;
												}
											}
											if(duplicate_found)
											{
												errors = errors + "\n• Voucher Number '" + voucher_number_text + "' already exists. Please enter a different Voucher Number.";
											}
										}
										// =====================================================
										// 3B. PREVENT NEW VOUCHER WHEN PREVIOUS ONE IS NOT RETURNED
										// =====================================================
										if(is_create && input.Employee != null && input.Voucher_Type != null && voucherType != "Supervisor Voucher")
										{
											previous_voucher_found = false;
											previous_voucher_number = "";
											previous_voucher_date = null;
											previous_voucher_status = "";
											for each  previous_voucher in Voucher_Register[Employee == input.Employee && Voucher_Type == input.Voucher_Type && Voucher_Status == "Issued"] sort by Date_Time_In desc
											{
												previous_voucher_found = true;
												previous_voucher_number = ifnull(previous_voucher.Voucher_Number,"");
												previous_voucher_date = previous_voucher.Date_Time_In;
												previous_voucher_status = ifnull(previous_voucher.Voucher_Status,"Issued");
												break;
											}
											if(previous_voucher_found)
											{
												previous_details = "";
												if(previous_voucher_number != "")
												{
													previous_details = previous_details + " Voucher: " + previous_voucher_number + ".";
												}
												if(previous_voucher_date != null)
												{
													previous_details = previous_details + " Issued on: " + previous_voucher_date.toString("dd-MMM-yyyy HH:mm") + ".";
												}
												errors = errors + "\n• This employee already has an unreturned " + voucherType + " voucher." + previous_details + " Return the previous voucher.";
											}
										}
										// =====================================================
										// 3C. PREVENT MULTIPLE OPEN SUPERVISOR VOUCHERS
										// =====================================================
										if(is_create && voucherType == "Supervisor Voucher" && input.Employee != null)
										{
											open_supervisor_found = false;
											open_supervisor_number = "";
											open_supervisor_date = null;
											for each  open_sup in Voucher_Register[Employee == input.Employee && Voucher_Type == input.Voucher_Type && Voucher_Status == "Issued"] sort by Date_Time_In desc
											{
												open_supervisor_found = true;
												open_supervisor_number = ifnull(open_sup.Voucher_Number,"");
												open_supervisor_date = open_sup.Date_Time_In;
												break;
											}
											if(open_supervisor_found)
											{
												open_details = "";
												if(open_supervisor_number != "")
												{
													open_details = " Voucher: " + open_supervisor_number + ".";
												}
												if(open_supervisor_date != null)
												{
													open_details = open_details + " Opened on: " + open_supervisor_date.toString("dd-MMM-yyyy HH:mm") + ".";
												}
												errors = errors + "\n• You Already have an open Supervisor Voucher." + open_details + " Close the Previous Voucher Before Opening Another one.";
											}
										}
										// =====================================================
										// 4. PHYSICAL VOUCHER PREFIX VALIDATION
										// =====================================================
										if(input.Document_Type == "Physical Voucher" && input.Voucher_Type != null)
										{
											expectedPrefix = ifnull(input.Voucher_Type.Prefix,"").trim().toUpperCase();
											voucherTypeName = ifnull(input.Voucher_Type.Voucher_Type,"");
											voucherNo = ifnull(input.Voucher_Number,"").trim().toUpperCase();
											if(expectedPrefix != "" && !voucherNo.startsWith(expectedPrefix))
											{
												errors = errors + "\n• Voucher Number for '" + voucherTypeName + "' must start with '" + expectedPrefix + "'.";
											}
										}
										// =====================================================
										// 5. DATE VALIDATION
										// =====================================================
										if(!is_create && input.Date_Time_Out != null)
										{
											if(input.Date_Time_In != null && input.Date_Time_In > input.Date_Time_Out)
											{
												errors = errors + "\n• Date-Time In cannot be greater than Date-Time Out.";
											}
											if(input.Date_Time_Out > now_ts)
											{
												errors = errors + "\n• Date-Time Out cannot be in the future.";
											}
										}
										// =====================================================
										// 6. STATUS-BASED VALIDATIONS
										// =====================================================
										st = ifnull(input.Voucher_Status,"Issued");
										if(!is_create && st == "Issued" && voucherType != "Supervisor Voucher")
										{
											if(input.Received_By == null)
											{
												errors = errors + "\n• Received By is required.";
											}
										}
										if(!is_create && voucherType == "Supervisor Voucher" && st == "Closed")
										{
											if(input.Employee_Taking_To_Head_Office == null)
											{
												errors = errors + "\n• Employee Taking To Head Office is required.";
											}
											if(input.How_to_Take_to_Head_Office == null || input.How_to_Take_to_Head_Office.trim() == "")
											{
												errors = errors + "\n• How To Take To Head Office is required.";
											}
											case_no = ifnull(input.Case_Number,"").trim();
											if(case_no == "")
											{
												errors = errors + "\n• Case Number is required.";
											}
											else
											{
												new_transport_date = zoho.currentdate;
												if(input.Time_Sent_to_Head_Office != null)
												{
													new_transport_date = input.Time_Sent_to_Head_Office.toDate();
												}
												case_data = Map();
												case_data.put("case_no",case_no);
												case_data.put("transport_date",new_transport_date);
												case_check = employee_management.checkVoucherTransferCase(case_data);
												if(case_check != null && case_check.get("ok") == false)
												{
													errors = errors + "\n• " + case_check.get("message");
												}
											}
										}
										if(st == "Head Office")
										{
											if(input.Seen == null)
											{
												errors = errors + "\n• Seen is required.";
											}
											else if(input.Seen == false && input.Reason_for_not_Seen == null || input.Reason_for_not_Seen.trim() == "")
											{
												errors = errors + "\n• Reason for not Seen is required.";
											}
											else if(input.Seen == true && input.Reason_for_not_Seen != null && input.Reason_for_not_Seen.trim() != "")
											{
												errors = errors + "\n• Reason for not Seen must be empty.";
											}
										}
										// =====================================================
										// 7. CANCELLATION VALIDATION
										// =====================================================
										if(input.Cancel_Voucher == true)
										{
											if(input.Cancellation_Reason == null || input.Cancellation_Reason.trim() == "")
											{
												errors = errors + "\n• Cancellation Reason is required.";
											}
										}
										else
										{
											input.Cancellation_Reason = "";
										}
										// =====================================================
										// 9. STATUS MOVEMENT BEFORE SAVE
										// =====================================================
										if(errors == "")
										{
											if(is_create)
											{
												input.Voucher_Status = "Issued";
												if(input.Date_Time_In == null)
												{
													input.Date_Time_In = now_ts;
												}
											}
											else
											{
												if(original_status != "Cancelled")
												{
													if(original_status == "Issued")
													{
														if(input.Date_Time_Out == null)
														{
															input.Date_Time_Out = now_ts;
														}
														if(input.Date_Time_In != null && input.Date_Time_Out != null)
														{
															ms = input.Date_Time_Out.toLong() - input.Date_Time_In.toLong();
															if(ms >= 0)
															{
																input.Hours_Worked = (ms / (1000.0 * 60.0 * 60.0)).round(2);
															}
															else
															{
																input.Hours_Worked = null;
															}
														}
														if(voucherType == "Supervisor Voucher")
														{
															input.Voucher_Status = "Closed";
														}
														else
														{
															input.Voucher_Status = "Returned";
														}
													}
													else if(original_status == "Closed")
													{
														if(input.Cancel_Voucher == true)
														{
															input.Voucher_Status = "Cancelled";
														}
														else if(voucherType == "Supervisor Voucher")
														{
															if(input.Manager_Time == null)
															{
																input.Manager_Time = now_ts;
															}
															if(input.Time_Sent_to_Head_Office == null)
															{
																input.Time_Sent_to_Head_Office = now_ts;
															}
															input.Voucher_Status = "Head Office";
														}
													}
													else if(original_status == "Returned")
													{
														if(input.Cancel_Voucher == true)
														{
															input.Voucher_Status = "Cancelled";
														}
														else
														{
															if(input.Manager_Time == null)
															{
																input.Manager_Time = now_ts;
															}
															input.Voucher_Status = "Head Office";
														}
													}
													else if(original_status == "Head Office")
													{
														if(input.Seen == true)
														{
															if(input.Time_Checked == null)
															{
																input.Time_Checked = now_ts;
															}
															input.Reason_for_not_Seen = "";
															input.Voucher_Status = "Human Resource";
														}
														else
														{
															reason_not_seen = ifnull(input.Reason_for_not_Seen,"").trim();
															if(reason_not_seen != "")
															{
																if(input.Time_Checked == null)
																{
																	input.Time_Checked = now_ts;
																}
																input.Voucher_Status = "Human Resource";
															}
															else
															{
																input.Voucher_Status = "Head Office";
															}
														}
													}
													else if(original_status == "Human Resource")
													{
														if(input.Hr_Time_Checked == null)
														{
															input.Hr_Time_Checked = now_ts;
														}
														input.Voucher_Status = "Audited";
													}
												}
											}
										}
										// =====================================================
										// 10. FINAL GATE
										// =====================================================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize as "Finalize"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ON SUCCESS FINALIZE
										// =====================================================
										// SECTION 1a: DIGITAL VOUCHER NUMBER
										// =====================================================
										voucher_no = ifnull(input.Voucher_Number,"").trim();
										if(input.Document_Type == "Digital Voucher" && input.Voucher_Type != null && voucher_no == "")
										{
											vno = employee_management.Generate_Voucher_Number(input.Voucher_Type.ID);
											if(vno != null && vno != "" && vno != "LIMIT_REACHED")
											{
												input.Voucher_Number = vno;
												if(input.ID != null)
												{
													rec = Voucher_Register[ID == input.ID];
													if(rec.ID != null)
													{
														rec.Voucher_Number=vno;
													}
												}
											}
										}
										// =====================================================
										// SECTION 1b: VARIABLES
										// =====================================================
										now_ts = zoho.currenttime;
										case_no = "";
										case_no_final = "";
										detailText = "";
										transport_dt = now_ts;
										total_vouchers = 0;
										employee_take_name = "";
										voucherType = "";
										if(input.Voucher_Type != null)
										{
											voucherType = ifnull(input.Voucher_Type.Voucher_Type,"").trim();
										}
										input.Display_Name_Voucher_Type = voucherType;
										bill_details_date = zoho.currentdate;
										if(input.Date_Time_In != null)
										{
											bill_details_date = input.Date_Time_In.toDate();
										}
										// =====================================================
										// SECTION 2: DISPLAY NAMES
										// =====================================================
										if(input.Issued_By != null)
										{
											input.Display_Name_Issued_By = ifnull(input.Issued_By.Voucher_Number,"") + " - " + ifnull(input.Issued_By.Display_Name_Employee,"");
										}
										else
										{
											input.Display_Name_Issued_By = null;
										}
										if(input.Site != null)
										{
											input.Display_Name_Site = input.Site.Display_Name_Asset_Name;
										}
										else
										{
											input.Display_Name_Site = null;
										}
										if(input.Employee != null && input.Employee.Employee_Name != null && input.Employee.Employee_Number != null)
										{
											input.Display_Name_Employee = input.Employee.Employee_Name.toString() + " - " + input.Employee.Employee_Number.trim();
										}
										else
										{
											input.Display_Name_Employee = null;
										}
										if(input.Issued_By != null || input.Received_By != null)
										{
											thisapp.voucher.update_supervisor_voucher_summary(input.ID);
										}
										// ============================================================================
										// SECTION 3: CASE / TRANSFER REGISTER + DOCUMENT TRANSPORT BILL
										// ============================================================================
										if(input.ID != null && input.Voucher_Status == "Head Office" && voucherType == "Supervisor Voucher")
										{
											case_no = ifnull(input.Case_Number,"").trim();
											case_no_final = case_no;
											if(input.Time_Sent_to_Head_Office != null)
											{
												transport_dt = input.Time_Sent_to_Head_Office;
											}
											if(input.Employee_Taking_To_Head_Office != null)
											{
												employee_take_name = ifnull(input.Employee_Taking_To_Head_Office.Employee_Name,"") + " - " + ifnull(input.Employee_Taking_To_Head_Office.Employee_Number,"");
											}
											if(case_no != "")
											{
												attached_count = 0;
												detailText = "";
												attachedVouchers = Voucher_Register[Issued_By.Voucher_Number == input.Voucher_Number];
												for each  av in attachedVouchers
												{
													av.Case_Number=case_no;
													attached_count = attached_count + 1;
													detailText = detailText + ifnull(av.Voucher_Number,"") + " - " + ifnull(av.Display_Name_Voucher_Type,"") + " - " + ifnull(av.Display_Name_Employee,"") + "\n";
												}
												total_vouchers = attached_count + 1;
												syncInput = Map();
												syncInput.put("Case_Number",case_no);
												syncInput.put("Transport_Date",transport_dt);
												syncInput.put("How_To_Take_To_Head_Office",ifnull(input.How_to_Take_to_Head_Office,""));
												syncInput.put("From_Site",ifnull(input.Display_Name_Site,""));
												syncInput.put("Employee_Taking_To_Head_Office",employee_take_name);
												syncInput.put("Source_Record_ID",input.ID);
												syncInput.put("Number_Of_Vouchers",total_vouchers);
												syncResp = employee_management.syncManagewiseVoucherTransferRegister(syncInput);
											}
											if(input.How_to_Take_to_Head_Office == "Transport Required")
											{
												if(input.Employee_Taking_To_Head_Office != null)
												{
													if(detailText == null || detailText == "")
													{
														detailText = "";
														issuedVouchers = Voucher_Register[Issued_By.Voucher_Number == input.Voucher_Number];
														for each  v in issuedVouchers
														{
															detailText = detailText + ifnull(v.Voucher_Number,"") + " - " + ifnull(v.Display_Name_Voucher_Type,"") + " - " + ifnull(v.Display_Name_Employee,"") + "\n";
														}
													}
													refVal = input.Voucher_Number + " - " + ifnull(input.Employee_Taking_To_Head_Office.Employee_Name,"") + " - " + ifnull(input.Employee_Taking_To_Head_Office.Employee_Number,"");
													existingBD = Bill_Details[Reference == refVal && Source_Record_ID == input.ID && Source_Form == "Kicks Klean Ug - Supervisor Voucher" && Expense_Type == "Document Transport"];
													if(existingBD.count() == 0)
													{
														insert into Bill_Details
														[
															Details_Date=bill_details_date
															Reference=refVal
															Details=detailText
															Expense_Type="Document Transport"
															Quantity=1.00
															Account=input.Display_Name_Site
															Current_Site=input.Display_Name_Site
															Source_Record_ID=input.ID
															Source_Form="Kicks Klean Ug - Supervisor Voucher"
															Bill_Details_Status="Draft"
															Added_User=zoho.loginuser
														]
													}
												}
											}
										}
										// =====================================================
										// SECTION 6E: CREATE EMPLOYEE BILL
										// =====================================================
										if(input.ID != null)
										{
											bill_record_ready = false;
											if(input.Employee != null)
											{
												vDate = zoho.currentdate;
												if(input.Date_Time_In != null)
												{
													vDate = input.Date_Time_In.toDate();
												}
												sourceVal = ifnull(input.Display_Name_Employee,"").trim();
												accountVal = ifnull(input.Display_Name_Site,"").trim();
												siteVal = ifnull(input.Display_Name_Site,"").trim();
												if(accountVal == "")
												{
													accountVal = "Unassigned Account";
												}
												employee_id = input.Employee.ID;
												empName = ifnull(input.Employee.Employee_Name,"").trim();
												empNumber = "";
												employee_number_value = 0;
												if(input.Employee.Employee_Number != null)
												{
													empNumber = input.Employee.Employee_Number.toString();
													employee_number_value = input.Employee.Employee_Number;
												}
												displayVendorName = empName;
												if(empNumber != "")
												{
													displayVendorName = empName + " - " + empNumber;
												}
												billName = displayVendorName;
												dailyAllowance = 0.0;
												weeklyAllowance = 0.0;
												monthlySalary = 0.0;
												allowanceInput = Map();
												allowanceInput.put("Employee_ID",employee_id);
												allowanceResp = employee_management.getEmployeeActiveAllowance(allowanceInput);
												if(allowanceResp != null)
												{
													dailyAllowance = ifnull(allowanceResp.get("Daily_Allowance"),0.0);
													weeklyAllowance = ifnull(allowanceResp.get("Weekly_Allowance"),0.0);
													monthlySalary = ifnull(allowanceResp.get("Monthly_Salary"),0.0);
												}
												day_start_text = vDate.toString("yyyy-MM-dd") + " 00:00:00";
												day_end_text = vDate.addDay(1).toString("yyyy-MM-dd") + " 00:00:00";
												day_start = day_start_text.toDateTime("yyyy-MM-dd HH:mm:ss");
												day_end = day_end_text.toDateTime("yyyy-MM-dd HH:mm:ss");
												dailyVoucherReference = "";
												dailyVoucherDetails = "";
												employeeDayVouchers = Voucher_Register[Employee == employee_id && Date_Time_In >= day_start && Date_Time_In < day_end];
												for each  vr in employeeDayVouchers
												{
													vrNumber = ifnull(vr.Voucher_Number,"").trim();
													vrType = ifnull(vr.Display_Name_Voucher_Type,"").trim();
													if(vrNumber != "")
													{
														if(dailyVoucherReference == "")
														{
															dailyVoucherReference = vrNumber;
														}
														else
														{
															if(!dailyVoucherReference.contains(vrNumber))
															{
																dailyVoucherReference = dailyVoucherReference + ", " + vrNumber;
															}
														}
														voucherLine = vrNumber;
														if(vrType != "")
														{
															voucherLine = voucherLine + " - " + vrType;
														}
														if(dailyVoucherDetails == "")
														{
															dailyVoucherDetails = voucherLine;
														}
														else
														{
															if(!dailyVoucherDetails.contains(voucherLine))
															{
																dailyVoucherDetails = dailyVoucherDetails + "\n" + voucherLine;
															}
														}
													}
												}
												if(dailyVoucherReference == "")
												{
													dailyVoucherReference = ifnull(input.Voucher_Number,"").trim();
												}
												if(dailyVoucherDetails == "")
												{
													dailyVoucherDetails = ifnull(input.Voucher_Number,"").trim();
													currentVoucherType = ifnull(input.Display_Name_Voucher_Type,"").trim();
													if(currentVoucherType != "")
													{
														dailyVoucherDetails = dailyVoucherDetails + " - " + currentVoucherType;
													}
												}
												if(dailyAllowance > 0 || weeklyAllowance > 0)
												{
													periodResp = thisapp.billing.getEmployeeBillPeriod(vDate,"Weekly Payment");
													if(periodResp != null)
													{
														billDate = periodResp.get("Bill_Date");
														billNumber = periodResp.get("Bill_Number");
														existingBill = Bill[Employee_Vendor == employee_id && Bill_Number == billNumber && Bill_Type == "Employee Bill"];
														employeeBillID = null;
														if(existingBill.ID != null)
														{
															employeeBillID = existingBill.ID;
															existingBill.Bill_Date=billDate;
															existingBill.Bill_Name=billName;
															existingBill.Display_Name_Vendor=displayVendorName;
															existingBill.Employee_Vendor=employee_id;
															existingBill.Bill_Type="Employee Bill";
														}
														else
														{
															employeeBillID = insert into Bill
															[
																Bill_Date=billDate
																Bill_Type="Employee Bill"
																Employee_Vendor=employee_id
																Display_Name_Vendor=displayVendorName
																Bill_Name=billName
																Bill_Number=billNumber
																Bill_Status="Draft"
																Payment_Status="Not Paid"
																Added_User=zoho.loginuser
															];
														}
														if(employeeBillID != null)
														{
															existingDailyWeekly = Bill_Details[Bill == employeeBillID && Details_Date == vDate && Expense_Type == "Weekly Payment"];
															weeklyDetailText = "";
															weeklyDetailText = "Date: " + vDate.toString("dd-MMM-yyyy");
															weeklyDetailText = weeklyDetailText + "\nEmployee: " + displayVendorName;
															weeklyDetailText = weeklyDetailText + "\nSite: " + siteVal;
															weeklyDetailText = weeklyDetailText + "\nWeek: " + billNumber;
															weeklyDetailText = weeklyDetailText + "\n\nVouchers:";
															weeklyDetailText = weeklyDetailText + "\n" + dailyVoucherDetails;
															if(existingDailyWeekly.count() == 0)
															{
																newWeeklyDetailID = insert into Bill_Details
																[
																	Bill=employeeBillID
																	Display_Name_Bill=billName + " - " + billNumber
																	Details_Date=vDate
																	Source=sourceVal
																	Reference=dailyVoucherReference
																	Details=weeklyDetailText
																	Expense_Type="Weekly Payment"
																	Quantity=1.00
																	Account=accountVal
																	Current_Site=siteVal
																	Source_Record_ID=input.ID
																	Source_Form="Kicks Klean Ug - Voucher Register"
																	Bill_Details_Status="Draft"
																	Added_User=zoho.loginuser
																];
																if(newWeeklyDetailID != null)
																{
																	bill_record_ready = true;
																}
															}
															else
															{
																for each  weeklyBD in existingDailyWeekly
																{
																	weeklyBD.Reference=dailyVoucherReference;
																	weeklyBD.Details=weeklyDetailText;
																	weeklyBD.Quantity=1.00;
																	weeklyBD.Source=sourceVal;
																	weeklyBD.Account=accountVal;
																	weeklyBD.Current_Site=siteVal;
																	weeklyBD.Display_Name_Bill=billName + " - " + billNumber;
																	bill_record_ready = true;
																	break;
																}
															}
														}
													}
												}
												specialMonthlyEmployee = false;
												if(employee_number_value >= 10000 && employee_number_value <= 20000)
												{
													specialMonthlyEmployee = true;
												}
												if(monthlySalary > 0 && specialMonthlyEmployee == false)
												{
													monthlyPeriodResp = thisapp.billing.getEmployeeBillPeriod(vDate,"Monthly Payment");
													if(monthlyPeriodResp != null)
													{
														monthlyBillDate = monthlyPeriodResp.get("Bill_Date");
														monthlyReference = monthlyPeriodResp.get("Bill_Number");
														existingMonthlyBill = Bill[Employee_Vendor == employee_id && Bill_Number == monthlyReference && Bill_Type == "Employee Bill"];
														monthlyBillID = null;
														if(existingMonthlyBill.ID != null)
														{
															monthlyBillID = existingMonthlyBill.ID;
															existingMonthlyBill.Bill_Date=monthlyBillDate;
															existingMonthlyBill.Bill_Type="Employee Bill";
															existingMonthlyBill.Employee_Vendor=employee_id;
															existingMonthlyBill.Display_Name_Vendor=displayVendorName;
															existingMonthlyBill.Bill_Name=billName;
															existingMonthlyBill.Bill_Number=monthlyReference;
														}
														else
														{
															monthlyBillID = insert into Bill
															[
																Bill_Date=monthlyBillDate
																Bill_Type="Employee Bill"
																Employee_Vendor=employee_id
																Display_Name_Vendor=displayVendorName
																Bill_Name=billName
																Bill_Number=monthlyReference
																Bill_Status="Draft"
																Payment_Status="Not Paid"
																Added_User=zoho.loginuser
															];
														}
														if(monthlyBillID != null)
														{
															existingDailyMonthly = Bill_Details[Bill == monthlyBillID && Details_Date == vDate && Expense_Type == "Monthly Payment"];
															monthlyDetailText = "";
															monthlyDetailText = "Date: " + vDate.toString("dd-MMM-yyyy");
															monthlyDetailText = monthlyDetailText + "\nEmployee: " + displayVendorName;
															monthlyDetailText = monthlyDetailText + "\nSite: " + siteVal;
															monthlyDetailText = monthlyDetailText + "\nMonth: " + monthlyReference;
															monthlyDetailText = monthlyDetailText + "\nMonthly Salary: " + monthlySalary.toString();
															monthlyDetailText = monthlyDetailText + "\n\nVouchers:";
															monthlyDetailText = monthlyDetailText + "\n" + dailyVoucherDetails;
															if(existingDailyMonthly.count() == 0)
															{
																newMonthlyDetailID = insert into Bill_Details
																[
																	Bill=monthlyBillID
																	Display_Name_Bill=billName + " - " + monthlyReference
																	Details_Date=vDate
																	Source=sourceVal
																	Reference=dailyVoucherReference
																	Details=monthlyDetailText
																	Expense_Type="Monthly Payment"
																	Quantity=1.00
																	Account=accountVal
																	Current_Site=siteVal
																	Source_Record_ID=input.ID
																	Source_Form="Kicks Klean Ug - Voucher Register"
																	Bill_Details_Status="Draft"
																	Added_User=zoho.loginuser
																];
																if(newMonthlyDetailID != null)
																{
																	bill_record_ready = true;
																}
															}
															else
															{
																for each  monthlyBD in existingDailyMonthly
																{
																	monthlyBD.Reference=dailyVoucherReference;
																	monthlyBD.Details=monthlyDetailText;
																	monthlyBD.Quantity=1.00;
																	monthlyBD.Source=sourceVal;
																	monthlyBD.Account=accountVal;
																	monthlyBD.Current_Site=siteVal;
																	monthlyBD.Display_Name_Bill=billName + " - " + monthlyReference;
																	bill_record_ready = true;
																	break;
																}
															}
														}
													}
												}
												if(monthlySalary > 0 && specialMonthlyEmployee == true)
												{
													specialEmployees = List();
													qualifiedSpecialEmployees = List();
													rejectedSpecialEmployees = List();
													supervisorVoucherList = List();
													specialDetailText = "";
													specialEmployeeCount = 0;
													siteVouchers = Voucher_Register[Display_Name_Site == siteVal && Date_Time_In >= day_start && Date_Time_In < day_end && Employee != null];
													for each  siteVoucher in siteVouchers
													{
														thisEmployeeNumber = 0;
														if(siteVoucher.Employee.Employee_Number != null)
														{
															thisEmployeeNumber = siteVoucher.Employee.Employee_Number;
														}
														if(thisEmployeeNumber >= 10000 && thisEmployeeNumber <= 20000)
														{
															thisEmployeeID = siteVoucher.Employee.ID;
															thisEmployeeKey = thisEmployeeID.toString();
															if(!qualifiedSpecialEmployees.contains(thisEmployeeKey) && !rejectedSpecialEmployees.contains(thisEmployeeKey))
															{
																thisAllowanceInput = Map();
																thisAllowanceInput.put("Employee_ID",thisEmployeeID);
																thisAllowanceResp = employee_management.getEmployeeActiveAllowance(thisAllowanceInput);
																thisMonthlySalary = 0.0;
																if(thisAllowanceResp != null)
																{
																	thisMonthlySalary = ifnull(thisAllowanceResp.get("Monthly_Salary"),0.0);
																}
																if(thisMonthlySalary > 0)
																{
																	qualifiedSpecialEmployees.add(thisEmployeeKey);
																}
																else
																{
																	rejectedSpecialEmployees.add(thisEmployeeKey);
																}
															}
															if(qualifiedSpecialEmployees.contains(thisEmployeeKey))
															{
																thisEmployeeName = ifnull(siteVoucher.Employee.Employee_Name,"").trim();
																thisEmployeeDisplay = thisEmployeeName;
																if(thisEmployeeNumber > 0)
																{
																	thisEmployeeDisplay = thisEmployeeName + " - " + thisEmployeeNumber.toString();
																}
																if(!specialEmployees.contains(thisEmployeeKey))
																{
																	specialEmployees.add(thisEmployeeKey);
																	specialEmployeeCount = specialEmployeeCount + 1;
																	if(specialDetailText != "")
																	{
																		specialDetailText = specialDetailText + "\n";
																	}
																	specialDetailText = specialDetailText + "\n" + thisEmployeeDisplay;
																}
																thisVoucherNumber = ifnull(siteVoucher.Voucher_Number,"").trim();
																thisVoucherType = ifnull(siteVoucher.Display_Name_Voucher_Type,"").trim();
																if(thisVoucherNumber != "")
																{
																	thisVoucherLine = "  - " + thisVoucherNumber;
																	if(thisVoucherType != "")
																	{
																		thisVoucherLine = thisVoucherLine + " - " + thisVoucherType;
																	}
																	if(!specialDetailText.contains(thisVoucherLine))
																	{
																		specialDetailText = specialDetailText + "\n" + thisVoucherLine;
																	}
																}
																thisSupervisorVoucher = ifnull(siteVoucher.Display_Name_Issued_By,"").trim();
																if(thisSupervisorVoucher != "")
																{
																	if(!supervisorVoucherList.contains(thisSupervisorVoucher))
																	{
																		supervisorVoucherList.add(thisSupervisorVoucher);
																	}
																}
															}
														}
													}
													specialReference = "";
													for each  supervisorVoucher in supervisorVoucherList
													{
														if(specialReference == "")
														{
															specialReference = supervisorVoucher;
														}
														else
														{
															specialReference = specialReference + ", " + supervisorVoucher;
														}
													}
													if(specialEmployeeCount > 0)
													{
														specialMonthlyText = "";
														specialMonthlyText = "Date: " + vDate.toString("dd-MMM-yyyy");
														specialMonthlyText = specialMonthlyText + "\nSite: " + siteVal;
														specialMonthlyText = specialMonthlyText + "\nEmployees: " + specialEmployeeCount.toString();
														specialMonthlyText = specialMonthlyText + "\n\nEmployees / Vouchers:";
														specialMonthlyText = specialMonthlyText + specialDetailText;
														existingSpecialMonthly = Bill_Details[Details_Date == vDate && Current_Site == siteVal && Expense_Type == "Monthly Payment" && Source_Form == "Kicks Klean Ug - Voucher Register" && Bill == null];
														if(existingSpecialMonthly.count() == 0)
														{
															newSpecialMonthlyDetailID = insert into Bill_Details
															[
																Details_Date=vDate
																Source=siteVal
																Reference=specialReference
																Details=specialMonthlyText
																Expense_Type="Monthly Payment"
																Quantity=specialEmployeeCount
																Account=accountVal
																Current_Site=siteVal
																Source_Record_ID=input.ID
																Source_Form="Kicks Klean Ug - Voucher Register"
																Bill_Details_Status="Draft"
																Added_User=zoho.loginuser
															];
															if(newSpecialMonthlyDetailID != null)
															{
																bill_record_ready = true;
															}
														}
														else
														{
															for each  specialBD in existingSpecialMonthly
															{
																specialBD.Reference=specialReference;
																specialBD.Details=specialMonthlyText;
																specialBD.Quantity=specialEmployeeCount;
																specialBD.Account=accountVal;
																specialBD.Current_Site=siteVal;
																specialBD.Source=siteVal;
																bill_record_ready = true;
																break;
															}
														}
													}
												}
											}
										}
										// =====================================================
										// SECTION 5: UPDATE TRANSFER REGISTER COUNT
										// =====================================================
										case_no_final = ifnull(input.Case_Number,"").trim();
										if(case_no_final != "")
										{
											employee_management.updateVoucherTransferRegisterCount(case_no_final);
										}
										// =====================================================
										// SECTION 6: RECALCULATE COSTS AND QUANTITY CREATED
										// =====================================================
										if(input.ID != null)
										{
											thisapp.recalculateVoucherMaterialsCost(input.ID);
										}
						)
					}
				}

			}
