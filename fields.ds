			On_Work_Order_Task_Source as "On Work Order Task Source Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Work_Order_Task_Source
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// WORK ORDER TASK SOURCE - ON USER INPUT
										// =====================================================
										input.Work_Done = "";
										input.Site_From = null;
										input.Display_Name_Site_From = "";
										input.Site_Location_From = null;
										input.Pick_Up_From = "";
										input.Party_From = null;
										input.Display_Name_Party_From = "";
										input.Party_Location_From = null;
										// =====================================================
										// 1. CLEAR NON-SELECTED TASK LOOKUPS FIRST
										// =====================================================
										if(input.Work_Order_Task_Source == "Masaka Sites")
										{
											input.Work_Order_Task_Freedom_City = null;
											input.Work_Order_Task_Concrete_Products = null;
											input.Work_Order_Task_Clean_Sand = null;
										}
										else if(input.Work_Order_Task_Source == "Freedom City")
										{
											input.Work_Order_Task_Masaka = null;
											input.Work_Order_Task_Concrete_Products = null;
											input.Work_Order_Task_Clean_Sand = null;
										}
										else if(input.Work_Order_Task_Source == "Concrete Products")
										{
											input.Work_Order_Task_Masaka = null;
											input.Work_Order_Task_Freedom_City = null;
											input.Work_Order_Task_Clean_Sand = null;
										}
										else if(input.Work_Order_Task_Source == "Clean Sand")
										{
											input.Work_Order_Task_Masaka = null;
											input.Work_Order_Task_Freedom_City = null;
											input.Work_Order_Task_Concrete_Products = null;
										}
										else
										{
											input.Work_Order_Task_Masaka = null;
											input.Work_Order_Task_Freedom_City = null;
											input.Work_Order_Task_Concrete_Products = null;
											input.Work_Order_Task_Clean_Sand = null;
										}
										// =====================================================
										// 2. HIDE ALL TASK LOOKUPS AFTER CLEARING
										// =====================================================
										hide Work_Order_Task_Masaka;
										disable Work_Order_Task_Masaka;
										hide Work_Order_Task_Freedom_City;
										disable Work_Order_Task_Freedom_City;
										hide Work_Order_Task_Concrete_Products;
										disable Work_Order_Task_Concrete_Products;
										hide Work_Order_Task_Clean_Sand;
										disable Work_Order_Task_Clean_Sand;
										// =====================================================
										// 3. SHOW ONLY THE SELECTED SOURCE LOOKUP
										// =====================================================
										if(input.Work_Order_Task_Source == "Masaka Sites")
										{
											show Work_Order_Task_Masaka;
											enable Work_Order_Task_Masaka;
										}
										else if(input.Work_Order_Task_Source == "Freedom City")
										{
											show Work_Order_Task_Freedom_City;
											enable Work_Order_Task_Freedom_City;
										}
										else if(input.Work_Order_Task_Source == "Concrete Products")
										{
											show Work_Order_Task_Concrete_Products;
											enable Work_Order_Task_Concrete_Products;
										}
										else if(input.Work_Order_Task_Source == "Clean Sand")
										{
											show Work_Order_Task_Clean_Sand;
											enable Work_Order_Task_Clean_Sand;
										}
						)
					}
				}

			}
