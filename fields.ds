			On_Site_Selected as "On Site Selected"
			{
				type =  form
				form = Site_Location

				record event = on add or edit

				on user input of Site
				{
					actions 
					{
						custom deluge script
						(
											if(input.Site != null)
										{
											input.Display_Name_Site = input.Site.Display_Name_Asset_Name;
										}
										else
