			On_Vendor_Name_Selected as "On Vendor Name Selected"
			{
				type =  form
				form = Vendor_Register

				record event = on add or edit

				on user input of Vendor_Name
				{
					actions 
					{
						custom deluge script
						(
											if(input.Vendor_Name != null)
										{
											input.Display_Name_Vendor = input.Vendor_Name;
										}
										else
										{
											input.Display_Name_Vendor = "";
										}
						)
					}
				}

			}
			On_Vendor_Type_Selected1 as "On Vendor Type Selected"
			{
				type =  form
