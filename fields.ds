		form Asset_List
		{
			displayname = "Asset List"
			success message = "Asset Register Added Successfully"
			Asset_List_Details
			(
				type = section
				displayname = "Asset List Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Asset_Owner
			(
				type = picklist	
				displayname = "Asset Owner"
				values  = company_management.Company_Register.ID
    			displayformat = [Company_Name + " - " + Company_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Asset_Owner
			(
    			type = text
				displayname = "Display Name Asset Owner"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Asset_ID
			(
    			type = text
				displayname = "Asset ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			unique Asset_Name
			(
    			type = text
				displayname = "Asset Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			unique Display_Name_Asset_Name
			(
    			type = text
				displayname = "Display Name Asset Name"
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Asset_Type
			(
				type = picklist	
				displayname = "Asset Type"
				values  = Asset_Type.ID
    			displayformat = [Asset_Type_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Asset_Type
			(
    			type = text
				displayname = "Display Name Asset Type"
	 			row = 1
	 			column = 1   
