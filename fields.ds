			Full_Validation4 as "Full Validation"
			{
				type =  form
				form = Asset_Transfer_Voucher

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										// =====================================================
										// MAIN FORM REQUIRED FIELDS
										// =====================================================
										if(input.Asset_Transfer_Voucher == null)
										{
											errors = errors + "\n• Asset Transfer Voucher is required.";
										}
										if(input.Transfer_Voucher_Date == null)
										{
											errors = errors + "\n• Transfer Date is required.";
										}
										if(input.Asset == null)
										{
											errors = errors + "\n• Asset is required.";
										}
										// =====================================================
										// FROM SECTION REQUIRED FIELDS
										// =====================================================
										if(input.Site_From == null)
										{
											errors = errors + "\n• Site From is required.";
										}
										if(input.Details_From == null || input.Details_From.trim() == "")
										{
											errors = errors + "\n• Details From is required.";
										}
										if(input.Custodian_From == null)
										{
											errors = errors + "\n• Custodian From is required.";
										}
										if(input.Transit_in_Charge_of == null)
										{
											errors = errors + "\n• Transit in Charge of is required.";
										}
										if(input.Notes_From == null || input.Notes_From.trim() == "")
										{
											errors = errors + "\n• Notes From is required.";
										}
										// =====================================================
										// TO SECTION REQUIRED FIELDS
										// =====================================================
										if(input.Site_To == null)
										{
											errors = errors + "\n• Site To is required.";
										}
										if(input.Details_To == null || input.Details_To.trim() == "")
										{
											errors = errors + "\n• Details To is required.";
										}
										if(input.Custodian_To == null)
										{
											errors = errors + "\n• Custodian To is required.";
										}
										if(input.Notes_To == null || input.Notes_To.trim() == "")
										{
											errors = errors + "\n• Notes To is required.";
										}
										if(input.Received_By == null)
										{
											errors = errors + "\n• Received By is required.";
										}
										// =====================================================
										// BUSINESS RULES
										// =====================================================
										if(input.Site_From != null && input.Site_To != null && input.Site_From == input.Site_To)
										{
											errors = errors + "\n• Site From and Site To cannot be the same.";
										}
										if(input.Custodian_From != null && input.Custodian_To != null && input.Custodian_From == input.Custodian_To)
										{
											errors = errors + "\n• Custodian From and Custodian To cannot be the same.";
										}
										// =====================================================
										// MOVEMENT EXPENSE DETAILS
										// OPTIONAL: can be 0 rows
										// BUT if rows exist, they must be valid
										// =====================================================
										if(input.Movement_Expense_Details != null && input.Movement_Expense_Details.count() > 0)
										{
											row_no = 0;
											for each  row in input.Movement_Expense_Details
											{
												row_no = row_no + 1;
												if(row.Item_Name == null)
												{
													errors = errors + "\n• Row " + row_no + ": Item Name is required.";
												}
												if(row.Quantity == null)
												{
													errors = errors + "\n• Row " + row_no + ": Quantity is required.";
												}
												else if(row.Quantity <= 0)
												{
													errors = errors + "\n• Row " + row_no + ": Quantity must be greater than 0.";
												}
												if(row.Rate == null)
												{
													errors = errors + "\n• Row " + row_no + ": Rate is required.";
												}
												else if(row.Rate < 0)
												{
													errors = errors + "\n• Row " + row_no + ": Rate cannot be negative.";
												}
											}
										}
										// =====================================================
										// FINAL STOP
										// =====================================================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation5 as "Full Validation"
			{
				type =  form
				form = Asset_Transfer_Multiple_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											error_message = "";
										// Parent fields
										if(input.Asset_Transfer_Voucher == null)
										{
											error_message = error_message + "Asset Transfer Voucher is required.\n";
										}
										if(input.Transfer_Voucher_Date == null)
										{
											error_message = error_message + "Transfer Voucher Date is required.\n";
										}
										else if(input.Transfer_Voucher_Date > zoho.currentdate)
										{
											error_message = error_message + "Transfer Voucher Date cannot be in the future.\n";
										}
										if(input.Site_From == null)
										{
											error_message = error_message + "Site From is required.\n";
										}
										if(input.Details_From == null || input.Details_From.trim() == "")
										{
											error_message = error_message + "Details From is required.\n";
										}
										if(input.Custodian_From == null)
										{
											error_message = error_message + "Custodian From is required.\n";
										}
										if(input.Transit_in_Charge_of == null)
										{
											error_message = error_message + "Transit in Charge of is required.\n";
										}
										if(input.Notes_From == null || input.Notes_From.trim() == "")
										{
											error_message = error_message + "Notes From is required.\n";
										}
										if(input.Site_To == null)
										{
											error_message = error_message + "Site To is required.\n";
										}
										if(input.Details_To == null || input.Details_To.trim() == "")
										{
											error_message = error_message + "Details To is required.\n";
										}
										if(input.Custodian_To == null)
										{
											error_message = error_message + "Custodian To is required.\n";
										}
										if(input.Notes_To == null || input.Notes_To.trim() == "")
										{
											error_message = error_message + "Notes To is required.\n";
										}
										if(input.Received_By == null)
										{
											error_message = error_message + "Received By is required.\n";
										}
										// Subform validation
										if(input.Transfer_Vouchers == null || input.Transfer_Vouchers.count() < 2)
										{
											error_message = error_message + "Transfer Vouchers must have more than 1 record.\n";
										}
										else
										{
											row_no = 0;
											for each  row in input.Transfer_Vouchers
											{
												row_no = row_no + 1;
												if(row.Asset == null)
												{
													error_message = error_message + "Asset is required in Transfer Vouchers row " + row_no + ".\n";
												}
											}
										}
										// Show all errors once
										if(error_message != "")
										{
											alert error_message;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize_On_Delete4 as "Finalize On Delete"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// 1) Update parent Work Order totals
										if(input.Work_Order != null)
										{
											thisapp.work_order_admin.update_work_order_totals(input.Work_Order);
										}
										// 2) Update parent Asset Issues summary
										if(input.Issue != null)
										{
											thisapp.asset_issues.asset_issues_update_summary(input.Issue);
										}
										else if(input.Work_Order != null)
										{
											wo_rec = Work_Order[ID == input.Work_Order];
											if(wo_rec.ID != null && wo_rec.Issue != null)
											{
												thisapp.asset_issues.asset_issues_update_summary(wo_rec.Issue);
											}
										}
										// 3) Recompute Asset -> Total Service Costs
										if(input.Asset != null)
										{
											total_service_costs = 0.0;
											task_rows = Work_Order_Tasks[Asset == input.Asset];
											for each  t in task_rows
											{
												status_val = ifnull(t.Work_Order_Task_Status,"");
												if(status_val == "Checking" || status_val == "Invoicing" || status_val == "Invoiced")
												{
													total_service_costs = total_service_costs + ifnull(t.Grand_Total,0.0);
												}
											}
											total_service_costs = round(total_service_costs,2);
											asset_rec = Asset_List[ID == input.Asset];
											if(asset_rec.ID != null)
											{
												asset_rec.Total_Service_Costs=total_service_costs;
												odo_val = ifnull(asset_rec.Odometer_Reading,0.0);
												if(odo_val > 0)
												{
													asset_rec.Service_Cost_Per_Odometer=round(total_service_costs / odo_val,2);
												}
												else
												{
													asset_rec.Service_Cost_Per_Odometer=0.0;
												}
											}
										}
						)
					}
				}

			}
