			Full_Validation14 as "Full Validation"
			{
				type =  form
				form = Item_Issuing_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Item Issuing Voucher - Validation On Create
										// =======================================
										if(input.Store == null)
										{
											alert "Please select the Store.";
											cancel submit;
										}
										if(input.Item_Issuing_Date == null)
										{
											alert "Item Issuing Date is missing. Check the selected Voucher record.";
											cancel submit;
										}
										if(input.Item_Issuing_Voucher != null)
										{
											dup_voucher = Item_Issuing_Voucher[Item_Issuing_Voucher == input.Item_Issuing_Voucher];
											if(dup_voucher.count() > 0)
											{
												alert "This Item Issuing Voucher has already been used.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Set_Up_Form21 as "Set Up Form"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// WORK ORDER TASKS -> SET UP FORM / ON LOAD
										// =====================================================
										isLabourService = false;
										isItemsService = false;
										if(input.Vendor_Service_Type == "Labour Only")
										{
											isLabourService = true;
										}
										if(input.Vendor_Service_Type == "Items Only")
										{
											isItemsService = true;
										}
										hide Back_End;
										//hide Back_End;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// -------------------------
										// HIDE FIELDS DEFAULT
										// -------------------------
										hide Display_Name_Asset;
										hide Display_Name_Work_Order;
										hide Parts_Consumables.Display_Name_Item_Labour;
										hide Parts_Consumables;
										hide Parts_Consumables.Display_Name_Work_Order_Task_Number;
										hide Parts_Consumables.Line_Number;
										hide Parts_Consumables.Item_Issuing_Detail;
										hide Parts_Consumables.bi;
										hide Parts_Consumables.Item_Status;
										hide Parts_Consumables.Source_Record_ID;
										hide Parts_Consumables.Source_Form;
										hide Approved_Task_Status;
										hide After_Repair_Section;
										hide Checked_Section;
										hide Labour_Total;
										hide Parts_Total;
										hide Grand_Total;
										hide Store_Manager;
										hide Display_Name_Store_Manager;
										hide Parts_Consumables.Quantity_In_Base_Unit;
										hide Parts_Consumables.Rate_In_Base_Unit;
										// ======================================
										// HIDE AUDIT FIELDS
										// ======================================
										hide Parts_Consumables.User_Name;
										hide Parts_Consumables.User_Email;
										hide Parts_Consumables.User_Role;
										hide Parts_Consumables.Created_By_Name;
										hide Parts_Consumables.Created_By_Email;
										hide Parts_Consumables.Created_By_Time;
										hide Parts_Consumables.Updated_By_Name;
										hide Parts_Consumables.Updated_By_Email;
										hide Parts_Consumables.Updated_By_Time;
										// -------------------------
										// DISABLE FIELDS DEFAULT
										// -------------------------
										disable Labour_Total;
										disable Parts_Total;
										disable Grand_Total;
										disable Issue;
										disable Parts_Consumables.Item;
										disable Parts_Consumables.Line_Total;
										disable Parts_Consumables.Display_Name_Item_Labour;
										disable Parts_Consumables.Unit_Of_Measure;
										disable Parts_Consumables.bi;
										disable Parts_Consumables.Item_Status;
										disable Parts_Consumables.Source_Record_ID;
										disable Parts_Consumables.Source_Form;
										disable Notes_Why_Cancelled;
										disable Date_Time_Approved;
										disable Approved_By_Email;
										disable Work_Order_Task_Number;
										disable Work_Order_Task_Status;
										disable Display_Name_Store_Manager;
										// -------------------------
										// MODE / STATUS
										// -------------------------
										status = ifnull(input.Work_Order_Task_Status,"");
										is_create = input.ID == null;
										if(is_create)
										{
											hide Cancel_This_Work_Order;
											hide Notes_Why_Cancelled;
											hide Odometer_Reading_Approved;
											hide Date_Time_Approved;
											hide Approved_By_Email;
											if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												show Display_Name_Store_Manager;
												enable Store_Manager;
											}
											else if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
												input.Store_Manager = null;
												input.Display_Name_Store_Manager = "";
											}
										}
										// =====================================================
										// A) REQUESTED
										// =====================================================
										if((!is_create && status == "") || (!is_create && status == "Requested"))
										{
											disable Work_Order_Task_Number;
											disable Asset;
											disable Before_Image;
											disable Odometer_Reading_Requested;
											disable Work_Order;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												disable Parts_Consumables.Unit_Cost;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
												input.Store_Manager = null;
												input.Display_Name_Store_Manager = "";
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												enable Store_Manager;
											}
											show Approved_Task_Status;
											show Cancel_This_Work_Order;
											show Notes_Why_Cancelled;
											show Odometer_Reading_Approved;
											show Date_Time_Approved;
											show Approved_By_Email;
										}
										// =====================================================
										// B) CANCELLED
										// =====================================================
										else if(!is_create && status == "Cancelled")
										{
											disable Asset;
											disable Odometer_Reading_Requested;
											disable Work_Order;
											disable Vendor_Service_Type;
											disable Parts_Consumables.Item;
											disable Parts_Consumables.Labour;
											disable Parts_Consumables.Description;
											disable Parts_Consumables.Quantity;
											disable Parts_Consumables.Unit_Cost;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												disable Store_Manager;
											}
											disable Work_Order_Task_Status;
											show Approved_Task_Status;
											show Cancel_This_Work_Order;
											show Notes_Why_Cancelled;
											disable Odometer_Reading_Approved;
										}
										// =====================================================
										// C) REPAIRING
										// =====================================================
										else if(status == "Repairing")
										{
											disable Asset;
											hide Odometer_Reading_Requested;
											disable Before_Image;
											disable Task_Description;
											disable Work_Order;
											disable Parts_Consumables.Item;
											disable Parts_Consumables.Labour;
											disable Parts_Consumables.Description;
											disable Parts_Consumables.Quantity;
											hide Parts_Consumables.Unit_Cost;
											hide Parts_Consumables.Line_Total;
											disable Vendor_Service_Type;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												show Parts_Consumables.Unit_Cost;
												show Parts_Consumables.Line_Total;
												disable Parts_Consumables.Unit_Cost;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												disable Store_Manager;
											}
											show After_Repair_Section;
											disable Date_Time_Work_Completed;
											disable Completed_By_Email;
										}
										// =====================================================
										// D) CHECKING
										// =====================================================
										else if(status == "Checking")
										{
											disable Asset;
											hide Odometer_Reading_Requested;
											disable Work_Order;
											disable Parts_Consumables.Item;
											disable Parts_Consumables.Labour;
											disable Parts_Consumables.Description;
											disable Parts_Consumables.Quantity;
											hide Parts_Consumables.Unit_Cost;
											hide Parts_Consumables.Line_Total;
											disable Vendor_Service_Type;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												show Parts_Consumables.Unit_Cost;
												enable Parts_Consumables.Unit_Cost;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Consumables.Line_Total;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												disable Store_Manager;
											}
											show Checked_Section;
											disable Date_Time_Work_Checked;
											disable Checked_By_Email;
										}
										// =====================================================
										// E) INVOICING
										// =====================================================
										else if(status == "Invoicing")
										{
											disable Asset;
											hide Odometer_Reading_Requested;
											disable Parts_Consumables.Item;
											disable Parts_Consumables.Labour;
											disable Parts_Consumables.Description;
											disable Vendor_Service_Type;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												show Parts_Consumables.Unit_Cost;
												enable Parts_Consumables.Unit_Cost;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												disable Store_Manager;
											}
										}
										// =====================================================
										// F) INVOICED
										// =====================================================
										else if(status == "Invoiced")
										{
											disable Asset;
											disable Odometer_Reading_Requested;
											disable Work_Order;
											disable Vendor_Service_Type;
											show Parts_Consumables;
											hide Parts_Consumables.Item;
											hide Parts_Consumables.Labour;
											show Parts_Consumables.Display_Name_Item_Labour;
											disable Parts_Consumables.Description;
											disable Parts_Consumables.Quantity;
											disable Parts_Consumables.Unit_Cost;
											show Labour_Total;
											show Parts_Total;
											show Grand_Total;
											if(isItemsService)
											{
												show Store_Manager;
												show Display_Name_Store_Manager;
												disable Store_Manager;
											}
											else
											{
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											show Approved_Task_Status;
											disable Cancel_This_Work_Order;
											disable Notes_Why_Cancelled;
											disable Odometer_Reading_Approved;
											show After_Repair_Section;
											disable Date_Time_Work_Completed;
											disable Completed_By_Email;
											disable Odometer_Reading_Completed;
											show Checked_Section;
											disable Odometer_Reading_Checked;
											disable Date_Time_Work_Checked;
											disable Service_Task_Checkbox;
											disable Checked_By_Email;
										}
										// =====================================================
										// G) ADMIN
										// =====================================================
										else if(status == "Admin")
										{
											enable Asset;
											enable Odometer_Reading_Requested;
											enable Work_Order;
											enable Task_Description;
											enable Odometer_Reading_Approved;
											show Approved_Task_Status;
											show Odometer_Reading_Approved;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												enable Store_Manager;
											}
										}
										// =====================================================
										// DISPLAY NAME STORE MANAGER
										// =====================================================
										if(input.Store_Manager != null)
										{
											input.Display_Name_Store_Manager = input.Store_Manager.Employee_Name + " - " + ifnull(input.Store_Manager.Employee_Number,"");
										}
										else
										{
											input.Display_Name_Store_Manager = "";
										}
										// =====================================================
										// DAYS ODOMETER AUTO-FILL
										// =====================================================
										status = ifnull(input.Work_Order_Task_Status,"Requested").trim();
										if(input.Asset != null && input.Asset.Odometer_Unit_Of_Measure == "days")
										{
											odo_today = ifnull(input.Asset.Odometer_Reading,0.0);
											if(status == "Requested")
											{
												if(input.Odometer_Reading_Approved == null)
												{
													input.Odometer_Reading_Approved = odo_today;
												}
												disable Odometer_Reading_Approved;
											}
											else if(status == "Repairing")
											{
												if(input.Odometer_Reading_Completed == null)
												{
													input.Odometer_Reading_Completed = odo_today;
												}
												disable Odometer_Reading_Completed;
											}
											else if(status == "Checking")
											{
												if(input.Odometer_Reading_Checked == null)
												{
													input.Odometer_Reading_Checked = odo_today;
												}
												disable Odometer_Reading_Checked;
											}
										}
						)
					}
				}

			}
			Set_Up_Form22 as "Set Up Form"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =============================================
										// Item Issuing Details -> Set Up Form OPTIMIZED
										// Load of form only
										// No heavy lookups here
										// =============================================
										// BACK END
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// Logged-in user info only
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// =============================================
										// Hide display/helper fields
										// =============================================
										hide Display_Name_Issuing_Voucher;
										hide Display_Name_Item;
										hide Display_Name_Taken_By;
										hide Display_Name_Unit_Of_Measure;
										hide Quantity_Returned;
										hide Quantity_Returned_in_Base_Unit_Of_Measure;
										hide Display_Name_Issued_By;
										hide Status;
										hide Notes;
										hide Status_Details;
										hide Items_Image;
										// =============================================
										// Disable system fields
										// =============================================
										disable Global_Available_Stock;
										disable Store_Available_Stock;
										disable Quantity_in_Base_Unit_Of_Measure;
										disable Item_Issuing_Number;
										disable Line_Total;
										disable Store;
										disable Request_Voucher;
										disable Cost;
										disable Status;
										// =============================================
										// Request source fields
										// Hide all first
										// =============================================
										req_type = ifnull(input.Request_Voucher_Type,"").trim();
										hide Employee_Voucher;
										hide Work_Order_Task;
										hide Sales_Voucher;
										hide Item_Taken;
										show Item;
										if(req_type == "Employee Voucher")
										{
											show Employee_Voucher;
										}
										else if(req_type == "Work Order Task")
										{
											show Work_Order_Task;
										}
										else if(req_type == "Sales Voucher")
										{
											show Sales_Voucher;
											show Item_Taken;
											show Items_Image;
											hide Item;
											input.Employee_Voucher = null;
											input.Work_Order_Task = null;
										}
										else if(req_type == "Internal Transfer")
										{
											input.Request_Voucher = ifnull(input.Item_Issuing_Number,"");
											input.Employee_Voucher = null;
											input.Work_Order_Task = null;
											input.Sales_Voucher = null;
											input.Item_Taken = null;
										}
										else
										{
											input.Request_Voucher = "";
											input.Employee_Voucher = null;
											input.Work_Order_Task = null;
											input.Sales_Voucher = null;
											input.Item_Taken = null;
										}
										// =============================================
										// Cancel / did not come back fields
										// =============================================
										hide Cancel_This_Line_Item;
										hide Reason_Why_Cancelled;
										hide Didn_t_Come_Back;
										hide Why;
										hide Reason_Why_Didn_t_Come_Back;
										if(input.ID != null)
										{
											show Didn_t_Come_Back;
											show Cancel_This_Line_Item;
											if(input.Cancel_This_Line_Item == true)
											{
												show Reason_Why_Cancelled;
											}
											if(input.Didn_t_Come_Back == true)
											{
												show Why;
												show Reason_Why_Didn_t_Come_Back;
											}
										}
										// =============================================
										hide Expected_Return_Date;
										// =============================================
										// Draft edit lock
										// =============================================
										if(input.ID != null && input.Status == "Draft")
										{
											disable Issuing_Voucher;
											disable Line_Number;
											disable Request_Voucher_Type;
											disable Employee_Voucher;
											disable Work_Order_Task;
											hide Issuing_Voucher;
											hide Store;
											hide Line_Number;
											hide Taken_By;
											hide Didn_t_Come_Back;
											show Status_Details;
											show Cancel_This_Line_Item;
										}
						)
					}
				}

			}
			On_Cancel_This_Line_Item_ as "On Cancel This Line Item Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Cancel_This_Line_Item
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_This_Line_Item == true)
										{
											show Reason_Why_Cancelled;
											input.Status = "Cancelled";
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = "";
										}
						)
					}
				}

			}
