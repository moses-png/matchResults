			Full_Validation1 as "Full Validation"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PAYMENT RECEIPT VOUCHER — FULL VALIDATION
										// =====================================================
										errors = "";
										// =====================================================
										// 1. PAYMENT RECEIPT DATE
										// =====================================================
										if(input.Payment_Receipt_Date == null)
										{
											input.Payment_Receipt_Date = zoho.currenttime;
										}
										if(input.Payment_Receipt_Date.toDate() > zoho.currentdate)
										{
											errors = errors + "\n• Payment Receipt Date cannot be in the future.";
										}
										// =====================================================
										// 2. RECEIVING ACCOUNT AND ACCOUNT TYPE
										// =====================================================
										account_type = "";
										if(input.Receiving_Account == null)
										{
											errors = errors + "\n• Please select the Receiving Account.";
										}
										else
										{
											if(input.Receiving_Account.Account_Type != null)
											{
												account_type = ifnull(input.Receiving_Account.Account_Type.Account_Type_Name,"").trim();
											}
											input.Account_Type = account_type;
											if(account_type == "")
											{
												errors = errors + "\n• Account Type could not be determined from the selected Receiving Account.";
											}
											else if(account_type == "Cash Account")
											{
												if(input.Payment_Receipt_Number == null || input.Payment_Receipt_Number.trim() == "")
												{
													errors = errors + "\n• The cash receipt number was not generated.";
												}
											}
											else if(account_type == "Mobile Money Account")
											{
												if(input.Payment_Receipt_Number == null || input.Payment_Receipt_Number.trim() == "")
												{
													errors = errors + "\n• Please enter the Mobile Money transaction ID.";
												}
											}
											else
											{
												errors = errors + "\n• Unsupported Account Type: " + account_type + ".";
											}
										}
										// =====================================================
										// 3. AMOUNT RECEIVED
										// =====================================================
										if(ifnull(input.Total_Amount_Received,0.0) <= 0)
										{
											errors = errors + "\n• Total Amount Received must be greater than zero.";
										}
										// =====================================================
										// 4. CUSTOMER
										// =====================================================
										if(input.Customer == null)
										{
											errors = errors + "\n• Please select the Customer.";
										}
										// =====================================================
										// 5. BLOCK SUBMISSION
										// =====================================================
										if(errors != "")
										{
											alert errors;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation_On_Create as "Full Validation On Create"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Generate only if empty (prevents changing during edit)
										if(input.Payment_Receipt_Number == null || input.Payment_Receipt_Number == "")
										{
											gen = Code_Generator[Prefix == "PAA" && Status == "Active"];
											if(gen == null)
											{
												alert "No ACTIVE Code Generator found for prefix PAA. Please set it up.";
											}
											else
											{
												nextNum = ifnull(gen.Next_Number,1);
												// Block if greater than 9999
												if(nextNum > 9999)
												{
													alert "Payment Number limit reached (PAA9999). Please create a new prefix.";
													// optional: cancel submit if you're running this on create/submit
												}
												else
												{
													// Pad to 4 digits
													formattedNum = nextNum.toString();
													if(nextNum < 10)
													{
														formattedNum = "000" + formattedNum;
													}
													else if(nextNum < 100)
													{
														formattedNum = "00" + formattedNum;
													}
													else if(nextNum < 1000)
													{
														formattedNum = "0" + formattedNum;
													}
													input.Payment_Receipt_Number = gen.Prefix + formattedNum;
													// increment
													gen.Next_Number=nextNum + 1;
												}
											}
										}
										gen = Code_Generator[Prefix == "PAA" && Status == "Active"];
										if(gen != null && ifnull(gen.Next_Number,1) > 10000)
										{
											alert "Cannot create new Payment. Payment numbers are capped at PAA9999.";
											cancel submit;
										}
						)
					}
				}

			}
			Delete_Row_Items_Dropped as "Delete Row Items Dropped"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on delete row of Shoe_Services
				{
					actions 
					{
						custom deluge script
						(
											grandTotal = ifnull(input.Grand_Total,0);
										paid = ifnull(input.Amount_Paid,0);
										statusVal = "Unpaid";
										if(paid <= 0)
										{
											statusVal = "Unpaid";
										}
										else if(paid < grandTotal)
										{
											statusVal = "Partially Paid";
										}
										else
										{
											statusVal = "Paid";
										}
										for each  shoeRow in input.Shoe_Services
										{
											shoeRow.Payment_Status=statusVal;
										}
						)
					}
				}

			}
			Full_Validation2 as "Full Validation"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// 1️⃣ REQUIRED FIELD VALIDATIONS
										// =====================================================
										if(input.Voucher == null)
										{
											alert "Please select a voucher.";
											cancel submit;
										}
										if(input.Customer == null)
										{
											alert "Please select a Customer.";
											cancel submit;
										}
										if(input.Shoe_Services.isEmpty())
										{
											alert "Please add at least one record in Items Dropped.";
											cancel submit;
										}
										rowNo = 0;
										for each  shoeRow in input.Shoe_Services
										{
											rowNo = rowNo + 1;
											if(shoeRow.Shoe_Type == null)
											{
												alert "Items Dropped (Row " + rowNo + "): Shoe Type is required.";
												cancel submit;
											}
											if(shoeRow.Brand == null)
											{
												alert "Items Dropped (Row " + rowNo + "): Brand is required.";
												cancel submit;
											}
											if(shoeRow.Color == null)
											{
												alert "Items Dropped (Row " + rowNo + "): Color is required.";
												cancel submit;
											}
											if(shoeRow.Condition_Level == null || shoeRow.Condition_Level == "")
											{
												alert "Items Dropped (Row " + rowNo + "): Condition Level is required.";
												cancel submit;
											}
											if(shoeRow.Shoe_Image == null || shoeRow.Shoe_Image.toString().trim() == "")
											{
												alert "Items Dropped (Row " + rowNo + "): Shoe Image is required.";
												cancel submit;
											}
											if(shoeRow.Service == null)
											{
												alert "Items Dropped (Row " + rowNo + "): Service is required.";
												cancel submit;
											}
											if(shoeRow.Storage_Container == null)
											{
												alert "Items Dropped (Row " + rowNo + "): Storage Container is required.";
												cancel submit;
											}
										}
										// =====================================================
										// 2️⃣ TRACKING NUMBER GENERATION
										// =====================================================
										if(input.Sales_Voucher_Number == null || input.Sales_Voucher_Number == "")
										{
											gen = Code_Generator[Prefix == "TAA" && Status == "Active"];
											if(gen == null)
											{
												alert "No ACTIVE Code Generator found for prefix TAA.";
												cancel submit;
											}
											else
											{
												nextNum = ifnull(gen.Next_Number,1);
												if(nextNum > 9999)
												{
													alert "Tracking Number limit reached (TAA9999).";
													cancel submit;
												}
												else
												{
													formattedNum = nextNum.toString();
													if(nextNum < 10)
													{
														formattedNum = "000" + formattedNum;
													}
													else if(nextNum < 100)
													{
														formattedNum = "00" + formattedNum;
													}
													else if(nextNum < 1000)
													{
														formattedNum = "0" + formattedNum;
													}
													input.Sales_Voucher_Number = gen.Prefix + formattedNum;
													gen.Next_Number=nextNum + 1;
												}
											}
										}
										// =====================================================
										// 3️⃣ TOTAL CALCULATIONS
										// =====================================================
										subTotal = 0;
										for each  shoeRow in input.Shoe_Services
										{
											subTotal = subTotal + ifnull(shoeRow.Rate,0);
										}
										input.Sub_Total = subTotal;
										grandTotal = ifnull(input.Sub_Total,0) - ifnull(input.Discount_Amount,0);
										if(grandTotal < 0)
										{
											grandTotal = 0;
										}
										input.Grand_Total = grandTotal;
										balance = ifnull(input.Grand_Total,0) - ifnull(input.Amount_Paid,0);
										if(balance < 0)
										{
											balance = 0;
										}
										input.Balance_Due = balance;
										// =====================================================
										// 4️⃣ PAYMENT STATUS
										// =====================================================
										paid = ifnull(input.Amount_Paid,0);
										statusVal = "Unpaid";
										if(paid <= 0)
										{
											statusVal = "Unpaid";
										}
										else if(paid < grandTotal)
										{
											statusVal = "Partially Paid";
										}
										else
										{
											statusVal = "Paid";
										}
										for each  shoeRow in input.Shoe_Services
										{
											shoeRow.Display_Name_Sales_Voucher=input.Sales_Voucher_Number;
											shoeRow.Payment_Status=statusVal;
										}
										// =====================================================
										// 5. PICKED VALIDATION + UPDATE PRODUCTION DETAILS
										// =====================================================
										for each  shoe_row in input.Shoe_Services
										{
											if(shoe_row.Picked == true)
											{
												tracking_number = ifnull(shoe_row.Display_Name_Sales_Voucher,input.Sales_Voucher_Number);
												production_rec = Production_Details[Tracking_Number == tracking_number && Line_Number == shoe_row.Line_Number];
												if(production_rec.ID == null)
												{
													alert "Production Details record was not found for shoe line " + shoe_row.Line_Number + ".";
													cancel submit;
												}
												if(production_rec.In_Store_Stage != "Ready" && production_rec.In_Store_Stage != "Picked")
												{
													alert "Shoe line " + shoe_row.Line_Number + " cannot be picked because its production stage is " + ifnull(production_rec.In_Store_Stage,"Not Defined") + ".";
													cancel submit;
												}
												shoe_row.In_Store_Stage="Picked";
												if(shoe_row.Pick_Up_Date == null)
												{
													shoe_row.Pick_Up_Date=zoho.currenttime;
												}
												production_rec.In_Store_Stage="Picked";
											}
										}
										// =====================================================
										// 6. AUTO CLOSE SALES VOUCHER
										// =====================================================
										if(input.Shoe_Services.isEmpty())
										{
											if(input.Status != "Closed")
											{
												input.Status = "Open";
											}
										}
										else
										{
											all_picked = true;
											for each  shoe_row in input.Shoe_Services
											{
												if(shoe_row.Picked != true || shoe_row.In_Store_Stage != "Picked")
												{
													all_picked = false;
													break;
												}
											}
											if(all_picked == true)
											{
												input.Status = "Closed";
											}
											else if(input.Status != "Closed")
											{
												input.Status = "Open";
											}
										}
						)
					}
				}

			}
			On_Sales_Voucher_Selected as "On Sales Voucher Selected"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on user input of Sales_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Sales_Voucher != null)
										{
											Payment_Document = "Sales Voucher";
											input.Display_Name_Invoice_Voucher = input.Sales_Voucher.Sales_Voucher_Number;
											input.Customer = input.Sales_Voucher.Display_Name_Customer;
											input.Amount_Due = ifnull(input.Sales_Voucher.Balance_Due,0);
											input.Balance_Due = ifnull(input.Amount_Due,0) - ifnull(input.Amount_Allocated,0);
										}
										else
										{
											input.Display_Name_Invoice_Voucher = "";
											input.Customer = "";
											input.Amount_Due = 0;
											input.Balance_Due = 0;
										}
						)
					}
				}

			}
			On_Sales_Voucher_Selected3 as "On Sales Voucher Selected"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on user input of Payment_Receipt_Details.Sales_Voucher
				{
					actions 
					{
						custom deluge script
						(
											// 1) Auto-fill Amount Due for allocation rows
										for each  allocRow in input.Payment_Receipt_Details
										{
											if(allocRow.Sales_Voucher != null)
											{
												allocRow.Amount_Due=ifnull(allocRow.Sales_Voucher.Balance_Due,0);
												// Defaults
												if(allocRow.Amount_Allocated == null)
												{
													allocRow.Amount_Allocated=0;
												}
												// Row balance
												allocRow.Balance_Due=ifnull(allocRow.Amount_Due,0) - ifnull(allocRow.Amount_Allocated,0);
											}
											else
											{
												// If Customer Intake cleared
												allocRow.Amount_Due=0;
												allocRow.Amount_Allocated=0;
												allocRow.Balance_Due=0;
											}
										}
										// 2) Recalculate parent totals + allocation status
										allocatedTotal = 0;
										for each  allocRow in input.Payment_Receipt_Details
										{
											allocatedTotal = allocatedTotal + ifnull(allocRow.Amount_Allocated,0);
										}
										input.Total_Amount_Allocated = allocatedTotal;
										input.Total_Amount_Not_Allocated = ifnull(input.Total_Amount_Received,0) - allocatedTotal;
										if(ifnull(input.Total_Amount_Allocated,0) <= 0)
										{
											input.Payment_Receipt_Voucher_Status = "Unallocated";
										}
										else if(ifnull(input.Total_Amount_Not_Allocated,0) > 0)
										{
											input.Payment_Receipt_Voucher_Status = "Partially Allocated";
										}
										else
										{
											input.Payment_Receipt_Voucher_Status = "Fully Allocated";
										}
						)
					}
				}

			}
			On_Amount_Alloctated_Sele as "On Amount  Alloctated Selected"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on user input of Payment_Receipt_Details.Amount_Allocated
				{
					actions 
					{
						custom deluge script
						(
											// 1) Validate + recalc row balances
										remaining = ifnull(input.Total_Amount_Received,0);
										for each  allocRow in input.Payment_Receipt_Details
										{
											if(allocRow.Sales_Voucher == null)
											{
												allocRow.Amount_Allocated=0;
												allocRow.Amount_Due=0;
												allocRow.Balance_Due=0;
											}
											else
											{
												// Ensure Amount Due is correct
												allocRow.Amount_Due=ifnull(allocRow.Sales_Voucher.Balance_Due,0);
												if(allocRow.Amount_Allocated == null)
												{
													allocRow.Amount_Allocated=0;
												}
												// Prevent clearing more than due
												if(ifnull(allocRow.Amount_Allocated,0) > ifnull(allocRow.Amount_Due,0))
												{
													alert "Amount Cleared cannot be more than Amount Due.";
													allocRow.Amount_Allocated=allocRow.Amount_Due;
												}
												// Prevent exceeding remaining payment amount
												if(ifnull(allocRow.Amount_Allocated,0) > remaining)
												{
													alert "You cannot allocate more than the remaining payment amount.";
													allocRow.Amount_Allocated=remaining;
												}
												// Reduce remaining balance
												remaining = remaining - ifnull(allocRow.Amount_Allocated,0);
												// Row balance
												allocRow.Balance_Due=ifnull(allocRow.Amount_Due,0) - ifnull(allocRow.Amount_Allocated,0);
											}
										}
										// 2) Recalculate parent totals
										allocatedTotal = 0;
										for each  allocRow in input.Payment_Receipt_Details
										{
											allocatedTotal = allocatedTotal + ifnull(allocRow.Amount_Allocated,0);
										}
										input.Total_Amount_Allocated = allocatedTotal;
										input.Total_Amount_Not_Allocated = ifnull(input.Total_Amount_Received,0) - allocatedTotal;
										// 3) Allocation Status
										if(ifnull(input.Total_Amount_Allocated,0) <= 0)
										{
											input.Payment_Receipt_Voucher_Status = "Unallocated";
										}
										else if(ifnull(input.Total_Amount_Not_Allocated,0) > 0)
										{
											input.Payment_Receipt_Voucher_Status = "Partially Allocated";
										}
										else
										{
											input.Payment_Receipt_Voucher_Status = "Fully Allocated";
										}
						)
					}
				}

			}
			On_Total_Amount_Received_ as "On Total Amount Received Selected"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on user input of Total_Amount_Received
				{
					actions 
					{
						custom deluge script
						(
											// Recalculate allocated total from the subform
										allocatedTotal = 0;
										for each  allocRow in input.Payment_Receipt_Details
										{
											allocatedTotal = allocatedTotal + ifnull(allocRow.Amount_Allocated,0);
										}
										// If payment amount is reduced below what's already allocated, block it
										if(ifnull(input.Total_Amount_Received,0) < allocatedTotal)
										{
											alert "Payment Amount cannot be less than the total Amount Cleared in allocations.";
											// Set it back to the allocated total to keep consistency
											input.Total_Amount_Received = allocatedTotal;
										}
										// Update parent totals
										input.Total_Amount_Allocated = allocatedTotal;
										input.Total_Amount_Not_Allocated = ifnull(input.Total_Amount_Received,0) - allocatedTotal;
										// Update allocation status
										if(ifnull(input.Total_Amount_Allocated,0) <= 0)
										{
											input.Payment_Receipt_Voucher_Status = "Unallocated";
										}
										else if(ifnull(input.Total_Amount_Not_Allocated,0) > 0)
										{
											input.Payment_Receipt_Voucher_Status = "Partially Allocated";
										}
										else
										{
											input.Payment_Receipt_Voucher_Status = "Fully Allocated";
										}
						)
					}
				}

			}
			Set_Up_Form4 as "Set Up Form"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// SALES VOUCHER — ON LOAD
										// =====================================================
										// =====================================================
										// 1. MAIN FORM — DISABLE FIELDS
										// =====================================================
										disable Sales_Voucher_Number;
										disable Display_Name_Customer;
										disable Phone_Number;
										disable WhatsApp_Number;
										disable Sub_Total;
										disable Tax_Amount;
										disable Grand_Total;
										disable Amount_Paid;
										disable Balance_Due;
										disable Discount_Amount;
										disable Payment_Status;
										disable Status;
										disable Display_Name_Voucher;
										disable Display_Name_Employee;
										// =====================================================
										// 2. SHOE SERVICES — DISABLE FIELDS
										// =====================================================
										disable Shoe_Services.Display_Name_Sales_Voucher;
										disable Shoe_Services.Display_Name_Customer;
										disable Shoe_Services.Rate;
										disable Shoe_Services.Payment_Status;
										disable Shoe_Services.In_Store_Stage;
										disable Shoe_Services.Line_Number;
										disable Shoe_Services.Shoe_Details;
										disable Shoe_Services.Pick_Up_Date;
										// =====================================================
										// 3. ITEM DETAILS — DISABLE FIELDS
										// =====================================================
										disable Item_Details.Line_Total;
										disable Item_Details.Quantity_Available;
										// =====================================================
										// 4. MAIN FORM — HIDE FIELDS
										// =====================================================
										hide Sales_Voucher_Number;
										hide Display_Name_Customer;
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										hide Discount_Percentage;
										hide Discount_Amount;
										hide WhatsApp_Number;
										hide Phone_Number;
										hide Display_Name_Site;
										hide Item_Issuing_Details;
										hide Payment_Receipt_Details;
										hide Bill;
										hide Reason_Why_Cancelled;
										hide Back_End;
										// =====================================================
										// 5. SHOE SERVICES — HIDE FIELDS
										// =====================================================
										hide Shoe_Services.Sales_Voucher_Details;
										hide Shoe_Services.Display_Name_Sales_Voucher;
										hide Shoe_Services.Display_Name_Customer;
										hide Shoe_Services.In_Store_Stage;
										// -----------------------------------------------------
										// Shoe Services audit fields
										// -----------------------------------------------------
										hide Shoe_Services.User_Role;
										hide Shoe_Services.User_Email;
										hide Shoe_Services.User_Name;
										hide Shoe_Services.Created_By_Time;
										hide Shoe_Services.Created_Name;
										hide Shoe_Services.Created_By_Email;
										hide Shoe_Services.Updated_By_Name;
										hide Shoe_Services.Updated_By_Time;
										hide Shoe_Services.Updated_By_Email;
										// =====================================================
										// 6. ITEM DETAILS — HIDE FIELDS
										// =====================================================
										hide Item_Details.Display_Name_Site;
										hide Item_Details.Display_Name_Sales_Voucher;
										hide Item_Details.Line_Number;
										hide Item_Details.Store;
										hide Item_Details.Base_Unit_Of_Measure;
										hide Item_Details.Display_Name_Item;
										hide Item_Details.Display_Name_Store;
										hide Item_Details.Display_Name_Unit_Of_Measure;
										hide Item_Details.Quantity_in_Base_Unit_Of_Measure;
										hide Item_Details.Display_Name_Base_Unit_Of_Measure;
										hide Item_Details.Quantity_Issued_in_Base_Unit_Of_Measure;
										hide Item_Details.Quantity_Not_Issued_in_Base_Unit_Of_Measure;
										hide Item_Details.Issue_Status;
										hide Item_Details.User_Name;
										hide Item_Details.User_Email;
										hide Item_Details.User_Role;
										hide Item_Details.Created_By_Name;
										hide Item_Details.Created_By_Time;
										hide Item_Details.Created_By_Email;
										hide Item_Details.Updated_By_Name;
										hide Item_Details.Updated_By_Email;
										hide Item_Details.Updated_By_Time;
										// =====================================================
										// 7. CREATE OR EDIT MODE
										// =====================================================
										is_create = input.ID == null;
										if(is_create)
										{
											hide Shoe_Services.Line_Number;
											hide Shoe_Services.Picked;
											hide Shoe_Services.Pick_Up_Date;
											hide Cancel_Voucher;
										}
										else
										{
											hide Shoe_Services.Shoe_Type;
											hide Shoe_Services.Brand;
											hide Shoe_Services.Color;
											hide Shoe_Services.Condition_Level;
											show Cancel_Voucher;
											disable Customer;
											disable Shoe_Services.Shoe_Image;
											disable Shoe_Services.Storage_Container;
											disable Shoe_Services.Service;
											disable Shoe_Services.Pick_Up_Date;
										}
										// =====================================================
										// 8. LOCK PICKED UNTIL SHOE IS READY
										// =====================================================
										for each  shoe_row in input.Shoe_Services
										{
											tracking_value = ifnull(shoe_row.Display_Name_Sales_Voucher,input.Sales_Voucher_Number);
											shoe_service_rec = Shoe_Services[Display_Name_Sales_Voucher == tracking_value && Line_Number == shoe_row.Line_Number];
											disable Shoe_Services.Pick_Up_Date;
											disable Shoe_Services.Picked;
											if(shoe_service_rec.ID != null && shoe_service_rec.In_Store_Stage == "Ready")
											{
												enable Shoe_Services.Picked;
											}
											if(shoe_service_rec.ID != null && shoe_service_rec.In_Store_Stage == "Picked")
											{
												disable Shoe_Services.Picked;
												disable Shoe_Services.Pick_Up_Date;
											}
										}
										// =====================================================
										// 9. DISCOUNT AMOUNT ACCESS
										// =====================================================
										day_name = zoho.currentdate.toString("EEEE");
										if(zoho.loginuserid == "matovuji193@gmail.com" || zoho.loginuserid == "xenotime15@gmail.com" || zoho.loginuserid == "phmak00104@gmail.com")
										{
											enable Discount_Amount;
										}
										else if(day_name == "Saturday")
										{
											enable Discount_Amount;
										}
										else
										{
											disable Discount_Amount;
										}
										// =====================================================
										// 10. AUDIT INFORMATION
										// =====================================================
										login_audit = thisapp.audit.getLoginAuditInfo();
										input.User_Name = login_audit.get("name");
										input.User_Email = login_audit.get("email");
										input.User_Role = login_audit.get("role");
										// =====================================================
										// 11. SALES TYPE DISPLAY CONTROL
										// =====================================================
										if(input.Sales_Type == "Item Sales")
										{
											show Item_Details;
											hide Shoe_Services;
										}
										else if(input.Sales_Type == "Shoe Services")
										{
											show Shoe_Services;
											hide Item_Details;
										}
										else if(input.Sales_Type == "Sales and Services")
										{
											show Shoe_Services;
											show Item_Details;
										}
										else
										{
											hide Shoe_Services;
											hide Item_Details;
										}
						)
					}
				}

			}
