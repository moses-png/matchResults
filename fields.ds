				 string syncStockBundlingFromStore(map input)
                 {
                 	bundle_record_id = input.get("Bundle_Record_ID");
                 	quantity_created = ifnull(input.get("Quantity_Created"),0);
                 	stock_receiving_detail = ifnull(input.get("Stock_Receiving_Detail"),"");
                 	source_record_id = ifnull(input.get("Source_Record_ID"),0);
                 	source_form = ifnull(input.get("Source_Form"),"");
                 	stock_status = ifnull(input.get("Stock_Status"),"Received");
                 	rec = Stock_Bundling_Note[ID == bundle_record_id];
                 	if(rec.ID != null)
                 	{
                 		rec.Quantity_Created=quantity_created;
                 		rec.Stock_Receiving_Detail=stock_receiving_detail;
                 		rec.Source_Record_ID=source_record_id;
                 		rec.Source_Form=source_form;
                 		if(ifnull(rec.Stock_Status,"") == "Pending")
                 		{
                 			rec.Stock_Status=stock_status;
                 		}
                 		return "Updated";
                 	}
                 	else
                 	{
                 		return "No matching Stock Bundling Note record found";
                 	}
                 }
				 map syncStockReceivingFromStore(map payload)
                 {
                 	resp = Map();
                 	resp.put("success",false);
                 	resp.put("ok",false);
                 	voucher_id = payload.get("Voucher");
                 	source_record_id = ifnull(payload.get("Source_Record_ID"),"").toString().trim();
                 	// Always use one standard source value
                 	source_form = "Store Management - Stock Receiving Details";
                 	if(voucher_id == null)
                 	{
                 		resp.put("message","Voucher is missing.");
                 		return resp;
                 	}
                 	if(source_record_id == "")
                 	{
                 		resp.put("message","Source Record ID is missing.");
                 		return resp;
                 	}
                 	existing = Stock_Receiving_Details[Source_Record_ID == source_record_id && Source_Form == source_form];
                 	if(existing.ID != null)
                 	{
                 		existing.Voucher=voucher_id;
                 		existing.Display_Name_Voucher=ifnull(payload.get("Display_Name_Voucher"),"");
                 		existing.Line_Number=ifnull(payload.get("Line_Number"),0);
                 		existing.Display_Name_Item=ifnull(payload.get("Display_Name_Item"),"");
                 		existing.Quantity_Received=ifnull(payload.get("Quantity_Received"),0.0);
                 		// Keep origin fields unchanged and explicit
                 		existing.Source_Record_ID=source_record_id;
                 		existing.Source_Form=source_form;
                 		resp.put("success",true);
                 		resp.put("ok",true);
                 		resp.put("action","updated");
                 		resp.put("record_id",existing.ID);
                 		resp.put("message","Stock Receiving Details updated successfully.");
                 		return resp;
                 	}
                 	new_id = insert into Stock_Receiving_Details
                 	[
                 		Voucher=voucher_id
                 		Display_Name_Voucher=ifnull(payload.get("Display_Name_Voucher"),"")
                 		Line_Number=ifnull(payload.get("Line_Number"),0)
                 		Display_Name_Item=ifnull(payload.get("Display_Name_Item"),"")
                 		Quantity_Received=ifnull(payload.get("Quantity_Received"),0.0)
                 		Source_Record_ID=source_record_id
                 		Source_Form=source_form
                 		Added_User=zoho.loginuser
                 	];
                 	resp.put("success",true);
                 	resp.put("ok",true);
                 	resp.put("action","created");
                 	resp.put("record_id",new_id);
                 	resp.put("message","Stock Receiving Details created successfully.");
                 	return resp;
                 }
				 map syncVoucherFromConcrete(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	if(payload == null)
                 	{
                 		resp.put("message","Payload is null.");
                 		return resp;
                 	}
                 	source_record_id = payload.get("Source_Record_ID");
                 	source_form = ifnull(payload.get("Source_Form"),"Concrete Products - Voucher Register");
                 	if(source_record_id == null)
                 	{
                 		resp.put("message","Source Record ID missing.");
                 		return resp;
                 	}
                 	voucher_number_val = ifnull(payload.get("Voucher_Number"),"").trim();
                 	if(voucher_number_val == "")
                 	{
                 		voucher_number_val = "CP-VCH-" + source_record_id.toString();
                 	}
                 	voucher_status_val = ifnull(payload.get("Voucher_Status"),"Open");
                 	date_in_val = null;
                 	date_out_val = null;
                 	start_time_val = null;
                 	end_time_val = null;
                 	manager_time_val = null;
                 	time_checked_val = null;
                 	hr_time_checked_val = null;
                 	if(ifnull(payload.get("Date_Time_In"),"") != "")
                 	{
                 		date_in_val = payload.get("Date_Time_In").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Date_Time_Out"),"") != "")
                 	{
                 		date_out_val = payload.get("Date_Time_Out").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Start_Time"),"") != "")
                 	{
                 		start_time_val = payload.get("Start_Time").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("End_Time"),"") != "")
                 	{
                 		end_time_val = payload.get("End_Time").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Manager_Time"),"") != "")
                 	{
                 		manager_time_val = payload.get("Manager_Time").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Time_Checked"),"") != "")
                 	{
                 		time_checked_val = payload.get("Time_Checked").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Hr_Time_Checked"),"") != "")
                 	{
                 		hr_time_checked_val = payload.get("Hr_Time_Checked").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	issued_by_text = ifnull(payload.get("Display_Name_Issued_By"),"").trim();
                 	received_by_text = ifnull(payload.get("Display_Name_Received_By"),"").trim();
                 	issued_by_val = null;
                 	if(issued_by_text != "")
                 	{
                 		issued_rec = Voucher[Voucher_Number == issued_by_text || Display_Name_Employee == issued_by_text || Display_Name_Issued_By == issued_by_text];
                 		if(issued_rec.ID != null)
                 		{
                 			issued_by_val = issued_rec.ID;
                 		}
                 	}
                 	received_by_val = null;
                 	if(received_by_text != "")
                 	{
                 		received_rec = Voucher[Voucher_Number == received_by_text || Display_Name_Employee == received_by_text || Display_Name_Received_By == received_by_text];
                 		if(received_rec.ID != null)
                 		{
                 			received_by_val = received_rec.ID;
                 		}
                 	}
                 	existing = Voucher[Source_Record_ID == source_record_id && Source_Form == source_form];
                 	if(existing.ID == null)
                 	{
                 		existing = Voucher[Voucher_Number == voucher_number_val];
                 	}
                 	if(existing.ID != null)
                 	{
                 		existing.Document_Type=payload.get("Document_Type");
                 		existing.Voucher_Type=payload.get("Voucher_Type");
                 		existing.Voucher_Number=voucher_number_val;
                 		existing.Employee=payload.get("Employee");
                 		existing.Display_Name_Employee=payload.get("Display_Name_Employee");
                 		existing.Issued_By=issued_by_val;
                 		existing.Display_Name_Issued_By=issued_by_text;
                 		existing.Received_By=received_by_val;
                 		existing.Display_Name_Received_By=received_by_text;
                 		existing.Date_Time_In=date_in_val;
                 		existing.Date_Time_Out=date_out_val;
                 		existing.Site=payload.get("Site");
                 		existing.Display_Name_Site=payload.get("Display_Name_Site");
                 		existing.Hours_Worked=payload.get("Hours_Worked");
                 		existing.Shift=payload.get("Shift");
                 		existing.Voucher_Status=voucher_status_val;
                 		existing.Management_Location=payload.get("Management_Location");
                 		existing.Asset=payload.get("Asset");
                 		existing.Machine_Start_of_Day=payload.get("Machine_Start_of_Day");
                 		existing.Start_Time=start_time_val;
                 		existing.End_Time=end_time_val;
                 		existing.Manager_Time=manager_time_val;
                 		existing.Time_Checked=time_checked_val;
                 		existing.Hr_Time_Checked=hr_time_checked_val;
                 		existing.Odometer_Start=payload.get("Odometer_Start");
                 		existing.Fuel_Start_Level=payload.get("Fuel_Start_Level");
                 		existing.Odometer_End=payload.get("Odometer_End");
                 		existing.Fuel_End_Level=payload.get("Fuel_End_Level");
                 		existing.Item=payload.get("Item");
                 		existing.Display_Name_Item=payload.get("Display_Name_Item");
                 		existing.Quantity_To_Be_Created=payload.get("Quantity_To_Be_Created");
                 		existing.Voucher_Cost=payload.get("Voucher_Cost");
                 		existing.Cancel_Voucher=payload.get("Cancel_Voucher");
                 		existing.Cancellation_Reason=payload.get("Cancellation_Reason");
                 		existing.Seen=payload.get("Seen");
                 		existing.Reason_for_not_Seen=payload.get("Reason_for_not_Seen");
                 		existing.Source_Record_ID=source_record_id;
                 		existing.Source_Form=source_form;
                 		resp.put("ok",true);
                 		resp.put("message","Voucher updated.");
                 		resp.put("id",existing.ID);
                 		return resp;
                 	}
                 	new_id = insert into Voucher
                 	[
                 		Document_Type=payload.get("Document_Type")
                 		Voucher_Type=payload.get("Voucher_Type")
                 		Voucher_Number=voucher_number_val
                 		Employee=payload.get("Employee")
                 		Display_Name_Employee=payload.get("Display_Name_Employee")
                 		Issued_By=issued_by_val
                 		Display_Name_Issued_By=issued_by_text
                 		Received_By=received_by_val
                 		Display_Name_Received_By=received_by_text
                 		Date_Time_In=date_in_val
                 		Date_Time_Out=date_out_val
                 		Site=payload.get("Site")
                 		Display_Name_Site=payload.get("Display_Name_Site")
                 		Hours_Worked=payload.get("Hours_Worked")
                 		Shift=payload.get("Shift")
                 		Voucher_Status=voucher_status_val
                 		Management_Location=payload.get("Management_Location")
                 		Asset=payload.get("Asset")
                 		Machine_Start_of_Day=payload.get("Machine_Start_of_Day")
                 		Start_Time=start_time_val
                 		End_Time=end_time_val
                 		Manager_Time=manager_time_val
                 		Time_Checked=time_checked_val
                 		Hr_Time_Checked=hr_time_checked_val
                 		Odometer_Start=payload.get("Odometer_Start")
                 		Fuel_Start_Level=payload.get("Fuel_Start_Level")
                 		Odometer_End=payload.get("Odometer_End")
                 		Fuel_End_Level=payload.get("Fuel_End_Level")
                 		Item=payload.get("Item")
                 		Display_Name_Item=payload.get("Display_Name_Item")
                 		Quantity_To_Be_Created=payload.get("Quantity_To_Be_Created")
                 		Voucher_Cost=payload.get("Voucher_Cost")
                 		Cancel_Voucher=payload.get("Cancel_Voucher")
                 		Cancellation_Reason=payload.get("Cancellation_Reason")
                 		Seen=payload.get("Seen")
                 		Reason_for_not_Seen=payload.get("Reason_for_not_Seen")
                 		Source_Record_ID=source_record_id
                 		Source_Form=source_form
                 		Added_User=zoho.loginuser
                 	];
                 	resp.put("ok",true);
                 	resp.put("message","Voucher created.");
                 	resp.put("id",new_id);
                 	return resp;
                 }
