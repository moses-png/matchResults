			Set_Up_Form10 as "Set Up Form"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ==================================================
										// LOCK BACK-END CONTROLLED FIELDS
										// ==================================================
										//Voucher Header
										disable Display_Name_Site;
										disable Display_Name_Voucher;
										disable Rate_per_CBM;
										disable Time_Receipt;
										//Customer Section
										disable Display_Name_Customer;
										//Item Sales
										disable Item_Sales.Display_Name_Sales_Voucher;
										disable Item_Sales.Line_Number;
										disable Item_Sales.Display_Name_Item;
										disable Item_Sales.Unit_Of_Measure_Conversion;
										disable Item_Sales.Conversion_Factor;
										disable Item_Sales.Unit_Of_Measure;
										disable Item_Sales.Base_Unit_Of_Measure;
										disable Item_Sales.Quantity_in_Base_Unit;
										disable Item_Sales.Rate_in_Base_Unit;
										//Sand Sales
										disable Display_Name_Number_Plate;
										disable Card_Number;
										disable Truck_Type;
										disable Truck_Size_1;
										disable Truck_Size_2;
										disable Truck_CBM;
										//Payment Section
										disable Amount_Supposed_To_Pay_Item_Sales;
										disable Amount_Supposed_To_Pay_Sand_Sales;
										disable Amount_Supposed_To_Pay;
										disable Balance_Due;
										//Status Details
										disable Sales_Voucher_Status;
										disable Notes;
										disable Overall_Time_Spent_in_Site;
										//Cashier Section
										disable Amount_Paid;
										disable Amount_Credited;
										disable Payment_Status;
										disable Time_Cashier;
										disable Minutes_Used_Cashier;
										//Security Guard Section
										disable Time_Security_Guard_In;
										disable Minutes_Used_Security_Guard_In;
										disable Time_Security_Guard_Out;
										disable Minutes_Used_Security_Guard_Out;
										//Operator Section
										disable Item_Issuing_Details;
										disable Batch_Number;
										disable Site_Location;
										disable Delivery_Status;
										disable Time_Operator;
										disable Minutes_Used_Operator;
										//Company Trucks Section
										disable Company_Truck_Stage;
										//Back End
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// ==================================================
										// DEFAULT HIDDEN FIELDS
										// ==================================================
										//Voucher Header
										hide Display_Name_Site;
										hide Display_Name_Voucher;
										hide Rate_per_CBM;
										hide Time_Receipt;
										//Customer Section
										hide Display_Name_Customer;
										hide Credit_Note;
										hide Delivery_Note;
										// Item Sales
										hide Item_Sales;
										hide Item_Sales.Display_Name_Sales_Voucher;
										hide Item_Sales.Display_Name_Item;
										hide Item_Sales.Conversion_Factor;
										hide Item_Sales.Base_Unit_Of_Measure;
										hide Item_Sales.Quantity_in_Base_Unit;
										hide Item_Sales.Rate_in_Base_Unit;
										hide Item_Sales.Quantity_Delivered;
										hide Item_Sales.Delivery_Status;
										//Sand Sales
										hide Sand_Sales;
										hide Number_Plate;
										hide Display_Name_Number_Plate;
										hide Card_Number;
										hide Truck_Type;
										hide Truck_Measurement;
										hide Truck_Size_1;
										hide Truck_Size_2;
										hide Truck_Size;
										hide Truck_CBM;
										//Payment Section
										hide Amount_Supposed_To_Pay_Sand_Sales;
										hide Amount_Supposed_To_Pay_Item_Sales;
										hide Amount_Paid;
										hide Amount_Credited;
										hide Balance_Due;
										hide Payment_Status;
										//Status Details
										hide Status_Details;
										hide Sales_Voucher_Status;
										hide Notes;
										hide Overall_Time_Spent_in_Site;
										//Cashier Section
										hide Cashier_Section;
										hide Amount_Paid;
										hide Amount_Credited;
										hide Payment_Status;
										hide Time_Cashier;
										hide Minutes_Used_Cashier;
										//Security Guard Section
										hide Security_Guard_Section;
										hide Time_Security_Guard_In;
										hide Minutes_Used_Security_Guard_In;
										hide Time_Security_Guard_Out;
										hide Minutes_Used_Security_Guard_Out;
										//Operator Section
										hide Operator_Section;
										hide Item_Issuing_Details;
										hide Batch_Number;
										hide Site_Location;
										hide Delivery_Status;
										hide Time_Operator;
										hide Minutes_Used_Operator;
										//Company Trucks Section
										hide Company_Trucks_Section;
										hide Company_Truck_Stage;
										//Back End
										hide Back_End;
										// ==================================================
										// CUSTOMER RULES (Sales Voucher → On Load)
										// ==================================================
										if(input.Customer != null)
										{
											input.Display_Name_Customer = input.Customer.Display_Name_Customer;
											creditAllowed = ifnull(input.Customer.Credit_is_Allowed,false);
											dnRequired = ifnull(input.Customer.Delivery_Note_Required,false);
											cnRequired = ifnull(input.Customer.Credit_Note_Required,false);
											if(dnRequired == true)
											{
												show Delivery_Note;
											}
											else
											{
												input.Delivery_Note = null;
												hide Delivery_Note;
											}
											if(creditAllowed == true && cnRequired == true)
											{
												show Credit_Note;
											}
											else
											{
												input.Credit_Note = null;
												hide Credit_Note;
											}
										}
										// ==================================================
										// SALES TYPE UI RULES (Sales Voucher -> On Load)
										// ==================================================
										if(input.Sales_Type == "Sand Sales")
										{
											show Sand_Sales;
											show Number_Plate;
											show Truck_Measurement;
											show Truck_Size;
											show Truck_CBM;
											hide Item_Sales;
											hide Amount_Supposed_To_Pay_Item_Sales;
											show Amount_Supposed_To_Pay_Sand_Sales;
										}
										else if(input.Sales_Type == "Item Sales")
										{
											hide Sand_Sales;
											hide Number_Plate;
											hide Truck_Measurement;
											hide Truck_Size;
											hide Truck_CBM;
											show Item_Sales;
											hide Amount_Supposed_To_Pay_Sand_Sales;
											show Amount_Supposed_To_Pay_Item_Sales;
										}
										else if(input.Sales_Type == "Sand & Item Sales")
										{
											show Sand_Sales;
											show Number_Plate;
											show Truck_Measurement;
											show Truck_Size;
											show Truck_CBM;
											show Item_Sales;
											show Amount_Supposed_To_Pay_Sand_Sales;
											show Amount_Supposed_To_Pay_Item_Sales;
										}
										else
										{
											hide Sand_Sales;
											hide Number_Plate;
											hide Truck_Measurement;
											hide Truck_Size;
											hide Truck_CBM;
											hide Item_Sales;
											hide Amount_Supposed_To_Pay_Sand_Sales;
											hide Amount_Supposed_To_Pay_Item_Sales;
										}
										// ==================================================
										// PAYMENT FIELD RULES - CREATE + EDIT
										// ==================================================
										if(input.ID == null)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											hide Amount_Paid;
											hide Amount_Credited;
											hide Balance_Due;
											disable Amount_Credited;
											disable Balance_Due;
										}
										else
										{
											enable Amount_To_Pay;
											disable Balance_Due;
										}
						)
					}
				}

			}
