										{
											input.Display_Name_Payment_Voucher = input.Payment_Made_Voucher.Payment_Made_Number;
											max_line = 0;
											rows = Payment_Charges[Payment_Made_Voucher == input.Payment_Made_Voucher];
											for each  r in rows
											{
												if(r.Line_Number != null && r.Line_Number > max_line)
												{
													max_line = r.Line_Number;
												}
											}
											input.Line_Number = max_line + 1;
										}
										else
										{
											input.Display_Name_Payment_Voucher = "";
