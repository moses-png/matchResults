			Full_Validation15 as "Full Validation"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										// safer create check
										if(input.ID == null)
										{
											is_create = true;
										}
										else
										{
											is_create = false;
										}
										// keep your image logic (unchanged)
										before_img = ifnull(input.Image_Before.toString(),"").trim();
										after_img = ifnull(input.Image_After.toString(),"").trim();
										// Cancel rule
										if(input.Cancelled == true)
										{
											if(isNull(input.Reason_Why_Cancelled) || input.Reason_Why_Cancelled.trim() == "")
											{
												errors = errors + "\n• Reason Why Cancelled is required when Cancelled is checked.";
											}
										}
										// CREATE
										if(is_create)
										{
											if(input.Voucher == null)
											{
												errors = errors + "\n• Voucher is required.";
											}
											if(input.Location == null)
											{
												errors = errors + "\n• Location is required.";
											}
											if(input.Job == null)
											{
												errors = errors + "\n• Job is required.";
											}
											else
											{
												// FIX: removed ifnull().trim()
												jobNo = input.Job.Job_No;
												if(jobNo == "TJS01" && input.Card == null)
												{
													errors = errors + "\n• Card is required for Card Sales.";
												}
												else if(jobNo == "TJS02" && input.Work_Order_Task == null)
												{
													errors = errors + "\n• Work Order Task is required for Service Task.";
												}
												else if(jobNo == "TJS03" && input.Batch_Number == null)
												{
													errors = errors + "\n• Stock Production is required for Stock Production job.";
												}
											}
											if(input.Odometer_Start == null)
											{
												errors = errors + "\n• Odometer Start is required.";
											}
											// keep image check exactly as you had it
											if(before_img == "")
											{
												errors = errors + "\n• Image Before is required on create.";
											}
										}
										else
										{
											if(input.Cancelled != true && input.Tractor_Work_Report_Status == "In Progress" && input.Odometer_End == null)
											{
												errors = errors + "\n• Odometer End is required when Status is In Progress and the record is not cancelled.";
											}
											// keep image check exactly as you had it
											if(after_img == "")
											{
												errors = errors + "\n• Image After is required on edit.";
											}
										}
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize8 as "Finalize"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											info "===== TRACTOR WORK REPORT FINALIZE START =====";
										jobNo = "";
										if(input.Job != null)
										{
											jobNo = ifnull(input.Job.Job_No,"");
										}
										// CREATE OR EDIT CHECK
										is_create = false;
										if(input.Added_Time != null && input.Modified_Time != null)
										{
											if(input.Added_Time.toLong() == input.Modified_Time.toLong())
											{
												is_create = true;
											}
										}
										// ON CREATE
										if(is_create)
										{
											if(input.Time_Start == null)
											{
												input.Time_Start = zoho.currenttime;
											}
										}
										else
										{
											// CANCELLED
											if(input.Cancelled == true)
											{
												input.Tractor_Work_Report_Status = "Cancelled";
											}
											else if(input.Tractor_Work_Report_Status == "In Progress")
											{
												if(input.Time_End == null)
												{
													input.Time_End = zoho.currenttime;
												}
												if(input.Time_Start != null && input.Time_End != null)
												{
													diffMillis = input.Time_End.toLong() - input.Time_Start.toLong();
													if(diffMillis >= 0)
													{
														input.Line_Duration_Minutes = round(diffMillis / 60000.0,2);
														input.Line_Hours_Worked = round(diffMillis / 3600000.0,2);
													}
													else
													{
														input.Line_Duration_Minutes = null;
														input.Line_Hours_Worked = null;
													}
												}
												if(jobNo == "TJS03")
												{
													input.Tractor_Work_Report_Status = "Loaded";
												}
												else
												{
													input.Tractor_Work_Report_Status = "Completed";
												}
											}
										}
										// ========================================
										// TJS01 - UPDATE SALES VOUCHER
										// ========================================
										if(jobNo == "TJS01" && input.Tractor_Work_Report_Status == "Completed")
										{
											if(input.Card != null)
											{
												card_rec = Sales_Voucher[ID == input.Card.ID];
												if(card_rec.ID != null)
												{
													nowTime = zoho.currenttime;
													card_rec.Sales_Voucher_Status="Security Guard Out";
													card_rec.Time_Operator=nowTime;
													if(input.Batch_Number != null)
													{
														card_rec.Batch_Number=input.Batch_Number;
													}
													if(input.Location != null)
													{
														card_rec.Site_Location=input.Location;
													}
													if(card_rec.Time_Security_Guard_In != null)
													{
														diffMillisOp = nowTime.toLong() - card_rec.Time_Security_Guard_In.toLong();
														if(diffMillisOp >= 0)
														{
															card_rec.Minutes_Used_Operator=round(diffMillisOp / 60000.0,2);
														}
														else
														{
															card_rec.Minutes_Used_Operator=null;
														}
													}
												}
											}
										}
										// ========================================
										// TJS01 - CREATE BATCH STOCK OUT
										// ========================================
										if(jobNo == "TJS01" && input.Tractor_Work_Report_Status == "Completed")
										{
											if(input.Card != null && input.Batch_Number != null)
											{
												sourceID = input.ID;
												existingBatchStock = Batch_Stock[Source_Record_ID == sourceID];
												if(existingBatchStock.count() == 0)
												{
													lastLine = Batch_Stock[Batch_Number == input.Batch_Number] sort by Line_Number desc;
													nextLine = 1;
													currentBalance = 0.0;
													for each  l in lastLine
													{
														nextLine = ifnull(l.Line_Number,0) + 1;
														currentBalance = ifnull(l.Running_Balance,0.0);
														break;
													}
													qtyOut = 0 - ifnull(input.Card.Truck_CBM,0.0);
													newBalance = currentBalance + qtyOut;
													insert into Batch_Stock
													[
														Batch_Number=input.Batch_Number
														Display_Name_Batch_Number=input.Batch_Number.Batch_Number
														Line_Number=nextLine
														Batch_Time=input.Time_End
														Batch_Type="Out"
														Reference=input.Card.Card_Number + " - " + input.Card.Display_Name_Number_Plate
														Quantity=qtyOut
														Running_Balance=newBalance
														Source_Record_ID=sourceID
														Source_Form="Employee Management - Tractor Work Report"
														Added_User=zoho.loginuser
													]
												}
											}
										}
										// ========================================
										// TJS02 - SYNC TO ASSET MANAGEMENT
										// ========================================
										if(jobNo == "TJS02" && input.Tractor_Work_Report_Status == "Completed")
										{
											if(input.Work_Order_Task != null)
											{
												payload = Map();
												payload.put("Work_Order_Task_ID",input.Work_Order_Task.ID);
												payload.put("Work_Order_Task_Number",ifnull(input.Work_Order_Task.Work_Order_Task_Number,""));
												payload.put("Display_Name_Work_Order_Task_Number",ifnull(input.Work_Order_Task.Work_Order_Task_Number,""));
												payload.put("Display_Name_Item_Labour","Machine Hire");
												payload.put("Display_Name_Asset",ifnull(input.Display_Name_Asset,""));
												payload.put("Odometer_Start",ifnull(input.Odometer_Start,0.0));
												payload.put("Odometer_End",ifnull(input.Odometer_End,0.0));
												payload.put("Quantity",ifnull(input.Line_Hours_Worked,0.0));
												desc = ifnull(input.Display_Name_Asset,"") + " started " + ifnull(input.Odometer_Start,0.0).toString() + " and ended at " + ifnull(input.Odometer_End,0.0).toString();
												payload.put("Description",desc);
												payload.put("Source_Record_ID",input.ID.toString());
												payload.put("Source_Form","Employee Management - Tractor Work Report");
												resp = asset_management.syncPartsConsumablesFromTractorWorkReport(payload);
												info "Response: " + resp.toString();
											}
										}
										info "===== TRACTOR WORK REPORT FINALIZE END =====";
						)
					}
				}

			}
			Full_Validation20 as "Full Validation"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// INVOICE -> FULL VALIDATION
										// ======================================
										errors = "";
										// 1) Company Register required
										if(input.Company_Register == null)
										{
											errors = errors + "\n• Company Register is required.";
										}
										// 2) Invoice Date required
										if(input.Invoice_Date == null)
										{
											errors = errors + "\n• Invoice Date is required.";
										}
										else if(input.Invoice_Date > zoho.currentdate)
										{
											errors = errors + "\n• Invoice Date cannot be in the future.";
										}
										// 3) Invoice Number required
										if(isNull(input.Invoice_Number) || input.Invoice_Number.trim() == "")
										{
											errors = errors + "\n• Invoice Number is required.";
										}
										else
										{
											dupInvoice = Invoice[Invoice_Number == input.Invoice_Number && ID != input.ID];
											if(dupInvoice.count() > 0)
											{
												errors = errors + "\n• Invoice Number already exists. Please enter a unique Invoice Number.";
											}
										}
										// 4) Customer required
										if(input.Customer == null)
										{
											errors = errors + "\n• Customer is required.";
										}
										// 5) Stop submission if there are errors
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
