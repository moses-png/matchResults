			On_Invoice_Selected as "On Invoice Selected"
			{
				type =  form
				form = Invoice_Details

				record event = on add or edit

				on user input of Invoice
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// INVOICE DETAILS -> ON INVOICE SELECTED
										// Autofill Display Name Invoice + Line Number
										// ======================================
										if(input.Invoice != null)
										{
											// 1) Display Name Invoice
											input.Display_Name_Invoice = ifnull(input.Invoice.Invoice_Number,"");
											// 2) Next Line Number
											next_line_no = 1;
											existing_rows = Invoice_Details[Invoice == input.Invoice] sort by Line_Number desc;
											for each  row in existing_rows
											{
												next_line_no = ifnull(row.Line_Number,0) + 1;
												break;
											}
											input.Line_Number = next_line_no;
										}
										else
										{
											input.Display_Name_Invoice = "";
											input.Line_Number = null;
										}
						)
					}
				}

			}
			Finalize14 as "Finalize"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// INVOICE -> FINALIZE
										// 1) Generate Invoice Number if empty
										// 2) Recalculate totals
										// 3) Update Payment Status
										// ======================================
										// --------------------------------------
										// 1) GENERATE INVOICE NUMBER
										// --------------------------------------
										if(input.Invoice_Number == null || input.Invoice_Number.trim() == "")
										{
											doc = Document_Key[Voucher_Type == "Invoice"];
											if(doc.ID != null)
											{
												nextNum = ifnull(doc.Next_Number,1);
												numStr = "";
												if(nextNum < 10)
												{
													numStr = "0000" + nextNum.toString();
												}
												else if(nextNum < 100)
												{
													numStr = "000" + nextNum.toString();
												}
												else if(nextNum < 1000)
												{
													numStr = "00" + nextNum.toString();
												}
												else if(nextNum < 10000)
												{
													numStr = "0" + nextNum.toString();
												}
												else
												{
													numStr = nextNum.toString();
												}
												input.Invoice_Number = doc.Prefix + "-" + numStr;
												doc.Next_Number=nextNum + 1;
											}
											else
											{
												info "No Document Key found for Invoice";
											}
										}
										// --------------------------------------
										// 2) RECALCULATE TOTALS
										// --------------------------------------
										sub_total = 0.0;
										inv_lines = Invoice_Details[Invoice == input.ID];
										for each  row in inv_lines
										{
											sub_total = sub_total + ifnull(row.Line_Total,0.0);
										}
										sub_total = round(sub_total,2);
										discount_amt = round(ifnull(input.Discount,0.0),2);
										tax_amt = round(ifnull(input.Tax_Amount,0.0),2);
										amount_paid = round(ifnull(input.Amount_Paid,0.0),2);
										grand_total = round(sub_total - discount_amt + tax_amt,2);
										if(grand_total < 0)
										{
											grand_total = 0.0;
										}
										balance_due = round(grand_total - amount_paid,2);
										if(balance_due < 0)
										{
											balance_due = 0.0;
										}
										// --------------------------------------
										// 3) PAYMENT STATUS
										// --------------------------------------
										payment_status = "Not Paid";
										if(amount_paid <= 0)
										{
											payment_status = "Not Paid";
										}
										else if(balance_due > 0)
										{
											payment_status = "Partially Paid";
										}
										else
										{
											payment_status = "Paid";
										}
										// --------------------------------------
										// 4) UPDATE HEADER
										// --------------------------------------
										input.Sub_Total = sub_total;
										input.Grand_Total = grand_total;
										input.Amount_Paid = amount_paid;
										input.Balance_Due = balance_due;
										input.Payment_Status = payment_status;
						)
					}
				}

			}
			Set_Up_Form as "Set Up Form"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// INVOICE -> LOAD OF FORM
										// UI CONTROL + DEFAULTS
										// ======================================
										// --------------------------------------
										// 1) DISABLE SYSTEM-CALCULATED FIELDS
										// --------------------------------------
										disable Sub_Total;
										disable Discount;
										disable Tax_Amount;
										disable Grand_Total;
										disable Amount_Paid;
										disable Balance_Due;
										disable Payment_Status;
										// --------------------------------------
										// 2) HIDE OPTIONAL FIELDS
										// --------------------------------------
										hide Reason_Why_Cancelled;
										// --------------------------------------
										// 3) HANDLE CANCEL LOGIC (INITIAL LOAD)
										// --------------------------------------
										if(input.Cancel_Invoice == true)
										{
											show Reason_Why_Cancelled;
										}
										else
										{
											hide Reason_Why_Cancelled;
										}
										// --------------------------------------
										// 4) DEFAULT VALUES (ON CREATE)
										// --------------------------------------
										if(input.ID == null)
										{
											input.Status = "Draft";
											input.Payment_Status = "Not Paid";
										}
						)
					}
				}

			}
			On_Cancel_Invoice_Selecte as "On Cancel Invoice Selected"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on user input of Cancel_Invoice
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// INVOICE -> ON CANCEL INVOICE SELECTED
										// ======================================
										if(input.Cancel_Invoice == true)
										{
											show Reason_Why_Cancelled;
											input.Status = "Cancelled";
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = "";
											// Only reset if it was cancelled by the checkbox
											if(input.Status == "Cancelled")
											{
												if(input.Sub_Total != null && input.Sub_Total > 0)
												{
													input.Status = "Invoiced";
												}
												else
												{
													input.Status = "Draft";
												}
											}
										}
						)
					}
				}

			}
			On_Status_Selected1 as "On Status Selected"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on user input of Status
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// INVOICE -> ON STATUS SELECTED
										// ======================================
										if(input.Status == "Cancelled")
										{
											input.Cancel_Invoice = true;
