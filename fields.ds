				 map createOrUpdateAssetTransactionLog(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	u = thisapp.audit.getLoginAuditInfo();
                 	user_name_val = u.get("name");
                 	user_email_val = u.get("email");
                 	user_role_val = u.get("role");
                 	asset_id = payload.get("Asset");
                 	source_form = ifnull(payload.get("Source_Form"),"");
                 	source_record_id = payload.get("Source_Record_ID");
                 	if(asset_id == null)
                 	{
                 		resp.put("message","Asset is required.");
                 		return resp;
                 	}
                 	if(source_form == "" || source_record_id == null)
                 	{
                 		resp.put("message","Source information is required.");
                 		return resp;
                 	}
                 	existing = Asset_Transaction_Log[Source_Form == source_form && Source_Record_ID == source_record_id];
                 	if(existing.ID != null)
                 	{
                 		existing.Transaction_Date=payload.get("Transaction_Date");
                 		existing.Transaction_Status=payload.get("Transaction_Status");
                 		existing.Transaction_Description=payload.get("Transaction_Description");
                 		existing.Asset=asset_id;
                 		existing.Display_Name_Asset=payload.get("Display_Name_Asset");
                 		existing.Transaction_Direction=payload.get("Transaction_Direction");
                 		existing.Amount=ifnull(payload.get("Amount"),0.0);
                 		existing.Income=ifnull(payload.get("Income"),0.0);
                 		existing.Expenses=ifnull(payload.get("Expenses"),0.0);
                 		existing.Application=payload.get("Application");
                 		existing.Source_Form=source_form;
                 		existing.Source_Record_ID=source_record_id;
                 		existing.Notes=payload.get("Notes");
                 		existing.User_Name=user_name_val;
                 		existing.User_Email=user_email_val;
                 		existing.User_Role=user_role_val;
                 		existing.Updated_By_Name=user_name_val;
                 		existing.Updated_By_Email=user_email_val;
                 		existing.Updated_By_Time=zoho.currenttime;
                 		log_id = existing.ID;
                 		resp.put("Action","Updated");
                 	}
                 	else
                 	{
                 		log_id = insert into Asset_Transaction_Log
                 		[
                 			Transaction_Date=payload.get("Transaction_Date")
                 			Transaction_Status=payload.get("Transaction_Status")
                 			Transaction_Description=payload.get("Transaction_Description")
                 			Asset=asset_id
                 			Display_Name_Asset=payload.get("Display_Name_Asset")
                 			Transaction_Direction=payload.get("Transaction_Direction")
                 			Amount=ifnull(payload.get("Amount"),0.0)
                 			Income=ifnull(payload.get("Income"),0.0)
                 			Expenses=ifnull(payload.get("Expenses"),0.0)
                 			Application=payload.get("Application")
                 			Source_Form=source_form
                 			Source_Record_ID=source_record_id
                 			Notes=payload.get("Notes")
                 			User_Name=user_name_val
                 			User_Email=user_email_val
                 			User_Role=user_role_val
                 			Created_By_Name=user_name_val
                 			Created_By_Email=user_email_val
                 			Created_By_Time=zoho.currenttime
                 			Added_User=zoho.loginuser
                 		];
                 		resp.put("Action","Created");
                 	}
                 	resp.put("ok",true);
                 	resp.put("Log_ID",log_id);
                 	resp.put("message","Asset Transaction Log saved.");
                 	return resp;
                 }
				 map deleteMileageLogFromCleanSand(string source_form_text, string source_record_id_text)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	if(source_form_text == null || source_form_text.trim() == "")
                 	{
                 		resp.put("message","Source form is required.");
                 		return resp;
                 	}
                 	if(source_record_id_text == null || source_record_id_text.trim() == "")
                 	{
                 		resp.put("message","Source record ID is required.");
                 		return resp;
                 	}
                 	logs = Asset_Mileage_Log[Odometer_Source_Form == source_form_text && Source_Record_ID == source_record_id_text];
                 	asset_ids = List();
                 	for each  l in logs
                 	{
                 		if(l.Asset != null)
                 		{
                 			asset_ids.add(l.Asset);
                 		}
                 		delete from Asset_Mileage_Log[ID == l.ID];
                 	}
                 	for each  asset_id in asset_ids
                 	{
                 		prev_odo = 0.0;
                 		all_logs = Asset_Mileage_Log[Asset == asset_id] sort by Date_Time_Recorded asc;
                 		for each  ml in all_logs
                 		{
                 			if(ml.Void_Mileage == true)
                 			{
                 				continue;
                 			}
                 			ml.Previous_Odometer=prev_odo;
                 			dist = ifnull(ml.Odometer_Reading,0.0) - prev_odo;
                 			if(dist < 0)
                 			{
                 				dist = 0.0;
                 			}
                 			ml.Distance_Since_Last=dist;
                 			prev_odo = ifnull(ml.Odometer_Reading,0.0);
                 		}
                 		asset_rec = Asset_List[ID == asset_id];
                 		if(asset_rec.ID != null)
                 		{
                 			latest_odo = 0.0;
                 			latest_time = null;
                 			latest_logs = Asset_Mileage_Log[Asset == asset_id] sort by Date_Time_Recorded desc;
                 			for each  latest in latest_logs
                 			{
                 				if(latest.Void_Mileage == true)
                 				{
                 					continue;
                 				}
                 				latest_odo = ifnull(latest.Odometer_Reading,0.0);
                 				latest_time = latest.Date_Time_Recorded;
                 				break;
                 			}
                 			asset_rec.Odometer_Reading=latest_odo;
                 			asset_rec.Date_Time_Odometer_Read=latest_time;
                 		}
                 	}
                 	resp.put("ok",true);
                 	resp.put("message","Clean Sand mileage log deleted and recalculated.");
                 	return resp;
                 }
