			On_Site_Selected9 as "On Site Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Site
				{
					actions 
					{
						custom deluge script
						(
											if(input.Site != null)
										{
											input.Display_Name_Site = input.Site.Display_Name_Asset_Name;
											cc = Card_Control[Site == input.Site && Card_Status == "Active"];
											if(cc.count() > 0)
											{
												input.Rate_per_CBM = cc.Rate_per_CBM;
											}
											else
											{
												input.Rate_per_CBM = null;
												alert "No ACTIVE Card Control found for this site.";
											}
										}
										else
										{
											input.Display_Name_Site = null;
											input.Rate_per_CBM = null;
										}
										// 3) Recalculate all amount fields
										sand_total = ifnull(input.Rate_per_CBM,0) * ifnull(input.Truck_CBM,0);
										item_total = 0;
										for each  r in input.Item_Sales
										{
											item_total = item_total + ifnull(r.Line_Total,0);
										}
										input.Amount_Supposed_To_Pay_Sand_Sales = round(sand_total,2);
										input.Amount_Supposed_To_Pay_Item_Sales = round(item_total,2);
										input.Amount_Supposed_To_Pay = round(sand_total + item_total / 10000,2);
						)
					}
				}

			}
