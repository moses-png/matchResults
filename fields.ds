                 	allowance = Employment_Status[Employee == emp.ID && Employment_Status == "Active"];
                 	if(allowance.ID != null)
                 	{
                 		resp.put("Daily_Allowance",ifnull(allowance.Daily_Allowance,0.0));
                 		resp.put("Weekly_Allowance",ifnull(allowance.Weekly_Allowance,0.0));
                 		resp.put("Monthly_Salary",ifnull(allowance.Monthly_Salary,0.0));
                 	}
                 	return resp;
                 }
				 map get_document_key_by_prefix(string prefix_code)
                 {
                 	result = Map();
                 	prefix_code = ifnull(prefix_code,"").trim().toUpperCase();
                 	doc_key = Document_Key[Prefix == prefix_code];
                 	if(doc_key.ID != null)
                 	{
                 		result.put("success",true);
                 		result.put("id",doc_key.ID);
                 		result.put("voucher_type",ifnull(doc_key.Voucher_Type,""));
                 		result.put("prefix",ifnull(doc_key.Prefix,""));
                 	}
                 	else
                 	{
                 		result.put("success",false);
                 		result.put("id",0);
                 		result.put("voucher_type","");
                 		result.put("prefix",prefix_code);
                 	}
                 	return result;
                 }
				 string normalize_ug_phone(string raw)
                 {
                 	if(raw == null)
                 	{
                 		raw = "";
                 	}
                 	// strip non-dialable chars
                 	raw = raw.replaceAll("[^0-9+]","");
                 	// already +256…
                 	if(raw.startsWith("+256"))
                 	{
                 		return raw;
                 	}
                 	// 2567… → +2567…
                 	if(raw.startsWith("256"))
                 	{
                 		return "+" + raw;
                 	}
                 	// 07… → +2567…
                 	if(raw.startsWith("0"))
                 	{
                 		raw = raw.replaceAll("^0","");
                 		return "+256" + raw;
                 	}
                 	// 7… → +2567…
                 	if(raw.startsWith("7"))
                 	{
                 		return "+256" + raw;
                 	}
                 	// fallback
                 	return raw;
                 }
				 void recalculateVoucherMaterialsCost(int voucher_id)
                 {
                 	v = Voucher[ID == voucher_id];
                 	if(v.ID == null)
                 	{
                 		return;
                 	}
                 	total_cost = 0.0;
                 	// Item Issuing Details
                 	item_rows = Item_Issuing_Details[Voucher.ID == voucher_id];
                 	for each  r in item_rows
                 	{
                 		total_cost = total_cost + ifnull(r.Quantity,0.0) * ifnull(r.Cost,0.0);
                 	}
                 	// Employee Issuing Details
                 	emp_rows = Employee_Issuing_Details[Voucher.ID == voucher_id];
                 	for each  er in emp_rows
                 	{
                 		total_cost = total_cost + ifnull(er.Quantity,0.0) * ifnull(er.Cost,0.0);
                 	}
                 	// Fuel Receiving Voucher
                 	fuel_rows = Fuel_Receiving_Voucher[Voucher.ID == voucher_id];
                 	for each  fr in fuel_rows
                 	{
                 		total_cost = total_cost + ifnull(fr.Quantity,0.0) * ifnull(fr.Rate,0.0);
                 	}
                 	info total_cost;
                 	v.Voucher_Cost=round(total_cost,2);
                 }
				 map syncCleanSandVoucherTransferRegister(map input)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("msg","Unknown error");
                 	try 
                 	{
                 		case_no = ifnull(input.get("Case_Number"),"").trim();
                 		if(case_no == "")
                 		{
                 			response.put("msg","Case_Number is missing");
                 		}
                 		else
                 		{
                 			transport_dt = input.get("Transport_Date");
                 			if(transport_dt == null)
                 			{
                 				transport_dt = zoho.currenttime;
                 			}
                 			how_to_take = ifnull(input.get("How_To_Take_To_Head_Office"),"");
                 			from_site = ifnull(input.get("From_Site"),"");
                 			employee_take_name = ifnull(input.get("Employee_Taking_To_Head_Office"),"");
                 			source_record_id = input.get("Source_Record_ID");
                 			total_vouchers = ifnull(input.get("Number_Of_Vouchers"),0);
                 			if(source_record_id == null || source_record_id.toString().trim() == "")
                 			{
                 				response.put("msg","Source_Record_ID is missing");
                 			}
                 			else
                 			{
                 				source_record_id_num = source_record_id.toLong();
                 				u = thisapp.audit.getLoginAuditInfo();
                 				existingTR = Voucher_Transfer_Register[Case_Number == case_no && Source_Record_ID == source_record_id_num && Source_Form == "Clean Sand Management - Voucher Register"];
                 				if(existingTR.ID != null)
                 				{
                 					existingTR.Transport_Date=transport_dt;
                 					existingTR.How_To_Take_To_Head_Office=how_to_take;
                 					existingTR.From_Site=from_site;
                 					existingTR.Employee_Taking_To_Head_Office=employee_take_name;
                 					existingTR.To_Site="Clean Sand - Head Office";
                 					existingTR.Number_Of_Vouchers=total_vouchers;
                 					existingTR.Source_Form="Clean Sand Management - Voucher Register";
                 					existingTR.Source_Record_ID=source_record_id_num;
                 					existingTR.Case_Status="In Transit";
                 					existingTR.User_Name=u.get("name");
                 					existingTR.User_Email=u.get("email");
                 					existingTR.User_Role=u.get("role");
                 					existingTR.Updated_By_Name=u.get("name");
                 					existingTR.Updated_By_Email=u.get("email");
                 					existingTR.Updated_By_Time=zoho.currenttime;
                 					response.put("ok",true);
                 					response.put("msg","Updated existing transfer register");
                 					response.put("Voucher_Transfer_Register_ID",existingTR.ID);
                 				}
                 				else
                 				{
                 					insert into Voucher_Transfer_Register
                 					[
                 						Case_Number=case_no
                 						Transport_Date=transport_dt
                 						How_To_Take_To_Head_Office=how_to_take
                 						From_Site=from_site
                 						Employee_Taking_To_Head_Office=employee_take_name
                 						To_Site="Clean Sand - Head Office"
                 						Number_Of_Vouchers=total_vouchers
                 						Source_Form="Clean Sand Management - Voucher Register"
                 						Source_Record_ID=source_record_id_num
                 						Case_Status="In Transit"
                 						User_Name=u.get("name")
                 						User_Email=u.get("email")
                 						User_Role=u.get("role")
                 						Created_By_Name=u.get("name")
                 						Created_By_Email=u.get("email")
                 						Created_By_Time=zoho.currenttime
                 						Added_User=zoho.loginuser
                 					]
                 					response.put("ok",true);
                 					response.put("msg","Created transfer register");
                 				}
                 			}
                 		}
                 	}	catch (e)
                 	{
                 		response.put("ok",false);
                 		response.put("msg",e.toString());
                 	}
                 	return response;
                 }
				 map syncConcreteVoucherTransferRegister(map input)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("msg","Unknown error");
                 	try 
                 	{
                 		case_no = ifnull(input.get("Case_Number"),"").trim();
                 		if(case_no == "")
                 		{
                 			response.put("msg","Case_Number is missing");
                 		}
                 		else
                 		{
                 			source_record_id = input.get("Source_Record_ID");
                 			if(source_record_id == null || source_record_id.toString().trim() == "")
                 			{
                 				response.put("msg","Source_Record_ID is missing");
                 			}
                 			else
                 			{
                 				source_record_id_num = source_record_id.toLong();
                 				source_form = "Concrete Products Management - Voucher Register";
                 				transport_dt = input.get("Transport_Date");
                 				if(transport_dt == null)
                 				{
                 					transport_dt = zoho.currenttime;
                 				}
                 				how_to_take = ifnull(input.get("How_To_Take_To_Head_Office"),"");
                 				from_site = ifnull(input.get("From_Site"),"");
                 				employee_take_name = ifnull(input.get("Employee_Taking_To_Head_Office"),"");
                 				total_vouchers = ifnull(input.get("Number_Of_Vouchers"),0);
                 				u = thisapp.audit.getLoginAuditInfo();
                 				// ==========================================
                 				// FIND EXISTING TRANSFER REGISTER
                 				// ==========================================
                 				existing_transfer_id = 0;
                 				// First search using Source Record and Source Form
                 				source_matches = Voucher_Transfer_Register[Source_Record_ID == source_record_id_num && Source_Form == source_form];
                 				for each  source_match in source_matches
                 				{
                 					existing_transfer_id = source_match.ID;
                 					break;
                 				}
                 				// If no source match, search using Case Number
                 				if(existing_transfer_id == 0)
                 				{
                 					case_matches = Voucher_Transfer_Register[Case_Number == case_no];
                 					for each  case_match in case_matches
                 					{
                 						existing_transfer_id = case_match.ID;
                 						break;
                 					}
                 				}
                 				// ==========================================
                 				// UPDATE EXISTING TRANSFER
                 				// ==========================================
                 				if(existing_transfer_id > 0)
                 				{
                 					existingTR = Voucher_Transfer_Register[ID == existing_transfer_id];
                 					if(existingTR.ID != null)
                 					{
                 						existingTR.Case_Number=case_no;
                 						existingTR.Transport_Date=transport_dt;
                 						existingTR.How_To_Take_To_Head_Office=how_to_take;
                 						existingTR.From_Site=from_site;
                 						existingTR.Employee_Taking_To_Head_Office=employee_take_name;
                 						existingTR.To_Site="Freedom City - Head Office";
                 						existingTR.Number_Of_Vouchers=total_vouchers;
                 						// Repair or populate the source reference
                 						existingTR.Source_Form=source_form;
                 						existingTR.Source_Record_ID=source_record_id_num;
                 						if(ifnull(existingTR.Case_Status,"") != "Closed")
                 						{
                 							existingTR.Case_Status="In Transit";
                 						}
                 						existingTR.User_Name=u.get("name");
                 						existingTR.User_Email=u.get("email");
                 						existingTR.User_Role=u.get("role");
                 						existingTR.Updated_By_Name=u.get("name");
                 						existingTR.Updated_By_Email=u.get("email");
                 						existingTR.Updated_By_Time=zoho.currenttime;
                 						response.put("ok",true);
                 						response.put("msg","Updated existing transfer register");
                 						response.put("Voucher_Transfer_Register_ID",existingTR.ID);
                 					}
                 					else
                 					{
                 						response.put("msg","Existing transfer register could not be loaded");
                 					}
                 				}
                 				// ==========================================
                 				// CREATE NEW TRANSFER
                 				// ==========================================
                 				else
                 				{
                 					transfer_id = insert into Voucher_Transfer_Register
                 					[
                 						Case_Number=case_no
                 						Transport_Date=transport_dt
                 						How_To_Take_To_Head_Office=how_to_take
                 						From_Site=from_site
                 						Employee_Taking_To_Head_Office=employee_take_name
                 						To_Site="Freedom City - Head Office"
                 						Number_Of_Vouchers=total_vouchers
                 						Source_Form=source_form
                 						Source_Record_ID=source_record_id_num
                 						Case_Status="In Transit"
                 						User_Name=u.get("name")
                 						User_Email=u.get("email")
                 						User_Role=u.get("role")
                 						Created_By_Name=u.get("name")
                 						Created_By_Email=u.get("email")
                 						Created_By_Time=zoho.currenttime
                 						Added_User=zoho.loginuser
                 					];
                 					response.put("ok",true);
                 					response.put("msg","Created transfer register");
                 					response.put("Voucher_Transfer_Register_ID",transfer_id);
                 				}
                 			}
                 		}
                 	}	catch (e)
                 	{
                 		response.put("ok",false);
                 		response.put("msg",e.toString());
                 	}
                 	return response;
                 }
