										{
											if(input.Party_From != null)
											{
												partyName = ifnull(input.Party_From.Party_Name,"").toString();
												partyID = ifnull(input.Party_From.Party_ID,"").toString();
												input.Display_Name_Party_From = trim(partyName + " - " + partyID);
												if(partyName == null || partyName == "")
												{
													input.Display_Name_Party_From = partyID;
												}
												else if(partyID == null || partyID == "")
												{
													input.Display_Name_Party_From = partyName;
												}
												input.Pick_Up_From = input.Display_Name_Party_From;
											}
											else
											{
												input.Pick_Up_From = "";
											}
										}
						)
