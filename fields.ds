											row.Bill_Number=ifnull(row.Employee_Management_Bill.Bill_Number,"");
											row.Amount_Due=ifnull(row.Employee_Management_Bill.Balance_Due,0.0);
										}
										else
										{
											row.Bill_Number="";
											row.Amount_Due=0.0;
										}
						)
					}
				}

			}
			On_Store_Management_Bill_1 as "On Store Management Bill Selected"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on user input of Payment_Details.Store_Management_Bill
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// PAYMENT DETAILS SUBFORM
										// On user input of Store_Management_Bill
										// Parent Form: Payment_Voucher
										// Subform: Payment_Details
										// ======================================
