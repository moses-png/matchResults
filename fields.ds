			Full_Validation17 as "Full Validation"
			{
				type =  form
				form = Bill_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// BILL DETAILS -> FULL VALIDATION
										// ======================================
										errors = "";
										// 1) Bill required
										if(input.Bill == null)
										{
											errors = errors + "\n• Bill is required.";
										}
										// 2) Quantity required and cannot be 0
										if(input.Quantity == null)
										{
											errors = errors + "\n• Quantity is required.";
										}
										else if(input.Quantity == 0)
										{
											errors = errors + "\n• Quantity cannot be 0.";
										}
										// 3) Rate required (0 allowed)
										if(input.Rate == null)
										{
											errors = errors + "\n• Rate is required.";
										}
										// 4) Line Total required (0 allowed)
										if(input.Line_Total == null)
										{
											errors = errors + "\n• Line Total is required.";
										}
										// 5) Group required
										if(input.Group == null)
										{
											errors = errors + "\n• Group is required.";
										}
										// 6) Stop early if basic errors already exist
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
										// 7) Recalculate current row line total safely
										current_line_total = round(ifnull(input.Quantity,0.0) * ifnull(input.Rate,0.0),2);
										input.Line_Total = current_line_total;
										// 8) Check parent Bill Total limit
										if(input.Bill != null)
										{
											billRec = Bill[ID == input.Bill.ID];
											if(billRec.ID != null)
											{
												bill_total_limit = round(ifnull(billRec.Bill_Total,0.0),2);
												total_lines = 0.0;
												existing_rows = Bill_Details[Bill == billRec.ID];
												for each  r in existing_rows
												{
													if(input.ID != null && r.ID == input.ID)
													{
														total_lines = total_lines + current_line_total;
													}
													else
													{
														total_lines = total_lines + round(ifnull(r.Line_Total,0.0),2);
													}
												}
												// If this is a new record, add current row because it is not yet in existing_rows
												if(input.ID == null)
												{
													total_lines = total_lines + current_line_total;
												}
												total_lines = round(total_lines,2);
												if(total_lines > bill_total_limit)
												{
													alert "Total Bill Details Line Total (" + total_lines + ") cannot be greater than Bill Total (" + bill_total_limit + ").";
													cancel submit;
												}
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete3 as "Finalize On Delete"
			{
				type =  form
				form = Sales_Voucher

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// SALES VOUCHER -> FINALIZE ON DELETE
										// Delete linked Invoice Details records
										// ===============================
										card_no = ifnull(input.Card_Number,"").trim();
										if(card_no != "")
										{
											// Delete sand invoice detail
											delete from Invoice_Details[Sales_Voucher == card_no && Item == "Sand Sales"];
											// Delete item invoice details
											for each  row in input.Item_Sales
											{
												line_no = ifnull(row.Line_Number,0);
												if(line_no > 0)
												{
													sales_voucher_line = card_no + " - " + line_no;
													delete from Invoice_Details[Sales_Voucher == sales_voucher_line];
												}
											}
										}
						)
					}
				}

			}
			Finalize13 as "Finalize"
			{
				type =  form
				form = Invoice_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// INVOICE DETAILS -> FINALIZE
										// ======================================
										// 1) Auto-fill Display Name Invoice
										if(input.Invoice != null)
										{
											input.Display_Name_Invoice = input.Invoice.Invoice_Number;
										}
										else
										{
											input.Display_Name_Invoice = "";
										}
										// 2) Auto-fill Group Display Name
										if(input.Group != null)
										{
											input.Display_Name_Group = ifnull(input.Group.Group_Number,"");
										}
										else
										{
											input.Display_Name_Group = "";
										}
										// 3) Recalculate parent Invoice totals
										if(input.Invoice != null)
										{
											invRec = Invoice[ID == input.Invoice.ID];
											if(invRec.ID != null)
											{
												sub_total = 0.0;
												inv_rows = Invoice_Details[Invoice == invRec.ID];
												for each  r in inv_rows
												{
													sub_total = sub_total + ifnull(r.Line_Total,0.0);
												}
												sub_total = round(sub_total,2);
												discount_amt = round(ifnull(invRec.Discount,0.0),2);
												tax_amt = round(ifnull(invRec.Tax_Amount,0.0),2);
												paid_amt = round(ifnull(invRec.Amount_Paid,0.0),2);
												grand_total = round(sub_total - discount_amt + tax_amt,2);
												if(grand_total < 0)
												{
													grand_total = 0.0;
												}
												balance_due = round(grand_total - paid_amt,2);
												if(balance_due < 0)
												{
													balance_due = 0.0;
												}
												invRec.Sub_Total=sub_total;
												invRec.Grand_Total=grand_total;
												invRec.Balance_Due=balance_due;
												// ❌ LOCKED: Invoice Status will NOT change
												// invRec.Status = if(grand_total > 0,"Invoiced","Draft");
												if(paid_amt <= 0)
												{
													invRec.Payment_Status="Not Paid";
												}
												else if(balance_due > 0)
												{
													invRec.Payment_Status="Partially Paid";
												}
												else
												{
													invRec.Payment_Status="Paid";
												}
											}
										}
										// 4) Update linked Sales Voucher -> Payment Status = Invoiced
										if(input.Sales_Voucher != null && input.Sales_Voucher != "")
										{
											svRec = Sales_Voucher[Card_Number == input.Sales_Voucher];
											if(svRec.ID != null)
											{
												svRec.Payment_Status="Invoiced";
											}
										}
										// 5) Rebuild Group Expense through Payment Management function
										if(input.Group != null && input.Invoice != null)
										{
											pay_date = zoho.currentdate;
											if(input.Invoice.Invoice_Date != null)
											{
												pay_date = input.Invoice.Invoice_Date;
											}
											total_receive = 0.0;
											all_rows = Invoice_Details[Group == input.Group];
											for each  row_rec in all_rows
											{
												if(row_rec.Invoice != null && row_rec.Invoice.Invoice_Date == pay_date)
												{
													total_receive = total_receive + round(ifnull(row_rec.Line_Total,0.0),2);
												}
											}
											total_receive = round(total_receive,2);
											payload = Map();
											payload.put("Group",input.Group);
											payload.put("Payment_Date",pay_date);
											payload.put("Source_Group","Invoice Income");
											payload.put("Total_Receive",total_receive);
											resp = payment_management.rebuildInvoiceIncomeGroupExpense(payload);
											if(resp != null && resp.get("ok") == true)
											{
												input.Last_Synced_Group_Amount = ifnull(input.Line_Total,0.0);
											}
											else
											{
												info resp;
											}
										}
										// ======================================
										// INVOICE DETAILS -> UPDATE METER READING STATUS
										// ======================================
										if(input.Source_Form == "Meter Reading - Employee Management" && input.Source_Record_ID != null)
										{
											mr = Meter_Reading[ID == input.Source_Record_ID];
											if(mr.ID != null)
											{
												mr.Status="Invoiced";
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete4 as "Finalize On Delete"
			{
				type =  form
				form = Invoice_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// INVOICE DETAILS -> FINALIZE ON DELETE
										// Reverse Group Expense sync
										// ======================================
										if(input.Group != null)
										{
											last_synced = round(ifnull(input.Last_Synced_Group_Amount,0.0),2);
											if(last_synced != 0)
											{
												pay_date = zoho.currentdate;
												if(input.Invoice != null)
												{
													inv_rec = Invoice[ID == input.Invoice];
													if(inv_rec.ID != null && inv_rec.Invoice_Date != null)
													{
														pay_date = inv_rec.Invoice_Date;
													}
												}
												payload = Map();
												payload.put("Group_ID",input.Group);
												payload.put("Amount_Delta",0 - last_synced);
												payload.put("Payment_Date",pay_date);
												payload.put("Source_Group","Invoice Income");
												resp = payment_management.createGroupExpenseFromInvoice(payload);
												info resp;
											}
										}
						)
					}
				}

			}
