					{
						custom deluge script
						(
											// ===== BACK END FIELDS (HIDE + DISABLE) =====
										hide Back_End;
										hide User_Name;
										hide User_Email;
										hide User_Role;
										hide Created_By_Name;
										hide Created_By_Email;
										hide Created_By_Time;
										hide Updated_By_Name;
										hide Updated_By_Email;
										hide Updated_By_Time;
										hide Display_Name_Asset;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// ===== DISABLE SYSTEM FIELDS =====
										disable Fuel_Voucher;
										disable Supplied_By;
										// ===== HIDE BY DEFAULT =====
										hide Fuel_Voucher;
										// ===== CREATE MODE =====
										if(input.ID == null)
										{
											hide Fuel_Voucher;
											hide Vendor;
											hide Store;
											hide Display_Name_Store;
											hide Item_Issuing_Details;
											hide Supplied_By;
											hide Rate;
											hide Status;
										}
										else
										{
											// EDIT MODE
											show Vendor;
											show Store;
										}
										// ===== CONTROL ITEM ISSUING =====
										if(input.Issued_By == "Fuel Tank")
										{
											show Item_Issuing_Details;
										}
										else
										{
											hide Item_Issuing_Details;
										}
						)
					}
				}

			}
			Full_Validation3 as "Full Validation"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										// =============================
										// 1) REQUIRED MAIN FIELDS
										// =============================
										if(input.Issued_By == null)
										{
											errors = errors + "\n• Please select Issued By.";
										}
										if(input.Asset == null)
										{
											errors = errors + "\n• Asset is required.";
										}
										if(input.Fuel_Issuing_Time == null)
										{
											errors = errors + "\n• Fuel Issuing Time is required.";
										}
										if(input.Odometer == null)
										{
											errors = errors + "\n• Odometer is required.";
										}
										else if(input.Odometer < 0)
										{
											errors = errors + "\n• Odometer cannot be negative.";
										}
										if(input.Quantity == null)
										{
											errors = errors + "\n• Quantity is required.";
										}
										else if(input.Quantity <= 0)
										{
											errors = errors + "\n• Quantity must be greater than 0.";
										}
										// =============================
										// 2) ODOMETER DATE RANGE VALIDATION
										// Ignore void mileage logs
										// =============================
										if(input.Asset != null && input.Fuel_Issuing_Time != null && input.Odometer != null)
										{
											prev_odo = null;
											next_odo = null;
											prev_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded < input.Fuel_Issuing_Time && Void_Mileage == false || Void_Mileage == null] sort by Date_Time_Recorded desc;
											for each  pl in prev_logs
											{
												prev_odo = ifnull(pl.Odometer_Reading,0.0);
												break;
											}
											next_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded > input.Fuel_Issuing_Time && Void_Mileage == false || Void_Mileage == null] sort by Date_Time_Recorded asc;
											for each  nx in next_logs
											{
												next_odo = ifnull(nx.Odometer_Reading,0.0);
												break;
											}
											if(prev_odo != null && input.Odometer < prev_odo)
											{
												errors = errors + "\n• Odometer cannot be less than the previous valid mileage log (" + prev_odo.toString() + ").";
											}
											if(next_odo != null && input.Odometer > next_odo)
											{
												errors = errors + "\n• Odometer cannot be greater than the next valid mileage log (" + next_odo.toString() + ").";
											}
										}
										// =============================
										// 3) CONDITIONAL RULES
										// =============================
										if(input.Issued_By == "Vendor")
										{
											if(input.Vendor == null)
											{
												errors = errors + "\n• Please select a Vendor.";
											}
											if(input.Store != null)
											{
												errors = errors + "\n• Store must be empty when Issued By is Vendor.";
											}
											if(input.Item_Issuing_Details != null)
											{
												errors = errors + "\n• Item Issuing Details must be empty when Issued By is Vendor.";
											}
										}
										else if(input.Issued_By == "Fuel Tank")
										{
											if(input.Store == null)
											{
												errors = errors + "\n• Please select a Store.";
											}
											if(input.Item_Issuing_Details == null)
											{
												errors = errors + "\n• Please select Item Issuing Details.";
											}
											if(input.Vendor != null)
											{
												errors = errors + "\n• Vendor must be empty when Issued By is Fuel Tank.";
											}
										}
										// =============================
										// 4) FINAL GATE
										// =============================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize_On_Delete1 as "Finalize On Delete"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ====================================================
										// 1) Delete linked Bill Details
										// ====================================================
										if(input.Fuel_Voucher != null && input.Fuel_Voucher != "")
										{
											bill_rows = Bill_Details[Source == "Fuel Receiving Voucher" && Reference == input.Fuel_Voucher];
											for each  bd in bill_rows
											{
												delete from Bill_Details[ID == bd.ID];
											}
										}
										// ====================================================
										// 2) Delete linked Asset Mileage Log
										// ====================================================
										source_form_text = "Fuel Receiving Voucher";
										source_record_id_text = input.ID.toString();
										mileage_rows = Asset_Mileage_Log[Odometer_Source_Form == source_form_text && Source_Record_ID == source_record_id_text];
										for each  ml in mileage_rows
										{
											delete from Asset_Mileage_Log[ID == ml.ID];
										}
										// ====================================================
										// 3) Recompute Asset -> Total Fuel Costs after delete
										// ====================================================
										if(input.Asset != null)
										{
											total_fuel_costs = 0.0;
											fuel_rows = Fuel_Receiving_Voucher[Asset == input.Asset];
											for each  fr in fuel_rows
											{
												row_total = round(ifnull(fr.Quantity,0.0) * ifnull(fr.Rate,0.0),2);
												total_fuel_costs = total_fuel_costs + row_total;
											}
											total_fuel_costs = round(total_fuel_costs,2);
											asset_rec = Asset_List[ID == input.Asset];
											if(asset_rec.ID != null)
											{
												asset_rec.Total_Fuel_Costs=total_fuel_costs;
												odo_val = ifnull(asset_rec.Odometer_Reading,0.0);
												if(odo_val > 0)
												{
													asset_rec.Fuel_Cost_Per_Odometer=round(total_fuel_costs / odo_val,2);
												}
												else
												{
													asset_rec.Fuel_Cost_Per_Odometer=0.0;
												}
											}
										}
										// ==============================================
										// 3) Recompute Asset costs after delete
										// ==============================================
										if(input.Asset != null)
										{
											asset_id = input.Asset.toLong();
											thisapp.asset.refresh_asset_costs(asset_id);
										}
						)
					}
				}

			}
