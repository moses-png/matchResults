		form Work_Order_Tasks
		{
			displayname = "Work Order Tasks"
			success message = "Service Task Work Report Added Successfully"
			Work_Order_Task_Details
			(
				type = section
				displayname = "Work Order Task Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Work_Order_Task_Number
			(
    			type = text
				displayname = "Work Order Task Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Asset
			(
				type = picklist	
				values  = Asset_List.ID
    			displayformat = [Asset_Name + " - " + Asset_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Asset
			(
    			type = text
				displayname = "Display Name Asset"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Odometer_Reading_Requested
			(
				type = decimal
				displayname = "Odometer Reading Requested"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Work_Order
			(
				type = picklist	
				displayname = "Work Order"
				values  = Work_Order[Display_Name_Asset == input.Display_Name_Asset && Status == "Pending" || Status == "In Progress"].ID
    			displayformat = [Work_Order_Number + " - " + Display_Name_Issue]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
