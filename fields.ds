			On_Cancel_Selected as "On Cancel Selected"
			{
				type =  form
				form = Stock_Production

				record event = on add or edit

				on user input of Cancel_Stock_Production
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_Stock_Production == true)
										{
											show Reason_Why_Cancelled;
											enable Reason_Why_Cancelled;
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = "";
											disable Reason_Why_Cancelled;
										}
						)
					}
				}

			}
			Finalize15 as "Finalize"
			{
				type =  form
				form = Stock_Production

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Time_Started == null)
										{
											input.Time_Started = zoho.currenttime;
										}
										if(input.Cancel_Stock_Production == true)
										{
											input.Production_Status = "Cancelled";
										}
										else
										{
											if(input.Production_Status == null || input.Production_Status == "")
											{
												input.Production_Status = "Open";
											}
										}
						)
					}
				}

			}
			Full_Validation21 as "Full Validation"
			{
				type =  form
				form = Stock_Production

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										// Site required
										if(input.Site == null)
										{
											errors = errors + "\n• Site is required.";
										}
										// Batch Details required
										if(isNull(input.Batch_Details) || input.Batch_Details.trim() == "")
										{
											errors = errors + "\n• Batch Details is required.";
										}
										// If Cancel Stock Production is true, Reason Why Cancelled is required
										if(input.Cancel_Stock_Production == true)
										{
											if(isNull(input.Reason_Why_Cancelled) || input.Reason_Why_Cancelled.trim() == "")
											{
												errors = errors + "\n• Reason Why Cancelled is required when Cancel is checked.";
											}
										}
										// Stop submission if there are errors
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			On_Batch_Number_Selected1 as "On Batch Number Selected"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on user input of Batch_Number
				{
					actions 
					{
						custom deluge script
						(
											if(input.Batch_Number != null)
										{
											batchNo = ifnull(input.Batch_Number.Batch_Number,"");
											autoText = "Stock Production";
											if(batchNo != "")
											{
												autoText = "Stock Production - " + batchNo;
											}
											input.Work_Done = autoText;
											productionSite = ifnull(input.Batch_Number.Display_Name_Site,"");
											currentSite = ifnull(input.Display_Name_Site,"");
											if(currentSite != "" && productionSite != "" && currentSite != productionSite)
											{
												alert "The selected Stock Production batch belongs to a different site.";
												input.Batch_Number = null;
												input.Work_Done = null;
											}
										}
						)
					}
				}

			}
			On_Item_Selected5 as "On Item Selected"
			{
				type =  form
				form = Stock_Bundling_Note

				record event = on add or edit

				on user input of Item
				{
					actions 
					{
						custom deluge script
						(
											if(input.Item != null)
										{
											itemName = ifnull(input.Item.Item_Name,"").trim();
											itemSKU = ifnull(input.Item.SKU,"").trim();
											if(itemName != "" && itemSKU != "")
											{
												input.Display_Name_Item = itemName + " - " + itemSKU;
											}
											else if(itemName != "")
											{
												input.Display_Name_Item = itemName;
											}
											else
											{
												input.Display_Name_Item = input.Item.toString();
											}
										}
										else
										{
											input.Display_Name_Item = "";
										}
						)
					}
				}

			}
			On_Voucher_Selected7 as "On Voucher Selected"
			{
				type =  form
				form = Stock_Bundling_Note

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Voucher != null)
										{
											input.Display_Name_Voucher = ifnull(input.Voucher.Voucher_Number,"");
										}
										else
										{
											input.Display_Name_Voucher = "";
										}
						)
					}
				}

			}
			On_Voucher_Selected6 as "On Voucher Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Voucher != null)
										{
											input.Display_Name_Voucher = input.Voucher.Voucher_Number;
											empName = ifnull(input.Voucher.Employee.Employee_Name,"").trim();
											empNo = ifnull(input.Voucher.Employee.Employee_Number,"").toString().trim();
											if(empName != "" && empNo != "")
											{
												input.Display_Name_Employee = empName + " - " + empNo;
											}
											else if(empName != "")
											{
												input.Display_Name_Employee = empName;
											}
											else
											{
												input.Display_Name_Employee = null;
											}
											input.Display_Name_Site = input.Voucher.Display_Name_Site;
											if(input.Voucher.Asset != null)
											{
												input.Display_Name_Asset = input.Voucher.Asset.Asset_Name + " - " + input.Voucher.Asset.Asset_ID;
											}
											else
											{
												input.Display_Name_Asset = null;
											}
											input.Number_Plate_Truck_Register = null;
											if(input.Display_Name_Asset != null && input.Display_Name_Asset.trim() != "")
											{
												assetDisplay = input.Display_Name_Asset.trim();
												plate = assetDisplay;
												if(assetDisplay.contains(" - "))
												{
													plate = assetDisplay.getPrefix(" -").trim();
												}
												truckRec = Truck_Register[Number_Plate == plate];
												if(truckRec.ID != null)
												{
													input.Number_Plate_Truck_Register = ifnull(truckRec.Number_Plate,"") + " - " + ifnull(truckRec.TSF_Number,"");
												}
											}
											// LINE NUMBER AUTO INCREMENT PER VOUCHER
											existing = Truck_Movement_Voucher[Voucher == input.Voucher];
											maxLine = 0;
											for each  rec in existing
											{
												if(input.ID != null && rec.ID == input.ID)
												{
													continue;
												}
												if(rec.Line_Number != null && rec.Line_Number > maxLine)
												{
													maxLine = rec.Line_Number;
												}
											}
											input.Line_Number = maxLine + 1;
										}
										else
										{
											input.Display_Name_Voucher = null;
											input.Display_Name_Employee = null;
											input.Display_Name_Site = null;
											input.Display_Name_Asset = null;
											input.Number_Plate_Truck_Register = null;
											input.Line_Number = null;
										}
						)
					}
				}

			}
			On_Site_Location_Selected as "On Site Location Selected"
			{
				type =  form
				form = Stock_Production

				record event = on add or edit

				on user input of Site_Location
				{
					actions 
					{
						custom deluge script
						(
											if(!isNull(input.Site_Location))
										{
											loc_rec = Management_Locations[ID == input.Site_Location];
											if(loc_rec.ID != null)
											{
												input.Display_Name_Site_Location = loc_rec.Location_Name;
											}
										}
										else
										{
											input.Display_Name_Site_Location = "";
										}
										// Build Batch Details
										mat = ifnull(input.Materials_Produced,"");
										site_from = "";
										if(input.Site != null)
										{
											site_from = ifnull(input.Site.Display_Name_Asset_Name,"");
										}
										loc_from = ifnull(input.Display_Name_Site_Location,"");
										input.Batch_Details = "Materials Produced is " + mat + " from " + site_from + " - " + loc_from;
						)
					}
				}

			}
			On_Materials_Produced as "On Materials Produced"
			{
				type =  form
				form = Stock_Production

				record event = on add or edit

				on user input of Materials_Produced
				{
					actions 
					{
						custom deluge script
						(
											// Build Batch Details
										mat = ifnull(input.Materials_Produced,"");
										site_from = "";
										if(input.Site != null)
										{
											site_from = ifnull(input.Site.Display_Name_Asset_Name,"");
										}
										loc_from = ifnull(input.Display_Name_Site_Location,"");
