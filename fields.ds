			}
			Finalize5 as "Finalize"
			{
				type =  form
				form = Transfer_Funds

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// TRANSFER FUNDS - ACCOUNT TRANSACTION LOGS
										// =====================================
										transfer_dt = input.Transfer_Date;
										if(transfer_dt == null)
										{
											transfer_dt = zoho.currenttime;
										}
										// =====================================
										// 1. TRANSFER OUT
										// =====================================
										txn = Map();
										txn.put("Transaction_Date",transfer_dt.toDate());
										txn.put("Transaction_Date_Time",transfer_dt);
										txn.put("Account",input.Account_From);
										txn.put("Display_Name_Account",ifnull(input.Display_Name_Account_From,""));
										txn.put("Transaction_Type","Credit");
										txn.put("Amount",ifnull(input.Amount_Transferred,0.0));
										txn.put("Reference_Type","Transfer Funds");
										txn.put("Reference_Number",ifnull(input.Transfer_Reference,""));
										txn.put("Application","Payment Management");
										txn.put("Source_Form","Transfer Funds");
										txn.put("Source_Record_ID",input.ID.toLong());
										txn.put("Notes",ifnull(input.Transfer_Description,""));
										txn_resp = thisapp.createOrUpdateAccountTransactionLog(txn);
										info txn_resp;
										// =====================================
										// 2. TRANSFER IN
										// =====================================
										txn2 = Map();
										txn2.put("Transaction_Date",transfer_dt.toDate());
										txn2.put("Transaction_Date_Time",transfer_dt);
										txn2.put("Account",input.Account_To);
										txn2.put("Display_Name_Account",ifnull(input.Display_Name_Account_To,""));
										txn2.put("Transaction_Type","Debit");
										txn2.put("Amount",ifnull(input.Amount_Transferred,0.0));
										txn2.put("Reference_Type","Transfer Funds");
										txn2.put("Reference_Number",ifnull(input.Receive_Reference,""));
										txn2.put("Application","Payment Management");
										txn2.put("Source_Form","Transfer Funds");
										txn2.put("Source_Record_ID",input.ID.toLong());
										txn2.put("Notes",ifnull(input.Receive_Description,""));
										txn_resp2 = thisapp.createOrUpdateAccountTransactionLog(txn2);
										info txn_resp2;
										// =====================================
										// 3. CHARGES
										// =====================================
										for each  charge_row in input.Charges
										{
											charge_amount = ifnull(charge_row.Amount,0.0);
											if(charge_amount > 0)
											{
												charge_txn = Map();
												charge_txn.put("Transaction_Date",transfer_dt.toDate());
												charge_txn.put("Transaction_Date_Time",transfer_dt);
												charge_txn.put("Account",input.Account_From);
												charge_txn.put("Display_Name_Account",ifnull(input.Display_Name_Account_From,""));
												charge_txn.put("Transaction_Type","Credit");
												charge_txn.put("Amount",charge_amount);
												charge_txn.put("Reference_Type","Charges");
												charge_txn.put("Reference_Number",ifnull(input.Transfer_Reference,""));
												charge_txn.put("Application","Payment Management");
												charge_txn.put("Source_Form","Transfer Funds");
												charge_txn.put("Source_Record_ID",charge_row.ID.toLong());
												charge_txn.put("Notes",ifnull(charge_row.Charge_Description,""));
												charge_resp = thisapp.createOrUpdateAccountTransactionLog(charge_txn);
												info charge_resp;
											}
										}
										// =====================================
										// 4. REFRESH ACCOUNTS
										// =====================================
										if(input.Account_From != null)
										{
											refresh_from = thisapp.refreshAccountTransactionLog(input.Account_From);
											info refresh_from;
										}
										if(input.Account_To != null)
										{
											refresh_to = thisapp.refreshAccountTransactionLog(input.Account_To);
											info refresh_to;
										}
						)
					}
				}

			}
			Set_Up_Form8 as "Set Up Form"
			{
				type =  form
				form = Account_Transaction_Log

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =========================
										// ACCOUNT DETAILS
										// =========================
										disable Transaction_Date;
										disable Account;
										disable Display_Name_Account;
										disable Transaction_Type;
										disable Reference_Type;
										disable Reference_Number;
										// =========================
										// ACCOUNT TOTALS
										// =========================
										disable Amount;
										disable Balance_Before;
										disable Balance_After;
										// =========================
										// INTEGRATION DETAILS
										// =========================
										disable Application;
										disable Source_Form;
										disable Source_Record_ID;
										disable Notes;
										// =========================
										// BACK END
										// =========================
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
						)
					}
				}

			}
			Finalize_On_Delete2 as "Finalize On Delete"
			{
				type =  form
				form = Account

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											payload = Map();
										payload.put("Application","Payment Management");
										payload.put("Source_Form","Account Opening Balance");
										payload.put("Source_Record_ID",input.ID);
										resp = thisapp.deleteAccountTransactionLog(payload);
										info resp;
						)
					}
				}

			}
			On_Email_Selected as "On Email Selected"
			{
				type =  form
				form = Account_User

				record event = on add or edit

				on user input of Email
				{
					actions 
					{
						custom deluge script
						(
											if(input.Email != null && input.Email.trim() != "")
										{
											// Convert to lowercase and trim
											email_value = input.Email.toLowerCase().trim();
											// Remove @gmail.com
											email_user = email_value.replaceAll("@gmail.com","");
											// Save Email User
											input.Email_User = email_user;
											// Default prefix
											prefix_value = email_user;
											// Check if last 2 characters are numbers
											if(email_user.length() >= 2)
											{
												last_two = email_user.right(2);
												// If numeric
												if(last_two.isNumber())
												{
													prefix_value = email_user.left(email_user.length() - 2);
												}
											}
											// Save Prefix
											input.Email_Prefix = prefix_value;
										}
										else
										{
											input.Email_User = "";
											input.Email_Prefix = "";
										}
						)
					}
				}

			}
