			Full_Validation25 as "Full Validation"
			{
				type =  form
				form = Document_Key

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// DOCUMENT KEY VALIDATION
										// =====================================================
										errors = List();
										voucher_type_txt = ifnull(input.Voucher_Type,"").trim();
										prefix_txt = ifnull(input.Prefix,"").trim().toUpperCase();
										// Normalize prefix
										input.Prefix = prefix_txt;
										// -----------------------------------------------------
										// 1) REQUIRED FIELDS
										// -----------------------------------------------------
										if(voucher_type_txt == "")
										{
											errors.add("• Voucher Type is required.");
										}
										if(prefix_txt == "")
										{
											errors.add("• Prefix is required.");
										}
										// -----------------------------------------------------
										// 2) PREFIX FORMAT
										// -----------------------------------------------------
										if(prefix_txt != "")
										{
											if(prefix_txt.length() < 2)
											{
												errors.add("• Prefix must contain at least 2 characters.");
											}
											if(prefix_txt.contains(" "))
											{
												errors.add("• Prefix cannot contain spaces.");
											}
										}
										// -----------------------------------------------------
										// 3) CHECK DUPLICATE VOUCHER TYPE + PREFIX
										// -----------------------------------------------------
										if(voucher_type_txt != "" && prefix_txt != "")
										{
											same_combination = Document_Key[Voucher_Type == voucher_type_txt && Prefix == prefix_txt && ID != input.ID];
											if(same_combination.ID != null)
											{
												errors.add("• This Voucher Type and Prefix already exists: " + voucher_type_txt + " - " + prefix_txt + ".");
											}
										}
										// -----------------------------------------------------
										// 4) CHECK WHETHER PREFIX IS USED ANYWHERE
										// -----------------------------------------------------
										if(prefix_txt != "")
										{
											prefix_used = Document_Key[Prefix == prefix_txt && ID != input.ID];
											if(prefix_used.ID != null)
											{
												existing_display = ifnull(prefix_used.Voucher_Type,"").trim() + " - " + ifnull(prefix_used.Prefix,"").trim();
												errors.add("• Prefix '" + prefix_txt + "' is already used by " + existing_display + ".");
											}
										}
										// -----------------------------------------------------
										// 5) STOP SUBMISSION
										// -----------------------------------------------------
										if(errors.size() > 0)
										{
											alert errors.toString("\n");
											cancel submit;
										}
						)
					}
				}

			}
		}






	}
