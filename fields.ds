				 map syncPartsConsumablesFromDragerWorkReport(map input)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("message","Unknown error.");
                 	info "===== syncPartsConsumablesFromDragerWorkReport START =====";
                 	info "INPUT: " + input.toString();
                 	// =====================================
                 	// 1) READ INPUTS
                 	// =====================================
                 	work_order_task_id = input.get("Work_Order_Task_ID");
                 	work_order_task_number = ifnull(input.get("Work_Order_Task_Number"),"");
                 	display_name_work_order_task_number = ifnull(input.get("Display_Name_Work_Order_Task_Number"),"");
                 	display_name_item_labour = ifnull(input.get("Display_Name_Item_Labour"),"Drager Labour");
                 	display_name_asset = ifnull(input.get("Display_Name_Asset"),"");
                 	odometer_start = ifnull(input.get("Odometer_Start"),0.0);
                 	odometer_end = ifnull(input.get("Odometer_End"),0.0);
                 	description = ifnull(input.get("Description"),"");
                 	qty = ifnull(input.get("Quantity"),0.0);
                 	qty_base = ifnull(input.get("Quantity_in_Base_Unit"),qty);
                 	unit_cost = ifnull(input.get("Unit_Cost"),0.0);
                 	rate_base = ifnull(input.get("Rate_in_Base_Unit"),0.0);
                 	uom_text = ifnull(input.get("Unit_Of_Measure_Text"),"");
                 	source_record_id = ifnull(input.get("Source_Record_ID"),"");
                 	source_form = ifnull(input.get("Source_Form"),"");
                 	line_total = round(qty * unit_cost,2);
                 	// =====================================
                 	// 2) VALIDATION
                 	// =====================================
                 	if(work_order_task_id == null)
                 	{
                 		response.put("message","Work Order Task ID is missing.");
                 		return response;
                 	}
                 	if(qty == null || qty <= 0)
                 	{
                 		response.put("message","Quantity must be greater than 0.");
                 		return response;
                 	}
                 	if(source_record_id == null || source_record_id.toString().trim() == "")
                 	{
                 		response.put("message","Source Record ID is missing.");
                 		return response;
                 	}
                 	if(source_form == null || source_form.trim() == "")
                 	{
                 		response.put("message","Source Form is missing.");
                 		return response;
                 	}
                 	// =====================================
                 	// 3) DUPLICATE CHECK
                 	// =====================================
                 	existingRow = Parts_Consumables[Source_Record_ID == source_record_id && Source_Form == source_form];
                 	if(existingRow.ID != null)
                 	{
                 		response.put("ok",true);
                 		response.put("message","Record already exists. Skipped duplicate.");
                 		response.put("record_id",existingRow.ID.toString());
                 		return response;
                 	}
                 	// =====================================
                 	// 4) LOAD WORK ORDER TASK
                 	// =====================================
                 	taskRec = Work_Order_Tasks[ID == work_order_task_id];
                 	if(taskRec.ID == null)
                 	{
                 		response.put("message","Work Order Task not found.");
                 		return response;
                 	}
                 	// =====================================
                 	// 5) LOAD LABOUR RECORD
                 	// =====================================
                 	labRec = Labour[Labour_Name == display_name_item_labour];
                 	if(labRec.ID == null)
                 	{
                 		response.put("message","Labour record not found: " + display_name_item_labour);
                 		return response;
                 	}
                 	// =====================================
                 	// 6) NEXT LINE NUMBER
                 	// =====================================
                 	nextLine = 1;
                 	rows = Parts_Consumables[Work_Order_Task_Number == taskRec.ID];
                 	for each  r in rows
                 	{
                 		line_no = ifnull(r.Line_Number,0);
                 		if(line_no >= nextLine)
                 		{
                 			nextLine = line_no + 1;
                 		}
                 	}
                 	// =====================================
                 	// 7) BUILD DESCRIPTION
                 	// =====================================
                 	desc = description;
                 	if(desc == null || desc.trim() == "")
                 	{
                 		desc = display_name_asset + " started " + odometer_start.toString() + " and Ended at " + odometer_end.toString();
                 	}
                 	// =====================================
                 	// 8) INSERT RECORD
                 	// =====================================
                 	insert into Parts_Consumables
                 	[
                 		Work_Order_Task_Number=taskRec.ID
                 		Display_Name_Work_Order_Task_Number=if(display_name_work_order_task_number != "",display_name_work_order_task_number,ifnull(taskRec.Work_Order_Task_Number,""))
                 		Line_Number=nextLine
                 		Labour=labRec.ID
                 		Display_Name_Item_Labour=if(display_name_item_labour != "",display_name_item_labour,ifnull(labRec.Labour_Name,""))
                 		Description=desc
                 		Quantity=qty
                 		Quantity_In_Base_Unit=qty_base
                 		Unit_of_Measure=uom_text
                 		Unit_Cost=unit_cost
                 		Rate_In_Base_Unit=rate_base
                 		Line_Total=line_total
                 		Item_Status="Requested"
                 		Source_Record_ID=source_record_id
                 		Source_Form=source_form
                 		Added_User=zoho.loginuser
                 	]
                 	// =====================================
                 	// 9) READ BACK INSERTED RECORD
                 	// =====================================
                 	newRow = Parts_Consumables[Source_Record_ID == source_record_id && Source_Form == source_form];
                 	if(newRow.ID != null)
                 	{
                 		response.put("ok",true);
                 		response.put("message","Parts & Consumables record created successfully.");
                 		response.put("record_id",newRow.ID.toString());
                 	}
                 	else
                 	{
                 		response.put("message","Insert may have succeeded, but record could not be reloaded.");
                 	}
                 	info "===== syncPartsConsumablesFromDragerWorkReport END =====";
                 	return response;
                 }
				 map syncPartsConsumablesFromStore(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	source_id = payload.get("Source_Record_ID");
                 	work_order_task_id = payload.get("Work_Order_Task_ID");
                 	if(source_id == null)
                 	{
                 		resp.put("message","Missing Source_Record_ID");
                 		return resp;
                 	}
                 	if(work_order_task_id == null)
                 	{
                 		resp.put("message","Missing Work_Order_Task_ID");
                 		return resp;
                 	}
                 	qty = ifnull(payload.get("Quantity"),0.0);
                 	unit_cost = ifnull(payload.get("Unit_Cost"),0.0);
                 	uom_text = ifnull(payload.get("Unit_Of_Measure_Text"),"");
                 	qty_base = ifnull(payload.get("Quantity_in_Base_Unit"),qty);
                 	rate_base = ifnull(payload.get("Rate_in_Base_Unit"),0.0);
                 	line_total = round(qty * unit_cost,2);
                 	// Safety: if selected UOM total is missing, use base UOM total
                 	if(line_total <= 0 && qty_base > 0 && rate_base > 0)
                 	{
                 		line_total = round(qty_base * rate_base,2);
                 	}
                 	pc_row = Parts_Consumables[Source_Record_ID == source_id];
                 	if(pc_row.ID != null)
                 	{
                 		pc_row.Work_Order_Task_Number=work_order_task_id;
                 		pc_row.Display_Name_Work_Order_Task_Number=ifnull(payload.get("Display_Name_Work_Order_Task_Number"),"");
                 		pc_row.Line_Number=payload.get("Line_Number");
                 		pc_row.Item=payload.get("Item");
                 		pc_row.Display_Name_Item_Labour=ifnull(payload.get("Display_Name_Item_Labour"),"");
                 		pc_row.Quantity=qty;
                 		pc_row.Quantity_In_Base_Unit=qty_base;
                 		pc_row.Unit_of_Measure=uom_text;
                 		pc_row.Unit_Cost=unit_cost;
                 		pc_row.Rate_In_Base_Unit=rate_base;
                 		pc_row.Line_Total=line_total;
                 		pc_row.Item_Issuing=payload.get("Item_Issuing_ID");
                 		pc_row.Item_Status=payload.get("Item_Status");
                 		pc_row.Source_Record_ID=source_id;
                 		pc_row.Source_Form=payload.get("Source_Form");
                 		resp.put("ok",true);
                 		resp.put("action","updated");
                 		resp.put("id",pc_row.ID);
                 		return resp;
                 	}
                 	new_pc = insert into Parts_Consumables
                 	[
                 		Work_Order_Task_Number=work_order_task_id
                 		Display_Name_Work_Order_Task_Number=ifnull(payload.get("Display_Name_Work_Order_Task_Number"),"")
                 		Line_Number=payload.get("Line_Number")
                 		Item=payload.get("Item")
                 		Display_Name_Item_Labour=ifnull(payload.get("Display_Name_Item_Labour"),"")
                 		Quantity=qty
                 		Quantity_In_Base_Unit=qty_base
                 		Unit_of_Measure=uom_text
                 		Unit_Cost=unit_cost
                 		Rate_In_Base_Unit=rate_base
                 		Line_Total=line_total
                 		Item_Issuing=payload.get("Item_Issuing_ID")
                 		Item_Status=payload.get("Item_Status")
                 		Source_Record_ID=source_id
                 		Source_Form=payload.get("Source_Form")
                 		Added_User=zoho.loginuser
                 	];
                 	resp.put("ok",true);
                 	resp.put("action","created");
                 	resp.put("id",new_pc);
                 	return resp;
                 }
				 map syncPartsConsumablesFromTractorWorkReport(map input)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("message","Unknown error.");
                 	info "===== syncPartsConsumablesFromTractorWorkReport START =====";
                 	info "INPUT: " + input.toString();
                 	// =====================================
                 	// 1) READ INPUTS
                 	// =====================================
                 	work_order_task_id = input.get("Work_Order_Task_ID");
                 	work_order_task_number = ifnull(input.get("Work_Order_Task_Number"),"");
                 	display_name_work_order_task_number = ifnull(input.get("Display_Name_Work_Order_Task_Number"),"");
                 	display_name_item_labour = ifnull(input.get("Display_Name_Item_Labour"),"Machine Hire");
                 	display_name_asset = ifnull(input.get("Display_Name_Asset"),"");
                 	odometer_start = ifnull(input.get("Odometer_Start"),0.0);
                 	odometer_end = ifnull(input.get("Odometer_End"),0.0);
                 	description = ifnull(input.get("Description"),"");
                 	qty = ifnull(input.get("Quantity"),0.0);
                 	source_record_id = ifnull(input.get("Source_Record_ID"),"");
                 	source_form = ifnull(input.get("Source_Form"),"");
                 	info "work_order_task_id: " + work_order_task_id;
                 	info "work_order_task_number: " + work_order_task_number;
                 	info "display_name_work_order_task_number: " + display_name_work_order_task_number;
                 	info "display_name_item_labour: " + display_name_item_labour;
                 	info "display_name_asset: " + display_name_asset;
                 	info "odometer_start: " + odometer_start;
                 	info "odometer_end: " + odometer_end;
                 	info "description: " + description;
                 	info "qty: " + qty;
                 	info "source_record_id: " + source_record_id;
                 	info "source_form: " + source_form;
                 	// =====================================
                 	// 2) VALIDATION
                 	// =====================================
                 	if(work_order_task_id == null)
                 	{
                 		response.put("message","Work Order Task ID is missing.");
                 		info response.toString();
                 		return response;
                 	}
                 	if(qty == null || qty <= 0)
                 	{
                 		response.put("message","Quantity must be greater than 0.");
                 		info response.toString();
                 		return response;
                 	}
                 	if(source_record_id == null || source_record_id.toString().trim() == "")
                 	{
                 		response.put("message","Source Record ID is missing.");
                 		info response.toString();
                 		return response;
                 	}
                 	if(source_form == null || source_form.trim() == "")
                 	{
                 		response.put("message","Source Form is missing.");
                 		info response.toString();
                 		return response;
                 	}
                 	// =====================================
                 	// 3) DUPLICATE CHECK
                 	// =====================================
                 	existingRow = Parts_Consumables[Source_Record_ID == source_record_id && Source_Form == source_form];
                 	if(existingRow.ID != null)
                 	{
                 		response.put("ok",true);
                 		response.put("message","Record already exists. Skipped duplicate.");
                 		response.put("record_id",existingRow.ID.toString());
                 		info "Duplicate found. Existing ID: " + existingRow.ID;
                 		info "===== syncPartsConsumablesFromTractorWorkReport END =====";
                 		return response;
                 	}
                 	// =====================================
                 	// 4) LOAD WORK ORDER TASK
                 	// =====================================
                 	taskRec = Work_Order_Tasks[ID == work_order_task_id];
                 	if(taskRec.ID == null)
                 	{
                 		response.put("message","Work Order Task not found.");
                 		info response.toString();
                 		return response;
                 	}
                 	info "Task found: " + ifnull(taskRec.Work_Order_Task_Number,"");
                 	// =====================================
                 	// 5) LOAD LABOUR RECORD
                 	// =====================================
                 	labRec = Labour[Labour_Name == display_name_item_labour];
                 	if(labRec.ID == null)
                 	{
                 		response.put("message","Labour record not found: " + display_name_item_labour);
                 		info response.toString();
                 		return response;
                 	}
                 	info "Labour found: " + labRec.ID;
                 	// =====================================
                 	// 6) NEXT LINE NUMBER
                 	// =====================================
                 	nextLine = 1;
                 	rows = Parts_Consumables[Work_Order_Task_Number == taskRec.ID];
                 	for each  r in rows
                 	{
                 		line_no = ifnull(r.Line_Number,0);
                 		if(line_no >= nextLine)
                 		{
                 			nextLine = line_no + 1;
                 		}
                 	}
                 	info "Next Line Number: " + nextLine;
                 	// =====================================
                 	// 7) BUILD DESCRIPTION
                 	// =====================================
                 	desc = description;
                 	if(desc == null || desc.trim() == "")
                 	{
                 		desc = display_name_asset + " started " + odometer_start.toString() + " and Ended at " + odometer_end.toString();
                 	}
                 	info "Description: " + desc;
                 	// =====================================
                 	// 8) INSERT RECORD
                 	// =====================================
                 	insert into Parts_Consumables
                 	[
                 		Work_Order_Task_Number=taskRec.ID
                 		Display_Name_Work_Order_Task_Number=if(display_name_work_order_task_number != "",display_name_work_order_task_number,ifnull(taskRec.Work_Order_Task_Number,""))
                 		Line_Number=nextLine
                 		Labour=labRec.ID
                 		Display_Name_Item_Labour=if(display_name_item_labour != "",display_name_item_labour,ifnull(labRec.Labour_Name,""))
                 		Description=desc
                 		Quantity=qty
                 		Item_Status="Requested"
                 		Source_Record_ID=source_record_id
                 		Source_Form=source_form
                 		Added_User=zoho.loginuser
                 	]
                 	info "Insert completed.";
                 	// =====================================
                 	// 9) READ BACK INSERTED RECORD
                 	// =====================================
                 	newRow = Parts_Consumables[Source_Record_ID == source_record_id && Source_Form == source_form];
                 	if(newRow.ID != null)
                 	{
                 		response.put("ok",true);
                 		response.put("message","Parts & Consumables record created successfully.");
                 		response.put("record_id",newRow.ID.toString());
                 	}
                 	else
                 	{
                 		response.put("message","Insert may have succeeded, but record could not be reloaded.");
                 	}
                 	info "Response: " + response.toString();
                 	info "===== syncPartsConsumablesFromTractorWorkReport END =====";
                 	return response;
                 }
				 map syncPartsConsumablesFromTruckMovementVoucher(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","Started.");
                 	workTaskID = payload.get("Work_Order_Task_ID");
                 	sourceID = payload.get("Source_Record_ID");
                 	sourceForm = payload.get("Source_Form");
                 	workTaskNumber = ifnull(payload.get("Work_Order_Task_Number"),"");
                 	displayWorkTask = ifnull(payload.get("Display_Name_Work_Order_Task_Number"),workTaskNumber);
                 	labourRec = Labour[Labour_Name == "Machine Hire"];
                 	if(labourRec.ID == null)
                 	{
                 		resp.put("message","Labour record 'Machine Hire' was not found.");
                 		return resp;
                 	}
                 	descriptionVal = ifnull(payload.get("Description"),"Truck Movement Voucher");
                 	qty = ifnull(payload.get("Quantity"),0.0);
                 	unitCost = ifnull(payload.get("Unit_Cost"),0.0);
                 	lineTotal = ifnull(payload.get("Line_Total"),qty * unitCost);
                 	if(workTaskID == null)
                 	{
                 		resp.put("message","Missing Work Order Task ID.");
                 		return resp;
                 	}
                 	if(sourceID == null || sourceID == "")
                 	{
                 		resp.put("message","Missing Source Record ID.");
                 		return resp;
                 	}
                 	if(sourceForm == null || sourceForm == "")
                 	{
                 		resp.put("message","Missing Source Form.");
                 		return resp;
                 	}
                 	existing = Parts_Consumables[Source_Form == sourceForm && Source_Record_ID == sourceID];
                 	if(existing.count() > 0)
                 	{
                 		for each  pc in existing
                 		{
                 			pc.Work_Order_Task_Number=workTaskID;
                 			pc.Display_Name_Work_Order_Task_Number=displayWorkTask;
                 			pc.Labour=labourRec.ID;
                 			pc.Display_Name_Item_Labour="Machine Hire";
                 			pc.Description=descriptionVal;
                 			pc.Quantity=qty;
                 			pc.Unit_of_Measure="km";
                 			pc.Unit_Cost=unitCost;
                 			pc.Line_Total=lineTotal;
                 			pc.Item_Status="Requested";
                 			pc.Source_Form=sourceForm;
                 			pc.Source_Record_ID=sourceID;
                 		}
                 		resp.put("ok",true);
                 		resp.put("message","Parts & Consumables updated.");
                 		return resp;
                 	}
                 	maxLine = 0;
                 	lines = Parts_Consumables[Work_Order_Task_Number == workTaskID];
                 	for each  line in lines
                 	{
                 		if(line.Line_Number != null && line.Line_Number > maxLine)
                 		{
                 			maxLine = line.Line_Number;
                 		}
                 	}
                 	nextLine = maxLine + 1;
                 	insert into Parts_Consumables
                 	[
                 		Work_Order_Task_Number=workTaskID
                 		Display_Name_Work_Order_Task_Number=displayWorkTask
                 		Line_Number=nextLine
                 		Labour=labourRec.ID
                 		Display_Name_Item_Labour="Machine Hire"
                 		Description=descriptionVal
                 		Quantity=qty
                 		Unit_of_Measure="km"
                 		Unit_Cost=unitCost
                 		Line_Total=lineTotal
                 		Item_Status="Requested"
                 		Source_Form=sourceForm
                 		Source_Record_ID=sourceID
                 		Added_User=zoho.loginuser
                 	]
                 	resp.put("ok",true);
                 	resp.put("message","Parts & Consumables created.");
                 	resp.put("line_number",nextLine);
                 	return resp;
                 }
				 map updateAssetCostSummaryFromCleanSand(int asset_id, decimal labour_total, decimal parts_total)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	if(asset_id == null)
                 	{
                 		resp.put("message","Asset is required.");
                 		return resp;
                 	}
                 	asset_rec = Asset_List[ID == asset_id];
                 	if(asset_rec.ID == null)
                 	{
                 		resp.put("message","Asset not found.");
                 		return resp;
                 	}
                 	old_service = round(ifnull(asset_rec.Total_Service_Costs,0.0),2);
                 	old_fuel = round(ifnull(asset_rec.Total_Fuel_Costs,0.0),2);
                 	add_labour = round(ifnull(labour_total,0.0),2);
                 	add_parts = round(ifnull(parts_total,0.0),2);
                 	add_service = round(add_labour + add_parts,2);
                 	new_service = round(old_service + add_service,2);
                 	new_total_costs = round(new_service + old_fuel,2);
                 	odo = ifnull(asset_rec.Odometer_Reading,0.0);
                 	asset_rec.Total_Service_Costs=new_service;
                 	asset_rec.Total_Costs=new_total_costs;
                 	if(odo > 0)
                 	{
                 		asset_rec.Service_Cost_Per_Odometer=round(new_service / odo,2);
                 		asset_rec.Fuel_Cost_Per_Odometer=round(old_fuel / odo,2);
                 		asset_rec.Cost_Per_Odometer=round(new_total_costs / odo,2);
                 	}
                 	else
                 	{
                 		asset_rec.Service_Cost_Per_Odometer=0.0;
                 		asset_rec.Fuel_Cost_Per_Odometer=0.0;
                 		asset_rec.Cost_Per_Odometer=0.0;
                 	}
                 	resp.put("ok",true);
                 	resp.put("message","Asset service cost summary added and recalculated.");
                 	resp.put("Added_Labour_As_Service",add_labour);
                 	resp.put("Added_Parts_As_Service",add_parts);
                 	resp.put("Added_Service_Cost",add_service);
                 	resp.put("New_Total_Service_Costs",new_service);
                 	resp.put("Existing_Total_Fuel_Costs",old_fuel);
                 	resp.put("New_Total_Costs",new_total_costs);
                 	return resp;
                 }
