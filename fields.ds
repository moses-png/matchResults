                 		delete from Asset_Mileage_Log[ID == l.ID];
                 	}
                 	for each  asset_id in asset_ids
                 	{
                 		prev_odo = 0.0;
                 		all_logs = Asset_Mileage_Log[Asset == asset_id] sort by Date_Time_Recorded asc;
                 		for each  ml in all_logs
                 		{
                 			if(ml.Void_Mileage == true)
