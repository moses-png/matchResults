			On_Voucher_Selected1 as "On Voucher Selected"
			{
				type =  form
				form = Gate_Pass

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											// Visitors Register → On Voucher Selected
										if(input.Voucher != null)
										{
											input.Display_Name_Voucher = input.Voucher.Voucher_Number;
										}
										else
										{
											input.Display_Name_Voucher = null;
										}
						)
					}
				}

			}
			Finalize3 as "Finalize"
			{
				type =  form
				form = Gate_Pass

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											is_create = false;
										if(input.Added_Time != null && input.Modified_Time != null)
										{
											if(input.Added_Time.toLong() == input.Modified_Time.toLong())
											{
												is_create = true;
											}
										}
										if(is_create)
										{
											// 1) Gate Pass Date (REPLACE Gate_Pass_Date with your real Date field link name)
											if(input.Gate_Pass_Date == null)
											{
												input.Gate_Pass_Date = zoho.currentdate;
											}
											gp_date = input.Gate_Pass_Date;
											// 2) Site key (stored as Display_Name_Site)
											site_key = ifnull(input.Display_Name_Site,"").trim();
											// 3) Count existing gate passes for same date + same site
											existing_count = 0;
											if(site_key != "")
											{
												existing_count = Gate_Pass[Gate_Pass_Date == gp_date && Display_Name_Site == site_key && ID != input.ID].count();
											}
											else
											{
												existing_count = Gate_Pass[Gate_Pass_Date == gp_date && ID != input.ID].count();
											}
											new_line_no = existing_count + 1;
											// 4) Save into the record
											rec = Gate_Pass[ID == input.ID];
											if(rec != null)
											{
												rec.Gate_Pass_Date=gp_date;
												rec.Line_Number=new_line_no;
											}
										}
						)
					}
				}

			}
			Set_up_Form7 as "Set up Form"
			{
				type =  form
				form = Gate_Pass

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//DISABLE FIELDS
										disable Display_Name_Voucher;
										disable Gate_Pass_Status;
										disable Line_Number;
										disable Display_Name_Site;
										disable Gate_Pass_Date;
										//BACK END
										disable User_Email;
										disable User_Name;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										//HIDE FIELDS
										hide Back_End;
										hide Display_Name_Voucher;
										hide Line_Number;
										hide Display_Name_Site;
										hide Gate_Pass_Date;
										// Logged-in user info
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										if(ifnull(input.User_Email,"").toLowerCase().startsWith("phmaa001"))
										{
											input.Display_Name_Site = "Gomba Site - ARA075";
										}
										if(ifnull(input.User_Email,"").toLowerCase().startsWith("phmae001"))
										{
											input.Display_Name_Site = "China Site - ARA073";
										}
										if(ifnull(input.User_Email,"").toLowerCase().startsWith("phmaf001"))
										{
											input.Display_Name_Site = "Seeta Site - ARA068";
										}
						)
					}
				}

			}
			On_Reason_for_Visit_Selec as "On Reason for Visit Selected"
			{
				type =  form
				form = Gate_Pass

				record event = on add or edit

				on user input of Reason_for_Visit
				{
					actions 
					{
						custom deluge script
						(
											if(input.Reason_for_Visit == "Boss Visit")
										{
											// Hide fields not needed for boss visits
											hide Person_to_See;
											hide Details_of_Visit;
											// Optional: clear values to avoid dirty data
											input.Person_to_See = null;
											input.Details_of_Visit = null;
										}
										else if(input.Reason_for_Visit == "Other Visit")
										{
											// Show fields for other visits
											show Person_to_See;
											show Details_of_Visit;
										}
										else
										{
											// Safety fallback (nothing selected yet)
											hide Person_to_See;
											hide Details_of_Visit;
										}
						)
					}
				}

			}
			Full_Validation1 as "Full Validation"
			{
				type =  form
				form = Gate_Pass

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										// -------------------------------------------------
										// REQUIRED: Voucher
										// -------------------------------------------------
										if(input.Voucher == null)
										{
											errors = errors + "\n• Voucher is required.";
										}
										// -------------------------------------------------
										// REQUIRED: Reason for Visit
										// -------------------------------------------------
										if(input.Reason_for_Visit == null || input.Reason_for_Visit.trim() == "")
										{
											errors = errors + "\n• Reason for Visit is required.";
										}
										// -------------------------------------------------
										// CONDITIONAL: Other Visit requires details
										// -------------------------------------------------
										if(input.Reason_for_Visit == "Other Visit")
										{
											if(input.Person_to_See == null || input.Person_to_See.trim() == "")
											{
												errors = errors + "\n• Person to See is required for Other Visit.";
											}
											if(input.Details_of_Visit == null || input.Details_of_Visit.trim() == "")
											{
												errors = errors + "\n• Details of Visit are required for Other Visit.";
											}
										}
										// -------------------------------------------------
										// FINAL GATE
										// -------------------------------------------------
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			On_Entry_By_Selected1 as "On Entry By Selected"
			{
				type =  form
				form = Visitors_Register

				record event = on add or edit

				on user input of Entry_By
				{
					actions 
					{
						custom deluge script
						(
											if(input.Entry_By == "Gate Pass")
										{
											// Show Gate Pass, hide Card
											show Gate_Pass;
											hide Card;
											hide Number_Plate;
											// Clear Card
											input.Card = null;
											input.Number_Plate = null;
											// Auto-fill Reference from Gate Pass
											if(input.Gate_Pass != null)
											{
												// Format: Date - Line Number
												gp_date = input.Gate_Pass.Gate_Pass_Date.toString("yyyy-MM-dd");
												gp_line = input.Gate_Pass.Line_Number.toString();
												input.Reference = gp_date + " - " + gp_line;
											}
											else
											{
												input.Reference = null;
											}
										}
										else if(input.Entry_By == "Card")
										{
											// Show Card, hide Gate Pass
											show Card;
											show Number_Plate;
											hide Gate_Pass;
											// Clear Gate Pass
											input.Gate_Pass = null;
											// Auto-fill Reference from Card
											if(input.Card != null)
											{
												input.Reference = input.Card.Card_Number;
											}
											else
											{
												input.Reference = null;
											}
										}
										else
										{
											// Safety fallback
											hide Gate_Pass;
											hide Card;
											hide Number_Plate;
											input.Number_Plate = null;
											input.Gate_Pass = null;
											input.Card = null;
											input.Reference = null;
										}
						)
					}
				}

			}
			On_Card_Selected as "On Card Selected"
			{
				type =  form
				form = Visitors_Register

				record event = on add or edit

				on user input of Card
				{
					actions 
					{
						custom deluge script
						(
