			Set_Up_Form_On_Create as "Set Up Form On Create"
			{
				type =  form
				form = Voucher

				record event = on add
					status = inactive

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// VOUCHER — SET UP FORM ON CREATE
										// Record Event: Created
										// Form Event: Load of the form
										// =====================================================
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
										if(input.Voucher_Status == null)
										{
											input.Voucher_Status = "Issued";
										}
										show Document_Type;
										show Physical_Voucher_Type;
										show Digital_Voucher_Type;
										show Employee;
										show Voucher_Number;
										enable Document_Type;
										enable Physical_Voucher_Type;
										enable Digital_Voucher_Type;
										enable Employee;
										enable Issued_By;
										enable Voucher_Number;
										enable Item;
										enable Quantity_To_Be_Created;
										// enable Date_Time_In;
						)
					}
				}

			}
			Set_Up_Form_On_Edit as "Set Up Form  On Edit"
			{
				type =  form
				form = Voucher

				record event = on edit
					status = inactive

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// VOUCHER — SET UP FORM ON EDIT
										// Record Event: Edited
										// Form Event: Load of the form
										// =====================================================
										st = ifnull(input.Voucher_Status,"Issued");
										// ON EDIT + Status = ISSUED
										if(st == "Issued")
										{
											show Issued_By;
											show Site;
											show Voucher_Return;
											show Received_By;
											enable Received_By;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											if(input.Voucher_Type == "Stock Receiving Note" || input.Voucher_Type == "Stock Bundling Note")
											{
												show Voucher_Header;
												show Asset;
												show Item;
												show Quantity_To_Be_Created;
												show Employee_Receiving_Details;
												enable Asset;
												enable Item;
												enable Quantity_To_Be_Created;
											}
											if(input.Voucher_Type == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Display_Name_Issued_By;
												hide Received_By;
												hide Display_Name_Received_By;
												show Voucher_Return;
												show Date_Time_Out;
												show Hours_Worked;
												show Shift;
												enable Shift;
											}
										}
										// ON EDIT + Status = CLOSED
										else if(st == "Closed")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											if(input.Voucher_Type == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Display_Name_Issued_By;
												hide Received_By;
												hide Display_Name_Received_By;
												show Manager_Section;
												show Manager_Time;
												show Cancel_Voucher;
												show Case_Number;
												show Employee_Taking_To_Head_Office;
												show How_to_Take_to_Head_Office;
												show Time_Sent_to_Head_Office;
												enable Case_Number;
												enable Employee_Taking_To_Head_Office;
												enable How_to_Take_to_Head_Office;
												enable Cancel_Voucher;
												if(input.Cancel_Voucher == true)
												{
													show Cancellation_Reason;
													enable Cancellation_Reason;
												}
											}
										}
										// ON EDIT + Status = RETURNED
										else if(st == "Returned")
										{
											show Issued_By;
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											if(input.Voucher_Type == "Supervisor Voucher")
											{
												hide Received_By;
												hide Display_Name_Received_By;
											}
											if(input.Voucher_Type == "Stock Receiving Note" || input.Voucher_Type == "Stock Bundling Note")
											{
												show Voucher_Header;
												show Asset;
												show Item;
												show Quantity_To_Be_Created;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												show Quantity_Created;
												disable Asset;
												disable Item;
												disable Quantity_To_Be_Created;
											}
											show Manager_Section;
											show Cancel_Voucher;
											enable Cancel_Voucher;
										}
										// ON EDIT + Status = HEAD OFFICE
										else if(st == "Head Office")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Manager_Section;
											show Cancel_Voucher;
											show Head_Office;
											show Seen;
											enable Seen;
										}
										// ON EDIT + Status = HUMAN RESOURCE
										else if(st == "Human Resource")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Manager_Section;
											show Cancel_Voucher;
											enable Cancel_Voucher;
											show Human_Resource;
											show Hr_Time_Checked;
										}
										// ON EDIT + Status = AUDITED
										else if(st == "Audited")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											enable Voucher_Status;
											show Voucher_Footer;
											show Voucher_Cost;
											show End_Time;
											show Odometer_End;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											show Head_Office;
											show Seen;
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
										}
										// ON EDIT + Status = CLEARED
										else if(st == "Cleared")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Shift_Voucher_Summary;
											show Opening_Vouchers;
											show Vouchers_Issued;
											show Vouchers_Returned;
											show Outstanding_Vouchers;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											show Head_Office;
											show Seen;
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
										}
										// =====================================
										// NOT CREATED / NOTES CONTROL
										// Only edit + Issued for Stock Receiving Note / Stock Bundling Note
										// =====================================
										if(input.Voucher_Type == "Stock Receiving Note" || input.Voucher_Type == "Stock Bundling Note" && st == "Issued")
										{
											show Notes;
											show Not_Created;
											enable Not_Created;
											if(input.Not_Created == true)
											{
												show Reason_Why_Not_Created;
												enable Reason_Why_Not_Created;
											}
											else
											{
												hide Reason_Why_Not_Created;
												disable Reason_Why_Not_Created;
											}
										}
										else
										{
											hide Notes;
											hide Not_Created;
											hide Reason_Why_Not_Created;
											disable Not_Created;
											disable Reason_Why_Not_Created;
										}
										// =====================================
										// BACK END ON EDIT
										// =====================================
										show Back_End;
										show User_Name;
										show User_Email;
										show User_Role;
										show Created_By_Name;
										show Created_By_Email;
										show Created_By_Time;
										show Updated_By_Name;
										show Updated_By_Email;
										show Updated_By_Time;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// =====================================
										// FORCE SHOW EXISTING IMPORTED DETAILS
										// =====================================
										if(input.Employee_Issuing_Details.count() > 0)
										{
											show Employee_Issuing_Details;
										}
										if(input.Item_Issuing_Details.count() > 0)
										{
											show Item_Issuing_Details;
										}
										if(input.Stock_Receiving_Details.count() > 0)
										{
											show Stock_Receiving_Details;
										}
										if(input.Fuel_Receiving_Details.count() > 0)
										{
											show Fuel_Receiving_Details;
										}
						)
					}
				}

			}
			Set_Up_Form_DIsable_Field as "Set Up Form - DIsable Fields"
			{
				type =  form
				form = Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------
										// 3) MODE + STATUS
										// ------------------------------
										is_create = input.ID == null;
										st = ifnull(input.Voucher_Status,"Issued");
										// =====================================================
										// NOTES CONTROL - DEFAULT HIDE
										// =====================================================
										hide Notes;
										hide Not_Created;
										hide Reason_Why_Not_Created;
										disable Reason_Why_Not_Created;
										// =====================================================
										// DEFAULT STATUS ON CREATE
										// =====================================================
										if(is_create && input.Voucher_Status == null)
										{
											input.Voucher_Status = "Issued";
											st = "Issued";
										}
										// =====================================================
										// ON CREATE
										// =====================================================
										if(is_create)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											enable Issued_By;
											enable Document_Type;
											enable Voucher_Number;
											enable Employee;
											enable Item;
											enable Quantity_To_Be_Created;
										}
										// =====================================================
										// ON EDIT + Status = ISSUED
										// =====================================================
										else if(!is_create && st == "Issued")
										{
											show Issued_By;
											show Site;
											show Voucher_Return;
											show Received_By;
											enable Received_By;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											if(input.Voucher_Type == "Daily Cleaners Report")
											{
												show Voucher_Header;
												show Management_Location;
												enable Management_Location;
												show Special_Tasks_Done;
												enable Special_Tasks_Done.Special_Task;
											}
											if(input.Voucher_Type == "Item Issuing Form")
											{
												show Asset;
												show Item_Issuing_Details;
											}
											if(input.Voucher_Type == "Kitchen Voucher")
											{
												show Kitchen_Employee_Details;
												enable Kitchen_Employee_Details.Employee;
											}
											if(input.Voucher_Type == "Occurency Report")
											{
												show Voucher_Header;
												show Management_Location;
												enable Management_Location;
												show Incident_Details;
												enable Incident_Details.Time;
												enable Incident_Details.Incident_Type;
												enable Incident_Details.Incident;
											}
											if(input.Voucher_Type == "Stock Receiving Note" || input.Voucher_Type == "Stock Bundling Note")
											{
												show Voucher_Header;
												//show Asset;
												//show Item;
												//show Quantity_To_Be_Created;
												show Employee_Receiving_Details;
												//enable Asset;
												//enable Item;
												//enable Quantity_To_Be_Created;
												show Stock_Bundling_Note;
												show Stock_Bundling_Note.Asset;
												show Stock_Bundling_Note.Quantity_To_Be_Created;
												show Stock_Bundling_Note.Item;
												show Stock_Bundling_Note.Line_Number;
												enable Stock_Bundling_Note.Asset;
												enable Stock_Bundling_Note.Quantity_To_Be_Created;
												enable Stock_Bundling_Note.Item;
												//enable Stock_Bundling_Note.
												show Notes;
												show Not_Created;
												enable Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
													enable Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
													disable Reason_Why_Not_Created;
												}
											}
											if(input.Voucher_Type == "Store Receiving Book")
											{
												show Asset;
												show Stock_Receiving_Details;
											}
											if(input.Voucher_Type == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Display_Name_Issued_By;
												hide Received_By;
												hide Display_Name_Received_By;
												show Voucher_Return;
												show Date_Time_Out;
												show Hours_Worked;
												show Shift;
												enable Shift;
											}
										}
										// =====================================================
										// ON EDIT + Status = CLOSED
										// =====================================================
										else if(!is_create && st == "Closed")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											if(input.Voucher_Type == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Display_Name_Issued_By;
												hide Received_By;
												hide Display_Name_Received_By;
												show Manager_Section;
												show Manager_Time;
												show Cancel_Voucher;
												show Case_Number;
												show Employee_Taking_To_Head_Office;
												show How_to_Take_to_Head_Office;
												show Time_Sent_to_Head_Office;
												enable Case_Number;
												enable Employee_Taking_To_Head_Office;
												enable How_to_Take_to_Head_Office;
												enable Cancel_Voucher;
												if(input.Cancel_Voucher == true)
												{
													show Cancellation_Reason;
													enable Cancellation_Reason;
												}
												else
												{
													hide Cancellation_Reason;
												}
											}
										}
										// =====================================================
										// ON EDIT + Status = RETURNED
										// =====================================================
										else if(!is_create && st == "Returned")
										{
											if(input.Voucher_Type == "Supervisor Voucher")
											{
												hide Received_By;
												hide Display_Name_Received_By;
											}
											show Issued_By;
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											if(input.Voucher_Type == "Cashier Envelope")
											{
												hide Voucher_Header;
												hide Voucher_Footer;
											}
											if(input.Voucher_Type == "Daily Cleaners Report")
											{
												show Voucher_Header;
												show Management_Location;
												show Special_Tasks_Done;
												show Voucher_Footer;
												show Voucher_Cost;
											}
											if(input.Voucher_Type == "Stock Receiving Note" || input.Voucher_Type == "Stock Bundling Note")
											{
												show Employee_Issuing_Details;
												show Voucher_Header;
												show Asset;
												show Item;
												show Quantity_To_Be_Created;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												show Quantity_Created;
												disable Asset;
												disable Item;
												disable Quantity_To_Be_Created;
												show Notes;
												show Not_Created;
												enable Not_Created;
												if(input.Not_Created == true)
												{
