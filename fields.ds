										disable Display_Name_Card;
										disable Customer;
										disable Display_Name_Customer;
										//Payment Section
										disable Amount_Due;
										disable Amount_Received;
										disable Amount_Credited;
										disable Balance_Due;
										disable Payment_Date;
										disable Cash_Receipt_Voucher;
										disable Cash_Receipt_Details;
										//Cash Section
										disable Old_Cashier_Paper_ID;
										disable Old_Cash_Envelope_ID;
										disable Old_Card_ID;
										//Back End
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										//HIDE FIELDS
										//Cashier Section
										hide Display_Name_Site;
										//Card Details
										hide Display_Name_Card;
										hide Display_Name_Customer;
										//Payment Details
										hide Amount_Received;
										hide Amount_Credited;
										hide Cash_Receipt_Voucher;
										hide Cash_Receipt_Details;
										//Cash Section
										hide Old_Cashier_Paper_ID;
										hide Old_Cash_Envelope_ID;
										hide Old_Card_ID;
										//Back End
										hide Back_End;
										//On CREATE
										if(input.ID == null)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
										}
						)
					}
				}

			}
