			On_Customer_Selected4 as "On Customer Selected"
			{
				type =  form
				form = Sand_Purchase_Order

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											// DELIVERY NOTE → On Customer Selected
										if(input.Customer == null)
										{
											// Clear parent display name
											input.Display_Name_Customer = null;
											// Clear subform display names
											for each  row in input.Purchase_Order_Details
											{
												row.Display_Name_Customer=null;
											}
											return;
										}
										// Auto-fill display name from the selected customer record (parent)
										input.Display_Name_Customer = input.Customer.Display_Name_Customer;
										// Push customer display name into subform rows
										for each  row in input.Purchase_Order_Details
										{
											row.Display_Name_Customer=input.Display_Name_Customer;
										}
						)
					}
				}

			}
