			On_Odometer_Unit_Of_Measu as "On Odometer Unit Of Measure Selected"
			{
				type =  form
				form = Asset_List

				record event = on add or edit

				on user input of Odometer_Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// ASSET LIST -> ON USER INPUT OF ODOMETER UNIT OF MEASURE
										// ======================================
										if(input.Odometer_Unit_Of_Measure != null)
										{
											input.Display_Name_Odometer_Unit_Of_Measure = input.Odometer_Unit_Of_Measure;
										}
