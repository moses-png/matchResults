											{
												row.Rate_in_Base_Unit=round(row.Rate / row.Conversion_Factor,2);
											}
											else
											{
												row.Rate_in_Base_Unit=round(row.Rate,2);
											}
										}
										else
										{
											row.Rate_in_Base_Unit=null;
										}
										// ---------------------------
										// Line Total
										// ---------------------------
										if(row.Quantity_in_Base_Unit != null && row.Rate_in_Base_Unit != null)
										{
											row.Line_Total=round(row.Quantity_in_Base_Unit * row.Rate_in_Base_Unit,2);
										}
										else
										{
											row.Line_Total=null;
										}
										// ---------------------------
										// Parent Totals
										// ---------------------------
										sand_total = ifnull(input.Rate_per_CBM,0) * ifnull(input.Truck_CBM,0);
										item_total = 0;
										for each  r in input.Item_Sales
										{
											item_total = item_total + ifnull(r.Line_Total,0);
										}
										input.Amount_Supposed_To_Pay_Sand_Sales = round(sand_total,2);
										input.Amount_Supposed_To_Pay_Item_Sales = round(item_total,2);
										input.Amount_Supposed_To_Pay = round(sand_total + item_total / 10000,2);
						)
					}
				}

			}
			On_Base_Unit_Of_Measure_S as "On Base Unit Of Measure Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Item_Sales.Base_Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// SUBFORM ROW → ON USER INPUT OF Base_Unit_Of_Measure
										// ===============================
										// 1) Show the selected Base Unit in single line
										if(row.Base_Unit_Of_Measure != null)
										{
											row.Unit_Of_Measure=row.Base_Unit_Of_Measure.Unit_Of_Measure_Name;
										}
										else
										{
											row.Unit_Of_Measure="";
										}
										// 2) Basic checks
										if(row.Item == null || row.Base_Unit_Of_Measure == null || row.Quantity == null || row.Quantity <= 0)
										{
											row.Rate_in_Base_Unit=null;
											row.Line_Total=null;
											// Recalculate parent totals safely
											sand_total = ifnull(input.Rate_per_CBM,0) * ifnull(input.Truck_CBM,0);
											item_total = 0;
											for each  r in input.Item_Sales
											{
												item_total = item_total + ifnull(r.Line_Total,0);
											}
											input.Amount_Supposed_To_Pay_Item_Sales = item_total;
											input.Amount_Supposed_To_Pay_Sand_Sales = sand_total;
											input.Amount_Supposed_To_Pay = sand_total + item_total;
											return;
										}
										// 3) Defaults
										conversion_factor = 1;
										is_allowed = false;
										base_uom = row.Item.Base_Unit_Of_Measure;
										// 4) Check if selected UoM is base
										if(row.Base_Unit_Of_Measure.get("ID") == base_uom.get("ID"))
										{
											is_allowed = true;
											conversion_factor = 1;
										}
										else
										{
											// 5) Check alternate UoM conversions
											if(row.Item.Unit_Conversion != null)
											{
												for each  conv in row.Item.Unit_Conversion
												{
													alt_uom = conv.get("alternate_unit_of_measure");
													if(alt_uom != null && alt_uom.get("ID") == row.Base_Unit_Of_Measure.get("ID"))
													{
														is_allowed = true;
														factor = conv.get("Conversion_To_Base");
														if(factor != null && factor > 0)
														{
															conversion_factor = factor;
														}
														break;
													}
												}
											}
										}
										// 6) Alert if UoM not allowed
										if(!is_allowed)
										{
											alert "The selected unit of measure is not valid for this item!";
											row.Rate_in_Base_Unit=null;
											row.Line_Total=null;
											// Recalculate parent totals safely
											sand_total = ifnull(input.Rate_per_CBM,0) * ifnull(input.Truck_CBM,0);
											item_total = 0;
											for each  r in input.Item_Sales
											{
												item_total = item_total + ifnull(r.Line_Total,0);
											}
											input.Amount_Supposed_To_Pay_Item_Sales = item_total;
											input.Amount_Supposed_To_Pay_Sand_Sales = sand_total;
											input.Amount_Supposed_To_Pay = sand_total + item_total;
											return;
										}
										// 7) Convert rate to base unit
										if(row.Rate != null)
										{
											row.Rate_in_Base_Unit=row.Rate / conversion_factor;
										}
										else
										{
											row.Rate_in_Base_Unit=null;
										}
										// 8) Quantity in base unit
										if(row.Quantity != null && row.Quantity > 0)
										{
											row.Quantity_in_Base_Unit=row.Quantity * conversion_factor;
										}
										else
										{
											row.Quantity_in_Base_Unit=null;
										}
										// 9) Line total
										if(row.Quantity_in_Base_Unit != null && row.Rate_in_Base_Unit != null)
										{
											row.Line_Total=row.Quantity_in_Base_Unit * row.Rate_in_Base_Unit;
										}
										else
										{
											row.Line_Total=null;
										}
										// 10) Update display field for single line Unit_Of_Measure
										if(row.Base_Unit_Of_Measure != null)
										{
											row.Unit_Of_Measure=row.Base_Unit_Of_Measure.get("Unit_Of_Measure_Name");
										}
										else
										{
											row.Unit_Of_Measure=null;
										}
										// 11) Recalculate parent totals
										sand_total = ifnull(input.Rate_per_CBM,0) * ifnull(input.Truck_CBM,0);
										item_total = 0;
										for each  r in input.Item_Sales
										{
											item_total = item_total + ifnull(r.Line_Total,0);
										}
										input.Amount_Supposed_To_Pay_Item_Sales = item_total;
										input.Amount_Supposed_To_Pay_Sand_Sales = sand_total;
										input.Amount_Supposed_To_Pay = round(sand_total + item_total / 10000,2);
						)
					}
				}

			}
			Add_Row_Item_Sales as "Add Row Item Sales"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on add row of Item_Sales
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// ITEM SALES ADD ROW
										// ===============================
										if(row != null)
										{
											line_no = 0;
											for each  r in input.Item_Sales
											{
