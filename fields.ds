											show Physical_Voucher_Type;
											hide Digital_Voucher_Type;
										}
										else if(input.Document_Type == "Digital Voucher")
										{
											hide Physical_Voucher_Type;
											show Digital_Voucher_Type;
										}
										else
										{
											hide Physical_Voucher_Type;
											hide Digital_Voucher_Type;
											input.Physical_Voucher_Type = null;
											input.Digital_Voucher_Type = null;
										}
						)
					}
				}

			}
			On_Document_Type_Selected as "On Document Type Selected"
			{
				type =  form
				form = Voucher

				record event = on add or edit

				on user input of Document_Type
				{
					actions 
					{
						custom deluge script
						(
											dt = ifnull(input.Document_Type,"").trim();
										if(dt == "Physical Voucher")
										{
											hide Digital_Voucher_Type;
											show Physical_Voucher_Type;
											enable Physical_Voucher_Type;
											enable Voucher_Number;
											input.Digital_Voucher_Type = null;
											input.Voucher_Type = null;
											input.Voucher_Number = null;
										}
										else if(dt == "Digital Voucher")
										{
											hide Physical_Voucher_Type;
											show Digital_Voucher_Type;
											enable Digital_Voucher_Type;
											disable Voucher_Number;
											input.Physical_Voucher_Type = null;
											input.Voucher_Type = null;
											input.Voucher_Number = null;
										}
										else
										{
											hide Physical_Voucher_Type;
											hide Digital_Voucher_Type;
											input.Physical_Voucher_Type = null;
											input.Digital_Voucher_Type = null;
										}
						)
					}
				}

			}
			On_Physical_Voucher_Type_ as "On Physical Voucher Type Selected"
			{
				type =  form
				form = Voucher

				record event = on add or edit

				on user input of Physical_Voucher_Type
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// ON USER INPUT: Physical_Voucher_Type
										// ========================================
										// 1) Safety: must be Physical Voucher
										if(input.Document_Type != "Physical Voucher")
										{
											return;
										}
										// 2) Sync main Voucher Type
										input.Voucher_Type = input.Physical_Voucher_Type;
										// 3) Hide digital-related fields
										hide Digital_Voucher_Type;
										input.Digital_Voucher_Type = null;
										// 4) Ensure Voucher Number is manual
										enable Voucher_Number;
										// ========================================
										// RESET FIRST (PREVENT LEFTOVERS)
										// ========================================
										// Supervisor Voucher / Shift fields
										show Issued_By;
										show Display_Name_Issued_By;
										hide Site;
										hide Display_Name_Site;
										// Voucher Header
										hide Voucher_Header;
										hide Management_Location;
										hide Asset;
										hide Machine_Start_of_Day;
										hide Start_Time;
										hide Odometer_Start;
										hide Item;
										hide Display_Name_Item;
										hide Quantity_To_Be_Created;
										hide Fuel_Start_Level;
										// Sub Forms
										hide Employee_Issuing_Details;
										hide Incident_Details;
										hide Visitor_Register_Details;
										hide Special_Tasks_Done;
										hide Parking_Controller_Details;
										hide Violation_Details;
										hide Tractor_Work_Details;
										hide Truck_Movement_Details;
										hide Drager_Work_Details;
										hide Kitchen_Employee_Details;
										hide Gate_Pass_Details;
										hide Truck_Measurement_Details;
										hide Item_Issuing_Details;
										hide Stock_Receiving_Details;
										hide Stock_Bundling_Note;
										hide Employee_Receiving_Details;
										hide Fuel_Receiving_Details;
										hide Meter_Readings;
										// Voucher Footer
										hide Voucher_Footer;
										hide Voucher_Cost;
										hide End_Time;
										hide Odometer_End;
										hide Fuel_End_Level;
										// ========================================
										// DOCUMENT TYPES - ALPHABETICAL ORDER
										// ========================================
										// Asset Transfer Voucher
										if(input.Voucher_Type == "Asset Transfer Voucher")
										{
											// Add fields here
										}
										// Boat Movement Voucher
										if(input.Voucher_Type == "Boat Movement Voucher")
										{
											// Add fields here
										}
										// Cashier Envelope
										if(input.Voucher_Type == "Cashier Envelope")
										{
											// Add fields here
										}
										// Cleaning Supervisor Checklist
										if(input.Voucher_Type == "Cleaning Supervisor Checklist")
										{
											// Add fields here
										}
										// Daily Cleaners Report
										if(input.Voucher_Type == "Daily Cleaners Report")
										{
											show Voucher_Header;
											show Management_Location;
											show Employee_Issuing_Details;
											show Special_Tasks_Done;
											show Voucher_Cost;
										}
										// Drager Work Report
										if(input.Voucher_Type == "Drager Work Report")
										{
											show Voucher_Header;
											show Asset;
											show Machine_Start_of_Day;
											show Start_Time;
											show Odometer_Start;
											show Employee_Issuing_Details;
											show Drager_Work_Details;
											show Voucher_Footer;
