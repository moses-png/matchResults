			On_Employee_Number_Select as "On Employee Number Selected"
			{
				type =  form
				form = Employee_Register

				record event = on add or edit

				on user input of Employee_Number
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------------
										// Build Display Name Employee
										// ------------------------------------
										emp_name = ifnull(input.Employee_Name,"").trim();
										emp_no = "";
										if(input.Employee_Number != null)
										{
											emp_no = input.Employee_Number.toString();
										}
										display_emp = "";
										if(emp_name != "" && emp_no != "")
										{
											display_emp = emp_name + " - " + emp_no;
										}
										else if(emp_name != "")
										{
											display_emp = emp_name;
										}
										else if(emp_no != "")
										{
											display_emp = emp_no;
										}
										input.Display_Name_Employee = display_emp;
										// ------------------------------------
										// Contact / Email Update Details
										// ------------------------------------
										if(input.Contact_Email_Update_Details != null)
										{
											for each  row_ce in input.Contact_Email_Update_Details
											{
												row_ce.Display_Name_Employee=display_emp;
												// Keep row linked to parent employee
												if(row_ce.Employee == null && input.ID != null)
												{
													row_ce.Employee=input.ID;
												}
											}
										}
										// ------------------------------------
										// Employee Department Details
										// ------------------------------------
										if(input.Employee_Department_Details != null)
										{
											for each  row_dept in input.Employee_Department_Details
											{
												row_dept.Display_Name_Employee=display_emp;
												if(row_dept.Employee == null && input.ID != null)
												{
													row_dept.Employee=input.ID;
												}
											}
										}
										// ------------------------------------
										// Employee Status Details
										// ------------------------------------
										if(input.Employee_Status_Details != null)
										{
											for each  row_st in input.Employee_Status_Details
											{
												row_st.Display_Name_Employee=display_emp;
												if(row_st.Employee == null && input.ID != null)
												{
													row_st.Employee=input.ID;
												}
											}
										}
										// ------------------------------------
										// Site Assigned
										// ------------------------------------
										if(input.Site_Assigned != null)
										{
											for each  row_sa in input.Site_Assigned
											{
												row_sa.Display_Name_Employee=display_emp;
												if(row_sa.Employee == null && input.ID != null)
												{
													row_sa.Employee=input.ID;
												}
												// Keep Employment Status synced
												if(input.Employment_Status != null)
												{
													row_sa.Employment_Status=input.Employment_Status;
												}
											}
										}
						)
					}
				}

			}
