			Set_Up_Form19 as "Set Up Form"
			{
				type =  form
				form = Machine_Start_of_Day

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Machine Start of Day -> On Load (Set Up Form)
										// -------------------------
										// 1) HIDE BACK-END FIELDS
										// -------------------------
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										// NOTE: do NOT always hide Display_Name_Voucher_Type here anymore
										hide Display_Name_Site;
										hide Display_Name_Asset_Type;
										hide Time_Started;
										//End Work
										hide End_Work;
										hide Time_Ended;
										hide Voucher_Status;
										//Back End Section
										hide Back_End;
										hide User_Name;
										hide User_Email;
										hide User_Role;
										hide Created_By_Name;
										hide Created_By_Email;
										hide Created_By_Time;
										hide Updated_By_Name;
										hide Updated_By_Email;
										hide Updated_By_Time;
										// -----------------------------------------------------
										// 1B) Display_Name_Voucher_Type should only display if NULL
										// -----------------------------------------------------
										//if(input.Display_Name_Voucher_Type == null)
										//{
										//show Display_Name_Voucher_Type;
										//}
										//else
										//{
										//hide Display_Name_Voucher_Type;
										//}
										// -------------------------
										// 2) DISABLE FIELDS (always)
										// -------------------------
										disable Display_Name_Voucher;
										disable Display_Name_Employee;
										disable Display_Name_Voucher_Type;
										// keep disabled (since it’s a display field)
										disable Display_Name_Site;
										disable Display_Name_Asset_Type;
										disable Time_Started;
										disable Time_Ended;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// -------------------------
										// 3) CREATE vs EDIT BEHAVIOR
										// -------------------------
										is_create = input.ID == null;
										// ---------- ON CREATE ----------
										if(is_create)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											if(input.User_Role == "Tractor Operator")
											{
												input.Display_Name_Voucher_Type = "Tractor Work Report";
											}
											else if(input.User_Role == "Truck Operator")
											{
												input.Display_Name_Voucher_Type = "Truck Movement Voucher";
											}
											else if(input.User_Role == "Drager Operator")
											{
												input.Display_Name_Voucher_Type = "Drager Work Report";
											}
											else
											{
												input.Display_Name_Voucher_Type = null;
											}
											// Show required create fields
											show Voucher;
											show Asset;
											show Odometer_Start;
											show Odometer_Start_Image;
											// Hide end fields until edit
											hide Odometer_End;
											hide Odometer_End_Image;
											// Status visible (optional) but locked (default Open is set on submit)
											show Voucher_Status;
											disable Voucher_Status;
										}
										// ---------- ON EDIT ----------
										else
										{
											// Always show these on edit (but lock the start side)
											show Voucher;
											show Odometer_Start;
											show Odometer_Start_Image;
											show Odometer_End;
											show Odometer_End_Image;
											show Voucher_Status;
											// If Status is Open: allow ending fields only
											if(input.Voucher_Status == "Open" || input.Voucher_Status == null)
											{
												disable Voucher;
												disable Asset;
												disable Odometer_Start;
												disable Odometer_Start_Image;
												disable Fuel_Start_Level;
												//End Work
												show End_Work;
												show Odometer_End;
												show Odometer_End_Image;
												enable Odometer_End;
												enable Odometer_End_Image;
												disable Voucher_Status;
												// will be changed by on-submit logic
											}
											else
											{
												// If not Open (Closed/Ended): lock everything
												disable Voucher;
												disable Asset;
												disable Odometer_Start;
												disable Odometer_Start_Image;
												disable Odometer_End;
												disable Odometer_End_Image;
												disable Voucher_Status;
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete2 as "Finalize On Delete"
			{
				type =  form
				form = Machine_Start_of_Day

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// MACHINE START OF DAY -> ON DELETE
										// Goal: clear values that were pushed to Voucher
										if(input.Voucher != null)
										{
											v = Voucher[ID == input.Voucher.ID];
