			Finalize12 as "Finalize"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											rec = Payment_Receipt_Voucher[ID == input.ID];
										if(rec.ID != null)
										{
											if(rec.Payment_Receipt_Date == null)
											{
												rec.Payment_Receipt_Date=zoho.currenttime;
											}
											total_charges = 0.0;
											for each  chg in rec.Charge_Details
											{
												total_charges = total_charges + ifnull(chg.Amount,0);
											}
											rec.Total_Charges=total_charges;
											total_allocated = 0.0;
											for each  det in Payment_Receipt_Details[Payment_Receipt_Voucher == rec.ID]
											{
												total_allocated = total_allocated + ifnull(det.Amount_Allocated,0);
											}
											rec.Total_Amount_Allocated=total_allocated;
											rec.Total_Amount_Not_Allocated=ifnull(rec.Total_Amount_Received,0) - ifnull(rec.Total_Charges,0) - ifnull(rec.Total_Amount_Allocated,0);
											if(rec.Total_Amount_Not_Allocated < 0)
											{
												rec.Total_Amount_Not_Allocated=0;
											}
											// Status
											if(ifnull(rec.Total_Amount_Allocated,0) == 0)
											{
												rec.Payment_Receipt_Voucher_Status="Unassigned";
											}
											else if(rec.Total_Amount_Not_Allocated > 0)
											{
												rec.Payment_Receipt_Voucher_Status="Partially Assigned";
											}
											else
											{
												rec.Payment_Receipt_Voucher_Status="Fully Assigned";
											}
										}
										if(input.ID != null)
										{
											receipt_datetime_txt = "";
											receipt_date_txt = "";
											if(input.Payment_Receipt_Date != null)
											{
												receipt_datetime_txt = input.Payment_Receipt_Date.toString("yyyy-MM-dd HH:mm:ss");
												receipt_date_txt = input.Payment_Receipt_Date.toString("yyyy-MM-dd");
											}
											created_time_txt = "";
											if(input.Created_By_Time != null)
											{
												created_time_txt = input.Created_By_Time.toString("yyyy-MM-dd HH:mm:ss");
											}
											updated_time_txt = "";
											if(input.Updated_By_Time != null)
											{
												updated_time_txt = input.Updated_By_Time.toString("yyyy-MM-dd HH:mm:ss");
											}
											// ==============================
											// SYNC PAYMENT VOUCHER
											// ==============================
											payload = Map();
											payload.put("Transaction_Type","Debit");
											payload.put("Account",input.Receiving_Account);
											payload.put("Display_Name_Account",ifnull(input.Display_Name_Receiving_Account,""));
											payload.put("Payment_Number",ifnull(input.Payment_Receipt_Number,""));
											payload.put("Payment_Date",receipt_date_txt);
											payload.put("Payment_Date_Time",receipt_datetime_txt);
											payload.put("Description",ifnull(input.Display_Name_Customer,""));
											payload.put("Total_Amount_Received",ifnull(input.Total_Amount_Received,0.0));
											payload.put("Total_Amount_Paid",0.0);
											payload.put("Payment_Voucher_Status","Draft");
											payload.put("Application","Kicks Klean Ug");
											payload.put("Transaction_Date",receipt_date_txt);
											payload.put("Source_Form","Payment Receipt Voucher");
											payload.put("Source_Record_ID",input.ID.toLong());
											payload.put("Voucher_Number",ifnull(input.Payment_Receipt_Number,""));
											payload.put("User_Name",ifnull(input.User_Name,""));
											payload.put("User_Email",ifnull(input.User_Email,""));
											payload.put("User_Role",ifnull(input.User_Role,""));
											payload.put("Created_By_Name",ifnull(input.Created_By_Name,""));
											payload.put("Created_By_Email",ifnull(input.Created_By_Email,""));
											payload.put("Created_By_Time",created_time_txt);
											payload.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
											payload.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
											payload.put("Updated_By_Time",updated_time_txt);
											sync_resp = md_payment_management.syncPaymentVoucherFromKicksKlean(payload);
											info sync_resp;
											// ==============================
											// ACCOUNT TRANSACTION LOG
											// ==============================
											receipt_dt = input.Payment_Receipt_Date;
											if(receipt_dt == null)
											{
												receipt_dt = zoho.currenttime;
											}
											txn = Map();
											txn.put("Transaction_Date",receipt_dt);
											txn.put("Account",input.Receiving_Account);
											txn.put("Display_Name_Account",ifnull(input.Display_Name_Receiving_Account,""));
											txn.put("Transaction_Type","Debit");
											txn.put("Amount",ifnull(input.Total_Amount_Received,0.0));
											txn.put("Reference_Type","Payment Receipt Voucher");
											txn.put("Reference_Number",ifnull(input.Payment_Receipt_Number,""));
											txn.put("Application","Kicks Klean Ug");
											txn.put("Source_Form","Payment Receipt Voucher");
											txn.put("Source_Record_ID",input.ID);
											txn.put("Notes",ifnull(input.Display_Name_Customer,""));
											txn.put("User_Name",ifnull(input.User_Name,""));
											txn.put("User_Email",ifnull(input.User_Email,""));
											txn.put("User_Role",ifnull(input.User_Role,""));
											txn.put("Created_By_Name",ifnull(input.Created_By_Name,""));
											txn.put("Created_By_Email",ifnull(input.Created_By_Email,""));
											txn.put("Created_By_Time",input.Created_By_Time);
											txn.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
											txn.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
											txn.put("Updated_By_Time",zoho.currenttime);
											txn_resp = md_payment_management.createOrUpdateAccountTransactionLog(txn);
											info txn_resp;
											md_payment_management.Recalculate_Unconfirmed_Account_Totals();
										}
										// ==============================
										// OPEN PAYMENT DETAILS FORM
										// ==============================
										if(input.Total_Amount_Not_Allocated > 0)
										{
											openUrl("#Form:Payment_Receipt_Details","same window");
										}
										// =====================================================
										// UPDATE CUSTOMER PERFORMANCE
										// =====================================================
										if(input.Customer != null)
										{
											thisapp.customer.update_customer_performance(input.Customer);
										}
						)
					}
				}

			}
			Finalize1 as "Finalize"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// PAYMENT RECEIPT DETAILS — FINALIZE
										// ======================================================
										// 1. UPDATE PAYMENT RECEIPT VOUCHER
										if(input.Payment_Receipt_Voucher != null)
										{
											prv = Payment_Receipt_Voucher[ID == input.Payment_Receipt_Voucher];
											if(prv.ID != null)
											{
												total_charges = 0.0;
												for each  ch in Payment_Charges[Payment_Receipt_Voucher == prv.ID]
												{
													total_charges = total_charges + ifnull(ch.Amount,0.0);
												}
												detail_allocated = 0.0;
												for each  det in Payment_Receipt_Details[Payment_Receipt_Voucher == prv.ID]
												{
													detail_allocated = detail_allocated + ifnull(det.Amount_Allocated,0.0);
												}
												amount_allocated = total_charges + detail_allocated;
												balance = ifnull(prv.Total_Amount_Received,0.0) - amount_allocated;
												if(balance < 0)
												{
													balance = 0.0;
												}
												prv.Total_Charges=total_charges;
												prv.Total_Amount_Allocated=amount_allocated;
												prv.Total_Amount_Not_Allocated=balance;
												if(balance <= 0)
												{
													prv.Payment_Receipt_Voucher_Status="Fully Assigned";
												}
												else if(amount_allocated > 0)
												{
													prv.Payment_Receipt_Voucher_Status="Partially Assigned";
												}
												else
												{
													prv.Payment_Receipt_Voucher_Status="Unassigned";
												}
											}
										}
										// ======================================================
										// 2. UPDATE SALES VOUCHER
										// ======================================================
										if(input.Sales_Voucher != null)
										{
											sv = Sales_Voucher[ID == input.Sales_Voucher];
											if(sv.ID != null)
											{
												total_paid = 0.0;
												for each  det2 in Payment_Receipt_Details[Sales_Voucher == sv.ID]
												{
													total_paid = total_paid + ifnull(det2.Amount_Allocated,0.0);
												}
												total_paid = round(total_paid,2);
												sv_total = round(ifnull(sv.Grand_Total,0.0),2);
												if(total_paid > sv_total)
												{
													total_paid = sv_total;
												}
												bal = round(sv_total - total_paid,2);
												if(bal < 0)
												{
													bal = 0.0;
												}
												payment_status = "Unpaid";
												if(sv_total > 0 && bal <= 0)
												{
													payment_status = "Paid";
												}
												else if(total_paid > 0)
												{
													payment_status = "Partially Paid";
												}
												sv.Amount_Paid=total_paid;
												sv.Balance_Due=bal;
												sv.Payment_Status=payment_status;
												for each  shoe_row in sv.Shoe_Services
												{
													shoe_row.Payment_Status=payment_status;
												}
											}
										}
										if(input.ID != null && input.Payment_Receipt_Voucher != null)
										{
											parent_prv = Payment_Receipt_Voucher[ID == input.Payment_Receipt_Voucher];
											if(parent_prv.ID != null)
											{
												// ----------------------------------------------
												// Parent dates
												// ----------------------------------------------
												parent_date_txt = "";
												parent_datetime_txt = "";
												if(parent_prv.Payment_Receipt_Date != null)
												{
													parent_date_txt = parent_prv.Payment_Receipt_Date.toString("yyyy-MM-dd");
													parent_datetime_txt = parent_prv.Payment_Receipt_Date.toString("yyyy-MM-dd HH:mm:ss");
												}
												parent_created_time_txt = "";
												if(parent_prv.Created_By_Time != null)
												{
													parent_created_time_txt = parent_prv.Created_By_Time.toString("yyyy-MM-dd HH:mm:ss");
												}
												parent_updated_time_txt = "";
												if(parent_prv.Updated_By_Time != null)
												{
													parent_updated_time_txt = parent_prv.Updated_By_Time.toString("yyyy-MM-dd HH:mm:ss");
												}
												// ----------------------------------------------
												// Build parent Payment Voucher payload
												// ----------------------------------------------
												parent_payload = Map();
												parent_payload.put("Transaction_Type","Debit");
												parent_payload.put("Account",parent_prv.Receiving_Account);
												parent_payload.put("Display_Name_Account",ifnull(parent_prv.Display_Name_Receiving_Account,""));
												parent_payload.put("Payment_Number",ifnull(parent_prv.Payment_Receipt_Number,""));
												parent_payload.put("Payment_Date",parent_date_txt);
												parent_payload.put("Payment_Date_Time",parent_datetime_txt);
												parent_payload.put("Description",ifnull(parent_prv.Display_Name_Customer,""));
												parent_payload.put("Total_Amount_Received",ifnull(parent_prv.Total_Amount_Received,0.0));
												parent_payload.put("Total_Amount_Paid",0.0);
												parent_payload.put("Payment_Voucher_Status","Draft");
												parent_payload.put("Application","Kicks Klean Ug");
												parent_payload.put("Transaction_Date",parent_date_txt);
												parent_payload.put("Source_Form","Payment Receipt Voucher");
												parent_payload.put("Source_Record_ID",parent_prv.ID.toLong());
												parent_payload.put("Voucher_Number",ifnull(parent_prv.Payment_Receipt_Number,""));
												parent_payload.put("User_Name",ifnull(parent_prv.User_Name,""));
												parent_payload.put("User_Email",ifnull(parent_prv.User_Email,""));
												parent_payload.put("User_Role",ifnull(parent_prv.User_Role,""));
												parent_payload.put("Created_By_Name",ifnull(parent_prv.Created_By_Name,""));
												parent_payload.put("Created_By_Email",ifnull(parent_prv.Created_By_Email,""));
												parent_payload.put("Created_By_Time",parent_created_time_txt);
												parent_payload.put("Updated_By_Name",ifnull(parent_prv.Updated_By_Name,""));
												parent_payload.put("Updated_By_Email",ifnull(parent_prv.Updated_By_Email,""));
												parent_payload.put("Updated_By_Time",parent_updated_time_txt);
												// ----------------------------------------------
												// Create or update parent Payment Voucher
												// ----------------------------------------------
												parent_sync_resp = md_payment_management.syncPaymentVoucherFromKicksKlean(parent_payload);
												info "Parent Payment Voucher sync response:";
												info parent_sync_resp;
												if(parent_sync_resp != null)
												{
													if(parent_sync_resp.get("ok") == true)
													{
														parent_sync_ok = true;
													}
												}
											}
											else
											{
												info "Linked Payment Receipt Voucher record could not be found.";
											}
										}
										// ======================================================
										// 4. SYNC PAYMENT RECEIPT DETAIL
										// ======================================================
										if(input.ID != null && input.Payment_Receipt_Voucher != null)
										{
											if(parent_sync_ok == true)
											{
												// ----------------------------------------------
												// Build description
												// ----------------------------------------------
												description = "";
												doc_name = "";
												if(ifnull(input.Display_Name_Invoice_Voucher,"") != "")
												{
													doc_name = input.Display_Name_Invoice_Voucher;
													if(doc_name.contains(" - "))
													{
														doc_name = doc_name.getPrefix(" - ");
													}
												}
												if(doc_name != "")
												{
													description = doc_name;
												}
												// ----------------------------------------------
												// Amount to sync
												// ----------------------------------------------
												// Only sync the amount actually allocated.
												sync_amount = ifnull(input.Amount_Allocated,0.0);
												// ----------------------------------------------
												// Transaction date
												// ----------------------------------------------
												transaction_date_txt = "";
												if(parent_prv.Payment_Receipt_Date != null)
												{
													transaction_date_txt = parent_prv.Payment_Receipt_Date.toString("yyyy-MM-dd");
												}
												// ----------------------------------------------
												// Created and updated times
												// ----------------------------------------------
												created_time_txt = "";
												if(input.Created_By_Time != null)
												{
													created_time_txt = input.Created_By_Time.toString("yyyy-MM-dd HH:mm:ss");
												}
												updated_time_txt = "";
												if(input.Updated_By_Time != null)
												{
													updated_time_txt = input.Updated_By_Time.toString("yyyy-MM-dd HH:mm:ss");
												}
												// ----------------------------------------------
												// Build detail payload
												// ----------------------------------------------
												payload = Map();
												payload.put("Payment_Voucher_Source_ID",parent_prv.ID.toLong());
												payload.put("Display_Name_Payment_Voucher",ifnull(input.Display_Name_Voucher,""));
												payload.put("Line_Number",ifnull(input.Line_Number,0));
												payload.put("Description",description);
												payload.put("Amount_Allocated",sync_amount);
												payload.put("Application","Kicks Klean Ug");
												payload.put("Transaction_Date",transaction_date_txt);
												payload.put("Source_Form","Payment Receipt Details");
												payload.put("Source_Record_ID",input.ID.toLong());
												payload.put("Voucher_Number",ifnull(parent_prv.Payment_Receipt_Number,""));
												payload.put("User_Name",ifnull(input.User_Name,""));
												payload.put("User_Email",ifnull(input.User_Email,""));
												payload.put("User_Role",ifnull(input.User_Role,""));
												payload.put("Created_By_Name",ifnull(input.Created_By_Name,""));
												payload.put("Created_By_Email",ifnull(input.Created_By_Email,""));
												payload.put("Created_By_Time",created_time_txt);
												payload.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
												payload.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
												payload.put("Updated_By_Time",updated_time_txt);
												// ----------------------------------------------
												// Create or update Payment Receipt Detail
												// ----------------------------------------------
												sync_resp = md_payment_management.syncPaymentDetailsFromkicksklean(payload);
												info "Payment Receipt Detail sync response:";
												info sync_resp;
												if(sync_resp != null)
												{
													if(sync_resp.get("ok") == true)
													{
														detail_sync_ok = true;
													}
												}
											}
											else
											{
												info "Payment Receipt Detail was not synced because the parent Payment Voucher could not be created or updated.";
											}
										}
										// ======================================================
										// 5. REFRESH ONLY THE AFFECTED ACCOUNT
										// ======================================================
										if(detail_sync_ok == true)
										{
											if(parent_prv.Receiving_Account != null)
											{
												account_id = parent_prv.Receiving_Account.ID;
												refresh_resp = md_payment_management.refreshAccountTransactionLog(account_id);
												info "Account Transaction Log refresh response:";
												info refresh_resp;
											}
											else
											{
												info "Account log refresh skipped: Receiving Account is empty.";
											}
										}
						)
					}
				}

			}
			Set_Up_Form7 as "Set Up Form"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//HIDE FIELDS
										//Voucher Details
										hide Display_Name_Customer;
										hide Display_Name_Voucher;
										//Allocation Details
										hide Display_Name_Invoice_Voucher;
										//Amount Details
										//Back End
										hide Back_End;
										//DISABLE FIELDS
										//Voucher Details
										disable Display_Name_Voucher;
										disable Line_Number;
										//Allocation Details
										disable Display_Name_Invoice_Voucher;
										//Amount Details
										disable Amount_Due;
										disable Balance_Due;
										disable Amount_Not_Allocated;
										disable Customer;
										//Back End
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// ======================================================
										// 2) CREATE MODE
										// ======================================================
										if(input.ID == null)
										{
										}
						)
					}
				}

			}
