                 	next_logs = Asset_Mileage_Log[Asset == asset_id && Date_Time_Recorded > date_time_recorded] sort by Date_Time_Recorded asc;
                 	for each  nx in next_logs
                 	{
                 		if(nx.Void_Mileage == true)
                 		{
                 			continue;
                 		}
                 		if(nx.ID != log_id)
                 		{
                 			nx.Previous_Odometer=odometer_reading;
                 			new_next_distance = ifnull(nx.Odometer_Reading,0.0) - odometer_reading;
                 			if(new_next_distance < 0)
                 			{
                 				new_next_distance = 0.0;
                 			}
                 			nx.Distance_Since_Last=new_next_distance;
                 			break;
                 		}
                 	}
                 	if(odometer_reading > ifnull(asset_rec.Odometer_Reading,0.0))
                 	{
                 		asset_rec.Odometer_Reading=odometer_reading;
                 		asset_rec.Date_Time_Odometer_Read=date_time_recorded;
                 	}
                 	resp.put("ok",true);
                 	resp.put("message","Mileage logged from Kicks Clean Ug.");
                 	resp.put("Mileage_Log_ID",log_id);
                 	return resp;
                 }
				 map logMileageFromManagewise(int asset_id, decimal odometer_reading, date date_time_recorded, string reference_text, string source_form_text, string source_record_id_text)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	if(asset_id == null)
                 	{
                 		resp.put("message","Asset is required.");
                 		return resp;
                 	}
                 	if(odometer_reading == null || odometer_reading <= 0)
                 	{
                 		resp.put("message","Odometer reading is required.");
                 		return resp;
                 	}
                 	if(date_time_recorded == null)
                 	{
                 		date_time_recorded = zoho.currenttime;
                 	}
                 	asset_rec = Asset_List[ID == asset_id];
                 	if(asset_rec.ID == null)
                 	{
                 		resp.put("message","Asset not found.");
                 		return resp;
                 	}
                 	u = thisapp.audit.getLoginAuditInfo();
                 	user_name_val = u.get("name");
                 	user_email_val = u.get("email");
                 	user_role_val = u.get("role");
                 	unit_of_measure_val = asset_rec.Odometer_Unit_Of_Measure;
                 	previous_odometer = 0.0;
                 	prev_logs = Asset_Mileage_Log[Asset == asset_id && Date_Time_Recorded < date_time_recorded] sort by Date_Time_Recorded desc;
                 	for each  pl in prev_logs
                 	{
                 		if(pl.Void_Mileage == true)
                 		{
                 			continue;
                 		}
                 		previous_odometer = ifnull(pl.Odometer_Reading,0.0);
                 		break;
                 	}
                 	distance_since_last = odometer_reading - previous_odometer;
                 	if(distance_since_last < 0)
                 	{
                 		distance_since_last = 0.0;
                 	}
                 	existing_log = Asset_Mileage_Log[Odometer_Source_Form == source_form_text && Source_Record_ID == source_record_id_text];
                 	if(existing_log.ID != null)
                 	{
                 		existing_log.Asset=asset_id;
                 		existing_log.Date_Time_Recorded=date_time_recorded;
                 		existing_log.Odometer_Reading=odometer_reading;
                 		existing_log.Previous_Odometer=previous_odometer;
                 		existing_log.Distance_Since_Last=distance_since_last;
                 		existing_log.Unit_of_Measure=unit_of_measure_val;
                 		existing_log.Odometer_Source_Form=source_form_text;
                 		existing_log.Source_Record_ID=source_record_id_text;
                 		existing_log.Reference=ifnull(reference_text,"");
                 		existing_log.User_Name=user_name_val;
                 		existing_log.User_Email=user_email_val;
                 		existing_log.User_Role=user_role_val;
                 		existing_log.Updated_By_Name=user_name_val;
                 		existing_log.Updated_By_Email=user_email_val;
                 		existing_log.Updated_By_Time=zoho.currenttime;
                 		log_id = existing_log.ID;
                 	}
                 	else
                 	{
                 		log_id = insert into Asset_Mileage_Log
                 		[
                 			Asset=asset_id
                 			Date_Time_Recorded=date_time_recorded
                 			Odometer_Reading=odometer_reading
                 			Previous_Odometer=previous_odometer
                 			Distance_Since_Last=distance_since_last
                 			Unit_of_Measure=unit_of_measure_val
                 			Odometer_Source_Form=source_form_text
                 			Source_Record_ID=source_record_id_text
                 			Reference=ifnull(reference_text,"")
                 			User_Name=user_name_val
                 			User_Email=user_email_val
                 			User_Role=user_role_val
                 			Created_By_Name=user_name_val
                 			Created_By_Email=user_email_val
                 			Created_By_Time=zoho.currenttime
                 			Added_User=zoho.loginuser
                 		];
                 	}
                 	next_logs = Asset_Mileage_Log[Asset == asset_id && Date_Time_Recorded > date_time_recorded] sort by Date_Time_Recorded asc;
                 	for each  nx in next_logs
                 	{
                 		if(nx.Void_Mileage == true)
                 		{
                 			continue;
                 		}
                 		if(nx.ID != log_id)
                 		{
                 			nx.Previous_Odometer=odometer_reading;
                 			new_next_distance = ifnull(nx.Odometer_Reading,0.0) - odometer_reading;
                 			if(new_next_distance < 0)
                 			{
                 				new_next_distance = 0.0;
                 			}
                 			nx.Distance_Since_Last=new_next_distance;
                 			break;
                 		}
                 	}
                 	if(odometer_reading > ifnull(asset_rec.Odometer_Reading,0.0))
                 	{
                 		asset_rec.Odometer_Reading=odometer_reading;
                 		asset_rec.Date_Time_Odometer_Read=date_time_recorded;
                 	}
                 	resp.put("ok",true);
                 	resp.put("message","Mileage logged from Managewise.");
                 	resp.put("Mileage_Log_ID",log_id);
                 	return resp;
                 }
