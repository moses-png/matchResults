			Set_Up_Form15 as "Set Up Form"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// PURCHASE ORDER - SET UP FORM
										// ======================================
										// --------------------------------------
										// HEADER CONTROLS
										// --------------------------------------
										disable PO_Total;
										disable PO_Status;
										disable PO_Total_Paid;
										disable Payment_Status;
										disable Receive_Status;
										hide PO_Billed_Total;
										hide PO_Total_Paid;
										hide Reason_Why_Closed;
										// ======================================
										// SUBFORM CONTROLS
										// ======================================
										disable PO_Details.Purchase_Order_Number;
										disable PO_Details.Line_Total;
										hide PO_Details.Display_Name_Item;
										hide PO_Details.Display_Name_Unit_Of_Measure;
										hide Site;
										hide Display_Name_Employee_Voucher;
										hide PO_Details.Quantity_Received;
										hide PO_Details.Quantity_Remaining;
										hide PO_Details.Purchase_Order_Details_Number;
										hide PO_Details.Quantity_in_Base_Unit_Of_Measure;
										hide PO_Details.Receiving_Status;
										hide PO_Details.Quantity_Unbilled;
										hide PO_Details.Quantity_Billed;
										hide PO_Details.Quantity_Billable;
										hide PO_Details.Billing_Status;
										hide PO_Details.Display_Name_Purchase_Order;
										hide PO_Details.Purchase_Order_Number;
										// ================================
										// SET UP FORM
										// ================================
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										disable Bill_Status;
										disable Payment_Status;
										disable PO_Number;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// ===============================================
										// HIDE PO DETAILS SUBFORM BACKEND FIELDS
										// ===============================================
										hide PO_Details.User_Role;
										hide PO_Details.User_Name;
										hide PO_Details.User_Email;
										hide PO_Details.Created_By_Name;
										hide PO_Details.Created_By_Email;
										hide PO_Details.Created_By_Time;
										hide PO_Details.Updated_By_Name;
										hide PO_Details.Updated_By_Email;
										hide PO_Details.Updated_By_Time;
										if(input.ID != null)
										{
											show Close_Purchase_Order;
										}
										else
										{
											hide Close_Purchase_Order;
										}
						)
					}
				}

			}
