			Full_Validation3 as "Full Validation"
			{
				type =  form
				form = Customer_Register

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// CUSTOMER: FULL VALIDATION
										// Required: Customer_Name, Phone_Number
										// Duplicates blocked: Customer_Name, Phone_Number
										// ===============================
										// 1) REQUIRED
										if(input.Customer_Name == null || input.Customer_Name.trim() == "")
										{
											alert "Customer Name is required.";
											cancel submit;
										}
										if(input.Phone_Number == null || input.Phone_Number.toString().trim() == "")
										{
											alert "Phone Number is required.";
											cancel submit;
										}
						)
					}
				}

			}
			On_User_input_of_Item_Nam as "On User input of Item Name"
			{
				type =  form
				form = Job_Card

				record event = on add or edit

				on user input of Items_Used.Item_Name
				{
					actions 
					{
						custom deluge script
						(
											if(row.Item_Name != null)
										{
											// Base Unit Of Measure from Item
											row.Unit_Of_Measure=ifnull(row.Item_Name.Base_Unit_Of_Measure.Unit_Of_Measure_Name,"");
											// Default Cost from Item
											row.Unit_Cost=ifnull(row.Item_Name.Default_Cost,0);
											// Line Total
											row.Line_Total=ifnull(row.Quantity,0) * ifnull(row.Unit_Cost,0);
										}
										else
										{
											row.Unit_Of_Measure="";
											row.Unit_Cost=0;
											row.Line_Total=0;
										}
										// Recalculate parent total (IMPORTANT)
										total = 0;
										for each  r in input.Items_Used
										{
											total = total + ifnull(r.Line_Total,0);
										}
										input.Items_Total = total;
						)
					}
				}

			}
			On_User_input_Of_Quantity as "On User input Of Quantity"
			{
				type =  form
				form = Job_Card

				record event = on add or edit

				on user input of Items_Used.Quantity
				{
					actions 
					{
						custom deluge script
						(
											row.Line_Total=ifnull(row.Quantity,0) * ifnull(row.Unit_Cost,0);
										// Recalculate parent total
										total = 0;
										for each  r in input.Items_Used
										{
											total = total + ifnull(r.Line_Total,0);
										}
										input.Items_Total = total;
						)
					}
				}

			}
			Addition_of_Row_in_Items_ as "Addition of Row in Items Used"
			{
				type =  form
				form = Job_Card

				record event = on add or edit

				on add row of Items_Used
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// Items Used: Row Added
										// Renumber + calc lines + total
										// ===============================
										lineNo = 0;
										total = 0;
										for each  r in input.Items_Used
										{
											lineNo = lineNo + 1;
											r.Line_Number=lineNo;
											// Ensure safe totals
											r.Line_Total=ifnull(r.Quantity,0) * ifnull(r.Unit_Cost,0);
											total = total + ifnull(r.Line_Total,0);
											// Carry parent names into rows (optional but useful)
											r.Display_Name_Voucher=input.Display_Name_Voucher;
											r.Display_Name_Employee=input.Display_Name_Employee;
										}
										input.Items_Total = total;
						)
					}
				}

			}
			Deletion_of_Row_Added_Ite as "Deletion of Row Added Items Used"
			{
				type =  form
				form = Job_Card

				record event = on add or edit

				on delete row of Items_Used
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// Items Used: Row Deleted (FAST)
										// Subtract deleted line total, then renumber
										// ===============================
										input.Items_Total = ifnull(input.Items_Total,0) - ifnull(row.Line_Total,0);
										// Clean up: renumber remaining rows
										lineNo = 0;
										for each  r in input.Items_Used
										{
											lineNo = lineNo + 1;
											r.Line_Number=lineNo;
										}
						)
					}
				}

			}
			On_User_input_of_Amount_P as "On User input of Amount Paid"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Amount_Paid
				{
					actions 
					{
						custom deluge script
						(
											grandTotal = ifnull(input.Grand_Total,0);
										paid = ifnull(input.Amount_Paid,0);
										if(paid <= 0)
										{
											Payment_Status = "Unpaid";
										}
										else if(paid < grandTotal)
										{
											Payment_Status = "Partially Paid";
										}
										else
										{
											Payment_Status = "Paid";
										}
						)
					}
				}

			}
			On_Item_Issuing_Voucher_S as "On Item Issuing Voucher Selected"
			{
				type =  form
				form = Job_Card

				record event = on add or edit

				on user input of Item_Issuing_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Item_Issuing_Voucher != null)
										{
											show Items_Used;
										}
										else
										{
											hide Items_Used;
										}
						)
					}
				}

			}
			Full_Validation5 as "Full Validation"
			{
				type =  form
				form = Job_Card

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// VOUCHER REQUIRED
										// ===============================
										if(input.Voucher == null)
										{
											alert "Voucher is required.";
											cancel submit;
										}
										// ===============================
										// ELECTRICITY STARTED REQUIRED
										// ===============================
										if(input.Electricity_Started == null)
										{
											alert "Please enter Electricity Started.";
											cancel submit;
										}
										// ===============================
										// ONLY ONE JOB CARD PER DAY (CREATE ONLY)
										// ===============================
										if(input.ID == null)
										{
											// only when creating
											startOfDay = zoho.currentdate.toString("yyyy-MM-dd") + " 00:00:00";
											endOfDay = zoho.currentdate.toString("yyyy-MM-dd") + " 23:59:59";
											existing = Job_Card[Display_Name_Employee == input.Display_Name_Employee && Time_Started >= startOfDay && Time_Started <= endOfDay];
											if(existing.ID != null)
											{
												alert "A Job Card already exists today for this employee.";
												cancel submit;
											}
										}
						)
					}
				}

			}
