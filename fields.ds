			On_Voucher_Selected as "On Voucher Selected"
			{
				type =  form
				form = Visitors_Register

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											// Visitors Register → On Voucher Selected
										if(input.Voucher != null)
										{
											input.Display_Name_Voucher = input.Voucher.Voucher_Number;
										}
										else
										{
											input.Display_Name_Voucher = null;
										}
						)
					}
				}

			}
			Finalize2 as "Finalize"
			{
				type =  form
				form = Visitors_Register

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Visitors Register → On Submit (Successful Submission)
										// Auto-fill Line_Number (per Voucher) + Time_In
										// PLUS:
										//   - On Create + Entry_By=Card -> update Sales Voucher (Security Guard In, Minutes Used, Truck Stage)
										//   - On Edit   + Entry_By=Card -> update Sales Voucher (Security Guard Out, Minutes Used, Overall Time, Truck Stage)
										//   - Gate Pass: Mark as Used (Create OR Edit)
										now_ts = zoho.currenttime;
										// -------------------------------------------------
										// Detect CREATE vs EDIT
										// -------------------------------------------------
										is_create = false;
										if(input.Added_Time != null && input.Modified_Time != null)
										{
											if(input.Added_Time.toLong() == input.Modified_Time.toLong())
											{
												is_create = true;
											}
										}
										// -------------------------------------------------
										// ON CREATE: Time In + Line Number + (Card) Update Sales Voucher
										// -------------------------------------------------
										if(is_create == true)
										{
											// 1) Time In (stamp once)
											if(input.Time_In == null)
											{
												input.Time_In = now_ts;
											}
											// 2) Line Number (counting per Voucher)
											if(input.Voucher != null)
											{
												maxLine = 0;
												rows = Visitors_Register[Voucher == input.Voucher && ID != input.ID];
												for each  r in rows
												{
													if(r.Line_Number != null && r.Line_Number > maxLine)
													{
														maxLine = r.Line_Number;
													}
												}
												input.Line_Number = maxLine + 1;
											}
											// 3) NEW: If Entry By = Card -> Update Sales Voucher (Security Guard In)
											if(input.Entry_By == "Card" && input.Card != null)
											{
												// Find Sales Voucher by Card Number
												sv = null;
												for each  rec in Sales_Voucher[Card_Number == input.Card.Card_Number]
												{
													sv = rec;
													break;
												}
												if(sv != null)
												{
													// A) Time Security Guard In (stamp once)
													if(sv.Time_Security_Guard_In == null)
													{
														sv.Time_Security_Guard_In=now_ts;
													}
													// B) Minutes Used Security Guard In
													//    (Guard In - (Cashier OR Receipt))
													t_in_ms = if(sv.Time_Security_Guard_In != null,sv.Time_Security_Guard_In.toLong(),null);
													if(sv.Time_Cashier != null)
													{
														t_start_ms = sv.Time_Cashier.toLong();
														if(t_in_ms != null && t_start_ms != null)
														{
															diff_ms = t_in_ms - t_start_ms;
															sv.Minutes_Used_Security_Guard_In=(diff_ms / 60000.0).round(2);
														}
													}
													else if(sv.Time_Receipt != null)
													{
														t_start_ms = sv.Time_Receipt.toLong();
														if(t_in_ms != null && t_start_ms != null)
														{
															diff_ms = t_in_ms - t_start_ms;
															sv.Minutes_Used_Security_Guard_In=(diff_ms / 60000.0).round(2);
														}
													}
													// C) Change Truck Stage to Loading
													sv.Sales_Voucher_Status="Loading";
												}
											}
										}
										// -------------------------------------------------
										// ON EDIT: Auto-checkout (Out + Time Out) + (Card) Update Sales Voucher
										// -------------------------------------------------
										if(is_create == false)
										{
											// 1) Mark visitor out + stamp Time Out
											input.Line_Status = "Out";
											if(input.Time_Out == null)
											{
												input.Time_Out = now_ts;
											}
											// 2) If Entry By = Card -> Update Sales Voucher (Security Guard Out)
											if(input.Entry_By == "Card" && input.Card != null)
											{
												// Find Sales Voucher by Card Number
												sv = null;
												for each  rec in Sales_Voucher[Card_Number == input.Card.Card_Number]
												{
													sv = rec;
													break;
												}
												if(sv != null)
												{
													// A) Time Security Guard Out (stamp once)
													if(sv.Time_Security_Guard_Out == null)
													{
														sv.Time_Security_Guard_Out=now_ts;
													}
													// Prepare MS values safely
													t_out_ms = if(sv.Time_Security_Guard_Out != null,sv.Time_Security_Guard_Out.toLong(),null);
													t_in_ms = if(sv.Time_Security_Guard_In != null,sv.Time_Security_Guard_In.toLong(),null);
													// B) Minutes Used Security Guard Out (Out - In)
													if(t_out_ms != null && t_in_ms != null)
													{
														diff_ms = t_out_ms - t_in_ms;
														sv.Minutes_Used_Security_Guard_Out=(diff_ms / 60000.0).round(2);
													}
													// C) Overall Time Spent in Site (Out - first available start)
													start_ms = null;
													if(sv.Time_Cashier != null)
													{
														start_ms = sv.Time_Cashier.toLong();
													}
													else if(sv.Time_Receipt != null)
													{
														start_ms = sv.Time_Receipt.toLong();
													}
													else if(t_in_ms != null)
													{
														start_ms = t_in_ms;
													}
													if(t_out_ms != null && start_ms != null)
													{
														diff_ms = t_out_ms - start_ms;
														sv.Overall_Time_Spent_in_Site=(diff_ms / 60000.0).round(2);
													}
													// D) Change Truck Stage to Left Site
													sv.Sales_Voucher_Status="Left Site";
												}
											}
										}
										// -------------------------------------------------
										// Gate Pass: Mark as Used (Create OR Edit)
										// -------------------------------------------------
										if(input.Entry_By == "Gate Pass" && input.Gate_Pass != null)
										{
											gp = null;
											for each  g in Gate_Pass[ID == input.Gate_Pass.ID]
											{
												gp = g;
												break;
											}
											if(gp != null && gp.Gate_Pass_Status != "Used")
											{
												gp.Gate_Pass_Status="Used";
											}
										}
						)
					}
				}

			}
