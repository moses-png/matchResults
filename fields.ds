			On_Customer_Selected as "On Customer Selected"
			{
				type =  form
				form = Payment_Received

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											// PAYMENT RECEIVED → ON CUSTOMER SELECTED
										if(input.Customer == null)
										{
											// Clear dependent fields
											input.Display_Name_Customer = null;
											input.Credit_Note = null;
											input.Delivery_Note = null;
											return;
										}
										// 1️⃣ Display Name Customer
										input.Display_Name_Customer = input.Customer.Display_Name_Customer;
										// 2️⃣ Reset dependent references when customer changes
										input.Credit_Note = null;
										input.Delivery_Note = null;
										// 3️⃣ Enforce customer rules
										// Credit allowed?
										if(input.Customer.Credit_is_Allowed != true)
										{
											// Prevent credit usage
											if(input.Payment_Type == "Credit")
											{
												alert "This customer is NOT allowed to use credit.";
												input.Payment_Type = null;
											}
										}
										// Delivery Note required?
										if(input.Customer.Delivery_Note_Required == true)
										{
											show Delivery_Note;
										}
										else
										{
											hide Delivery_Note;
											input.Delivery_Note = null;
										}
										// Credit Note required?
										if(input.Customer.Credit_Note_Required == true)
										{
											show Credit_Note;
										}
										else
										{
											hide Credit_Note;
											input.Credit_Note = null;
										}
						)
					}
				}

			}
			On_Card_Selected1 as "On Card Selected"
			{
				type =  form
				form = Payment_Received

				record event = on add or edit

				on user input of Card
				{
					actions 
					{
						custom deluge script
						(
											if(input.Card == null)
										{
											// -------------------------
											// Clear card + customer
											// -------------------------
											input.Display_Name_Card = null;
											input.Customer = null;
											input.Display_Name_Customer = null;
											// -------------------------
											// Clear docs
											// -------------------------
											input.Delivery_Note = null;
											input.Credit_Note = null;
											// -------------------------
											// Clear payment amounts
											// -------------------------
											input.Amount_Due = null;
											input.Amount_Received = null;
											input.Amount_Credited = 0.0;
											input.Amount = null;
											input.Balance_Due = null;
											// -------------------------
											// Clear payment meta
											// -------------------------
											input.Transaction_ID = null;
											input.Account = null;
											input.Payment_Type = null;
											input.Payment_Date = null;
											// Hide doc fields by default (optional)
											hide Delivery_Note;
											hide Credit_Note;
											// Hide mobile money fields by default (optional)
											hide Transaction_ID;
											hide Account;
											return;
										}
										// -------------------------------------------------
										// 1) Display Name Card (from Sales Voucher / Card)
										// -------------------------------------------------
										input.Display_Name_Card = input.Card.Card_Number;
										// -------------------------------------------------
										// 2) Pull Customer from Card
										// -------------------------------------------------
										if(input.Card.Customer != null)
										{
											input.Customer = input.Card.Customer;
											input.Display_Name_Customer = input.Customer.Display_Name_Customer;
										}
										else
										{
											input.Customer = null;
											input.Display_Name_Customer = null;
											// If no customer, we can’t enforce customer rules
											hide Delivery_Note;
											hide Credit_Note;
											// Still compute amounts (optional) and exit
										}
										// -------------------------------------------------
										// 3) Reset dependent docs whenever card changes
										// -------------------------------------------------
										input.Delivery_Note = null;
										input.Credit_Note = null;
										// -------------------------------------------------
										// 4) Enforce Customer Rules (flags are on CUSTOMER)
										// Credit_is_Allowed, Purchase_Order_Required,
										// Delivery_Note_Required, Credit_Note_Required
										// -------------------------------------------------
										if(input.Customer != null)
										{
											creditAllowed = ifnull(input.Customer.Credit_is_Allowed,false);
											dnRequired = ifnull(input.Customer.Delivery_Note_Required,false);
											cnRequired = ifnull(input.Customer.Credit_Note_Required,false);
											// 4A) Credit allowed?
											if(creditAllowed != true && input.Payment_Type == "Credit")
											{
												alert "This customer is NOT allowed to use credit.";
												input.Payment_Type = null;
											}
											// 4C) Delivery Note required?
											if(dnRequired == true)
											{
												show Delivery_Note;
											}
											else
											{
												hide Delivery_Note;
												input.Delivery_Note = null;
											}
											// 4D) Credit Note required?
											if(cnRequired == true)
											{
												show Credit_Note;
											}
											else
											{
												hide Credit_Note;
												input.Credit_Note = null;
											}
										}
										// (These rules are exactly what the document applies under “On Customer Selected”.)【turn1file12†L21-L67】
										// -------------------------------------------------
										// 5) Compute Amount Due from Card (Sales Voucher)
										// Prefer Balance_Due if present; else Amount_To_Pay - Amount_Paid
										// -------------------------------------------------
										due = 0.0;
										if(input.Card.Balance_Due != null)
										{
											due = input.Card.Balance_Due;
										}
										else
										{
											amtToPay = ifnull(input.Card.Amount_To_Pay,0.0);
											amtPaid = ifnull(input.Card.Amount_Paid,0.0);
											due = amtToPay - amtPaid;
										}
										// Clamp negative
										if(due < 0)
										{
											due = 0.0;
										}
										// -------------------------------------------------
										// 6) Set Amount Due + initialize Balance Due
										// -------------------------------------------------
										input.Amount_Due = due;
										input.Balance_Due = due;
										// Optional warning
										if(due == 0)
										{
											alert "This card is already fully paid (Balance Due is 0).";
										}
						)
					}
				}

			}
			On_Payment_Type_Selected as "On Payment Type  Selected"
			{
				type =  form
				form = Payment_Received

				record event = on add or edit

				on user input of Payment_Type
				{
					actions 
					{
						custom deluge script
						(
											pt = ifnull(input.Payment_Type,"").trim();
										amtDue = ifnull(input.Amount_Due,0.0);
										// =====================================================
										// BLANK PAYMENT TYPE
										// =====================================================
										if(pt == "")
										{
											input.Amount = null;
											input.Amount_Received = 0.0;
											input.Amount_Credited = 0.0;
											show Amount;
											hide Amount_Credited;
											hide Account;
											hide Transaction_ID;
											hide Cash_Envelope;
											input.Balance_Due = amtDue;
											return;
										}
										// =====================================================
										// CREDIT
										// =====================================================
										if(pt == "Credit")
										{
											input.Amount = null;
											input.Amount_Received = 0.0;
											input.Amount_Credited = amtDue;
											hide Amount;
											show Amount_Credited;
											hide Account;
											hide Transaction_ID;
											hide Cash_Envelope;
											input.Balance_Due = amtDue - ifnull(input.Amount_Credited,0.0);
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0.0;
											}
											return;
										}
										// =====================================================
										// MOBILE MONEY
										// =====================================================
										if(pt == "Mobile Money")
										{
											show Amount;
											hide Amount_Credited;
											hide Cash_Envelope;
											show Account;
											show Transaction_ID;
											input.Amount_Credited = 0.0;
											if(input.Amount == null || ifnull(input.Amount,0.0) == 0.0)
											{
												input.Amount_Received = 0.0;
												input.Balance_Due = amtDue;
												return;
											}
											amt = ifnull(input.Amount,0.0);
											input.Amount_Received = amt;
											input.Balance_Due = amtDue - ifnull(input.Amount_Received,0.0);
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0.0;
											}
											return;
										}
										// =====================================================
										// CASH
										// =====================================================
										if(pt == "Cash")
										{
											show Amount;
											hide Amount_Credited;
											hide Account;
											hide Transaction_ID;
											show Cash_Envelope;
											if(input.Cashier_Envelope != null)
											{
												emp_name = input.Cashier_Envelope.Display_Name_Employee;
												acc_id = payment_management.account.getCashAccountByEmployee(emp_name);
												if(acc_id != "")
												{
													input.Account = acc_id.toLong();
												}
												else
												{
													alert "No cash account found for: " + emp_name;
													input.Account = null;
												}
											}
											else
											{
												input.Account = null;
											}
											input.Amount_Credited = 0.0;
											if(input.Amount == null || ifnull(input.Amount,0.0) == 0.0)
											{
												input.Amount_Received = 0.0;
												input.Balance_Due = amtDue;
												return;
											}
											amt = ifnull(input.Amount,0.0);
											input.Amount_Received = amt;
											input.Balance_Due = amtDue - ifnull(input.Amount_Received,0.0);
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0.0;
											}
											return;
										}
						)
					}
				}

			}
			On_Amount_Selected as "On Amount Selected"
			{
				type =  form
				form = Payment_Received

				record event = on add or edit

				on user input of Amount
				{
					actions 
					{
						custom deluge script
						(
											// PAYMENT RECEIVED → ON AMOUNT SELECTED
										pt = ifnull(input.Payment_Type,"").trim();
										amtDue = ifnull(input.Amount_Due,0.0);
										amt = ifnull(input.Amount,0.0);
										// Safety: Amount cannot be negative
										if(amt < 0)
										{
											alert "Amount cannot be negative.";
											input.Amount = null;
											return;
										}
										// CASH / MOBILE MONEY: Amount drives Amount Received
										if(pt == "Cash" || pt == "Mobile Money")
										{
											input.Amount_Received = amt;
											// If you keep a credit field, ensure it's not accidentally left
											if(input.Amount_Credited == null)
											{
												input.Amount_Credited = 0.0;
											}
											input.Balance_Due = amtDue - (ifnull(input.Amount_Received,0.0) + ifnull(input.Amount_Credited,0.0));
										}
										// CREDIT: Amount should not be used (credit uses Amount Credited)
										else if(pt == "Credit")
										{
											// Keep it clean: Amount is not applicable under Credit
											input.Amount = 0.0;
											// If your Credit rule is “Amount Credited = Amount Due”
											if(input.Amount_Credited == null || input.Amount_Credited == 0)
											{
												input.Amount_Credited = amtDue;
											}
											// Usually credit means no cash received
											input.Amount_Received = 0.0;
											input.Balance_Due = amtDue - (ifnull(input.Amount_Received,0.0) + ifnull(input.Amount_Credited,0.0));
										}
										else
										{
											// If payment type is blank/other, still recalc safely
											input.Balance_Due = amtDue - (ifnull(input.Amount_Received,0.0) + ifnull(input.Amount_Credited,0.0));
										}
										// Clamp
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0.0;
										}
						)
					}
				}

			}
			Finalize7 as "Finalize"
			{
				type =  form
				form = Payment_Received

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ================================
										// PAYMENT RECEIVED → FINALIZE
										// (On Success)
										// ================================
										// 0) Get saved Payment Received
										pr = Payment_Received[ID == input.ID];
										if(pr == null)
										{
											return;
										}
										// 0.1) Ensure Payment Date
										if(pr.Payment_Date == null)
										{
											pr.Payment_Date=zoho.currenttime;
										}
										// 1) Normalize payment values
										pt = ifnull(pr.Payment_Type,"").trim();
										amtDue = ifnull(pr.Amount_Due,0.0);
										if(pt == "Credit")
										{
											pr.Amount_Credited=amtDue;
											pr.Amount_Received=0.0;
											pr.Amount=0.0;
											pr.Balance_Due=0.0;
										}
										else
										{
											if(pr.Amount_Credited == null)
											{
												pr.Amount_Credited=0.0;
											}
										}
										// 2) Update Credit Note
										if(pr.Credit_Note != null)
										{
											cn = Credit_Note[ID == pr.Credit_Note.ID];
											if(cn != null)
											{
												if(pr.Cashier_Envelope != null)
												{
													cn.Cashier_Envelope=pr.Cashier_Envelope;
												}
												cn.Credit_Note_Status="Credited";
											}
										}
										// 3) Update Delivery Note
										if(pr.Delivery_Note != null)
										{
											dn = Delivery_Note[ID == pr.Delivery_Note.ID];
											if(dn != null)
											{
												if(pr.Cashier_Envelope != null)
												{
													dn.Cashier_Envelope=pr.Cashier_Envelope;
												}
												dn.Delivery_Note_Status="Delivered";
											}
										}
										// 4) Update Sales Voucher
										if(pr.Card != null)
										{
											sv = Sales_Voucher[ID == pr.Card.ID];
											if(sv != null)
											{
												total_cash = 0.0;
												total_credit = 0.0;
												pays = Payment_Received[Card == sv];
												for each  p in pays
												{
													total_cash = total_cash + ifnull(p.Amount_Received,0.0);
													total_credit = total_credit + ifnull(p.Amount_Credited,0.0);
												}
												total_settled = total_cash + total_credit;
												sv.Amount_Paid=total_cash;
												sv.Amount_Credited=total_credit;
												amt_to_pay = ifnull(sv.Amount_To_Pay,0.0);
												bal = amt_to_pay - total_settled;
												if(bal < 0)
												{
													bal = 0.0;
												}
												sv.Balance_Due=bal;
												if(bal <= 0)
												{
													sv.Sales_Voucher_Status="Security Guard In";
												}
												if(total_settled <= 0)
												{
													sv.Payment_Status="Unpaid";
												}
												else if(total_cash <= 0 && total_credit > 0 && bal <= 0)
												{
													sv.Payment_Status="Credit";
												}
												else if(bal > 0)
												{
													sv.Payment_Status="Partially Paid";
												}
												else
												{
													sv.Payment_Status="Paid";
												}
												tCashier = ifnull(pr.Payment_Date,zoho.currenttime);
												sv.Time_Cashier=tCashier;
												if(sv.Time_Receipt != null && sv.Time_Cashier != null)
												{
													diffMillis = sv.Time_Cashier.toLong() - sv.Time_Receipt.toLong();
													sv.Minutes_Used_Cashier=diffMillis / 60000.0;
												}
											}
										}
										// 5) Update Cashier Paper totals
										if(pr.Cashier_Paper != null)
										{
											cp = Cashier_Paper[ID == pr.Cashier_Paper.ID];
											if(cp != null)
											{
												cash_total = 0.0;
												other_total = 0.0;
												pays_cp = Payment_Received[Cashier_Paper == cp.ID];
												for each  pr2 in pays_cp
												{
													pt2 = ifnull(pr2.Payment_Type,"").trim();
													amt_rec = ifnull(pr2.Amount_Received,0.0);
													amt_cred = ifnull(pr2.Amount_Credited,0.0);
													if(pt2 == "Cash")
													{
														cash_total = cash_total + amt_rec;
													}
													else if(pt2 == "Mobile Money")
													{
														other_total = other_total + amt_rec;
													}
													else if(pt2 == "Credit")
													{
														other_total = other_total + amt_cred;
													}
													else
													{
														other_total = other_total + amt_rec + amt_cred;
													}
												}
												cp.Cash_Total=cash_total;
												cp.Other_Total=other_total;
											}
										}
										// 6) Update Cash Envelope totals
										if(pr.Cash_Envelope != null)
										{
											ce = Cash_Envelope[ID == pr.Cash_Envelope.ID];
											if(ce != null)
											{
												env_total = 0.0;
												pays_env = Payment_Received[Cash_Envelope == ce.ID];
												for each  pr3 in pays_env
												{
													if(ifnull(pr3.Payment_Type,"").trim() == "Cash")
													{
														env_total = env_total + ifnull(pr3.Amount_Received,0.0);
													}
												}
												ce.Cash_Envelope_Total=env_total;
											}
										}
										// 7) Sync to Payment Management Cash Receipt
										if(pt == "Credit")
										{
											info "Credit payment. No Cash Receipt created.";
											return;
										}
										payload = Map();
										receipt_ref = "";
										description_text = "";
										account_receiving_id = null;
										if(pt == "Mobile Money")
										{
											receipt_ref = ifnull(pr.Transaction_ID,"").trim();
											description_text = "Mobile Money";
											account_receiving_id = pr.Account;
										}
										else if(pt == "Cash")
										{
											if(pr.Cash_Envelope != null)
											{
												receipt_ref = pr.Cash_Envelope.Cash_Envelope_Number;
											}
											description_text = "Cashier Envelope";
											account_receiving_id = pr.Account;
										}
										payload.put("payment_received_id",pr.ID);
										payload.put("payment_type",pt);
										payload.put("amount_received",ifnull(pr.Amount_Received,0.0));
										payload.put("receipt_ref",receipt_ref);
										payload.put("account_receiving_id",account_receiving_id);
										payload.put("payment_date",ifnull(pr.Payment_Date,zoho.currentdate));
										payload.put("description",description_text);
										payload.put("sales_voucher_id",pr.Card);
										payload.put("invoice_number",ifnull(pr.Display_Name_Card,""));
										payload.put("amount_due",ifnull(pr.Amount_Due,0.0));
										payload.put("display_name_site",ifnull(pr.Display_Name_Site,""));
										resp = payment_management.cashreceipt.create_cash_receipt_from_payment_received(payload);
										if(resp != null && resp.get("ok") == true)
										{
											pr.Cash_Receipt_Voucher=resp.get("cash_receipt_voucher_id");
											pr.Cash_Receipt_Details=resp.get("cash_receipt_details_id");
										}
										else
										{
											info "Cash Receipt sync failed: " + ifnull(resp.get("msg"),"unknown error");
										}
										// 8) Sync to Payment Management Group Expenses
										grp_payload = Map();
										site_name = ifnull(pr.Display_Name_Site,"");
										sales_type = "";
										if(pr.Card != null)
										{
											sales_type = ifnull(pr.Card.Sales_Type,"");
										}
										pay_date = ifnull(pr.Payment_Date.toDate(),zoho.currentdate);
										// Recalculate total actually received from ALL Payment Received records
										// 8) Sync to Payment Management Group Expenses
										if(pt != "Credit")
										{
											grp_payload = Map();
											site_name = ifnull(pr.Display_Name_Site,"");
											sales_type = "";
											if(pr.Card != null)
											{
												sales_type = ifnull(pr.Card.Sales_Type,"");
											}
											pay_date = ifnull(pr.Payment_Date.toDate(),zoho.currentdate);
											// Recalculate total actually received from ALL Payment Received records
											total_actual_received = 0.0;
											all_payments = Payment_Received[Display_Name_Site == site_name];
											for each  pay in all_payments
											{
												pay_sales_type = "";
												if(pay.Card != null)
												{
													pay_sales_type = ifnull(pay.Card.Sales_Type,"");
												}
												if(pay.Payment_Date != null && pay.Payment_Date.toDate() == pay_date && pay_sales_type == sales_type && ifnull(pay.Payment_Type,"").trim() != "Credit")
												{
													total_actual_received = total_actual_received + ifnull(pay.Amount_Received,0.0) * 10000;
												}
											}
											grp_payload.put("display_name_site",site_name);
											grp_payload.put("payment_date",pay_date);
											grp_payload.put("sales_type",sales_type);
											grp_payload.put("amount_actual_received",total_actual_received);
											grp_payload.put("payment_received_id",pr.ID);
											grp_resp = payment_management.group.update_group_income_from_payment_received(grp_payload);
											if(grp_resp == null || grp_resp.get("ok") != true)
											{
												info "Group Expenses sync failed: " + ifnull(grp_resp.get("msg"),"unknown error");
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete1 as "Finalize On Delete"
			{
				type =  form
				form = Payment_Received

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// PAYMENT RECEIVED → REVERSE ON DELETE
										// (On Delete)  ✅ Uses Old_* IDs
										// ======================================
										svId = input.Old_Card_ID;
										cpId = input.Old_Cashier_Paper_ID;
										ceId = input.Old_Cash_Envelope_ID;
										// -------------------------------------------------
										// 1) SALES VOUCHER RECALC
										// -------------------------------------------------
										if(svId != null)
										{
											sv = Sales_Voucher[ID == svId];
											if(sv != null)
											{
												total_cash = 0.0;
												total_credit = 0.0;
												pays = Payment_Received[Card == sv];
												for each  p in pays
												{
													total_cash = total_cash + ifnull(p.Amount_Received,0.0);
													total_credit = total_credit + ifnull(p.Amount_Credited,0.0);
												}
												total_settled = total_cash + total_credit;
												sv.Amount_Paid=total_cash;
												sv.Amount_Credited=total_credit;
												amt_to_pay = ifnull(sv.Amount_To_Pay,0.0);
												bal = amt_to_pay - total_settled;
												if(bal < 0)
												{
													bal = 0.0;
												}
												sv.Balance_Due=bal;
												if(total_settled <= 0)
												{
													sv.Payment_Status="Unpaid";
												}
												else if(total_cash <= 0 && total_credit > 0 && bal <= 0)
												{
													sv.Payment_Status="Credit";
												}
												else if(bal > 0)
												{
													sv.Payment_Status="Partially Paid";
												}
												else
												{
													sv.Payment_Status="Paid";
												}
											}
										}
										// -------------------------------------------------
										// 2) CASHIER PAPER TOTALS (Cash vs Other)
										// -------------------------------------------------
										if(cpId != null)
										{
											cp = Cashier_Paper[ID == cpId];
											if(cp != null)
											{
												cash_total = 0.0;
												other_total = 0.0;
												pays_cp = Payment_Received[Cashier_Paper == cp.ID];
												for each  pr2 in pays_cp
												{
													pt2 = ifnull(pr2.Payment_Type,"").trim();
													amt_rec = ifnull(pr2.Amount_Received,0.0);
													amt_cred = ifnull(pr2.Amount_Credited,0.0);
													if(pt2 == "Cash")
													{
														cash_total = cash_total + amt_rec;
													}
													else if(pt2 == "Mobile Money")
													{
														other_total = other_total + amt_rec;
													}
													else if(pt2 == "Credit")
													{
														other_total = other_total + amt_cred;
													}
													else
													{
														other_total = other_total + amt_rec + amt_cred;
													}
												}
												cp.Cash_Total=cash_total;
												cp.Other_Total=other_total;
											}
										}
										// -------------------------------------------------
										// 3) CASH ENVELOPE TOTAL (Cash only)
										// -------------------------------------------------
										if(ceId != null)
										{
											ce = Cash_Envelope[ID == ceId];
											if(ce != null)
											{
												env_total = 0.0;
												pays_env = Payment_Received[Cash_Envelope == ce.ID];
												for each  pr3 in pays_env
												{
													if(ifnull(pr3.Payment_Type,"").trim() == "Cash")
													{
														env_total = env_total + ifnull(pr3.Amount_Received,0.0);
													}
												}
												ce.Cash_Envelope_Total=env_total;
											}
										}
										// -------------------------------------------------
										// 4) GROUP EXPENSES ACTUAL RECEIVED RECALC
										// -------------------------------------------------
										pt_deleted = ifnull(input.Payment_Type,"").trim();
										if(pt_deleted != "Credit")
										{
											site_name = ifnull(input.Display_Name_Site,"");
											sales_type = "";
											pay_date = zoho.currentdate;
											if(input.Payment_Date != null)
											{
												pay_date = input.Payment_Date.toDate();
											}
											if(svId != null)
											{
												sv_for_group = Sales_Voucher[ID == svId];
												if(sv_for_group.ID != null)
												{
													sales_type = ifnull(sv_for_group.Sales_Type,"");
													if(site_name == "")
													{
														site_name = ifnull(sv_for_group.Display_Name_Site,"");
													}
												}
											}
											total_actual_received = 0.0;
											all_payments = Payment_Received[Display_Name_Site == site_name];
											for each  pay in all_payments
											{
												pay_sales_type = "";
												if(pay.Card != null)
												{
													pay_sales_type = ifnull(pay.Card.Sales_Type,"");
												}
												if(pay.Payment_Date != null && pay.Payment_Date.toDate() == pay_date && pay_sales_type == sales_type && ifnull(pay.Payment_Type,"").trim() != "Credit")
												{
													total_actual_received = total_actual_received + ifnull(pay.Amount_Received,0.0) * 10000;
												}
											}
											grp_payload = Map();
											grp_payload.put("display_name_site",site_name);
											grp_payload.put("payment_date",pay_date);
											grp_payload.put("sales_type",sales_type);
											grp_payload.put("amount_actual_received",total_actual_received);
											grp_payload.put("payment_received_id",input.ID);
											grp_resp = payment_management.group.update_group_income_from_payment_received(grp_payload);
											if(grp_resp == null || grp_resp.get("ok") != true)
											{
												info "Group Expenses delete sync failed: " + ifnull(grp_resp.get("msg"),"unknown error");
											}
										}
						)
					}
				}

			}
			Full_Validation7 as "Full Validation"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										// --------------------------------------------------
										// 1) Credit Note Date
										// --------------------------------------------------
										if(input.Credit_Note_Date == null)
										{
											errors = errors + "\n- Credit Note Date is required.";
										}
										else if(input.Credit_Note_Date > zoho.currentdate)
										{
											errors = errors + "\n- Credit Note Date cannot be in the future.";
										}
										// --------------------------------------------------
										// 2) Credit Note Number
										// --------------------------------------------------
										if(input.Credit_Note_Number == null || input.Credit_Note_Number.trim() == "")
										{
											errors = errors + "\n- Credit Note Number is required.";
										}
										// --------------------------------------------------
										// 3) Receipt Officer Daily Voucher
										// --------------------------------------------------
										if(input.Receipt_Officer_Voucher == null)
										{
											errors = errors + "\n- Receipt Officer Daily Voucher is required.";
										}
										// --------------------------------------------------
										// 4) Confirmed By
										// --------------------------------------------------
										if(input.Confirmed_By == null)
										{
											errors = errors + "\n- Confirmed By is required.";
										}
										// --------------------------------------------------
										// 5) How have you confirmed
										// --------------------------------------------------
										if(input.How_have_you_confirmed == null || input.How_have_you_confirmed == "")
										{
											errors = errors + "\n- How you have confirmed is required.";
										}
										// --------------------------------------------------
										// 6) Number Plate + TSF Number (Auto-fill check)
										// --------------------------------------------------
										if(input.Number_Plate == null)
										{
											errors = errors + "\n- Number Plate is required.";
										}
										else
										{
											// TSF_Number should always match the selected Number Plate
											expected_tsf = input.Number_Plate.TSF_Number;
											if(input.TSF_Number == null || input.TSF_Number.trim() == "")
											{
												errors = errors + "\n- TSF Number is missing. Re-select the Number Plate.";
											}
											else if(expected_tsf != null && input.TSF_Number.trim() != expected_tsf.trim())
											{
												errors = errors + "\n- TSF Number does not match the selected Number Plate.";
											}
										}
										// --------------------------------------------------
										// FINAL GATE
										// --------------------------------------------------
										if(errors != "")
										{
											alert "Please fix the following before submitting:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize6 as "Finalize"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// SALES VOUCHER -> ON SUBMIT / FINALIZE
										// ======================================
										// 1) AUTO-FILL TIME RECEIPT
										if(input.Time_Receipt == null)
										{
											input.Time_Receipt = zoho.currenttime;
										}
										// 2) PREPARE REUSABLE VALUES
										date_picked_text = "";
										if(input.Time_Receipt != null)
										{
											date_picked_text = input.Time_Receipt.toDate().toString("dd-MMM-yyyy");
										}
										delivery_note_val = "";
										if(input.Delivery_Note != null && input.Delivery_Note.Delivery_Note_Number != null)
										{
											delivery_note_val = input.Delivery_Note.Delivery_Note_Number;
										}
										credit_note_val = "";
										if(input.Credit_Note != null && input.Credit_Note.Credit_Note_Number != null)
										{
											credit_note_val = input.Credit_Note.Credit_Note_Number;
										}
										purchase_order_val = "";
										if(input.Delivery_Note != null && input.Delivery_Note.Purchase_Order != null)
										{
											if(input.Delivery_Note.Purchase_Order.Purchase_Order_Number != null)
											{
												purchase_order_val = input.Delivery_Note.Purchase_Order.Purchase_Order_Number;
											}
										}
										customer_val = "";
										if(input.Customer != null && input.Customer.Display_Name_Customer != null)
										{
											customer_val = input.Customer.Display_Name_Customer;
										}
										number_plate_val = "";
										if(input.Number_Plate != null)
										{
											if(input.Number_Plate.Number_Plate != null)
											{
												number_plate_val = input.Number_Plate.Number_Plate;
											}
											else
											{
												number_plate_val = input.Number_Plate.toString();
											}
										}
										// Build Details text
										details_val = "";
										if(date_picked_text != "")
										{
											details_val = details_val + "Date Picked: " + date_picked_text;
										}
										if(delivery_note_val != "")
										{
											if(details_val != "")
											{
												details_val = details_val + "\n";
											}
											details_val = details_val + "Delivery Note: " + delivery_note_val;
										}
										if(credit_note_val != "")
										{
											if(details_val != "")
											{
												details_val = details_val + "\n";
											}
											details_val = details_val + "Credit Note: " + credit_note_val;
										}
										if(purchase_order_val != "")
										{
											if(details_val != "")
											{
												details_val = details_val + "\n";
											}
											details_val = details_val + "Purchase Order: " + purchase_order_val;
										}
										if(customer_val != "")
										{
											if(details_val != "")
											{
												details_val = details_val + "\n";
											}
											details_val = details_val + "Customer: " + customer_val;
										}
										if(number_plate_val != "")
										{
											if(details_val != "")
											{
												details_val = details_val + "\n";
											}
											details_val = details_val + "Number Plate: " + number_plate_val;
										}
										// 3) CREDIT NOTE UPDATE
										if(input.Credit_Note != null)
										{
											credit_note_rec = Credit_Note[ID == input.Credit_Note];
											if(credit_note_rec.ID != null)
											{
												if(input.Customer != null)
												{
													credit_note_rec.Customer=input.Customer;
												}
												if(input.Number_Plate != null)
												{
													credit_note_rec.Number_Plate=input.Number_Plate;
													credit_note_rec.TSF_Number=input.Number_Plate.TSF_Number;
												}
												credit_note_rec.Credit_Note_Status="Issued";
											}
										}
										// 4) DELIVERY NOTE UPDATE
										if(input.Delivery_Note != null)
										{
											delivery_note_rec = Delivery_Note[ID == input.Delivery_Note];
											if(delivery_note_rec.ID != null)
											{
												if(input.Customer != null)
												{
													delivery_note_rec.Customer=input.Customer;
													delivery_note_rec.Display_Name_Customer=input.Customer.Display_Name_Customer;
												}
												if(input.Number_Plate != null)
												{
													delivery_note_rec.Number_Plate=input.Number_Plate;
													if(input.Number_Plate.Truck_Type != null)
													{
														delivery_note_rec.Truck_Type=input.Number_Plate.Truck_Type;
													}
												}
												delivery_note_rec.Delivery_Note_Status="Issued";
											}
										}
										// 5) RECALCULATE PARENT TOTALS
										sand_total = ifnull(input.Rate_per_CBM,0) * ifnull(input.Truck_CBM,0);
										item_total = 0;
										for each  r in input.Item_Sales
										{
											item_total = item_total + ifnull(r.Line_Total,0);
										}
										input.Amount_Supposed_To_Pay_Sand_Sales = round(sand_total,2);
										input.Amount_Supposed_To_Pay_Item_Sales = round(item_total,2);
										input.Amount_Supposed_To_Pay = round(sand_total + item_total,2);
										// 6) CREATE OR UPDATE INVOICE DETAILS
										if(input.Customer != null && customer_val != "Walk In Customers - 16")
										{
											card_no = ifnull(input.Card_Number,"").trim();
											site_val = "";
											if(input.Site != null)
											{
												if(input.Site.Display_Name_Asset_Name != null)
												{
													site_val = input.Site.Display_Name_Asset_Name;
												}
												else if(input.Site.Asset_Name != null)
												{
													site_val = input.Site.Asset_Name;
												}
											}
											if(card_no != "" && site_val != "")
											{
												// A) SAND SALES
												if(input.Sales_Type == "Sand Sales" || input.Sales_Type == "Sand & Item Sales")
												{
													truck_cbm_val = ifnull(input.Truck_CBM,0);
													amount_to_pay_val = ifnull(input.Amount_To_Pay,0);
													sand_qty = null;
													sand_rate = null;
													update_qty_rate = true;
													if(customer_val == "Mr Rodgers - 238" || customer_val == "Hamidu Ssenoga - 1")
													{
														sand_qty = 1;
														sand_rate = amount_to_pay_val * 10000;
													}
													else if(customer_val == "Mrsand - 20" || customer_val == "Grapes Trucks - 18")
													{
														update_qty_rate = false;
													}
													else
													{
														sand_qty = truck_cbm_val;
														sand_rate = null;
													}
													if(truck_cbm_val > 0)
													{
														existing_sand = Invoice_Details[Sales_Voucher == card_no && Item == "Sand Sales"];
														if(existing_sand.count() == 0)
														{
															insert into Invoice_Details
															[
																Sales_Voucher=card_no
																Item="Sand Sales"
																Details=details_val
																Quantity=sand_qty
																Rate=sand_rate
																Account=site_val
																Current_Site=site_val
																Added_User=zoho.loginuser
															]
														}
														else
														{
															for each  sand_row in existing_sand
															{
																sand_row.Item="Sand Sales";
																sand_row.Details=details_val;
																sand_row.Account=site_val;
																sand_row.Current_Site=site_val;
																if(update_qty_rate == true)
																{
																	sand_row.Quantity=sand_qty;
																	sand_row.Rate=sand_rate;
																}
																break;
															}
														}
													}
												}
												// B) ITEM SALES
												if(input.Sales_Type == "Item Sales" || input.Sales_Type == "Sand & Item Sales")
												{
													for each  row in input.Item_Sales
													{
														line_no = ifnull(row.Line_Number,0);
														qty_base = ifnull(row.Quantity_in_Base_Unit,0);
														item_val = "";
														if(row.Item != null)
														{
															if(row.Display_Name_Item != null && row.Display_Name_Item != "")
															{
																item_val = row.Display_Name_Item;
															}
															else if(row.Item.Item_Name != null)
															{
																item_val = row.Item.Item_Name;
															}
														}
														sales_voucher_line = card_no + " - " + line_no;
														if(line_no > 0 && qty_base > 0 && item_val != "")
														{
															existing_item = Invoice_Details[Sales_Voucher == sales_voucher_line];
															if(existing_item.count() == 0)
															{
																insert into Invoice_Details
																[
																	Sales_Voucher=sales_voucher_line
																	Item=item_val
																	Details=details_val
																	Account=site_val
																	Current_Site=site_val
																	Added_User=zoho.loginuser
																]
															}
															else
															{
																for each  item_row in existing_item
																{
																	item_row.Item=item_val;
																	item_row.Details=details_val;
																	item_row.Account=site_val;
																	item_row.Current_Site=site_val;
																	break;
																}
															}
														}
													}
												}
											}
										}
										// 7) SYNC TO PAYMENT MANAGEMENT GROUP EXPENSES
										grp_payload = Map();
										site_name = "";
										if(input.Site != null)
										{
											if(input.Site.Display_Name_Asset_Name != null)
											{
												site_name = input.Site.Display_Name_Asset_Name;
											}
											else if(input.Site.Asset_Name != null)
											{
												site_name = input.Site.Asset_Name;
											}
										}
										total_to_receive = 0.0;
										all_sales = Sales_Voucher[Display_Name_Site == site_name && Sales_Type == input.Sales_Type];
										for each  sv in all_sales
										{
											if(sv.Time_Receipt != null && sv.Time_Receipt.toDate() == input.Time_Receipt.toDate())
											{
												total_to_receive = total_to_receive + ifnull(sv.Amount_To_Pay,0.0) * 10000;
											}
										}
										grp_payload.put("display_name_site",site_name);
										grp_payload.put("sales_type",ifnull(input.Sales_Type,""));
										grp_payload.put("amount_to_receive",total_to_receive);
										grp_payload.put("sales_voucher_amount",ifnull(input.Amount_To_Pay,0.0));
										grp_payload.put("payment_date",ifnull(input.Time_Receipt.toDate(),zoho.currentdate));
										grp_payload.put("sales_voucher_id",input.ID);
										grp_resp = payment_management.group.update_group_expense_from_sales_voucher(grp_payload);
										if(grp_resp == null || grp_resp.get("ok") != true)
										{
											info "Group Expenses Sales sync failed: " + ifnull(grp_resp.get("msg"),"unknown error");
										}
						)
					}
				}

			}
			Set_up_Form12 as "Set up Form"
			{
				type =  form
				form = Payment_Received

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
