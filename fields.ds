				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Site
			(
				type = picklist	
				values  = asset_management.Asset_List[Allowed_Emails.Email == input.User_Email].ID
    			displayformat = [Asset_Name + " - " + Asset_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
