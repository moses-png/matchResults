			On_Labour_Selected as "On Labour Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Parts_Consumables.Labour
				{
					actions 
					{
						custom deluge script
						(
											// ===== LABOUR SELECTED: make row a Labour row, reset amounts =====
										if(row.Labour != null)
										{
											// Make it Labour-only
											row.Item=null;
											// Set display: Labour Name
											row.Display_Name_Item_Labour=row.Labour.Labour_Name;
											// Reset row amounts
											row.Quantity=null;
											row.Unit_Cost=null;
											row.Line_Total=null;
										}
										else
										{
											// If Labour cleared, clear display ONLY if Item is empty
											if(row.Item == null)
											{
												row.Display_Name_Item_Labour="";
											}
										}
										// ===== RECALCULATE TOTALS (build LIST(Map) for your functions) =====
										parts_rows = List();
										for each  r in input.Parts_Consumables
										{
											m = Map();
											m.put("Item",r.Item);
											m.put("Labour",r.Labour);
											m.put("Quantity",r.Quantity);
											m.put("Unit Cost",r.Unit_Cost);
											parts_rows.add(m);
										}
										input.Parts_Total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
										input.Labour_Total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Parts_Total,input.Labour_Total);
						)
					}
				}

			}
			On_Quantity_Selected3 as "On Quantity Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Parts_Consumables.Quantity
				{
					actions 
					{
						custom deluge script
						(
											// 1) Always update THIS row line total
										row.Line_Total=thisapp.asset_calc.asset_calc_line_total(row.Quantity,row.Unit_Cost);
										// 2) Parent totals: only if the parent record already exists (Edit mode)
										if(input.ID != null)
										{
											rec = Work_Order_Tasks[ID == input.ID];
											// Only proceed if record exists
											if(rec.count() > 0)
											{
												parts_rows = List();
												for each  r in rec.Parts_Consumables
												{
													m = Map();
													m.put("Item",r.Item);
													m.put("Labour",r.Labour);
													m.put("Quantity",r.Quantity);
													m.put("Unit Cost",r.Unit_Cost);
													parts_rows.add(m);
												}
												parts_total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
												labour_total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
												grand_total = thisapp.asset_calc.asset_calc_grand_total(parts_total,labour_total);
												rec.Parts_Total=parts_total;
												rec.Labour_Total=labour_total;
												rec.Grand_Total=grand_total;
											}
										}
						)
					}
				}

			}
			Finalize10 as "Finalize"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// FINALIZATION DEFAULT VALUES
										// =====================================================
										if(input.Tax_Amount == null)
										{
											input.Tax_Amount = 0.0;
										}
										if(input.Amount_Paid == null)
										{
											input.Amount_Paid = 0.0;
										}
										input.Grand_Total = round(ifnull(input.Sub_Total,0.0) + ifnull(input.Tax_Amount,0.0) - ifnull(input.Discount_Amount,0.0),2);
										if(input.Grand_Total < 0)
										{
											input.Grand_Total = 0.0;
										}
										input.Balance_Due = round(ifnull(input.Grand_Total,0.0) - ifnull(input.Amount_Paid,0.0),2);
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0.0;
										}
										// =====================================================
										// CREATE PRODUCTION DETAILS
										// =====================================================
										for each  shoeRow in input.Shoe_Services
										{
											if(shoeRow.Line_Number == null)
											{
												continue;
											}
											existing = Production_Details[Sales_Voucher == shoeRow.ID];
											if(existing.ID != null)
											{
												continue;
											}
											tasksText = "";
											if(shoeRow.Service != null)
											{
												taskList = Tasks_Needed[Service == shoeRow.Service] sort by Order_Task;
												for each  t in taskList
												{
													if(t.Task != null)
													{
														taskName = ifnull(t.Task.Task_Name,"");
														if(taskName != "")
														{
															if(tasksText == "")
															{
																tasksText = taskName;
															}
															else
															{
																tasksText = tasksText + "\n" + taskName;
															}
														}
													}
												}
											}
											insert into Production_Details
											[
												Sales_Voucher=shoeRow.ID
												Tracking_Number=input.Sales_Voucher_Number
												Line_Number=shoeRow.Line_Number
												Shoe_Type=shoeRow.Shoe_Type
												Brand=shoeRow.Brand
												Color=shoeRow.Color
												Service=shoeRow.Service
												Storage_Container=shoeRow.Storage_Container
												Tasks_To_Be_Done=tasksText
												In_Store_Stage="Received"
												Added_User=zoho.loginuser
											]
										}
										// =====================================================
										// UPDATE CUSTOMER PERFORMANCE
										// =====================================================
										if(input.Customer != null)
										{
											thisapp.customer.update_customer_performance(input.Customer.ID);
										}
						)
					}
				}

			}
			On_In_Store_Stage_Selecte as "On In Store Stage Selected"
			{
				type =  form
				form = Production_Details

				record event = on add or edit

				on user input of In_Store_Stage
				{
					actions 
					{
						custom deluge script
						(
											if(input.In_Store_Stage == "Received")
										{
											show Ready_Section;
											show Job_Card;
											show Ready_Started_Photos;
										}
										else if(input.In_Store_Stage == "In Progress")
										{
											show Ready_Section;
											show Job_Card;
											show Ready_Ended_Photos;
											disable Job_Card;
										}
										else if(input.In_Store_Stage == "Picked")
										{
											show Ready_Section;
											show Job_Card;
											show Ready_Started_Photos;
											show Ready_Started;
											show Ready_Ended_Photos;
											show Ready_Ended;
											disable Job_Card;
											disable Ready_Started_Photos;
											disable Ready_Started;
											disable Ready_Ended_Photos;
											disable Ready_Ended;
										}
						)
					}
				}

			}
			Set_Up_Form8 as "Set Up Form"
			{
				type =  form
				form = Production_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// DISABLE PRODUCTION INFORMATION
										// =====================================================
										disable Tracking_Number;
										disable Line_Number;
										disable Tasks_To_Be_Done;
										disable Shoe_Type;
										disable Color;
										disable Brand;
										disable Service;
										disable Storage_Container;
										disable In_Store_Stage;
										//hide Customer;
										hide Display_Name_Job_Card;
										hide Ready_Section;
										hide Job_Card;
										hide Ready_Started_Photos;
										hide Ready_Started;
										hide Ready_Ended_Photos;
										hide Ready_Ended;
										if(input.In_Store_Stage == "Received")
										{
											show Ready_Section;
											show Job_Card;
											show Ready_Started_Photos;
										}
										else if(input.In_Store_Stage == "In Progress")
										{
											show Ready_Section;
											show Job_Card;
											show Ready_Ended_Photos;
											disable Job_Card;
										}
										else if(input.In_Store_Stage == "Picked")
										{
											show Ready_Section;
											show Job_Card;
											show Ready_Started_Photos;
											show Ready_Started;
											show Ready_Ended_Photos;
											show Ready_Ended;
											disable Job_Card;
											disable Ready_Started_Photos;
											disable Ready_Started;
											disable Ready_Ended_Photos;
											disable Ready_Ended;
										}
										hide Back_End;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			Finalize11 as "Finalize"
			{
				type =  form
				form = Production_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PRODUCTION DETAILS FINALIZE
										// =====================================================
										shoe_service_rec = Shoe_Services[Display_Name_Sales_Voucher == input.Tracking_Number && Line_Number == input.Line_Number];
										// =====================================================
										// SYNC SHOE SERVICE STAGE
										// =====================================================
										if(shoe_service_rec.ID != null)
										{
											shoe_service_rec.In_Store_Stage=input.In_Store_Stage;
										}
										// =====================================================
										// REFRESH JOB CARD SHOES WORKED ON
										// =====================================================
										if(input.Job_Card != null)
										{
											thisapp.production.updateJobCardShoesWorkedOn(input.Job_Card.ID);
										}
						)
					}
				}

			}
			Full_Validation4 as "Full Validation"
			{
				type =  form
				form = Production_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// RECEIVED -> IN PROGRESS
										// =====================================================
										if(input.In_Store_Stage == "Received")
										{
											if(input.Job_Card == null)
											{
												alert "Please select the Job Card.";
												cancel submit;
											}
											if(input.Ready_Started_Photos == null || input.Ready_Started_Photos.isEmpty())
											{
												alert "Please upload the Ready Started Photos.";
												cancel submit;
											}
											if(input.Ready_Started == null)
											{
												input.Ready_Started = zoho.currenttime;
											}
											input.In_Store_Stage = "In Progress";
										}
										// =====================================================
										// IN PROGRESS -> READY
										// =====================================================
										else if(input.In_Store_Stage == "In Progress")
										{
											if(input.Job_Card == null)
											{
												alert "Job Card is required.";
												cancel submit;
											}
											if(input.Ready_Started == null)
											{
												alert "Ready Started time is missing.";
												cancel submit;
											}
											if(input.Ready_Started_Photos == null || input.Ready_Started_Photos.isEmpty())
											{
												alert "Ready Started Photos are required.";
												cancel submit;
											}
											if(input.Ready_Ended_Photos == null || input.Ready_Ended_Photos.isEmpty())
											{
												alert "Please upload the Ready Ended Photos.";
												cancel submit;
											}
											if(input.Ready_Ended == null)
											{
												input.Ready_Ended = zoho.currenttime;
											}
											input.In_Store_Stage = "Ready";
										}
										// =====================================================
										// READY
										// Do NOT automatically move to Picked here
										// =====================================================
										else if(input.In_Store_Stage == "Ready")
										{
											if(input.Job_Card == null)
											{
												alert "Job Card is required.";
												cancel submit;
											}
											if(input.Ready_Started == null)
											{
												alert "Ready Started time is required.";
												cancel submit;
											}
											if(input.Ready_Ended == null)
											{
												alert "Ready Ended time is required.";
												cancel submit;
											}
											if(input.Ready_Started_Photos == null || input.Ready_Started_Photos.isEmpty())
											{
												alert "Ready Started Photos are required.";
												cancel submit;
											}
											if(input.Ready_Ended_Photos == null || input.Ready_Ended_Photos.isEmpty())
											{
												alert "Ready Ended Photos are required.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			On_Voucher_Selected1 as "On Voucher Selected"
			{
				type =  form
				form = Job_Card

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// VOUCHER — ON USER INPUT
										// =====================================================
										if(input.Voucher != null)
										{
											input.Display_Name_Voucher = ifnull(input.Voucher.Voucher_Number,"");
											input.Display_Name_Employee = ifnull(input.Voucher.Display_Name_Employee,"");
										}
										else
										{
											input.Display_Name_Voucher = "";
											input.Display_Name_Employee = "";
										}
						)
					}
				}

			}
			Finalize_On_Create34 as "Finalize On Create"
			{
				type =  form
				form = Labour

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
						)
					}
				}

			}
			Finalize_On_Edit34 as "Finalize On Edit"
			{
				type =  form
				form = Labour

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Updated_By_Name = u.get("name");
										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
						)
					}
				}

			}
			Set_Up_Form35 as "Set Up Form"
			{
				type =  form
				form = Labour

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// BACK END
										// =====================================================
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// Logged-in user
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			On_Job_Card_Selected as "On Job Card Selected"
			{
				type =  form
				form = Production_Details

				record event = on add or edit

				on user input of Job_Card
				{
					actions 
					{
						custom deluge script
						(
											if(input.Job_Card != null)
										{
											input.Display_Name_Job_Card = ifnull(input.Job_Card.Display_Name_Voucher,"") + " - " + ifnull(input.Job_Card.Display_Name_Employee,"");
										}
										else
										{
											input.Display_Name_Job_Card = "";
										}
						)
					}
				}

			}
		}






