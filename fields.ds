			)
			Area
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Volume
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Odometer_Unit_Of_Measure
			(
				type = picklist
				displayname = "Odometer Unit Of Measure"
				maxchar = 100
				values = {"km","miles","hours","days","cubic meters","kiloliters","gallons","CT Ratio 20","CT Ratio 40","CT Ratio 80","CT Ratio 120","CT Ratio 150","kWh","Litres"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Odometer_Unit_Of_Measure
			(
    			type = text
				displayname = "Display Name Odometer Unit Of Measure"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Odometer_Reading
			(
				type = decimal
				displayname = "Odometer Reading"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_Time_Odometer_Read
			(
    			type = datetime
				displayname = "Date-Time Odometer Read"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Asset_Images
			(
    			type = image
				displayname = "Asset Images"
				source  = file
    			file count = 10
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			unique Serial_Number
			(
    			type = text
				displayname = "Serial Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Asset_Status
			(
				type = picklist
				displayname = "Asset Status"
				maxchar = 100
				values = {"Draft","Active","In Use","Idle","Under Maintenance","Retired","Disposed"}
				initial value = "Draft"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status_Change_Date
			(
    			type = date
				displayname = "Status Change Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Retirement_Date
			(
    			type = date
				displayname = "Retirement Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Disposal_Date
			(
    			type = date
				displayname = "Disposal Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Site
			(
    			type = text
				displayname = "Current Site"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Custodian
			(
    			type = text
				displayname = "Current Custodian"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Last_Transfer_Date
			(
    			type = date
				displayname = "Last Transfer Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Last_Transfer_Reference
