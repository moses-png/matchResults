			On_Voucher_Selected8 as "On Voucher Selected"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Voucher != null)
										{
											// 1) Display Name Voucher
											input.Display_Name_Voucher = input.Voucher.Voucher_Number;
											// 2) Display Name Employee
											empName = ifnull(input.Voucher.Employee.Employee_Name,"").trim();
											empNo = ifnull(input.Voucher.Employee.Employee_Number,"").toString().trim();
											if(empName != "" && empNo != "")
											{
												input.Display_Name_Employee = empName + " - " + empNo;
											}
											else if(empName != "")
											{
												input.Display_Name_Employee = empName;
											}
											else
											{
												input.Display_Name_Employee = null;
											}
											// 3) Display Name Site
											input.Display_Name_Site = input.Voucher.Display_Name_Site;
											// 4) Display Name Asset
											if(input.Voucher.Asset != null)
											{
												input.Display_Name_Asset = input.Voucher.Asset.Asset_Name + " - " + input.Voucher.Asset.Asset_ID;
											}
											else
											{
												input.Display_Name_Asset = null;
											}
											// 5) LINE NUMBER (AUTO INCREMENT PER VOUCHER)
											existing = Tractor_Work_Report[Voucher == input.Voucher];
											if(existing.count() > 0)
											{
												maxLine = 0;
												for each  rec in existing
												{
													if(rec.Line_Number != null && rec.Line_Number > maxLine)
													{
														maxLine = rec.Line_Number;
													}
												}
												input.Line_Number = maxLine + 1;
											}
											else
											{
												input.Line_Number = 1;
											}
										}
										else
										{
											input.Display_Name_Voucher = null;
											input.Display_Name_Employee = null;
											input.Display_Name_Site = null;
											input.Display_Name_Asset = null;
											input.Line_Number = null;
										}
						)
					}
				}

			}
			On_Work_Order_Task_Select3 as "On Work Order Task Selected"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on user input of Work_Order_Task
				{
					actions 
					{
						custom deluge script
						(
											if(input.Work_Order_Task != null)
										{
											taskNo = ifnull(input.Work_Order_Task.Work_Order_Task_Number,"").trim();
											taskDesc = ifnull(input.Work_Order_Task.Task_Description,"").trim();
											if(taskNo != "" && taskDesc != "")
											{
												input.Work_Done = taskNo + " - " + taskDesc;
											}
											else if(taskNo != "")
											{
												input.Work_Done = taskNo;
											}
											else if(taskDesc != "")
											{
												input.Work_Done = taskDesc;
											}
											else if(input.ID == null)
											{
												input.Work_Done = null;
											}
										}
										else
										{
											// Only clear Work Done on create, not edit
											if(input.ID == null)
											{
												input.Work_Done = null;
											}
										}
						)
					}
				}

			}
			Full_Validation22 as "Full Validation"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// DRAGER WORK REPORT -> FULL VALIDATION
										// ========================================
										errors = "";
										// SAFER CREATE CHECK
										if(input.ID == null)
										{
											is_create = true;
										}
										else
										{
											is_create = false;
										}
										// IMAGE LOGIC
										before_img = ifnull(input.Image_Before.toString(),"").trim();
										after_img = ifnull(input.Image_After.toString(),"").trim();
										// CANCEL RULE
										if(input.Cancelled == true)
										{
											if(isNull(input.Reason_Why_Cancelled) || input.Reason_Why_Cancelled.trim() == "")
											{
												errors = errors + "\n• Reason Why Cancelled is required when Cancelled is checked.";
											}
										}
										// CREATE
										if(is_create)
										{
											if(input.Voucher == null)
											{
												errors = errors + "\n• Voucher is required.";
											}
											if(input.Location == null)
											{
												errors = errors + "\n• Location is required.";
											}
											if(input.Job == null)
											{
												errors = errors + "\n• Job is required.";
											}
											else
											{
												jobNo = input.Job.Job_No;
												if(jobNo == "TJS01" && input.Batch_Number_From == null)
												{
													errors = errors + "\n• Batch Number is required for Drager production job.";
												}
												else if(jobNo == "TJS02" && input.Work_Order_Task == null)
												{
													errors = errors + "\n• Work Order Task is required for Drager service task.";
												}
											}
											if(input.Odometer_Start == null)
											{
												errors = errors + "\n• Odometer Start is required.";
											}
											if(before_img == "")
											{
												errors = errors + "\n• Image Before is required on create.";
											}
										}
										// EDIT
										else
										{
											if(input.Cancelled != true && input.Drager_Work_Report_Status == "In Progress" && input.Odometer_End == null)
											{
												errors = errors + "\n• Odometer End is required when Status is In Progress and the record is not cancelled.";
											}
											if(after_img == "")
											{
												errors = errors + "\n• Image After is required on edit.";
											}
										}
										// FINAL BLOCK
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize11 as "Finalize"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											info "===== DRAGER WORK REPORT FINALIZE START =====";
										// ========================================
										// CREATE OR EDIT CHECK
										// ========================================
										is_create = false;
										if(input.Added_Time != null && input.Modified_Time != null)
										{
											if(input.Added_Time.toLong() == input.Modified_Time.toLong())
											{
												is_create = true;
											}
										}
										// ========================================
										// ON CREATE
										// ========================================
										if(is_create)
										{
											if(input.Time_Start == null)
											{
												input.Time_Start = zoho.currenttime;
											}
											// Default
											input.Drager_Work_Report_Status = "In Progress";
											// ========================================
											// TJS03 - TRUCK MOVEMENT
											// On create: Drager = Completed + Truck Movement = Completed
											// ========================================
											if(input.Job != null && input.Job.Job_No == "TJS04")
											{
												input.Drager_Work_Report_Status = "Completed";
												if(input.Time_End == null)
												{
													input.Time_End = zoho.currenttime;
												}
												if(input.Time_Start != null && input.Time_End != null)
												{
													diffMillis = input.Time_End.toLong() - input.Time_Start.toLong();
													if(diffMillis >= 0)
													{
														input.Line_Duration_Minutes = round(diffMillis / 60000.0,2);
														input.Line_Hours_Worked = round(diffMillis / 3600000.0,2);
													}
													else
													{
														input.Line_Duration_Minutes = null;
														input.Line_Hours_Worked = null;
													}
												}
												if(input.Truck_Movement_Voucher != null)
												{
													tmv = Truck_Movement_Voucher[ID == input.Truck_Movement_Voucher];
													if(tmv.ID != null)
													{
														if(tmv.Truck_Movement_Voucher_Status == "Delivered")
														{
															tmv.Truck_Movement_Voucher_Status="Completed";
															info "Truck Movement updated to Completed on create.";
														}
													}
												}
											}
										}
										// ========================================
										// ON EDIT
										// ========================================
										else
										{
											if(input.Cancelled == true)
											{
												input.Drager_Work_Report_Status = "Cancelled";
											}
											else if(input.Drager_Work_Report_Status == "In Progress")
											{
												if(input.Time_End == null)
												{
													input.Time_End = zoho.currenttime;
												}
												if(input.Time_Start != null && input.Time_End != null)
												{
													diffMillis = input.Time_End.toLong() - input.Time_Start.toLong();
													if(diffMillis >= 0)
													{
														input.Line_Duration_Minutes = round(diffMillis / 60000.0,2);
														input.Line_Hours_Worked = round(diffMillis / 3600000.0,2);
													}
													else
													{
														input.Line_Duration_Minutes = null;
														input.Line_Hours_Worked = null;
													}
												}
												if(input.Job != null && input.Job.Job_No == "TJS01")
												{
													input.Drager_Work_Report_Status = "Loaded";
												}
												else
												{
													input.Drager_Work_Report_Status = "Completed";
												}
											}
										}
										// ========================================
										// CREATE BATCH STOCK OUT
										// DJS01 = Production / Loading
										// ========================================
										if(input.Drager_Work_Report_Status == "Completed" || input.Drager_Work_Report_Status == "Loaded")
										{
											if(input.Job != null && input.Job.Job_No == "TJS01")
											{
												if(input.Batch_Number_From != null)
												{
													sourceID = input.ID;
													existingBatchStock = Batch_Stock[Source_Record_ID == sourceID];
													if(existingBatchStock.count() == 0)
													{
														lastLine = Batch_Stock[Batch_Number == input.Batch_Number_From] sort by Line_Number desc;
														nextLine = 1;
														currentBalance = 0.0;
														for each  l in lastLine
														{
															nextLine = ifnull(l.Line_Number,0) + 1;
															currentBalance = ifnull(l.Running_Balance,0.0);
															break;
														}
														qtyOut = -1;
														newBalance = currentBalance + qtyOut;
														insert into Batch_Stock
														[
															Batch_Number=input.Batch_Number_From
															Display_Name_Batch_Number=input.Batch_Number_From.Batch_Number
															Line_Number=nextLine
															Batch_Time=input.Time_End
															Batch_Type="Out"
															Reference=input.Display_Name_Voucher
															Quantity=qtyOut
															Running_Balance=newBalance
															Source_Record_ID=sourceID
															Source_Form="Employee Management - Drager Work Report"
															Added_User=zoho.loginuser
														]
														info "Batch Stock OUT created.";
													}
													else
													{
														info "Batch Stock OUT already exists.";
													}
												}
											}
										}
										// ========================================
										// SYNC TO ASSET MANAGEMENT
										// DJS02 = Work Order Task
										// ========================================
										if(input.Drager_Work_Report_Status == "Completed")
										{
											if(input.Job != null && input.Job.Job_No == "TJS02")
											{
												if(input.Work_Order_Task != null)
												{
													payload = Map();
													payload.put("Work_Order_Task_ID",input.Work_Order_Task.ID);
													payload.put("Work_Order_Task_Number",ifnull(input.Work_Order_Task.Work_Order_Task_Number,""));
													payload.put("Display_Name_Work_Order_Task_Number",ifnull(input.Work_Order_Task.Work_Order_Task_Number,""));
													payload.put("Display_Name_Item_Labour","Drager Labour");
													payload.put("Display_Name_Asset",ifnull(input.Display_Name_Asset,""));
													payload.put("Odometer_Start",ifnull(input.Odometer_Start,0.0));
													payload.put("Odometer_End",ifnull(input.Odometer_End,0.0));
													payload.put("Quantity",ifnull(input.Line_Hours_Worked,0.0));
													desc = ifnull(input.Display_Name_Asset,"") + " started at " + ifnull(input.Odometer_Start,0.0).toString() + " and ended at " + ifnull(input.Odometer_End,0.0).toString();
													payload.put("Description",desc);
													payload.put("Source_Record_ID",input.ID.toString());
													payload.put("Source_Form","Employee Management - Drager Work Report");
													resp = asset_management.syncPartsConsumablesFromDragerWorkReport(payload);
													info "Response: " + resp.toString();
												}
											}
										}
										info "===== DRAGER WORK REPORT FINALIZE END =====";
						)
					}
				}

			}
			On_Tractor_Work_Report_Se as "On Tractor Work Report Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Tractor_Work_Report
				{
					actions 
					{
						custom deluge script
						(
											if(input.Tractor_Work_Report != null)
										{
											twr = Tractor_Work_Report[ID == input.Tractor_Work_Report];
											if(twr.ID != null)
											{
												if(twr.Batch_Number != null)
												{
													input.Batch_Number_From = twr.Batch_Number;
												}
												else
												{
													input.Batch_Number_From = null;
												}
												if(twr.Voucher != null && twr.Voucher.Site != null)
												{
													input.Site_From = twr.Voucher.Site;
													input.Display_Name_Site_From = ifnull(twr.Display_Name_Site,"");
												}
												else
												{
													input.Site_From = null;
													input.Display_Name_Site_From = "";
												}
											}
										}
										else
										{
											input.Batch_Number_From = null;
											input.Site_From = null;
											input.Display_Name_Site_From = "";
										}
						)
					}
				}

			}
