	reports
	{
		default list All_Employees
		{
			displayName = "All Employees"
			show all rows from Employee_Register    
			(
				Images
				(
			dimension = custom
			imagewidth = 100px
			imageheight = 100px
				)
				Gender
				Date_of_Birth as "Date of Birth"
				Home_Address  as "Home Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Date_of_Joining as "Date of Joining"
				Religion
				Next_of_Kin  as "Next of Kin"
				Next_of_Kin_Contact as "Next of Kin Contact"
				(
					displayformat = plainnumber 
				)
				Relationship
				NSSF_Number as "NSSF Number"
				Tax_Identification_Number as "Tax Identification Number"
				Employee_Name as "Employee Name"
				Father_s_Name as "Father's Name"
				Mother_s_Name as "Mother's Name"
				National_Identification_Number as "National Identification Number"
				Employee_Number as "Employee Number"
				Employee_Type as "Employee Type"
				Employment_Status as "Employment Status"
				User_Name as "User Name"
				User_Email as "User Email"
				User_Role as "User Role"
				Created_By_Name as "Created By Name"
				Created_By_Time as "Created By Time"
				Updated_By_Name as "Updated By Name"
				Updated_By_Email as "Updated By Email"
				Updated_By_Time as "Updated By Time"
				Created_By_Email as "Created By Email"
				Display_Name_Employee as "Display Name Employee"
			)
			sort by
			(
				Employee_Number descending
			)
			conditional formatting
			(
				"Employment Status - Active"
				{
				condition = (Employment_Status == "Active")
				fields = [Employment_Status]
				format = "font-weight:bold;background-color:#4ea64c;"
				}
			)
		}
