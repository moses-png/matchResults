			On_Voucher_Selected4 as "On Voucher Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// TRUCK MOVEMENT VOUCHER
										// USER INPUT OF VOUCHER
										// =====================================================
										input.Display_Name_Voucher = "";
										input.Display_Name_Employee = "";
										input.Display_Name_Site = "";
										input.Display_Name_Asset = "";
										input.Number_Plate_Truck_Register = null;
										input.Line_Number = null;
										if(input.Voucher != null)
										{
											input.Display_Name_Voucher = ifnull(input.Voucher.Display_Name_Voucher,"");
											input.Display_Name_Employee = ifnull(input.Voucher.Display_Name_Employee,"");
											input.Display_Name_Site = ifnull(input.Voucher.Display_Name_Site,"");
											next_line_number = 1;
											existing_lines = Truck_Movement_Voucher[Voucher == input.Voucher && ID != input.ID];
											for each  existing_line in existing_lines
											{
												existing_number = ifnull(existing_line.Line_Number,0).toLong();
												if(existing_number >= next_line_number)
												{
													next_line_number = existing_number + 1;
												}
											}
											input.Line_Number = next_line_number;
											if(input.Voucher.Asset != null)
											{
												assetName = ifnull(input.Voucher.Asset.Asset_Name,"").trim();
												assetID = "";
												if(input.Voucher.Asset.Asset_ID != null)
												{
													assetID = input.Voucher.Asset.Asset_ID.toString().trim();
												}
												if(assetName != "" && assetID != "")
												{
													input.Display_Name_Asset = assetName + " - " + assetID;
												}
												else if(assetName != "")
												{
													input.Display_Name_Asset = assetName;
												}
												else if(assetID != "")
												{
													input.Display_Name_Asset = assetID;
												}
												else
												{
													input.Display_Name_Asset = "";
												}
												input.Number_Plate_Truck_Register = assetName;
											}
										}
						)
					}
				}

			}
			Finalize_On_Create18 as "Finalize On Create"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
						)
					}
				}

			}
