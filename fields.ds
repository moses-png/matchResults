                 	{
                 		resp.put("message","Source Record ID missing.");
                 		return resp;
                 	}
                 	voucher_number_val = ifnull(payload.get("Voucher_Number"),"").trim();
                 	if(voucher_number_val == "")
                 	{
                 		voucher_number_val = "MSM-VCH-" + source_record_id.toString();
                 	}
                 	voucher_status_val = ifnull(payload.get("Voucher_Status"),"Open");
                 	date_in_val = null;
                 	date_out_val = null;
                 	start_time_val = null;
                 	end_time_val = null;
                 	manager_time_val = null;
                 	time_checked_val = null;
                 	hr_time_checked_val = null;
                 	if(ifnull(payload.get("Date_Time_In"),"") != "")
                 	{
                 		date_in_val = payload.get("Date_Time_In").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Date_Time_Out"),"") != "")
                 	{
                 		date_out_val = payload.get("Date_Time_Out").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Start_Time"),"") != "")
                 	{
                 		start_time_val = payload.get("Start_Time").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("End_Time"),"") != "")
                 	{
                 		end_time_val = payload.get("End_Time").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Manager_Time"),"") != "")
                 	{
                 		manager_time_val = payload.get("Manager_Time").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Time_Checked"),"") != "")
                 	{
                 		time_checked_val = payload.get("Time_Checked").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Hr_Time_Checked"),"") != "")
                 	{
                 		hr_time_checked_val = payload.get("Hr_Time_Checked").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	issued_by_text = ifnull(payload.get("Display_Name_Issued_By"),"").trim();
                 	received_by_text = ifnull(payload.get("Display_Name_Received_By"),"").trim();
                 	issued_by_val = null;
                 	if(issued_by_text != "")
                 	{
                 		issued_rec = Voucher[Voucher_Number == issued_by_text || Display_Name_Employee == issued_by_text || Display_Name_Issued_By == issued_by_text];
                 		if(issued_rec.ID != null)
                 		{
                 			issued_by_val = issued_rec.ID;
                 		}
                 	}
                 	received_by_val = null;
                 	if(received_by_text != "")
                 	{
                 		received_rec = Voucher[Voucher_Number == received_by_text || Display_Name_Employee == received_by_text || Display_Name_Received_By == received_by_text];
                 		if(received_rec.ID != null)
                 		{
                 			received_by_val = received_rec.ID;
                 		}
                 	}
                 	existing = Voucher[Source_Record_ID == source_record_id && Source_Form == source_form];
                 	if(existing.ID == null)
                 	{
                 		existing = Voucher[Voucher_Number == voucher_number_val];
                 	}
                 	if(existing.ID != null)
                 	{
                 		existing.Document_Type=payload.get("Document_Type");
                 		existing.Voucher_Type=payload.get("Voucher_Type");
                 		existing.Voucher_Number=voucher_number_val;
                 		existing.Employee=payload.get("Employee");
                 		existing.Display_Name_Employee=payload.get("Display_Name_Employee");
                 		existing.Issued_By=issued_by_val;
                 		existing.Display_Name_Issued_By=issued_by_text;
                 		existing.Received_By=received_by_val;
                 		existing.Display_Name_Received_By=received_by_text;
                 		existing.Date_Time_In=date_in_val;
                 		existing.Date_Time_Out=date_out_val;
                 		existing.Site=payload.get("Site");
                 		existing.Display_Name_Site=payload.get("Display_Name_Site");
                 		existing.Hours_Worked=payload.get("Hours_Worked");
                 		existing.Shift=payload.get("Shift");
                 		existing.Voucher_Status=voucher_status_val;
                 		existing.Management_Location=payload.get("Management_Location");
                 		existing.Asset=payload.get("Asset");
                 		existing.Machine_Start_of_Day=payload.get("Machine_Start_of_Day");
                 		existing.Start_Time=start_time_val;
                 		existing.End_Time=end_time_val;
                 		existing.Manager_Time=manager_time_val;
                 		existing.Time_Checked=time_checked_val;
                 		existing.Hr_Time_Checked=hr_time_checked_val;
                 		existing.Odometer_Start=payload.get("Odometer_Start");
                 		existing.Fuel_Start_Level=payload.get("Fuel_Start_Level");
                 		existing.Odometer_End=payload.get("Odometer_End");
                 		existing.Fuel_End_Level=payload.get("Fuel_End_Level");
                 		existing.Item=payload.get("Item");
                 		existing.Display_Name_Item=payload.get("Display_Name_Item");
                 		existing.Quantity_To_Be_Created=payload.get("Quantity_To_Be_Created");
                 		existing.Voucher_Cost=payload.get("Voucher_Cost");
                 		existing.Cancel_Voucher=payload.get("Cancel_Voucher");
                 		existing.Cancellation_Reason=payload.get("Cancellation_Reason");
                 		existing.Seen=payload.get("Seen");
                 		existing.Reason_for_not_Seen=payload.get("Reason_for_not_Seen");
                 		existing.Source_Record_ID=source_record_id;
                 		existing.Source_Form=source_form;
                 		resp.put("ok",true);
                 		resp.put("message","Voucher updated.");
                 		resp.put("id",existing.ID);
                 		return resp;
                 	}
                 	new_id = insert into Voucher
                 	[
                 		Document_Type=payload.get("Document_Type")
                 		Voucher_Type=payload.get("Voucher_Type")
                 		Voucher_Number=voucher_number_val
                 		Employee=payload.get("Employee")
                 		Display_Name_Employee=payload.get("Display_Name_Employee")
                 		Issued_By=issued_by_val
                 		Display_Name_Issued_By=issued_by_text
                 		Received_By=received_by_val
                 		Display_Name_Received_By=received_by_text
                 		Date_Time_In=date_in_val
                 		Date_Time_Out=date_out_val
                 		Site=payload.get("Site")
                 		Display_Name_Site=payload.get("Display_Name_Site")
                 		Hours_Worked=payload.get("Hours_Worked")
                 		Shift=payload.get("Shift")
                 		Voucher_Status=voucher_status_val
                 		Management_Location=payload.get("Management_Location")
                 		Asset=payload.get("Asset")
                 		Machine_Start_of_Day=payload.get("Machine_Start_of_Day")
                 		Start_Time=start_time_val
                 		End_Time=end_time_val
                 		Manager_Time=manager_time_val
                 		Time_Checked=time_checked_val
                 		Hr_Time_Checked=hr_time_checked_val
                 		Odometer_Start=payload.get("Odometer_Start")
                 		Fuel_Start_Level=payload.get("Fuel_Start_Level")
                 		Odometer_End=payload.get("Odometer_End")
                 		Fuel_End_Level=payload.get("Fuel_End_Level")
                 		Item=payload.get("Item")
                 		Display_Name_Item=payload.get("Display_Name_Item")
                 		Quantity_To_Be_Created=payload.get("Quantity_To_Be_Created")
                 		Voucher_Cost=payload.get("Voucher_Cost")
                 		Cancel_Voucher=payload.get("Cancel_Voucher")
                 		Cancellation_Reason=payload.get("Cancellation_Reason")
                 		Seen=payload.get("Seen")
                 		Reason_for_not_Seen=payload.get("Reason_for_not_Seen")
                 		Source_Record_ID=source_record_id
                 		Source_Form=source_form
                 		Added_User=zoho.loginuser
                 	];
                 	resp.put("ok",true);
                 	resp.put("message","Voucher created.");
                 	resp.put("id",new_id);
                 	return resp;
                 }
				 map updateInvoiceFromPayment(map payload)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("msg","");
                 	result.put("invoice_number","");
                 	result.put("invoice_id",null);
                 	result.put("invoice_amount_paid",0.0);
                 	result.put("invoice_balance_due",0.0);
                 	result.put("invoice_status","Draft");
                 	result.put("payment_status","Not Paid");
                 	result.put("payment_date",null);
                 	if(payload == null)
                 	{
                 		result.put("msg","payload is null");
                 		return result;
                 	}
                 	invoice_id_val = payload.get("Invoice_ID");
                 	invoice_no_val = ifnull(payload.get("Invoice_Number"),"").trim();
                 	total_paid_input = round(ifnull(payload.get("Total_Paid"),0.0),2);
                 	payment_date_val = payload.get("Payment_Date");
                 	result.put("payment_date",payment_date_val);
                 	inv = null;
                 	if(invoice_id_val != null)
                 	{
                 		inv = Invoice[ID == invoice_id_val];
                 	}
                 	else if(invoice_no_val != "")
                 	{
                 		inv = Invoice[Invoice_Number == invoice_no_val];
                 	}
                 	if(inv == null || inv.ID == null)
                 	{
                 		result.put("msg","No Invoice found");
                 		return result;
                 	}
                 	invoice_total_due = round(ifnull(inv.Grand_Total,0.0) - ifnull(inv.Discount,0.0) + ifnull(inv.Tax_Amount,0.0),2);
                 	if(invoice_total_due < 0)
                 	{
                 		invoice_total_due = 0.0;
                 	}
                 	recomputed_paid = total_paid_input;
                 	if(recomputed_paid < 0)
                 	{
                 		recomputed_paid = 0.0;
                 	}
                 	if(recomputed_paid > invoice_total_due)
                 	{
                 		recomputed_paid = invoice_total_due;
                 	}
                 	balance_due = round(invoice_total_due - recomputed_paid,2);
                 	if(balance_due < 0)
                 	{
                 		balance_due = 0.0;
                 	}
                 	payment_status = "Not Paid";
                 	if(recomputed_paid <= 0)
                 	{
                 		payment_status = "Not Paid";
                 	}
                 	else if(recomputed_paid < invoice_total_due)
                 	{
                 		payment_status = "Partially Paid";
                 	}
                 	else
                 	{
                 		payment_status = "Paid";
                 	}
                 	invoice_status = "Draft";
                 	if(inv.Cancel_Invoice == true)
                 	{
                 		invoice_status = "Cancelled";
                 	}
                 	else if(invoice_total_due > 0)
                 	{
                 		invoice_status = "Invoiced";
                 	}
                 	else
                 	{
                 		invoice_status = "Draft";
                 	}
                 	inv.Amount_Paid=recomputed_paid;
                 	inv.Balance_Due=balance_due;
                 	inv.Payment_Status=payment_status;
                 	inv.Status=invoice_status;
                 	result.put("ok",true);
                 	result.put("msg","Invoice payment updated successfully");
                 	result.put("invoice_number",inv.Invoice_Number);
                 	result.put("invoice_id",inv.ID);
                 	result.put("invoice_amount_paid",recomputed_paid);
                 	result.put("invoice_balance_due",balance_due);
                 	result.put("invoice_status",invoice_status);
                 	result.put("payment_status",payment_status);
                 	return result;
                 }
				 map updateInvoiceFromReceipt(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("msg","");
                 	resp.put("invoice_amount_paid",0.0);
                 	resp.put("balance_due",0.0);
                 	resp.put("payment_status","");
                 	resp.put("group_allocations",List());
                 	// -------------------------
                 	// VALIDATION
                 	// -------------------------
                 	if(payload == null)
                 	{
                 		resp.put("msg","Payload is null.");
                 		return resp;
                 	}
                 	invoice_no = ifnull(payload.get("Invoice_Number"),"").trim();
                 	total_received = round(ifnull(payload.get("Total_Received"),0.0),2);
                 	receipt_date_val = payload.get("Receipt_Date");
                 	if(invoice_no == "")
                 	{
                 		resp.put("msg","Invoice_Number is required.");
                 		return resp;
                 	}
                 	if(receipt_date_val == null)
                 	{
                 		receipt_date_val = zoho.currentdate;
                 	}
                 	// -------------------------
                 	// FIND INVOICE
                 	// -------------------------
                 	inv = Invoice[Invoice_Number == invoice_no];
                 	if(inv.ID == null)
                 	{
                 		resp.put("msg","Invoice not found: " + invoice_no);
                 		return resp;
                 	}
                 	// -------------------------
                 	// CALCULATE VALUES
                 	// -------------------------
                 	grand_total = round(ifnull(inv.Grand_Total,0.0),2);
                 	if(total_received > grand_total)
                 	{
                 		total_received = grand_total;
                 	}
                 	balance_due_val = round(grand_total - total_received,2);
                 	if(balance_due_val < 0)
                 	{
                 		balance_due_val = 0.0;
                 	}
                 	payment_status_val = "Not Paid";
                 	if(total_received <= 0)
                 	{
                 		payment_status_val = "Not Paid";
                 	}
                 	else if(balance_due_val > 0)
                 	{
                 		payment_status_val = "Partially Paid";
                 	}
                 	else
                 	{
                 		payment_status_val = "Paid";
                 	}
                 	// -------------------------
                 	// UPDATE INVOICE
                 	// -------------------------
                 	inv.Amount_Paid=total_received;
                 	inv.Balance_Due=balance_due_val;
                 	inv.Payment_Status=payment_status_val;
                 	// -------------------------
                 	// RETURN RESPONSE
                 	// -------------------------
                 	resp.put("ok",true);
                 	resp.put("msg","Invoice updated");
                 	resp.put("invoice_amount_paid",total_received);
                 	resp.put("balance_due",balance_due_val);
                 	resp.put("payment_status",payment_status_val);
                 	return resp;
                 }
				 void updateVoucherQuantityCreated(int voucher_id)
                 {
                 	v = Voucher[ID == voucher_id];
                 	if(v.ID != null)
                 	{
                 		total_qty_received = 0.0;
                 		if(v.Voucher_Type == "Stock Receiving Note" || v.Voucher_Type == "Stock Bundling Note")
                 		{
                 			for each  rec in v.Employee_Receiving_Details
                 			{
                 				total_qty_received = total_qty_received + ifnull(rec.Quantity_Received,0.0);
                 			}
                 		}
                 		v.Quantity_Created=total_qty_received;
                 	}
                 }
				 void updateVoucherTransferRegisterCount(string case_no)
                 {
                 	if(case_no != null && case_no.trim() != "")
                 	{
                 		case_no = case_no.trim();
                 		total_vouchers = 0;
                 		head_office_count = 0;
                 		// =====================================================
                 		// 1) FIND SUPERVISOR VOUCHERS FOR THIS CASE
                 		// =====================================================
                 		supervisor_vouchers = Voucher[Case_Number == case_no && Voucher_Type == "Supervisor Voucher"];
                 		for each  sv in supervisor_vouchers
                 		{
                 			// Count the Supervisor Voucher itself
                 			total_vouchers = total_vouchers + 1;
                 			if(sv.Voucher_Status == "Head Office")
                 			{
                 				head_office_count = head_office_count + 1;
                 			}
                 			// =================================================
                 			// 2) COUNT VOUCHERS ATTACHED TO THIS SUPERVISOR
                 			// =================================================
                 			attached_vouchers = Voucher[Issued_By == sv.ID];
                 			for each  av in attached_vouchers
                 			{
                 				total_vouchers = total_vouchers + 1;
                 				if(av.Voucher_Status == "Head Office")
                 				{
                 					head_office_count = head_office_count + 1;
                 				}
                 			}
                 		}
                 		// =====================================================
                 		// 3) UPDATE TRANSFER REGISTER
                 		// =====================================================
                 		transfer_records = Voucher_Transfer_Register[Case_Number == case_no];
                 		for each  tr in transfer_records
                 		{
                 			tr.Number_Of_Vouchers=total_vouchers;
                 			if(total_vouchers > 0 && head_office_count >= total_vouchers)
                 			{
                 				tr.Case_Status="Closed";
                 			}
                 			else
                 			{
                 				tr.Case_Status="In Transit";
                 			}
                 		}
                 		info "Case Number: " + case_no;
                 		info "Supervisor Vouchers: " + supervisor_vouchers.count();
                 		info "Total Vouchers: " + total_vouchers;
                 		info "Transfer Records: " + transfer_records.count();
                 	}
                 }
				 void update_voucher_status(BIGINT voucher_id, STRING new_status)
                 {
                 	voucher_rec = Voucher[ID == voucher_id];
                 	if(voucher_rec.count() > 0)
                 	{
                 		voucher_rec.Voucher_Status=new_status;
                 	}
                 }
				 map audit.getLoginAuditInfo()
                 {
                 	info = Map();
                 	info.put("name",zoho.loginuser);
                 	info.put("email",zoho.loginuserid);
                 	// role is optional (in case you add it later)
                 	try 
                 	{
                 		info.put("role",thisapp.permissions.roleForUser(zoho.loginuserid));
                 	}
                 	catch (e)
                 	{
                 		info.put("role",thisapp.permissions.loginUserProfile());
                 	}
                 	return info;
                 }
				 map employee.get_employee_by_display_name(string employee_display_name)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("message","");
                 	result.put("employee_id",null);
                 	result.put("display_name","");
                 	employee_display_name = ifnull(employee_display_name,"").trim();
                 	if(employee_display_name == "")
                 	{
                 		result.put("message","Employee display name is required.");
                 		return result;
                 	}
                 	employee_rec = Employee_Register[Display_Name_Employee == employee_display_name];
                 	if(employee_rec.ID == null)
                 	{
                 		result.put("message","Employee was not found: " + employee_display_name);
                 		return result;
                 	}
                 	result.put("ok",true);
                 	result.put("message","Employee found.");
                 	result.put("employee_id",employee_rec.ID);
                 	result.put("display_name",ifnull(employee_rec.Display_Name_Employee,""));
                 	return result;
                 }
				 map employee.get_employee_salary_details(int employee_id, date work_date)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("message","");
                 	result.put("employee_id",employee_id);
                 	result.put("monthly_salary",0.0);
                 	result.put("daily_salary",0.0);
                 	result.put("days_in_month",0);
                 	// =====================================================
                 	// 1. VALIDATE INPUTS
                 	// =====================================================
                 	if(employee_id == null)
                 	{
                 		result.put("message","Employee ID is required.");
                 		return result;
                 	}
                 	if(work_date == null)
                 	{
                 		work_date = zoho.currentdate;
                 	}
                 	// =====================================================
                 	// 2. FIND ACTIVE EMPLOYMENT STATUS
                 	// =====================================================
                 	status_rec = Employment_Status[Employee == employee_id && Employment_Status == "Active"];
                 	if(status_rec.ID == null)
                 	{
                 		result.put("message","No active employment status was found for this employee.");
                 		return result;
                 	}
                 	monthly_salary = ifnull(status_rec.Monthly_Salary,0.0);
                 	if(monthly_salary <= 0)
                 	{
                 		result.put("message","The employee has no monthly salary.");
                 		return result;
                 	}
                 	// =====================================================
                 	// 3. GET NUMBER OF DAYS IN THE SELECTED MONTH
                 	// =====================================================
                 	month_number = work_date.getMonth();
                 	year_number = work_date.getYear();
                 	if(month_number == 1 || month_number == 3 || month_number == 5 || month_number == 7 || month_number == 8 || month_number == 10 || month_number == 12)
                 	{
                 		days_in_month = 31;
                 	}
                 	else if(month_number == 4 || month_number == 6 || month_number == 9 || month_number == 11)
                 	{
                 		days_in_month = 30;
                 	}
                 	else
                 	{
                 		// February leap-year calculation
                 		is_leap_year = false;
                 		if(year_number % 400 == 0)
                 		{
                 			is_leap_year = true;
                 		}
                 		else if(year_number % 100 == 0)
                 		{
                 			is_leap_year = false;
                 		}
                 		else if(year_number % 4 == 0)
                 		{
                 			is_leap_year = true;
                 		}
                 		if(is_leap_year)
                 		{
                 			days_in_month = 29;
                 		}
                 		else
                 		{
                 			days_in_month = 28;
                 		}
                 	}
                 	// =====================================================
                 	// 4. CALCULATE DAILY SALARY
                 	// =====================================================
                 	daily_salary = round(monthly_salary / days_in_month,2);
                 	result.put("ok",true);
                 	result.put("message","Employee salary details found.");
                 	result.put("employee_id",employee_id);
                 	result.put("monthly_salary",monthly_salary);
                 	result.put("daily_salary",daily_salary);
                 	result.put("days_in_month",days_in_month);
                 	result.put("employment_status_id",status_rec.ID);
                 	return result;
                 }
				 map planning.sendGroupedMonthlyCollectionsIT(date target_date)
                 {
                 	// Guard: no date passed
                 	if(target_date == null)
                 	{
                 		return {"ok":false,"msg":"target_date is null"};
                 	}
                 	// Compute period (month window based on target_date)
                 	period_start = target_date.toStartOfMonth();
                 	period_end = period_start.addMonth(1).addDay(-1);
                 	// =========================================================
                 	// One-time backfill for older records
                 	// =========================================================
                 	for each  rFix in Payment_Received[Payment_Date == null]
                 	{
                 		if(rFix.Created_By_Time != null)
                 		{
                 			rFix.Payment_Date=rFix.Created_By_Time.toDate();
                 		}
                 	}
                 	// Buckets (non-credit receipts)
                 	received9A = 0.0;
                 	received12A = 0.0;
                 	receivedOther = 0.0;
                 	// Buckets (credit amounts)
                 	credit9A = 0.0;
                 	credit12A = 0.0;
                 	creditOther = 0.0;
                 	// Fetch payments received in the month
                 	month_receipts = Payment_Received[Payment_Date >= period_start && Payment_Date <= period_end];
                 	for each  r in month_receipts
                 	{
                 		amt = ifnull(r.Amount_Due,0).toDecimal();
                 		if(amt <= 0)
                 		{
                 			continue;
                 		}
                 		site = ifnull(r.Display_Name_Site,"").trim();
                 		isCredit = ifnull(r.Payment_Type,"") == "Credit";
                 		if(site == "Gomba Site - ARA075")
                 		{
                 			if(isCredit)
                 			{
                 				credit9A = credit9A + amt;
                 			}
                 			else
                 			{
                 				received9A = received9A + amt;
                 			}
                 		}
                 		else if(site == "Seeta Site - ARA068")
                 		{
                 			if(isCredit)
                 			{
                 				credit12A = credit12A + amt;
                 			}
                 			else
                 			{
                 				received12A = received12A + amt;
                 			}
                 		}
                 		else
                 		{
                 			if(isCredit)
                 			{
                 				creditOther = creditOther + amt;
                 			}
                 			else
                 			{
                 				receivedOther = receivedOther + amt;
                 			}
                 		}
                 	}
                 	// Output payload
                 	out = Map();
                 	out.put("ok",true);
                 	out.put("period_start",period_start);
                 	out.put("period_end",period_end);
                 	out.put("received9A",received9A);
                 	out.put("received12A",received12A);
                 	out.put("receivedOther",receivedOther);
                 	out.put("total_received",received9A + received12A + receivedOther);
                 	// Credits (for 9A* and 12A*)
                 	out.put("credit9A",credit9A);
                 	out.put("credit12A",credit12A);
                 	out.put("creditOther",creditOther);
                 	out.put("total_credit",credit9A + credit12A + creditOther);
                 	return out;
                 }
				 map truck.compute_sizes(decimal l, decimal w, decimal h1, decimal h2)
                 {
                 	// null-safe
                 	l = ifnull(l,0.0);
                 	w = ifnull(w,0.0);
                 	h1 = ifnull(h1,0.0);
                 	h2 = ifnull(h2,0.0);
                 	out = Map();
                 	out.put("size1",(l * w * h1).round(3));
                 	out.put("size2",(l * w * (h1 + h2)).round(3));
                 	return out;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Set_Up_Form1 as "Set Up Form"
			{
				type =  form
				form = Employee_Register

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// -------- 0) Detect mode --------
										is_create = input.ID == null;
										// -------- 2) MAIN FORM UI --------
										hide Back_End;
										hide National_Identification_Number;
										hide NSSF_Number;
										hide Tax_Identification_Number;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										disable Display_Name_Employee;
										disable Employment_Status;
										// Default on create
										if(is_create)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											input.Employment_Status = "Active";
										}
										// Build display name
										if(input.Employee_Name != null && input.Employee_Number != null)
										{
											input.Display_Name_Employee = input.Employee_Name.trim() + " - " + input.Employee_Number.toString();
										}
										else
										{
											input.Display_Name_Employee = null;
										}
										// -------- 3) CONTACT / EMAIL UPDATE SUBFORM --------
										disable Contact_Email_Update_Details.Display_Name_Employee;
										disable Contact_Email_Update_Details.Display_Name_Contact_Name_Email;
										hide Contact_Email_Update_Details.Display_Name_Employee;
										if(is_create)
										{
											hide Contact_Email_Update_Details.Contact;
											hide Contact_Email_Update_Details.Contact_Names;
											hide Contact_Email_Update_Details.Email;
										}
										// -------- 4) EMPLOYEE DEPARTMENT DETAILS SUBFORM --------
										disable Employee_Department_Details.Display_Name_Employee;
										disable Employee_Department_Details.Display_Name_Company;
										disable Employee_Department_Details.Display_Name_Employee_Department;
										disable Employee_Department_Details.Department_Status;
										disable Employee_Department_Details.Employment_Status;
										hide Employee_Department_Details.Display_Name_Employee;
										hide Employee_Department_Details.Display_Name_Company;
										hide Employee_Department_Details.Display_Name_Employee_Department;
										if(input.Employee_Department_Details != null)
										{
											for each  dept_row in input.Employee_Department_Details
											{
												if(dept_row.Employee != null)
												{
													dept_row.Display_Name_Employee=dept_row.Employee.Employee_Name + " - " + dept_row.Employee.Employee_Number.toString();
												}
												else
												{
													dept_row.Display_Name_Employee=input.Display_Name_Employee;
												}
												if(dept_row.Company != null)
												{
													dept_row.Display_Name_Company=dept_row.Company.Company_Name + " - " + dept_row.Company.Company_ID.toString();
												}
												else
												{
													dept_row.Display_Name_Company=null;
												}
												if(dept_row.Employee_Department != null)
												{
													dept_row.Display_Name_Employee_Department=dept_row.Employee_Department.Display_Name_Department;
												}
												else
												{
													dept_row.Display_Name_Employee_Department=null;
												}
												if(dept_row.Department_Status == null)
												{
													dept_row.Department_Status="Active";
												}
												dept_row.Employment_Status=input.Employment_Status;
											}
										}
										// -------- 5) EMPLOYEE STATUS DETAILS SUBFORM --------
										disable Employee_Status_Details.Display_Name_Employee;
										disable Employee_Status_Details.Estimated_Take_per_day;
										disable Employee_Status_Details.Estimated_Take_per_month;
										disable Employee_Status_Details.Employment_Status;
										hide Employee_Status_Details.Display_Name_Employee;
										if(input.Employee_Status_Details != null)
										{
											for each  status_row in input.Employee_Status_Details
											{
												status_row.Display_Name_Employee=input.Display_Name_Employee;
												if(status_row.Employee_Status_Date == null)
												{
													status_row.Employee_Status_Date=zoho.currentdate;
												}
												status_row.Employment_Status=thisapp.compute_employment_status(status_row.Date_Started,status_row.Date_Ended);
												est = thisapp.compute_estimated_takes(status_row.Daily_Allowance,status_row.Weekly_Allowance,status_row.Monthly_Salary);
												status_row.Estimated_Take_per_day=est.get("per_day");
												status_row.Estimated_Take_per_month=est.get("per_month");
											}
										}
										// -------- 6) SITE ASSIGNED SUBFORM --------
										disable Site_Assigned.Display_Name_Employee;
										disable Site_Assigned.Display_Name_Site;
										disable Site_Assigned.Employment_Status;
										hide Site_Assigned.Display_Name_Employee;
										hide Site_Assigned.Display_Name_Site;
										if(input.Site_Assigned != null)
										{
											for each  sa_row in input.Site_Assigned
											{
												if(sa_row.Employee != null)
												{
													sa_row.Display_Name_Employee=sa_row.Employee.Employee_Name + " - " + sa_row.Employee.Employee_Number.toString();
												}
												else
												{
													sa_row.Display_Name_Employee=input.Display_Name_Employee;
												}
												if(sa_row.Site != null)
												{
													sa_row.Display_Name_Site=sa_row.Site.Display_Name_Asset_Name;
												}
												else
												{
													sa_row.Display_Name_Site=null;
												}
												sa_row.Employment_Status=input.Employment_Status;
												if(sa_row.Site_Assigned_Status == null)
												{
													sa_row.Site_Assigned_Status="Active";
												}
											}
										}
						)
					}
				}

			}
			On_Contact_Selected1 as "On Contact Selected"
			{
				type =  form
				form = Employee_Register

				record event = on add or edit

				on user input of Contact_Email_Update_Details.Contact
				{
					actions 
					{
						custom deluge script
						(
											// This runs on the subform row where Contact Names was edited.
										if(row != null)
										{
											// Rebuild Display_Name using your helper (handles Contact vs Email paths)
											row.Display_Name_Contact_Name_Email=thisapp.Build_Display_Name(row.Update_Type,row.Contact,row.Contact_Names,row.Email);
										}
						)
					}
				}

			}
			On_Contact_Names_Selected1 as "On Contact Names Selected"
			{
				type =  form
				form = Employee_Register

				record event = on add or edit

				on user input of Contact_Email_Update_Details.Contact_Names
				{
					actions 
					{
						custom deluge script
						(
											// Row-level handler (subform)
										if(row != null)
										{
											row.Display_Name_Contact_Name_Email=thisapp.Build_Display_Name(row.Update_Type,row.Contact,row.Contact_Names,row.Email);
										}
						)
					}
				}

			}
			On_Update_Type_Selected1 as "On Update Type Selected"
			{
				type =  form
				form = Employee_Register

				record event = on add or edit

				on user input of Contact_Email_Update_Details.Update_Type
				{
					actions 
					{
						custom deluge script
						(
											// Row-level handler (subform)
										if(row != null)
										{
											// Recompute Display_Name no matter what was chosen
											row.Display_Name_Contact_Name_Email=thisapp.Build_Display_Name(row.Update_Type,row.Contact,row.Contact_Names,row.Email);
											// (Optional) Toggle row field visibility if you want dynamic UX inside the subform
											// Note: show/hide supports subform fields using row.<FieldLinkName>
											if(row.Update_Type == "Contact")
											{
												show row.Contact;
												show row.Contact_Names;
												hide row.Email;
											}
											else if(row.Update_Type == "Email")
											{
												hide row.Contact;
												hide row.Contact_Names;
												show row.Email;
											}
											else
											{
												// If not chosen yet, hide all specifics (optional)
												hide row.Contact;
												hide row.Contact_Names;
												hide row.Email;
											}
										}
						)
					}
				}

			}
			Full_Validation as "Full Validation"
			{
				type =  form
				form = Employee_Register

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										// -------------------------------------------------
										// 0) EMPLOYEE IDENTIFIER RULE
										// -------------------------------------------------
										if(input.Employee_Number == null)
										{
											errors = errors + "\n• Employee Number is required.";
										}
										// Direct / Indirect Employment Number Rules
										if(input.Employee_Type != null && input.Employee_Number != null)
										{
											if(input.Employee_Type == "Indirect Employment" && input.Employee_Number <= 10000)
											{
												errors = errors + "\n• Indirect Employment Employee Number must be greater than 10000.";
											}
											if(input.Employee_Type == "Direct Employment" && input.Employee_Number > 10000)
											{
												errors = errors + "\n• Direct Employment Employee Number must not exceed 10000.";
											}
										}
										// -------------------------------------------------
										// Build Display Name Employee
										// -------------------------------------------------
										display_emp = "";
										emp_name = ifnull(input.Employee_Name,"").trim();
										emp_no = "";
										if(input.Employee_Number != null)
										{
											emp_no = input.Employee_Number.toString();
										}
										if(emp_name != "" && emp_no != "")
										{
											display_emp = emp_name + " - " + emp_no;
										}
										else if(emp_name != "")
										{
											display_emp = emp_name;
										}
										else if(emp_no != "")
										{
											display_emp = emp_no;
										}
										input.Display_Name_Employee = display_emp;
										// -------------------------------------------------
										// 1) CORE EMPLOYEE HEADER FIELDS
										// -------------------------------------------------
										if(input.Employee_Name == null || input.Employee_Name.trim() == "")
										{
											errors = errors + "\n• Employee Name is required.";
										}
										if(input.Employee_Type == null)
										{
											errors = errors + "\n• Employee Type is required.";
										}
										if(input.Gender == null)
										{
											errors = errors + "\n• Gender is required.";
										}
										if(input.Date_of_Birth == null)
										{
											errors = errors + "\n• Date of Birth is required.";
										}
										else if(input.Date_of_Birth > zoho.currentdate)
										{
											errors = errors + "\n• Date of Birth cannot be in the future.";
										}
										if(input.Date_of_Joining == null)
										{
											errors = errors + "\n• Date of Joining is required.";
										}
										else
										{
											if(input.Date_of_Joining > zoho.currentdate)
											{
												errors = errors + "\n• Date of Joining cannot be in the future.";
											}
											if(input.Date_of_Birth != null && input.Date_of_Joining < input.Date_of_Birth)
											{
												errors = errors + "\n• Date of Joining cannot be before Date of Birth.";
											}
										}
										// -------------------------------------------------
										// 2) LEGAL & STATUTORY
										// -------------------------------------------------
										if(input.Legal_Registration_Status == null)
										{
											errors = errors + "\n• Legal Registration Status is required.";
										}
										if(input.Legal_Registration_Status == "Registered")
										{
											if(input.National_Identification_Number == null || input.National_Identification_Number.trim() == "")
											{
												errors = errors + "\n• National Identification Number is required when employee is Registered.";
											}
											if(input.NSSF_Number == null || input.NSSF_Number.trim() == "")
											{
												errors = errors + "\n• NSSF Number is required when employee is Registered.";
											}
											if(input.Tax_Identification_Number == null || input.Tax_Identification_Number.trim() == "")
											{
												errors = errors + "\n• Tax Identification Number is required when employee is Registered.";
											}
										}
										else if(input.Legal_Registration_Status == "Not Registered")
										{
											input.National_Identification_Number = "";
											input.NSSF_Number = "";
											input.Tax_Identification_Number = "";
										}
										// Normalize National Identification Number only
										if(input.National_Identification_Number != null && input.National_Identification_Number.trim() != "")
										{
											nin = input.National_Identification_Number.trim().toUpperCase();
											input.National_Identification_Number = nin;
											dupeNIN = Employee_Register[National_Identification_Number == nin && ID != input.ID];
											if(dupeNIN.count() > 0)
											{
												errors = errors + "\n• National Identification Number already exists for another employee.";
											}
										}
										// Normalize NSSF only
										if(input.NSSF_Number != null && input.NSSF_Number.trim() != "")
										{
											input.NSSF_Number = input.NSSF_Number.trim();
										}
										// Normalize TIN only
										if(input.Tax_Identification_Number != null && input.Tax_Identification_Number.trim() != "")
										{
											input.Tax_Identification_Number = input.Tax_Identification_Number.trim();
										}
										// -------------------------------------------------
										// 3) NEXT OF KIN RULE
										// -------------------------------------------------
										has_next_of_kin = (input.Next_of_Kin != null && input.Next_of_Kin.trim() != "") || (input.Next_of_Kin_Contact != null && input.Next_of_Kin_Contact.toString().trim() != "") || input.Relationship != null;
										if(has_next_of_kin)
										{
											if(input.Next_of_Kin == null || input.Next_of_Kin.trim() == "")
											{
												errors = errors + "\n• Next of Kin name is required when giving contact/relationship.";
											}
											if(input.Next_of_Kin_Contact == null || input.Next_of_Kin_Contact.toString().trim() == "")
											{
												errors = errors + "\n• Next of Kin Contact is required when giving next of kin.";
											}
											if(input.Relationship == null)
											{
												errors = errors + "\n• Relationship is required when giving next of kin.";
											}
										}
										// -------------------------------------------------
										// 4) CONTACT / EMAIL UPDATE DETAILS
										// -------------------------------------------------
										active_contact_rows = 0;
										if(input.Contact_Email_Update_Details != null)
										{
											for each  row_ce in input.Contact_Email_Update_Details
											{
												row_ce.Display_Name_Employee=display_emp;
												ce_ut = ifnull(row_ce.Update_Type,"");
												ce_dn = thisapp.Build_Display_Name(ce_ut,row_ce.Contact,row_ce.Contact_Names,row_ce.Email);
												row_ce.Display_Name_Contact_Name_Email=ce_dn;
												if(ce_ut == "")
												{
													errors = errors + "\n• Update Type is required in Contact / Email Update row.";
												}
												else if(ce_ut.equalsIgnoreCase("Contact"))
												{
													if(row_ce.Contact == null || row_ce.Contact.toString().trim() == "" || row_ce.Contact_Names == null || row_ce.Contact_Names.trim() == "")
													{
														errors = errors + "\n• Contact + Contact Names are required for a Contact update.";
													}
												}
												else if(ce_ut.equalsIgnoreCase("Email"))
												{
													if(row_ce.Email == null || row_ce.Email.trim() == "")
													{
														errors = errors + "\n• Email is required for an Email update.";
													}
													else
													{
														row_ce.Email=row_ce.Email.trim().toLowerCase();
													}
												}
												if(row_ce.Contact_Email_Status == "Active")
												{
													active_contact_rows = active_contact_rows + 1;
												}
												if(ce_dn == "")
												{
													errors = errors + "\n• Display Name could not be built for one Contact / Email Update row.";
												}
											}
										}
										if(active_contact_rows == 0)
										{
											errors = errors + "\n• Add at least one Contact / Email Update row marked Active.";
										}
										// -------------------------------------------------
										// FINAL GATE
										// -------------------------------------------------
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize5 as "Finalize"
			{
				type =  form
				form = Employee_Register

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// EMPLOYEE — FINALIZE (Successful submission)
										// =====================================================
										// =====================================================
										// 2️⃣ CONTACT / EMAIL UPDATE SUBFORM CLEANUP
										// =====================================================
										if(input.Contact_Email_Update_Details != null)
										{
											for each  row_ce in input.Contact_Email_Update_Details
											{
												row_ce.Display_Name_Contact_Name_Email=thisapp.Build_Display_Name(row_ce.Update_Type,row_ce.Contact,row_ce.Contact_Names,row_ce.Email);
												if(row_ce.Update_Voucher_Number != null)
												{
													row_ce.Update_Voucher_Number=row_ce.Update_Voucher_Number.trim().toUpperCase();
												}
												if(row_ce.Update_Date != null && row_ce.Update_Date > zoho.currentdate)
												{
													row_ce.Update_Date=zoho.currentdate;
												}
												if(row_ce.Update_Type != null && row_ce.Update_Type.equalsIgnoreCase("Email") && row_ce.Email != null)
												{
													row_ce.Email=row_ce.Email.trim().toLowerCase();
												}
												if(row_ce.Update_Type != null && row_ce.Update_Type.equalsIgnoreCase("Contact") && row_ce.Contact != null)
												{
													norm_phone = thisapp.normalize_ug_phone(row_ce.Contact);
													row_ce.Contact=norm_phone;
												}
											}
										}
										// =====================================================
										// 3️⃣ EMPLOYEE_DEPARTMENT_DETAILS SUBFORM CLEANUP
										// =====================================================
										if(input.Employee_Department_Details != null)
										{
											for each  row_dept in input.Employee_Department_Details
											{
												if(row_dept.Employee == null && input.ID != null)
												{
													row_dept.Employee=input.ID;
												}
												// ✅ Display field = "Employee Name - Employee Number"
												if(row_dept.Employee != null)
												{
													row_dept.Display_Name_Employee=row_dept.Employee.Employee_Name + " - " + row_dept.Employee.Employee_Number;
												}
												else
												{
													row_dept.Display_Name_Employee=null;
												}
												if(row_dept.Employee_Department != null)
												{
													row_dept.Display_Name_Employee_Department=row_dept.Employee_Department.Display_Name_Department;
												}
												else
												{
													row_dept.Display_Name_Employee_Department=null;
												}
												if(row_dept.Department_End_Date != null && row_dept.Department_End_Date <= zoho.currentdate)
												{
													row_dept.Department_Status="Inactive";
												}
												else if(row_dept.Department_Start_Date != null)
												{
													row_dept.Department_Status="Active";
												}
												else
												{
													row_dept.Department_Status=null;
												}
											}
										}
										// =====================================================
										// 3️⃣B SITE_ASSIGNED SUBFORM CLEANUP
										// =====================================================
										if(input.Site_Assigned != null)
										{
											for each  sa_row in input.Site_Assigned
											{
												if(sa_row.Employee == null && input.ID != null)
												{
													sa_row.Employee=input.ID;
												}
												// ✅ Display field = "Employee Name - Employee Number"
												if(sa_row.Employee != null)
												{
													sa_row.Display_Name_Employee=sa_row.Employee.Employee_Name + " - " + sa_row.Employee.Employee_Number;
												}
												else
												{
													sa_row.Display_Name_Employee=null;
												}
												if(sa_row.Site != null)
												{
													sa_row.Display_Name_Site=sa_row.Site.Display_Name_Asset_Name;
												}
												else
												{
													sa_row.Display_Name_Site=null;
												}
											}
										}
										// =====================================================
										// 4️⃣ EMPLOYEE_STATUS_DETAILS SUBFORM CLEANUP
										//    + derive overall_active_status ONLY if any row is Active
										// =====================================================
										overall_active_status = "Inactive";
										if(input.Employee_Status_Details != null)
										{
											for each  row_status in input.Employee_Status_Details
											{
												if(row_status.Employee_Status_Voucher_Number != null)
												{
													row_status.Employee_Status_Voucher_Number=row_status.Employee_Status_Voucher_Number.trim().toUpperCase();
												}
												row_status.Employment_Status=thisapp.compute_employment_status(row_status.Date_Started,row_status.Date_Ended);
												estMap = thisapp.compute_estimated_takes(row_status.Daily_Allowance,row_status.Weekly_Allowance,row_status.Monthly_Salary);
												row_status.Estimated_Take_per_day=estMap.get("per_day");
												row_status.Estimated_Take_per_month=estMap.get("per_month");
												// ✅ If any row is Active → overall is Active, stop checking further
												if(row_status.Employment_Status == "Active")
												{
													overall_active_status = "Active";
													break;
												}
											}
										}
										// =====================================================
										// 5️⃣ PUSH OVERALL EMPLOYMENT STATUS TO EMPLOYEE HEADER
										// =====================================================
										emp_rec = Employee_Register[ID == input.ID];
										if(emp_rec.count() > 0)
										{
											emp_rec.Employment_Status=overall_active_status;
										}
										// =====================================================
										// 6️⃣ CASCADE EMPLOYMENT STATUS INTO EMPLOYEE_DEPARTMENT rows
										// =====================================================
										if(input.Employee_Department_Details != null)
										{
											for each  row_dept in input.Employee_Department_Details
											{
												row_dept.Employment_Status=overall_active_status;
											}
										}
										// =====================================================
										// 7️⃣ CASCADE EMPLOYMENT STATUS INTO SITE_ASSIGNED rows ✅
										//    + Auto-inactivate Site_Assigned_Status when employment is Inactive
										// =====================================================
										if(input.Site_Assigned != null)
										{
											for each  sa_row in input.Site_Assigned
											{
												// Always sync Employment_Status
												sa_row.Employment_Status=overall_active_status;
												// If employee is not active overall, force site assignment inactive
												if(overall_active_status == "Inactive")
												{
													sa_row.Site_Assigned_Status="Inactive";
												}
												else
												{
													// If employee is active overall, keep status as-is,
													// but if blank, default it to Active
													if(sa_row.Site_Assigned_Status == null || sa_row.Site_Assigned_Status.trim() == "")
													{
														sa_row.Site_Assigned_Status="Active";
													}
												}
											}
										}
						)
					}
				}

			}
