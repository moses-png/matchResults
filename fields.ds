			On_Account_From_Selected as "On Account From Selected"
			{
				type =  form
				form = Transfer_Funds

				record event = on add or edit

				on user input of Account_From
				{
					actions 
					{
						custom deluge script
						(
											if(input.Account_From != null)
										{
											input.Display_Name_Account_From = input.Account_From.Account_Name;
										}
										else
										{
											input.Display_Name_Account_From = null;
										}
						)
					}
				}

			}
