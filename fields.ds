											{
												input.Phone_Used_Site = "Gomba Site - ARA075";
											}
											if(ifnull(input.User_Email,"").toLowerCase().startsWith("xeno"))
											{
												input.Phone_Used_Site = "Gomba Site - ARA075";
											}
											if(ifnull(input.User_Email,"").toLowerCase().startsWith("phmab001"))
											{
												input.Phone_Used_Site = "Kakoni Site - ARA070";
											}
											if(ifnull(input.User_Email,"").toLowerCase().startsWith("phmac001"))
											{
												input.Phone_Used_Site = "Freedom City Mall - ARA338";
											}
											if(ifnull(input.User_Email,"").toLowerCase().startsWith("phmae001"))
											{
												input.Phone_Used_Site = "China Site - ARA073";
											}
											if(ifnull(input.User_Email,"").toLowerCase().startsWith("phmaf001"))
											{
												input.Phone_Used_Site = "Seeta Site - ARA068";
											}
											show Bed_Length;
											show Bed_Width;
											show Bed_Height;
											show Bed_Height_2;
											show Truck_Size_1;
											show Truck_Size_2;
											hide Voucher_Footer_Details;
											hide Head_Office_Section;
											// Everything else stays hidden (as you requested)
										}
										// -------------------------
										// 5) EDIT MODE
										// -------------------------
										else
										{
											// Edit + Document Stage = Manager
											if(input.Document_Stage == "Manager")
											{
												// You want to see CONFIRMED inputs + confirmed sizes
												disable Voucher;
												disable Number_Plate;
												disable Truck_Type;
												disable Number_of_Tyres;
												disable Front_Image;
												disable Front_Side_Image;
												show Bed_Length_Confirmed;
												show Bed_Width_Confirmed;
												show Bed_Height_Confirmed;
												show Bed_Height_2_Confirmed;
												show Truck_Size_1_Confirmed;
												show Truck_Size_2_Confirmed;
												hide Voucher_Footer_Details;
												hide Head_Office_Section;
												// Rest not seen (kept hidden)
											}
											// Edit + Document Stage = Head Office
											else if(input.Document_Stage == "Head Office")
											{
												// Show measured
												disable Voucher;
												disable Number_Plate;
												disable Truck_Type;
												disable Number_of_Tyres;
												show Bed_Length;
												show Bed_Width;
												show Bed_Height;
												show Bed_Height_2;
												show Truck_Size_1;
												show Truck_Size_2;
												disable Bed_Length;
												disable Bed_Width;
												disable Bed_Height;
												disable Bed_Height_2;
												disable Truck_Size_1;
												disable Truck_Size_2;
												// show Time_Measured;
												// Show confirmed
												show Bed_Length_Confirmed;
												show Bed_Width_Confirmed;
												show Bed_Height_Confirmed;
												show Bed_Height_2_Confirmed;
												show Truck_Size_1_Confirmed;
												show Truck_Size_2_Confirmed;
												disable Bed_Length_Confirmed;
												disable Bed_Width_Confirmed;
												disable Bed_Height_Confirmed;
												disable Bed_Height_2_Confirmed;
												disable Truck_Size_1_Confirmed;
												disable Truck_Size_2_Confirmed;
												// show Time_Confirmed;
												// Show differences
												show Bed_Length_Difference;
												show Bed_Width_Difference;
												show Bed_Height_Difference;
												show Bed_Height_2_Difference;
												show Truck_Size_1_Difference;
												show Truck_Size_2_Difference;
												// Show status + stage + verification
												show Measurement_Status;
												enable Measurement_Status;
												show Document_Stage;
												show Measurement_Checkbox;
												enable Measurement_Checkbox;
												show Time_Checked;
												show Head_Office_Supervisor;
												enable Head_Office_Supervisor;
											}
											else if(input.Document_Stage == "Completed")
											{
