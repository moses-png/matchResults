			On_Daily_Allowance_Select as "On Daily Allowance Selected"
			{
				type =  form
				form = Employment_Status

				record event = on add or edit

				on user input of Daily_Allowance
				{
					actions 
					{
						custom deluge script
						(
											dailyAllowance = ifnull(input.Daily_Allowance,0);
										weeklyAllowance = ifnull(input.Weekly_Allowance,0);
										monthlySalary = ifnull(input.Monthly_Salary,0);
										weeklyPerDay = weeklyAllowance / 7;
										monthlyPerDay = monthlySalary / 30;
										input.Estimated_Take_per_day = dailyAllowance + weeklyPerDay + monthlyPerDay;
										input.Estimated_Take_per_month = input.Estimated_Take_per_day * 30;
						)
					}
				}

			}
