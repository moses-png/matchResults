			Full_Validation7 as "Full Validation"
			{
				type =  form
				form = Asset_Transfer_Expense_Detail

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errs = "";
										// 1. Quantity must be greater than 0
										if(input.Quantity != null && input.Quantity <= 0)
										{
											errs = errs + "\n• Quantity must be greater than 0.";
										}
										// 2. Rate cannot be negative
										if(input.Rate != null && input.Rate < 0)
										{
											errs = errs + "\n• Rate cannot be negative.";
										}
										// 3. Finalize Line_Total before save (authoritative math)
										q = ifnull(input.Quantity,0.0);
										r = ifnull(input.Rate,0.0);
										input.Line_Total = round(q * r,2);
										// 4. Stop if there are problems
										if(errs != "")
										{
											alert "Please fix the following:" + errs;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize_ as "Finalize "
			{
				type =  form
				form = Asset_Transfer_Expense_Detail

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											rec = Asset_Transfer_Expense_Detail[ID == input.ID];
										q = ifnull(input.Quantity,0.0);
										r = ifnull(input.Rate,0.0);
										rec.Line_Total=round(q * r,2);
						)
					}
				}

			}
			Finalize2 as "Finalize"
			{
				type =  form
				form = Asset_Transfer_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Asset != null)
										{
											all_vouchers = Asset_Transfer_Voucher[Asset == input.Asset];
											latest_voucher_id = null;
											latest_voucher_date = null;
											for each  v in all_vouchers
											{
												this_v_date = v.Transfer_Voucher_Date;
												this_v_id = v.ID;
												if(latest_voucher_date == null)
												{
													latest_voucher_date = this_v_date;
													latest_voucher_id = this_v_id;
												}
												else
												{
													if(this_v_date > latest_voucher_date)
													{
														latest_voucher_date = this_v_date;
														latest_voucher_id = this_v_id;
													}
													else if(this_v_date == latest_voucher_date)
													{
														if(this_v_id > latest_voucher_id)
														{
															latest_voucher_id = this_v_id;
															latest_voucher_date = this_v_date;
														}
													}
												}
											}
											should_update = false;
											if(latest_voucher_id != null && latest_voucher_id == input.ID)
											{
												should_update = true;
											}
											if(should_update)
											{
												asset_rec = Asset_List[ID == input.Asset];
												if(asset_rec.ID != null)
												{
													site_text = "";
													custodian_text = "";
													if(input.Site_To != null)
													{
														site_text = ifnull(input.Site_To.Asset_Name,"") + " - " + ifnull(input.Site_To.Asset_ID,"");
													}
													if(input.Custodian_To != null)
													{
														custodian_text = ifnull(input.Custodian_To.Employee_Name,"") + " - " + ifnull(input.Custodian_To.Employee_Number,"");
													}
													asset_rec.Current_Site=site_text;
													asset_rec.Current_Custodian=custodian_text;
													asset_rec.Last_Transfer_Date=input.Transfer_Voucher_Date;
													asset_rec.Last_Transfer_Reference=input.Display_Name_Asset_Transfer_Voucher;
												}
												avail_rows = Available_Lists[Asset == input.Asset];
												for each  a in avail_rows
												{
													a.Current_Site=input.Site_To;
													a.Current_Custodian=input.Custodian_To;
													a.Last_Transfer_Date=input.Transfer_Voucher_Date;
													a.Last_Transfer_Reference=input.Display_Name_Asset_Transfer_Voucher;
												}
											}
											else
											{
												info "This transfer voucher is older than the asset's current recorded location. Asset_List was not updated.";
											}
										}
										// ----------------------------------------------------
										// AUTO CREATE / UPDATE BILL DETAILS FROM MOVEMENT EXPENSE DETAILS
										// ----------------------------------------------------
										if(input.Movement_Expense_Details != null && input.Movement_Expense_Details.count() > 0)
										{
											source_text = "";
											asset_text = "";
											current_site_text = "";
											from_text = "";
											to_text = "";
											if(input.Display_Name_Asset_Transfer_Voucher != null && input.Display_Name_Asset_Transfer_Voucher.trim() != "")
											{
												source_text = input.Display_Name_Asset_Transfer_Voucher + " - Asset Transfer Expense";
											}
											else
											{
												source_text = "Asset Transfer Expense";
											}
											if(input.Asset != null)
											{
												asset_text = ifnull(input.Asset.Asset_Name,"") + " - " + ifnull(input.Asset.Asset_ID,"");
											}
											if(input.Site_From != null)
											{
												from_text = ifnull(input.Site_From.Asset_Name,"") + " - " + ifnull(input.Site_From.Asset_ID,"");
											}
											if(input.Site_To != null)
											{
												to_text = ifnull(input.Site_To.Asset_Name,"") + " - " + ifnull(input.Site_To.Asset_ID,"");
												current_site_text = to_text;
											}
											reference_text = asset_text + " from " + from_text + " to " + to_text;
											for each  exp_row in input.Movement_Expense_Details
											{
												if(exp_row.ID != null)
												{
													qty_val = ifnull(exp_row.Quantity,0.0);
													rate_val = ifnull(exp_row.Rate,0.0);
													line_total_val = round(qty_val * rate_val,2);
													existing_bd = Bill_Details[Asset_Transfer_Expense_Detail == exp_row.ID];
													if(existing_bd.count() > 0)
													{
														for each  bd in existing_bd
														{
															bd.Source=source_text;
															bd.Reference=reference_text;
															bd.Asset_Transfer_Expense_Detail=exp_row.ID;
															bd.Display_Name_Item=ifnull(exp_row.Item_Name,"");
															bd.Description=ifnull(exp_row.Description,"");
															bd.Quantity=qty_val;
															bd.Rate=rate_val;
															bd.Line_Total=line_total_val;
															bd.Account=asset_text;
															bd.Current_Site=current_site_text;
															break;
														}
													}
													else
													{
														insert into Bill_Details
														[
															Source=source_text
															Reference=reference_text
															Asset_Transfer_Expense_Detail=exp_row.ID
															Display_Name_Item=ifnull(exp_row.Item_Name,"")
															Description=ifnull(exp_row.Description,"")
															Quantity=qty_val
															Rate=rate_val
															Line_Total=line_total_val
															Account=asset_text
															Current_Site=current_site_text
															Added_User=zoho.loginuser
														]
													}
												}
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete2 as "Finalize On Delete"
			{
				type =  form
				form = Asset_Transfer_Voucher

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Asset != null)
										{
											remaining_vouchers = Asset_Transfer_Voucher[Asset == input.Asset];
											latest_id = null;
											latest_date = null;
											latest_site_to = null;
											latest_custodian_to = null;
											latest_ref = null;
											for each  v in remaining_vouchers
											{
												this_id = v.ID;
												this_date = v.Transfer_Voucher_Date;
												if(latest_date == null)
												{
													latest_date = this_date;
													latest_id = this_id;
													latest_site_to = v.Site_To;
													latest_custodian_to = v.Custodian_To;
													latest_ref = v.Display_Name_Asset_Transfer_Voucher;
												}
												else
												{
													if(this_date > latest_date)
													{
														latest_date = this_date;
														latest_id = this_id;
														latest_site_to = v.Site_To;
														latest_custodian_to = v.Custodian_To;
														latest_ref = v.Display_Name_Asset_Transfer_Voucher;
													}
													else if(this_date == latest_date)
													{
														if(this_id > latest_id)
														{
															latest_date = this_date;
															latest_id = this_id;
															latest_site_to = v.Site_To;
															latest_custodian_to = v.Custodian_To;
															latest_ref = v.Display_Name_Asset_Transfer_Voucher;
														}
													}
												}
											}
											if(latest_id != null)
											{
												site_text = "";
												custodian_text = "";
												if(latest_site_to != null)
												{
													site_text = ifnull(latest_site_to.Asset_Name,"") + " - " + ifnull(latest_site_to.Asset_ID,"");
												}
												if(latest_custodian_to != null)
												{
													custodian_text = ifnull(latest_custodian_to.Employee_Name,"") + " - " + ifnull(latest_custodian_to.Employee_Number,"");
												}
												asset_rec = Asset_List[ID == input.Asset];
												if(asset_rec.ID != null)
												{
													asset_rec.Current_Site=site_text;
													asset_rec.Current_Custodian=custodian_text;
													asset_rec.Last_Transfer_Date=latest_date;
													asset_rec.Last_Transfer_Reference=latest_ref;
												}
												avail_rows = Available_Lists[Asset == input.Asset];
												for each  a in avail_rows
												{
													a.Current_Site=latest_site_to;
													a.Current_Custodian=latest_custodian_to;
													a.Last_Transfer_Date=latest_date;
													a.Last_Transfer_Reference=latest_ref;
												}
											}
											else
											{
												asset_rec2 = Asset_List[ID == input.Asset];
												if(asset_rec2.ID != null)
												{
													asset_rec2.Current_Site=input.Old_Current_Site;
													asset_rec2.Current_Custodian=input.Old_Current_Custodian;
													asset_rec2.Last_Transfer_Date=input.Old_Last_Transfer_Date;
													asset_rec2.Last_Transfer_Reference=input.Old_Last_Transfer_Reference;
												}
												avail_rows2 = Available_Lists[Asset == input.Asset];
												for each  b in avail_rows2
												{
													b.Current_Site=input.Old_Current_Site;
													b.Current_Custodian=input.Old_Current_Custodian;
													b.Last_Transfer_Date=input.Old_Last_Transfer_Date;
													b.Last_Transfer_Reference=input.Old_Last_Transfer_Reference;
												}
											}
										}
						)
					}
				}

			}
			Full_Validation_on_Create1 as "Full Validation on Create"
			{
				type =  form
				form = Asset_List

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.ID == null || isNull(input.Asset_ID) || trim(input.Asset_ID) == "")
										{
											resp = thisapp.asset_codegen.generateAssetRecordLabels("ARC",input.Asset_Name);
											if(resp.get("ok") == false)
											{
												alert resp.get("message");
												cancel submit;
											}
											input.Asset_ID = resp.get("asset_id");
											input.Display_Name_Asset_Name = resp.get("display_name");
										}
										else
										{
											if(input.Asset_Name != null && input.Asset_ID != null)
											{
												input.Display_Name_Asset_Name = input.Asset_Name + " - " + input.Asset_ID;
											}
										}
										if(isNull(input.Display_Name_Asset_Name) || trim(input.Display_Name_Asset_Name) == "")
										{
											alert "Display Name could not be built. Please make sure Asset Name is filled.";
											cancel submit;
										}
						)
					}
				}

			}
			Set_Up_Form as "Set Up Form"
			{
				type =  form
				form = Asset_Issues

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Always disable these fields (both Create + Edit)
										//DISABLE FIELDS
										disable Voucher;
										disable Reported_By;
										disable Site;
										disable Current_Site;
										disable Current_Custodian;
										disable Number_Of_Work_Order_Tasks;
										disable Total_Service_Task_Cost;
										disable Display_Name_Asset;
										disable Status;
										disable Issue_Number;
										disable Reported_Date;
										//disable Issue_Number;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										//HIDE FIELDS
										hide Voucher;
										hide Site;
										hide Number_Of_Work_Order_Tasks;
										hide Total_Service_Task_Cost;
										hide Display_Name_Asset;
										//hide Issue_Number;
										hide Back_End;
										u = thisapp.audit.getLoggedInUserInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										hide Source_Form;
										hide Source_Record_ID;
										hide Source_Details;
										// -------- CREATE MODE --------
										if(input.ID == null)
										{
											// Set defaults so fields never show blank
											if(isNull(input.Number_Of_Work_Order_Tasks))
											{
												input.Number_Of_Work_Order_Tasks = 0;
											}
											if(isNull(input.Total_Service_Task_Cost))
											{
												input.Total_Service_Task_Cost = 0.0;
											}
											// Initial display name setup (if asset already selected by default/lookup)
											if(input.Asset != null)
											{
												input.Display_Name_Asset = ifnull(input.Asset.Display_Name_Asset_Name,"");
											}
											else
											{
												input.Display_Name_Asset = "";
											}
										}
										// -------- EDIT MODE --------
										else
										{
											// On edit, do NOT reset totals/counters
											// Only ensure the display name isn't blank
											if(input.Asset != null && input.Display_Name_Asset == null || input.Display_Name_Asset == "")
											{
												input.Display_Name_Asset = ifnull(input.Asset.Display_Name_Asset_Name,"");
											}
										}
										hide Work_Order_Tasks;
										hide Work_Orders;
						)
					}
				}

			}
			On_Asset_Selected2 as "On Asset Selected"
			{
				type =  form
				form = Asset_Issues

				record event = on add or edit

				on user input of Asset
				{
					actions 
					{
						custom deluge script
						(
											if(input.Asset != null)
										{
											input.Display_Name_Asset = input.Asset.Asset_Name + " - " + input.Asset.Asset_ID;
											input.Current_Site = input.Asset.Current_Site;
											input.Current_Custodian = input.Asset.Current_Custodian;
											if(input.Asset.Odometer_Unit_Of_Measure == "days")
											{
												input.Odometer_Reading = input.Asset.Odometer_Reading;
												// ? Lock the field
												disable Odometer_Reading;
											}
											else
											{
												input.Odometer_Reading = null;
												// ? Allow manual input
												enable Odometer_Reading;
											}
										}
										else
										{
											input.Display_Name_Asset = null;
											input.Current_Site = null;
											input.Current_Custodian = null;
											input.Odometer_Reading = null;
											enable Odometer_Reading;
										}
						)
					}
				}

			}
			Finalize4 as "Finalize"
			{
				type =  form
				form = Asset_Issues

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// OPEN LINKED SOURCE ASSET ISSUE
										// =====================================================
										current_asset_issue_status = ifnull(input.Status,"").toString().trim();
										source_record_id_text = ifnull(input.Source_Record_ID,"").toString().trim();
										source_form = ifnull(input.Source_Form,"").toString().trim();
										if(current_asset_issue_status == "Draft")
										{
											if(source_record_id_text == "")
											{
												info "Source Asset Issue status update skipped because Source_Record_ID is unavailable.";
											}
											else
											{
												open_status_payload = Map();
												open_status_payload.put("Source_Record_ID",source_record_id_text);
												open_status_payload.put("Source_Form",source_form);
												open_status_payload.put("Status","Open");
												open_status_response = Map();
												source_application_name = "";
												source_route_found = true;
												info "SOURCE ASSET ISSUE OPEN STATUS PAYLOAD:";
												info open_status_payload;
												// =================================================
												// FREEDOM CITY MANAGEMENT
												// =================================================
												if(source_form == "Freedom City Management - Asset Issues")
												{
													source_application_name = "Freedom City Management";
													open_status_response = freedom_city_management.asset_issues.updateAssetIssueStatusFromAssetManagement(open_status_payload);
												}
												// =================================================
												// MASAKA SITE MANAGEMENT
												// =================================================
												else if(source_form == "Masaka Site Management - Asset Issues")
												{
													source_application_name = "Masaka Site Management";
													open_status_response = masaka_site_management.updateAssetIssueStatusFromAssetManagement(open_status_payload);
												}
												// =================================================
												// MANAGEWISE MANAGEMENT
												// =================================================
												else if(source_form == "Managewise Management - Asset Issues")
												{
													source_application_name = "Managewise Management";
													open_status_response = managewise_management.updateAssetIssueStatusFromAssetManagement(open_status_payload);
												}
												// =================================================
												// CONCRETE PRODUCTS MANAGEMENT
												// =================================================
												else if(source_form == "Concrete Products Management - Asset Issues")
												{
													source_application_name = "Concrete Products Management";
													open_status_response = concrete_products_management.updateAssetIssueStatusFromAssetManagement(open_status_payload);
												}
												// =================================================
												// CLEAN SAND MANAGEMENT
												// =================================================
												else if(source_form == "Clean Sand Management - Asset Issues")
												{
													source_application_name = "Clean Sand Management";
													open_status_response = clean_sand_management.updateAssetIssueStatusFromAssetManagement(open_status_payload);
												}
												// =================================================
												// FREEDOM CITY KIDS PARK MANAGEMENT
												// =================================================
												else if(source_form == "Freedom City Kids Park Management - Asset Issues")
												{
													source_application_name = "Freedom City Kids Park Management";
													open_status_response = freedom_city_kids_park_management.updateAssetIssueStatusFromAssetManagement(open_status_payload);
												}
												// =================================================
												// KICKS KLEAN UG
												// =================================================
												else if(source_form == "Kicks Klean Ug - Asset Issues")
												{
													source_application_name = "Kicks Klean Ug";
													open_status_response = kicks_klean_ug.updateAssetIssueStatusFromAssetManagement(open_status_payload);
												}
												else
												{
													source_route_found = false;
													info "Source Asset Issue status update skipped because Source_Form is unsupported: " + source_form;
												}
												if(source_route_found == true)
												{
													info source_application_name + " ASSET ISSUE OPEN STATUS RESPONSE:";
													info open_status_response;
													if(ifnull(open_status_response.get("ok"),false) == true)
													{
														input.Status = "Open";
														info source_application_name + " Asset Issue successfully changed to Open.";
														info "Asset Management Asset Issue successfully changed to Open.";
													}
													else
													{
														info source_application_name + " Asset Issue update failed: " + ifnull(open_status_response.get("message"),"Unknown error.");
														input.Status = "Draft";
													}
												}
											}
										}
										else
										{
											info "Source Asset Issue status update skipped because Asset Management status is " + current_asset_issue_status + ", not Draft.";
										}
						)
					}
				}

			}
			Full_Validation as "Full Validation"
			{
				type =  form
				form = Asset_Issues

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(isNull(input.Number_Of_Work_Order_Tasks))
										{
											input.Number_Of_Work_Order_Tasks = 0;
										}
										if(isNull(input.Total_Service_Task_Cost))
										{
											input.Total_Service_Task_Cost = 0.0;
										}
										if(input.Asset != null)
										{
											// Use the Display Name from the Asset_List lookup
											input.Display_Name_Asset = ifnull(input.Asset.Display_Name_Asset_Name,"");
										}
										else
										{
											input.Display_Name_Asset = "";
										}
										if(Asset == null)
										{
											alert "Asset is required.";
											cancel submit;
										}
										if(Odometer_Reading == null)
										{
											alert "Odometer Reading is required.";
											cancel submit;
										}
										if(Issue == "")
										{
											alert "Issue is required.";
											cancel submit;
										}
										if(Issue_Description == "")
										{
											alert "Issue Description is required.";
											cancel submit;
										}
										if(Severity == null)
										{
											alert "Severity is required.";
											cancel submit;
										}
										if(Status == null)
										{
											alert "Status is required.";
											cancel submit;
										}
										// ======================================
										// ODOMETER DATE-SEQUENCE VALIDATION
										// Ignore void mileage logs
										// ======================================
										if(input.Asset != null && input.Odometer_Reading != null)
										{
											recorded_time = zoho.currenttime;
											if(input.Reported_Date != null)
											{
												recorded_time = input.Reported_Date;
											}
											prev_logs = Asset_Mileage_Log[Asset == input.Asset && Date_Time_Recorded < recorded_time && Void_Mileage == false || Void_Mileage == null] sort by Date_Time_Recorded desc;
											for each  prev in prev_logs
											{
												prev_odo = ifnull(prev.Odometer_Reading,0.0);
												if(input.Odometer_Reading < prev_odo)
												{
													alert "Odometer Reading cannot be less than the previous valid mileage reading.";
													cancel submit;
												}
												break;
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete as "Finalize On Delete"
			{
				type =  form
				form = Asset_Issues

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											source_form = "Asset Issues";
										source_record_id_str = input.ID.toString();
										// Get all logs for this source form
										logs_to_delete = Asset_Mileage_Log[Odometer_Source_Form == source_form];
										for each  log_row in logs_to_delete
										{
											if(log_row.Source_Record_ID != null && log_row.Source_Record_ID.toString() == source_record_id_str)
											{
												delete from Asset_Mileage_Log[ID == log_row.ID];
												break;
											}
										}
						)
					}
				}

			}
