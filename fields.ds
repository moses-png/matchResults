			On_Cancelled_Selected2 as "On Cancelled Selected"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on user input of Cancelled
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancelled == true)
										{
											show Reason_Why_Cancelled;
											enable Reason_Why_Cancelled;
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = null;
										}
						)
					}
				}

			}
			On_Odometer_Start_Selecte2 as "On Odometer Start Selected"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on user input of Odometer_Start
				{
					actions 
					{
						custom deluge script
						(
											if(input.Odometer_Start != null)
										{
											if(input.Odometer_End != null)
											{
												if(input.Odometer_Start <= input.Odometer_End)
												{
													input.Line_Hours_Worked = input.Odometer_End - input.Odometer_Start;
												}
												else
												{
													alert "Odometer Start cannot be greater than Odometer End";
													input.Odometer_Start = null;
													input.Line_Hours_Worked = null;
												}
											}
											else
											{
												input.Line_Hours_Worked = null;
											}
										}
										else
										{
											input.Line_Hours_Worked = null;
										}
						)
					}
				}

			}
			On_Odometer_End_Selected2 as "On Odometer End Selected"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on user input of Odometer_End
				{
					actions 
					{
						custom deluge script
						(
											if(input.Odometer_Start != null && input.Odometer_End != null)
										{
											if(input.Odometer_End >= input.Odometer_Start)
											{
												input.Line_Hours_Worked = input.Odometer_End - input.Odometer_Start;
											}
											else
											{
												alert "Odometer End cannot be less than Odometer Start";
												input.Odometer_End = null;
												input.Line_Hours_Worked = null;
											}
										}
										else
										{
											input.Line_Hours_Worked = null;
										}
						)
					}
				}

			}
			On_Time_End_Selected2 as "On Time End Selected"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on user input of Time_End
				{
					actions 
					{
						custom deluge script
						(
											if(input.Time_Start != null && input.Time_End != null)
										{
											diffMillis = input.Time_End.toLong() - input.Time_Start.toLong();
											if(diffMillis >= 0)
											{
												input.Line_Duration_Minutes = round(diffMillis / 60000.0,2);
											}
											else
											{
												alert "Time End cannot be before Time Start";
												input.Time_End = null;
												input.Line_Duration_Minutes = null;
											}
										}
										else
										{
											input.Line_Duration_Minutes = null;
										}
						)
					}
				}

			}
