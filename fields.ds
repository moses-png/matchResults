			On_Party_From_Selected as "On Party From Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Party_From
				{
					actions 
					{
						custom deluge script
						(
											if(input.Party_From != null)
										{
											partyName = ifnull(input.Party_From.Party_Name,"").toString();
											partyID = ifnull(input.Party_From.Party_ID,"").toString();
											if(!isNull(partyName) && !isNull(partyID))
											{
												input.Display_Name_Party_From = partyName + " - " + partyID;
											}
											else if(!isNull(partyName))
											{
												input.Display_Name_Party_From = partyName;
											}
											else if(!isNull(partyID))
											{
												input.Display_Name_Party_From = partyID;
											}
											else
											{
												input.Display_Name_Party_From = "";
											}
											if(input.Party_Location_From != null)
											{
												input.Pick_Up_From = input.Display_Name_Party_From + " - " + input.Party_Location_From.Location_Name;
											}
											else
											{
												input.Pick_Up_From = input.Display_Name_Party_From;
											}
										}
										else
										{
											input.Display_Name_Party_From = "";
											input.Party_Location_From = null;
											input.Pick_Up_From = "";
										}
						)
					}
				}

			}
