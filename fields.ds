			Full_Validation16 as "Full Validation"
			{
				type =  form
				form = Machine_Start_Of_Day

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// MACHINE START OF DAY -> FULL VALIDATION
										// =====================================================
										is_create = input.ID == null;
										errors = "";
										// =====================================================
										// 1. DOCUMENT SOURCE VALIDATION
										// =====================================================
										document_source = ifnull(input.Document_Source,"").trim();
										if(document_source == "")
										{
											errors = errors + "\n• Document Source is required.";
										}
										// =====================================================
										// 2. DOCUMENT-SOURCE VOUCHER VALIDATION
										// =====================================================
										if(document_source == "Masaka Site Management")
										{
											if(input.Employee_Voucher_Masaka == null)
											{
												errors = errors + "\n• Employee Voucher is required for Masaka Site Management.";
											}
											else
											{
												existing = Machine_Start_Of_Day[Employee_Voucher_Masaka == input.Employee_Voucher_Masaka && ID != input.ID];
												if(existing.count() > 0)
												{
													errors = errors + "\n• A Record already exists for this Voucher.";
												}
											}
										}
										else if(document_source == "Clean Sand Management")
										{
											if(input.Employee_Voucher_Clean_Sand == null)
											{
												errors = errors + "\n• Voucher is required for Clean Sand Management.";
											}
											else
											{
												existing = Machine_Start_Of_Day[Employee_Voucher_Clean_Sand == input.Employee_Voucher_Clean_Sand && ID != input.ID];
												if(existing.count() > 0)
												{
													errors = errors + "\n• A Record already exists for this Voucher.";
												}
											}
										}
										else if(document_source == "Concrete Products Management")
										{
											if(input.Employee_Voucher_Concrete_Products == null)
											{
												errors = errors + "\n• Asset Voucher is required for Concrete Products Management.";
											}
											else
											{
												existing = Machine_Start_Of_Day[Employee_Voucher_Concrete_Products == input.Employee_Voucher_Concrete_Products && ID != input.ID];
												if(existing.count() > 0)
												{
													errors = errors + "\n• A Record already exists for this Voucher.";
												}
											}
										}
										else if(document_source == "Freedom City Management")
										{
											if(input.Employee_Voucher_Freedom_City == null)
											{
												errors = errors + "\n• Machine Voucher is required for Freedom City Management.";
											}
											else
											{
												existing = Machine_Start_Of_Day[Employee_Voucher_Freedom_City == input.Employee_Voucher_Freedom_City && ID != input.ID];
												if(existing.count() > 0)
												{
													errors = errors + "\n• A Record already exists for this Voucher.";
												}
											}
										}
										else if(document_source != "")
										{
											errors = errors + "\n• The selected Document Source is not recognized.";
										}
										// =====================================================
										// 3. CREATE VALIDATION
										// =====================================================
										if(is_create)
										{
											if(input.Asset == null)
											{
												errors = errors + "\n• Asset is required.";
											}
											if(input.Odometer_Start == null)
											{
												errors = errors + "\n• Odometer Start is required.";
											}
											//if(input.Odometer_Start_Image == null || input.Odometer_Start_Image.isEmpty())
											//{
											//errors = errors + "\n• Odometer Start Image is required.";
											//}
										}
										// =====================================================
										// 4. EDIT VALIDATION
										// =====================================================
										else
										{
											if(input.Odometer_End == null)
											{
												errors = errors + "\n• Odometer End is required.";
											}
											if(input.Odometer_End_Image == null || input.Odometer_End_Image.isEmpty())
											{
												errors = errors + "\n• Odometer End Image is required.";
											}
											if(input.Odometer_Start != null && input.Odometer_End != null)
											{
												if(input.Odometer_End < input.Odometer_Start)
												{
													errors = errors + "\n• Odometer End cannot be less than Odometer Start.";
												}
											}
										}
										// =====================================================
										// 5. BLOCK SUBMISSION
										// =====================================================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize11 as "Finalize"
			{
				type =  form
				form = Machine_Start_Of_Day

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// MACHINE START OF DAY -> FINALIZE
										// =====================================================
										now_ts = zoho.currenttime;
										is_create = false;
										if(input.Added_Time != null && input.Modified_Time != null)
										{
											if(input.Added_Time.toLong() == input.Modified_Time.toLong())
											{
												is_create = true;
											}
										}
										// =====================================================
										// 2. ON CREATE
										// =====================================================
										if(is_create)
										{
											if(input.Time_Started == null)
											{
												input.Time_Started = now_ts;
											}
											if(input.Voucher_Status == null || input.Voucher_Status.trim() == "")
											{
												input.Voucher_Status = "Open";
											}
										}
										// =====================================================
										// 3. ON EDIT
										// =====================================================
										else
										{
											if(input.Odometer_End != null)
											{
												if(input.Time_Ended == null)
												{
													input.Time_Ended = now_ts;
												}
												input.Voucher_Status = "Closed";
											}
										}
						)
					}
				}

			}
