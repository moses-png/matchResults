			{
				type =  form
				form = Stock_Receiving_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Stock Receiving Voucher Validation
										// On Create / On Validate
										// =======================================
										if(input.Stock_Receiving_Book == null)
										{
											alert "Please select Stock Receiving Book.";
											cancel submit;
										}
										if(input.Store == null)
										{
											alert "Please select the Store.";
											cancel submit;
										}
										if(input.Received_By == null || input.Received_By.trim() == "")
										{
											alert "Received By is required.";
											cancel submit;
										}
										existing_rec = Stock_Receiving_Voucher[Stock_Receiving_Book == input.Stock_Receiving_Book && ID != input.ID];
										if(existing_rec.ID != null)
										{
											alert "This Stock Receiving Book has already been used.";
											cancel submit;
										}
						)
					}
				}

			}
			Finalize5 as "Finalize"
			{
				type =  form
				form = Asset_Issues

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// KICKS KLEAN UG - ASSET ISSUE FINALIZE
										// =====================================================
										current_issue_status = ifnull(input.Issue_Status,"").toString().trim();
										current_work_order_status = ifnull(input.Work_Order_Status,"").toString().trim();
										has_work_order = false;
										if(input.Work_Order_Number != null && input.Work_Order_Number.toString().trim() != "")
										{
											has_work_order = true;
										}
										if(input.Asset != null && input.ID != null)
										{
											mile_log_resp = asset_management.logMileageFromKicks_Klean_Ug(input.Asset.ID,ifnull(input.Odometer_Reading,0.0),input.Reported_Date,ifnull(input.Issue_Number,""),"Asset Issues",input.ID.toString());
											info "KICKS KLEAN UG ASSET ISSUE MILEAGE RESPONSE:";
											info mile_log_resp;
										}
										else if(input.Asset == null)
										{
											info "Mileage log skipped because Asset is unavailable.";
										}
										else
										{
											info "Mileage log skipped because Source Record ID is unavailable.";
										}
										if(input.Resolve_Issue == true)
										{
											input.Issue_Status = "Resolved";
											input.Work_Order_Status = "Cancelled";
										}
										else if(input.Cancel_Work_Order == true)
										{
											input.Issue_Status = "Cancelled";
											input.Work_Order_Status = "Cancelled";
										}
										else if(has_work_order == true)
										{
											if(current_issue_status != "Resolved" && current_issue_status != "Cancelled")
											{
												input.Issue_Status = "In Progress";
											}
											else
											{
												input.Issue_Status = current_issue_status;
											}
											if(current_work_order_status == "" || current_work_order_status == "Draft")
											{
												input.Work_Order_Status = "Pending";
											}
											else
											{
												input.Work_Order_Status = current_work_order_status;
											}
										}
										else
										{
											if(current_issue_status == "")
											{
												input.Issue_Status = "Draft";
											}
											else
											{
												input.Issue_Status = current_issue_status;
											}
											if(current_work_order_status == "")
											{
												input.Work_Order_Status = "Draft";
											}
											else
											{
												input.Work_Order_Status = current_work_order_status;
											}
										}
										status_to_sync = ifnull(input.Issue_Status,"").toString().trim();
										if(status_to_sync == "")
										{
											status_to_sync = "Draft";
											input.Issue_Status = "Draft";
										}
										if(input.ID != null)
										{
											asset_issue_payload = Map();
											asset_issue_payload.put("Source_Record_ID",input.ID);
											asset_issue_payload.put("Source_Form","Kicks Klean Ug - Asset Issues");
											asset_issue_payload.put("Voucher",input.Voucher);
											asset_issue_payload.put("Reported_By",input.Reported_By);
											asset_issue_payload.put("Site",input.Site);
											asset_issue_payload.put("Issue_Number",input.Issue_Number);
											asset_issue_payload.put("Asset",input.Asset);
											asset_issue_payload.put("Display_Name_Asset",input.Display_Name_Asset);
											asset_issue_payload.put("Current_Site",input.Current_Site);
											asset_issue_payload.put("Current_Custodian",input.Current_Custodian);
											asset_issue_payload.put("Odometer_Reading",ifnull(input.Odometer_Reading,0.0));
											asset_issue_payload.put("Reported_Date",input.Reported_Date);
											asset_issue_payload.put("Issue",input.Issue);
											asset_issue_payload.put("Issue_Description",input.Issue_Description);
											asset_issue_payload.put("Severity",input.Severity);
											asset_issue_payload.put("Status",status_to_sync);
											info "KICKS KLEAN UG ASSET ISSUE SYNC PAYLOAD:";
											info asset_issue_payload;
											asset_issue_response = asset_management.syncAssetIssueFromKicksKleanUg(asset_issue_payload);
											info "KICKS KLEAN UG ASSET ISSUE SYNC RESPONSE:";
											info asset_issue_response;
											if(ifnull(asset_issue_response.get("ok"),false) == true)
											{
												info "KICKS KLEAN UG ASSET ISSUE SYNC SUCCESSFUL: " + ifnull(asset_issue_response.get("message"),"Asset Issue synchronized successfully.");
											}
											else
											{
												info "KICKS KLEAN UG ASSET ISSUE SYNC FAILED: " + ifnull(asset_issue_response.get("message"),"Unknown synchronization error.");
											}
										}
										else
										{
											info "Kicks Klean Ug Asset Issue sync skipped because Source Record ID is unavailable.";
										}
						)
					}
				}

			}
			Set_Up_Form19 as "Set Up Form"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// Stock Receiving Details -> Set Up Form
										// ======================================
										// ===============================
										// BACK END
										// ===============================
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// Logged-in user info
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// --------------------------------------
										// Always hide helper/display fields
										// --------------------------------------
										hide Display_Name_Stock_Receiving_Voucher;
										hide Display_Name_Voucher;
										hide Display_Name_Item;
										hide Display_Name_Unit_Of_Measure_Received;
										hide Display_Name_Received_By;
										hide Display_Name_Receiving_Type;
										// --------------------------------------
										// Always lock calculated / system fields
										// --------------------------------------
										disable Store;
										disable Quantity_to_Receive;
										disable Display_Name_Unit_Of_Measure_to_Receive;
										disable Quantity_in_Base_Unit_Of_Measure_Received;
										disable Display_Name_Unit_Of_Measure_Received;
										disable Display_Name_Unit_Of_Measure_to_Receive;
										disable Stock_Receiving_Voucher_and_Number;
										disable Stock_Receiving_Details_Status;
										disable Rate;
										disable Line_Total;
										// --------------------------------------
										// Hide fields by default
										// --------------------------------------
										hide Rate;
										hide Line_Total;
										hide Purchase_Order;
										hide Voucher;
										hide Item;
										hide Transfer_Item;
										hide Internal_Transfer_Number;
										hide Stock_Return_Number;
										hide Item_Issuing_Details;
										hide Tool_Return_Number;
										// --------------------------------------
										// Disable source fields by default
										// --------------------------------------
										disable Purchase_Order;
										disable Voucher;
										disable Item;
										disable Transfer_Item;
										disable Internal_Transfer_Number;
										disable Stock_Return_Number;
										disable Item_Issuing_Details;
										// --------------------------------------
										// CREATE MODE (New Record)
										// --------------------------------------
										if(input.ID == null)
										{
											show Stock_Receiving_Voucher;
											show Stock_Receiving_Voucher_Number;
											show Stock_Condition;
											show Notes;
											show Quantity_to_Receive;
											show Quantity_Received;
											show Unit_Of_Measure_Received;
											enable Stock_Receiving_Voucher;
											enable Stock_Receiving_Voucher_Number;
											enable Stock_Condition;
											enable Notes;
											enable Quantity_Received;
											enable Unit_Of_Measure_Received;
											disable Quantity_to_Receive;
											if(input.Receiving_Type == "Purchase Order")
											{
												show Purchase_Order;
												show Item;
												enable Purchase_Order;
												enable Item;
											}
											else if(input.Receiving_Type == "Internal Transfer")
											{
												show Internal_Transfer_Number;
												show Transfer_Item;
												enable Internal_Transfer_Number;
												enable Transfer_Item;
											}
											else if(input.Receiving_Type == "Stock Return")
											{
												show Stock_Return_Number;
												show Item_Issuing_Details;
												enable Stock_Return_Number;
												enable Item_Issuing_Details;
											}
											else if(input.Receiving_Type == "Tool Return")
											{
												show Tool_Return_Number;
												enable Item_Issuing_Details;
											}
											else
											{
												hide Purchase_Order;
												hide Voucher;
												hide Item;
												hide Transfer_Item;
												hide Internal_Transfer_Number;
												hide Tool_Return_Number;
												hide Item_Issuing_Details;
											}
										}
										// --------------------------------------
										// EDIT MODE
										// --------------------------------------
										else
										{
											disable Stock_Receiving_Voucher;
											disable Stock_Receiving_Voucher_Number;
											enable Stock_Condition;
											disable Notes;
											enable Quantity_Received;
											disable Unit_Of_Measure_Received;
											if(input.Receiving_Type == "Purchase Order")
											{
												show Purchase_Order;
												show Item;
												disable Purchase_Order;
												disable Item;
											}
											else if(input.Receiving_Type == "Internal Transfer")
											{
												show Internal_Transfer_Number;
												show Transfer_Item;
												disable Internal_Transfer_Number;
												disable Transfer_Item;
											}
											else if(input.Receiving_Type == "Stock Return")
											{
												show Stock_Return_Number;
												show Item_Issuing_Details;
												disable Stock_Return_Number;
												disable Item_Issuing_Details;
											}
											else if(input.Receiving_Type == "Tool Return")
											{
												show Tool_Return_Number;
												disable Item_Issuing_Details;
											}
											else
											{
												hide Purchase_Order;
												hide Voucher;
												hide Item;
												hide Transfer_Item;
												hide Internal_Transfer_Number;
												hide Stock_Return_Number;
												hide Tool_Return_Number;
												hide Item_Issuing_Details;
											}
										}
						)
					}
				}

			}
