			On_Receiving_Account_Sele as "On Receiving Account Selected"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on user input of Receiving_Account
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ON RECEIVING ACCOUNT SELECTED
										// =====================================================
										if(input.Receiving_Account != null)
										{
											input.Display_Name_Receiving_Account = ifnull(input.Receiving_Account.Account_Name,"");
											account_type = "";
											if(input.Receiving_Account.Account_Type != null)
											{
												account_type = ifnull(input.Receiving_Account.Account_Type.Account_Type_Name,"").trim();
											}
											input.Account_Type = account_type;
											if(account_type == "Cash Account")
											{
												disable Payment_Receipt_Number;
												input.Payment_Receipt_Number = "";
											}
											else if(account_type == "Mobile Money Account")
											{
												enable Payment_Receipt_Number;
												input.Payment_Receipt_Number = "";
											}
											else
											{
												disable Payment_Receipt_Number;
												input.Payment_Receipt_Number = "";
											}
										}
										else
										{
											input.Account_Type = "";
											disable Payment_Receipt_Number;
											input.Payment_Receipt_Number = "";
										}
						)
					}
				}

			}
			On_Voucher_Selected as "On Voucher Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Voucher != null)
										{
											input.Display_Name_Voucher = input.Voucher.Voucher_Number;
											input.Display_Name_Employee = input.Voucher.Display_Name_Employee;
											input.Display_Name_Site = input.Voucher.Display_Name_Site;
										}
										else
										{
											input.Display_Name_Voucher = "";
											input.Display_Name_Employee = "";
											input.Display_Name_Site = "";
										}
						)
					}
				}

			}
			On_Discount_Type_Selected as "On Discount Type Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Discount_Type
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// DISCOUNT
										// =====================================================
										if(input.Discount_Type == "None")
										{
											input.Discount_Percentage = 0;
											input.Discount_Amount = 0;
											hide Discount_Percentage;
											hide Discount_Amount;
										}
										else if(input.Discount_Type == "Percentage")
										{
											show Discount_Percentage;
											show Discount_Amount;
											enable Discount_Percentage;
											disable Discount_Amount;
											input.Discount_Amount = round(ifnull(input.Sub_Total,0) * ifnull(input.Discount_Percentage,0) / 100,2);
										}
										else if(input.Discount_Type == "Amount")
										{
											input.Discount_Percentage = 0;
											hide Discount_Percentage;
											show Discount_Amount;
											enable Discount_Amount;
										}
										// =====================================================
										// TOTALS
										// =====================================================
										input.Grand_Total = round(ifnull(input.Sub_Total,0) + ifnull(input.Tax_Amount,0) - ifnull(input.Discount_Amount,0),2);
										if(input.Grand_Total < 0)
										{
											input.Grand_Total = 0;
										}
										input.Balance_Due = round(ifnull(input.Grand_Total,0) - ifnull(input.Amount_Paid,0),2);
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0;
										}
						)
					}
				}

			}
			On_Discount_Amount_Select as "On Discount Amount Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Discount_Amount
				{
					actions 
					{
						custom deluge script
						(
											if(input.Discount_Amount == null)
										{
											input.Discount_Amount = 0;
										}
										if(input.Discount_Amount > ifnull(input.Sub_Total,0))
										{
											alert "Discount Amount cannot be greater than Sub Total.";
											input.Discount_Amount = ifnull(input.Sub_Total,0);
										}
										input.Grand_Total = ifnull(input.Sub_Total,0) + ifnull(input.Tax_Amount,0) - ifnull(input.Discount_Amount,0);
										input.Balance_Due = ifnull(input.Grand_Total,0) - ifnull(input.Amount_Paid,0);
						)
					}
				}

			}
			On_Discount_Percentage_Se as "On Discount Percentage Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Discount_Percentage
				{
					actions 
					{
						custom deluge script
						(
											if(input.Discount_Percentage != null)
										{
											input.Discount_Amount = ifnull(input.Sub_Total,0) * input.Discount_Percentage / 100;
										}
										else
										{
											input.Discount_Amount = 0;
										}
										input.Grand_Total = ifnull(input.Sub_Total,0) + ifnull(input.Tax_Amount,0) - ifnull(input.Discount_Amount,0);
										input.Balance_Due = ifnull(input.Grand_Total,0) - ifnull(input.Amount_Paid,0);
						)
					}
				}

			}
			On_Sales_Type_Selected as "On Sales Type Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Sales_Type
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// SALES TYPE - ON USER INPUT
										// =====================================================
										if(input.Sales_Type == "Item Sales")
										{
											show Item_Details;
											hide Shoe_Services;
										}
										else if(input.Sales_Type == "Shoe Services")
										{
											show Shoe_Services;
											hide Item_Details;
										}
										else if(input.Sales_Type == "Sales and Services")
										{
											show Shoe_Services;
											show Item_Details;
										}
										else
										{
											hide Shoe_Services;
											hide Item_Details;
										}
						)
					}
				}

			}
			Add_Row_Item_Details as "Add Row Item Details"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on add row of Item_Details
				{
					actions 
					{
						custom deluge script
						(
											// 1) Fill tracking + customer on all rows
										for each  itemRow in input.Item_Details
										{
											itemRow.Display_Name_Sales_Voucher=input.Sales_Voucher_Number;
											itemRow.Display_Name_Site=input.Display_Name_Site;
										}
										// 2) Re-number rows + build Shoe Detail
										lineNo = 0;
										for each  itemRow in input.Item_Details
										{
											lineNo = lineNo + 1;
											itemRow.Line_Number=lineNo;
										}
										total_subtotal = 0;
										// Item Details total
										for each  item_row in input.Item_Details
										{
											total_subtotal = total_subtotal + ifnull(item_row.Line_Total,0);
										}
										input.Sub_Total = total_subtotal;
						)
					}
				}

			}
			Finalize_On_Edit11 as "Finalize On Edit"
			{
				type =  form
				form = Voucher_Register

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Updated_By_Name = u.get("name");
										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
						)
					}
				}

			}
			Set_Up_Form11 as "Set Up Form"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------
										// 0) GET VOUCHER TYPE
										// ------------------------------
										voucherType = "";
										if(input.Voucher_Type != null)
										{
											voucherType = ifnull(input.Voucher_Type.Voucher_Type,"").trim();
										}
										input.Display_Name_Voucher_Type = voucherType;
										// ------------------------------
										// 1) ALWAYS DISABLE
										// ------------------------------
										disable Display_Name_Employee;
										disable Display_Name_Issued_By;
										disable Date_Time_In;
										disable Display_Name_Site;
										disable Received_By;
										disable Display_Name_Received_By;
										disable Date_Time_Out;
										disable Hours_Worked;
										disable Shift;
										disable Voucher_Status;
										disable Opening_Vouchers;
										disable Vouchers_Issued;
										disable Vouchers_Returned;
										disable Outstanding_Vouchers;
										disable Employee_Cost;
										disable Voucher_Cost;
										disable Manager_Time;
										disable Cancel_Voucher;
										disable Cancellation_Reason;
										disable Employee_Taking_To_Head_Office;
										disable How_to_Take_to_Head_Office;
										disable Time_Sent_to_Head_Office;
										disable Seen;
										disable Reason_for_not_Seen;
										disable Time_Checked;
										disable Hr_Time_Checked;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// ===============================
										// EMPLOYEE ISSUING DETAILS
										// ===============================
										hide Employee_Issuing_Details;
										hide Employee_Issuing_Details.Display_Name_Voucher;
										hide Employee_Issuing_Details.Source_Record_ID;
										hide Employee_Issuing_Details.Source_Form;
										// ===============================
										// EMPLOYEE RECEIVING DETAILS
										// ===============================
										hide Employee_Receiving_Details;
										hide Employee_Receiving_Details.Source_Record_ID;
										hide Employee_Receiving_Details.Source_Form;
										// ===============================
										// INCIDENT DETAILS
										// ===============================
										// ===============================
										// KITCHEN VOUCHER DETAILS
										// ===============================
										// ==============================
										// VOUCHER ISSUING DETAILS
										// ===============================
										hide Voucher_Issuing_Details;
										hide Voucher_Issuing_Details.Display_Name_Voucher;
										hide Voucher_Issuing_Details.User_Name;
										hide Voucher_Issuing_Details.User_Email;
										hide Voucher_Issuing_Details.User_Role;
										hide Voucher_Issuing_Details.Created_By_Name;
										hide Voucher_Issuing_Details.Created_By_Email;
										hide Voucher_Issuing_Details.Created_By_Time;
										hide Voucher_Issuing_Details.Updated_By_Name;
										hide Voucher_Issuing_Details.Updated_By_Email;
										hide Voucher_Issuing_Details.Updated_By_Time;
										// ===============================
										// VOUCHER RECEIVING DETAILS
										// ===============================
										hide Voucher_Receiving_Details;
										hide Voucher_Receiving_Details.Source_Record_ID;
										hide Voucher_Receiving_Details.Source_Form;
										// ===============================
										// STOCK BUNDLING NOTE
										// ===============================
										// ===============================
										// TRUCK MEASUREMENT DETAILS
										// ===============================
										// ===============================
										// TRUCK MOVEMENT DETAILS
										// ===============================
										// ------------------------------
										// 2) ALWAYS HIDE
										// ------------------------------
										hide Issued_By;
										hide Display_Name_Issued_By;
										hide Display_Name_Voucher_Type;
										hide Display_Name_Employee;
										hide Date_Time_In;
										hide Site;
										hide Display_Name_Site;
										hide Voucher_Return;
										hide Display_Name_Received_By;
										hide Date_Time_Out;
										hide Hours_Worked;
										hide Shift;
										hide Voucher_Status;
										hide Shift_Voucher_Summary;
										hide Opening_Vouchers;
										hide Vouchers_Issued;
										hide Vouchers_Returned;
										hide Outstanding_Vouchers;
										hide Voucher_Header;
										hide Voucher_Footer;
										hide Employee_Cost;
										hide Voucher_Cost;
										hide Manager_Section;
										hide Manager_Time;
										hide Cancel_Voucher;
										hide Cancellation_Reason;
										hide Employee_Taking_To_Head_Office;
										hide How_to_Take_to_Head_Office;
										hide Time_Sent_to_Head_Office;
										hide Case_Number;
										hide Head_Office;
										hide Seen;
										hide Reason_for_not_Seen;
										hide Time_Checked;
										hide Human_Resource;
										hide Hr_Time_Checked;
										hide Back_End;
										hide Sales_Vouchers;
										// ------------------------------
										// 3) DOCUMENT TYPE TOGGLE
										// ------------------------------
										if(input.Document_Type == "Physical Voucher")
										{
											show Voucher_Type;
											enable Voucher_Type;
											enable Voucher_Number;
										}
										else if(input.Document_Type == "Digital Voucher")
										{
											show Voucher_Type;
											enable Voucher_Type;
											disable Voucher_Number;
										}
										else
										{
											hide Voucher_Type;
											input.Voucher_Type = null;
											input.Voucher_Number = null;
										}
										// ------------------------------
										// 4) MODE + STATUS
										// ------------------------------
										is_create = input.ID == null;
										st = ifnull(input.Voucher_Status,"Issued");
										if(is_create && input.Voucher_Status == null)
										{
											input.Voucher_Status = "Issued";
											st = "Issued";
										}
										// =====================================================
										// ON CREATE
										// =====================================================
										if(is_create)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											enable Issued_By;
											enable Document_Type;
											enable Voucher_Type;
											enable Voucher_Number;
											enable Employee;
										}
										// =====================================================
										// ON EDIT + ISSUED
										// =====================================================
										else if(!is_create && st == "Issued")
										{
											show Issued_By;
											show Site;
											show Voucher_Return;
											show Received_By;
											enable Received_By;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
										}
										// =====================================================
										// ON EDIT + CLOSED
										// =====================================================
										else if(!is_create && st == "Closed")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Display_Name_Issued_By;
												hide Received_By;
												hide Display_Name_Received_By;
												show Manager_Section;
												show Manager_Time;
												show Cancel_Voucher;
												show Case_Number;
												show Employee_Taking_To_Head_Office;
												show How_to_Take_to_Head_Office;
												show Time_Sent_to_Head_Office;
												enable Case_Number;
												enable Employee_Taking_To_Head_Office;
												enable How_to_Take_to_Head_Office;
												enable Cancel_Voucher;
												if(input.Cancel_Voucher == true)
												{
													show Cancellation_Reason;
													enable Cancellation_Reason;
												}
											}
										}
										// =====================================================
										// ON EDIT + RETURNED
										// =====================================================
										else if(!is_create && st == "Returned")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Received_By;
												hide Display_Name_Received_By;
											}
											show Issued_By;
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Manager_Section;
											show Cancel_Voucher;
											enable Cancel_Voucher;
										}
										// =====================================================
										// ON EDIT + HEAD OFFICE
										// =====================================================
										else if(!is_create && st == "Head Office")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Manager_Section;
											show Cancel_Voucher;
											if(input.Cancel_Voucher == true)
											{
												show Cancellation_Reason;
											}
											show Head_Office;
											show Seen;
											enable Seen;
										}
										// =====================================================
										// ON EDIT + HUMAN RESOURCE
										// =====================================================
										else if(!is_create && st == "Human Resource")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											enable Document_Type;
											show Voucher_Type;
											enable Voucher_Type;
											show Voucher_Number;
											enable Voucher_Number;
											show Employee;
											show Date_Time_In;
											enable Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											enable Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Manager_Section;
											show Cancel_Voucher;
											enable Cancel_Voucher;
										}
										// =====================================================
										// ON EDIT + AUDITED
										// =====================================================
										else if(!is_create && st == "Audited")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											enable Voucher_Status;
											show Voucher_Cost;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											if(input.Cancel_Voucher == true)
											{
												show Cancellation_Reason;
											}
											show Head_Office;
											show Seen;
											if(input.Seen == true)
											{
												hide Reason_for_not_Seen;
											}
											else
											{
												show Reason_for_not_Seen;
											}
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
											show Back_End;
											show User_Name;
											show User_Email;
											show User_Role;
											show Created_By_Name;
											show Created_By_Email;
											show Created_By_Time;
											show Updated_By_Name;
											show Updated_By_Email;
											show Updated_By_Time;
										}
										// =====================================================
										// ON EDIT + CLEARED
										// =====================================================
										else if(!is_create && st == "Cleared")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Shift_Voucher_Summary;
											show Opening_Vouchers;
											show Vouchers_Issued;
											show Vouchers_Returned;
											show Outstanding_Vouchers;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											show Head_Office;
											show Seen;
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
											show Back_End;
										}
										// =====================================
										// FINAL NOTES CONTROL
										// =====================================
										// =====================================
										// FORCE SHOW EXISTING DETAILS
										// =====================================
										if(input.Employee_Issuing_Details.count() > 0)
										{
											show Employee_Issuing_Details;
										}
										if(input.Voucher_Issuing_Details.count() > 0)
										{
											show Voucher_Issuing_Details;
										}
										if(input.Voucher_Receiving_Details.count() > 0)
										{
											show Voucher_Receiving_Details;
										}
						)
					}
				}

			}
			On_Cancel_Voucher_Selecte as "On Cancel Voucher Selected"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on user input of Cancel_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_Voucher == true)
										{
											show Cancellation_Reason;
										}
										else
										{
											hide Cancellation_Reason;
											input.Cancellation_Reason = "";
										}
						)
					}
				}

			}
			On_Date_Time_In_Selected as "On Date-Time In Selected"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on user input of Date_Time_In
				{
					actions 
					{
						custom deluge script
						(
											// ---- CONFIGURE DAY WINDOW HERE ----
										START_DAY_HOUR = 6;
										// 06:00 inclusive
										END_DAY_HOUR = 18;
										// 18:00 exclusive
										// If Date-Time In is cleared, clear dependent fields
										if(input.Date_Time_In == null)
										{
											input.Shift = null;
											input.Hours_Worked = null;
										}
										else
										{
											// -------------------------
											// 1) Shift
											// -------------------------
											hr = input.Date_Time_In.toString("HH").toLong();
											if(hr >= START_DAY_HOUR && hr < END_DAY_HOUR)
											{
												input.Shift = "Day Shift";
											}
											else
											{
												input.Shift = "Night Shift";
											}
											// -------------------------
											// 2) Hours Worked (only if Out exists)
											// -------------------------
											if(input.Date_Time_Out != null)
											{
												// Validate ordering
												if(input.Date_Time_Out < input.Date_Time_In)
												{
													alert "Date-Time Out cannot be earlier than Date-Time In.";
													input.Date_Time_Out = null;
													input.Hours_Worked = null;
												}
												else
												{
													ms = input.Date_Time_Out.toLong() - input.Date_Time_In.toLong();
													input.Hours_Worked = (ms / (1000.0 * 60.0 * 60.0)).round(2);
												}
											}
											else
											{
												input.Hours_Worked = null;
											}
										}
						)
					}
				}

			}
			On_Date_Time_Out_Selected as "On Date-Time Out Selected"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on user input of Date_Time_Out
				{
					actions 
					{
						custom deluge script
						(
											// Voucher → On Date_Time_Out
										// If cleared
										if(input.Date_Time_Out == null)
										{
											input.Hours_Worked = null;
											return;
										}
										// Must have In first
										if(input.Date_Time_In == null)
										{
											alert "Please enter Date-Time In first.";
											input.Date_Time_Out = null;
											input.Hours_Worked = null;
											return;
										}
										// Validate ordering
										if(input.Date_Time_Out < input.Date_Time_In)
										{
											alert "Date-Time Out cannot be earlier than Date-Time In.";
											input.Date_Time_Out = null;
											input.Hours_Worked = null;
											return;
										}
										// Compute hours
										ms = input.Date_Time_Out.toLong() - input.Date_Time_In.toLong();
										input.Hours_Worked = (ms / (1000.0 * 60.0 * 60.0)).round(2);
						)
					}
				}

			}
			On_Document_Type_Selected as "On Document Type Selected"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on user input of Document_Type
				{
					actions 
					{
						custom deluge script
						(
											dt = ifnull(input.Document_Type,"").trim();
										if(dt == "Physical Voucher")
										{
											show Voucher_Type;
											enable Voucher_Type;
											enable Voucher_Number;
											input.Voucher_Type = null;
											input.Display_Name_Voucher_Type = null;
											input.Voucher_Number = null;
										}
										else if(dt == "Digital Voucher")
										{
											show Voucher_Type;
											enable Voucher_Type;
											disable Voucher_Number;
											input.Voucher_Type = null;
											input.Display_Name_Voucher_Type = null;
											input.Voucher_Number = null;
										}
										else
										{
											hide Voucher_Type;
											disable Voucher_Number;
											input.Voucher_Type = null;
											input.Display_Name_Voucher_Type = null;
											input.Voucher_Number = null;
										}
						)
					}
				}

			}
