				 map updateBillFromPayment(map payload)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("msg","");
                 	result.put("bill_number","");
                 	result.put("bill_id",null);
                 	result.put("bill_amount_paid",0.0);
                 	result.put("bill_status","Not Paid");
                 	result.put("line_updates",0);
                 	result.put("group_allocations",List());
                 	if(payload == null)
                 	{
                 		result.put("msg","payload is null");
                 		return result;
                 	}
                 	fullBillNo = ifnull(payload.get("Bill_Number"),"").trim();
                 	total_paid_input = round(ifnull(payload.get("Total_Paid"),0.0).toDecimal(),2);
                 	if(fullBillNo == "")
                 	{
                 		result.put("msg","Missing Bill_Number");
                 		return result;
                 	}
                 	billRec = Bill[Bill_Number == fullBillNo];
                 	if(billRec == null || billRec.ID == null)
                 	{
                 		result.put("msg","No Bill found for Bill_Number: " + fullBillNo);
                 		return result;
                 	}
                 	bill_total = round(ifnull(billRec.Amount_Due,0.0).toDecimal(),2);
                 	recomputed_paid = total_paid_input;
                 	if(recomputed_paid < 0)
                 	{
                 		recomputed_paid = 0.0;
                 	}
                 	if(recomputed_paid > bill_total)
                 	{
                 		recomputed_paid = bill_total;
                 	}
                 	statusVal = "Not Paid";
                 	if(recomputed_paid <= 0)
                 	{
                 		statusVal = "Not Paid";
                 	}
                 	else if(recomputed_paid < bill_total)
                 	{
                 		statusVal = "Partially Paid";
                 	}
                 	else
                 	{
                 		statusVal = "Paid";
                 	}
                 	billRec.Amount_Paid=recomputed_paid;
                 	billRec.Payment_Status=statusVal;
                 	for each  bd_reset in Bill_Details[Bill == billRec.ID]
                 	{
                 		bd_reset.Amount_Paid=0.0;
                 	}
                 	remaining_amt = round(recomputed_paid,2);
                 	updated_lines = 0;
                 	bill_lines = Bill_Details[Bill == billRec.ID] sort by Line_Number asc;
                 	for each  bd in bill_lines
                 	{
                 		if(remaining_amt <= 0)
                 		{
                 			break;
                 		}
                 		line_total_val = round(ifnull(bd.Line_Total,0.0),2);
                 		if(line_total_val < 0)
                 		{
                 			line_total_val = 0.0;
                 		}
                 		apply_amt = 0.0;
                 		if(remaining_amt >= line_total_val)
                 		{
                 			apply_amt = line_total_val;
                 		}
                 		else
                 		{
                 			apply_amt = remaining_amt;
                 		}
                 		bd.Amount_Paid=round(apply_amt,2);
                 		remaining_amt = round(remaining_amt - apply_amt,2);
                 		if(apply_amt > 0)
                 		{
                 			updated_lines = updated_lines + 1;
                 		}
                 	}
                 	group_totals_map = Map();
                 	for each  bd2 in Bill_Details[Bill == billRec.ID] sort by Line_Number asc
                 	{
                 		if(bd2.Group != null)
                 		{
                 			group_key = bd2.Group.ID.toString();
                 			if(group_totals_map.containKey(group_key))
                 			{
                 				gm = group_totals_map.get(group_key);
                 			}
                 			else
                 			{
                 				gm = Map();
                 				gm.put("group_id",bd2.Group.ID);
                 				gm.put("amount_to_pay",0.0);
                 				gm.put("amount_actually_paid",0.0);
                 			}
                 			gm.put("amount_to_pay",round(ifnull(gm.get("amount_to_pay"),0.0) + ifnull(bd2.Line_Total,0.0),2));
                 			gm.put("amount_actually_paid",round(ifnull(gm.get("amount_actually_paid"),0.0) + ifnull(bd2.Amount_Paid,0.0),2));
                 			group_totals_map.put(group_key,gm);
                 		}
                 	}
                 	group_allocations = List();
                 	for each  gk in group_totals_map.keys()
                 	{
                 		group_allocations.add(group_totals_map.get(gk));
                 	}
                 	result.put("ok",true);
                 	result.put("msg","Success");
                 	result.put("bill_number",fullBillNo);
                 	result.put("bill_id",billRec.ID);
                 	result.put("bill_amount_paid",recomputed_paid);
                 	result.put("bill_status",statusVal);
                 	result.put("line_updates",updated_lines);
                 	result.put("group_allocations",group_allocations);
                 	return result;
                 }
				 int update_shop_days_odometer()
                 {
                 	updated_count = 0;
                 	shop_assets = Asset_List[Display_Name_Asset_Type == "Shops" && Odometer_Unit_Of_Measure == "days" && Odometer_Reading == 3 || Odometer_Reading == 4 && Date_Time_Odometer_Read != null];
                 	for each  asset_rec in shop_assets
                 	{
                 		days_used = daysBetween(asset_rec.Date_Time_Odometer_Read.toDate(),zoho.currentdate);
                 		if(days_used < 0)
                 		{
                 			days_used = 0;
                 		}
                 		asset_rec.Odometer_Reading=days_used;
                 		updated_count = updated_count + 1;
                 	}
                 	info updated_count + " records updated.";
                 	return updated_count;
                 }
				 int update_sim_cards_days_odometer()
                 {
                 	updated_count = 0;
                 	sim_assets = Asset_List[Display_Name_Asset_Type == "Sim Cards" && Odometer_Unit_Of_Measure == "days" && Odometer_Reading == 0 && Date_Time_Odometer_Read != null];
                 	for each  asset_rec in sim_assets
                 	{
                 		days_used = daysBetween(asset_rec.Date_Time_Odometer_Read.toDate(),zoho.currentdate);
                 		if(days_used < 0)
                 		{
                 			days_used = 0;
                 		}
                 		asset_rec.Odometer_Reading=days_used;
                 		updated_count = updated_count + 1;
                 	}
                 	info updated_count + " SIM Card records updated.";
                 	return updated_count;
                 }
				 map validateAssetMileage(int asset_id, decimal odometer_reading, date mileage_date_time, string source_form_text, string source_record_id_text)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	// =====================================================
                 	// 1. SOURCE TRANSACTION DATE
                 	// =====================================================
                 	date_time_recorded = mileage_date_time;
                 	if(date_time_recorded == null)
                 	{
                 		date_time_recorded = zoho.currenttime;
                 	}
                 	if(asset_id == null)
                 	{
                 		resp.put("message","Asset is required.");
                 		return resp;
                 	}
                 	asset_rec = Asset_List[ID == asset_id];
                 	if(asset_rec.ID == null)
                 	{
                 		resp.put("message","Asset not found in Asset Management.");
                 		return resp;
                 	}
                 	unit_text = ifnull(asset_rec.Odometer_Unit_Of_Measure,"").trim().toLowerCase();
                 	previous_odometer = null;
                 	previous_time = null;
                 	previous_log_id = null;
                 	next_odometer = null;
                 	next_time = null;
                 	next_log_id = null;
                 	// =====================================================
                 	// 2. FIND PREVIOUS LOG
                 	// =====================================================
                 	prev_logs = Asset_Mileage_Log[Asset == asset_id && Date_Time_Recorded < date_time_recorded] sort by Date_Time_Recorded desc;
                 	for each  pl in prev_logs
                 	{
                 		if(pl.Void_Mileage != true)
                 		{
                 			previous_odometer = ifnull(pl.Odometer_Reading,0.0).toDecimal();
                 			previous_time = pl.Date_Time_Recorded;
                 			previous_log_id = pl.ID;
                 			break;
                 		}
                 	}
                 	// =====================================================
                 	// 3. FIND LOG ON THE SAME DATE
                 	// Used for day-based assets
                 	// =====================================================
                 	same_day_odometer = null;
                 	source_day = date_time_recorded.toDate();
                 	for each  day_log in Asset_Mileage_Log[Asset == asset_id] sort by Date_Time_Recorded desc
                 	{
                 		if(day_log.Void_Mileage != true && day_log.Date_Time_Recorded != null && day_log.Date_Time_Recorded.toDate() == source_day)
                 		{
                 			same_day_odometer = ifnull(day_log.Odometer_Reading,0.0).toDecimal();
                 			break;
                 		}
                 	}
                 	// =====================================================
                 	// 4. FIND NEXT LOG
                 	// =====================================================
                 	next_logs = Asset_Mileage_Log[Asset == asset_id && Date_Time_Recorded > date_time_recorded] sort by Date_Time_Recorded asc;
                 	for each  nl in next_logs
                 	{
                 		if(nl.Void_Mileage != true)
                 		{
                 			next_odometer = ifnull(nl.Odometer_Reading,0.0).toDecimal();
                 			next_time = nl.Date_Time_Recorded;
                 			next_log_id = nl.ID;
                 			break;
                 		}
                 	}
                 	// =====================================================
                 	// 5. HANDLE DAY-BASED ODOMETERS
                 	// =====================================================
                 	if(unit_text == "days" || unit_text == "day")
                 	{
                 		if(same_day_odometer != null)
                 		{
                 			odometer_reading = same_day_odometer;
                 		}
                 		else if(previous_odometer != null)
                 		{
                 			// No exact log for that date:
                 			// use previous reading plus elapsed calendar days
                 			days_passed = daysBetween(previous_time.toDate(),source_day);
                 			if(days_passed < 0)
                 			{
                 				days_passed = 0;
                 			}
                 			odometer_reading = previous_odometer + days_passed;
                 		}
                 		else
                 		{
                 			odometer_reading = ifnull(asset_rec.Odometer_Reading,0.0).toDecimal();
                 		}
                 	}
                 	else
                 	{
                 		if(odometer_reading == null || odometer_reading <= 0)
                 		{
                 			resp.put("message","Odometer Reading is required. Asset unit found: " + unit_text);
                 			return resp;
                 		}
                 		odometer_reading = odometer_reading.toDecimal();
                 	}
                 	// =====================================================
                 	// 6. VALIDATE PREVIOUS LOG
                 	// =====================================================
                 	if(previous_odometer != null && odometer_reading < previous_odometer)
                 	{
                 		resp.put("message","Odometer is invalid.");
                 		resp.put("Odometer_Reading",odometer_reading);
                 		resp.put("Previous_Odometer",previous_odometer);
                 		resp.put("Previous_Time",previous_time);
                 		return resp;
                 	}
                 	// =====================================================
                 	// 7. VALIDATE NEXT LOG
                 	// =====================================================
                 	if(next_odometer != null && odometer_reading > next_odometer)
                 	{
                 		resp.put("message","Odometer is invalid.");
                 		resp.put("Odometer_Reading",odometer_reading);
                 		resp.put("Next_Odometer",next_odometer);
                 		resp.put("Next_Time",next_time);
                 		return resp;
                 	}
                 	// =====================================================
                 	// 8. DISTANCE SINCE LAST
                 	// =====================================================
                 	distance_since_last = 0.0;
                 	if(previous_odometer != null)
                 	{
                 		distance_since_last = (odometer_reading - previous_odometer).toDecimal();
                 	}
                 	// =====================================================
                 	// 9. HOURS VALIDATION
                 	// =====================================================
                 	if(unit_text == "hours" || unit_text == "hour" && previous_odometer != null && previous_time != null)
                 	{
                 		hours_passed_txt = previous_time.hoursBetween(date_time_recorded);
                 		hours_passed_num = ifnull(hours_passed_txt.toDecimal(),0.0);
                 		if(hours_passed_num < 1.0)
                 		{
                 			hours_passed_num = 1.0;
                 		}
                 		if(distance_since_last > hours_passed_num)
                 		{
                 			resp.put("message","Odometer is invalid.");
                 			resp.put("Odometer_Reading",odometer_reading);
                 			resp.put("Previous_Odometer",previous_odometer);
                 			resp.put("Hours_Passed",hours_passed_num);
                 			resp.put("Distance_Since_Last",distance_since_last);
                 			return resp;
                 		}
                 	}
                 	// =====================================================
                 	// 10. PASSED
                 	// =====================================================
                 	resp.put("ok",true);
                 	resp.put("message","Mileage validation passed in chronological position.");
                 	resp.put("Date_Time_Recorded",date_time_recorded);
                 	resp.put("Odometer_Reading",odometer_reading);
                 	resp.put("Previous_Log_ID",previous_log_id);
                 	resp.put("Previous_Odometer",ifnull(previous_odometer,0.0));
                 	resp.put("Previous_Time",previous_time);
                 	resp.put("Next_Log_ID",next_log_id);
                 	resp.put("Next_Odometer",ifnull(next_odometer,0.0));
                 	resp.put("Next_Time",next_time);
                 	resp.put("Distance_Since_Last",distance_since_last);
                 	return resp;
                 }
				 map validateAssetMileage2(int asset_id, decimal odometer_reading, string source_form_text, string source_record_id_text)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	date_time_recorded = zoho.currenttime;
                 	if(asset_id == null)
                 	{
                 		resp.put("message","Asset is required.");
                 		return resp;
                 	}
                 	asset_rec = Asset_List[ID == asset_id];
                 	if(asset_rec.ID == null)
                 	{
                 		resp.put("message","Asset not found in Asset Management.");
                 		return resp;
                 	}
                 	unit_text = ifnull(asset_rec.Odometer_Unit_Of_Measure,"").trim().toLowerCase();
                 	if(unit_text == "days" || unit_text == "day")
                 	{
                 		odometer_reading = ifnull(asset_rec.Odometer_Reading,0.0).toDecimal();
                 	}
                 	else
                 	{
                 		if(odometer_reading == null || odometer_reading <= 0)
                 		{
                 			resp.put("message","Odometer Reading is Required. Asset unit found: " + unit_text);
                 			return resp;
                 		}
                 		odometer_reading = ifnull(odometer_reading,0.0).toDecimal();
                 	}
                 	previous_odometer = null;
                 	previous_time = null;
                 	next_odometer = null;
                 	prev_logs = Asset_Mileage_Log[Asset == asset_id && Date_Time_Recorded < date_time_recorded] sort by Date_Time_Recorded desc;
                 	for each  pl in prev_logs
                 	{
                 		if(pl.Void_Mileage == true)
                 		{
                 			continue;
                 		}
                 		previous_odometer = ifnull(pl.Odometer_Reading,0.0).toDecimal();
                 		previous_time = pl.Date_Time_Recorded;
                 		break;
                 	}
                 	next_logs = Asset_Mileage_Log[Asset == asset_id && Date_Time_Recorded > date_time_recorded] sort by Date_Time_Recorded asc;
                 	for each  nl in next_logs
                 	{
                 		if(nl.Void_Mileage == true)
                 		{
                 			continue;
                 		}
                 		next_odometer = ifnull(nl.Odometer_Reading,0.0).toDecimal();
                 		break;
                 	}
                 	if(previous_odometer != null && odometer_reading < previous_odometer)
                 	{
                 		resp.put("message","Odometer is invalid.");
                 		resp.put("Odometer_Reading",odometer_reading);
                 		return resp;
                 	}
                 	if(next_odometer != null && odometer_reading > next_odometer)
                 	{
                 		resp.put("message","Odometer is invalid.");
                 		resp.put("Odometer_Reading",odometer_reading);
                 		return resp;
                 	}
                 	distance_since_last = 0.0;
                 	if(previous_odometer != null)
                 	{
                 		distance_since_last = (odometer_reading - previous_odometer).toDecimal();
                 	}
                 	if(unit_text == "hours" || unit_text == "hour" && previous_odometer != null && previous_time != null)
                 	{
                 		hours_passed_txt = previous_time.hoursBetween(date_time_recorded);
                 		hours_passed_num = ifnull(hours_passed_txt.toDecimal(),0.0);
                 		if(hours_passed_num < 1.0)
                 		{
                 			hours_passed_num = 1.0;
                 		}
                 		if(distance_since_last > hours_passed_num)
                 		{
                 			resp.put("message","Odometer is invalid");
                 			resp.put("Odometer_Reading",odometer_reading);
                 			resp.put("Previous_Odometer",previous_odometer);
                 			resp.put("Hours_Passed",hours_passed_num);
                 			resp.put("Distance_Since_Last",distance_since_last);
                 			return resp;
                 		}
                 	}
                 	resp.put("ok",true);
                 	resp.put("message","Mileage validation passed.");
                 	resp.put("Odometer_Reading",odometer_reading);
                 	resp.put("Previous_Odometer",ifnull(previous_odometer,0.0));
                 	resp.put("Next_Odometer",ifnull(next_odometer,0.0));
                 	resp.put("Distance_Since_Last",distance_since_last);
                 	return resp;
                 }
				 void asset.refresh_asset_costs(int assetID)
                 {
                 	asset_rec = Asset_List[ID == assetID];
                 	if(asset_rec.ID == null)
                 	{
                 		return;
                 	}
                 	total_fuel = 0.0;
                 	for each  log in Asset_Transaction_Log[Asset == assetID && Transaction_Status == "Posted" && Source_Form == "Fuel Receiving Voucher"]
                 	{
                 		total_fuel = total_fuel + ifnull(log.Expenses,0.0);
                 	}
                 	total_service = ifnull(asset_rec.Total_Service_Costs,0.0);
                 	total_labour = ifnull(asset_rec.Total_Labour_Costs,0.0);
                 	total_cost = total_fuel + total_service + total_labour;
                 	odo = ifnull(asset_rec.Odometer_Reading,0.0);
                 	asset_rec.Total_Fuel_Costs=round(total_fuel,2);
                 	asset_rec.Total_Costs=round(total_cost,2);
                 	if(odo > 0)
                 	{
                 		asset_rec.Fuel_Cost_Per_Odometer=round(total_fuel / odo,2);
                 		asset_rec.Service_Cost_Per_Odometer=round(total_service / odo,2);
                 		asset_rec.Labour_Cost_Per_Odometer=round(total_labour / odo,2);
                 		asset_rec.Cost_Per_Odometer=round(total_cost / odo,2);
                 	}
                 	else
                 	{
                 		asset_rec.Fuel_Cost_Per_Odometer=0.0;
                 		asset_rec.Service_Cost_Per_Odometer=0.0;
                 		asset_rec.Labour_Cost_Per_Odometer=0.0;
                 		asset_rec.Cost_Per_Odometer=0.0;
                 	}
                 }
				 map asset.updateLeaseSummary(map lease_data)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("message","Asset lease summary was not updated");
                 	try 
                 	{
                 		// -----------------------------------------------
                 		// VALIDATE REQUIRED INPUT
                 		// -----------------------------------------------
                 		asset_id = null;
                 		if(lease_data.containKey("Asset_ID"))
                 		{
                 			asset_id = lease_data.get("Asset_ID");
                 		}
                 		if(asset_id == null)
                 		{
                 			response.put("message","Asset ID was not supplied");
                 			return response;
                 		}
                 		// -----------------------------------------------
                 		// FIND ASSET IN THIS APPLICATION
                 		// -----------------------------------------------
                 		asset_record = Asset_List[ID == asset_id.toLong()];
                 		if(asset_record.ID == null)
                 		{
                 			response.put("message","Asset Register record was not found for ID: " + asset_id);
                 			return response;
                 		}
                 		// -----------------------------------------------
                 		// READ VALUES FROM MAP
                 		// -----------------------------------------------
                 		lease_status = ifnull(lease_data.get("Lease_Status"),"").toString();
                 		lease_number = ifnull(lease_data.get("Lease_Number"),"").toString();
                 		tenant_name = ifnull(lease_data.get("Tenant_Name"),"").toString();
                 		lease_id = lease_data.get("Lease_ID");
                 		lease_start_date = lease_data.get("Lease_Start_Date");
                 		lease_end_date = lease_data.get("Lease_End_Date");
                 		monthly_rent = lease_data.get("Monthly_Rent");
                 		// -----------------------------------------------
                 		// UPDATE COMMON LEASE SUMMARY
                 		// -----------------------------------------------
                 		asset_record.Is_Rentable=true;
                 		asset_record.Display_Name_Current_Lease=lease_number;
                 		asset_record.Display_Name_Current_Tenant=tenant_name;
                 		if(lease_id != null)
                 		{
                 			/*
                 			The cross-application lookup may accept the source
                 			record ID. Keep this only if the Current Lease field
                 			is configured to reference Freedom City Management.
                 			*/
                 			asset_record.Current_Lease_Freedom_City_Management=lease_id.toLong();
                 		}
                 		if(lease_start_date != null)
                 		{
                 			asset_record.Lease_Start_Date=lease_start_date.toDate();
                 		}
                 		else
                 		{
                 			asset_record.Lease_Start_Date=null;
                 		}
                 		if(lease_end_date != null)
                 		{
                 			asset_record.Lease_End_Date=lease_end_date.toDate();
                 		}
                 		else
                 		{
                 			asset_record.Lease_End_Date=null;
                 		}
                 		if(monthly_rent != null)
                 		{
                 			asset_record.Monthly_Rent=monthly_rent.toDecimal();
                 		}
                 		else
                 		{
                 			asset_record.Monthly_Rent=0;
                 		}
                 		// -----------------------------------------------
                 		// DETERMINE ASSET RENTAL STATUS
                 		// -----------------------------------------------
                 		if(lease_status == "Draft")
                 		{
                 			asset_record.Rental_Status="Reserved";
                 			asset_record.Occupancy_Status="Handover Pending";
                 		}
                 		else if(lease_status == "Active")
                 		{
                 			asset_record.Rental_Status="Occupied";
                 			asset_record.Occupancy_Status="Occupied";
                 		}
                 		else if(lease_status == "Expired" || lease_status == "Terminated")
                 		{
                 			/*
                 			Keep the current lease summary until the physical
                 			shop take-back has been completed.
                 			*/
                 			asset_record.Rental_Status="Unavailable";
                 			asset_record.Occupancy_Status="Take Back Pending";
                 		}
                 		else if(lease_status == "Cancelled")
                 		{
                 			asset_record.Rental_Status="Available";
                 			asset_record.Occupancy_Status="Vacant";
                 			asset_record.Current_Lease_Freedom_City_Management=null;
                 			asset_record.Display_Name_Current_Lease="";
                 			asset_record.Display_Name_Current_Tenant="";
                 			asset_record.Lease_Start_Date=null;
                 			asset_record.Lease_End_Date=null;
                 			asset_record.Monthly_Rent=0;
                 		}
                 		response.put("ok",true);
                 		response.put("message","Lease summary updated for asset: " + asset_record.Display_Name_Asset_Name);
                 		response.put("Asset_ID",asset_record.ID);
                 	}	catch (error)
                 	{
                 		response.put("ok",false);
                 		response.put("message","Unable to update the Asset Register: " + error.toString());
                 	}
                 	return response;
                 }
				 float asset_calc.asset_calc_grand_total(float parts_total, float labour_total)
                 {
                 	p = ifnull(parts_total,0.0);
                 	l = ifnull(labour_total,0.0);
                 	return round(p + l,2);
                 }
				 float asset_calc.asset_calc_labour_total(list parts_rows)
                 {
                 	total = 0.0;
                 	for each  rmap in parts_rows
                 	{
                 		labourVal = rmap.get("Labour");
                 		qty = ifnull(rmap.get("Quantity"),0.0);
                 		rate = ifnull(rmap.get("Unit Cost"),0.0);
                 		// Labour rows only
                 		if(labourVal != null && qty > 0 && rate >= 0)
                 		{
                 			total = total + qty * rate;
                 		}
                 	}
                 	return round(total,2);
                 }
				 float asset_calc.asset_calc_line_total(float qty, float rate)
                 {
                 	q = ifnull(qty,0.0);
                 	r = ifnull(rate,0.0);
                 	if(q < 0)
                 	{
                 		q = 0;
                 	}
                 	if(r < 0)
                 	{
                 		r = 0;
                 	}
                 	return round(q * r,2);
                 }
				 float asset_calc.asset_calc_parts_total(list parts_rows)
                 {
                 	total = 0.0;
                 	for each  rmap in parts_rows
                 	{
                 		itemVal = rmap.get("Item");
                 		qty = ifnull(rmap.get("Quantity"),0.0);
                 		rate = ifnull(rmap.get("Unit Cost"),0.0);
                 		if(itemVal != null && qty > 0 && rate >= 0)
                 		{
                 			total = total + qty * rate;
                 		}
                 	}
                 	return round(total,2);
                 }
				 map asset_codegen.generateAssetRecordLabels(string prefix_key, string machine_name)
                 {
                 	// -------------------------------------------------
                 	// 0. Init return map
                 	// -------------------------------------------------
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("asset_id","");
                 	result.put("display_name","");
                 	result.put("message","");
                 	// -------------------------------------------------
                 	// 1. Validate inputs
                 	// -------------------------------------------------
                 	if(prefix_key == null || prefix_key.trim() == "")
                 	{
                 		result.put("message","Prefix key is required.");
                 		return result;
                 	}
                 	if(machine_name == null || machine_name.trim() == "")
                 	{
                 		result.put("message","Machine Name is required.");
                 		return result;
                 	}
                 	// -------------------------------------------------
                 	// 2. Fetch sequence row for this prefix
                 	// -------------------------------------------------
                 	seq = Asset_ID_Sequence[Prefix == prefix_key];
                 	if(seq.ID == null)
                 	{
                 		result.put("message","No Asset ID Sequence found for prefix '" + prefix_key + "'. Please create it first.");
                 		return result;
                 	}
                 	// -------------------------------------------------
                 	// 3. Read / guard the counter
                 	// -------------------------------------------------
                 	next_num = ifnull(seq.Next_Number,1);
                 	if(next_num > 999)
                 	{
                 		result.put("message","Asset IDs for prefix '" + prefix_key + "' are exhausted (001–999 used). Please reset the sequence.");
                 		return result;
                 	}
                 	// -------------------------------------------------
                 	// 4. Zero-pad counter (001, 002, ..., 010, ..., 100)
                 	// -------------------------------------------------
                 	if(next_num < 10)
                 	{
                 		seq_str = "00" + next_num;
                 	}
                 	else if(next_num < 100)
                 	{
                 		seq_str = "0" + next_num;
                 	}
                 	else
                 	{
                 		seq_str = "" + next_num;
                 	}
                 	// -------------------------------------------------
                 	// 5. Build new Asset_ID
                 	// -------------------------------------------------
                 	new_asset_id = prefix_key + seq_str;
                 	// -------------------------------------------------
                 	// 6. Duplicate safety
                 	// -------------------------------------------------
                 	dupe = Asset_List[Asset_ID == new_asset_id];
                 	if(dupe.count() > 0)
                 	{
                 		result.put("message","An Asset with ID " + new_asset_id + " already exists. Please try again.");
                 		return result;
                 	}
                 	// -------------------------------------------------
                 	// 7. Prepare Display Name ("Machine Name - Asset_ID")
                 	// -------------------------------------------------
                 	disp_name = machine_name.trim() + " - " + new_asset_id;
                 	// -------------------------------------------------
                 	// 8. Advance the sequence counter
                 	// -------------------------------------------------
                 	seq_update = Asset_ID_Sequence[ID == seq.ID];
                 	seq_update.Next_Number=next_num + 1;
                 	// -------------------------------------------------
                 	// 9. Return success payload
                 	// -------------------------------------------------
                 	result.put("ok",true);
                 	result.put("asset_id",new_asset_id);
                 	result.put("display_name",disp_name);
                 	result.put("message","Success");
                 	return result;
                 }
				 void asset_issues.asset_issues_update_summary(bigint issue_id)
                 {
                 	if(issue_id == null)
                 	{
                 		return;
                 	}
                 	issue_rec = Asset_Issues[ID == issue_id];
                 	if(issue_rec.ID == null)
                 	{
                 		return;
                 	}
                 	work_order_count = 0;
                 	work_orders = Work_Order[Issue == issue_id];
                 	for each  wo in work_orders
                 	{
                 		work_order_count = work_order_count + 1;
                 	}
                 	work_order_task_count = 0;
                 	total_service_task_cost = 0.0;
                 	tasks = Work_Order_Tasks[Issue == issue_id];
                 	for each  t in tasks
                 	{
                 		work_order_task_count = work_order_task_count + 1;
                 		total_service_task_cost = total_service_task_cost + ifnull(t.Grand_Total,0.0);
                 	}
                 	if(work_order_task_count == 0)
                 	{
                 		tasks2 = Work_Order_Tasks[Issue == issue_id];
                 		for each  t2 in tasks2
                 		{
                 			work_order_task_count = work_order_task_count + 1;
                 			total_service_task_cost = total_service_task_cost + ifnull(t2.Grand_Total,0.0);
                 		}
                 	}
                 	issue_rec.Number_Of_Work_Order=work_order_count;
                 	issue_rec.Number_Of_Work_Order_Tasks=work_order_task_count;
                 	issue_rec.Total_Service_Task_Cost=round(total_service_task_cost,2);
                 }
				 map asset_issues.get_concrete_issue_data(int am_issue_id)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	am_issue = Asset_Issues[ID == am_issue_id];
                 	if(am_issue.ID == null)
                 	{
                 		resp.put("message","Asset Issue not found.");
                 		return resp;
                 	}
                 	if(am_issue.Asset == null)
                 	{
                 		resp.put("message","Asset missing on Asset Issue.");
                 		return resp;
                 	}
                 	asset_rec = Asset_List[ID == am_issue.Asset.ID];
                 	if(asset_rec.ID == null)
                 	{
                 		resp.put("message","Asset record not found.");
                 		return resp;
                 	}
                 	site_name = ifnull(asset_rec.Current_Site,"").trim();
                 	if(site_name != "Kabuusu" && site_name != "Concrete Products")
                 	{
                 		resp.put("message","Asset site not allowed for Concrete Products.");
                 		return resp;
                 	}
                 	resp.put("ok",true);
                 	resp.put("Source_Record_ID",am_issue.ID);
                 	resp.put("Source_Form","Asset Management Asset Issues");
                 	resp.put("Issue_Number",am_issue.Issue_Number);
                 	resp.put("Asset_ID",am_issue.Asset.ID);
                 	resp.put("Display_Name_Asset",am_issue.Display_Name_Asset);
                 	resp.put("Current_Site",am_issue.Current_Site);
                 	resp.put("Current_Custodian",am_issue.Current_Custodian);
                 	resp.put("Odometer_Reading",am_issue.Odometer_Reading);
                 	resp.put("Reported_Date",am_issue.Reported_Date);
                 	resp.put("Issue",am_issue.Issue);
                 	resp.put("Issue_Description",am_issue.Issue_Description);
                 	resp.put("Severity",am_issue.Severity);
                 	resp.put("Status","Open");
                 	return resp;
                 }
