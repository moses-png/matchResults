			Full_Validation5 as "Full Validation"
			{
				type =  form
				form = Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										is_create = input.ID == null;
										now_ts = zoho.currenttime;
										ADMIN_EMAIL = "xenotime15@gmail.com";
										is_admin = zoho.loginuser == ADMIN_EMAIL;
										// Skip manual validations for synced records
										is_sync = input.Source_Record_ID != null && input.Source_Form != null;
										// ----------------------------------
										// VOUCHER NUMBER RULES
										// ----------------------------------
										if(input.Document_Type == "Physical Voucher")
										{
											if(input.Voucher_Number == null || input.Voucher_Number.trim() == "")
											{
												errors = errors + "\n• Voucher Number is required for Physical Voucher.";
											}
											else
											{
												vn = input.Voucher_Number.trim();
												dupVoucher = Voucher[Voucher_Number == vn && ID != input.ID && Source_Record_ID != input.Source_Record_ID];
												if(dupVoucher.count() > 0)
												{
													errors = errors + "\n• Voucher Number '" + vn + "' already exists.";
												}
											}
										}
										else if(input.Document_Type == "Digital Voucher")
										{
											if(input.Voucher_Number != null && input.Voucher_Number.trim() != "")
											{
												vn = input.Voucher_Number.trim();
												dupVoucher = Voucher[Voucher_Number == vn && ID != input.ID && Source_Record_ID != input.Source_Record_ID];
												if(dupVoucher.count() > 0)
												{
													errors = errors + "\n• Voucher Number '" + vn + "' already exists.";
												}
											}
										}
										// ----------------------------------
										// NON-ADMIN / NON-SYNC VALIDATIONS
										// ----------------------------------
										if(!is_admin && !is_sync)
										{
											if(input.Site == null)
											{
												errors = errors + "\n• Site is required.";
											}
											if(input.Document_Type == null || input.Document_Type.trim() == "")
											{
												errors = errors + "\n• Document Type is required.";
											}
											else
											{
												if(input.Document_Type == "Digital Voucher" && input.Digital_Voucher_Type == null)
												{
													errors = errors + "\n• Digital Voucher Type is required.";
												}
												else if(input.Document_Type == "Physical Voucher")
												{
													if(input.Physical_Voucher_Type == null || input.Physical_Voucher_Type.trim() == "")
													{
														errors = errors + "\n• Physical Voucher Type is required.";
													}
												}
											}
											if(input.Employee == null)
											{
												errors = errors + "\n• Employee is required.";
											}
											if(is_create && input.Voucher_Type != "Supervisor Voucher")
											{
												if(input.Issued_By == null)
												{
													errors = errors + "\n• Issued By is required.";
												}
											}
											if(!is_create && input.Date_Time_Out != null)
											{
												if(input.Date_Time_In != null && input.Date_Time_In > input.Date_Time_Out)
												{
													errors = errors + "\n• Date-Time In cannot be greater than Date-Time Out.";
												}
												if(input.Date_Time_Out > now_ts)
												{
													errors = errors + "\n• Date-Time Out cannot be in the future.";
												}
											}
											if(is_create)
											{
												input.Voucher_Status = "Issued";
											}
											st = ifnull(input.Voucher_Status,"Issued");
											if(!is_create && st == "Issued" && input.Voucher_Type != "Supervisor Voucher")
											{
												if(input.Received_By == null)
												{
													errors = errors + "\n• Received By is required.";
												}
											}
											if(!is_create && input.Voucher_Type == "Supervisor Voucher" && st == "Closed")
											{
												if(input.Employee_Taking_To_Head_Office == null)
												{
													errors = errors + "\n• Employee Taking To Head Office is required.";
												}
												if(input.How_to_Take_to_Head_Office == null || input.How_to_Take_to_Head_Office.trim() == "")
												{
													errors = errors + "\n• How To Take To Head Office is required.";
												}
												case_no = ifnull(input.Case_Number,"").trim();
												if(case_no == "")
												{
													errors = errors + "\n• Case Number is required.";
												}
												else
												{
													new_transport_date = zoho.currentdate;
													if(input.Time_Sent_to_Head_Office != null)
													{
														new_transport_date = input.Time_Sent_to_Head_Office.toDate();
													}
													sameDateBlockedCase = Voucher_Transfer_Register[Case_Number == case_no && Transport_Date == new_transport_date && Case_Status != "Open" && Case_Status != "In Transit"];
													if(sameDateBlockedCase.ID != null)
													{
														errors = errors + "\n• Case Number " + case_no + " is already " + sameDateBlockedCase.Case_Status + " for " + new_transport_date.toString() + ".";
													}
													differentDateBlockedCase = Voucher_Transfer_Register[Case_Number == case_no && Transport_Date != new_transport_date && Case_Status != "Open"];
													if(differentDateBlockedCase.ID != null)
													{
														errors = errors + "\n• Case Number " + case_no + " was already used on " + differentDateBlockedCase.Transport_Date.toString() + " and is " + differentDateBlockedCase.Case_Status + ". Reopen that case first.";
													}
												}
											}
											if(!is_create && st == "Issued" && input.Voucher_Type == "Kitchen Voucher")
											{
												if(input.Kitchen_Employee_Details == null || input.Kitchen_Employee_Details.count() < 3)
												{
													errors = errors + "\n• Add at least THREE Kitchen Employee Details records.";
												}
											}
											if(!is_create && st == "Issued" && input.Voucher_Type == "Daily Cleaners Report")
											{
												if(input.Management_Location == null)
												{
													errors = errors + "\n• Management Location is required.";
												}
											}
											if(!is_create && st == "Issued" && input.Voucher_Type == "Occurency Report")
											{
												if(input.Management_Location == null)
												{
													errors = errors + "\n• Management Location is required.";
												}
												if(input.Incident_Details == null || input.Incident_Details.count() < 2)
												{
													errors = errors + "\n• Add at least TWO Incident Details records.";
												}
											}
											if(st == "Head Office")
											{
												if(input.Seen == null)
												{
													errors = errors + "\n• Seen is required.";
												}
												else if(input.Seen == false && input.Reason_for_not_Seen == null || input.Reason_for_not_Seen.trim() == "")
												{
													errors = errors + "\n• Reason for not Seen is required.";
												}
												else if(input.Seen == true && input.Reason_for_not_Seen != null && input.Reason_for_not_Seen.trim() != "")
												{
													errors = errors + "\n• Reason for not Seen must be empty.";
												}
											}
											if(input.Cancel_Voucher == true)
											{
												if(input.Cancellation_Reason == null || input.Cancellation_Reason.trim() == "")
												{
													errors = errors + "\n• Cancellation Reason is required.";
												}
											}
											else
											{
												input.Cancellation_Reason = "";
											}
											bad_rows = Stock_Bundling_Note[Voucher == input.ID && Stock_Status == "Pending" || Stock_Status == "Partially Received"];
											if(bad_rows.count() > 0)
											{
												if(input.Not_Created == true)
												{
													reason_txt = "";
													if(input.Reason_Why_Not_Created != null)
													{
														reason_txt = input.Reason_Why_Not_Created.trim();
													}
													if(reason_txt == "")
													{
														errors = errors + "\n• Reason Why Not Created is required.";
													}
													else if(reason_txt.length() < 30)
													{
														errors = errors + "\n• Reason Why Not Created must be at least 30 characters.";
													}
												}
											}
										}
										//}
										// ----------------------------------
										// FINAL GATE
										// ----------------------------------
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Contact_Email_Update_Deta as "Contact / Email Update Details Add Row"
			{
				type =  form
				form = Employee_Register

				record event = on add or edit

				on add row of Contact_Email_Update_Details
				{
					actions 
					{
						custom deluge script
						(
											// Contact / Email Update Details — On Add Row
										// Auto-fill Employee + Display Name Employee from the parent Employee record
										if(row != null)
										{
											// Link this row back to the parent Employee record (only works after the parent is saved)
											if(row.Employee == null && input.ID != null)
											{
												row.Employee=input.ID;
											}
											// Build Display Name Employee = "Employee Name - Employee Number"
											if(input.Employee_Name != null && input.Employee_Name.trim() != "" && input.Employee_Number != null)
											{
												row.Display_Name_Employee=input.Employee_Name.trim() + " - " + input.Employee_Number.toString();
											}
											else
											{
												row.Display_Name_Employee=null;
											}
										}
										u = thisapp.audit.getLoginAuditInfo();
										row.User_Name=u.get("name");
										row.User_Email=u.get("email");
										row.User_Role=u.get("role");
										if(row.Created_By_Email == null || row.Created_By_Email == "")
										{
											row.Created_By_Name=u.get("name");
											row.Created_By_Email=u.get("email");
											row.Created_By_Time=zoho.currenttime;
										}
										else
										{
											row.Updated_By_Name=u.get("name");
											row.Updated_By_Email=u.get("email");
											row.Updated_By_Time=zoho.currenttime;
										}
						)
					}
				}

			}
