			}
			Finalize as "Finalize"
			{
				type =  form
				form = Payment_Made_Voucher_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											asset_resp = null;
										emp_resp = null;
										store_resp = null;
										// ==================================================
										// 0) SMALL HELPERS
										// ==================================================
										current_bill_no = ifnull(input.Bill_Number,"").trim();
										old_bill_no = ifnull(input.Old_Bill_Number,"").trim();
										current_row_paid = round(ifnull(input.Amount_Paid,0.0),2);
										old_row_paid = round(ifnull(input.Old_Amount_Paid,0.0),2);
										if(current_bill_no == "")
										{
											if(input.System == "Store Management" && input.Store_Management_Bill != null)
											{
												current_bill_no = ifnull(input.Store_Management_Bill.Bill_Number,"").trim();
												input.Bill_Number = current_bill_no;
											}
											else if(input.System == "Asset Management" && input.Asset_Management_Bill != null)
											{
												current_bill_no = ifnull(input.Asset_Management_Bill.Bill_Number,"").trim();
												input.Bill_Number = current_bill_no;
											}
											else if(input.System == "Employee Management" && input.Employee_Management_Bill != null)
											{
												current_bill_no = ifnull(input.Employee_Management_Bill.Bill_Number,"").trim();
												input.Bill_Number = current_bill_no;
											}
										}
										// ==================================================
										// GET DATE + GROUP FROM SELECTED PAYMENT VOUCHER
										// ==================================================
										pay_date_val = zoho.currentdate;
										voucher_group_id = null;
										if(input.Payment_Voucher != null)
										{
											pv_head = Payment_Made_Voucher[ID == input.Payment_Voucher];
											if(pv_head.ID != null)
											{
												if(pv_head.Payment_Voucher_Date != null)
												{
													pay_date_val = pv_head.Payment_Voucher_Date;
												}
												if(pv_head.Group != null)
												{
													voucher_group_id = pv_head.Group.ID;
												}
											}
										}
										// ==================================================
										// 1) IF BILL CHANGED ON EDIT, RECOMPUTE OLD BILL
										// ==================================================
										if(input.System == "Store Management" && old_bill_no != "" && old_bill_no != current_bill_no)
										{
											old_bill_total_paid = 0.0;
											old_bill_rows = Payment_Made_Voucher_Details[System == "Store Management" && Bill_Number == old_bill_no];
											for each  old_row in old_bill_rows
											{
												old_row_amt = round(ifnull(old_row.Amount_Paid,0.0),2);
												if(old_row_amt > 0)
												{
													old_bill_total_paid = round(old_bill_total_paid + old_row_amt,2);
												}
											}
											old_payload = Map();
											old_payload.put("Bill_Number",old_bill_no);
											old_payload.put("Total_Paid",old_bill_total_paid);
											old_payload.put("Payment_Date",pay_date_val);
											old_resp = store_management.updateBillFromPayment(old_payload);
											if(old_resp != null && old_resp.get("ok") == true)
											{
												old_po_resp = store_management.recheckPurchaseOrdersFromBill(old_bill_no);
												info old_po_resp;
											}
										}
										// ==================================================
										// 2) MAIN SYNC FOR CURRENT BILL
										// ==================================================
										if(input.System == "Asset Management" && input.Asset_Management_Bill != null && current_bill_no != "")
										{
											recomputed_total = 0.0;
											payment_rows = Payment_Made_Voucher_Details[System == "Asset Management" && Bill_Number == current_bill_no];
											for each  pay_row in payment_rows
											{
												row_amt = round(ifnull(pay_row.Amount_Paid,0.0),2);
												if(row_amt > 0)
												{
													recomputed_total = round(recomputed_total + row_amt,2);
												}
											}
											payload = Map();
											payload.put("Bill_Number",current_bill_no);
											payload.put("Total_Paid",recomputed_total);
											payload.put("Payment_Date",pay_date_val);
											asset_resp = asset_management.updateBillFromPayment(payload);
											if(asset_resp != null && asset_resp.get("ok") == true)
											{
												input.Old_Bill_Number = current_bill_no;
												input.Old_Amount_Paid = current_row_paid;
											}
											else
											{
												info asset_resp;
											}
										}
										else if(input.System == "Employee Management" && current_bill_no != "")
										{
											recomputed_total = 0.0;
											payment_rows = Payment_Made_Voucher_Details[System == "Employee Management" && Bill_Number == current_bill_no];
											for each  pay_row in payment_rows
											{
												row_amt = round(ifnull(pay_row.Amount_Paid,0.0),2);
												if(row_amt > 0)
												{
													recomputed_total = round(recomputed_total + row_amt,2);
												}
											}
											payload = Map();
											payload.put("Bill_Number",current_bill_no);
											payload.put("Total_Paid",recomputed_total);
											payload.put("Payment_Date",pay_date_val);
											emp_resp = employee_management.updateInvoiceFromReceipt(payload);
											if(emp_resp != null && emp_resp.get("ok") == true)
											{
												input.Old_Bill_Number = current_bill_no;
												input.Old_Amount_Paid = current_row_paid;
											}
											else
											{
												info emp_resp;
											}
										}
										else if(input.System == "Store Management" && input.Store_Management_Bill != null && current_bill_no != "")
										{
											recomputed_total = 0.0;
											payment_rows = Payment_Made_Voucher_Details[System == "Store Management" && Bill_Number == current_bill_no];
											for each  pay_row in payment_rows
											{
												row_amt = round(ifnull(pay_row.Amount_Paid,0.0),2);
												if(row_amt > 0)
												{
													recomputed_total = round(recomputed_total + row_amt,2);
												}
											}
											payload = Map();
											payload.put("Bill_Number",current_bill_no);
											payload.put("Total_Paid",recomputed_total);
											payload.put("Payment_Date",pay_date_val);
											store_resp = store_management.updateBillFromPayment(payload);
											if(store_resp != null && store_resp.get("ok") == true)
											{
												input.Old_Bill_Number = current_bill_no;
												if(old_bill_no == current_bill_no)
												{
													group_delta = round(current_row_paid - old_row_paid,2);
												}
												else
												{
													group_delta = current_row_paid;
												}
												// ==================================================
												// GROUP EXPENSE UPDATE - USE DELTA ONLY
												// ==================================================
												if(voucher_group_id != null && group_delta != 0)
												{
													source_group = "Store Purchases";
													group_date = pay_date_val;
													grp_rec = Group_Accounts[Group == voucher_group_id && Payment_Date == group_date && Source_Group == source_group];
													if(grp_rec.ID != null)
													{
														new_paid = round(ifnull(grp_rec.Amount_Actually_Paid,0.0) + group_delta,2);
														if(new_paid < 0)
														{
															new_paid = 0.0;
														}
														grp_rec.Amount_Actually_Paid=new_paid;
													}
													else
													{
														if(group_delta > 0)
														{
															insert into Group_Accounts
															[
																Group=voucher_group_id
																Payment_Date=group_date
																Source_Group=source_group
																Amount_Actually_Paid=group_delta
																Amount_to_Pay=0.0
																Added_User=zoho.loginuser
															]
														}
													}
												}
												input.Old_Amount_Paid = current_row_paid;
												po_resp = store_management.recheckPurchaseOrdersFromBill(current_bill_no);
												info "Store Bill Updated -> Paid: " + store_resp.get("bill_amount_paid") + " | Payment Status: " + store_resp.get("payment_status");
												info po_resp;
											}
											else
											{
												info store_resp;
											}
										}
										// ==================================================
										// 3) UPDATE PAYMENT VOUCHER TOTALS
										// ==================================================
										if(input.Payment_Voucher != null)
										{
											pv = Payment_Made_Voucher[ID == input.Payment_Voucher];
											if(pv.ID != null)
											{
												total_assigned = 0.0;
												all_rows = Payment_Made_Voucher_Details[Payment_Voucher == pv.ID];
												for each  r in all_rows
												{
													amt = round(ifnull(r.Amount_Paid,0.0),2);
													if(amt > 0)
													{
														total_assigned = round(total_assigned + amt,2);
													}
												}
												total_paid = round(ifnull(pv.Total_Amount_Paid,0.0),2);
												balance_not_assigned = round(total_paid - total_assigned,2);
												if(balance_not_assigned < 0)
												{
													balance_not_assigned = 0.0;
												}
												pv.Amount_Assigned=total_assigned;
												pv.Balance_Not_Assigned=balance_not_assigned;
												if(total_paid <= 0)
												{
													pv.Payment_Voucher_Status="Draft";
												}
												else if(total_assigned <= 0)
												{
													pv.Payment_Voucher_Status="Unassigned";
												}
												else if(balance_not_assigned > 0)
												{
													pv.Payment_Voucher_Status="Partially Assigned";
												}
												else
												{
													pv.Payment_Voucher_Status="Fully Assigned";
												}
											}
										}
						)
					}
				}

			}
			On_System_Selected as "On System Selected"
			{
				type =  form
				form = Payment_Made_Voucher_Details

				record event = on add or edit

				on user input of System
				{
					actions 
					{
						custom deluge script
						(
											// Reset all bill fields first
										input.Store_Management_Bill = null;
										input.Asset_Management_Bill = null;
										input.Employee_Management_Bill = null;
										input.Bill_Number = "";
										input.Amount_Due = 0.0;
										input.Amount_Paid = 0.0;
										hide Asset_Management_Bill;
										hide Employee_Management_Bill;
										hide Store_Management_Bill;
										// Control which bill field is enabled
										if(input.System == "Store Management")
										{
											show Store_Management_Bill;
											enable Store_Management_Bill;
											disable Asset_Management_Bill;
											disable Employee_Management_Bill;
										}
										else if(input.System == "Asset Management")
										{
											show Asset_Management_Bill;
											enable Asset_Management_Bill;
											disable Store_Management_Bill;
											disable Employee_Management_Bill;
										}
										else if(input.System == "Employee Management")
										{
											show Employee_Management_Bill;
											enable Employee_Management_Bill;
											disable Store_Management_Bill;
											disable Asset_Management_Bill;
										}
						)
					}
				}

			}
			On_Asset_Management_Bill_ as "On Asset Management Bill Selected"
			{
				type =  form
				form = Payment_Made_Voucher_Details

				record event = on add or edit

				on user input of Asset_Management_Bill
				{
					actions 
					{
						custom deluge script
						(
											if(input.Asset_Management_Bill != null)
										{
											input.Bill_Number = ifnull(input.Asset_Management_Bill.Bill_Number,"");
											input.Amount_Due = ifnull(input.Asset_Management_Bill.Amount_Due,0.0);
											paid_now = ifnull(input.Amount_Paid,0.0);
											// 	input.Balance_Due = ifnull(input.Amount_Due,0.0) - paid_now;
										}
										else
										{
											input.Bill_Number = "";
											input.Amount_Due = 0.0;
										}
						)
					}
				}

			}
			On_Asset_Selected as "On Asset Selected"
			{
				type =  form
				form = Group

				record event = on add or edit

				on user input of Asset
