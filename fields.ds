	reports
	{
		default list All_Payment_Accounts
		{
			displayName = "All Payment Accounts"
			show all rows from Account    
			(
				Provider
				Account_Name as "Account Name"
				Account_Number as "Account Number"
				Opening_Balance as "Opening Balance"
				Current_Balance as "Current Balance"
				(
					display = total	
				)
				Total_Credit as "Total Credit"
				(
					display = total	
				)
				Total_Debit as "Total Debit"
				(
					display = total	
				)
				Account_Status as "Account Status"
				Account_Type as "Account Type"
				Allow_Overdraft as "Allow Overdraft"
				Overdraft_Amount_Allowed as "Overdraft Amount Allowed"
				User_Name as "User Name"
				User_Email as "User Email"
				User_Role as "User Role"
				Created_By_Name as "Created By Name"
				Created_By_Email as "Created By Email"
				Created_By_Time as "Created By Time"
				Updated_By_Name as "Updated By Name"
				Updated_By_Email as "Updated By Email"
				Updated_By_Time as "Updated By Time"
				Unconfirmed_Total_Amount as "Unconfirmed Total Amount"
				(
					display = total	
				)
			)
			group by
			(
				Provider ascending
			)
		}
		default list All_Account_Types
		{
			displayName = "All Account Types"
			show all rows from Account_Types    
			(
				Account_Type_Name as "Account Type Name"
				Account_Code as "Account Code"
				Notes
				Status
				User_Name as "User Name"
				User_Email as "User Email"
