			On_Vendor_Service_Type_Se as "On Vendor Service Type Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Vendor_Service_Type
				{
					actions 
					{
						custom deluge script
						(
											// User input of Vendor_Service_Type (Work_Order_Tasks)
										isLabourService = false;
										isItemsService = false;
										if(input.Vendor_Service_Type == "Labour Only")
										{
											isLabourService = true;
										}
										else if(input.Vendor_Service_Type == "Items Only")
										{
											isItemsService = true;
										}
										if(isLabourService)
										{
											show Parts_Consumables;
											show Parts_Consumables.Labour;
											hide Parts_Consumables.Item;
											hide Parts_Total;
											show Labour_Total;
											show Grand_Total;
											hide Store_Manager;
											hide Display_Name_Store_Manager;
											input.Store_Manager = null;
											input.Display_Name_Store_Manager = "";
											for each  r in input.Parts_Consumables
											{
												if(r.Item != null)
												{
													r.Item=null;
													r.Display_Name_Item_Labour="";
													r.Quantity=null;
													r.Unit_Cost=null;
													r.Unit_Of_Measure="";
													r.Line_Total=null;
												}
											}
										}
										else if(isItemsService)
										{
											show Parts_Consumables;
											show Parts_Consumables.Item;
											hide Parts_Consumables.Labour;
											show Parts_Total;
											hide Labour_Total;
											show Grand_Total;
											show Store_Manager;
											//show Display_Name_Store_Manager;
											enable Store_Manager;
											if(input.Store_Manager != null)
											{
												input.Display_Name_Store_Manager = input.Store_Manager.Employee_Name + " - " + ifnull(input.Store_Manager.Employee_Number,"");
											}
											else
											{
												input.Display_Name_Store_Manager = "";
											}
											for each  r in input.Parts_Consumables
											{
												if(r.Labour != null)
												{
													r.Labour=null;
													r.Display_Name_Item_Labour="";
													r.Quantity=null;
													r.Unit_Cost=null;
													r.Unit_Of_Measure="";
													r.Line_Total=null;
												}
											}
										}
										else
										{
											hide Parts_Consumables;
											hide Parts_Total;
											hide Labour_Total;
											hide Grand_Total;
											hide Store_Manager;
											hide Display_Name_Store_Manager;
											input.Store_Manager = null;
											input.Display_Name_Store_Manager = "";
										}
										// ---- Recalculate totals ----
										parts_rows = List();
										for each  rr in input.Parts_Consumables
										{
											m = Map();
											m.put("Item",rr.Item);
											m.put("Labour",rr.Labour);
											m.put("Quantity",rr.Quantity);
											m.put("Unit Cost",rr.Unit_Cost);
											parts_rows.add(m);
										}
										input.Parts_Total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
										input.Labour_Total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Parts_Total,input.Labour_Total);
						)
					}
				}

			}
			On_Transaction_Type_Selec as "On Transaction Type Selected"
			{
				type =  form
				form = Payment_Charges

				record event = on add or edit

				on user input of Transaction_Type
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ON USER INPUT OF Transaction_Type
										// =====================================================
										if(input.Transaction_Type == "Payment Made")
										{
											show Payment_Made_Voucher;
											hide Payment_Receipt_Voucher;
											input.Payment_Receipt_Voucher = null;
											input.Display_Name_Payment_Voucher = "";
										}
										else if(input.Transaction_Type == "Payment Received")
										{
											show Payment_Receipt_Voucher;
											hide Payment_Made_Voucher;
											input.Payment_Made_Voucher = null;
											input.Display_Name_Payment_Voucher = "";
										}
										else
										{
											hide Payment_Made_Voucher;
											hide Payment_Receipt_Voucher;
											input.Payment_Made_Voucher = null;
											input.Payment_Receipt_Voucher = null;
											input.Display_Name_Payment_Voucher = "";
										}
						)
					}
				}

			}
			Finalize8 as "Finalize"
			{
				type =  form
				form = Payment_Charges

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PAYMENT CHARGES — FINALIZE
										// =====================================================
										// -----------------------------------------------------
										// Back End Time Text
										// -----------------------------------------------------
										created_time_txt = "";
										if(input.Created_By_Time != null)
										{
											created_time_txt = input.Created_By_Time.toString("dd-MMM-yyyy HH:mm:ss");
										}
										updated_time_txt = "";
										if(input.Updated_By_Time != null)
										{
											updated_time_txt = input.Updated_By_Time.toString("dd-MMM-yyyy HH:mm:ss");
										}
										// -----------------------------------------------------
										// Description
										// -----------------------------------------------------
										description = ifnull(input.Charge_Type,"");
										if(ifnull(input.Charge_Description,"") != "")
										{
											if(description != "")
											{
												description = description + " - ";
											}
											description = description + input.Charge_Description;
										}
										// =====================================================
										// PAYMENT MADE
										// =====================================================
										if(input.Transaction_Type == "Payment Made" && input.Payment_Made_Voucher != null)
										{
											pmv = Payment_Made_Voucher[ID == input.Payment_Made_Voucher.ID];
											if(pmv.ID != null)
											{
												total_charges = 0.0;
												for each  ch in Payment_Charges[Payment_Made_Voucher == pmv.ID]
												{
													total_charges = total_charges + ifnull(ch.Amount,0.0);
												}
												total_paid_details = 0.0;
												for each  det in pmv.Made_Details
												{
													total_paid_details = total_paid_details + ifnull(det.Amount_Paid,0.0);
												}
												total_allocated = total_charges + total_paid_details;
												pmv.Total_Charges=total_charges;
												pmv.Total_Amount_Allocated=total_allocated;
												pmv.Total_Amount_Not_Allocated=ifnull(pmv.Total_Amount_Paid,0.0) - total_allocated;
												if(pmv.Total_Amount_Not_Allocated < 0)
												{
													pmv.Total_Amount_Not_Allocated=0.0;
												}
												if(total_allocated == 0)
												{
													pmv.Payment_Made_Voucher_Status="Unassigned";
												}
												else if(pmv.Total_Amount_Not_Allocated > 0)
												{
													pmv.Payment_Made_Voucher_Status="Partially Assigned";
												}
												else
												{
													pmv.Payment_Made_Voucher_Status="Fully Assigned";
												}
												transaction_date_txt = "";
												if(pmv.Payment_Made_Date != null)
												{
													transaction_date_txt = pmv.Payment_Made_Date.toString("dd-MMM-yyyy");
												}
												payload = Map();
												payload.put("Payment_Voucher_Source_ID",pmv.ID.toLong());
												payload.put("Display_Name_Payment_Voucher",ifnull(input.Display_Name_Payment_Voucher,""));
												payload.put("Line_Number",input.Line_Number);
												payload.put("Description",description);
												payload.put("Amount_Allocated",ifnull(input.Amount,0.0));
												payload.put("Application","Kicks Klean Ug");
												payload.put("Transaction_Date",transaction_date_txt);
												payload.put("Source_Form","Payment Charges");
												payload.put("Source_Record_ID",input.ID.toLong());
												payload.put("Voucher_Number",ifnull(pmv.Payment_Made_Number,""));
												payload.put("User_Name",ifnull(input.User_Name,""));
												payload.put("User_Email",ifnull(input.User_Email,""));
												payload.put("User_Role",ifnull(input.User_Role,""));
												payload.put("Created_By_Name",ifnull(input.Created_By_Name,""));
												payload.put("Created_By_Email",ifnull(input.Created_By_Email,""));
												payload.put("Created_By_Time",created_time_txt);
												payload.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
												payload.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
												payload.put("Updated_By_Time",updated_time_txt);
												sync_resp = md_payment_management.syncPaymentChargesFromKicksklean(payload);
												info sync_resp;
											}
										}
										// =====================================================
										// PAYMENT RECEIVED
										// =====================================================
										else if(input.Transaction_Type == "Payment Received" && input.Payment_Receipt_Voucher != null)
										{
											prv = Payment_Receipt_Voucher[ID == input.Payment_Receipt_Voucher.ID];
											if(prv.ID != null)
											{
												total_charges = 0.0;
												for each  ch2 in Payment_Charges[Payment_Receipt_Voucher == prv.ID]
												{
													total_charges = total_charges + ifnull(ch2.Amount,0.0);
												}
												total_receipt_details = 0.0;
												for each  det2 in Payment_Receipt_Details[Payment_Receipt_Voucher == prv.ID]
												{
													total_receipt_details = total_receipt_details + ifnull(det2.Amount_Allocated,0.0);
												}
												total_allocated = total_charges + total_receipt_details;
												prv.Total_Charges=total_charges;
												prv.Total_Amount_Allocated=total_allocated;
												prv.Total_Amount_Not_Allocated=ifnull(prv.Total_Amount_Received,0.0) - total_allocated;
												if(prv.Total_Amount_Not_Allocated < 0)
												{
													prv.Total_Amount_Not_Allocated=0.0;
												}
												if(prv.Total_Amount_Not_Allocated <= 0)
												{
													prv.Payment_Receipt_Voucher_Status="Assigned";
												}
												else if(total_allocated > 0)
												{
													prv.Payment_Receipt_Voucher_Status="Partially Assigned";
												}
												else
												{
													prv.Payment_Receipt_Voucher_Status="Unassigned";
												}
												transaction_date_txt = "";
												if(prv.Payment_Receipt_Date != null)
												{
													transaction_date_txt = prv.Payment_Receipt_Date.toString("dd-MMM-yyyy");
												}
												payload = Map();
												payload.put("Payment_Voucher_Source_ID",prv.ID.toLong());
												payload.put("Display_Name_Payment_Voucher",ifnull(input.Display_Name_Payment_Voucher,""));
												payload.put("Line_Number",input.Line_Number);
												payload.put("Description",description);
												payload.put("Amount_Allocated",ifnull(input.Amount,0.0));
												payload.put("Application","Kicks Klean Ug");
												payload.put("Transaction_Date",transaction_date_txt);
												payload.put("Source_Form","Payment Charges");
												payload.put("Source_Record_ID",input.ID.toLong());
												payload.put("Voucher_Number",ifnull(prv.Payment_Receipt_Number,""));
												payload.put("User_Name",ifnull(input.User_Name,""));
												payload.put("User_Email",ifnull(input.User_Email,""));
												payload.put("User_Role",ifnull(input.User_Role,""));
												payload.put("Created_By_Name",ifnull(input.Created_By_Name,""));
												payload.put("Created_By_Email",ifnull(input.Created_By_Email,""));
												payload.put("Created_By_Time",created_time_txt);
												payload.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
												payload.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
												payload.put("Updated_By_Time",updated_time_txt);
												sync_resp = md_payment_management.syncPaymentChargesFromKicksklean(payload);
												info sync_resp;
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete7 as "Finalize On Delete"
			{
				type =  form
				form = Payment_Charges

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// PAYMENT CHARGES — ON DELETE
										// ======================================================
										if(input.Payment_Receipt_Voucher != null)
										{
											prv = Payment_Receipt_Voucher[ID == input.Payment_Receipt_Voucher];
											if(prv.ID != null)
											{
												total_charges = 0.0;
												charge_rows = Payment_Charges[Payment_Receipt_Voucher == prv.ID && ID != input.ID];
												for each  ch in charge_rows
												{
													total_charges = total_charges + ifnull(ch.Amount,0.0);
												}
												prv.Total_Charges=total_charges;
												amount_allocated = 0.0;
												receipt_rows = Payment_Receipt_Details[Payment_Receipt_Voucher == prv.ID];
												for each  rec in receipt_rows
												{
													amount_allocated = amount_allocated + ifnull(rec.Amount_Allocated,0.0);
												}
												prv.Total_Amount_Allocated=amount_allocated;
												total_received = ifnull(prv.Total_Amount_Received,0.0);
												amount_not_allocated = total_received - total_charges - amount_allocated;
												if(amount_not_allocated < 0)
												{
													amount_not_allocated = 0.0;
												}
												prv.Total_Amount_Not_Allocated=amount_not_allocated;
												if(amount_not_allocated <= 0)
												{
													prv.Payment_Receipt_Voucher_Status="Assigned";
												}
												else if(total_charges > 0 || amount_allocated > 0)
												{
													prv.Payment_Receipt_Voucher_Status="Partially Assigned";
												}
												else
												{
													prv.Payment_Receipt_Voucher_Status="Unassigned";
												}
											}
										}
										// =====================================================
										//PAYMENT CHARGES FINALIZE ON DELETE
										// =====================================================
										delete_payload = Map();
										delete_payload.put("Source_Record_ID",input.ID);
										delete_payload.put("Source_Form","Payment Charges");
										delete_resp = md_payment_management.deletePaymentChargesFromKicksklean(delete_payload);
										info delete_resp;
						)
					}
				}

			}
