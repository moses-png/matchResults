				type =  form
				form = Contact_Email_Update

				record event = on add or edit

				on user input of Start_Date
				{
					actions 
					{
						custom deluge script
						(
											// Validate dates
										if(input.End_Date != null)
										{
											if(input.End_Date < input.Start_Date)
											{
												alert "End Date cannot be earlier than Start Date.";
												input.End_Date = null;
												return;
											}
										}
										// Auto status based on current date
										if(input.End_Date != null)
										{
											if(input.End_Date < zoho.currentdate)
											{
												input.Contact_Email_Status = "Inactive";
											}
											else
											{
												input.Contact_Email_Status = "Active";
											}
										}
										else
										{
											input.Contact_Email_Status = "Active";
										}
						)
					}
				}

			}
