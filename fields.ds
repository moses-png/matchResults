
 application ""
 {
 	

 	forms
	{
		form Asset_ID_Sequence
		{
			displayname = "Asset ID Sequence"
			success message = "Asset Id Sequence Added Successfully"
			Asset_ID_Sequence_Details
			(
				type = section
				displayname = "Asset ID Sequence Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Prefix
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Next_Number
			(
				type = number
				displayname = "Next Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Back_End
			(
				type = section
				displayname = "Back End"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			User_Role
			(
    			type = text
				displayname = "User Role"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Created_By_Name
			(
    			type = text
				displayname = "Created By Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Created_By_Email
			(
    			type = email
				displayname = "Created By Email"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Created_By_Time
			(
    			type = datetime
				displayname = "Created By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Updated_By_Name
			(
    			type = text
				displayname = "Updated By  Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Updated_By_Email
			(
    			type = email
				displayname = "Updated By Email"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Updated_By_Time
			(
    			type = datetime
				displayname = "Updated By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Asset_Inspection
		{
			displayname = "Asset Inspection"
			success message = "Asset Inspection Added Successfully"
			Section1
			(
				type = section
				displayname = "Inspection Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Inspection_ID
			(
				type = number
				displayname = "Inspection ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			unique Inspection_Voucher_Number
			(
    			type = text
				displayname = "Inspection Voucher Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Asset
			(
				type = picklist	
				values  = Asset_List.ID
    			displayformat = [Asset_Name + " - " + Asset_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Inspection_Date_Time
			(
    			type = datetime
				displayname = "Inspection Date-Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Inspector
			(
				type = picklist	
				values  = employee_management.Employee_Register.ID
    			displayformat = [Employee_Name + " - " + Employee_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Odometer_Reading
			(
				type = decimal
				displayname = "Odometer Reading"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Inspection_Type
			(
				type = picklist
				displayname = "Inspection Type"
				maxchar = 100
				values = {"Routine","Pre-Transfer","Pre-Repair","Post-Repair"}
				sortorder = ascending
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Overall_Condition
			(
				type = picklist
				displayname = "Overall Condition"
				maxchar = 100
				values = {"Excellent","Good","Fair","Poor","Unserviceable Condition"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issues_Found
			(
    			type = textarea
				displayname = "Issues Found"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Required
			(
    			type = textarea
				displayname = "Action Required"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Next_Inspection_Date
			(
    			type = date
				displayname = "Next Inspection Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			File_upload
			(
    			type = upload file
				displayname = "File upload"
    			file count = 10
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Inspection_Checklist
			(
				type = grid
				displayname = "Inspection Checklist"
				values  = Inspection_Checklist_Item.ID
    			bidirectional = Inspection_Voucher_Nu
	 			row = 2
	 			column = 1   
				width = medium
			)
			Back_End
			(
				type = section
				displayname = "Back End"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 3
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Use_role
			(
    			type = text
				displayname = "User Role"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Created_By_Name
			(
    			type = text
				displayname = "Created By Name"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Created_By_Email
			(
    			type = email
				displayname = "Created By Email"
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Created_By_Time
			(
    			type = datetime
				displayname = "Created By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Updated_By_Name
			(
    			type = text
				displayname = "Updated By Name"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Updated_By_Email
			(
    			type = email
				displayname = "Updated By Email"
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Updated_By_Time
			(
    			type = datetime
				displayname = "Updated By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Asset_Issues
		{
			displayname = "Asset Issues"
			success message = "Asset Issue Added Successfully"
			Asset_Issue_Details
			(
				type = section
