		 functions
		 {
			 Deluge
			 {
				 string Build_Display_Name(string update_type, string contact, string contact_names, string email)
                 {
                 	// normalize inputs
                 	if(update_type == null)
                 	{
                 		update_type = "";
                 	}
                 	else
                 	{
                 		update_type = update_type.trim();
                 	}
                 	if(contact == null)
                 	{
                 		contact = "";
                 	}
                 	else
                 	{
                 		contact = contact.trim();
                 	}
                 	if(contact_names == null)
                 	{
                 		contact_names = "";
                 	}
                 	else
                 	{
                 		contact_names = contact_names.trim();
                 	}
                 	if(email == null)
                 	{
                 		email = "";
                 	}
                 	else
                 	{
                 		email = email.trim();
                 	}
                 	// Contact path
                 	if(update_type.equalsIgnoreCase("Contact"))
                 	{
                 		contact = thisapp.normalize_ug_phone(contact);
                 		if(contact == "" || contact_names == "")
                 		{
                 			return "";
                 		}
                 		return contact + " - " + contact_names;
                 	}
                 	// Email path
                 	else if(update_type.equalsIgnoreCase("Email"))
                 	{
                 		if(email == "")
                 		{
                 			return "";
                 		}
                 		return email.toLowerCase();
                 	}
                 	// Fallback
                 	else
                 	{
                 		return "";
                 	}
                 }
				 string Build_Employee_Name_ID(string emp_name, int emp_id)
                 {
                 	if(emp_name != null && emp_name.trim() != "" && emp_id != null)
                 	{
                 		return emp_name.trim() + " - " + emp_id.toString();
                 	}
                 	return null;
                 }
				 map checkVoucherTransferCase(map data)
                 {
                 	resp = Map();
                 	resp.put("ok",true);
                 	resp.put("message","");
                 	case_no = ifnull(data.get("case_no"),"").trim();
                 	transport_date = data.get("transport_date");
                 	sameDateBlockedCase = Voucher_Transfer_Register[Case_Number == case_no && Transport_Date == transport_date && Case_Status != "Open" && Case_Status != "In Transit"];
                 	if(sameDateBlockedCase.ID != null)
                 	{
                 		resp.put("ok",false);
                 		resp.put("message","Case Number " + case_no + " is already " + sameDateBlockedCase.Case_Status + " for " + transport_date.toString() + ".");
                 		return resp;
                 	}
                 	differentDateBlockedCase = Voucher_Transfer_Register[Case_Number == case_no && Transport_Date != transport_date && Case_Status != "Open"];
                 	if(differentDateBlockedCase.ID != null)
                 	{
                 		resp.put("ok",false);
                 		resp.put("message","Case Number " + case_no + " was already used on " + differentDateBlockedCase.Transport_Date.toString() + " and is " + differentDateBlockedCase.Case_Status + ". Reopen that case first.");
                 		return resp;
                 	}
                 	return resp;
                 }
				 void closeIssueAndUpdateRoutineFromFreedomHalls()
                 {
                 }
				 map closeVoucherTransferCase(string case_no, int received_count)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("msg","Transfer case not found");
                 	try 
                 	{
                 		case_no = ifnull(case_no,"").trim();
                 		if(case_no == "")
                 		{
                 			response.put("msg","Case Number is required");
                 		}
                 		else
                 		{
                 			transfer_records = Voucher_Transfer_Register[Case_Number == case_no];
                 			record_found = false;
                 			expected_count = 0;
                 			closed_count = 0;
                 			for each  transfer_rec in transfer_records
                 			{
                 				record_found = true;
                 				current_expected = ifnull(transfer_rec.Number_Of_Vouchers,0);
                 				if(current_expected > expected_count)
                 				{
                 					expected_count = current_expected;
                 				}
                 				if(current_expected > 0 && received_count >= current_expected)
                 				{
                 					transfer_rec.Case_Status="Closed";
                 					transfer_rec.Updated_By_Time=zoho.currenttime;
                 					closed_count = closed_count + 1;
                 				}
                 				else if(ifnull(transfer_rec.Case_Status,"") != "Closed")
                 				{
                 					transfer_rec.Case_Status="In Transit";
                 					transfer_rec.Updated_By_Time=zoho.currenttime;
                 				}
                 			}
                 			if(record_found == true)
                 			{
                 				response.put("ok",true);
                 				response.put("Case_Number",case_no);
                 				response.put("Expected_Vouchers",expected_count);
                 				response.put("Received_Vouchers",received_count);
                 				response.put("Closed_Records",closed_count);
                 				if(expected_count > 0 && received_count >= expected_count)
                 				{
                 					response.put("msg","All vouchers reached Head Office. Case closed.");
                 				}
                 				else
                 				{
                 					response.put("msg","Case remains In Transit.");
                 				}
                 			}
                 		}
                 	}	catch (e)
                 	{
                 		response.put("ok",false);
                 		response.put("msg",e.toString());
                 	}
                 	return response;
                 }
				 string compute_employment_status(date date_started, date date_ended)
                 {
                 	// Default
                 	status_val = "Inactive";
                 	if(date_started != null)
                 	{
                 		// No end date → active from start date onward
                 		if(date_ended == null)
                 		{
                 			if(zoho.currentdate >= date_started)
                 			{
                 				status_val = "Active";
                 			}
                 		}
                 		else
                 		{
                 			// Inclusive bounds
                 			if(zoho.currentdate >= date_started && zoho.currentdate <= date_ended)
                 			{
                 				status_val = "Active";
                 			}
                 		}
                 	}
                 	return status_val;
                 }
				 map compute_estimated_takes(float daily, float weekly, float monthly)
                 {
                 	if(daily == null)
                 	{
                 		daily = 0.0;
                 	}
                 	if(weekly == null)
                 	{
                 		weekly = 0.0;
                 	}
                 	if(monthly == null)
                 	{
                 		monthly = 0.0;
                 	}
                 	per_day = daily + weekly / 7.0 + monthly * 12.0 / 365.0;
                 	per_month = daily * 365.0 / 12.0 + weekly * 52.0 / 12.0 + monthly;
                 	per_day = round(per_day,2);
                 	per_month = round(per_month,2);
                 	out = Map();
                 	out.put("per_day",per_day);
                 	out.put("per_month",per_month);
                 	return out;
                 }
				 void create_fuel_receiving_from_asset(map payload)
                 {
                 	asset_fuel_id = payload.get("asset_fuel_id");
                 	voucher_id = payload.get("voucher_id");
                 	source_form_text = "Fuel Receiving Voucher";
                 	if(asset_fuel_id == null)
                 	{
                 		info "Asset Fuel ID missing.";
                 		return;
                 	}
                 	if(voucher_id == null)
                 	{
                 		info "Employee Voucher ID missing.";
                 		return;
                 	}
                 	existing = Fuel_Receiving_Voucher[Source_Record_ID == asset_fuel_id && Source_Form == source_form_text];
                 	if(existing.count() > 0)
                 	{
                 		for each  r in existing
                 		{
                 			r.Voucher=voucher_id;
                 			r.Fuel_Receiving_Voucher=asset_fuel_id;
                 			r.Fuel_Issuing_Time=payload.get("fuel_issuing_time");
                 			r.Issued_By=payload.get("issued_by");
                 			r.Supplied_By=payload.get("supplied_by");
                 			r.Quantity=ifnull(payload.get("quantity"),0.0);
                 			r.Rate=ifnull(payload.get("rate"),0.0);
                 			r.Line_Total=round(ifnull(payload.get("quantity"),0.0) * ifnull(payload.get("rate"),0.0),2);
                 			r.Fuel_Level_Before=payload.get("fuel_level_before");
                 			r.Fuel_Level_After=payload.get("fuel_level_after");
                 			r.Source_Record_ID=asset_fuel_id;
                 			r.Source_Form=source_form_text;
                 			break;
                 		}
                 		info "Updated Employee Fuel Receiving row.";
                 		return;
                 	}
                 	next_line = 1;
                 	old_rows = Fuel_Receiving_Voucher[Voucher == voucher_id] sort by Line_Number desc;
                 	for each  old in old_rows
                 	{
                 		next_line = ifnull(old.Line_Number,0) + 1;
                 		break;
                 	}
                 	insert into Fuel_Receiving_Voucher
                 	[
                 		Voucher=voucher_id
                 		Line_Number=next_line
                 		Fuel_Receiving_Voucher=asset_fuel_id
                 		Fuel_Issuing_Time=payload.get("fuel_issuing_time")
                 		Issued_By=payload.get("issued_by")
                 		Supplied_By=payload.get("supplied_by")
                 		Quantity=ifnull(payload.get("quantity"),0.0)
                 		Rate=ifnull(payload.get("rate"),0.0)
                 		Line_Total=round(ifnull(payload.get("quantity"),0.0) * ifnull(payload.get("rate"),0.0),2)
                 		Fuel_Level_Before=payload.get("fuel_level_before")
                 		Fuel_Level_After=payload.get("fuel_level_after")
                 		Source_Record_ID=asset_fuel_id
                 		Source_Form=source_form_text
                 		Added_User=zoho.loginuser
                 	]
                 	info "Created Employee Fuel Receiving row.";
                 }
				 void defaultFunction(List input)
                 {
                 	for each  rec_id in input
                 	{
                 		rec = Voucher[ID == rec_id];
                 		if(rec.ID != null && rec.Voucher_Status == "Human Resource")
                 		{
                 			rec.Voucher_Status="Audited";
                 		}
                 	}
                 }
				 map deleteEmployeeIssuingFromStore(map input)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("msg","Unknown error");
                 	try 
                 	{
                 		source_record_id = input.get("Source_Record_ID");
                 		if(source_record_id == null)
                 		{
                 			response.put("msg","Source_Record_ID is missing");
                 			return response;
                 		}
                 		source_record_id_num = source_record_id.toLong();
                 		deleted_count = 0;
                 		for each  rec in Employee_Issuing_Details[Source_Record_ID == source_record_id_num]
                 		{
                 			delete from Employee_Issuing_Details[ID == rec.ID];
                 			deleted_count = deleted_count + 1;
                 		}
                 		response.put("ok",true);
                 		response.put("msg","Employee issuing details deleted");
                 		response.put("deleted_count",deleted_count);
                 	}
                 	catch (e)
                 	{
                 		response.put("msg",e.toString());
                 	}
                 	return response;
                 }
				 map deleteEmployeeReceivingFromStore(map payload)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("deleted_count",0);
                 	result.put("message","");
                 	src_id = ifnull(payload.get("Source_Record_ID"),"").toString().trim();
                 	src_form = ifnull(payload.get("Source_Form"),"Stock Receiving Details").toString().trim();
                 	if(src_id == "")
                 	{
                 		result.put("message","Source_Record_ID is required.");
                 		return result;
                 	}
                 	deleted_count = 0;
                 	rows = Employee_Receiving_Details[Source_Record_ID == src_id && Source_Form == src_form];
                 	for each  r in rows
                 	{
                 		delete from Employee_Receiving_Details[ID == r.ID];
                 		deleted_count = deleted_count + 1;
                 	}
                 	// Fallback for older synced rows that used the prefixed source form
                 	if(deleted_count == 0)
                 	{
                 		rows2 = Employee_Receiving_Details[Source_Record_ID == src_id && Source_Form == "Store Management - Stock Receiving Details"];
                 		for each  r2 in rows2
                 		{
                 			delete from Employee_Receiving_Details[ID == r2.ID];
                 			deleted_count = deleted_count + 1;
                 		}
                 	}
                 	result.put("ok",true);
                 	result.put("deleted_count",deleted_count);
                 	result.put("message","Employee Receiving synced rows deleted.");
                 	return result;
                 }
				 map deleteItemIssuingFromStore(map input)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("msg","Unknown error");
                 	source_record_id = input.get("Source_Record_ID");
                 	if(source_record_id == null)
                 	{
                 		response.put("msg","Source_Record_ID is missing");
                 		return response;
                 	}
                 	rows = Item_Issuing_Details[Source_Record_ID == source_record_id];
                 	for each  r in rows
                 	{
                 		delete from Item_Issuing_Details[ID == r.ID];
                 	}
                 	response.put("ok",true);
                 	response.put("msg","Item issuing detail deleted");
                 	return response;
                 }
				 map deleteStockBundlingFromStore(map payload)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("deleted_count",0);
                 	result.put("message","");
                 	src_id_raw = payload.get("Source_Record_ID");
                 	if(src_id_raw == null || src_id_raw.toString().trim() == "")
                 	{
                 		result.put("message","Source_Record_ID is required.");
                 		return result;
                 	}
                 	src_id = src_id_raw.toLong();
                 	src_form = ifnull(payload.get("Source_Form"),"Store Management - Stock Receiving Details").toString().trim();
                 	deleted_count = 0;
                 	rows = Stock_Bundling_Note[Source_Record_ID == src_id && Source_Form == src_form];
                 	for each  r in rows
                 	{
                 		delete from Stock_Bundling_Note[ID == r.ID];
                 		deleted_count = deleted_count + 1;
                 	}
                 	if(deleted_count == 0)
                 	{
                 		rows2 = Stock_Bundling_Note[Source_Record_ID == src_id && Source_Form == "Stock Receiving Details"];
                 		for each  r2 in rows2
                 		{
                 			delete from Stock_Bundling_Note[ID == r2.ID];
                 			deleted_count = deleted_count + 1;
                 		}
                 	}
                 	result.put("ok",true);
                 	result.put("deleted_count",deleted_count);
                 	result.put("message","Stock Bundling Note synced rows deleted.");
                 	return result;
                 }
