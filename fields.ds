			On_Asset_Selected4 as "On Asset Selected"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add or edit

				on user input of Asset
				{
					actions 
					{
						custom deluge script
						(
											if(input.Asset != null)
										{
											input.Display_Name_Asset = input.Asset.Asset_Name + " - " + input.Asset.Asset_ID;
											if(input.Fuel_Issuing_Time == null)
											{
												input.Fuel_Issuing_Time = zoho.currenttime;
											}
											if(input.Asset.Odometer_Unit_Of_Measure == "days")
											{
												input.Odometer = ifnull(input.Asset.Odometer_Reading,0.0);
												disable Odometer;
											}
											else
											{
												input.Odometer = null;
												enable Odometer;
											}
										}
										else
										{
											input.Display_Name_Asset = "";
											input.Odometer = null;
											enable Odometer;
										}
						)
					}
				}

			}
			On_Email_Selected as "On Email Selected"
			{
				type =  form
				form = Email_User

				record event = on add or edit

				on user input of Email
				{
					actions 
					{
						custom deluge script
						(
											if(input.Email != null && input.Email.trim() != "")
										{
											// Convert to lowercase and trim
											email_value = input.Email.toLowerCase().trim();
											// Remove @gmail.com
											email_user = email_value.replaceAll("@gmail.com","");
											// Save Email User
											input.Email_User = email_user;
											// Default prefix
											prefix_value = email_user;
											// Check if last 2 characters are numbers
											if(email_user.length() >= 2)
											{
												last_two = email_user.right(2);
												// If numeric
												if(last_two.isNumber())
												{
													prefix_value = email_user.left(email_user.length() - 2);
												}
											}
											// Save Prefix
											input.Email_Prefix = prefix_value;
										}
										else
										{
											input.Email_User = "";
											input.Email_Prefix = "";
										}
						)
					}
				}

			}
