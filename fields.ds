			On_Credit_Note_Selected as "On Credit Note Selected"
			{
				type =  form
				form = Payment_Received

				record event = on add or edit

				on user input of Credit_Note
				{
					actions 
					{
						custom deluge script
						(
											// ---- On Credit_Note Selected ----
										// If a Credit Note is selected
										if(input.Credit_Note != null)
										{
											// 1) Force Payment Type to Credit
											input.Payment_Type = "Credit";
											// 2) Make sure total Amount matches Amount Due (optional but recommended)
											if(input.Amount_Due != null)
											{
												input.Amount = input.Amount_Due;
											}
											else
											{
												input.Amount = 0;
											}
											// 3) Credit the full amount due
											input.Amount_Credited = input.Amount_Due;
											// 4) Clear cash/mobile money received (avoid double counting)
											input.Amount_Received = 0;
											// 5) Recalculate balance due
											// Balance Due = Amount - (Amount Received + Amount Credited)
											amtTotal = ifnull(input.Amount,0);
											amtReceived = ifnull(input.Amount_Received,0);
											amtCredited = ifnull(input.Amount_Credited,0);
											input.Balance_Due = amtTotal - (amtReceived + amtCredited);
											// 6) UI behavior (optional but recommended)
											hide Amount_Received;
											show Amount_Credited;
											disable Payment_Type;
										}
										else
										{
											// ---- If Credit Note is cleared ----
											// Reset credit-related values and restore normal entry
											// Enable payment type again
											enable Payment_Type;
											// Clear credited amount
											input.Amount_Credited = 0;
											// Show fields back for Cash / Mobile Money use
											show Amount_Received;
											hide Amount_Credited;
											// Recalculate balance due again (based on any existing values)
											amtTotal = ifnull(input.Amount,0);
											amtReceived = ifnull(input.Amount_Received,0);
											amtCredited = ifnull(input.Amount_Credited,0);
											input.Balance_Due = amtTotal - (amtReceived + amtCredited);
										}
						)
					}
				}

			}
