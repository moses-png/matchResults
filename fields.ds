			Finalize6 as "Finalize"
			{
				type =  form
				form = Asset_List

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										user_name_val = u.get("name");
										user_email_val = u.get("email");
										user_role_val = u.get("role");
										asset_id = input.ID;
										if(asset_id != null && input.Odometer_Reading != null && input.Date_Time_Odometer_Read != null && input.Odometer_Unit_Of_Measure != null)
										{
											prev_odometer = 0.0;
											distance_val = 0.0;
											// Find the mileage log that was originally created from this Asset List record
											existing_logs = Asset_Mileage_Log[Source_Record_ID == asset_id.toString() && Odometer_Source_Form == "Asset List"];
											if(existing_logs.count() > 0)
											{
												for each  log_rec in existing_logs
												{
													prev_odometer = ifnull(log_rec.Previous_Odometer,0.0);
													distance_val = ifnull(input.Odometer_Reading,0.0) - prev_odometer;
													if(distance_val < 0)
													{
														distance_val = 0.0;
													}
													log_rec.Asset=asset_id;
													log_rec.Date_Time_Recorded=input.Date_Time_Odometer_Read;
													log_rec.Odometer_Reading=input.Odometer_Reading;
													log_rec.Distance_Since_Last=distance_val;
													log_rec.Unit_of_Measure=input.Odometer_Unit_Of_Measure;
													log_rec.Reference=input.Display_Name_Asset_Name;
													log_rec.Notes="Auto-updated from Asset List";
													log_rec.User_Name=user_name_val;
													log_rec.User_Email=user_email_val;
													log_rec.User_Role=user_role_val;
													log_rec.Updated_By_Name=user_name_val;
													log_rec.Updated_By_Email=user_email_val;
													log_rec.Updated_By_Time=zoho.currenttime;
													break;
												}
											}
											else
											{
												// Only create if one does not already exist
												last_logs = Asset_Mileage_Log[Asset == asset_id] sort by ID desc;
												if(last_logs.count() > 0)
												{
													for each  last_log in last_logs
													{
														prev_odometer = ifnull(last_log.Odometer_Reading,0.0);
														break;
													}
												}
												distance_val = ifnull(input.Odometer_Reading,0.0) - prev_odometer;
												if(distance_val < 0)
												{
													distance_val = 0.0;
												}
												insert into Asset_Mileage_Log
												[
													Asset=asset_id
													Date_Time_Recorded=input.Date_Time_Odometer_Read
													Odometer_Reading=input.Odometer_Reading
													Previous_Odometer=prev_odometer
													Distance_Since_Last=distance_val
													Unit_of_Measure=input.Odometer_Unit_Of_Measure
													Odometer_Source_Form="Asset List"
													Source_Record_ID=asset_id.toString()
													Reference=input.Display_Name_Asset_Name
													Notes="Auto-created from Asset List"
													User_Name=user_name_val
													User_Email=user_email_val
													User_Role=user_role_val
													Created_By_Name=user_name_val
													Created_By_Email=user_email_val
													Created_By_Time=zoho.currenttime
													Added_User=zoho.loginuser
												]
											}
										}
						)
					}
				}

			}
