			On_Card_Source_Selected as "On Card Source Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Card_Source
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// CARD SOURCE - ON USER INPUT
										// =====================================================
										if(input.Card_Source == "Masaka Sites")
										{
											show Card_Masaka;
											enable Card_Masaka;
											hide Card_Clean_Sand;
											disable Card_Clean_Sand;
											input.Card_Clean_Sand = null;
										}
										else if(input.Card_Source == "Clean Sand")
										{
											show Card_Clean_Sand;
											enable Card_Clean_Sand;
											hide Card_Masaka;
											disable Card_Masaka;
											input.Card_Masaka = null;
										}
										else
										{
											hide Card_Masaka;
											disable Card_Masaka;
											input.Card_Masaka = null;
											hide Card_Clean_Sand;
											disable Card_Clean_Sand;
											input.Card_Clean_Sand = null;
										}
						)
					}
				}

			}
			On_Delivery_Location_Sele as "On Delivery Location Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Delivery_Location
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// TRUCK MOVEMENT VOUCHER
										// DELIVERY LOCATION - ON USER INPUT
										// TJS01 - CARD SALES
										// =====================================================
										if(input.Job != null && input.Job.Job_No == "TJS01")
										{
											if(input.Delivery_Location == "Company Sites")
											{
												show Site_To;
												show Site_Location_To;
												hide Batch_Number_To;
												input.Batch_Number_To = null;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
											}
											else if(input.Delivery_Location == "Suppliers")
											{
												show Party_To;
												show Party_Location_To;
												hide Batch_Number_To;
												input.Batch_Number_To = null;
												hide Site_To;
												hide Site_Location_To;
												input.Site_To = null;
												input.Site_Location_To = null;
											}
											else
											{
												hide Site_To;
												hide Site_Location_To;
												input.Site_To = null;
												input.Site_Location_To = null;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
												hide Batch_Number_To;
												input.Batch_Number_To = null;
											}
										}
						)
					}
				}

			}
