			On_Truck_Measurement_Sele as "On Truck Measurement Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Truck_Measurement
				{
					actions 
					{
						custom deluge script
						(
											// Sales Voucher -> On Truck Measurement Selected
										// Auto-fill Truck Size 1/2, then compute Truck_CBM + totals
										if(input.Truck_Measurement == null)
										{
											// Clear everything if measurement removed
											input.Truck_Size_1 = null;
											input.Truck_Size_2 = null;
											input.Truck_Size = null;
											input.Truck_CBM = null;
											// Recalculate totals safely
											itemTotal = 0;
											for each  r in input.Item_Sales
											{
												itemTotal = itemTotal + ifnull(r.Line_Total,0);
											}
											sandAmt = 0;
											input.Amount_Supposed_To_Pay_Sand_Sales = round(sandAmt,2);
											input.Amount_Supposed_To_Pay_Item_Sales = round(itemTotal,2);
											input.Amount_Supposed_To_Pay = round(sandAmt + itemTotal,2);
											return;
										}
										// 1) Auto-fill sizes from Truck Measurement
										input.Truck_Size_1 = input.Truck_Measurement.Truck_Size_1;
										input.Truck_Size_2 = input.Truck_Measurement.Truck_Size_2;
										// 2) Decide Truck_Size if not selected yet
										if(input.Truck_Size == null)
										{
											if(input.Truck_Size_1 != null && input.Truck_Size_2 == null)
											{
												input.Truck_Size = "Truck Size 1";
											}
											else if(input.Truck_Size_2 != null && input.Truck_Size_1 == null)
											{
												input.Truck_Size = "Truck Size 2";
											}
											else
											{
												input.Truck_Size = "Truck Size 1";
											}
										}
										// 3) Compute Truck_CBM based on Truck_Size
										cbm = 0.0;
										if(input.Truck_Size == "Truck Size 1")
										{
											cbm = ifnull(input.Truck_Size_1,0.0);
										}
										else if(input.Truck_Size == "Truck Size 2")
										{
											cbm = ifnull(input.Truck_Size_2,0.0);
										}
										else
										{
											input.Truck_CBM = null;
											itemTotal = 0;
											for each  r in input.Item_Sales
											{
												itemTotal = itemTotal + ifnull(r.Line_Total,0);
											}
											sandAmt = 0;
											input.Amount_Supposed_To_Pay_Sand_Sales = round(sandAmt,2);
											input.Amount_Supposed_To_Pay_Item_Sales = round(itemTotal,2);
											input.Amount_Supposed_To_Pay = round(sandAmt + itemTotal,2);
											return;
										}
										// 4) Round CBM
										input.Truck_CBM = round(cbm,1);
										// 5) Compute totals
										sand_total = ifnull(input.Rate_per_CBM,0) * ifnull(input.Truck_CBM,0);
										item_total = 0;
										for each  r in input.Item_Sales
										{
											item_total = item_total + ifnull(r.Line_Total,0);
										}
										input.Amount_Supposed_To_Pay_Sand_Sales = round(sand_total,2);
										input.Amount_Supposed_To_Pay_Item_Sales = round(item_total,2);
										input.Amount_Supposed_To_Pay = round(sand_total + item_total / 10000,2);
						)
					}
				}

			}
