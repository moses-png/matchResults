			Full_Validation10 as "Full Validation"
			{
				type =  form
				form = Delivery_Note

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// DELIVERY NOTE -> FULL VALIDATION
										// (Validations on form submission)
										// ===============================
										errors = "";
										// Identify customers that do NOT use PO flow
										custName = "";
										noPO = false;
										if(input.Customer != null)
										{
											custName = ifnull(input.Customer.Display_Name_Customer,"").trim();
											noPO = custName == "Mrsand - 20" || custName == "Grapes Trucks - 18";
										}
										// 1) Receipt Officer Daily Voucher is Required
										if(input.Receipt_Officer_Daily_Voucher == null)
										{
											errors = errors + "\n• Receipt Officer Daily Voucher is required.";
										}
										// 2) Delivery Note Number is Required
										if(input.Delivery_Note_Number == null || input.Delivery_Note_Number.trim() == "")
										{
											errors = errors + "\n• Delivery Note Number is required.";
										}
										// 3) Customer is Required
										if(input.Customer == null)
										{
											errors = errors + "\n• Customer is required.";
										}
										// 4) Purchase Order is Required (EXCEPT noPO customers)
										if(noPO == false && input.Purchase_Order == null)
										{
											errors = errors + "\n• Purchase Order is required.";
										}
										// 5) Purchase Order Details is Required (EXCEPT noPO customers)
										if(noPO == false)
										{
											poLines = input.Purchase_Order_Details;
											if(poLines == null || poLines.isEmpty())
											{
												errors = errors + "\n• Purchase Order Details is required (add at least one item line).";
											}
										}
										// 6) Location is Required (EXCEPT noPO customers)
										if(noPO == false && input.Location == null)
										{
											errors = errors + "\n• Location is required.";
										}
										// 7) Delivery Date is Required (EXCEPT noPO customers, since you hide it)
										if(noPO == false && input.Delivery_Note_Date == null)
										{
											errors = errors + "\n• Delivery Date is required.";
										}
										// 8) Truck Number Plate is Required
										if(input.Number_Plate == null)
										{
											errors = errors + "\n• Truck Number Plate is required.";
										}
										// 9) Driver Name is Required
										if(input.Driver_Name == null || input.Driver_Name.trim() == "")
										{
											errors = errors + "\n• Driver Name is required.";
										}
										// 10) Prepared By is Required
										if(input.Prepared_By == null)
										{
											errors = errors + "\n• Prepared By is required.";
										}
										// 11) Received By is Required
										if(input.Received_By == null || input.Received_By.trim() == "")
										{
											errors = errors + "\n• Received By is required.";
										}
										// FINAL: stop submission if errors exist
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			On_Amount_To_Pay_Selected as "On Amount To Pay Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Amount_To_Pay
				{
					actions 
					{
						custom deluge script
						(
											// Guard: nothing to calculate without Amount To Pay
										if(input.Amount_To_Pay == null)
										{
											input.Balance_Due = null;
											return;
										}
										// Normalize values
										supposed = round(ifnull(input.Amount_Supposed_To_Pay,0.0),2);
										amountToPay = round(ifnull(input.Amount_To_Pay,0.0),2);
										amountPaid = round(ifnull(input.Amount_Paid,0.0),2);
										amountCredited = round(ifnull(input.Amount_Credited,0.0),2);
										// ---------------------------------------------------
										// Validate Amount To Pay against Amount Supposed To Pay
										// Allow more, but do not allow shortage beyond 0.5
										// ---------------------------------------------------
										min_allowed = round(supposed - 0.5,2);
										if(amountToPay < min_allowed)
										{
											alert "Amount To Pay is too low. Minimum allowed is " + min_allowed.toString() + ".";
											input.Amount_To_Pay = supposed;
											input.Balance_Due = supposed - (amountPaid + amountCredited);
											return;
										}
										// ---------------------------------------------------
										// Calculate Balance Due
										// ---------------------------------------------------
										balance = amountToPay - (amountPaid + amountCredited);
										if(balance < 0)
										{
											input.Balance_Due = 0;
										}
										else
										{
											input.Balance_Due = balance;
										}
						)
					}
				}

			}
			Set_up_Form15 as "Set up Form"
			{
				type =  form
				form = Cashier_Paper

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// DISABLE FIELDS
										//Cashier Section
										disable Display_Name_Site;
										//Paper Details
										disable Cashier_Paper_Date;
										disable Cash_Total;
										disable Other_Total;
										//Status Details
										disable Cashier_Paper_Status;
										disable Locked;
										// HIDE FIELDS
										//Cashier Section
										hide Display_Name_Site;
										//Paper Details
										hide Cash_Total;
										hide Other_Total;
										//Status Details
										hide Status_Details;
										hide Cashier_Paper_Status;
										hide Locked;
										//Payment Details;
										hide Payment_Details;
										//Back End
										hide Back_End;
										// =====================================
										// CREATE MODE
										// =====================================
										if(input.ID == null)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											input.Cashier_Paper_Date = zoho.currenttime;
										}
										else
										{
											disable Site;
											disable Cashier_Envelope;
											show Cash_Total;
											show Other_Total;
											show Payment_Details;
											hide Payment_Details.Site;
											hide Payment_Details.Display_Name_Site;
											hide Payment_Details.Cashier_Envelope;
											hide Payment_Details.Display_Name_Card;
											hide Payment_Details.Display_Name_Customer;
											hide Payment_Details.Payment_Date;
											hide Payment_Details.Old_Cashier_Paper_ID;
											hide Payment_Details.Old_Cash_Envelope_ID;
											hide Payment_Details.Old_Card_ID;
											hide Payment_Details.User_Name;
											hide Payment_Details.User_Email;
											hide Payment_Details.User_Role;
											hide Payment_Details.Created_By_Name;
											hide Payment_Details.Created_By_Email;
											hide Payment_Details.Created_By_Time;
											hide Payment_Details.Updated_By_Name;
											hide Payment_Details.Updated_By_Email;
											hide Payment_Details.Updated_By_Time;
											disable Payment_Details.Card;
											disable Payment_Details.Customer;
											disable Payment_Details.Credit_Note;
											disable Payment_Details.Delivery_Note;
											disable Payment_Details.Amount_Due;
											disable Payment_Details.Transaction_ID;
											disable Payment_Details.Amount_Received;
											disable Payment_Details.Amount_Credited;
											disable Payment_Details.Balance_Due;
											disable Payment_Details.Cash_Envelope;
											disable Payment_Details.Payment_Type;
											disable Payment_Details.Account;
											disable Payment_Details.Amount;
										}
						)
					}
				}

			}
			Finalize_On_Create10 as "Finalize On Create"
			{
				type =  form
				form = Cashier_Paper

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
										// Keep the current/new paper Open
										input.Cashier_Paper_Status = "Open";
										// Ensure Site is selected
										if(input.Site != null && input.ID != null)
										{
											siteId = input.Site.ID;
											// Find other OPEN papers for the same site, excluding this new one
											oldPapers = Cashier_Paper[Site == siteId && Cashier_Paper_Status == "Open" && ID != input.ID];
											for each  op in oldPapers
											{
												op.Cashier_Paper_Status="Checking";
											}
										}
						)
					}
				}

			}
			Finalize_On_Edit9 as "Finalize On Edit"
			{
				type =  form
				form = Cashier_Paper

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// CASHIER PAPER → FINALIZE ON EDIT
										// =====================================
										// Update audit information
										u = thisapp.audit.getLoginAuditInfo();
										input.Updated_By_Name = u.get("name");
										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
										// Get latest saved record
										cp = Cashier_Paper[ID == input.ID];
										if(cp != null)
										{
											// If currently Checking → move to Verified
											if(cp.Cashier_Paper_Status == "Checking")
											{
												cp.Cashier_Paper_Status="Verified";
											}
										}
						)
					}
				}

			}
			Finalize_On_Create11 as "Finalize On Create"
			{
				type =  form
				form = Cash_Envelope

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
										// ======================================
										// CASH ENVELOPE → ON CREATE
										// Make previous Cash Envelope for same Site = "In Safe"
										// Keep new one = "In Use"
										// ======================================
										// New/current envelope should stay active
										input.Cash_Envelope_Status = "Open";
										// Identify site
										siteId = null;
										if(input.Site != null)
										{
											siteId = input.Site.ID;
										}
										// Update older cash envelopes for same site
										if(siteId != null && input.ID != null)
										{
											oldEnv = Cash_Envelope[Site == input.Site && ID != input.ID && Cash_Envelope_Status == "Open"];
											for each  e in oldEnv
											{
												e.Cash_Envelope_Status="In Safe";
											}
										}
										else
										{
											// Fallback if using Phone_Used_Site text instead of Site lookup
											ps = ifnull(input.Display_Name_Site,"").trim();
											if(ps != "" && input.ID != null)
											{
												oldEnv2 = Cash_Envelope[Display_Name_Site == ps && ID != input.ID && Cash_Envelope_Status == "Open"];
												for each  e2 in oldEnv2
												{
													e2.Cash_Envelope_Status="In Safe";
												}
											}
										}
						)
					}
				}

			}
