			Full_Validation9 as "Full Validation"
			{
				type =  form
				form = Cashier_Paper

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Cashier Paper -> Full Validation (Submit)
										errors = "";
										// =====================================
										// 1) Cashier Envelope REQUIRED
										// =====================================
										if(input.Cashier_Envelope == null)
										{
											errors = errors + "\n• Cashier Envelope is required.";
										}
										// =====================================
										// 2) Cashier Paper Number REQUIRED
										// =====================================
										if(input.Cashier_Paper_Number == null || input.Cashier_Paper_Number.trim() == "")
										{
											errors = errors + "\n• Cashier Paper Number is required.";
										}
										else
										{
											// Clean value
											input.Cashier_Paper_Number = input.Cashier_Paper_Number.trim();
											// =====================================
											// 3) PREVENT DUPLICATES
											// =====================================
											dup = Cashier_Paper[Cashier_Paper_Number == input.Cashier_Paper_Number && ID != input.ID];
											if(dup.count() > 0)
											{
												errors = errors + "\n• Cashier Paper Number already exists.";
											}
										}
										// =====================================
										// FINAL BLOCK
										// =====================================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation11 as "Full Validation"
			{
				type =  form
				form = Cash_Envelope

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Cashier Paper -> Full Validation (Submit)
										errors = "";
										// 1) Cashier Envelope REQUIRED
										if(input.Cashier_Envelope == null)
										{
											errors = errors + "\n• Cashier Envelope is required.";
										}
										// 2) Cash Envelope Number REQUIRED
										if(input.Cash_Envelope_Number == null || input.Cash_Envelope_Number.trim() == "")
										{
											errors = errors + "\n• Cash Envelope Number is required.";
										}
										else
										{
											// Must start with "E"
											if(!input.Cash_Envelope_Number.startsWith("E"))
											{
												errors = errors + "\n• Cash Envelope Number must start with letter 'E'.";
											}
										}
										// Final: Block submit if errors exist
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
										// Non-blocking message before save
										alert "Heads up: When you open this new Cash Envelope, the previous one for this site will automatically change to 'In Safe'.";
						)
					}
				}

			}
			Full_Validation12 as "Full Validation"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										// ---------------------------
										// 1) Voucher
										// ---------------------------
										if(input.Voucher == null)
										{
											errors = errors + "\n• Voucher is required.";
										}
										// ---------------------------
										// 2) Customer
										// ---------------------------
										if(input.Customer == null)
										{
											errors = errors + "\n• Customer is required.";
										}
										// ---------------------------
										// 3) Sales Type
										// ---------------------------
										salesType = ifnull(input.Sales_Type,"").trim();
										if(salesType == "")
										{
											errors = errors + "\n• Sales Type is required.";
										}
										// ---------------------------------------------------------
										// 4) Customer document requirements
										// ---------------------------------------------------------
										if(input.Customer != null)
										{
											requirePO = ifnull(input.Customer.Purchase_Order_Required,false);
											requireDN = ifnull(input.Customer.Delivery_Note_Required,false);
											requireCN = ifnull(input.Customer.Credit_Note_Required,false);
											if(requireDN == true && input.Delivery_Note == null)
											{
												errors = errors + "\n• Delivery Note is required for this Customer.";
											}
											if(requireCN == true && input.Credit_Note == null)
											{
												errors = errors + "\n• Credit Note is required for this Customer.";
											}
											if(requirePO == true && input.Delivery_Note == null)
											{
												errors = errors + "\n• This Customer requires a Purchase Order through a Delivery Note.";
											}
										}
										// =========================================================
										// 5) VALIDATION BY SALES TYPE
										// =========================================================
										// ---------------------------
										// A) Sand Sales
										// ---------------------------
										if(salesType == "Sand Sales")
										{
											if(input.Number_Plate == null)
											{
												errors = errors + "\n• Number Plate is required.";
											}
											if(input.Truck_Measurement == null)
											{
												errors = errors + "\n• Truck Measurement is required.";
											}
											if(input.Truck_Size == null || input.Truck_Size.toString().trim() == "")
											{
												errors = errors + "\n• Truck Size is required.";
											}
											cbm = ifnull(input.Truck_CBM,0.0);
											if(cbm <= 0)
											{
												errors = errors + "\n• Truck CBM is required and must be greater than 0.";
											}
										}
										// ---------------------------
										// B) Item Sales
										// ---------------------------
										else if(salesType == "Item Sales")
										{
											if(input.Item_Sales == null || input.Item_Sales.isEmpty())
											{
												errors = errors + "\n• Add at least one Item Sales row.";
											}
										}
										// ---------------------------
										// C) Sand & Item Sales
										// ---------------------------
										else if(salesType == "Sand & Item Sales")
										{
											if(input.Number_Plate == null)
											{
												errors = errors + "\n• Number Plate is required.";
											}
											if(input.Truck_Measurement == null)
											{
												errors = errors + "\n• Truck Measurement is required.";
											}
											if(input.Truck_Size == null || input.Truck_Size.toString().trim() == "")
											{
												errors = errors + "\n• Truck Size is required.";
											}
											cbm = ifnull(input.Truck_CBM,0.0);
											if(cbm <= 0)
											{
												errors = errors + "\n• Truck CBM is required and must be greater than 0.";
											}
											if(input.Item_Sales == null || input.Item_Sales.isEmpty())
											{
												errors = errors + "\n• Add at least one Item Sales row.";
											}
										}
										// ---------------------------
										// D) Invalid Sales Type
										// ---------------------------
										else if(salesType != "")
										{
											errors = errors + "\n• Invalid Sales Type selected.";
										}
										// ---------------------------
										// 9) Amount To Pay
										// ---------------------------
										amt_to_pay = round(ifnull(input.Amount_To_Pay,0.0),2);
										amt_expected = round(ifnull(input.Amount_Supposed_To_Pay,0.0),2);
										if(amt_expected <= 0)
										{
											errors = errors + "\n• Amount Supposed To Pay must be greater than 0.";
										}
										else if(amt_to_pay <= 0)
										{
											errors = errors + "\n• Amount To Pay must be greater than 0.";
										}
										else
										{
											min_allowed = round(amt_expected - 0.5,2);
											if(amt_to_pay < min_allowed)
											{
												errors = errors + "\n• Amount To Pay is too low. Minimum allowed is " + min_allowed.toString() + ".";
											}
										}
										// ---------------------------
										// FINAL
										// ---------------------------
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation13 as "Full Validation"
			{
				type =  form
				form = Payment_Received

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// PAYMENT RECEIVED — FULL VALIDATION
										// (ON VALIDATE)
										// =====================================
										errors = "";
										pt = ifnull(input.Payment_Type,"").trim();
										// ALWAYS REQUIRED
										if(input.Cashier_Envelope == null)
										{
											errors = errors + "\n• Cashier Envelope is required.";
										}
										if(input.Card == null)
										{
											errors = errors + "\n• Card is required.";
										}
										if(input.Cashier_Paper == null)
										{
											errors = errors + "\n• Cashier Paper is required.";
										}
										// -------------------------------------
										// CONDITIONAL — BASED ON SAND CUSTOMER FLAGS
										// -------------------------------------
										if(input.Customer != null)
										{
											cust = Sand_Customer[ID == input.Customer];
											if(cust != null)
											{
												if(cust.Credit_Note_Required == true && input.Credit_Note == null)
												{
													errors = errors + "\n• Credit Note is required for this customer.";
												}
												if(cust.Delivery_Note_Required == true && input.Delivery_Note == null)
												{
													errors = errors + "\n• Delivery Note is required for this customer.";
												}
											}
										}
										// -------------------------------------
										// PAYMENT TYPE RULES
										// -------------------------------------
										if(pt == "Cash")
										{
											if(input.Amount == null || input.Amount <= 0)
											{
												errors = errors + "\n• Amount is required for Cash payments.";
											}
											if(input.Cash_Envelope == null)
											{
												errors = errors + "\n• Cash Envelope is required for Cash payments.";
											}
										}
										if(pt == "Mobile Money")
										{
											if(input.Account == null)
											{
												errors = errors + "\n• Account is required for Mobile Money payments.";
											}
											if(input.Transaction_ID == null || input.Transaction_ID.trim() == "")
											{
												errors = errors + "\n• Transaction ID is required for Mobile Money payments.";
											}
											if(input.Amount == null || input.Amount <= 0)
											{
												errors = errors + "\n• Amount is required for Mobile Money payments.";
											}
										}
										// ✅ Only for CREDIT: must have Delivery Note OR Credit Note
										if(pt == "Credit")
										{
											if(input.Credit_Note == null && input.Delivery_Note == null)
											{
												errors = errors + "\n• For Credit payments, you must select either a Delivery Note or a Credit Note.";
											}
										}
										// FINAL GATE
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation14 as "Full Validation"
			{
				type =  form
				form = Visitors_Register

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// Visitor Register - On Create Validation
										// ===============================
										// Run ONLY on create
										if(input.ID == null)
										{
											// 1️⃣ Voucher is required
											if(input.Voucher == null)
											{
												alert "Voucher is required.";
												cancel submit;
											}
											// 2️⃣ Entry By is required
											if(input.Entry_By == null)
											{
												alert "Entry By is required.";
												cancel submit;
											}
											// 3️⃣ If Entry By = Card → Card is required
											if(input.Entry_By == "Card")
											{
												if(input.Card == null)
												{
													alert "Card is required when Entry By is Card.";
													cancel submit;
												}
												if(input.Number_Plate == null)
												{
													alert "Number Plate is required when Entry By is Card.";
													cancel submit;
												}
												// Safety: Gate Pass must be empty
												if(input.Gate_Pass != null)
												{
													alert "Gate Pass must be empty when Entry By is Card.";
													cancel submit;
												}
											}
											// 4️⃣ If Entry By = Gate Pass → Gate Pass is required
											if(input.Entry_By == "Gate Pass")
											{
												if(input.Gate_Pass == null)
												{
													alert "Gate Pass is required when Entry By is Gate Pass.";
													cancel submit;
												}
												// Safety: Card must be empty
												if(input.Card != null)
												{
													alert "Card must be empty when Entry By is Gate Pass.";
													cancel submit;
												}
											}
										}
						)
					}
				}

			}
			Adding_to_Cash_Receipt as "Adding to Cash Receipt"
			{
				type =  form
				form = Payment_Received

				record event = on add or edit
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											payment_management.generateGroupSummary_sand(input.Payment_Date);
										// --- compute group in NEW solution (based on Site) ---
										// default -> 1E (safe fallback)
										groupVal = "U";
										siteName = "";
										// ONLY run when NOT Credit
										if(input.Payment_Type == "Credit")
										{
											return;
										}
										if(input.Display_Name_Site != null)
										{
											siteName = input.Display_Name_Site.toString().trim();
										}
										if(siteName == "Gomba Site - ARA075")
										{
											groupVal = "9A";
										}
										else if(siteName == "Seeta Site - ARA068")
										{
											groupVal = "12A";
										}
										// --- Account logic ---
										Acc = "";
										if(input.Payment_Type == "Cash")
										{
											Acc = "Hamidu Cash Accounts";
										}
										else if(input.Payment_Type == "Mobile Money")
										{
											Acc = input.Account.Account_Name;
										}
										// --- send to Solution B ---
										payload = Map();
										payload.put("Payment_Date",input.Created_By_Time);
										payload.put("Amount_Paid",input.Amount_Received);
										payload.put("Reference",input.Cashier_Paper.Cashier_Paper_Number + " - " + input.Display_Name_Card);
										payload.put("Account",Acc);
										payload.put("Group",groupVal);
										resp = payment_management.cashreceipt.createCashReceiptFromEmployeesoln(payload);
										if(resp == null || resp.get("ok") != true)
										{
											info "Sync to Solution B failed: " + ifnull(resp.get("msg"),"unknown error");
										}
						)
					}
				}

			}
			Add_Row_Kitchen_Employee_ as "Add Row Kitchen Employee Details"
			{
				type =  form
