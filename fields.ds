			Full_Validation_On_Create1 as "Full Validation On Create"
			{
				type =  form
				form = Stock_Production

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Site == null)
										{
											alert "Please select Asset.";
											cancel submit;
										}
										batch_date = "";
										if(input.Time_Started != null)
										{
											batch_date = input.Time_Started.toString("yy-MM-dd");
										}
										else
										{
											batch_date = zoho.currenttime.toString("yy-MM-dd");
										}
										// Use full display name instead of Asset ID
										site_name = ifnull(input.Display_Name_Site,"").trim();
										if(site_name == "")
										{
											site_name = ifnull(input.Site.Asset_Name,"").trim();
										}
										if(site_name == "")
										{
											alert "Selected Site has no Display Name Site From.";
											cancel submit;
										}
										// Count existing batches for same site
										batch_count = Stock_Production[Site == input.Site].count() + 1;
										// Format batch count
										count_text = "";
										if(batch_count < 10)
										{
											count_text = "0" + batch_count;
										}
										else
										{
											count_text = batch_count.toString();
										}
										// Final batch number
										input.Batch_Number = batch_date + " - " + site_name + " - " + count_text;
						)
					}
				}

			}
