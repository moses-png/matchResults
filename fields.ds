										// 2️⃣ Bed-level differences
										input.Bed_Length_Difference = (ifnull(input.Bed_Length_Confirmed,0.0) - ifnull(input.Bed_Length,0.0)).round(3);
										input.Bed_Width_Difference = (ifnull(input.Bed_Width_Confirmed,0.0) - ifnull(input.Bed_Width,0.0)).round(3);
										input.Bed_Height_Difference = (ifnull(input.Bed_Height_Confirmed,0.0) - ifnull(input.Bed_Height,0.0)).round(3);
										Bed_Height_2_Difference = (ifnull(input.Bed_Height_2_Confirmed,0.0) - ifnull(input.Bed_Height_2,0.0)).round(3);
										// 3️⃣ Truck size differences
										input.Truck_Size_1_Difference = (ifnull(input.Truck_Size_1_Confirmed,0.0) - ifnull(input.Truck_Size_1,0.0)).round(3);
										input.Truck_Size_2_Difference = (ifnull(input.Truck_Size_2_Confirmed,0.0) - ifnull(input.Truck_Size_2,0.0)).round(3);
						)
					}
				}

			}
			Set_up_Form8 as "Set up Form"
			{
				type =  form
				form = Truck_Measurement

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// Truck Measurement – On Load (Visibility + Locking)
										// =====================================================
										// Logged-in user info
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// -------------------------
										// 1) DISABLE FIELDS (always)
										// -------------------------
										disable Display_Name_Voucher;
										disable Line_Number;
										disable Receipt_Officer;
										disable Display_Name_Site;
										disable Truck_Size_1;
										disable Truck_Size_2;
										disable Time_Measured;
										disable Phone_Used_Site;
										disable Display_Name_Number_Plate;
										// You said disable it; keep disabled even if shown
										disable Truck_Size_1_Confirmed;
										disable Truck_Size_2_Confirmed;
										disable Time_Confirmed;
										// same idea
										disable Bed_Length_Difference;
										disable Bed_Width_Difference;
										disable Bed_Height_Difference;
										disable Bed_Height_2_Difference;
										disable Truck_Size_1_Difference;
										disable Truck_Size_2_Difference;
										disable Measurement_Status;
										disable Document_Stage;
										disable Measurement_Checkbox;
										disable Time_Checked;
										disable Head_Office_Supervisor;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// -------------------------
