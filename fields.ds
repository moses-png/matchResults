			Validation_On_Create as "Validation On Create"
			{
				type =  form
				form = Job_Card

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Set Time Started only once, at first submission
										if(input.Time_Started == null)
										{
											input.Time_Started = zoho.currenttime;
										}
										// Default status on create
										if(input.Status == null || input.Status == "")
										{
											input.Status = "At Work";
										}
						)
					}
				}

			}
			Validation_on_Edit as "Validation on Edit"
			{
				type =  form
				form = Job_Card

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// When editing + submitting, stamp end time once
										if(input.Time_Ended == null)
										{
											input.Time_Ended = zoho.currenttime;
										}
										// Set status to Left Work when ended
										input.Status = "Left Work";
										if(input.Time_Started == null)
										{
											alert "Time Started is missing. Submit the Job Card first.";
											cancel submit;
										}
										// Only enforce when user is closing the job card
										isClosing = false;
										// If you use Status to close:
										if(input.Status == "Left Work")
										{
											isClosing = true;
										}
										// Or if you use Time Ended being set to close:
										if(input.Time_Ended != null)
										{
											isClosing = true;
										}
						)
					}
				}

			}
