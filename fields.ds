			Full_Validation_On_Edit as "Full Validation On Edit"
			{
				type =  form
				form = Asset_Issues

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Work_Order_Number == null || input.Work_Order_Number.trim() == "")
										{
											doc_key = Document_Key[Voucher_Type == "Work Order" && Document_Key_Status == "Active"];
											if(doc_key.ID == null)
											{
												alert "Document Key for Work Order is not configured.";
												cancel submit;
											}
											prefix_value = ifnull(doc_key.Prefix,"WAH");
											next_no = ifnull(doc_key.Next_Number,1);
											if(next_no > 999)
											{
												alert "Work Order numbering has reached the maximum of 999.";
												cancel submit;
											}
											if(next_no < 10)
											{
												num_text = "00" + next_no;
											}
											else if(next_no < 100)
											{
												num_text = "0" + next_no;
											}
											else
											{
												num_text = next_no.toString();
											}
											input.Work_Order_Number = prefix_value + num_text;
											doc_key.Next_Number=next_no + 1;
										}
						)
					}
				}

			}
