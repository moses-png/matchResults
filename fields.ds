						)
					}
				}

			}
			On_job_Selected as "On job Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Job
				{
					actions 
					{
						custom deluge script
						(
											if(input.Job != null)
										{
											jobNo = input.Job.Job_No;
											// ==================================
											// TJS01 - Card Sales
											// ==================================
											if(jobNo == "TJS01")
											{
												show Pick_Up_Section;
												show Card;
												enable Card;
												hide Work_Order_Task;
												input.Work_Order_Task = null;
												hide Batch_Number_From;
												input.Batch_Number_From = null;
												hide Truck_Movement_Voucher;
												input.Truck_Movement_Voucher = null;
												hide Task_Location;
												input.Task_Location = null;
												hide Small_Notes;
												input.Small_Notes = null;
												show Site_From;
												show Site_Location_From;
												disable Site_From;
												enable Site_Location_From;
												show Site_To;
												show Site_Location_To;
												disable Site_To;
												enable Site_Location_To;
												hide Party_From;
												hide Party_Location_From;
												input.Party_From = null;
												input.Party_Location_From = null;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
											}
											// ==================================
											// TJS02 - Service Task
											// ==================================
											else if(jobNo == "TJS02")
											{
												show Pick_Up_Section;
												show Work_Order_Task;
												enable Work_Order_Task;
												show Task_Location;
												enable Task_Location;
												show Small_Notes;
												enable Small_Notes;
												hide Card;
												input.Card = null;
												hide Batch_Number_From;
												input.Batch_Number_From = null;
												hide Truck_Movement_Voucher;
												input.Truck_Movement_Voucher = null;
												show Site_To;
												show Site_Location_To;
												enable Site_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
												if(input.Task_Location == "Company Sites")
												{
													show Site_From;
													show Site_Location_From;
													enable Site_From;
													enable Site_Location_From;
													hide Party_From;
													hide Party_Location_From;
													input.Party_From = null;
													input.Party_Location_From = null;
												}
												else if(input.Task_Location == "Suppliers")
												{
													show Party_From;
													show Party_Location_From;
													enable Party_From;
													enable Party_Location_From;
													hide Site_From;
													hide Site_Location_From;
													input.Site_From = null;
													input.Site_Location_From = null;
												}
												else
												{
													hide Site_From;
													hide Site_Location_From;
													input.Site_From = null;
													input.Site_Location_From = null;
													hide Party_From;
													hide Party_Location_From;
													input.Party_From = null;
													input.Party_Location_From = null;
												}
											}
											// ==================================
											// TJS03 - Stock Production
											// ==================================
											else if(jobNo == "TJS03")
											{
												show Pick_Up_Section;
												show Batch_Number_From;
												hide Card;
												input.Card = null;
												hide Work_Order_Task;
												input.Work_Order_Task = null;
												hide Truck_Movement_Voucher;
												input.Truck_Movement_Voucher = null;
												hide Task_Location;
												input.Task_Location = null;
												hide Small_Notes;
												input.Small_Notes = null;
												show Site_From;
												disable Site_From;
												show Site_Location_From;
												enable Site_Location_From;
												show Site_To;
												disable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_From;
												hide Party_Location_From;
												input.Party_From = null;
												input.Party_Location_From = null;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
											}
											// ==================================
											// TJS04 - Return Truck To Site
											// ==================================
											else if(jobNo == "TJS04")
											{
												show Pick_Up_Section;
												show Truck_Movement_Voucher;
												enable Truck_Movement_Voucher;
												hide Card;
												input.Card = null;
												hide Work_Order_Task;
												input.Work_Order_Task = null;
												hide Batch_Number_From;
												input.Batch_Number_From = null;
												hide Task_Location;
												input.Task_Location = null;
												// Pickup = party from previous delivery
												show Party_From;
												show Party_Location_From;
												disable Party_From;
												enable Party_Location_From;
												hide Site_From;
												hide Site_Location_From;
												input.Site_From = null;
												input.Site_Location_From = null;
												// Delivery = company site
												show Site_To;
												show Site_Location_To;
												enable Site_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
											}
										}
										else
										{
											hide Pick_Up_Section;
											hide Batch_Number_From;
											hide Card;
											hide Work_Order_Task;
											hide Truck_Movement_Voucher;
											hide Task_Location;
											hide Small_Notes;
											input.Card = null;
											input.Work_Order_Task = null;
											input.Batch_Number_From = null;
											input.Truck_Movement_Voucher = null;
											input.Task_Location = null;
											input.Small_Notes = null;
											show Site_From;
											show Site_Location_From;
											enable Site_From;
											enable Site_Location_From;
											show Site_To;
											show Site_Location_To;
											enable Site_To;
											enable Site_Location_To;
											show Party_From;
											show Party_Location_From;
											enable Party_From;
											enable Party_Location_From;
											show Party_To;
											show Party_Location_To;
											enable Party_To;
											enable Party_Location_To;
										}
						)
					}
				}

			}
			On_Card_Selected3 as "On Card Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Card
				{
					actions 
					{
						custom deluge script
						(
											if(input.Card != null)
										{
											// 1) Auto-fill Work Done
											cardNo = ifnull(input.Card.Card_Number,"").trim();
											numberPlate = ifnull(input.Card.Display_Name_Number_Plate,"").trim();
											if(cardNo != "" && numberPlate != "")
											{
												input.Work_Done = "Truck Movement for Card " + cardNo + " - " + numberPlate;
											}
											else if(cardNo != "")
											{
												input.Work_Done = "Truck Movement for Card " + cardNo;
											}
											else
											{
												input.Work_Done = null;
											}
											// 2) Auto-fill Site From
											input.Site_From = input.Card.Site;
											input.Display_Name_Site_From = ifnull(input.Card.Display_Name_Site,"").trim();
											// 3) Auto-fill Site Location From from Sales Voucher Site Location
											input.Site_Location_From = input.Card.Site_Location;
											// 4) Auto-fill Pick Up From
											input.Pick_Up_From = input.Display_Name_Site_From;
										}
										else
										{
											input.Work_Done = null;
											input.Site_From = null;
											input.Display_Name_Site_From = null;
											input.Site_Location_From = null;
											input.Pick_Up_From = null;
										}
						)
					}
				}

			}
