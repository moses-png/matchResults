			On_System_Selected2 as "On System Selected"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on user input of Payment_Details.System
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// PAYMENT DETAILS SUBFORM
										// On user input of System
										// Parent Form: Payment_Voucher
										// Subform: Payment_Details
										// ======================================
										// --------------------------------------
										// RESET ALL BILL FIELDS
										// --------------------------------------
										row.Store_Management_Bill=null;
										row.Asset_Management_Bill=null;
										row.Employee_Management_Bill=null;
										row.Bill_Number="";
										row.Amount_Due=0.0;
										row.Amount_Paid=0.0;
										// --------------------------------------
										// HIDE ALL BILL LOOKUPS FIRST
										// --------------------------------------
										hide row.Store_Management_Bill;
										hide row.Asset_Management_Bill;
										hide row.Employee_Management_Bill;
										// --------------------------------------
										// CONTROL WHICH BILL FIELD IS USED
										// --------------------------------------
										if(row.System == "Store Management")
										{
											show row.Store_Management_Bill;
											enable row.Store_Management_Bill;
											disable row.Asset_Management_Bill;
											disable row.Employee_Management_Bill;
										}
										else if(row.System == "Asset Management")
										{
											show row.Asset_Management_Bill;
											enable row.Asset_Management_Bill;
											disable row.Store_Management_Bill;
											disable row.Employee_Management_Bill;
										}
										else if(row.System == "Employee Management")
										{
											show row.Employee_Management_Bill;
											enable row.Employee_Management_Bill;
											disable row.Store_Management_Bill;
											disable row.Asset_Management_Bill;
										}
										else
										{
											hide row.Store_Management_Bill;
											hide row.Asset_Management_Bill;
											hide row.Employee_Management_Bill;
										}
						)
					}
				}

			}
			Finalize2 as "Finalize"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											asset_resp = null;
										emp_resp = null;
										store_resp = null;
										// ======================================
										// LOOP THROUGH PAYMENT DETAILS SUBFORM
										// ======================================
										for each  r in input.Payment_Details
										{
											current_bill_no = ifnull(r.Bill_Number,"").trim();
											old_bill_no = ifnull(r.Old_Bill_Number,"").trim();
											// Get bill number if empty
											if(current_bill_no == "")
											{
												if(r.System == "Store Management" && r.Store_Management_Bill != null)
												{
													current_bill_no = ifnull(r.Store_Management_Bill.Bill_Number,"").trim();
													r.Bill_Number=current_bill_no;
												}
												else if(r.System == "Asset Management" && r.Asset_Management_Bill != null)
												{
													current_bill_no = ifnull(r.Asset_Management_Bill.Bill_Number,"").trim();
													r.Bill_Number=current_bill_no;
												}
												else if(r.System == "Employee Management" && r.Employee_Management_Bill != null)
												{
													current_bill_no = ifnull(r.Employee_Management_Bill.Bill_Number,"").trim();
													r.Bill_Number=current_bill_no;
												}
											}
											// Payment date
											pay_date_val = zoho.currentdate;
											if(r.Payment_Voucher_Date != null)
											{
												pay_date_val = r.Payment_Voucher_Date;
											}
											else if(input.Payment_Voucher_Date != null)
											{
												pay_date_val = input.Payment_Voucher_Date;
											}
											// ======================================
											// OLD BILL CHANGED - RECOMPUTE OLD BILL
											// ======================================
											if(old_bill_no != "" && old_bill_no != current_bill_no)
											{
												old_bill_total_paid = 0.0;
												old_rows = Payment_Made_Voucher_Details[System == r.System && Bill_Number == old_bill_no];
												for each  old_row in old_rows
												{
													old_amt = round(ifnull(old_row.Amount_Paid,0.0),2);
													if(old_amt > 0)
													{
														old_bill_total_paid = round(old_bill_total_paid + old_amt,2);
													}
												}
												old_payload = Map();
												old_payload.put("Bill_Number",old_bill_no);
												old_payload.put("Total_Paid",old_bill_total_paid);
												old_payload.put("Payment_Date",pay_date_val);
												if(r.System == "Asset Management")
												{
													asset_management.updateBillFromPayment(old_payload);
												}
												else if(r.System == "Store Management")
												{
													store_management.updateBillFromPayment(old_payload);
												}
												else if(r.System == "Employee Management")
												{
													employee_management.updateInvoiceFromReceipt(old_payload);
												}
											}
											// ======================================
											// CURRENT BILL - RECOMPUTE TOTAL PAID
											// ======================================
											if(current_bill_no != "")
											{
												recomputed_total = 0.0;
												payment_rows = Payment_Made_Voucher_Details[System == r.System && Bill_Number == current_bill_no];
												for each  pay_row in payment_rows
												{
													row_amt = round(ifnull(pay_row.Amount_Paid,0.0),2);
													if(row_amt > 0)
													{
														recomputed_total = round(recomputed_total + row_amt,2);
													}
												}
												payload = Map();
												payload.put("Bill_Number",current_bill_no);
												payload.put("Total_Paid",recomputed_total);
												payload.put("Payment_Date",pay_date_val);
												if(r.System == "Asset Management")
												{
													asset_resp = asset_management.updateBillFromPayment(payload);
												}
												else if(r.System == "Store Management")
												{
													store_resp = store_management.updateBillFromPayment(payload);
												}
												else if(r.System == "Employee Management")
												{
													emp_resp = employee_management.updateInvoiceFromReceipt(payload);
												}
												r.Old_Bill_Number=current_bill_no;
											}
										}
										// ======================================
										// UPDATE PAYMENT VOUCHER TOTALS
										// ======================================
										total_assigned = 0.0;
										for each  r2 in input.Payment_Details
										{
											amt = round(ifnull(r2.Amount_Paid,0.0),2);
											if(amt > 0)
											{
												total_assigned = round(total_assigned + amt,2);
											}
										}
										total_paid = round(ifnull(input.Total_Amount_Paid,0.0),2);
										balance_not_assigned = round(total_paid - total_assigned,2);
										if(balance_not_assigned < 0)
										{
											balance_not_assigned = 0.0;
										}
										input.Amount_Assigned = total_assigned;
										input.Balance_Not_Assigned = balance_not_assigned;
										if(total_paid <= 0)
										{
											input.Payment_Voucher_Status = "Draft";
										}
										else if(total_assigned <= 0)
										{
											input.Payment_Voucher_Status = "Unassigned";
										}
										else if(balance_not_assigned > 0)
										{
											input.Payment_Voucher_Status = "Partially Assigned";
										}
										else
										{
											input.Payment_Voucher_Status = "Fully Assigned";
										}
						)
					}
				}

			}
			On_Addition_Of_Row1 as "On Addition Of Row"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on add row of Payment_Details
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// PAYMENT DETAILS SUBFORM
										// ADDITION OF ROW
										// Parent Form: Payment_Voucher
										// Subform: Payment_Details
										// ======================================
										// --------------------------------------
										// DEFAULT PAYMENT DATE
										// --------------------------------------
										if(input.Payment_Voucher_Date != null)
										{
											row.Payment_Voucher_Date=input.Payment_Voucher_Date;
										}
										else
										{
											row.Payment_Voucher_Date=zoho.currentdate;
										}
										// --------------------------------------
										// DISPLAY NAME
										// --------------------------------------
										if(input.Payment_Voucher_Number != null)
										{
											row.Display_Name_Payment_Voucher=input.Payment_Voucher_Number;
										}
										// --------------------------------------
										// NEXT LINE NUMBER
										// --------------------------------------
										max_line = 0;
										for each  r in input.Payment_Details
										{
											if(ifnull(r.Line_Number,0) > max_line)
											{
												max_line = r.Line_Number;
											}
										}
										row.Line_Number=max_line + 1;
										// --------------------------------------
										// DEFAULT VALUES
										// --------------------------------------
										row.Amount_Due=0.0;
										row.Amount_Paid=0.0;
										row.Old_Amount_Paid=0.0;
										row.Old_Bill_Number="";
										row.Old_Group_Allocations_Text="";
										if(row.Old_Group_Alloc_Payment_Date == null)
										{
											row.Old_Group_Alloc_Payment_Date=row.Payment_Voucher_Date;
										}
										// --------------------------------------
										// HIDE BILL LOOKUPS INITIALLY
										// --------------------------------------
										hide row.Store_Management_Bill;
										hide row.Asset_Management_Bill;
										hide row.Employee_Management_Bill;
						)
					}
				}

			}
			On_Deletion_Of_Row as "On Deletion Of Row"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on delete row of Payment_Details
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// PAYMENT DETAILS SUBFORM
										// DELETION OF ROW
										// Parent Form: Payment_Voucher
										// Subform: Payment_Details
										// ======================================
										deleted_bill_no = ifnull(row.Bill_Number,"").trim();
										if(deleted_bill_no == "")
										{
											if(row.System == "Store Management" && row.Store_Management_Bill != null)
											{
												deleted_bill_no = ifnull(row.Store_Management_Bill.Bill_Number,"").trim();
											}
											else if(row.System == "Asset Management" && row.Asset_Management_Bill != null)
											{
												deleted_bill_no = ifnull(row.Asset_Management_Bill.Bill_Number,"").trim();
											}
											else if(row.System == "Employee Management" && row.Employee_Management_Bill != null)
											{
												deleted_bill_no = ifnull(row.Employee_Management_Bill.Bill_Number,"").trim();
											}
										}
										// --------------------------------------
										// PAYMENT DATE
										// --------------------------------------
										pay_date_val = zoho.currentdate;
										if(row.Payment_Voucher_Date != null)
										{
											pay_date_val = row.Payment_Voucher_Date;
										}
										else if(input.Payment_Voucher_Date != null)
										{
											pay_date_val = input.Payment_Voucher_Date;
										}
										// ======================================
										// RECOMPUTE REMAINING BILL TOTAL
										// ======================================
										if(deleted_bill_no != "")
										{
											recomputed_total = 0.0;
											remaining_rows = input.Payment_Details;
											for each  r in remaining_rows
											{
												compare_bill_no = ifnull(r.Bill_Number,"").trim();
												if(compare_bill_no == deleted_bill_no && r.System == row.System)
												{
													row_amt = round(ifnull(r.Amount_Paid,0.0),2);
													if(row_amt > 0)
													{
														recomputed_total = round(recomputed_total + row_amt,2);
													}
												}
											}
											payload = Map();
											payload.put("Bill_Number",deleted_bill_no);
											payload.put("Total_Paid",recomputed_total);
											payload.put("Payment_Date",pay_date_val);
											// ----------------------------------
											// PUSH UPDATE BACK TO SOURCE SYSTEM
											// ----------------------------------
											if(row.System == "Asset Management")
											{
												asset_management.updateBillFromPayment(payload);
											}
											else if(row.System == "Store Management")
											{
												store_management.updateBillFromPayment(payload);
											}
											else if(row.System == "Employee Management")
											{
												employee_management.updateInvoiceFromReceipt(payload);
											}
										}
										// ======================================
										// UPDATE PAYMENT VOUCHER TOTALS
										// ======================================
										total_assigned = 0.0;
										for each  r2 in input.Payment_Details
										{
											amt = round(ifnull(r2.Amount_Paid,0.0),2);
											if(amt > 0)
											{
												total_assigned = round(total_assigned + amt,2);
											}
										}
										total_paid = round(ifnull(input.Total_Amount_Paid,0.0),2);
										balance_not_assigned = round(total_paid - total_assigned,2);
										if(balance_not_assigned < 0)
										{
											balance_not_assigned = 0.0;
										}
										input.Amount_Assigned = total_assigned;
										input.Balance_Not_Assigned = balance_not_assigned;
										if(total_paid <= 0)
										{
											input.Payment_Voucher_Status = "Draft";
										}
										else if(total_assigned <= 0)
										{
											input.Payment_Voucher_Status = "Unassigned";
										}
										else if(balance_not_assigned > 0)
										{
											input.Payment_Voucher_Status = "Partially Assigned";
										}
										else
										{
											input.Payment_Voucher_Status = "Fully Assigned";
										}
						)
					}
				}

			}
			Finalize4 as "Finalize"
			{
				type =  form
				form = Payment_Voucher2

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PAYMENT VOUCHER STATUS FINALIZATION
										// =====================================================
										// -----------------------------------------------------
										// 1. CHECKED: MOVE TO PENDING
										// -----------------------------------------------------
										if(input.Check == true && input.Payment_Voucher_Status != "Confirmed")
										{
											input.Payment_Voucher_Status = "Pending";
											payload = Map();
											payload.put("Voucher_Number",ifnull(input.Voucher_Number,""));
											payload.put("Source_Record_ID",input.Source_Record_ID);
											if(input.Source_Form == "Payment Receipt Voucher")
											{
												payload.put("Payment_Receipt_Voucher_Status","Pending");
												masaka_resp = masaka_site_management.updatePaymentReceiptStatusFromPayment(payload);
												info "MASAKA PAYMENT RECEIPT RESPONSE:";
												info masaka_resp;
												freedom_resp = freedom_city_management.updatePaymentReceiptStatusFromPayment(payload);
												info "FREEDOM CITY PAYMENT RECEIPT RESPONSE:";
												info freedom_resp;
											}
											else if(input.Source_Form == "Payment Made Voucher")
											{
												payload.put("Payment_Made_Voucher_Status","Pending");
												masaka_resp = masaka_site_management.updatePaymentMadeStatusFromPayment(payload);
												info "MASAKA PAYMENT MADE RESPONSE:";
												info masaka_resp;
												freedom_resp = freedom_city_management.updatePaymentMadeStatusFromPayment(payload);
												info "FREEDOM CITY PAYMENT MADE RESPONSE:";
												info freedom_resp;
											}
										}
										// -----------------------------------------------------
										// 2. CONFIRMED
										// -----------------------------------------------------
										if(input.Payment_Voucher_Status == "Confirmed")
										{
											if(input.Confirmed_By_Email == null || input.Confirmed_By_Email == "")
											{
												input.Confirmed_By_Email = zoho.loginuserid;
											}
											if(input.Confirmed_By_Time == null)
											{
												input.Confirmed_By_Time = zoho.currenttime;
											}
											thisapp.Deduct_From_Unconfirmed(input.ID);
											payload = Map();
											payload.put("Voucher_Number",ifnull(input.Voucher_Number,""));
											payload.put("Source_Record_ID",input.Source_Record_ID);
											if(input.Source_Form == "Payment Receipt Voucher")
											{
												payload.put("Payment_Receipt_Voucher_Status","Confirmed");
												masaka_resp = masaka_site_management.updatePaymentReceiptStatusFromPayment(payload);
												info "MASAKA PAYMENT RECEIPT RESPONSE:";
												info masaka_resp;
												freedom_resp = freedom_city_management.updatePaymentReceiptStatusFromPayment(payload);
												info "FREEDOM CITY PAYMENT RECEIPT RESPONSE:";
												info freedom_resp;
											}
											else if(input.Source_Form == "Payment Made Voucher")
											{
												payload.put("Payment_Made_Voucher_Status","Confirmed");
												masaka_resp = masaka_site_management.updatePaymentMadeStatusFromPayment(payload);
												info "MASAKA PAYMENT MADE RESPONSE:";
												info masaka_resp;
												freedom_resp = freedom_city_management.updatePaymentMadeStatusFromPayment(payload);
												info "FREEDOM CITY PAYMENT MADE RESPONSE:";
												info freedom_resp;
											}
										}
						)
					}
				}

			}
