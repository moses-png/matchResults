				 map getExistingFreedomCityManagementPaymentReceiptIDs(list source_ids)
                 {
                 	resp = Map();
                 	existing_ids = List();
                 	if(source_ids == null || source_ids.isEmpty())
                 	{
                 		resp.put("ok",true);
                 		resp.put("existing_ids",existing_ids);
                 		return resp;
                 	}
                 	for each  source_id in source_ids
                 	{
                 		if(source_id != null)
                 		{
                 			rec = Payment_Voucher2[Source_Record_ID == source_id && Source_Form == "Payment Receipt Voucher" && Application == "Freedom City Management"];
                 			if(rec.ID != null)
                 			{
                 				existing_ids.add(source_id.toLong());
                 			}
                 		}
                 	}
                 	resp.put("ok",true);
                 	resp.put("existing_ids",existing_ids);
                 	resp.put("count",existing_ids.size());
                 	return resp;
                 }
				 map getExistingMasakaReceiptTransactionLogIDs(list source_ids)
                 {
                 	resp = Map();
                 	existing_ids = List();
                 	if(source_ids == null || source_ids.isEmpty())
                 	{
                 		resp.put("ok",true);
                 		resp.put("existing_ids",existing_ids);
                 		resp.put("count",0);
                 		return resp;
                 	}
                 	for each  source_id in source_ids
                 	{
                 		if(source_id != null)
                 		{
                 			log_rec = Account_Transaction_Log[Source_Record_ID == source_id.toLong() && Source_Form == "Payment Receipt Voucher" && Application == "Masaka Site Management" && Transaction_Type == "Debit"];
                 			if(log_rec.ID != null)
                 			{
                 				existing_ids.add(source_id.toLong());
                 			}
                 		}
                 	}
                 	resp.put("ok",true);
                 	resp.put("existing_ids",existing_ids);
                 	resp.put("count",existing_ids.size());
                 	return resp;
                 }
				 map rebuildInvoiceIncomeGroupExpense(map payload)
                 {
                 	resp = {"ok":false,"message":"Unknown error"};
                 	group_lookup = payload.get("Group");
                 	pay_date = payload.get("Payment_Date");
                 	source_group = ifnull(payload.get("Source_Group"),"Invoice Income");
                 	total_receive = round(ifnull(payload.get("Total_Receive"),0.0),2);
                 	info "===== GROUP EXPENSE DEBUG START =====";
                 	info "Group: " + group_lookup;
                 	info "Payment Date: " + pay_date;
                 	info "Source Group: " + source_group;
                 	info "Total Receive Passed In: " + total_receive;
                 	if(group_lookup == null)
                 	{
                 		resp.put("message","Group is required.");
                 		return resp;
                 	}
                 	if(pay_date == null)
                 	{
                 		resp.put("message","Payment_Date is required.");
                 		return resp;
                 	}
                 	existing_exp = Group_Accounts[Group == group_lookup && Payment_Date == pay_date && Source_Group == source_group];
                 	info "Matches Found: " + existing_exp.count();
                 	match_count = existing_exp.count();
                 	if(match_count > 0)
                 	{
                 		first_done = false;
                 		for each  ge in existing_exp
                 		{
                 			info "Before Update -> ID: " + ge.ID + " Amount_to_Receive: " + ge.Amount_to_Receive;
                 			if(first_done == false)
                 			{
                 				ge.Amount_to_Receive=total_receive;
                 				first_done = true;
                 			}
                 			else
                 			{
                 				ge.Amount_to_Receive=0;
                 			}
                 			info "After Update -> ID: " + ge.ID + " Amount_to_Receive: " + ge.Amount_to_Receive;
                 		}
                 		resp.put("ok",true);
                 		resp.put("message","Updated existing Group Expense rows. Matches found: " + match_count);
                 		info resp;
                 		info "===== GROUP EXPENSE DEBUG END =====";
                 		return resp;
                 	}
                 	else
                 	{
                 		insert into Group_Accounts
                 		[
                 			Group=group_lookup
                 			Payment_Date=pay_date
                 			Source_Group=source_group
                 			Amount_to_Receive=total_receive
                 			Added_User=zoho.loginuser
                 		]
                 		info "Inserted new Group Expense with Amount_to_Receive: " + total_receive;
                 		resp.put("ok",true);
                 		resp.put("message","Created new Group Expense.");
                 		info resp;
                 		info "===== GROUP EXPENSE DEBUG END =====";
                 		return resp;
                 	}
                 	return resp;
                 }
				 void Recalculate_Unconfirmed_Account_Totals()
                 {
                 	for each  acc in Account
                 	{
                 		unconfirmed_credit = 0.0;
                 		unconfirmed_debit = 0.0;
                 		for each  pv in Payment_Voucher2[Account == acc.ID && Payment_Voucher_Status == "Draft"]
                 		{
                 			if(pv.Transaction_Type == "Debit")
                 			{
                 				unconfirmed_debit = unconfirmed_debit + ifnull(pv.Total_Amount_Received,0.0);
                 			}
                 			else if(pv.Transaction_Type == "Credit")
                 			{
                 				unconfirmed_credit = unconfirmed_credit + ifnull(pv.Total_Amount_Paid,0.0);
                 			}
                 		}
                 		acc.Unconfirmed_Total_Credit=unconfirmed_credit;
                 		acc.Unconfirmed_Total_Debit=unconfirmed_debit;
                 		acc.Unconfirmed_Total_Amount=unconfirmed_debit + unconfirmed_credit;
                 	}
                 }
				 map refreshAccountTransactionLog(int account_id)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	if(account_id == null)
                 	{
                 		resp.put("message","Account ID is required.");
                 		return resp;
                 	}
                 	acc = Account[ID == account_id];
                 	if(acc.ID == null)
                 	{
                 		resp.put("message","Account not found.");
                 		return resp;
                 	}
                 	running_balance = 0.0;
                 	total_debit = 0.0;
                 	total_credit = 0.0;
                 	log_count = 0;
                 	logs = Account_Transaction_Log[Account == account_id] sort by Transaction_Date asc;
                 	for each  log_rec in logs
                 	{
                 		log_count = log_count + 1;
                 		amount = ifnull(log_rec.Amount,0.0);
                 		log_rec.Balance_Before=running_balance;
                 		if(log_rec.Reference_Type == "Opening Balance")
                 		{
                 			running_balance = amount;
                 		}
                 		else if(log_rec.Transaction_Type == "Debit")
                 		{
                 			total_debit = total_debit + amount;
                 			running_balance = running_balance + amount;
                 		}
                 		else if(log_rec.Transaction_Type == "Credit")
                 		{
                 			total_credit = total_credit + amount;
                 			running_balance = running_balance - amount;
                 		}
                 		log_rec.Balance_After=running_balance;
                 	}
                 	acc.Total_Debit=total_debit;
                 	acc.Total_Credit=total_credit;
                 	acc.Current_Balance=running_balance;
                 	resp.put("ok",true);
                 	resp.put("message","Selected account refreshed successfully.");
                 	resp.put("account_id",account_id);
                 	resp.put("account_name",ifnull(acc.Account_Name,""));
                 	resp.put("logs_processed",log_count);
                 	resp.put("total_debit",total_debit);
                 	resp.put("total_credit",total_credit);
                 	resp.put("current_balance",running_balance);
                 	return resp;
                 }
				 map syncPaymentChargesFromCleanSand(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	if(payload == null)
                 	{
                 		resp.put("message","Payload is null.");
                 		return resp;
                 	}
                 	source_record_id = payload.get("Source_Record_ID");
                 	parent_source_id = payload.get("Payment_Voucher_Source_ID");
                 	source_form = ifnull(payload.get("Source_Form"),"Payment Charges");
                 	if(source_record_id == null)
                 	{
                 		resp.put("message","Source Record ID missing.");
                 		return resp;
                 	}
                 	if(parent_source_id == null)
                 	{
                 		resp.put("message","Payment Voucher Source ID missing.");
                 		return resp;
                 	}
                 	transaction_date_val = null;
                 	if(ifnull(payload.get("Transaction_Date"),"") != "")
                 	{
                 		transaction_date_val = payload.get("Transaction_Date").toDate("dd-MMM-yyyy");
                 	}
                 	created_by_time_val = null;
                 	if(ifnull(payload.get("Created_By_Time"),"") != "")
                 	{
                 		created_by_time_val = payload.get("Created_By_Time").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	updated_by_time_val = null;
                 	if(ifnull(payload.get("Updated_By_Time"),"") != "")
                 	{
                 		updated_by_time_val = payload.get("Updated_By_Time").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	pv_list = Payment_Voucher2[Source_Record_ID == parent_source_id];
                 	if(pv_list.count() == 0)
                 	{
                 		resp.put("message","Parent Payment Voucher not found.");
                 		resp.put("parent_source_id",parent_source_id);
                 		return resp;
                 	}
                 	pv = pv_list;
                 	existing_list = Payment_Details[Source_Record_ID == source_record_id && Source_Form == source_form];
                 	if(existing_list.count() > 0)
                 	{
                 		existing = existing_list;
                 		existing.Voucher=pv.ID;
                 		existing.Display_Name_Voucher=payload.get("Display_Name_Payment_Voucher");
                 		existing.Line_Number=payload.get("Line_Number");
                 		existing.Description=payload.get("Description");
                 		existing.Amount_Allocated=ifnull(payload.get("Amount_Allocated"),0.0);
                 		existing.Application=payload.get("Application");
                 		existing.Transaction_Date=transaction_date_val;
                 		existing.Source_Form=source_form;
                 		existing.Source_Record_ID=source_record_id;
                 		existing.Voucher_Number=payload.get("Voucher_Number");
                 		existing.User_Name=payload.get("User_Name");
                 		existing.User_Email=payload.get("User_Email");
                 		existing.User_Role=payload.get("User_Role");
                 		existing.Created_By_Name=payload.get("Created_By_Name");
                 		existing.Created_By_Email=payload.get("Created_By_Email");
                 		existing.Created_By_Time=created_by_time_val;
                 		existing.Updated_By_Name=payload.get("Updated_By_Name");
                 		existing.Updated_By_Email=payload.get("Updated_By_Email");
                 		existing.Updated_By_Time=updated_by_time_val;
                 		resp.put("charge_action","updated");
                 		resp.put("charge_id",existing.ID);
                 	}
                 	else
                 	{
                 		new_id = insert into Payment_Details
                 		[
                 			Voucher=pv.ID
                 			Display_Name_Voucher=payload.get("Display_Name_Payment_Voucher")
                 			Line_Number=payload.get("Line_Number")
                 			Description=payload.get("Description")
                 			Amount_Allocated=ifnull(payload.get("Amount_Allocated"),0.0)
                 			Application=payload.get("Application")
                 			Transaction_Date=transaction_date_val
                 			Source_Form=source_form
                 			Source_Record_ID=source_record_id
                 			Voucher_Number=payload.get("Voucher_Number")
                 			User_Name=payload.get("User_Name")
                 			User_Email=payload.get("User_Email")
                 			User_Role=payload.get("User_Role")
                 			Created_By_Name=payload.get("Created_By_Name")
                 			Created_By_Email=payload.get("Created_By_Email")
                 			Created_By_Time=created_by_time_val
                 			Updated_By_Name=payload.get("Updated_By_Name")
                 			Updated_By_Email=payload.get("Updated_By_Email")
                 			Updated_By_Time=updated_by_time_val
                 			Added_User=zoho.loginuser
                 		];
                 		resp.put("charge_action","created");
                 		resp.put("charge_id",new_id);
                 	}
                 	total_amount = 0.0;
                 	for each  d in Payment_Details[Voucher == pv.ID]
                 	{
                 		total_amount = total_amount + ifnull(d.Amount_Allocated,0.0);
                 	}
                 	pv.Total_Amount=total_amount;
                 	resp.put("ok",true);
                 	resp.put("message","Payment charge synced from Clean Sand Management and parent total recalculated.");
                 	resp.put("payment_voucher_id",pv.ID);
                 	resp.put("total_amount",total_amount);
                 	return resp;
                 }
