				 map labour.recalculate_truck_movement_labour(int employee_id, string employee_display_name, date work_date)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("message","");
                 	result.put("employee_id",employee_id);
                 	result.put("employee","");
                 	result.put("monthly_salary",0.0);
                 	result.put("working_days",0);
                 	result.put("daily_labour",0.0);
                 	result.put("trip_lines_updated",0);
                 	result.put("calculated_labour_total",0.0);
                 	// =====================================================
                 	// 1. VALIDATE EMPLOYEE
                 	// =====================================================
                 	if(employee_id == null)
                 	{
                 		result.put("message","Employee ID is required.");
                 		return result;
                 	}
                 	employee_display_name = ifnull(employee_display_name,"").trim();
                 	if(employee_display_name == "")
                 	{
                 		result.put("message","Display Name Employee is required.");
                 		return result;
                 	}
                 	result.put("employee",employee_display_name);
                 	if(work_date == null)
                 	{
                 		work_date = zoho.currentdate;
                 	}
                 	// =====================================================
                 	// 2. GET EMPLOYEE SALARY
                 	// =====================================================
                 	salary_result = employee_management.employee.get_employee_salary_details(employee_id,work_date);
                 	if(salary_result == null)
                 	{
                 		result.put("message","Employee Management returned no salary information.");
                 		return result;
                 	}
                 	if(ifnull(salary_result.get("ok"),false) != true)
                 	{
                 		result.put("message",ifnull(salary_result.get("message"),"Employee salary could not be retrieved."));
                 		return result;
                 	}
                 	monthly_salary = ifnull(salary_result.get("monthly_salary"),0.0);
                 	if(monthly_salary <= 0)
                 	{
                 		result.put("message","The employee monthly salary must be greater than zero.");
                 		return result;
                 	}
                 	result.put("monthly_salary",monthly_salary);
                 	// =====================================================
                 	// 3. DETERMINE MONTH RANGE
                 	// =====================================================
                 	month_number = work_date.getMonth();
                 	year_number = work_date.getYear();
                 	month_text = month_number.toString();
                 	if(month_number < 10)
                 	{
                 		month_text = "0" + month_number;
                 	}
                 	month_start_text = "01-" + month_text + "-" + year_number.toString();
                 	month_start = month_start_text.toDate("dd-MM-yyyy");
                 	next_month_start = month_start.addMonth(1);
                 	result.put("month_start",month_start);
                 	result.put("next_month_start",next_month_start);
                 	// =====================================================
                 	// 4. GET EMPLOYEE'S TRUCK MOVEMENTS
                 	// =====================================================
                 	// Display_Name_Employee is stored directly in
                 	// Truck_Movement_Voucher.
                 	month_trips = Truck_Movement_Voucher[Display_Name_Employee == employee_display_name && Time_Start >= month_start && Time_Start < next_month_start && Cancel_Voucher != true];
                 	if(month_trips.count() <= 0)
                 	{
                 		result.put("message","No truck movements were found for " + employee_display_name + " in this month.");
                 		return result;
                 	}
                 	// =====================================================
                 	// 5. COUNT TRIPS FOR EACH WORKING DATE
                 	// =====================================================
                 	trips_per_day = Map();
                 	working_dates = List();
                 	for each  trip_rec in month_trips
                 	{
                 		if(trip_rec.Time_Start != null)
                 		{
                 			movement_date = trip_rec.Time_Start.toDate();
                 			day_key = movement_date.toString("yyyy-MM-dd");
                 			if(!working_dates.contains(day_key))
                 			{
                 				working_dates.add(day_key);
                 			}
                 			day_trip_count = 0;
                 			if(trips_per_day.containKey(day_key))
                 			{
                 				day_trip_count = ifnull(trips_per_day.get(day_key),0);
                 			}
                 			trips_per_day.put(day_key,day_trip_count + 1);
                 		}
                 	}
                 	// =====================================================
                 	// 6. CALCULATE DAILY LABOUR
                 	// =====================================================
                 	working_days = working_dates.size();
                 	if(working_days <= 0)
                 	{
                 		result.put("message","No valid working dates were found.");
                 		return result;
                 	}
                 	daily_labour = round(monthly_salary / working_days,2);
                 	result.put("working_days",working_days);
                 	result.put("daily_labour",daily_labour);
                 	// =====================================================
                 	// 7. DISTRIBUTE DAILY LABOUR ACROSS DAILY TRIPS
                 	// =====================================================
                 	updated_count = 0;
                 	calculated_total = 0.0;
                 	for each  trip_rec in month_trips
                 	{
                 		if(trip_rec.Time_Start != null)
                 		{
                 			day_key = trip_rec.Time_Start.toDate().toString("yyyy-MM-dd");
                 			trips_that_day = ifnull(trips_per_day.get(day_key),0);
                 			if(trips_that_day > 0)
                 			{
                 				labour_per_trip = round(daily_labour / trips_that_day,2);
                 				trip_rec.Labour_Cost=labour_per_trip;
                 				calculated_total = calculated_total + labour_per_trip;
                 				updated_count = updated_count + 1;
                 			}
                 		}
                 	}
                 	// =====================================================
                 	// 8. RETURN RESULT
                 	// =====================================================
                 	result.put("trip_lines_updated",updated_count);
                 	result.put("calculated_labour_total",round(calculated_total,2));
                 	result.put("ok",true);
                 	result.put("message","Truck movement labour was recalculated successfully.");
                 	return result;
                 }
				 map mileage.get_days_odometer_readings(int asset_id, date reported_date)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("reported_odometer",0.0);
                 	result.put("current_odometer",0.0);
                 	result.put("message","");
                 	if(asset_id == null)
                 	{
                 		result.put("message","Asset ID is required.");
                 		return result;
                 	}
                 	if(reported_date == null)
                 	{
                 		reported_date = zoho.currentdate;
                 	}
                 	asset_rec = Asset_List[ID == asset_id];
                 	if(asset_rec.ID == null)
                 	{
                 		result.put("message","Asset was not found.");
                 		return result;
                 	}
                 	reported_odo = null;
                 	current_odo = null;
                 	// Find the latest reading on or before the reported date
                 	for each  log_rec in Asset_Mileage_Log[Asset == asset_id] sort by Date_Time_Recorded desc
                 	{
                 		if(log_rec.Date_Time_Recorded != null)
                 		{
                 			log_date = log_rec.Date_Time_Recorded.toDate();
                 			if(reported_odo == null && log_date <= reported_date)
                 			{
                 				reported_odo = ifnull(log_rec.Odometer_Reading,0.0);
                 			}
                 			if(current_odo == null && log_date <= zoho.currentdate)
                 			{
                 				current_odo = ifnull(log_rec.Odometer_Reading,0.0);
                 			}
                 			if(reported_odo != null && current_odo != null)
                 			{
                 				break;
                 			}
                 		}
                 	}
                 	if(reported_odo == null)
                 	{
                 		reported_odo = 0.0;
                 	}
                 	if(current_odo == null)
                 	{
                 		current_odo = 0.0;
                 	}
                 	result.put("ok",true);
                 	result.put("reported_odometer",reported_odo);
                 	result.put("current_odometer",current_odo);
                 	result.put("message","Days odometer readings retrieved.");
                 	return result;
                 }
				 int mileage_core.mileage_add_log(int asset_id, float odo_value, string source_form, string source_record_id, string uom)
                 {
                 	// Return ID of new mileage log
                 	new_id = 0;
                 	// Basic guard
                 	if(asset_id == null || odo_value == null)
                 	{
                 		return new_id;
                 	}
                 	// Insert new row into Asset_Mileage_Log
                 	inserted = insert into Asset_Mileage_Log
                 	[
                 		Asset=asset_id
                 		Date_Time_Recorded=zoho.currenttime
                 		Odometer_Reading=odo_value
                 		Previous_Odometer=0.0
                 		Distance_Since_Last=0.0
                 		Unit_of_Measure=ifnull(uom,"km")
                 		Odometer_Source_Form=source_form
                 		Source_Record_ID=source_record_id
                 		Reference=""
                 		Notes=""
                 		Added_User=zoho.loginuser
                 	];
                 	// 'inserted' is the record ID (long), not a record object
                 	if(inserted != null)
                 	{
                 		new_id = inserted.toLong();
                 	}
                 	return new_id;
                 }
				 void routine_issues.close_and_update_frequency(bigint issue_id, bigint current_task_id)
                 {
                 	if(issue_id == null)
                 	{
                 		return;
                 	}
                 	issue_rec = Asset_Issues[ID == issue_id];
                 	if(issue_rec.ID == null)
                 	{
                 		return;
                 	}
                 	tasks = Work_Order_Tasks[Issue == issue_id];
                 	total_tasks = 0;
                 	open_task_found = false;
                 	latest_odo = null;
                 	for each  t in tasks
                 	{
                 		total_tasks = total_tasks + 1;
                 		status_val = ifnull(t.Work_Order_Task_Status,"").trim();
                 		// Treat current task as already Invoicing
                 		if(t.ID == current_task_id)
                 		{
                 			status_val = "Invoicing";
                 		}
                 		if(status_val != "Invoicing" && status_val != "Invoiced" && status_val != "Cancelled")
                 		{
                 			open_task_found = true;
                 		}
                 		if(t.Odometer_Reading_Checked != null)
                 		{
                 			latest_odo = t.Odometer_Reading_Checked;
                 		}
                 	}
                 	if(total_tasks == 0 || open_task_found == true)
                 	{
                 		return;
                 	}
                 	// Close Asset Issue
                 	issue_rec.Status="Closed";
                 	// Update Routine Issue frequency details
                 	routine_rows = Routine_Issues[Open_Issue_ID == issue_id];
                 	for each  r in routine_rows
                 	{
                 		r.Open_Issue_ID=null;
                 		r.Last_Issue_Date=zoho.currentdate;
                 		if(latest_odo != null)
                 		{
                 			r.Last_Done_Odometer=latest_odo;
                 			if(r.Odometer_Frequency != null)
                 			{
                 				r.Next_Done_Odometer=latest_odo + r.Odometer_Frequency;
                 			}
                 		}
                 		r.Last_Done_Date=zoho.currentdate;
                 		if(r.Frequency_Value != null && r.Date_Frequency != null)
                 		{
                 			if(r.Date_Frequency == "Days")
                 			{
                 				r.Next_Done_Date=zoho.currentdate.addDay(r.Frequency_Value);
                 			}
                 			else if(r.Date_Frequency == "Weeks")
                 			{
                 				r.Next_Done_Date=zoho.currentdate.addDay(r.Frequency_Value * 7);
                 			}
                 			else if(r.Date_Frequency == "Months")
                 			{
                 				r.Next_Done_Date=zoho.currentdate.addMonth(r.Frequency_Value);
                 			}
                 			else if(r.Date_Frequency == "Years")
                 			{
                 				r.Next_Done_Date=zoho.currentdate.addMonth(r.Frequency_Value * 12);
                 			}
                 		}
                 	}
                 }
				 void routine_issues.create_asset_issues_from_routines()
                 {
                 	today_date = zoho.currentdate;
                 	routine_list = Routine_Issues[Status == "Active"];
                 	for each  r in routine_list
                 	{
                 		if(r.Asset == null || r.Labour == null)
                 		{
                 			continue;
                 		}
                 		if(r.Open_Issue_ID != null)
                 		{
                 			old_issue = Asset_Issues[ID == r.Open_Issue_ID];
                 			if(old_issue.ID != null && old_issue.Status != "Closed")
                 			{
                 				continue;
                 			}
                 			else
                 			{
                 				r.Open_Issue_ID=null;
                 			}
                 		}
                 		asset_rec = Asset_List[ID == r.Asset];
                 		if(asset_rec.ID == null)
                 		{
                 			continue;
                 		}
                 		current_odo = ifnull(asset_rec.Odometer_Reading,0.0);
                 		create_issue = false;
                 		if(r.Next_Done_Odometer != null && r.Next_Done_Odometer > 0 && current_odo >= r.Next_Done_Odometer)
                 		{
                 			create_issue = true;
                 		}
                 		if(r.Next_Done_Date != null && r.Next_Done_Date <= today_date)
                 		{
                 			create_issue = true;
                 		}
                 		if(create_issue == false)
                 		{
                 			continue;
                 		}
                 		issue_title = ifnull(r.Display_Name_Labour,"Routine Maintenance") + " Due";
                 		existing_open = Asset_Issues[Asset == r.Asset && Issue == issue_title && Status != "Closed"];
                 		if(existing_open.count() > 0)
                 		{
                 			for each  ei in existing_open
                 			{
                 				r.Open_Issue_ID=ei.ID;
                 				break;
                 			}
                 			continue;
                 		}
                 		prefix_key = "RTN-ISSUE";
                 		seq = Work_Order_Sequence[Prefix == prefix_key];
                 		if(seq.ID == null)
                 		{
                 			info "Sequence missing: " + prefix_key;
                 			continue;
                 		}
                 		next_num = ifnull(seq.Next_Number,1);
                 		if(next_num < 10)
                 		{
                 			num_str = "000" + next_num;
                 		}
                 		else if(next_num < 100)
                 		{
                 			num_str = "00" + next_num;
                 		}
                 		else if(next_num < 1000)
                 		{
                 			num_str = "0" + next_num;
                 		}
                 		else
                 		{
                 			num_str = next_num.toString();
                 		}
                 		issue_no = prefix_key + "-" + num_str;
                 		dupe = Asset_Issues[Issue_Number == issue_no];
                 		if(dupe.count() > 0)
                 		{
                 			info "Duplicate issue number: " + issue_no;
                 			continue;
                 		}
                 		issue_desc = "Auto-created from Routine Issue.\nAsset: " + ifnull(r.Display_Name_Asset,"") + "\nRoutine: " + ifnull(r.Display_Name_Labour,"") + "\nCurrent Odometer: " + current_odo + "\nNext Done Odometer: " + ifnull(r.Next_Done_Odometer,0) + "\nNext Done Date: " + ifnull(r.Next_Done_Date,"");
                 		new_issue_id = insert into Asset_Issues
                 		[
                 			Issue_Number=issue_no
                 			Asset=r.Asset
                 			Display_Name_Asset=ifnull(asset_rec.Display_Name_Asset_Name,"")
                 			Current_Site=ifnull(asset_rec.Current_Site,"")
                 			Current_Custodian=ifnull(asset_rec.Current_Custodian,"")
                 			Odometer_Reading=current_odo
                 			Reported_Date=zoho.currenttime
                 			Issue=issue_title
                 			Issue_Description=issue_desc
                 			Severity="Medium"
                 			Status="Open"
                 			Added_User=zoho.loginuser
                 		];
                 		site_name = ifnull(asset_rec.Current_Site,"").trim();
                 		site_name_lower = site_name.toLowerCase();
                 		info "Routine sync site_name: [" + site_name + "]";
                 		if(site_name_lower.contains("kabuusu") || site_name_lower.contains("concrete products"))
                 		{
                 			sync_payload = Map();
                 			sync_payload.put("Source_Record_ID",new_issue_id);
                 			sync_payload.put("Source_Form","Asset Management Asset Issues");
                 			sync_payload.put("Issue_Number",issue_no);
                 			sync_payload.put("Asset",r.Asset);
                 			sync_payload.put("Display_Name_Asset",ifnull(asset_rec.Display_Name_Asset_Name,""));
                 			sync_payload.put("Current_Site",ifnull(asset_rec.Current_Site,""));
                 			sync_payload.put("Current_Custodian",ifnull(asset_rec.Current_Custodian,""));
                 			sync_payload.put("Odometer_Reading",current_odo);
                 			sync_payload.put("Reported_Date",zoho.currenttime);
                 			sync_payload.put("Issue",issue_title);
                 			sync_payload.put("Issue_Description",issue_desc);
                 			sync_payload.put("Severity","Medium");
                 			sync_payload.put("Status","Open");
                 			info "Calling Concrete sync for: " + issue_no;
                 			concrete_products_management.create_asset_issue_from_asset_management_payload(sync_payload);
                 			info "Concrete sync call finished for: " + issue_no;
                 		}
                 		else
                 		{
                 			info "Concrete sync skipped. Site did not match: [" + site_name + "]";
                 		}
                 		r.Open_Issue_ID=new_issue_id;
                 		r.Last_Issue_Date=zoho.currentdate;
                 		seq.Next_Number=next_num + 1;
                 		info "Created routine issue: " + issue_no;
                 	}
                 }
				 map services.recalculate_weekly_weigh_bridge(int employee_vendor_id, date work_date, string truck_plate)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("message","");
                 	result.put("weekly_total",1000000.0);
                 	result.put("trip_count",0);
                 	result.put("rate_per_trip",0.0);
                 	result.put("lines_updated",0);
                 	result.put("bill_id",null);
                 	result.put("distributed_total",0.0);
                 	// =====================================================
                 	// 1. VALIDATE PARAMETERS
                 	// =====================================================
                 	if(employee_vendor_id == null)
                 	{
                 		result.put("message","Hamid Ssenoga employee vendor ID is required.");
                 		return result;
                 	}
                 	if(work_date == null)
                 	{
                 		work_date = zoho.currentdate;
                 	}
                 	truck_plate = ifnull(truck_plate,"").trim();
                 	if(truck_plate == "")
                 	{
                 		result.put("message","Number Plate - Truck Register is required.");
                 		return result;
                 	}
                 	weekly_total = 1000000.0;
                 	// =====================================================
                 	// 2. CALCULATE MONDAY TO NEXT MONDAY
                 	// =====================================================
                 	day_number = work_date.getDayOfWeek();
                 	if(day_number == 1)
                 	{
                 		days_to_monday = -6;
                 	}
                 	else
                 	{
                 		days_to_monday = 2 - day_number;
                 	}
                 	week_start = work_date.addDay(days_to_monday);
                 	next_week_start = week_start.addDay(7);
                 	week_number = week_start.getWeekOfYear();
                 	week_text = week_number.toString();
                 	if(week_number < 10)
                 	{
                 		week_text = "0" + week_text;
                 	}
                 	week_identifier = week_start.getYear().toString() + " Week " + week_text;
                 	// Bill Number now identifies both truck and week
                 	weekly_bill_number = truck_plate + " - " + week_identifier;
                 	result.put("week_start",week_start);
                 	result.put("next_week_start",next_week_start);
                 	result.put("truck_plate",truck_plate);
                 	result.put("week_identifier",week_identifier);
                 	result.put("bill_number",weekly_bill_number);
                 	// =====================================================
                 	// 3. LOAD VALID MOVEMENTS FOR THIS TRUCK AND THIS WEEK
                 	// =====================================================
                 	week_movements = Truck_Movement_Voucher[Time_Start >= week_start && Time_Start < next_week_start && Number_Plate_Truck_Register == truck_plate && Cancel_Voucher != true && Truck_Movement_Voucher_Status != "Cancelled"];
                 	if(week_movements.count() <= 0)
                 	{
                 		result.put("message","No Truck Movement records were found for truck " + truck_plate + " in " + week_identifier + ".");
                 		return result;
                 	}
                 	// =====================================================
                 	// 4. COUNT WEIGH BRIDGE TRIPS FOR THIS TRUCK ONLY
                 	// =====================================================
                 	weigh_bridge_trip_count = 0;
                 	for each  movement_rec in week_movements
                 	{
                 		for each  srv in movement_rec.Services
                 		{
                 			if(srv.Service != null)
                 			{
                 				service_name = ifnull(srv.Service.Service_Name,"").trim();
                 				if(service_name == "Weigh Bridge")
                 				{
                 					weigh_bridge_trip_count = weigh_bridge_trip_count + 1;
                 				}
                 			}
                 		}
                 	}
                 	if(weigh_bridge_trip_count <= 0)
                 	{
                 		result.put("message","No Weigh Bridge service rows were found for truck " + truck_plate + " in " + week_identifier + ".");
                 		return result;
                 	}
                 	// =====================================================
                 	// 5. CALCULATE RATE PER TRIP
                 	// =====================================================
                 	rate_per_trip = round(weekly_total / weigh_bridge_trip_count,2);
                 	result.put("trip_count",weigh_bridge_trip_count);
                 	result.put("rate_per_trip",rate_per_trip);
                 	// =====================================================
                 	// 6. FIND EXISTING BILL FOR THIS TRUCK AND THIS WEEK
                 	// =====================================================
                 	weigh_bridge_bill = Bill[Employee_Vendor == employee_vendor_id && Bill_Name == "Weigh Bridge" && Bill_Number == weekly_bill_number && Vendor_Type == "Employee Vendor"];
                 	bill_id = null;
                 	if(weigh_bridge_bill.ID != null)
                 	{
                 		bill_id = weigh_bridge_bill.ID;
                 	}
                 	else
                 	{
                 		// =================================================
                 		// 7. CREATE A BILL FOR THIS TRUCK AND THIS WEEK
                 		// =================================================
                 		bill_id = insert into Bill
                 		[
                 			Bill_Date=week_start
                 			Vendor_Type="Employee Bill"
                 			Employee_Vendor=employee_vendor_id
                 			Display_Name_Vendor="Hamid Ssenoga - 50"
                 			Bill_Name="Weigh Bridge"
                 			Bill_Number=weekly_bill_number
                 			Bill_Total=weekly_total
                 			Services_Total=weekly_total
                 			Total_Amount=weekly_total
                 			Amount_Due=weekly_total
                 			Amount_Paid=0.0
                 			Bill_Status="Draft"
                 			Payment_Status="Not Paid"
                 			Added_User=zoho.loginuser
                 		];
                 		if(bill_id != null)
                 		{
                 			weigh_bridge_bill = Bill[ID == bill_id];
                 		}
                 	}
                 	if(weigh_bridge_bill.ID == null)
                 	{
                 		result.put("message","The weekly Weigh Bridge Employee Bill for truck " + truck_plate + " could not be created.");
                 		return result;
                 	}
                 	// =====================================================
                 	// 8. KEEP THIS TRUCK'S WEEKLY BILL AT 1,000,000
                 	// =====================================================
                 	paid_amount = ifnull(weigh_bridge_bill.Amount_Paid,0.0);
                 	balance_amount = weekly_total - paid_amount;
                 	if(balance_amount < 0)
                 	{
                 		balance_amount = 0.0;
                 	}
                 	weigh_bridge_bill.Bill_Date=week_start;
                 	weigh_bridge_bill.Vendor_Type="Employee Venodr";
                 	weigh_bridge_bill.Employee_Vendor=employee_vendor_id;
                 	weigh_bridge_bill.Display_Name_Vendor="Hamid Ssenoga - 50";
                 	weigh_bridge_bill.Bill_Name="Weigh Bridge";
                 	weigh_bridge_bill.Bill_Number=weekly_bill_number;
                 	weigh_bridge_bill.Bill_Total=weekly_total;
                 	weigh_bridge_bill.Services_Total=weekly_total;
                 	weigh_bridge_bill.Total_Amount=weekly_total;
                 	weigh_bridge_bill.Bill_Status="Draft";
                 	if(paid_amount <= 0)
                 	{
                 		weigh_bridge_bill.Payment_Status="Not Paid";
                 	}
                 	else if(balance_amount <= 0)
                 	{
                 		weigh_bridge_bill.Payment_Status="Paid";
                 	}
                 	else
                 	{
                 		weigh_bridge_bill.Payment_Status="Partially Paid";
                 	}
                 	bill_id = weigh_bridge_bill.ID;
                 	// =====================================================
                 	// 9. DISTRIBUTE 1,000,000 AMONG THIS TRUCK'S TRIPS
                 	// =====================================================
                 	updated_count = 0;
                 	distributed_total = 0.0;
                 	current_trip_number = 0;
                 	for each  movement_rec in week_movements
                 	{
                 		movement_has_weigh_bridge = false;
                 		movement_services_total = 0.0;
                 		movement_display = ifnull(movement_rec.Display_Name_Voucher,"").trim();
                 		if(movement_rec.Line_Number != null)
                 		{
                 			if(movement_display != "")
                 			{
                 				movement_display = movement_display + " - " + movement_rec.Line_Number.toString();
                 			}
                 			else
                 			{
                 				movement_display = movement_rec.Line_Number.toString();
                 			}
                 		}
                 		for each  srv in movement_rec.Services
                 		{
                 			if(srv.Service != null)
                 			{
                 				service_name = ifnull(srv.Service.Service_Name,"").trim();
                 				if(service_name == "Weigh Bridge")
                 				{
                 					movement_has_weigh_bridge = true;
                 					current_trip_number = current_trip_number + 1;
                 					line_rate = rate_per_trip;
                 					if(current_trip_number == weigh_bridge_trip_count)
                 					{
                 						line_rate = round(weekly_total - distributed_total,2);
                 					}
                 					srv.Quantity=1.0;
                 					srv.Rate=line_rate;
                 					srv.Bill=bill_id;
                 					srv.Display_Name_Bill="Weigh Bridge - " + weekly_bill_number;
                 					srv.Truck_Movement_Voucher=movement_rec.ID;
                 					srv.Display_Name_Voucher=movement_display;
                 					srv.Last_Synced_Group_ID=bill_id;
                 					srv.Last_Synced_Group_Amount=line_rate;
                 					movement_services_total = movement_services_total + line_rate;
                 					distributed_total = distributed_total + line_rate;
                 					updated_count = updated_count + 1;
                 				}
                 				else
                 				{
                 					movement_services_total = movement_services_total + ifnull(srv.Line_Total,0.0);
                 				}
                 			}
                 			else
                 			{
                 				movement_services_total = movement_services_total + ifnull(srv.Line_Total,0.0);
                 			}
                 		}
                 		// =================================================
                 		// 10. RECALCULATE PARENT MOVEMENT TOTALS
                 		// =================================================
                 		if(movement_has_weigh_bridge == true)
                 		{
                 			movement_rec.Service_Cost=round(movement_services_total,2);
                 			movement_rec.Line_Total=round(ifnull(movement_rec.Material_Cost,0.0) + ifnull(movement_rec.Service_Cost,0.0) + ifnull(movement_rec.Fuel_Cost,0.0) + ifnull(movement_rec.Labour_Cost,0.0),2);
                 			distance = ifnull(movement_rec.Line_Distance_Travelled,0.0);
                 			if(distance > 0)
                 			{
                 				movement_rec.Cost_Per_Odometer=round(movement_rec.Line_Total / distance,2);
                 			}
                 			else
                 			{
                 				movement_rec.Cost_Per_Odometer=0.0;
                 			}
                 		}
                 	}
                 	// =====================================================
                 	// 11. VERIFY DISTRIBUTION
                 	// =====================================================
                 	distributed_total = round(distributed_total,2);
                 	if(distributed_total != weekly_total)
                 	{
                 		result.put("message","Weigh Bridge distribution for truck " + truck_plate + " does not equal UGX 1,000,000.");
                 		result.put("distributed_total",distributed_total);
                 		return result;
                 	}
                 	// =====================================================
                 	// 12. RETURN RESULTS
                 	// =====================================================
                 	result.put("bill_id",bill_id);
                 	result.put("lines_updated",updated_count);
                 	result.put("distributed_total",distributed_total);
                 	result.put("ok",true);
                 	result.put("message","Weekly Weigh Bridge bill for truck " + truck_plate + " was recalculated successfully.");
                 	return result;
                 }
				 float service_work_report.swr_calc_line_total(float qty, float rate)
                 {
                 	q = ifnull(qty,0.0);
                 	r = ifnull(rate,0.0);
                 	lt = q * r;
                 	return round(lt,2);
                 }
				 map service_work_report.swr_validate_row(int item_id, int labour_id, float qty, float rate)
                 {
                 	result = Map();
                 	result.put("ok",true);
                 	result.put("message","");
                 	// 1. Must select one of Item or Labour
                 	if(item_id == null && labour_id == null)
                 	{
                 		result.put("ok",false);
                 		result.put("message","Select either an Item or a Labour.");
                 		return result;
                 	}
                 	// 2. Cannot select both
                 	if(item_id != null && labour_id != null)
                 	{
                 		result.put("ok",false);
                 		result.put("message","You cannot select both Item and Labour in the same row.");
                 		return result;
                 	}
                 	// 3. Quantity > 0
                 	if(qty == null || qty <= 0)
                 	{
                 		result.put("ok",false);
                 		result.put("message","Quantity must be greater than 0.");
                 		return result;
                 	}
                 	// 4. Unit Cost >= 0
                 	if(rate == null || rate < 0)
                 	{
                 		result.put("ok",false);
                 		result.put("message","Unit Cost must be 0 or higher.");
                 		return result;
                 	}
                 	return result;
                 }
				 void work_order_admin.update_work_order_totals(bigint work_order_id)
                 {
                 	if(work_order_id == null)
                 	{
                 		return;
                 	}
                 	wo = Work_Order[ID == work_order_id];
                 	if(wo.ID == null)
                 	{
                 		return;
                 	}
                 	parts_total = 0.0;
                 	labour_total = 0.0;
                 	task_count = 0;
                 	open_task_found = false;
                 	earliest_started_datetime = null;
                 	earliest_started_odometer = null;
                 	latest_completed_datetime = null;
                 	latest_completed_odometer = null;
                 	tasks = Work_Order_Tasks[Work_Order == work_order_id];
                 	for each  t in tasks
                 	{
                 		task_count = task_count + 1;
                 		parts_total = parts_total + ifnull(t.Parts_Total,0.0);
                 		labour_total = labour_total + ifnull(t.Labour_Total,0.0);
                 		task_status = ifnull(t.Work_Order_Task_Status,"").trim();
                 		if(task_status == "" || task_status == "Requested" || task_status == "Repairing" || task_status == "Checking")
                 		{
                 			open_task_found = true;
                 		}
                 		if(t.Date_Time_Approved != null)
                 		{
                 			if(earliest_started_datetime == null || t.Date_Time_Approved < earliest_started_datetime)
                 			{
                 				earliest_started_datetime = t.Date_Time_Approved;
                 				earliest_started_odometer = t.Odometer_Reading_Approved;
                 			}
                 		}
                 		if(t.Date_Time_Work_Completed != null)
                 		{
                 			if(latest_completed_datetime == null || t.Date_Time_Work_Completed > latest_completed_datetime)
                 			{
                 				latest_completed_datetime = t.Date_Time_Work_Completed;
                 				latest_completed_odometer = t.Odometer_Reading_Completed;
                 			}
                 		}
                 	}
                 	parts_total = round(parts_total,2);
                 	labour_total = round(labour_total,2);
                 	wo.Parts_Total=parts_total;
                 	wo.Labour_Total=labour_total;
                 	wo.Service_Task_Total=round(parts_total + labour_total,2);
                 	if(earliest_started_datetime != null)
                 	{
                 		wo.Date_Started=earliest_started_datetime;
                 	}
                 	if(earliest_started_odometer != null)
                 	{
                 		wo.Odometer_Reading_Started=earliest_started_odometer;
                 	}
                 	if(task_count > 0)
                 	{
                 		if(latest_completed_datetime != null && open_task_found == false)
                 		{
                 			wo.Status="Completed";
                 			wo.Date_Completed=latest_completed_datetime;
                 			if(latest_completed_odometer != null)
                 			{
                 				wo.Odometer_Reading_Completed=latest_completed_odometer;
                 			}
                 		}
                 		else if(earliest_started_datetime != null)
                 		{
                 			wo.Status="In Progress";
                 			wo.Date_Completed=null;
                 			wo.Odometer_Reading_Completed=null;
                 		}
                 		else
                 		{
                 			wo.Status="Pending";
                 			wo.Date_Started=null;
                 			wo.Odometer_Reading_Started=null;
                 			wo.Date_Completed=null;
                 			wo.Odometer_Reading_Completed=null;
                 		}
                 	}
                 	else
                 	{
                 		wo.Status="Pending";
                 		wo.Date_Started=null;
                 		wo.Odometer_Reading_Started=null;
                 		wo.Date_Completed=null;
                 		wo.Odometer_Reading_Completed=null;
                 	}
                 }
			 }
		 }


		workflow
		{
		form
		{
			Set_Up_Form6 as "Set Up Form"
			{
				type =  form
				form = Asset_List

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// 1. ALWAYS DISABLE SYSTEM / COMPUTED FIELDS
										// =====================================
										disable Display_Name_Asset_Owner;
										disable Display_Name_Asset_Name;
										disable Display_Name_Asset_Type;
										disable Asset_ID;
										disable Status_Change_Date;
										disable Retirement_Date;
										disable Disposal_Date;
										disable Current_Site;
										disable Current_Custodian;
										disable Last_Transfer_Date;
										disable Last_Transfer_Reference;
										disable Asset_Status;
										disable Total_Service_Costs;
										disable Service_Cost_Per_Odometer;
										disable Total_Fuel_Costs;
										disable Fuel_Cost_Per_Odometer;
										disable Total_Labour_Costs;
										disable Labour_Cost_Per_Odometer;
										disable Total_Costs;
										disable Cost_Per_Odometer;
										// =====================================
										// 2. ALWAYS HIDE BACKEND / NON-USER FIELDS
										// =====================================
										hide Display_Name_Asset_Owner;
										hide Display_Name_Asset_Name;
										hide Display_Name_Asset_Type;
										hide Status_Change_Date;
										hide Retirement_Date;
										hide Disposal_Date;
										hide Current_Site;
										hide Current_Custodian;
										hide Last_Transfer_Date;
										hide Last_Transfer_Reference;
										hide Display_Name_Odometer_Unit_Of_Measure;
										// =====================================
										// 3. ALWAYS CONTROL AVAILABLE LISTS SUBFORM
										// =====================================
										//disable fields
										disable Available_Lists.Display_Name_Asset;
										disable Available_Lists.Display_Name_List;
										disable Available_Lists.Current_Site;
										disable Available_Lists.Current_Custodian;
										disable Available_Lists.Last_Transfer_Date;
										disable Available_Lists.Last_Transfer_Reference;
										//hide fields
										hide Available_Lists.Display_Name_Asset;
										hide Available_Lists.Display_Name_List;
										hide Available_Lists.Current_Site;
										hide Available_Lists.Current_Custodian;
										hide Available_Lists.Last_Transfer_Date;
										hide Available_Lists.Last_Transfer_Reference;
										hide Available_Lists;
										hide Routine_Issues;
										hide Allowed_Emails;
										hide Store_Users;
										hide Transaction_Log;
										// =====================================
										// 4. LEASE SUMMARY
										// =====================================
										hide Rental_Status;
										hide Current_Lease_Freedom_City_Management;
										hide Display_Name_Current_Tenant;
										hide Display_Name_Current_Lease;
										hide Lease_Start_Date;
										hide Lease_End_Date;
										hide Monthly_Rent;
										hide Occupancy_Status;
										hide Last_Handover_Date;
										hide Last_Take_Back_Date;
										hide Area;
										hide Volume;
										// =====================================
										// 4. CREATE MODE
										// =====================================
										if(input.ID == null)
										{
											hide Asset_ID;
											if(input.Is_Purchased == true)
											{
												show Item;
												show Purchase_Cost;
											}
											else
											{
												hide Item;
												hide Purchase_Cost;
												input.Item = null;
												input.Purchase_Cost = null;
											}
										}
										// =====================================
										// 5. EDIT MODE
										// =====================================
										if(input.ID != null)
										{
											show Asset_ID;
											show Current_Custodian;
											show Current_Site;
											enable Current_Custodian;
											enable Current_Site;
											disable Asset_Owner;
											disable Asset_Type;
											if(input.Is_Purchased == true)
											{
												show Item;
												show Purchase_Cost;
											}
											else
											{
												hide Item;
												hide Purchase_Cost;
												input.Item = null;
												input.Purchase_Cost = null;
											}
										}
										// =====================================
										// 6. ALWAYS BUILD DISPLAY NAME ASSET
										// =====================================
										if(input.Asset_Name != null && input.Asset_ID != null)
										{
											input.Display_Name_Asset_Name = input.Asset_Name + " - " + input.Asset_ID;
										}
										else if(input.Asset_Name != null)
										{
											input.Display_Name_Asset_Name = input.Asset_Name;
										}
										else
										{
											input.Display_Name_Asset_Name = "";
										}
										// =====================================
										// 7. ALWAYS BUILD DISPLAY NAME ASSET OWNER
										// =====================================
										if(input.Asset_Owner != null)
										{
											input.Display_Name_Asset_Owner = ifnull(input.Asset_Owner.Company_Name,"");
										}
										else
										{
											input.Display_Name_Asset_Owner = "";
										}
										// =====================================
										// 8. ALWAYS BUILD DISPLAY NAME ASSET TYPE
										// =====================================
										if(input.Asset_Type != null)
										{
											input.Display_Name_Asset_Type = ifnull(input.Asset_Type.Asset_Type_Name,"");
										}
										else
										{
											input.Display_Name_Asset_Type = "";
										}
										// Back End fields hidden only on CREATE
										if(input.ID == null)
										{
											hide Back_End;
											hide User_Name;
											hide User_Email;
											hide User_Role;
											hide Created_By_Name;
											hide Created_By_Email;
											hide Created_By_Time;
											hide Updated_By_Name;
											hide Updated_By_Email;
											hide Updated_By_Time;
										}
										else
										{
											disable Current_Site;
											disable Current_Custodian;
											disable Notes;
											disable Serial_Number;
											disable Asset_Images;
											disable Date_Time_Odometer_Read;
											disable Odometer_Reading;
											disable Odometer_Unit_Of_Measure;
											disable Asset_Name;
											show Back_End;
											show User_Name;
											show User_Email;
											show User_Role;
											show Created_By_Name;
											show Created_By_Email;
											show Created_By_Time;
											show Updated_By_Name;
											show Updated_By_Email;
											show Updated_By_Time;
											disable User_Name;
											disable User_Email;
											disable User_Role;
											disable Created_By_Name;
											disable Created_By_Email;
											disable Created_By_Time;
											disable Updated_By_Name;
											disable Updated_By_Email;
											disable Updated_By_Time;
										}
										enable Current_Site;
										enable Current_Custodian;
						)
					}
				}

			}
			On_Asset_Name_Selected as "On Asset Name Selected"
			{
				type =  form
				form = Asset_List

				record event = on add or edit

				on user input of Asset_Name
				{
