			On_Voucher_Selected5 as "On Voucher Selected"
			{
				type =  form
				form = Machine_Start_of_Day

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											// Machine Start of Day -> On Voucher Selected
										if(input.Voucher == null)
										{
											input.Display_Name_Voucher = null;
											input.Display_Name_Voucher_Type = null;
											input.Display_Name_Site = null;
											input.Display_Name_Asset_Type = null;
											input.Display_Name_Employee = null;
											return;
										}
										// 1️⃣ Display Name Voucher
										if(input.Voucher.Voucher_Number != null)
										{
											input.Display_Name_Voucher = input.Voucher.Voucher_Number;
										}
										else
										{
											input.Display_Name_Voucher = input.Voucher.toString();
										}
										// 2️⃣ Voucher Type
										vType = input.Voucher.Voucher_Type;
										input.Display_Name_Voucher_Type = vType;
										// 3️⃣ Site (Auto from Voucher)
										input.Display_Name_Site = input.Voucher.Display_Name_Site;
										// 4️⃣ Employee (Auto from Voucher)
										if(input.Voucher.Display_Name_Employee != null)
										{
											input.Display_Name_Employee = input.Voucher.Display_Name_Employee;
										}
										else if(input.Voucher.Employee != null)
										{
											// fallback if display field not available
											input.Display_Name_Employee = input.Voucher.Employee.toString();
										}
										else
										{
											input.Display_Name_Employee = null;
										}
										// 5️⃣ Asset Type Logic (from your PDF rules)
										if(vType == "Tractor Work Report")
										{
											input.Display_Name_Asset_Type = "Tractors";
										}
										else if(vType == "Truck Movement Voucher")
										{
											input.Display_Name_Asset_Type = "Trucks";
										}
										else if(vType == "Drager Work Report")
										{
											input.Display_Name_Asset_Type = "Dragers";
										}
										else
										{
											input.Display_Name_Asset_Type = null;
										}
						)
					}
				}

			}
			Finalize9 as "Finalize"
			{
				type =  form
				form = Machine_Start_of_Day

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// MACHINE START OF DAY -> FINALIZE / ON SUBMIT
										// =====================================================
										now_ts = zoho.currenttime;
										// Detect CREATE vs EDIT
										is_create = false;
										if(input.Added_Time != null && input.Modified_Time != null)
										{
											if(input.Added_Time.toLong() == input.Modified_Time.toLong())
											{
												is_create = true;
											}
										}
										// Load linked Voucher
										v = null;
										if(input.Voucher != null)
										{
											v = Voucher[ID == input.Voucher.ID];
										}
										// =====================================================
										// ON CREATE
										// =====================================================
										if(is_create)
										{
											if(input.Time_Started == null)
											{
												input.Time_Started = now_ts;
											}
											if(isNull(input.Voucher_Status) || input.Voucher_Status == "")
											{
												input.Voucher_Status = "Open";
											}
											if(v != null)
											{
												if(input.Asset != null)
												{
													v.Asset=input.Asset.ID;
												}
												if(input.Odometer_Start != null)
												{
													v.Odometer_Start=input.Odometer_Start;
												}
												if(input.Fuel_Start_Level != null)
												{
													v.Fuel_Start_Level=input.Fuel_Start_Level;
												}
												if(input.Time_Started != null)
												{
													v.Start_Time=input.Time_Started;
												}
												// Link back to Machine Start of Day if field exists in Voucher
												v.Machine_Start_of_Day=input.ID;
											}
										}
										// =====================================================
										// ON EDIT
										// =====================================================
										else
										{
											if(v != null)
											{
												// Allow Asset to update on edit also
												if(input.Asset != null)
												{
													v.Asset=input.Asset.ID;
												}
												// Keep start values synced if edited
												if(input.Odometer_Start != null)
												{
													v.Odometer_Start=input.Odometer_Start;
												}
												if(input.Fuel_Start_Level != null)
												{
													v.Fuel_Start_Level=input.Fuel_Start_Level;
												}
												if(input.Time_Started != null)
												{
													v.Start_Time=input.Time_Started;
												}
											}
											// Close only when Odometer_End is entered
											if(input.Odometer_End != null)
											{
												if(input.Time_Ended == null)
												{
													input.Time_Ended = now_ts;
												}
												input.Voucher_Status = "Closed";
												if(v != null)
												{
													v.Odometer_End=input.Odometer_End;
													if(input.Fuel_End_Level != null)
													{
														v.Fuel_End_Level=input.Fuel_End_Level;
													}
													v.End_Time=input.Time_Ended;
												}
											}
										}
						)
					}
				}

			}
			Full_Validation16 as "Full Validation"
			{
				type =  form
				form = Machine_Start_of_Day

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Machine Start of Day -> Validations on form submission
										is_create = input.ID == null;
										errors = "";
										// ---------------------------------
										// PREVENT DUPLICATE VOUCHER (STRICT)
										// ---------------------------------
										if(input.Voucher != null)
										{
											existing = Machine_Start_of_Day[Voucher == input.Voucher && ID != input.ID];
											if(existing.count() > 0)
											{
												errors = errors + "\n• A Machine Start of Day record already exists for this Voucher.";
											}
										}
										// ---------- ON CREATE ----------
										if(is_create)
										{
											if(input.Voucher == null)
											{
												errors = errors + "\n• Voucher is required.";
											}
											if(input.Asset == null)
											{
												errors = errors + "\n• Asset is required.";
											}
											if(input.Odometer_Start == null)
											{
												errors = errors + "\n• Odometer Start is required.";
											}
											if(input.Odometer_Start_Image == null || input.Odometer_Start_Image.isEmpty())
											{
												errors = errors + "\n• Odometer Start Image is required.";
											}
										}
										// ---------- ON EDIT ----------
										else
										{
											if(input.Odometer_End == null)
											{
												errors = errors + "\n• Odometer End is required.";
											}
											if(input.Odometer_End_Image == null || input.Odometer_End_Image.isEmpty())
											{
												errors = errors + "\n• Odometer End Image is required.";
											}
											// ---------------------------------
											// ODOMETER VALIDATION
											// ---------------------------------
											if(input.Odometer_Start != null && input.Odometer_End != null)
											{
												if(input.Odometer_End < input.Odometer_Start)
												{
													errors = errors + "\n• Odometer End cannot be less than Odometer Start.";
												}
											}
										}
										// Block submit
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
