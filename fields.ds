										}
										// Truck Movement Voucher
										if(input.Voucher_Type == "Truck Movement Voucher")
										{
											show Voucher_Header;
											show Asset;
											show Machine_Start_of_Day;
											show Start_Time;
											show Odometer_Start;
											show Employee_Issuing_Details;
											show Truck_Movement_Details;
											show Voucher_Footer;
											show Voucher_Cost;
											show End_Time;
											show Odometer_End;
										}
						)
					}
				}

			}
			On_Digital_Voucher_Type_S as "On Digital Voucher Type Selected"
			{
				type =  form
				form = Voucher

				record event = on add or edit

				on user input of Digital_Voucher_Type
				{
					actions 
					{
						custom deluge script
						(
											// Run only for Digital Voucher path
										if(input.Document_Type != "Digital Voucher")
										{
											return;
										}
										// 1) Clear physical residue
										input.Physical_Voucher_Type = null;
										hide Physical_Voucher_Type;
										// 2) Set Voucher Type from Digital Voucher Type
										if(input.Digital_Voucher_Type != null)
										{
											input.Voucher_Type = input.Digital_Voucher_Type.Voucher_Type;
										}
										else
										{
											input.Voucher_Type = null;
										}
										// 3) Voucher Number auto / disabled
										disable Voucher_Number;
										// ========================================
										// RESET FIRST
										// ========================================
										show Issued_By;
										show Display_Name_Issued_By;
										show Received_By;
										show Display_Name_Received_By;
										hide Site;
										hide Display_Name_Site;
										hide Voucher_Header;
										hide Management_Location;
										hide Asset;
										hide Machine_Start_of_Day;
										hide Start_Time;
										hide Odometer_Start;
										hide Item;
										hide Display_Name_Item;
										hide Quantity_To_Be_Created;
										hide Fuel_Start_Level;
										hide Employee_Issuing_Details;
										hide Incident_Details;
										hide Visitor_Register_Details;
										hide Special_Tasks_Done;
										hide Parking_Controller_Details;
										hide Violation_Details;
										hide Tractor_Work_Details;
										hide Truck_Movement_Details;
										hide Drager_Work_Details;
										hide Kitchen_Employee_Details;
										hide Gate_Pass_Details;
										hide Truck_Measurement_Details;
										hide Item_Issuing_Details;
										hide Stock_Receiving_Details;
										hide Stock_Bundling_Note;
										hide Employee_Receiving_Details;
										hide Fuel_Receiving_Details;
										hide Meter_Readings;
										hide Voucher_Footer;
										hide Voucher_Cost;
										hide End_Time;
										hide Odometer_End;
										hide Fuel_End_Level;
										// ========================================
										// DOCUMENT TYPES
										// ========================================
										if(input.Voucher_Type == "Daily Cleaners Report")
										{
											show Voucher_Header;
											show Management_Location;
											show Employee_Issuing_Details;
											show Special_Tasks_Done;
											show Voucher_Cost;
										}
										if(input.Voucher_Type == "Occurency Report")
										{
											show Voucher_Header;
											show Management_Location;
											show Incident_Details;
										}
										if(input.Voucher_Type == "Occurency Report Phone")
										{
											show Voucher_Header;
											show Management_Location;
											show Incident_Details;
											show Visitor_Register_Details;
											show Gate_Pass_Details;
										}
										if(input.Voucher_Type == "Kitchen Voucher")
										{
											show Kitchen_Employee_Details;
										}
										if(input.Voucher_Type == "Supervisor Voucher")
										{
											hide Issued_By;
											hide Display_Name_Issued_By;
											hide Received_By;
											hide Display_Name_Received_By;
											show Site;
											enable Site;
											show Display_Name_Site;
											input.Voucher_Status = "Issued";
										}
										if(input.Voucher_Type == "Item Issuing Form")
										{
											show Item_Issuing_Details;
										}
										if(input.Voucher_Type == "Store Receiving Book")
										{
											show Stock_Receiving_Details;
										}
										if(input.Voucher_Type == "Stock Receiving Note")
										{
											show Voucher_Header;
											show Asset;
											show Item;
											show Quantity_To_Be_Created;
											enable Asset;
											enable Item;
											enable Quantity_To_Be_Created;
										}
										if(input.Voucher_Type == "Stock Bundling Note")
										{
											show Stock_Bundling_Note;
											show Stock_Bundling_Note.Line_Number;
											show Stock_Bundling_Note.Item;
											enable Stock_Bundling_Note.Item;
											show Stock_Bundling_Note.Quantity_To_Be_Created;
											enable Stock_Bundling_Note.Quantity_To_Be_Created;
											show Stock_Bundling_Note.Asset;
											enable Stock_Bundling_Note.Asset;
										}
						)
					}
				}

			}
			Finalize_On_Create as "Finalize On Create"
			{
				type =  form
				form = Voucher

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
										// Generate Voucher Number AFTER record is saved (ID exists)
										if(input.Document_Type == "Digital Voucher" && input.Voucher_Type != null && input.Voucher_Type.trim() != "")
										{
											vtype = input.Voucher_Type.trim();
											dk = Document_Key[Voucher_Type == vtype && Document_Type == "Digital Voucher" && Document__Status == "Active"];
											rec = Voucher[ID == input.ID];
											if(rec.ID != null)
											{
												if(dk.ID != null)
												{
													vno = thisapp.Generate_Voucher_Number(dk.ID);
													if(vno != null && vno != "" && vno != "LIMIT_REACHED")
													{
														rec.Voucher_Number=vno;
													}
													else
													{
														rec.Voucher_Number="GEN_FAIL";
													}
												}
												else
												{
													rec.Voucher_Number="NO_DOC_KEY";
												}
											}
										}
										if(input.Voucher_Type == "Stock Receiving Note")
										{
											itemDisplay = ifnull(input.Display_Name_Item,"").trim();
											if(itemDisplay == "" && input.Item != null)
											{
												itemName = ifnull(input.Item.Item_Name,"").trim();
												itemSKU = ifnull(input.Item.SKU,"").trim();
												if(itemName != "" && itemSKU != "")
												{
													itemDisplay = itemName + " - " + itemSKU;
												}
												else if(itemName != "")
												{
													itemDisplay = itemName;
												}
												else
												{
													itemDisplay = input.Item.toString();
												}
											}
											insert into Stock_Bundling_Note
											[
												Voucher=input.ID
												Display_Name_Voucher=input.Voucher_Number
												Item=input.Item
												Display_Name_Item=itemDisplay
												Quantity_To_Be_Created=input.Quantity_To_Be_Created
												Asset=input.Asset
												Stock_Status="Pending"
												Added_User=zoho.loginuser
											]
										}
						)
					}
				}

			}
			Finalize_On_Edit1 as "Finalize On Edit"
			{
				type =  form
				form = Voucher

				record event = on edit

