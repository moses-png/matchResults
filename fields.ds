	 			row = 5
	 			column = 1   
				width = medium
			)
			Back_End
			(
				type = section
				displayname = "Back End"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 6
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 6
	 			column = 1   
