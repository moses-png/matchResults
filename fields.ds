			Set_Up_Form18 as "Set Up Form"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// DRAGER WORK REPORT -> SET UP FORM
										// ========================================
										oldWorkDone = input.Work_Done;
										oldBatchFrom = input.Batch_Number_From;
										oldDisplayBatchFrom = input.Display_Name_Batch_Number_From;
										// ========================================
										// DISABLE FIELDS
										// ========================================
										disable Display_Name_Voucher;
										disable Display_Name_Employee;
										disable Display_Name_Site;
										disable Display_Name_Asset;
										disable Line_Number;
										disable Display_Name_Batch_Number_From;
										disable Work_Done;
										disable Display_Name_Batch_Number_To;
										disable Time_Start;
										disable Time_End;
										disable Reason_Why_Cancelled;
										disable Line_Duration_Minutes;
										disable Line_Hours_Worked;
										disable Drager_Work_Report_Status;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// ========================================
										// HIDE DEFAULT FIELDS
										// ========================================
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										hide Display_Name_Site;
										hide Display_Name_Asset;
										hide Line_Number;
										hide Display_Name_Batch_Number_From;
										hide Display_Name_Batch_Number_To;
										hide Display_Name_Job;
										hide Work_Order_Task;
										hide Batch_Number_From;
										hide Batch_Number_To;
										hide Truck_Movement_Voucher;
										hide Drager_Work_Report;
										hide Time_Start;
										hide Odometer_End;
										hide Time_End;
										hide Image_After;
										hide Cancel_Voucher;
										hide Reason_Why_Cancelled;
										hide Line_Summary;
										hide Cost_Per_Odometer;
										hide Total;
										hide Line_Duration_Minutes;
										hide Line_Hours_Worked;
										hide Drager_Work_Report_Status;
										hide Back_End;
										hide Display_Name_Location;
										// ========================================
										// CREATE MODE
										// ========================================
										if(input.ID == null)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											show Voucher;
											show Location;
											show Job;
											show Work_Done;
											show Image_Before;
											show Odometer_Start;
											hide Work_Order_Task;
											hide Batch_Number_From;
											hide Batch_Number_To;
											hide Truck_Movement_Voucher;
											hide Odometer_End;
											hide Time_Start;
											hide Time_End;
											hide Image_After;
											hide Cancel_Voucher;
											hide Reason_Why_Cancelled;
										}
										// ========================================
										// EDIT MODE
										// ========================================
										else
										{
											show Voucher;
											show Line_Number;
											show Location;
											show Job;
											show Work_Done;
											show Image_Before;
											show Odometer_Start;
											show Cancel_Voucher;
											show Drager_Work_Report_Status;
											disable Voucher;
											disable Location;
											disable Job;
											disable Odometer_Start;
											// ========================================
											// CANCELLED CHECKBOX
											// ========================================
											if(input.Cancel_Voucher == true)
											{
												show Reason_Why_Cancelled;
												enable Reason_Why_Cancelled;
											}
											else
											{
												hide Reason_Why_Cancelled;
												input.Reason_Why_Cancelled = null;
											}
											// ========================================
											// JOB-BASED SHOW / HIDE
											// ========================================
											hide Work_Order_Task;
											hide Batch_Number_From;
											hide Batch_Number_To;
											hide Truck_Movement_Voucher;
											if(input.Job != null)
											{
												jobNo = input.Job.Job_No;
												if(jobNo == "TJS01")
												{
													show Batch_Number_From;
													enable Batch_Number_From;
												}
												else if(jobNo == "TJS02")
												{
													show Work_Order_Task;
													enable Work_Order_Task;
												}
												else if(jobNo == "TJS03")
												{
													show Batch_Number_To;
													enable Batch_Number_To;
												}
												else if(jobNo == "TJS04")
												{
													show Truck_Movement_Voucher;
													enable Truck_Movement_Voucher;
												}
											}
											// RESTORE IMPORTANT VALUES
											if(input.Batch_Number_From == null && oldBatchFrom != null)
											{
												input.Batch_Number_From = oldBatchFrom;
											}
											if(ifnull(input.Display_Name_Batch_Number_From,"") == "" && ifnull(oldDisplayBatchFrom,"") != "")
											{
												input.Display_Name_Batch_Number_From = oldDisplayBatchFrom;
											}
											if(ifnull(input.Work_Done,"") == "" && ifnull(oldWorkDone,"") != "")
											{
												input.Work_Done = oldWorkDone;
											}
											// ========================================
											// STATUS: IN PROGRESS
											// ========================================
											if(input.Drager_Work_Report_Status == "In Progress")
											{
												show Work_Done;
												hide Image_Before;
												disable Image_Before;
												show Image_After;
												show Odometer_End;
												enable Image_After;
												enable Odometer_End;
											}
											// ========================================
											// STATUS: COMPLETED
											// ========================================
											else if(input.Drager_Work_Report_Status == "Completed")
											{
												show Work_Done;
												show Image_Before;
												show Image_After;
												show Odometer_End;
												show Time_Start;
												show Time_End;
												show Line_Duration_Minutes;
												show Line_Hours_Worked;
												show Cost_Per_Odometer;
												show Total;
												disable Voucher;
												disable Location;
												disable Job;
												disable Work_Done;
												disable Odometer_Start;
												disable Odometer_End;
												disable Work_Order_Task;
												disable Batch_Number_From;
												disable Batch_Number_To;
												disable Truck_Movement_Voucher;
												disable Time_Start;
												disable Time_End;
												disable Image_Before;
												disable Image_After;
												disable Cancel_Voucher;
											}
											// ========================================
											// STATUS: CANCELLED
											// ========================================
											else if(input.Drager_Work_Report_Status == "Cancelled")
											{
												show Reason_Why_Cancelled;
												disable Voucher;
												disable Location;
												disable Job;
												disable Work_Done;
												disable Odometer_Start;
												disable Odometer_End;
												disable Work_Order_Task;
												disable Batch_Number_From;
												disable Batch_Number_To;
												disable Truck_Movement_Voucher;
												disable Image_Before;
												disable Image_After;
												disable Time_Start;
												disable Time_End;
											}
											if(input.Batch_Number_From == null && oldBatchFrom != null)
											{
												input.Batch_Number_From = oldBatchFrom;
											}
											if(ifnull(input.Display_Name_Batch_Number_From,"") == "" && ifnull(oldDisplayBatchFrom,"") != "")
											{
												input.Display_Name_Batch_Number_From = oldDisplayBatchFrom;
											}
											if(ifnull(input.Work_Done,"") == "" && ifnull(oldWorkDone,"") != "")
											{
												input.Work_Done = oldWorkDone;
											}
										}
						)
					}
				}

			}
			On_Batch_Number_From_Sele as "On Batch Number From Selected"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on user input of Batch_Number_From
				{
					actions 
					{
						custom deluge script
						(
											batchFrom = "";
										batchTo = "";
										locationName = "";
										if(input.Batch_Number_From != null)
										{
											batchFrom = ifnull(input.Batch_Number_From.Batch_Number,"");
											input.Display_Name_Batch_Number_From = batchFrom;
										}
										else
										{
											input.Display_Name_Batch_Number_From = "";
										}
										if(input.Batch_Number_To != null)
										{
											batchTo = ifnull(input.Batch_Number_To.Batch_Number,"");
											input.Display_Name_Batch_Number_To = batchTo;
										}
										else
										{
											input.Display_Name_Batch_Number_To = "";
										}
										if(input.Location != null)
										{
											locationName = ifnull(input.Location.Location_Name,"");
										}
										if(batchFrom != "" && batchTo != "")
										{
											if(locationName != "")
											{
												input.Work_Done = "Extracted material from " + batchFrom + " at " + locationName + " and moved to " + batchTo;
											}
											else
											{
												input.Work_Done = "Extracted material from " + batchFrom + " and moved to " + batchTo;
											}
										}
										else if(batchFrom != "")
										{
											if(locationName != "")
											{
												input.Work_Done = "Extracted material from " + batchFrom + " at " + locationName;
											}
											else
											{
												input.Work_Done = "Extracted material from " + batchFrom;
											}
										}
										else if(batchTo != "")
										{
											input.Work_Done = "Material moved to " + batchTo;
										}
										else
										{
											input.Work_Done = "";
										}
						)
					}
				}

			}
