				 map deleteMileageLogFromMeterReading(map asset_payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	resp.put("action","none");
                 	resp.put("deleted_count",0);
                 	// ======================================
                 	// VALIDATE PAYLOAD
                 	// ======================================
                 	if(asset_payload == null)
                 	{
                 		resp.put("message","Asset payload is required.");
                 		return resp;
                 	}
                 	source_form_value = asset_payload.get("Odometer_Source_Form");
                 	source_id_value = asset_payload.get("Source_Record_ID");
                 	if(source_form_value == null || source_id_value == null)
                 	{
                 		resp.put("message","Odometer Source Form and Source Record ID are required.");
                 		return resp;
                 	}
                 	source_form = source_form_value.toString().trim();
                 	source_id = source_id_value.toString().trim();
                 	if(source_form == "" || source_id == "")
                 	{
                 		resp.put("message","Odometer Source Form and Source Record ID cannot be empty.");
                 		return resp;
                 	}
                 	// ======================================
                 	// FIND MATCHING MILEAGE LOGS
                 	// ======================================
                 	existingLogs = Asset_Mileage_Log[Odometer_Source_Form == source_form && Source_Record_ID == source_id];
                 	deleted_count = existingLogs.count();
                 	if(deleted_count == 0)
                 	{
                 		resp.put("ok",true);
                 		resp.put("message","No matching mileage log was found.");
                 		resp.put("action","not_found");
                 		return resp;
                 	}
                 	// ======================================
                 	// DELETE MATCHING LOGS
                 	// ======================================
                 	delete from Asset_Mileage_Log[Odometer_Source_Form == source_form && Source_Record_ID == source_id];
                 	// ======================================
                 	// VERIFY DELETION
                 	// ======================================
                 	remainingLogs = Asset_Mileage_Log[Odometer_Source_Form == source_form && Source_Record_ID == source_id];
                 	if(remainingLogs.count() == 0)
                 	{
                 		resp.put("ok",true);
                 		resp.put("message","Mileage log deleted successfully.");
                 		resp.put("action","deleted");
                 		resp.put("deleted_count",deleted_count);
                 	}
                 	else
                 	{
                 		resp.put("message","Some mileage logs could not be deleted.");
                 		resp.put("deleted_count",deleted_count - remainingLogs.count());
                 	}
                 	return resp;
                 }
				 map deletePartsConsumablesFromStore(MAP payload)
                 {
                 	resp = Map();
                 	src_id = payload.get("Source_Record_ID");
                 	if(src_id != null)
                 	{
                 		delete from Parts_Consumables[Source_Record_ID == src_id];
                 	}
                 	resp.put("status","success");
                 	resp.put("message","Related Parts Consumables deleted.");
                 	return resp;
                 }
				 map deleteWorkOrderFromConcreteProducts(map input)
                 {
                 	resp = Map();
                 	resp.put("success",false);
                 	resp.put("message","Started");
                 	source_id = input.get("Source_Record_ID");
                 	source_form = ifnull(input.get("Source_Form"),"").trim();
                 	if(source_id == null)
                 	{
                 		resp.put("message","Source_Record_ID is missing");
                 		return resp;
                 	}
                 	if(source_form == "")
                 	{
                 		source_form = "Concrete Products - Work Order";
                 	}
                 	wo_rec = Work_Order[Source_Record_ID == source_id && Source_Form == source_form];
                 	if(wo_rec.ID != null)
                 	{
                 		delete from Work_Order[ID == wo_rec.ID];
                 		resp.put("success",true);
                 		resp.put("message","Deleted synced Work Order");
                 		resp.put("Deleted_Work_Order_ID",wo_rec.ID);
                 	}
                 	else
                 	{
                 		resp.put("success",true);
                 		resp.put("message","No synced Work Order found");
                 	}
                 	return resp;
                 }
