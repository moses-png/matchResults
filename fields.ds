											input.Site_From = input.Batch_Number_From.Site;
											input.Display_Name_Site_From = ifnull(input.Batch_Number_From.Display_Name_Site,"");
											input.Work_Done = ifnull(input.Batch_Number_From.Materials_Produced,"");
											input.Pick_Up_From = ifnull(input.Display_Name_Site_From,"");
											Deliver_To = ifnull(input.Display_Name_Site_To,"");
										}
										else
										{
											input.Site_From = null;
											input.Display_Name_Site_From = "";
											input.Pick_Up_From = "";
											input.Work_Done = "";
											Deliver_To = ifnull(input.Display_Name_Site_To,"");
										}
						)
					}
				}

			}
