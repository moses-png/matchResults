											// Default mode
											row.Convert=false;
											row.Conversion_Factor=1;
											row.Unit_Of_Measure_Conversion=null;
											// Clear calculated fields
											row.Quantity_in_Base_Unit=null;
											row.Rate_in_Base_Unit=null;
											row.Line_Total=null;
											// Optional: clear manual entry fields too for a brand-new row
											// row.Quantity = null;
											// row.Rate = null;
											// Hide conversion/helper fields
											hide row.Unit_Of_Measure_Conversion;
											hide row.Conversion_Factor;
											hide row.Quantity_in_Base_Unit;
											hide row.Rate_in_Base_Unit;
										}
										// ===============================
										// RECALCULATE PARENT TOTALS
										// ===============================
										sand_total = ifnull(input.Rate_per_CBM,0) * ifnull(input.Truck_CBM,0);
										item_total = 0;
										for each  r in input.Item_Sales
										{
											item_total = item_total + ifnull(r.Line_Total,0);
										}
										input.Amount_Supposed_To_Pay_Sand_Sales = round(sand_total,2);
										input.Amount_Supposed_To_Pay_Item_Sales = round(item_total,2);
										input.Amount_Supposed_To_Pay = round(sand_total + item_total / 10000,2);
						)
					}
				}

			}
