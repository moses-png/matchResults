			On_Odometer_Start_Selecte1 as "On Odometer Start Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Odometer_Start
				{
					actions 
					{
						custom deluge script
						(
											if(input.Odometer_Start != null)
										{
											// If End not yet entered, reset distance
											if(input.Odometer_End == null)
											{
												input.Line_Distance_Travelled = 0;
											}
											else
											{
												distance = input.Odometer_End - input.Odometer_Start;
												if(distance < 0)
												{
													alert "Odometer End cannot be less than Odometer Start";
													input.Odometer_Start = null;
													input.Line_Distance_Travelled = null;
												}
												else
												{
													input.Line_Distance_Travelled = distance;
												}
											}
										}
										else
										{
											input.Line_Distance_Travelled = null;
										}
						)
					}
				}

			}
			On_Odometer_End_Selected1 as "On Odometer End Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Odometer_End
				{
					actions 
					{
						custom deluge script
						(
											if(input.Odometer_End != null)
										{
											if(input.Odometer_Start != null)
											{
												distance = input.Odometer_End - input.Odometer_Start;
												if(distance < 0)
												{
													alert "Odometer End cannot be less than Odometer Start";
													input.Odometer_End = null;
													input.Line_Distance_Travelled = null;
													input.Total_Cost = null;
												}
												else
												{
													// Distance
													input.Line_Distance_Travelled = distance;
													// Cost Calculation (if rate exists)
													if(input.Cost_Per_Odometer != null)
													{
														input.Total_Cost = distance * input.Cost_Per_Odometer;
													}
													else
													{
														input.Total_Cost = null;
													}
												}
											}
											else
											{
												alert "Please enter Odometer Start first";
												input.Odometer_End = null;
											}
										}
										else
										{
											input.Line_Distance_Travelled = null;
											input.Total_Cost = null;
										}
						)
					}
				}

			}
			On_Time_Start_Selected1 as "On Time Start Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Time_Start
				{
					actions 
					{
						custom deluge script
						(
											if(input.Time_Start != null)
										{
											// If End not yet set → reset duration
											if(input.Time_End == null)
											{
												input.Line_Duration_Minutes = 0;
											}
											else
											{
												// Calculate duration in minutes
												duration = ((input.Time_End - input.Time_Start)) / (1000 * 60);
												if(duration < 0)
												{
													alert "Time End cannot be before Time Start";
													input.Time_Start = null;
													input.Line_Duration_Minutes = null;
												}
												else
												{
													input.Line_Duration_Minutes = duration;
												}
											}
										}
										else
										{
											input.Line_Duration_Minutes = null;
										}
						)
					}
				}

			}
			On_Time_End_Selected1 as "On Time End Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Time_End
				{
					actions 
					{
						custom deluge script
						(
											if(input.Time_End != null)
										{
											if(input.Time_Start != null)
											{
												duration_ms = (input.Time_End - input.Time_Start);
												duration_min = duration_ms / (1000 * 60);
												if(duration_min < 0)
												{
													alert "Time End cannot be before Time Start";
													input.Time_End = null;
													input.Line_Duration_Minutes = null;
												}
												else
												{
													input.Line_Duration_Minutes = duration_min;
												}
											}
											else
											{
												alert "Please enter Time Start first";
												input.Time_End = null;
												input.Line_Duration_Minutes = null;
											}
										}
										else
										{
											input.Line_Duration_Minutes = null;
										}
						)
					}
				}

			}
			Finalize10 as "Finalize"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// TRUCK MOVEMENT VOUCHER - FINALIZE
										// Created or Edited
										// ======================================
										info "===== TRUCK MOVEMENT VOUCHER FINALIZE START =====";
										is_create = false;
										if(input.Added_Time != null && input.Modified_Time != null)
										{
											if(input.Added_Time.toLong() == input.Modified_Time.toLong())
											{
												is_create = true;
											}
										}
										// =======================
										// CANCELLED
										// =======================
										if(input.Cancelled == true)
										{
											input.Truck_Movement_Voucher_Status = "Cancelled";
											input.Line_Duration_Minutes = 0;
											input.Line_Distance_Travelled = 0;
											input.Total_Cost = 0;
											if(input.Card != null)
											{
												cardRec = Sales_Voucher[ID == input.Card];
												if(cardRec.ID != null)
												{
													cardRec.Company_Truck_Stage="Draft";
												}
											}
											info "Record cancelled.";
											info "===== TRUCK MOVEMENT VOUCHER FINALIZE END =====";
											return;
										}
										// =======================
										// CREATE
										// =======================
										if(is_create)
										{
											if(input.Time_Start == null)
											{
												input.Time_Start = zoho.currenttime;
											}
											input.Truck_Movement_Voucher_Status = "In Progress";
											if(input.Card != null)
											{
												cardRec = Sales_Voucher[ID == input.Card];
												if(cardRec.ID != null)
												{
													cardRec.Company_Truck_Stage="Picked Up";
												}
											}
											if(input.Job != null && input.Job.Job_No == "TJS03")
											{
												if(input.Tractor_Work_Report != null)
												{
													twrCreate = Tractor_Work_Report[ID == input.Tractor_Work_Report];
													if(twrCreate.ID != null)
													{
														if(twrCreate.Tractor_Work_Report_Status == "Loaded")
														{
															twrCreate.Tractor_Work_Report_Status="Completed";
														}
														if(twrCreate.Batch_Number != null)
														{
															sourceID = input.ID;
															sourceForm = "Employee Management - Truck Movement Voucher - Create TJS03 OUT";
															existingBatchStock = Batch_Stock[Source_Record_ID == sourceID && Source_Form == sourceForm];
															if(existingBatchStock.count() == 0)
															{
																qtyOutCreate = 0.0;
																truckPlateText = ifnull(input.Number_Plate_Truck_Register,"").trim();
																if(truckPlateText != "")
																{
																	tmList = Truck_Measurement[Display_Name_Number_Plate == truckPlateText && Measurement_Status == "Active"] sort by Time_Confirmed desc;
																	for each  tm in tmList
																	{
																		qtyOutCreate = 0 - ifnull(tm.Truck_Size_2,0.0);
																		break;
																	}
																}
																if(qtyOutCreate == 0 && truckPlateText != "")
																{
																	tmList2 = Truck_Measurement[Display_Name_Number_Plate == truckPlateText] sort by Time_Confirmed desc;
																	for each  tm2 in tmList2
																	{
																		qtyOutCreate = 0 - ifnull(tm2.Truck_Size_2,0.0);
																		break;
																	}
																}
																if(qtyOutCreate == 0 && input.Card != null)
																{
																	qtyOutCreate = 0 - ifnull(input.Card.Truck_CBM,0.0);
																}
																lastLineCreate = Batch_Stock[Batch_Number == twrCreate.Batch_Number] sort by Line_Number desc;
																nextLineCreate = 1;
																currentBalanceCreate = 0.0;
																for each  lCreate in lastLineCreate
																{
																	nextLineCreate = ifnull(lCreate.Line_Number,0) + 1;
																	currentBalanceCreate = ifnull(lCreate.Running_Balance,0.0);
																	break;
																}
																newBalanceCreate = currentBalanceCreate + qtyOutCreate;
																insert into Batch_Stock
																[
																	Batch_Number=twrCreate.Batch_Number
																	Display_Name_Batch_Number=twrCreate.Batch_Number.Batch_Number
																	Line_Number=nextLineCreate
																	Batch_Time=zoho.currenttime
																	Batch_Type="Out"
																	Reference="Truck Movement Create OUT - " + ifnull(input.Display_Name_Voucher,"")
																	Quantity=qtyOutCreate
																	Running_Balance=newBalanceCreate
																	Source_Record_ID=sourceID
																	Source_Form=sourceForm
																	Added_User=zoho.loginuser
																]
															}
														}
													}
												}
											}
											info "CREATE MODE: Time_Start set and status In Progress.";
										}
										else
										{
											// =======================
											// EDIT CALCULATIONS ONLY
											// NO BATCH STOCK CREATION ON EDIT
											// =======================
											if(input.Time_End == null)
											{
												input.Time_End = zoho.currenttime;
											}
											if(input.Time_Start != null && input.Time_End != null)
											{
												diffMillis = input.Time_End.toLong() - input.Time_Start.toLong();
												duration_min = diffMillis / (1000 * 60);
												if(duration_min < 0)
												{
													duration_min = 0;
												}
												input.Line_Duration_Minutes = duration_min;
											}
											else
											{
												input.Line_Duration_Minutes = 0;
											}
											if(input.Odometer_Start != null && input.Odometer_End != null)
											{
												distance = input.Odometer_End - input.Odometer_Start;
												if(distance < 0)
												{
													distance = 0;
												}
												input.Line_Distance_Travelled = distance;
											}
											else
											{
												input.Line_Distance_Travelled = 0;
											}
											input.Total_Cost = ifnull(input.Line_Distance_Travelled,0.0) * ifnull(input.Cost_Per_Odometer,0.0);
											// Complete linked Tractor Work Report only
											if(input.Job != null && input.Job.Job_No == "TJS03")
											{
												if(input.Tractor_Work_Report != null)
												{
													twr = Tractor_Work_Report[ID == input.Tractor_Work_Report];
													if(twr.ID != null)
													{
														if(twr.Tractor_Work_Report_Status == "Loaded")
														{
															twr.Tractor_Work_Report_Status="Completed";
														}
													}
												}
											}
											// =======================
											// STATUS CONTROL BY JOB
											// TJS03: In Progress -> Delivered on Edit
											// =======================
											if(input.Job != null && input.Job.Job_No == "TJS03" && input.Truck_Movement_Voucher_Status == "In Progress")
											{
												input.Truck_Movement_Voucher_Status = "Delivered";
												info "EDIT MODE: TJS03 moved from In Progress to Delivered.";
											}
											else if(input.Job != null && input.Job.Job_No == "TJS04")
											{
												input.Truck_Movement_Voucher_Status = "Completed";
												if(input.Truck_Movement_Voucher != null)
												{
													oldMove = Truck_Movement_Voucher[ID == input.Truck_Movement_Voucher];
													if(oldMove.ID != null)
													{
														if(oldMove.Truck_Movement_Voucher_Status == "Delivered")
														{
															oldMove.Truck_Movement_Voucher_Status="Completed";
														}
													}
												}
											}
											else
											{
												if(input.Party_To != null || input.Party_Location_To != null)
												{
													input.Truck_Movement_Voucher_Status = "Delivered";
												}
												else
												{
													input.Truck_Movement_Voucher_Status = "Completed";
												}
											}
											if(input.Card != null)
											{
												cardRec = Sales_Voucher[ID == input.Card];
												if(cardRec.ID != null)
												{
													if(input.Truck_Movement_Voucher_Status == "Delivered" || input.Truck_Movement_Voucher_Status == "Completed")
													{
														cardRec.Company_Truck_Stage="Delivered";
													}
												}
											}
										}
										// =====================================
										// SYNC TO ASSET MANAGEMENT
										// Only when status is Completed
										// Only for Job = TJS02
										// =====================================
										if(input.Truck_Movement_Voucher_Status == "Completed")
										{
											if(input.Job != null)
											{
												jobNo = ifnull(input.Job.Job_No,"").trim();
												if(jobNo == "TJS02")
												{
													if(input.Work_Order_Task != null)
													{
														payload = Map();
														payload.put("Work_Order_Task_ID",input.Work_Order_Task.ID);
														payload.put("Work_Order_Task_Number",ifnull(input.Work_Order_Task.Work_Order_Task_Number,""));
														payload.put("Display_Name_Work_Order_Task_Number",ifnull(input.Work_Order_Task.Work_Order_Task_Number,""));
														payload.put("Display_Name_Item_Labour","Truck Movement");
														payload.put("Display_Name_Asset",ifnull(input.Display_Name_Asset,""));
														payload.put("Odometer_Start",ifnull(input.Odometer_Start,0.0));
														payload.put("Odometer_End",ifnull(input.Odometer_End,0.0));
														payload.put("Quantity",ifnull(input.Line_Distance_Travelled,0.0));
														payload.put("Unit_Cost",ifnull(input.Cost_Per_Odometer,0.0));
														payload.put("Line_Total",ifnull(input.Total_Cost,0.0));
														desc = ifnull(input.Display_Name_Asset,"") + " moved from " + ifnull(input.Pick_Up_From,"") + " to " + ifnull(input.Delivery_To,"") + ". Odometer started " + ifnull(input.Odometer_Start,0.0).toString() + " and ended at " + ifnull(input.Odometer_End,0.0).toString();
														payload.put("Description",desc);
														payload.put("Source_Record_ID",input.ID.toString());
														payload.put("Source_Form","Employee Management - Truck Movement Voucher");
														resp = asset_management.syncPartsConsumablesFromTruckMovementVoucher(payload);
														info "Response: " + resp.toString();
													}
												}
											}
										}
										info "===== TRUCK MOVEMENT VOUCHER FINALIZE END =====";
						)
					}
				}

			}
			On_Party_To_Selected as "On Party To Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

