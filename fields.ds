			On_Amount_Paid_Selected1 as "On Amount Paid Selected"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on user input of Amount_Paid
				{
					actions 
					{
						custom deluge script
						(
											if(input.Amount_Paid == null)
										{
											input.Amount_Paid = 0;
										}
										if(input.Amount_Paid > input.Amount_Not_Allocated)
										{
											alert "Amount Paid cannot be greater than Amount Not Allocated.";
											input.Amount_Paid = 0;
											return;
										}
										input.Amount_Allocated = input.Amount_Paid;
										input.Balance_Due = input.Amount_Due - input.Amount_Paid;
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0;
										}
						)
					}
				}

			}
			On_Bill_Selected2 as "On Bill Selected"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on user input of Bill
				{
					actions 
					{
						custom deluge script
						(
											if(input.Bill != null)
										{
											input.Display_Name_Bill = input.Bill.Display_Name_Vendor;
											input.Amount_Due = ifnull(input.Bill.Balance_Due,0);
											input.Amount_Allocated = 0;
											input.Amount_Paid = 0;
											input.Balance_Due = ifnull(input.Bill.Balance_Due,0);
										}
										else
										{
											input.Display_Name_Bill = "";
											input.Amount_Due = 0;
											input.Amount_Allocated = 0;
											input.Amount_Paid = 0;
											input.Balance_Due = 0;
										}
						)
					}
				}

			}
			On_Payment_Made_Voucher_S as "On Payment Made Voucher Selected"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on user input of Payment_Made_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Payment_Made_Voucher != null)
										{
											input.Display_Name_Payment_Made_Voucher = input.Payment_Made_Voucher.Payment_Made_Number;
											input.Display_Name_Vendor = input.Payment_Made_Voucher.Display_Name_Vendor;
											// Pull amount not allocated
											input.Amount_Not_Allocated = ifnull(input.Payment_Made_Voucher.Total_Amount_Not_Allocated,0);
											// Line number
											line_no = 1;
											rows = Payment_Made_Details[Payment_Made_Voucher == input.Payment_Made_Voucher];
											if(rows.count() > 0)
											{
												line_no = rows.count() + 1;
											}
											input.Line_Number = line_no;
										}
										else
										{
											input.Display_Name_Payment_Made_Voucher = "";
											input.Display_Name_Vendor = "";
											input.Amount_Not_Allocated = 0;
											input.Line_Number = null;
										}
						)
					}
				}

			}
			Finalize7 as "Finalize"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// PAYMENT MADE DETAILS — FINALIZE
										// ======================================================
										if(input.Payment_Made_Voucher != null)
										{
											rec = Payment_Made_Voucher[ID == input.Payment_Made_Voucher.ID];
											if(rec.ID != null)
											{
												input.Amount_Allocated = ifnull(input.Amount_Paid,0.0);
												// Update Bill
												if(input.Bill != null)
												{
													bill_rec = Bill[ID == input.Bill.ID];
													if(bill_rec.ID != null)
													{
														total_paid_for_bill = 0.0;
														for each  pmv in Payment_Made_Voucher[ID != null]
														{
															for each  row2 in pmv.Made_Details
															{
																if(row2.Bill != null && row2.Bill.ID == bill_rec.ID)
																{
																	total_paid_for_bill = total_paid_for_bill + ifnull(row2.Amount_Paid,0.0);
																}
															}
														}
														original_bill_amount = ifnull(bill_rec.Total_Amount,0.0);
														new_due = original_bill_amount - total_paid_for_bill;
														if(new_due < 0)
														{
															new_due = 0.0;
														}
														bill_rec.Amount_Paid=total_paid_for_bill;
														bill_rec.Amount_Due=new_due;
														bill_rec.Balance_Due=new_due;
														if(new_due <= 0)
														{
															bill_rec.Payment_Status="Paid";
														}
														else if(total_paid_for_bill > 0)
														{
															bill_rec.Payment_Status="Partially Paid";
														}
														else
														{
															bill_rec.Payment_Status="Unpaid";
														}
													}
												}
												total_charges = 0.0;
												for each  ch in rec.Charge_Details
												{
													total_charges = total_charges + ifnull(ch.Amount,0.0);
												}
												total_allocated = 0.0;
												for each  det in rec.Made_Details
												{
													total_allocated = total_allocated + ifnull(det.Amount_Paid,0.0);
												}
												rec.Total_Charges=total_charges;
												rec.Total_Amount_Allocated=total_allocated;
												rec.Total_Amount_Not_Allocated=ifnull(rec.Total_Amount_Paid,0.0) - total_charges - total_allocated;
												if(rec.Total_Amount_Not_Allocated < 0)
												{
													rec.Total_Amount_Not_Allocated=0.0;
												}
												if(total_allocated == 0)
												{
													rec.Payment_Made_Voucher_Status="Unassigned";
												}
												else if(rec.Total_Amount_Not_Allocated > 0)
												{
													rec.Payment_Made_Voucher_Status="Partially Assigned";
												}
												else
												{
													rec.Payment_Made_Voucher_Status="Fully Assigned";
												}
												if(input.ID != null && input.Payment_Type == "Cash")
												{
													description = "";
													doc_name = "";
													if(ifnull(input.Display_Name_Bill,"") != "")
													{
														doc_name = input.Display_Name_Bill;
														if(doc_name.contains(" - "))
														{
															doc_name = doc_name.getPrefix(" - ");
														}
													}
													if(ifnull(input.Payment_Document,"") != "")
													{
														description = input.Payment_Document;
													}
													if(doc_name != "")
													{
														if(description != "")
														{
															description = description + " - ";
														}
														description = description + doc_name;
													}
													transaction_date_txt = "";
													if(rec.Payment_Made_Date != null)
													{
														transaction_date_txt = rec.Payment_Made_Date.toString("dd-MMM-yyyy");
													}
													created_time_txt = "";
													if(input.Created_By_Time != null)
													{
														created_time_txt = input.Created_By_Time.toString("dd-MMM-yyyy HH:mm:ss");
													}
													updated_time_txt = "";
													if(input.Updated_By_Time != null)
													{
														updated_time_txt = input.Updated_By_Time.toString("dd-MMM-yyyy HH:mm:ss");
													}
													payload = Map();
													payload.put("Payment_Voucher_Source_ID",rec.ID.toLong());
													payload.put("Display_Name_Payment_Voucher",ifnull(input.Display_Name_Payment_Made_Voucher,""));
													payload.put("Line_Number",input.Line_Number);
													payload.put("Description",description);
													payload.put("Amount_Allocated",ifnull(input.Amount_Allocated,0.0));
													payload.put("Application","Kicks Klean Ug");
													payload.put("Transaction_Date",transaction_date_txt);
													payload.put("Source_Form","Payment Made Details");
													payload.put("Source_Record_ID",input.ID.toLong());
													payload.put("Voucher_Number",ifnull(rec.Payment_Made_Number,""));
													payload.put("User_Name",ifnull(input.User_Name,""));
													payload.put("User_Email",ifnull(input.User_Email,""));
													payload.put("User_Role",ifnull(input.User_Role,""));
													payload.put("Created_By_Name",ifnull(input.Created_By_Name,""));
													payload.put("Created_By_Email",ifnull(input.Created_By_Email,""));
													payload.put("Created_By_Time",created_time_txt);
													payload.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
													payload.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
													payload.put("Updated_By_Time",updated_time_txt);
													sync_resp = md_payment_management.syncPaymentMadeDetailsFromKicksklean2(payload);
													info sync_resp;
													//md_payment_management.refreshAccountTransactionLog();
												}
											}
										}
										// ==========================================
										// UPDATE PURCHASE ORDER AFTER PAYMENT CHANGE
										// ==========================================
										if(input.Bill != null)
										{
											bill_id = input.Bill.ID;
											po_ids = List();
											bill_detail_rows = Bill_Details[Bill == bill_id];
											for each  bd in bill_detail_rows
											{
												if(bd.Item != null)
												{
													po_det = Purchase_Order_Details[ID == bd.Item.ID];
													if(po_det.ID != null && po_det.Purchase_Order != null)
													{
														po_id = po_det.Purchase_Order.ID;
														if(!po_ids.contains(po_id))
														{
															po_ids.add(po_id);
														}
													}
												}
											}
											for each  po_id in po_ids
											{
												thisapp.po.update_po_receiving_status(po_id);
											}
										}
										po = Purchase_Order[ID == po_id];
										if(po.ID != null)
										{
											store_payment_resp = store_management.po.update_po_bill_status_from_masaka_site_management(po.PO_Number,po.PO_Date,po.Display_Name_Employee_Voucher,ifnull(po.PO_Billed_Total,0.0),ifnull(po.PO_Total_Paid,0.0));
											info store_payment_resp;
										}
						)
					}
				}

			}
			Finalize_On_Delete6 as "Finalize On Delete"
			{
				type =  form
				form = Payment_Made_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PAYMENT MADE DETAILS FINALIZE ON DELETE
										// =====================================================
										delete_payload = Map();
										delete_payload.put("Source_Record_ID",input.ID);
										delete_payload.put("Source_Form","Payment Made Details");
										delete_resp = md_payment_management.deletePaymentMadeDetailsFromKicksklean(delete_payload);
										info delete_resp;
										// ======================================================
										// PAYMENT MADE DETAILS — ON DELETE
										// ======================================================
										if(input.Payment_Made_Voucher != null)
										{
											pmv = Payment_Made_Voucher[ID == input.Payment_Made_Voucher];
											if(pmv.ID != null)
											{
												for each  old_row in pmv.Made_Details
												{
													if(old_row.ID == input.ID)
													{
														if(old_row.Bill != null)
														{
															deleted_bill_id = old_row.Bill.ID;
														}
														break;
													}
												}
												total_paid = ifnull(pmv.Total_Amount_Paid,0.0);
												total_charges = ifnull(pmv.Total_Charges,0.0);
												detail_allocated = 0.0;
												for each  det in Payment_Made_Details[Payment_Made_Voucher == pmv.ID && ID != input.ID]
												{
													detail_allocated = detail_allocated + ifnull(det.Amount_Allocated,0.0);
												}
												amount_allocated = total_charges + detail_allocated;
												balance = total_paid - amount_allocated;
												if(balance < 0)
												{
													balance = 0.0;
												}
												pmv.Total_Amount_Allocated=amount_allocated;
												pmv.Total_Amount_Not_Allocated=balance;
												if(balance <= 0 && amount_allocated > 0)
												{
													pmv.Payment_Made_Voucher_Status="Assigned";
												}
												else if(amount_allocated > 0)
												{
													pmv.Payment_Made_Voucher_Status="Partially Assigned";
												}
												else
												{
													pmv.Payment_Made_Voucher_Status="Unassigned";
												}
											}
										}
										if(deleted_bill_id != null)
										{
											bill_rec = Bill[ID == deleted_bill_id];
											if(bill_rec.ID != null)
											{
												total_paid_for_bill = 0.0;
												for each  pmv2 in Payment_Made_Voucher[ID != null]
												{
													for each  det2 in pmv2.Made_Details
													{
														if(det2.ID != input.ID && det2.Bill != null)
														{
															if(det2.Bill.ID == deleted_bill_id)
															{
																total_paid_for_bill = total_paid_for_bill + ifnull(det2.Amount_Paid,0.0);
															}
														}
													}
												}
												original_bill_amount = ifnull(bill_rec.Total_Amount,0.0);
												new_due = original_bill_amount - total_paid_for_bill;
												if(new_due < 0)
												{
													new_due = 0.0;
												}
												bill_rec.Amount_Paid=total_paid_for_bill;
												bill_rec.Amount_Due=new_due;
												bill_rec.Balance_Due=new_due;
												if(total_paid_for_bill <= 0)
												{
													bill_rec.Payment_Status="Not Paid";
												}
												else if(new_due <= 0)
												{
													bill_rec.Payment_Status="Paid";
												}
												else
												{
													bill_rec.Payment_Status="Partially Paid";
												}
											}
										}
						)
					}
				}

			}
			On_Unit_Of_Measure_Select3 as "On Unit Of Measure Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Parts_Consumables.Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											row.Line_Total=thisapp.asset_calc.asset_calc_line_total(row.Quantity,row.Unit_Cost);
										if(input.ID != null)
										{
											rec = Work_Order_Tasks[ID == input.ID];
											if(rec.count() > 0)
											{
												parts_rows = List();
												for each  r in rec.Parts_Consumables
												{
													m = Map();
													m.put("Item",r.Item);
													m.put("Labour",r.Labour);
													m.put("Quantity",r.Quantity);
													m.put("Unit Cost",r.Unit_Cost);
													parts_rows.add(m);
												}
												parts_total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
												labour_total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
												grand_total = thisapp.asset_calc.asset_calc_grand_total(parts_total,labour_total);
												rec.Parts_Total=parts_total;
												rec.Labour_Total=labour_total;
												rec.Grand_Total=grand_total;
											}
										}
						)
					}
				}

			}
