		 functions
		 {
			 Deluge
			 {
				 map backfillMasakaAccountBalances()
                 {
                 	resp = Map();
                 	processed_accounts = 0;
                 	processed_logs = 0;
                 	account_found = false;
                 	// Find one Masaka transaction whose balances are still empty
                 	pending_logs = Account_Transaction_Log[Application == "Masaka Site Management" && Balance_After == null] sort by Transaction_Date asc range from 0 to 0;
                 	for each  pending_log in pending_logs
                 	{
                 		if(pending_log.Account != null)
                 		{
                 			account_found = true;
                 			acc_id = pending_log.Account.ID;
                 			acc = Account[ID == acc_id];
                 			if(acc.ID != null)
                 			{
                 				running_balance = 0.0;
                 				total_debit = 0.0;
                 				total_credit = 0.0;
                 				/*
                 					Refresh every transaction for this account.
                 
                 					Do not filter this inner query by Application because
                 					the account balance must include all its transactions.
                 				*/
                 				logs = Account_Transaction_Log[Account == acc_id] sort by Transaction_Date asc;
                 				for each  log in logs
                 				{
                 					amount = ifnull(log.Amount,0.0);
                 					reference_type = ifnull(log.Reference_Type,"").trim();
                 					transaction_type = ifnull(log.Transaction_Type,"").trim();
                 					log.Balance_Before=running_balance;
                 					if(reference_type == "Opening Balance")
                 					{
                 						running_balance = amount;
                 					}
                 					else if(transaction_type == "Debit")
                 					{
                 						total_debit = total_debit + amount;
                 						running_balance = running_balance + amount;
                 					}
                 					else if(transaction_type == "Credit")
                 					{
                 						total_credit = total_credit + amount;
                 						running_balance = running_balance - amount;
                 					}
                 					log.Balance_After=running_balance;
                 					processed_logs = processed_logs + 1;
                 				}
                 				acc.Total_Debit=total_debit;
                 				acc.Total_Credit=total_credit;
                 				acc.Current_Balance=running_balance;
                 				processed_accounts = 1;
                 			}
                 		}
                 	}
                 	remaining_logs = Account_Transaction_Log[Application == "Masaka Site Management" && Balance_After == null].count();
                 	resp.put("ok",true);
                 	resp.put("processed_accounts",processed_accounts);
                 	resp.put("processed_logs",processed_logs);
                 	resp.put("remaining_masaka_logs",remaining_logs);
                 	if(account_found == false || remaining_logs == 0)
                 	{
                 		resp.put("completed",true);
                 		resp.put("message","Masaka Site Management balance backfill completed.");
                 	}
                 	else
                 	{
                 		resp.put("completed",false);
                 		resp.put("message","One account refreshed. Click Execute again.");
                 	}
                 	return resp;
                 }
				 map createCashReceiptFromPaymentReceived(map input)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("msg","Unknown error");
                 	paymentId = input.get("Payment_Received_ID");
                 	cashEnvelopeName = ifnull(input.get("Cash_Envelope_Name"),"");
                 	cashEnvelopeDate = input.get("Cash_Envelope_Date");
                 	amountDue = round(ifnull(input.get("Amount_Due"),0.0),2);
                 	amountReceived = round(ifnull(input.get("Amount_Received"),0.0),2);
                 	currentSite = ifnull(input.get("Current_Site"),"");
                 	accountName = ifnull(input.get("Account"),"");
                 	sourceForm = ifnull(input.get("Source_Form"),"Payment Received");
                 	if(paymentId == null)
                 	{
                 		response.put("msg","Payment_Received_ID is missing");
                 		return response;
                 	}
                 	if(cashEnvelopeName == "")
                 	{
                 		response.put("msg","Cash Envelope Name is missing");
                 		return response;
                 	}
                 	if(cashEnvelopeDate == null)
                 	{
                 		cashEnvelopeDate = zoho.currentdate;
                 	}
                 	// ============================================
                 	// FIND / CREATE CASH RECEIPT VOUCHER
                 	// ============================================
                 	existingReceipt = Cash_Receipt_Voucher[Cash_Receipt_Number == cashEnvelopeName];
                 	if(existingReceipt.ID != null)
                 	{
                 		cashReceiptId = existingReceipt.ID;
                 	}
                 	else
                 	{
                 		cashReceiptId = insert into Cash_Receipt_Voucher
                 		[
                 			Cash_Receipt_Number=cashEnvelopeName
                 			Cash_Receipt_Date=cashEnvelopeDate
                 			Description="Cashier Envelope"
                 			Account_Receiving=accountName
                 			Total_Amount_Received=0.0
                 			Total_Amount_Allocated=0.0
                 			Added_User=zoho.loginuser
                 		];
                 	}
                 	if(cashReceiptId == null)
                 	{
                 		response.put("msg","Cash Receipt Voucher create failed");
                 		return response;
                 	}
                 	// ============================================
                 	// FIND EXISTING DETAIL
                 	// ============================================
                 	existingDetail = Cash_Receipt_Details[Cash_Receipt_Voucher == cashReceiptId && Source_Record_ID == paymentId && Source_Form == sourceForm];
                 	if(existingDetail.ID != null)
                 	{
                 		existingDetail.Display_Name_Cash_Receipt_Voucher=cashEnvelopeName;
                 		existingDetail.Cash_Receipt_Date=cashEnvelopeDate;
                 		existingDetail.Amount_Due=amountDue;
                 		existingDetail.Amount_Received=amountReceived;
                 		existingDetail.Current_Site=currentSite;
                 		existingDetail.Account=accountName;
                 		response.put("Detail_Action","Updated");
                 	}
                 	else
                 	{
                 		maxLine = 0;
                 		rows = Cash_Receipt_Details[Cash_Receipt_Voucher == cashReceiptId];
                 		for each  rec in rows
                 		{
                 			if(ifnull(rec.Line_Number,0) > maxLine)
                 			{
                 				maxLine = rec.Line_Number;
                 			}
                 		}
                 		newDetail = insert into Cash_Receipt_Details
                 		[
                 			Cash_Receipt_Voucher=cashReceiptId
                 			Display_Name_Cash_Receipt_Voucher=cashEnvelopeName
                 			Cash_Receipt_Date=cashEnvelopeDate
                 			Line_Number=maxLine + 1
                 			Amount_Due=amountDue
                 			Amount_Received=amountReceived
                 			Current_Site=currentSite
                 			Account=accountName
                 			Source_Record_ID=paymentId
                 			Source_Form=sourceForm
                 			Added_User=zoho.loginuser
                 		];
                 		response.put("Detail_Action","Created");
                 		response.put("Cash_Receipt_Details_ID",newDetail);
                 	}
                 	// ============================================
                 	// RECALCULATE TOTALS
                 	// ============================================
                 	totalReceived = 0.0;
                 	details = Cash_Receipt_Details[Cash_Receipt_Voucher == cashReceiptId];
                 	for each  d in details
                 	{
                 		totalReceived = totalReceived + ifnull(d.Amount_Received,0.0);
                 	}
                 	cr = Cash_Receipt_Voucher[ID == cashReceiptId];
                 	if(cr.ID != null)
                 	{
                 		cr.Total_Amount_Received=totalReceived;
                 		cr.Total_Amount_Allocated=totalReceived;
                 	}
                 	response.put("ok",true);
                 	response.put("msg","Cash Receipt processed");
                 	response.put("Cash_Receipt_Voucher_ID",cashReceiptId);
                 	response.put("Total_Amount_Received",totalReceived);
                 	return response;
                 }
				 map createGroupExpenseFromAssetBill(map input)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("msg","Unknown error");
                 	groupId = input.get("Group_ID");
                 	amt = round(ifnull(input.get("Amount_Delta"),0.0),2);
                 	payDate = input.get("Payment_Date");
                 	sourceGroup = ifnull(input.get("Source_Group"),"Asset Bill");
                 	if(groupId == null)
                 	{
                 		response.put("msg","Group_ID is missing");
                 		return response;
                 	}
                 	if(payDate == null)
                 	{
                 		payDate = zoho.currentdate;
                 	}
                 	grp = Group[ID == groupId];
                 	if(grp.ID == null)
                 	{
                 		response.put("msg","Group not found");
                 		return response;
                 	}
                 	// ONE record per Group + Date + Source Group
                 	existing = Group_Accounts[Group == grp.ID && Payment_Date == payDate && Source_Group == sourceGroup];
                 	if(existing.ID != null)
                 	{
                 		existing.Amount_to_Pay=round(ifnull(existing.Amount_to_Pay,0.0) + amt,2);
                 		response.put("ok",true);
                 		response.put("msg","Existing group expense updated");
                 		response.put("Group_Expenses_ID",existing.ID);
                 		response.put("Amount_Added",amt);
                 		response.put("New_Amount_to_Pay",existing.Amount_to_Pay);
                 		response.put("Source_Group",sourceGroup);
                 		return response;
                 	}
                 	newRec = insert into Group_Accounts
                 	[
                 		Group=grp.ID
                 		Payment_Date=payDate
                 		Source_Group=sourceGroup
                 		Amount_to_Pay=amt
                 		Added_User=zoho.loginuser
                 	];
                 	if(newRec != null)
                 	{
                 		response.put("ok",true);
                 		response.put("msg","Group expense created");
                 		response.put("Group_Expenses_ID",newRec);
                 		response.put("Amount_Added",amt);
                 		response.put("Source_Group",sourceGroup);
                 	}
                 	else
                 	{
                 		response.put("msg","Insert failed");
                 	}
                 	return response;
                 }
				 map createGroupExpenseFromEmployeeBill(map input)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("msg","Unknown error");
                 	groupId = input.get("Group_ID");
                 	amt = round(ifnull(input.get("Amount_Delta"),0.0),2);
                 	payDate = input.get("Payment_Date");
