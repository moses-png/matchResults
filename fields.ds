			{
				type =  form
				form = Account_User

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =======================
										// EMAIL USER - SET UP FORM
										// =======================
										disable Email_Prefix;
										disable Email_User;
										disable Display_Name_Account;
										hide Display_Name_Account;
										hide Display_Name_Employee;
										disable Status;
										//==================================
										//BACK END
										//=================================
										hide Back_End;
										hide User_Name;
										hide User_Email;
										hide User_Role;
										hide Created_By_Name;
										hide Created_By_Email;
										hide Created_By_Time;
										hide Updated_By_Name;
										hide Updated_By_Email;
										hide Updated_By_Time;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										//===================================
										//LOGGED IN USER
										//===================================
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			Full_Validation1 as "Full Validation"
			{
				type =  form
				form = Account_User

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// PREVENT SAME EMAIL ON SAME ACCOUNT
										// =====================================
										if(input.Account != null && input.Email != null && input.Email.trim() != "")
										{
											email_val = input.Email.trim().toLowerCase();
											dup = Account_User[Account == input.Account && Email == email_val && ID != input.ID];
											if(dup.ID != null)
											{
												alert "This email is already assigned to the selected account.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			On_Employee_Selected as "On Employee Selected"
			{
				type =  form
				form = Account_User

				record event = on add or edit

				on user input of Employee
				{
					actions 
					{
						custom deluge script
						(
											if(input.Employee != null)
										{
											input.Display_Name_Employee = input.Employee.Employee_Name + " - " + input.Employee.Employee_Number;
										}
										else
										{
											input.Display_Name_Employee = "";
										}
						)
					}
				}

			}
			Set_Up_Form10 as "Set Up Form"
			{
				type =  form
				form = Cash_Receipt_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//hide Issue_Number;
										hide Back_End;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			Set_Up_Form11 as "Set Up Form"
			{
				type =  form
				form = Debit

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//hide Issue_Number;
										hide Back_End;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			Set_Up_Form12 as "Set Up Form"
			{
				type =  form
				form = Group

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//hide Issue_Number;
										hide Back_End;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			Finalize6 as "Finalize"
			{
				type =  form
				form = Account

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											opening_dt = input.Opening_Balance_Date_Time;
										if(opening_dt == null)
										{
											opening_dt = zoho.currenttime;
										}
										txn = Map();
										txn.put("Transaction_Date",opening_dt.toDate());
										txn.put("Transaction_Date_Time",opening_dt);
										txn.put("Account",input.ID);
										txn.put("Display_Name_Account",ifnull(input.Account_Name,""));
										txn.put("Transaction_Type","Debit");
										txn.put("Amount",ifnull(input.Opening_Balance,0.0));
										txn.put("Reference_Type","Opening Balance");
										txn.put("Reference_Number",ifnull(input.Account_Number,""));
										txn.put("Application","Payment Management");
										txn.put("Source_Form","Account Opening Balance");
										txn.put("Source_Record_ID",input.ID);
										txn.put("Notes",ifnull(input.Opening_Balance_Notes,""));
										txn_resp = thisapp.createOrUpdateAccountTransactionLog(txn);
										info txn_resp;
										//thisapp.refreshAccountTransactionLog();
						)
					}
				}

			}
			On_Check_Selected as "On Check Selected"
			{
				type =  form
				form = Payment_Voucher2

				record event = on add or edit

				on user input of Check
				{
					actions 
					{
						custom deluge script
						(
											if(input.Check == true)
										{
											show Reason_Why_Checking;
										}
										else
										{
											hide Reason_Why_Checking;
										}
						)
					}
				}

			}
			Add_Row_Charges_ as "Add Row \"Charges\""
			{
				type =  form
				form = Transfer_Funds

				record event = on add or edit

				on add row of Charges
				{
					actions 
					{
						custom deluge script
						(
											max_line = 0;
										for each  r in input.Charges
										{
											if(ifnull(r.Line_Number,0) > max_line)
											{
												max_line = r.Line_Number;
											}
										}
										row.Line_Number=max_line + 1;
										row.Transaction_Type="Transfer Funds";
										row.Transfer_Account=input.Account_From;
										row.Display_Name_Voucher=ifnull(input.Display_Name_Account_From,"");
										row.Amount=0;
						)
					}
				}

			}
			Delete_Row_Charges_ as "Delete Row \"Charges\""
			{
				type =  form
				form = Transfer_Funds

				record event = on add or edit

				on delete row of Charges
				{
					actions 
					{
						custom deluge script
						(
											line_no = 1;
										for each  r in input.Charges
										{
											r.Line_Number=line_no;
											line_no = line_no + 1;
										}
						)
					}
				}

			}
		}






	}
