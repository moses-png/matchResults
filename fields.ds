	reports
	{
		default list All_Services
		{
			displayName = "All Services"
			show all rows from Service    
			(
				Service_Name as "Service Name"
				Rate
				Total_Cost as "Total Cost"
				User_Name as "User Name"
				User_Email as "User Email"
