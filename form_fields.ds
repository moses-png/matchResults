      "name": "Work_Order_Tasks",
      "fields": [
        {
          "name": "Work_Order_Task_Number",
          "displayname": "Work Order Task Number",
          "type": "text"
        },
        {
          "name": "Asset",
          "displayname": "Asset",
          "type": "lookup",
          "lookup_trail": {
            "app": "asset_management",
            "form": "Asset_List",
            "display": "Asset_Name"
          },
          "display_fields": [
            "Asset_Name",
            "Asset_ID"
          ]
        },
        {
          "name": "Display_Name_Asset",
          "displayname": "Display Name Asset",
          "type": "text"
        },
        {
          "name": "Odometer_Reading_Requested",
          "displayname": "Odometer Reading Requested",
          "type": "decimal"
        },
        {
          "name": "Work_Order",
          "displayname": "Work Order",
          "type": "lookup",
          "lookup_trail": {
            "app": "same",
            "form": "Asset_Issues",
            "display": "Work_Order_Number"
          },
          "display_fields": [
            "Work_Order_Number",
            "Issue_Number",
            "Display_Name_Asset"
          ],
          "setFilter": "Asset.Asset_Name == input.Asset.Asset_Name && Work_Order_Status == \"Pending\" || Work_Order_Status == \"In Progress\"",
          "direction": "Asset Issues → Work Order Tasks"
        },
        {
          "name": "Display_Name_Work_Order",
          "displayname": "Display Name Work Order",
          "type": "text"
        },
        {
          "name": "Issue",
          "displayname": "Issue",
