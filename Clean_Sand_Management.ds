			Finalize_On_Delete as "Finalize On Delete"
			{
				type =  form
				form = Payment_Charges

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// PAYMENT CHARGES — ON DELETE
										// ======================================================
										if(input.Payment_Receipt_Voucher != null)
										{
											prv = Payment_Receipt_Voucher[ID == input.Payment_Receipt_Voucher];
											if(prv.ID != null)
											{
												total_charges = 0.0;
												charge_rows = Payment_Charges[Payment_Receipt_Voucher == prv.ID && ID != input.ID];
												for each  ch in charge_rows
												{
													total_charges = total_charges + ifnull(ch.Amount,0.0);
												}
												prv.Total_Charges=total_charges;
												amount_allocated = 0.0;
												receipt_rows = Payment_Receipt_Details[Payment_Receipt_Voucher == prv.ID];
												for each  rec in receipt_rows
												{
													amount_allocated = amount_allocated + ifnull(rec.Amount_Allocated,0.0);
												}
												prv.Total_Amount_Allocated=amount_allocated;
												total_received = ifnull(prv.Total_Amount_Received,0.0);
												amount_not_allocated = total_received - total_charges - amount_allocated;
												if(amount_not_allocated < 0)
												{
													amount_not_allocated = 0.0;
												}
												prv.Total_Amount_Not_Allocated=amount_not_allocated;
												if(amount_not_allocated <= 0)
												{
													prv.Payment_Receipt_Voucher_Status="Allocated";
												}
												else if(total_charges > 0 || amount_allocated > 0)
												{
													prv.Payment_Receipt_Voucher_Status="Partially Allocated";
												}
												else
												{
													prv.Payment_Receipt_Voucher_Status="Unassigned";
												}
											}
										}
										// =====================================================
										//PAYMENT CHARGES FINALIZE ON DELETE
										// =====================================================
										delete_payload = Map();
										delete_payload.put("Source_Record_ID",input.ID);
										delete_payload.put("Source_Form","Payment Charges");
										delete_resp = payment_management.deletePaymentChargesFromMasakaSiteManagement(delete_payload);
										info delete_resp;
						)
					}
				}

			}
			Finalize6 as "Finalize"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// PAYMENT RECEIPT DETAILS — FINALIZE
										// ======================================================
										// 1. UPDATE PAYMENT RECEIPT VOUCHER
										if(input.Payment_Receipt_Voucher != null)
										{
											prv = Payment_Receipt_Voucher[ID == input.Payment_Receipt_Voucher];
											if(prv.ID != null)
											{
												total_charges = 0.0;
												for each  ch in Payment_Charges[Payment_Receipt_Voucher == prv.ID]
												{
													total_charges = total_charges + ifnull(ch.Amount,0.0);
												}
												detail_allocated = 0.0;
												for each  det in Payment_Receipt_Details[Payment_Receipt_Voucher == prv.ID]
												{
													detail_allocated = detail_allocated + ifnull(det.Amount_Allocated,0.0);
												}
												amount_allocated = total_charges + detail_allocated;
												balance = ifnull(prv.Total_Amount_Received,0.0) - amount_allocated;
												if(balance < 0)
												{
													balance = 0.0;
												}
												prv.Total_Charges=total_charges;
												prv.Total_Amount_Allocated=amount_allocated;
												prv.Total_Amount_Not_Allocated=balance;
												if(balance <= 0)
												{
													prv.Payment_Receipt_Voucher_Status="Fully Assigned";
												}
												else if(amount_allocated > 0)
												{
													prv.Payment_Receipt_Voucher_Status="Partially Assigned";
												}
												else
												{
													prv.Payment_Receipt_Voucher_Status="Unassigned";
												}
											}
										}
										// =====================================================
										// UPDATE SALES VOUCHER DIRECTLY
										// =====================================================
										if(input.Payment_Document == "Sales Voucher" && input.Sales_Voucher != null)
										{
											sv = Sales_Voucher[ID == input.Sales_Voucher.ID];
											if(sv.ID != null)
											{
												total_paid = 0.0;
												total_credited = 0.0;
												for each  det2 in Payment_Receipt_Details[Payment_Document == "Sales Voucher" && Sales_Voucher == sv.ID]
												{
													total_paid = total_paid + ifnull(det2.Amount_Allocated,0.0);
													total_credited = total_credited + ifnull(det2.Amount_Credited,0.0);
												}
												sv_total = ifnull(sv.Grand_Total,0.0);
												if(total_paid > sv_total)
												{
													total_paid = sv_total;
												}
												sv.Amount_Paid=total_paid;
												sv.Amount_Credited=total_credited;
												bal = sv_total - total_paid - total_credited;
												if(bal < 0)
												{
													bal = 0.0;
												}
												if(sv.Balance_Due <= 0)
												{
													if(total_credited > 0 && total_paid <= 0)
													{
														sv.Payment_Status="Credit";
													}
													else
													{
														sv.Payment_Status="Paid";
													}
												}
												else if(total_credited > 0)
												{
													sv.Payment_Status="Partially Credited";
												}
												else if(total_paid > 0)
												{
													sv.Payment_Status="Partially Paid";
												}
												else
												{
													sv.Payment_Status="Unpaid";
												}
											}
										}
										// =====================================================
										// IF PAYMENT IS FOR SALES VOUCHER
										// =====================================================
										if(input.Payment_Document == "Sales Voucher" && input.Sales_Voucher != null)
										{
											sv = Sales_Voucher[ID == input.Sales_Voucher.ID];
											if(sv.ID != null)
											{
												total_paid = 0.0;
												total_credited = 0.0;
												for each  det2 in Payment_Receipt_Details[Payment_Document == "Sales Voucher" && Sales_Voucher == sv.ID]
												{
													total_paid = total_paid + ifnull(det2.Amount_Allocated,0.0);
													total_credited = total_credited + ifnull(det2.Amount_Credited,0.0);
												}
												sv_total = ifnull(sv.Grand_Total,0.0);
												if(total_paid > sv_total)
												{
													total_paid = sv_total;
												}
												sv.Amount_Paid=total_paid;
												sv.Amount_Credited=total_credited;
												sv.Balance_Due=sv_total - total_paid - total_credited;
												if(sv.Balance_Due < 0)
												{
													sv.Balance_Due=0.0;
												}
												if(sv.Balance_Due <= 0)
												{
													if(total_credited > 0 && total_paid <= 0)
													{
														sv.Payment_Status="Credit";
													}
													else
													{
														sv.Payment_Status="Paid";
													}
												}
												else if(total_credited > 0)
												{
													sv.Payment_Status="Partially Credited";
												}
												else if(total_paid > 0)
												{
													sv.Payment_Status="Partially Paid";
												}
												else
												{
													sv.Payment_Status="Unpaid";
												}
											}
										}
										// =====================================================
										// IF PAYMENT IS FOR INVOICE
										// =====================================================
										if(input.Payment_Document == "Invoice" && input.Invoice != null)
										{
											thisapp.fix_sales_vouchers_from_invoice(input.Invoice.ID);
											thisapp.update_invoice_payment(input.Invoice.ID);
										}
										// =====================================================
										// 2B. POST PAYMENT RECEIPT DETAILS TO GRAPES GROUP
										// =====================================================
										if(input.Payment_Document == "Sales Voucher" && input.Sales_Voucher != null && input.Payment_Type == "Cash")
										{
											amount_to_post = ifnull(input.Amount_Allocated,0.0);
											if(amount_to_post > 0)
											{
												post = Map();
												post.put("Display_Name_Application","Masaka Site Management");
												post.put("Source_Form","Payment Receipt Details");
												post.put("Source_Record_ID",input.ID.toString());
												post.put("Voucher_Number",input.Display_Name_Voucher);
												post.put("MSM_Payment_Receipt_Details",input.ID);
												post.put("Transaction_Date",input.Payment_Receipt_Voucher.Payment_Receipt_Date);
												post.put("Business_Division",null);
												post.put("Display_Name_Business_Division","");
												post.put("Amount_To_Receive",0);
												post.put("Amount_Received",amount_to_post);
												post.put("Amount_Not_Received",amount_to_post * -1);
												post.put("Amount_To_Pay",0);
												post.put("Amount_Paid",0);
												post.put("Amount_Not_Paid",0);
												grapes_group.masakasite.postBusinessDivisionDetail(post);
											}
										}
										// =====================================================
										// IF CREDIT, CREATE / UPDATE INVOICE DETAILS
										// =====================================================
										if(input.Payment_Type == "Credit" && input.Payment_Document == "Sales Voucher" && input.Sales_Voucher != null)
										{
											sv2 = Sales_Voucher[ID == input.Sales_Voucher.ID];
											if(sv2.ID != null)
											{
												credit_note_no = "";
												if(input.Credit_Note_Voucher != null)
												{
													credit_note_no = ifnull(input.Credit_Note_Voucher.Credit_Note_Number,"");
												}
												delivery_note_no = "";
												if(sv2.Delivery_Note != null)
												{
													delivery_note_no = ifnull(sv2.Delivery_Note.Delivery_Note_Number,"");
												}
												number_plate_text = ifnull(sv2.Display_Name_Number_Plate,"");
												line_no = ifnull(input.Line_Number,1);
												for each  p in sv2.Product_Details
												{
													item_text = "Number Plate: " + number_plate_text + "\nItem: " + ifnull(p.Display_Name_Item,"") + "\nQuantity: " + ifnull(p.Quantity,0).toString() + "\nUnit Of Measure: " + ifnull(p.Display_Name_Base_Unit_Of_Measure,"");
													details_text = "Sales Voucher Number: " + ifnull(sv2.Sales_Voucher_Number,"") + "\nSales Voucher Date: " + sv2.Sales_Voucher_Date.toString("dd-MMM-yyyy") + "\nCustomer: " + ifnull(sv2.Display_Name_Customer,"") + "\nCredit Note: " + credit_note_no;
													if(delivery_note_no != "")
													{
														details_text = details_text + "\nDelivery Note: " + delivery_note_no;
													}
													existing_inv = Invoice_Details[Source_Record_ID == sv2.ID && Source_Form == "Sales Voucher" && Line_Number == line_no];
													if(existing_inv.count() > 0)
													{
														for each  inv in existing_inv
														{
															inv.Sales_Voucher=sv2.ID;
															inv.Display_Name_Voucher=ifnull(sv2.Sales_Voucher_Number,"");
															inv.Line_Number=line_no;
															inv.Item=item_text;
															inv.Details=details_text;
															inv.Quantity=1;
															inv.Site=sv2.Display_Name_Site;
															inv.Account=sv2.Display_Name_Site;
															inv.Invoice_Details_Status="Draft";
															inv.Source_Record_ID=sv2.ID;
															inv.Source_Form="Sales Voucher";
														}
													}
													else
													{
														insert into Invoice_Details
														[
															Sales_Voucher=sv2.ID
															Display_Name_Voucher=ifnull(sv2.Sales_Voucher_Number,"")
															Details_Date=zoho.currentdate
															Line_Number=line_no
															Item=item_text
															Details=details_text
															Quantity=1
															Site=sv2.Display_Name_Site
															Account=sv2.Display_Name_Site
															Source_Record_ID=sv2.ID
															Source_Form="Sales Voucher"
															Invoice_Details_Status="Draft"
															Added_User=zoho.loginuser
														]
													}
													line_no = line_no + 1;
												}
											}
										}
										// =====================================================
										// SECTION: SYNC PAYMENT RECEIPT DETAILS TO PAYMENT MANAGEMENT
										// =====================================================
										if(input.ID != null && input.Payment_Type == "Cash")
										{
											// ---------------------------------
											// Build Description
											// ---------------------------------
											description = "";
											doc_name = "";
											if(ifnull(input.Display_Name_Invoice_Voucher,"") != "")
											{
												doc_name = input.Display_Name_Invoice_Voucher;
												if(doc_name.contains(" - "))
												{
													doc_name = doc_name.getPrefix(" - ");
												}
											}
											if(ifnull(input.Payment_Document,"") != "")
											{
												description = input.Payment_Document;
											}
											if(doc_name != "")
											{
												if(description != "")
												{
													description = description + " - ";
												}
												description = description + doc_name;
											}
											// ---------------------------------
											// Amount To Sync
											// ---------------------------------
											sync_amount = ifnull(input.Amount_Allocated,0.0);
											if(input.Payment_Document == "Cash Deposit" && sync_amount <= 0)
											{
												sync_amount = ifnull(input.Amount_Not_Allocated,0.0);
											}
											// ---------------------------------
											// Transaction Date
											// ---------------------------------
											transaction_date_txt = "";
											if(input.Payment_Receipt_Voucher.Payment_Receipt_Date != null)
											{
												transaction_date_txt = input.Payment_Receipt_Voucher.Payment_Receipt_Date.toString("dd-MMM-yyyy");
											}
											// ---------------------------------
											// Created / Updated Time
											// ---------------------------------
											created_time_txt = "";
											if(input.Created_By_Time != null)
											{
												created_time_txt = input.Created_By_Time.toString("dd-MMM-yyyy HH:mm:ss");
											}
											updated_time_txt = "";
											if(input.Updated_By_Time != null)
											{
												updated_time_txt = input.Updated_By_Time.toString("dd-MMM-yyyy HH:mm:ss");
											}
											// ---------------------------------
											// Build Payload
											// ---------------------------------
											payload = Map();
											payload.put("Payment_Voucher_Source_ID",input.Payment_Receipt_Voucher.ID.toLong());
											payload.put("Display_Name_Payment_Voucher",ifnull(input.Display_Name_Voucher,""));
											payload.put("Line_Number",input.Line_Number);
											payload.put("Description",description);
											payload.put("Amount_Allocated",sync_amount);
											payload.put("Application","Masaka Site Management");
											payload.put("Transaction_Date",transaction_date_txt);
											payload.put("Source_Form","Payment Receipt Details");
											payload.put("Source_Record_ID",input.ID.toLong());
											payload.put("Voucher_Number",ifnull(input.Payment_Receipt_Voucher.Payment_Receipt_Number,""));
											payload.put("User_Name",ifnull(input.User_Name,""));
											payload.put("User_Email",ifnull(input.User_Email,""));
											payload.put("User_Role",ifnull(input.User_Role,""));
											payload.put("Created_By_Name",ifnull(input.Created_By_Name,""));
											payload.put("Created_By_Email",ifnull(input.Created_By_Email,""));
											payload.put("Created_By_Time",created_time_txt);
											payload.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
											payload.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
											payload.put("Updated_By_Time",updated_time_txt);
											// ---------------------------------
											// Sync
											// ---------------------------------
											sync_resp = payment_management.syncPaymentDetailsFromMasakaSiteManagement(payload);
											info sync_resp;
											if(sync_resp != null && sync_resp.get("ok") == true)
											{
												account_id_val = sync_resp.get("account_id");
												if(account_id_val != null)
												{
													refresh_resp = payment_management.refreshAccountTransactionLog(account_id_val.toLong());
													info refresh_resp;
												}
											}
										}
										// =====================================================
										// FINALIZE: CASH RECEIPT TO CUSTOMER DEPOSIT
										// =====================================================
										if(input.Payment_Type == "Cash" && input.Payment_Document == "Cash Deposit" && input.Customer_Deposit_Number != null)
										{
											cd = Customer_Deposit_Details[ID == input.Customer_Deposit_Number.ID];
											if(cd.ID != null)
											{
												// ---------------------------------
												// Recalculate from Payment Receipt Details
												// ---------------------------------
												total_received = 0.0;
												for each  prd in Payment_Receipt_Details[Customer_Deposit_Number == cd.ID]
												{
													total_received = total_received + ifnull(prd.Amount_Allocated,0.0);
												}
												// ---------------------------------
												// Update Customer Deposit record
												// ---------------------------------
												cd.Total_Amount_Received=total_received;
												cd.Total_Charges=0.0;
												cd.Total_Amount_Allocated=0.0;
												cd.Total_Amount_Not_Allocated=total_received;
												if(total_received > 0)
												{
													cd.Customer_Deposit_Status="Unassigned";
												}
												else
												{
													cd.Customer_Deposit_Status="Unassigned";
												}
											}
										}
										// =====================================================
										// FINALIZE: USE CUSTOMER DEPOSIT TO PAY DOCUMENT
										// =====================================================
										if(input.Payment_Type == "Cash Deposit" && input.Customer_Deposit_Voucher != null)
										{
											cd = Customer_Deposit_Details[ID == input.Customer_Deposit_Voucher.ID];
											if(cd.ID != null)
											{
												total_allocated = 0.0;
												for each  prd in Payment_Receipt_Details[Customer_Deposit_Voucher == cd.ID]
												{
													total_allocated = total_allocated + ifnull(prd.Amount_Allocated,0.0);
												}
												cd.Total_Amount_Allocated=total_allocated;
												cd.Total_Amount_Not_Allocated=ifnull(cd.Total_Amount_Received,0.0) - ifnull(cd.Total_Charges,0.0) - total_allocated;
												if(cd.Total_Amount_Not_Allocated < 0)
												{
													cd.Total_Amount_Not_Allocated=0.0;
												}
												if(cd.Total_Amount_Not_Allocated <= 0)
												{
													cd.Customer_Deposit_Status="Fully Assigned";
												}
												else if(total_allocated > 0)
												{
													cd.Customer_Deposit_Status="Partially Assigned";
												}
												else
												{
													cd.Customer_Deposit_Status="Unassigned";
												}
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete1 as "Finalize On Delete"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// PAYMENT RECEIPT DETAILS — ON DELETE
										// ======================================================
										if(input.Payment_Receipt_Voucher != null)
										{
											prv = Payment_Receipt_Voucher[ID == input.Payment_Receipt_Voucher];
											if(prv.ID != null)
											{
												total_charges = 0.0;
												for each  ch in Payment_Charges[Payment_Receipt_Voucher == prv.ID]
												{
													total_charges = total_charges + ifnull(ch.Amount,0.0);
												}
												detail_allocated = 0.0;
												for each  det in Payment_Receipt_Details[Payment_Receipt_Voucher == prv.ID && ID != input.ID]
												{
													detail_allocated = detail_allocated + ifnull(det.Amount_Allocated,0.0);
												}
												amount_allocated = total_charges + detail_allocated;
												total_received = ifnull(prv.Total_Amount_Received,0.0);
												balance = total_received - amount_allocated;
												if(balance < 0)
												{
													balance = 0.0;
												}
												prv.Total_Charges=total_charges;
												prv.Total_Amount_Allocated=amount_allocated;
												prv.Total_Amount_Not_Allocated=balance;
												if(balance <= 0)
												{
													prv.Payment_Receipt_Voucher_Status="Fully Assigned";
												}
												else if(amount_allocated > 0)
												{
													prv.Payment_Receipt_Voucher_Status="Partially Assigned";
												}
												else
												{
													prv.Payment_Receipt_Voucher_Status="Unassigned";
												}
											}
										}
										// ======================================================
										// UPDATE LINKED SALES VOUCHER
										// ======================================================
										voucher_number = ifnull(input.Display_Name_Invoice_Voucher,"").trim();
										if(input.Payment_Document == "Sales Voucher" && voucher_number != "")
										{
											sv = Sales_Voucher[Sales_Voucher_Number == voucher_number];
											if(sv.ID != null)
											{
												total_paid = 0.0;
												total_credited = 0.0;
												for each  det in Payment_Receipt_Details[Payment_Document == "Sales Voucher" && Display_Name_Invoice_Voucher == voucher_number && ID != input.ID]
												{
													total_paid = total_paid + ifnull(det.Amount_Allocated,0.0);
													total_credited = total_credited + ifnull(det.Amount_Credited,0.0);
												}
												sv_total = ifnull(sv.Grand_Total,0.0);
												if(total_paid > sv_total)
												{
													total_paid = sv_total;
												}
												balance = sv_total - total_paid - total_credited;
												if(balance < 0)
												{
													balance = 0.0;
												}
												sv.Amount_Paid=total_paid;
												sv.Amount_Credited=total_credited;
												sv.Balance_Due=balance;
												if(balance <= 0)
												{
													if(total_credited > 0 && total_paid <= 0)
													{
														sv.Payment_Status="Credit";
													}
													else
													{
														sv.Payment_Status="Paid";
													}
												}
												else if(total_credited > 0)
												{
													sv.Payment_Status="Partially Credited";
												}
												else if(total_paid > 0)
												{
													sv.Payment_Status="Partially Paid";
												}
												else
												{
													sv.Payment_Status="Unpaid";
												}
											}
										}
										payload = Map();
										payload.put("Source_Record_ID",input.ID.toLong());
										payload.put("Source_Form","Payment Receipt Details");
										resp = payment_management.deletePaymentDetailsFromMasakaSiteManagement(payload);
										info resp;
						)
					}
				}

			}
