											{
												hide Employee_Issuing_Details;
												show Voucher_Header;
												show Asset;
												show Item;
												show Quantity_To_Be_Created;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												disable Asset;
												disable Item;
												disable Quantity_To_Be_Created;
												show Notes;
												show Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
												}
											}
											show Manager_Section;
											show Cancel_Voucher;
											if(input.Cancel_Voucher == true)
											{
												show Cancellation_Reason;
											}
											else
											{
												hide Cancellation_Reason;
											}
											show Head_Office;
											show Seen;
											enable Seen;
										}
										// =====================================================
										// ON EDIT + Status = HUMAN RESOURCE
										// =====================================================
										else if(!is_create && st == "Human Resource")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											enable Document_Type;
											show Voucher_Type;
											enable Voucher_Type;
											show Voucher_Number;
											enable Voucher_Number;
											show Employee;
											show Date_Time_In;
											enable Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											enable Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
											{
												hide Employee_Issuing_Details;
												show Voucher_Header;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												show Notes;
												show Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
												}
											}
											show Manager_Section;
											show Cancel_Voucher;
											enable Cancel_Voucher;
										}
										// =====================================================
										// ON EDIT + Status = AUDITED
										// =====================================================
										else if(!is_create && st == "Audited")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											enable Voucher_Status;
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
											{
												hide Employee_Issuing_Details;
												show Voucher_Header;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												show Notes;
												show Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
												}
											}
											show Voucher_Cost;
											show End_Time;
											show Odometer_End;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											if(input.Cancel_Voucher == true)
											{
												show Cancellation_Reason;
											}
											else
											{
												hide Cancellation_Reason;
											}
											show Head_Office;
											show Seen;
											if(input.Seen == true)
											{
												hide Reason_for_not_Seen;
											}
											else
											{
												show Reason_for_not_Seen;
											}
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
											show Back_End;
											show User_Name;
											show User_Email;
											show User_Role;
											show Created_By_Name;
											show Created_By_Email;
											show Created_By_Time;
											show Updated_By_Name;
											show Updated_By_Email;
											show Updated_By_Time;
										}
										// =====================================================
										// ON EDIT + Status = CLEARED
										// =====================================================
										else if(!is_create && st == "Cleared")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
