										{
											alert "Please correct the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			On_Bill_Total_Selected as "On Bill Total Selected"
			{
				type =  form
				form = Bill

				record event = on add or edit

				on user input of Bill_Total
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// MASAKA SITE MANAGEMENT
										// BILL
										// ON USER INPUT OF BILL TOTAL
										//
										// PURPOSE:
										// For monthly bills, distribute Bill Total across
										// Bill Details based on total quantity and recalculate
										// the main Bill totals.
										//
										// CONDITION:
										// Only runs when Bill Number contains "Month"
										// =====================================================
										if(input.Bill_Number != null && input.Bill_Number.contains("Month"))
										{
											// =================================================
											// 1. GET BILL TOTAL
											// =================================================
											bill_total = ifnull(input.Bill_Total,0.0);
											// =================================================
											// 2. CALCULATE TOTAL QUANTITY IN BILL DETAILS
											// Blank Quantity is treated as 0
											// =================================================
											total_quantity = 0.0;
											for each  row in input.Bill_Details
											{
												total_quantity = total_quantity + ifnull(row.Quantity,0.0);
											}
											// =================================================
											// 3. CALCULATE RATE PER UNIT
											// =================================================
											if(bill_total > 0 && total_quantity > 0)
											{
												rate_per_unit = bill_total / total_quantity;
												for each  row in input.Bill_Details
												{
													row.Rate=rate_per_unit;
												}
											}
											// =================================================
											// 4. CALCULATE SERVICES TOTAL
											// =================================================
											services_total = 0.0;
											for each  service_row in input.Services
											{
												services_total = services_total + ifnull(service_row.Line_Total,0.0);
											}
											input.Services_Total = services_total;
											// =================================================
											// 5. CALCULATE TOTAL AMOUNT
											// Bill Total + Services Total
											// =================================================
											input.Total_Amount = bill_total + services_total;
											// =================================================
											// 6. TAX & DISCOUNT
											// Uses current values already on the Bill
											// =================================================
											tax_amount = ifnull(input.Tax_Amount,0.0);
											discount_amount = ifnull(input.Discount_Amount,0.0);
											// =================================================
											// 7. CALCULATE AMOUNT DUE
											// =================================================
											input.Amount_Due = input.Total_Amount + tax_amount - discount_amount;
											// =================================================
											// 8. AMOUNT PAID
											// Uses current Amount Paid
											// =================================================
											amount_paid = ifnull(input.Amount_Paid,0.0);
											// =================================================
											// 9. CALCULATE BALANCE DUE
											// =================================================
											input.Balance_Due = input.Amount_Due - amount_paid;
										}
						)
					}
				}

			}
