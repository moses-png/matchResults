			On_Task_Location_Selected as "On Task Location Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Task_Location
				{
					actions 
					{
						custom deluge script
						(
											if(input.Job != null && input.Job.Job_No == "TJS02")
										{
											show Pick_Up_Section;
											show Work_Order_Task;
											enable Work_Order_Task;
											show Task_Location;
											enable Task_Location;
											show Small_Notes;
											enable Small_Notes;
											hide Card;
											hide Batch_Number_From;
											// Delivery is always Site To
											show Site_To;
											show Site_Location_To;
											enable Site_To;
											enable Site_Location_To;
											hide Party_To;
											hide Party_Location_To;
											if(input.Task_Location == "Company Sites")
											{
												show Site_From;
												show Site_Location_From;
												enable Site_From;
												enable Site_Location_From;
												hide Party_From;
												hide Party_Location_From;
											}
											else if(input.Task_Location == "Suppliers")
											{
												show Party_From;
												show Party_Location_From;
												enable Party_From;
												enable Party_Location_From;
												hide Site_From;
												hide Site_Location_From;
											}
											else
											{
												hide Site_From;
												hide Site_Location_From;
												hide Party_From;
												hide Party_Location_From;
												input.Site_From = null;
												input.Site_Location_From = null;
												input.Party_From = null;
												input.Party_Location_From = null;
											}
										}
						)
					}
				}

			}
			On_Tractor_Work_Report_Se as "On Tractor Work Report Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Tractor_Work_Report
				{
					actions 
					{
						custom deluge script
						(
											if(input.Tractor_Work_Report != null)
										{
											twr = Tractor_Work_Report[ID == input.Tractor_Work_Report];
											if(twr.ID != null)
											{
												if(twr.Batch_Number != null)
												{
													input.Batch_Number_From = twr.Batch_Number;
												}
												else
												{
													input.Batch_Number_From = null;
												}
												if(twr.Voucher != null && twr.Voucher.Site != null)
												{
													input.Site_From = twr.Voucher.Site;
													input.Display_Name_Site_From = ifnull(twr.Display_Name_Site,"");
												}
												else
												{
													input.Site_From = null;
													input.Display_Name_Site_From = "";
												}
											}
										}
										else
										{
											input.Batch_Number_From = null;
											input.Site_From = null;
											input.Display_Name_Site_From = "";
										}
						)
					}
				}

			}
			On_Truck_Movement_Voucher1 as "On Truck Movement Voucher Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Truck_Movement_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Truck_Movement_Voucher != null)
										{
											oldMove = Truck_Movement_Voucher[ID == input.Truck_Movement_Voucher];
											if(oldMove.ID != null)
											{
												input.Party_From = oldMove.Party_To;
												input.Display_Name_Party_From = oldMove.Display_Name_Party_To;
												input.Party_Location_From = oldMove.Party_Location_To;
												input.Pick_Up_From = oldMove.Delivery_To;
												input.Work_Done = "Return Truck To Site";
												input.Small_Notes = "Returning truck from previous delivery: " + oldMove.Display_Name_Voucher;
											}
										}
										else
										{
											input.Party_From = null;
											input.Display_Name_Party_From = "";
											input.Party_Location_From = null;
											input.Pick_Up_From = "";
											input.Work_Done = "";
											input.Small_Notes = "";
										}
						)
					}
				}

			}
			On_Voucher_Selected7 as "On Voucher Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Voucher != null)
										{
											input.Display_Name_Voucher = input.Voucher.Voucher_Number;
											empName = ifnull(input.Voucher.Employee.Employee_Name,"").trim();
											empNo = ifnull(input.Voucher.Employee.Employee_Number,"").toString().trim();
											if(empName != "" && empNo != "")
											{
												input.Display_Name_Employee = empName + " - " + empNo;
											}
											else if(empName != "")
											{
												input.Display_Name_Employee = empName;
											}
											else
											{
												input.Display_Name_Employee = null;
											}
											input.Display_Name_Site = input.Voucher.Display_Name_Site;
											if(input.Voucher.Asset != null)
											{
												input.Display_Name_Asset = input.Voucher.Asset.Asset_Name + " - " + input.Voucher.Asset.Asset_ID;
											}
											else
											{
												input.Display_Name_Asset = null;
											}
											input.Number_Plate_Truck_Register = null;
											if(input.Display_Name_Asset != null && input.Display_Name_Asset.trim() != "")
											{
												assetDisplay = input.Display_Name_Asset.trim();
												plate = assetDisplay;
												if(assetDisplay.contains(" - "))
												{
													plate = assetDisplay.getPrefix(" -").trim();
												}
												truckRec = Truck_Register[Number_Plate == plate];
												if(truckRec.ID != null)
												{
													input.Number_Plate_Truck_Register = ifnull(truckRec.Number_Plate,"");
												}
											}
											existing = Truck_Movement_Voucher[Voucher == input.Voucher];
											maxLine = 0;
											for each  rec in existing
											{
												if(input.ID != null && rec.ID == input.ID)
												{
													continue;
												}
												if(rec.Line_Number != null && rec.Line_Number > maxLine)
												{
													maxLine = rec.Line_Number;
												}
											}
											input.Line_Number = maxLine + 1;
										}
										else
										{
											input.Display_Name_Voucher = null;
											input.Display_Name_Employee = null;
											input.Display_Name_Site = null;
											input.Display_Name_Asset = null;
											input.Number_Plate_Truck_Register = null;
											input.Line_Number = null;
										}
						)
					}
				}

			}
