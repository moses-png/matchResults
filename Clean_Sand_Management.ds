	 			column = 1   
				width = medium
			)
			Bill_Type
			(
				type = picklist
				displayname = "Bill Type"
				maxchar = 100
				values = {"Store Bill","Invoice Bill","Employee Bill","Sales Voucher Bill"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vendor
			(
				type = picklist	
				values  = Vendor_Register.ID
