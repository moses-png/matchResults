			On_Status_Selected as "On Status Selected"
			{
				type =  form
				form = Product_Price_Register

				record event = on add or edit

				on user input of Status
				{
					actions 
					{
						custom deluge script
						(
											if(input.Status == "Inactive")
										{
											if(input.Effective_To == null)
											{
												input.Effective_To = zoho.currentdate;
											}
										}
										else if(input.Status == "Active")
										{
											if(input.Effective_From == null)
											{
												input.Effective_From = zoho.currentdate;
											}
										}
						)
					}
				}

			}
			On_Unit_Of_Measure_Select7 as "On Unit Of Measure Selected"
			{
				type =  form
				form = Product_Price_Register

				record event = on add or edit

				on user input of Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											if(input.Unit_Of_Measure != null)
										{
											input.Display_Name_Unit_Of_Measure = input.Unit_Of_Measure.Display_Name_Alternate_Unit_Of_Measure;
										}
										else
										{
											input.Display_Name_Unit_Of_Measure = "";
										}
						)
					}
				}

			}
			Full_Validation21 as "Full Validation"
			{
				type =  form
				form = Product_Price_Register

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Item == null)
										{
											alert "Item is required.";
											cancel submit;
										}
										if(input.Unit_Of_Measure == null)
										{
											alert "Unit Of Measure is required.";
											cancel submit;
										}
										if(input.Price_Type == null)
										{
											alert "Price Type is required.";
											cancel submit;
										}
										if(input.Unit_Price == null || input.Unit_Price <= 0)
										{
											alert "Unit Price must be greater than 0.";
											cancel submit;
										}
										if(input.Status == null)
										{
											input.Status = "Active";
										}
										if(input.Status == "Active")
										{
											dup = Product_Price_Register[Item == input.Item && Unit_Of_Measure == input.Unit_Of_Measure && Price_Type == input.Price_Type && Status == "Active" && ID != input.ID];
											if(dup.count() > 0)
											{
												alert "An active price already exists for this Item, Unit Of Measure and Price Type.";
												cancel submit;
											}
										}
						)
					}
				}

			}
