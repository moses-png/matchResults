			On_Stock_Receiving_Vouche1 as "On Stock Receiving Voucher Number Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Stock_Receiving_Voucher_Number
				{
					actions 
					{
						custom deluge script
						(
											// Format voucher number as 2 digits: 01, 02, 12
										num_txt = null;
										if(input.Stock_Receiving_Voucher_Number != null)
										{
											if(input.Stock_Receiving_Voucher_Number < 10)
											{
												num_txt = "0" + input.Stock_Receiving_Voucher_Number.toString();
											}
											else
											{
												num_txt = input.Stock_Receiving_Voucher_Number.toString();
											}
										}
										// Build Stock Receiving Voucher and Number
										if(input.Stock_Receiving_Voucher != null && num_txt != null)
										{
											srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
											if(srv.ID != null)
											{
												voucher_name = ifnull(srv.Display_Name_Stock_Receiving_Book,"").trim();
												if(voucher_name != "")
												{
													input.Stock_Receiving_Voucher_and_Number = voucher_name + "-" + num_txt;
												}
												else
												{
													input.Stock_Receiving_Voucher_and_Number = num_txt;
												}
											}
											else
											{
												input.Stock_Receiving_Voucher_and_Number = num_txt;
											}
										}
										else if(num_txt != null)
										{
											// Fallback if SRV not yet selected
											input.Stock_Receiving_Voucher_and_Number = num_txt;
										}
										else
										{
											input.Stock_Receiving_Voucher_and_Number = null;
										}
						)
					}
				}

			}
			On_Item_Issuing_Voucher_S1 as "On Item Issuing Voucher Selected"
			{
				type =  form
				form = Item_Issuing_Voucher

				record event = on add or edit

				on user input of Item_Issuing_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Item_Issuing_Voucher != null)
										{
											// Display Name (Voucher Number - Employee)
											input.Display_Name_Item_Issuing_Voucher = input.Item_Issuing_Voucher.Voucher_Number;
											// Issued By
											input.Issued_By = input.Item_Issuing_Voucher.Display_Name_Employee;
											// Item Issuing Date (Voucher Date_Time_In -> Voucher Created_Time -> Today)
											iiv_date = null;
											// Prefer Date_Time_In if it exists
											if(input.Item_Issuing_Voucher.Date_Time_In != null)
											{
												// Works if Date_Time_In is Date-Time
												iiv_date = input.Item_Issuing_Voucher.Date_Time_In.toDate();
											}
											else if(input.Item_Issuing_Voucher.Created_By_Time != null)
											{
												// Created_Time is usually Date-Time
												iiv_date = input.Item_Issuing_Voucher.Created_By_Time.toDate();
											}
											// Fallback
											if(iiv_date == null)
											{
												iiv_date = zoho.currentdate;
											}
											input.Item_Issuing_Date = iiv_date;
										}
										else
										{
											input.Display_Name_Item_Issuing_Voucher = null;
											input.Issued_By = null;
											input.Item_Issuing_Date = null;
										}
						)
					}
				}

			}
