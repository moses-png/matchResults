			On_Unit_Of_Measure_Select1 as "On Unit Of Measure Selected"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on user input of PO_Details.Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											// PURCHASE ORDER – PO Lines: On Unit Of Measure Selected
										for each  po_det in input.PO_Details
										{
											// If no Item or UOM
											if(po_det.Unit_Of_Measure == null || po_det.Item == null)
											{
												po_det.Display_Name_Unit_Of_Measure=null;
												po_det.Quantity_in_Base_Unit_Of_Measure=null;
												po_det.Line_Total=null;
												continue;
											}
											// Validate conversion
											check = store_management.po.check_uom_conversion_from_concrete(po_det.Item,po_det.Unit_Of_Measure);
											if(check.get("ok") != true)
											{
												alert check.get("message");
												po_det.Unit_Of_Measure=null;
												po_det.Display_Name_Unit_Of_Measure=null;
												po_det.Quantity_in_Base_Unit_Of_Measure=null;
												po_det.Line_Total=null;
												continue;
											}
											// Recalculate
											resp = store_management.po.recalculate_po_detail_line_from_concrete(po_det.Item,po_det.Unit_Of_Measure,po_det.Quantity_Ordered,po_det.Unit_Cost);
											po_det.Display_Name_Unit_Of_Measure=resp.get("display_uom_name");
											po_det.Quantity_in_Base_Unit_Of_Measure=resp.get("qty_in_base");
											po_det.Line_Total=resp.get("line_total");
										}
										// Recalculate PO total
										po_total = 0.0;
										for each  po_row in input.PO_Details
										{
											po_total = po_total + ifnull(po_row.Line_Total,0.0);
										}
										input.PO_Total = po_total;
						)
					}
				}

			}
			Finalize1 as "Finalize"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ===============================================
										// PURCHASE ORDER – FINALIZE
										// ===============================================
										// -----------------------------------------------
										// 1) Generate PO Number first
										// -----------------------------------------------
										if(input.PO_Number == null || input.PO_Number.trim() == "")
										{
											input.PO_Number = store_management.getNextOrderSequence("PO",input.Company.ID,input.PO_Type);
										}
										// -----------------------------------------------
										// 2) Refresh Display_Name_Company
										// -----------------------------------------------
										if(input.Company != null)
										{
											input.Display_Name_Company = input.Company.Company_Name + " - " + input.Company.Company_ID;
										}
										else
										{
											input.Display_Name_Company = null;
										}
										// -----------------------------------------------
										// 3) Company + PO Number
										// -----------------------------------------------
										full_name = "";
										if(input.Company != null)
										{
											company_name = ifnull(input.Company.Company_Name,"").trim();
											company_id = ifnull(input.Company.Company_ID,"").trim();
											if(company_name != "" && company_id != "")
											{
												full_name = company_name + " - " + company_id;
											}
											else
											{
												full_name = company_name;
											}
										}
										if(input.PO_Number != null && input.PO_Number.trim() != "")
										{
											if(full_name != "")
											{
												full_name = full_name + " - " + input.PO_Number.trim();
											}
											else
											{
												full_name = input.PO_Number.trim();
											}
										}
										Display_Name_Purchase_Order = full_name;
										// -----------------------------------------------
										// 4) Renumber PO Details + refresh display fields
										// -----------------------------------------------
										line_no = 0;
										po_total = 0.0;
										input.PO_Billed_Total = ifnull(input.PO_Billed_Total,0.0);
										input.PO_Total_Paid = ifnull(input.PO_Total_Paid,0.0);
										for each  po_det in input.PO_Details
										{
											if(po_det.Item != null)
											{
												line_no = line_no + 1;
												po_det.Purchase_Order_Number=line_no;
												po_det.Display_Name_Purchase_Order=full_name;
												if(input.PO_Number != null && input.PO_Number.trim() != "")
												{
													po_det.Purchase_Order_Details_Number=input.PO_Number.trim() + " - " + line_no.toString();
												}
												else
												{
													po_det.Purchase_Order_Details_Number=line_no.toString();
												}
												name_txt = ifnull(po_det.Item.Item_Name,"").trim();
												sku_txt = ifnull(po_det.Item.SKU,"").trim();
												if(sku_txt != "")
												{
													po_det.Display_Name_Item=name_txt + " - " + sku_txt;
												}
												else
												{
													po_det.Display_Name_Item=name_txt;
												}
												if(po_det.Unit_Of_Measure != null)
												{
													po_det.Display_Name_Unit_Of_Measure=po_det.Unit_Of_Measure.Unit_Of_Measure_Name;
												}
												else
												{
													po_det.Display_Name_Unit_Of_Measure=null;
												}
												po_total = po_total + ifnull(po_det.Line_Total,0.0);
											}
											else
											{
												po_det.Purchase_Order_Number=null;
												po_det.Purchase_Order_Details_Number=null;
												po_det.Display_Name_Purchase_Order=full_name;
												po_det.Display_Name_Item=null;
												po_det.Quantity_Received=ifnull(po_det.Quantity_Received,0.0);
												po_det.Quantity_Remaining=ifnull(po_det.Quantity_Remaining,ifnull(po_det.Quantity_Ordered,0.0));
												po_det.Quantity_Billable=ifnull(po_det.Quantity_Billable,0.0);
												po_det.Quantity_Billed=ifnull(po_det.Quantity_Billed,0.0);
												po_det.Quantity_Unbilled=ifnull(po_det.Quantity_Unbilled,ifnull(po_det.Quantity_Billable,0.0));
											}
										}
										input.PO_Total = po_total;
										// -----------------------------------------------
										// 5) Build payload for Store Management sync
										// -----------------------------------------------
										payload = Map();
										payload.put("Source_Record_ID",input.ID);
										payload.put("Source_Form","Concrete Products - Purchase Order");
										payload.put("PO_Type","External Purchase");
										payload.put("Company",input.Company);
										payload.put("Display_Name_Company",input.Display_Name_Company);
										payload.put("PO_Number",input.PO_Number);
										payload.put("PO_Date",input.PO_Date);
										payload.put("Receive_Status",input.Receive_Status);
										payload.put("PO_Status",input.PO_Status);
										payload.put("PO_Total",input.PO_Total);
										payload.put("Bill_Status",input.Bill_Status);
										payload.put("PO_Billed_Total",input.PO_Billed_Total);
										payload.put("Payment_Status",input.Payment_Status);
										payload.put("PO_Total_Paid",input.PO_Total_Paid);
										lines = List();
										for each  po_det in input.PO_Details
										{
											if(po_det.Item != null)
											{
												line = Map();
												line.put("Display_Name_Purchase_Order",po_det.Display_Name_Purchase_Order);
												line.put("Purchase_Order_Number",po_det.Purchase_Order_Number);
												line.put("Purchase_Order_Details_Number",po_det.Purchase_Order_Details_Number);
												line.put("Item",po_det.Item);
												line.put("Display_Name_Item",po_det.Display_Name_Item);
												line.put("Stock_Condition",po_det.Stock_Condition);
												line.put("Quantity_Ordered",po_det.Quantity_Ordered);
												line.put("Unit_Of_Measure",po_det.Unit_Of_Measure);
												line.put("Display_Name_Unit_Of_Measure",po_det.Display_Name_Unit_Of_Measure);
												line.put("Unit_Cost",po_det.Unit_Cost);
												line.put("Line_Total",po_det.Line_Total);
												line.put("Quantity_in_Base_Unit_Of_Measure",po_det.Quantity_in_Base_Unit_Of_Measure);
												line.put("Quantity_Received",po_det.Quantity_Received);
												line.put("Quantity_Remaining",po_det.Quantity_Remaining);
												line.put("Receiving_Status",po_det.Receiving_Status);
												line.put("Quantity_Billable",po_det.Quantity_Billable);
												line.put("Quantity_Billed",po_det.Quantity_Billed);
												line.put("Quantity_Unbilled",po_det.Quantity_Unbilled);
												line.put("Billing_Status",po_det.Billing_Status);
												lines.add(line);
											}
										}
										payload.put("Lines",lines);
										// -----------------------------------------------
										// 6) Sync to Store Management
										// -----------------------------------------------
										resp = store_management.po.syncPurchaseOrderFromConcrete(payload);
										info resp;
						)
					}
				}

			}
			On_Item_Selected5 as "On Item Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Item
				{
					actions 
					{
						custom deluge script
						(
											// ----------------------------------------
										// On Item Selected
										// Used for: Purchase Order only
										// Concrete Stock Receiving Details
										// ----------------------------------------
										if(input.Receiving_Type != "Purchase Order")
										{
											return;
										}
										if(input.Item != null)
										{
											input.Display_Name_Item = input.Item.Display_Name_Item;
											input.Quantity_to_Receive = ifnull(input.Item.Quantity_Remaining,0.0);
											input.Unit_Of_Measure_Received = input.Item.Unit_Of_Measure;
											input.Display_Name_Unit_Of_Measure_to_Receive = input.Item.Display_Name_Unit_Of_Measure;
											if(input.Item.Unit_Of_Measure != null)
											{
												input.Display_Name_Unit_Of_Measure_Received = input.Item.Unit_Of_Measure.Unit_Of_Measure_Name;
											}
											else
											{
												input.Display_Name_Unit_Of_Measure_Received = input.Item.Display_Name_Unit_Of_Measure;
											}
											Business_Division = null;
											Display_Name_Business_Site = "";
											Display_Name_Division = "";
											Display_Name_Business_Division = "";
											if(input.Stock_Receiving_Voucher != null && input.Stock_Receiving_Voucher.Business_Site != null)
											{
												Display_Name_Business_Site = input.Stock_Receiving_Voucher.Business_Site.Group_Number.toString();
												division_resp = store_management.getItemDivision(input.Item.Item);
												if(division_resp.get("ok") == true)
												{
													division_id = division_resp.get("Division_ID");
													bd_resp = grapes_group.getBusinessDivisionBySiteAndDivision(input.Stock_Receiving_Voucher.Business_Site.ID,division_id);
													if(bd_resp.get("ok") == true)
													{
														Business_Division = bd_resp.get("Business_Division_ID");
														Display_Name_Division = bd_resp.get("Display_Name_Division");
														Display_Name_Business_Division = bd_resp.get("Display_Name_Business_Division");
													}
													else
													{
														Display_Name_Division = division_resp.get("Division_Letter");
														Display_Name_Business_Division = ifnull(Display_Name_Business_Site,"") + ifnull(Display_Name_Division,"");
													}
												}
											}
											input.Quantity_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										}
										else
										{
											input.Display_Name_Item = "";
											input.Quantity_to_Receive = null;
											input.Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_to_Receive = "";
											input.Display_Name_Unit_Of_Measure_Received = "";
											Business_Division = null;
											Display_Name_Business_Site = "";
											Display_Name_Division = "";
											Display_Name_Business_Division = "";
											input.Quantity_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										}
						)
					}
				}

			}
			On_Item_Issuing_Detail_Se as "On Item Issuing Detail Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Item_Issuing_Details
				{
					actions 
					{
						custom deluge script
						(
											// ----------------------------------------
										// On Item Issuing Details Selected
										// Used for: Internal Transfer only
										// Concrete Stock Receiving Details
										// ----------------------------------------
										if(input.Receiving_Type != "Internal Transfer")
										{
											return;
										}
										if(input.Item_Issuing_Details == null)
										{
											input.Display_Name_Item = null;
											input.Stock_Condition = null;
											input.Quantity_to_Receive = null;
											input.Quantity_Received = null;
											input.Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_to_Receive = null;
											Display_Name_Unit_Of_Measure_Received = null;
											Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Rate = null;
											input.Line_Total = null;
											return;
										}
										issue_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
										if(issue_rec.ID == null)
										{
											return;
										}
										input.Display_Name_Item = ifnull(issue_rec.Display_Name_Item,"");
										input.Stock_Condition = ifnull(issue_rec.Stock_Condition,"New");
										issued_qty = ifnull(issue_rec.Quantity,0.0);
										returned_qty = ifnull(issue_rec.Quantity_Returned,0.0);
										remaining_qty = issued_qty - returned_qty;
										if(remaining_qty < 0)
										{
											remaining_qty = 0.0;
										}
										input.Quantity_to_Receive = remaining_qty;
										input.Quantity_Received = remaining_qty;
										item_id = issue_rec.Item;
										uom_id = issue_rec.Unit_Of_Measure;
										input.Unit_Of_Measure_Received = uom_id;
										input.Display_Name_Unit_Of_Measure_to_Receive = ifnull(issue_rec.Display_Name_Unit_Of_Measure,"");
										Display_Name_Unit_Of_Measure_Received = ifnull(issue_rec.Display_Name_Unit_Of_Measure,"");
										input.Rate = ifnull(issue_rec.Cost,0.0);
										base_qty = ifnull(issue_rec.Quantity_in_Base_Unit_Of_Measure,0.0);
										if(base_qty == null || base_qty <= 0 && item_id != null && uom_id != null && remaining_qty > 0)
										{
											check = store_management.po.check_uom_conversion_from_concrete(item_id,uom_id);
											if(check.get("ok") == true)
											{
												resp = store_management.po.recalculate_po_detail_line_from_concrete(item_id,uom_id,remaining_qty,input.Rate);
												base_qty = ifnull(resp.get("qty_in_base"),0.0);
											}
										}
										if(base_qty != null && base_qty > 0 && issued_qty > 0)
										{
											if(remaining_qty != issued_qty)
											{
												Quantity_in_Base_Unit_Of_Measure_Received = base_qty / issued_qty * remaining_qty;
											}
											else
											{
												Quantity_in_Base_Unit_Of_Measure_Received = base_qty;
											}
										}
										else
										{
											Quantity_in_Base_Unit_Of_Measure_Received = null;
										}
										if(input.Quantity_Received != null && input.Quantity_Received > 0 && input.Rate != null)
										{
											input.Line_Total = input.Quantity_Received * input.Rate;
										}
										else
										{
											input.Line_Total = null;
										}
						)
					}
				}

			}
			On_Stock_Return_Number as "On Stock Return Number"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Stock_Return_Number
				{
					actions 
					{
						custom deluge script
						(
											if(input.Stock_Return_Number != null)
										{
											issue_rec = Item_Issuing_Details[ID == input.Stock_Return_Number];
											input.Item_Issuing_Details = null;
											if(issue_rec.ID != null)
											{
												input.Display_Name_Voucher = ifnull(issue_rec.Request_Voucher,"");
											}
											else
											{
												input.Display_Name_Voucher = null;
											}
										}
										else
										{
											input.Item_Issuing_Details = null;
											input.Display_Name_Voucher = null;
										}
						)
					}
				}

			}
			On_Tool_Return_Number as "On Tool Return Number"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Tool_Return_Number
				{
					actions 
					{
						custom deluge script
						(
											if(input.Tool_Return_Number != null)
										{
											issue_rec = Item_Issuing_Details[ID == input.Tool_Return_Number];
											input.Item_Issuing_Details = null;
											if(issue_rec.ID != null)
											{
												input.Display_Name_Voucher = ifnull(issue_rec.Request_Voucher,"");
											}
											else
											{
												input.Display_Name_Voucher = null;
											}
										}
										else
										{
											input.Item_Issuing_Details = null;
											input.Display_Name_Voucher = null;
										}
						)
