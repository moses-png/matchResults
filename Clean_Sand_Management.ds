
 application "Clean Sand Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Africa/Kampala"
 	time format = "24-hr"

 	forms
	{
		form Asset_Issues
		{
			displayname = "Asset Issues"
			success message = "Data Added Successfully!"
			Asset_Issue_Details
			(
				type = section
				displayname = "Asset Issue Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Employee_Voucher
			(
				type = picklist	
				displayname = "Employee Voucher"
				values  = Voucher_Register.ID
    			displayformat = [Voucher_Number + " - " + Display_Name_Employee]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Voucher
			(
    			type = text
				displayname = "Voucher "
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reported_By
			(
    			type = text
				displayname = "Reported By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Site
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Number
			(
    			type = text
				displayname = "Issue Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Asset
			(
				type = picklist	
				values  = asset_management.Asset_List.ID
    			displayformat = [Asset_Name + " - " + Asset_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Asset
			(
    			type = text
				displayname = "Display Name Asset"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Site
			(
    			type = text
				displayname = "Current Site"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Custodian
			(
    			type = text
				displayname = "Current Custodian"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Odometer_Reading
			(
				type = decimal
				displayname = "Odometer Reading"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reported_Date
			(
    			type = datetime
				displayname = "Reported Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Description
			(
    			type = textarea
				displayname = "Issue Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Severity
			(
				type = picklist
				maxchar = 100
				values = {"Low","Medium","High","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)Clean_Sand_Management.ds
			Issue_Status
			(
				type = picklist
				displayname = "Issue Status"
				maxchar = 100
				values = {"Draft","Open","In progress","Resolved","Closed","Cancelled"}
				initial value = "Draft"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Attachments
			(
    			type = upload file
    			file count = 10
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Labour_Total
			(
				displayname = "Labour Total"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Parts_Total
			(
				displayname = "Parts Total"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Service_Task_Cost
			(
				displayname = "Total Service Task Cost"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Number_Of_Work_Order_Tasks
			(
				type = number
				displayname = "Number Of Work Order Tasks"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Work_Order
			(
				type = section
				displayname = "Work Order"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Resolve_Issue
			(
    			type = checkbox
				displayname = "Resolve Issue"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Reason_Why_Resolved
			(
    			type = textarea
				displayname = "Reason Why Resolved"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Order_Number
			(
    			type = text
				displayname = "Work Order Number"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Order_Date
			(
    			type = datetime
				displayname = "Work Order Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Order_Odometer_Reading
			(
				type = decimal
				displayname = "Work Order Odometer Reading"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Order_in_Charge_Of
			(
				type = picklist	
				displayname = "Work Order in Charge Of"
				values  = employee_management.Employee_Register.ID
    			displayformat = [Employee_Name + " - " + Employee_Number]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Display_Name_Work_Order_in_Charge_Of
			(
    			type = text
				displayname = "Display Name Work Order in Charge Of"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Order_Status
			(
				type = picklist
				displayname = "Work Order Status"
				maxchar = 100
				values = {"Draft","Pending","In Progress","Completed","Cancelled"}
				initial value = "Draft"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Cancel_Work_Order
			(
    			type = checkbox
				displayname = "Cancel Work Order"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Reason_Why_Cancelled
			(
    			type = textarea
				displayname = "Reason Why Cancelled"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Order_Tasks
			(
				type = grid
				displayname = "Work Order Tasks"
				values  = Work_Order_Tasks.ID
    			bidirectional = Work_Order
	 			row = 3
	 			column = 1   
				width = medium
			)
			Material_Request_Vouchers
			(
				type = grid
				displayname = "Material Request Vouchers"
				values  = Material_Request_Voucher.ID
    			bidirectional = Work_Order
	 			row = 4
	 			column = 1   
				width = medium
			)
			Issue_Status1
			(
				type = section
				displayname = "Issue Status "
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Overall_Start_Date
			(
    			type = datetime
				displayname = "Overall Start Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Odometer_Reading_Started
			(
				type = decimal
				displayname = "Odometer Reading Started"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Overall_End_Date
			(
    			type = datetime
				displayname = "Overall End Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Odometer_Reading_Ended
			(
				type = decimal
				displayname = "Odometer Reading Ended"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Sync_Details
			(
				type = section
				displayname = "Sync Details"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Source_Form
			(
    			type = text
				displayname = "Source Form"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Source_Record_ID
			(
				type = number
				displayname = "Source Record ID"
				maxchar = 19
	 			row = 6
	 			column = 1   
				width = medium
			)
			Back_End
			(
				type = section
				displayname = "Back End"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 7
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 7
	 			column = 1   
				width = medium
				personal data = true
			)
			User_Role
			(
    			type = text
				displayname = "User Role"
	 			row = 7
	 			column = 1   
				width = medium
			)
			Created_By_Name
			(
    			type = text
				displayname = "Created By Name"
	 			row = 7
	 			column = 1   
				width = medium
			)
			Created_By_Email
			(
    			type = email
				displayname = "Created By Email"
				maxchar = 80
	 			row = 7
	 			column = 1   
				width = medium
				personal data = true
			)
			Created_By_Time
			(
    			type = datetime
				displayname = "Created By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 7
	 			column = 1   
				width = medium
			)
			Updated_By_Name
			(
    			type = text
				displayname = "Updated By Name"
	 			row = 7
	 			column = 1   
				width = medium
			)
			Updated_By_Email
			(
    			type = email
				displayname = "Updated By Email"
				maxchar = 80
	 			row = 7
	 			column = 1   
				width = medium
				personal data = true
			)
			Updated_By_Time
			(
    			type = datetime
				displayname = "Updated By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 7
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Bill
		{
			success message = "Data Added Successfully!"
			Bill_Header
			(
				type = section
				displayname = "Bill Header"
				visibility = true
	 			row = 1
	 			column = 0   
