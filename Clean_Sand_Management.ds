			Full_Validation_On_Create3 as "Full Validation On Create"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											prefix_value = "FAA";
										if(input.ID == null && input.Fuel_Receiving_Voucher == null || input.Fuel_Receiving_Voucher.trim() == "")
										{
											new_voucher = asset_management.getNextSequence(prefix_value);
											if(new_voucher == null || new_voucher == "")
											{
												alert "Sequence not configured for " + prefix_value + " in Sequences form.";
												cancel submit;
											}
											dupe = Fuel_Receiving_Voucher[Fuel_Receiving_Voucher == new_voucher];
											if(dupe.count() > 0)
											{
												alert "Duplicate detected (" + new_voucher + "). Please try again.";
												cancel submit;
											}
											input.Fuel_Receiving_Voucher = new_voucher;
										}
						)
					}
				}

			}
			Set_Up_Form12 as "Set Up Form"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ===== BACK END FIELDS (HIDE + DISABLE) =====
										hide Back_End;
										hide User_Name;
										hide User_Email;
										hide User_Role;
										hide Created_By_Name;
										hide Created_By_Email;
										hide Created_By_Time;
										hide Updated_By_Name;
										hide Updated_By_Email;
										hide Updated_By_Time;
										hide Display_Name_Asset;
										hide Display_Name_Item_Issuing_Detail;
										hide Display_Name_Voucher;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// ===== DISABLE SYSTEM FIELDS =====
										disable Fuel_Receiving_Voucher;
										disable Supplied_By;
										// ===== HIDE BY DEFAULT =====
										hide Fuel_Receiving_Voucher;
										// ===== CREATE MODE =====
										if(input.ID == null)
										{
											hide Fuel_Receiving_Voucher;
											hide Vendor;
											hide Store;
											hide Display_Name_Store;
											hide Item_Issuing_Detail;
											hide Supplied_By;
											hide Rate;
											hide Status;
										}
										else
										{
											// EDIT MODE
											show Vendor;
											show Store;
										}
										// ===== CONTROL ITEM ISSUING =====
										if(input.Issued_By == "Fuel Tank")
										{
											show Item_Issuing_Detail;
										}
										else
										{
											hide Item_Issuing_Detail;
										}
						)
					}
				}

			}
			On_Asset_Selected as "On Asset Selected"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add or edit

				on user input of Asset
				{
					actions 
					{
						custom deluge script
						(
											if(input.Asset != null)
										{
											input.Display_Name_Asset = input.Asset.Asset_Name + " - " + input.Asset.Asset_ID;
											if(input.Fuel_Issuing_Time == null)
											{
												input.Fuel_Issuing_Time = zoho.currenttime;
											}
											if(input.Asset.Odometer_Unit_Of_Measure == "days")
											{
												base_odometer = ifnull(input.Asset.Odometer_Reading,0);
												last_read_date = input.Asset.Date_Time_Odometer_Read;
												if(last_read_date != null && input.Fuel_Issuing_Time != null)
												{
													days_used = last_read_date.toDate().daysBetween(input.Fuel_Issuing_Time.toDate());
													input.Odometer = base_odometer + days_used;
												}
												else
												{
													input.Odometer = base_odometer;
												}
												disable Odometer;
											}
											else
											{
												input.Odometer = null;
												enable Odometer;
											}
										}
										else
										{
											input.Display_Name_Asset = null;
											input.Odometer = null;
											enable Odometer;
										}
						)
					}
				}

			}
