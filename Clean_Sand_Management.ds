			Set_Up_Form37 as "Set Up Form"
			{
				type =  form
				form = Meter_Reading

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// METER READING -> SET UP FORM
										// ======================================
										// --------------------------------------
										// DISABLE SYSTEM / AUTO FILL FIELDS
										// --------------------------------------
										disable Display_Name_Voucher;
										disable Display_Name_Employee;
										disable Display_Name_Site;
										disable Unit_Of_Measure;
										disable Previous_Reading_Date;
										disable Previous_Reading;
										disable Consumption;
										disable Account;
										disable Current_Site;
										disable Location;
										// --------------------------------------
										// BACK END FIELDS
										// --------------------------------------
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										disable Status;
										// --------------------------------------
										// HIDE DISPLAY / BACK END FIELDS
										// --------------------------------------
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										hide Display_Name_Site;
										hide Previous_Reading_Date;
										hide Previous_Reading;
										hide Current_Reading_Date;
										hide Consumption;
										hide Status;
										hide Account;
										hide Current_Site;
										hide Back_End;
										// --------------------------------------
										// AUTO FILL USER INFO
										// --------------------------------------
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// --------------------------------------
										// CREATE MODE
										// --------------------------------------
										if(input.ID == null)
										{
											if(input.Status == null)
											{
												input.Status = "Draft";
											}
										}
										// --------------------------------------
										// EDIT MODE
										// --------------------------------------
										else
										{
											show Current_Reading_Date;
											enable Current_Reading_Date;
											disable Status;
										}
						)
					}
				}

			}
			Set_Up_Form38 as "Set Up Form"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//HIDE FIELDS
										//Voucher Details
										hide Display_Name_Voucher;
										//Allocation Details
										hide Display_Name_Invoice_Voucher;
										hide Business_Division_Details;
										//Amount Details
										hide Amount_Allocated;
										hide Amount_Credited;
										hide Amount_Not_Allocated;
										hide Customer_Deposit_Number;
										hide Customer_Deposit_Voucher;
										//Back End
										hide Back_End;
										//DISABLE FIELDS
										//Voucher Details
										disable Display_Name_Voucher;
										disable Line_Number;
										//Allocation Details
										disable Display_Name_Invoice_Voucher;
										//Amount Details
										disable Amount_Due;
										disable Balance_Due;
										disable Amount_Not_Allocated;
										disable Customer;
										//Back End
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// ======================================================
										// 2) CREATE MODE
										// ======================================================
										if(input.ID == null)
										{
											// Hide both until Payment Type is selected
											hide Sales_Voucher;
											hide Invoice;
											hide Credit_Note_Voucher;
											hide Payment_Receipt_Voucher;
											input.Sales_Voucher = null;
											input.Invoice = null;
										}
										// ======================================================
										// 3) EDIT MODE
										// ======================================================
										else
										{
											// Preserve selected values and show correct field
											if(input.Payment_Document == "Sales Voucher")
											{
												show Sales_Voucher;
												hide Invoice;
											}
											else if(input.Payment_Document == "Invoice")
											{
												show Invoice;
												hide Sales_Voucher;
											}
											else
											{
												hide Sales_Voucher;
												hide Invoice;
											}
										}
										// ======================================================
										// 4) PAYMENT TYPE VISIBILITY
										// Applies after Create/Edit setup
										// ======================================================
										if(input.Payment_Document == "Sales Voucher")
										{
											show Sales_Voucher;
											hide Invoice;
											if(input.ID == null)
											{
												input.Invoice = null;
											}
										}
										else if(input.Payment_Document == "Invoice")
										{
											show Invoice;
											hide Sales_Voucher;
											if(input.ID == null)
											{
												input.Sales_Voucher = null;
											}
										}
										else
										{
											hide Sales_Voucher;
											hide Invoice;
											if(input.ID == null)
											{
												input.Sales_Voucher = null;
												input.Invoice = null;
											}
										}
						)
					}
				}

			}
			On_Current_Reading_Select as "On Current Reading Selected"
			{
				type =  form
				form = Meter_Reading

				record event = on add or edit

				on user input of Current_Reading
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// METER READING -> ON CURRENT READING SELECTED
										// ======================================
										if(input.Current_Reading != null)
										{
											if(input.Previous_Reading == null)
											{
												input.Previous_Reading = 0;
											}
											if(input.Current_Reading < input.Previous_Reading)
											{
												alert "Current Reading cannot be less than Previous Reading.";
												input.Current_Reading = null;
												input.Consumption = null;
											}
											else
											{
												baseConsumption = input.Current_Reading - input.Previous_Reading;
												finalConsumption = baseConsumption;
												if(input.Unit_Of_Measure != null && input.Unit_Of_Measure.contains("CT Ratio"))
												{
													parts = input.Unit_Of_Measure.toList(" ");
													if(parts.size() >= 3)
													{
														ctRatioText = parts.get(2);
														if(ctRatioText != null && ctRatioText != "")
														{
															finalConsumption = baseConsumption * ctRatioText.toDecimal();
														}
													}
												}
												input.Consumption = finalConsumption;
												if(input.Current_Reading_Date == null)
												{
													input.Current_Reading_Date = zoho.currenttime;
												}
											}
										}
										else
										{
											input.Consumption = null;
										}
						)
					}
				}

			}
			On_Current_Reading_Date_S as "On Current Reading Date Selected"
			{
				type =  form
				form = Meter_Reading

				record event = on add or edit

				on user input of Current_Reading_Date
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// METER READING -> ON CURRENT READING DATE SELECTED
										// ======================================
										if(input.Current_Reading_Date != null)
										{
											if(input.Meter != null)
											{
												prevList = Meter_Reading[Meter == input.Meter && ID != input.ID && Current_Reading_Date < input.Current_Reading_Date] sort by Current_Reading_Date desc;
												input.Previous_Reading = 0;
												input.Previous_Reading_Date = null;
												for each  p in prevList
												{
													input.Previous_Reading = ifnull(p.Current_Reading,0.0);
													input.Previous_Reading_Date = p.Current_Reading_Date;
													break;
												}
											}
											if(input.Current_Reading != null)
											{
												if(input.Previous_Reading == null)
												{
													input.Previous_Reading = 0;
												}
												if(input.Current_Reading < input.Previous_Reading)
												{
													alert "Current Reading cannot be less than Previous Reading.";
													input.Consumption = null;
												}
												else
												{
													baseConsumption = input.Current_Reading - input.Previous_Reading;
													finalConsumption = baseConsumption;
													if(input.Unit_Of_Measure != null && input.Unit_Of_Measure.contains("CT Ratio"))
													{
														parts = input.Unit_Of_Measure.toList(" ");
														if(parts.size() >= 3)
														{
															ctRatioText = parts.get(2);
															if(ctRatioText != null && ctRatioText != "")
															{
																finalConsumption = baseConsumption * ctRatioText.toDecimal();
															}
														}
													}
													input.Consumption = finalConsumption;
												}
											}
										}
										else
										{
											input.Previous_Reading = null;
											input.Previous_Reading_Date = null;
											input.Consumption = null;
										}
						)
					}
				}

			}
			On_Amount_Allocated_Selec as "On Amount Allocated Selected"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on user input of Amount_Allocated
				{
					actions 
					{
						custom deluge script
						(
											amount_allocated = ifnull(input.Amount_Allocated,0.0);
										// =====================================================
										// CASH + CASH DEPOSIT DOCUMENT
										// =====================================================
										if(input.Payment_Type == "Cash" && input.Payment_Document == "Cash Deposit" && input.Payment_Receipt_Voucher != null)
										{
											receipt_available = ifnull(input.Payment_Receipt_Voucher.Total_Amount_Not_Allocated,0.0);
											input.Amount_Not_Allocated = receipt_available;
											if(ifnull(input.Amount_Allocated,0.0) > receipt_available)
											{
												alert "Amount Allocated cannot exceed receipt Amount Not Allocated.";
												input.Amount_Allocated = receipt_available;
											}
										}
										//=====================================================
										// NORMAL CASH ALLOCATION
										// =====================================================
										else
										{
											amount_due = ifnull(input.Amount_Due,0.0);
											voucher_total = ifnull(input.Payment_Receipt_Voucher.Total_Amount_Received,0.0);
											if(amount_allocated > amount_due)
											{
												alert "Amount Allocated cannot be greater than Amount Due.";
												input.Amount_Allocated = amount_due;
												amount_allocated = amount_due;
											}
											already_allocated = 0.0;
											for each  rec in Payment_Receipt_Details[Payment_Receipt_Voucher == input.Payment_Receipt_Voucher && ID != input.ID]
											{
												already_allocated = already_allocated + ifnull(rec.Amount_Allocated,0.0);
											}
											available = voucher_total - already_allocated;
											if(available < 0)
											{
												available = 0.0;
											}
											if(amount_allocated > available)
											{
												alert "Amount Allocated cannot exceed Total Amount Received. Available amount is: " + available;
												input.Amount_Allocated = available;
												amount_allocated = available;
											}
											input.Balance_Due = amount_due - amount_allocated;
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0.0;
											}
										}
						)
					}
				}

			}
			On_Employee_Voucher_Selec2 as "On Employee Voucher Selected"
			{
				type =  form
				form = Meter_Reading

				record event = on add or edit

				on user input of Employee_Voucher
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// METER READING -> ON EMPLOYEE VOUCHER SELECTED
										// ======================================
										if(input.Employee_Voucher != null)
										{
											input.Display_Name_Voucher = ifnull(input.Employee_Voucher.Voucher_Number,"");
											input.Display_Name_Employee = ifnull(input.Employee_Voucher.Display_Name_Employee,"");
											input.Display_Name_Site = ifnull(input.Employee_Voucher.Display_Name_Site,"");
											input.Account = ifnull(input.Employee_Voucher.Display_Name_Site,"");
										}
										else
										{
											input.Display_Name_Voucher = "";
											input.Display_Name_Employee = "";
											input.Display_Name_Site = "";
											input.Account = "";
										}
						)
					}
				}

			}
			On_Credit_Note_Voucher_Se as "On Credit Note Voucher Selected"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on user input of Credit_Note_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Credit_Note_Voucher != null)
										{
											input.Display_Name_Voucher = input.Credit_Note_Voucher.Credit_Note_Number;
											input.Payment_Document = "Sales Voucher";
											if(input.Credit_Note_Voucher.Sales_Voucher != null)
											{
												input.Sales_Voucher = input.Credit_Note_Voucher.Sales_Voucher.ID;
												input.Display_Name_Invoice_Voucher = input.Credit_Note_Voucher.Sales_Voucher.Sales_Voucher_Number;
											}
											else
											{
												input.Sales_Voucher = null;
												input.Display_Name_Invoice_Voucher = "";
											}
											max_line = 0;
											existing_lines = Payment_Receipt_Details[Payment_Receipt_Voucher == input.Payment_Receipt_Voucher && Credit_Note_Voucher == input.Credit_Note_Voucher];
											for each  r in existing_lines
											{
												if(ifnull(r.Line_Number,0) > max_line)
												{
													max_line = r.Line_Number;
												}
											}
											input.Line_Number = max_line + 1;
											input.Amount_Due = ifnull(input.Credit_Note_Voucher.Amount_Due,0.0);
											input.Amount_Credited = ifnull(input.Credit_Note_Voucher.Credit_Amount,0.0);
											input.Balance_Due = input.Amount_Due - input.Amount_Credited;
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0.0;
											}
											disable Amount_Credited;
										}
						)
					}
				}

			}
