		form Bill
		{
			success message = "Data Added Successfully!"
			Bill
			(
				type = section
				displayname = "Bill "
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Company
			(
				type = picklist	
				values  = company_management.Company_Register.ID
    			displayformat = [Company_Name + " - " + Company_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Company
			(
    			type = text
				displayname = "Display Name Company"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Bill_Date
			(
    			type = date
				displayname = "Bill Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Bill_Type
			(
				type = picklist
				displayname = "Bill Type"
				maxchar = 100
				values = {"External Bill","Invoice Bill","Employee Bill","Sales Voucher Bill"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vendor
			(
				type = picklist	
				values  = vendor_and_client_management.Business_Partners_Register.ID
    			displayformat = [Party_Name + " - " + Party_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee_Vendor
			(
				type = picklist	
