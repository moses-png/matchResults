										disable Customer_Allocations.Display_Name_Invoice_Voucher;
										disable Customer_Allocations.Amount_Due;
										disable Customer_Allocations.Amount_Not_Allocated;
										disable Customer_Allocations.Amount_Allocated;
										disable Customer_Allocations.Balance_Due;
