					(
						sender type : "users"
						to : "phmak00104@gmail.com"
						title : "Record Updated"
						message : "${zoho.loginuserid} has updated a record in form Truck Movement Voucher"
						view: "All_Truck_Movement_Vouchers"
					)
					}
				}

			}
			Set_Up_Form43 as "Set Up Form"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// TRUCK MOVEMENT VOUCHER - ON LOAD
										// ======================================
										is_create = input.ID == null;
										// =======================
										// 1. DISABLE DISPLAY / AUTO FIELDS
										// =======================
										disable Voucher;
										disable Display_Name_Voucher;
										disable Display_Name_Employee;
										disable Display_Name_Site;
										disable Display_Name_Asset;
										disable Line_Number;
										disable Number_Plate_Truck_Register;
										disable Work_Done;
										// ======================================
										//Pick Up Section
										// ======================================
										disable Display_Name_Party_From;
										disable Display_Name_Site_From;
										disable Pick_Up_From;
										disable Time_Start;
										// ======================================
										//Delivery Section
										// ======================================
										disable Display_Name_Party_To;
										disable Display_Name_Site_To;
										disable Delivery_To;
										disable Time_End;
										disable Reason_Why_Cancelled;
										disable Truck_Movement_Voucher_Status;
										// ======================================
										//Line Summary
										// ======================================
										disable Cost_Per_Odometer;
										disable Line_Total;
										disable Line_Duration_Minutes;
										disable Line_Distance_Travelled;
										// ======================================
										//Back End
										// ======================================
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// =======================
										// 2. DEFAULT HIDE SECTIONS / JOB FIELDS
										// =======================
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										hide Display_Name_Site;
										hide Display_Name_Asset;
										hide Line_Number;
										//hide Number_Plate_Truck_Register;
										hide Card;
										hide Work_Order_Task;
										hide Batch_Number_From;
										hide Truck_Movement_Voucher;
										hide Task_Location;
										hide Small_Notes;
										hide Tractor_Work_Report;
										// ======================================
										//Pick Up Section
										// ======================================
										hide Pick_Up_Section;
										hide Display_Name_Party_From;
										hide Display_Name_Site_From;
										//hide Time_Start;
										hide Display_Name_Job;
										hide Display_Name_Card;
										// ======================================
										//Delivery Section
										// ======================================
										hide Delivery_Section;
										hide Display_Name_Party_To;
										hide Display_Name_Site_To;
										//hide Time_End;
										hide Line_Summary;
										hide Batch_Number_To;
										//hide Back_End;
										hide Services;
										hide Services.Display_Name_Bill;
										hide Services.Bill;
										hide Services.Display_Name_Service;
										hide Services.Display_Name_Voucher;
										hide Services.Invoice;
										hide Services.Last_Synced_Group_Amount;
										hide Services.Last_Synced_Group_ID;
										hide Services.User_Role;
										hide Services.User_Email;
										hide Services.User_Name;
										hide Services.Created_By_Time;
										hide Services.Created_By_Name;
										hide Services.Created_By_Email;
										hide Services.Updated_By_Name;
										hide Services.Updated_By_Time;
										hide Services.Updated_By_Email;
										// =======================
										// 3. JOB CONTROL
										// =======================
										if(input.Job != null)
										{
											jobNo = input.Job.Job_No;
											if(jobNo == "TJS01")
											{
												show Pick_Up_Section;
												show Card;
												enable Card;
												hide Work_Order_Task;
												hide Batch_Number_From;
												hide Truck_Movement_Voucher;
												hide Task_Location;
												hide Small_Notes;
												show Site_From;
												show Site_Location_From;
												disable Site_From;
												enable Site_Location_From;
												hide Party_From;
												hide Party_Location_From;
												show Delivery_Section;
												show Delivery_Location;
												enable Delivery_Location;
												show Odometer_End;
												show Time_End;
												show Delivery_To_Image;
												show Cancel_Voucher;
												show Truck_Movement_Voucher_Status;
												disable Truck_Movement_Voucher_Status;
												hide Reason_Why_Cancelled;
												if(input.Delivery_Location == "Company Sites")
												{
													show Site_To;
													show Site_Location_To;
													enable Site_To;
													enable Site_Location_To;
													hide Party_To;
													hide Party_Location_To;
												}
												else if(input.Delivery_Location == "Suppliers")
												{
													show Party_To;
													show Party_Location_To;
													enable Party_To;
													enable Party_Location_To;
													hide Site_To;
													hide Site_Location_To;
												}
												else
												{
													hide Site_To;
													hide Site_Location_To;
													hide Party_To;
													hide Party_Location_To;
												}
												if(is_create)
												{
													input.Work_Order_Task = null;
													input.Batch_Number_From = null;
													input.Truck_Movement_Voucher = null;
													input.Task_Location = null;
													input.Small_Notes = null;
													input.Party_From = null;
													input.Party_Location_From = null;
													if(input.Delivery_Location == "Company Sites")
													{
														input.Party_To = null;
														input.Display_Name_Party_To = "";
														input.Party_Location_To = null;
													}
													else if(input.Delivery_Location == "Suppliers")
													{
														input.Site_To = null;
														input.Display_Name_Site_To = "";
														input.Site_Location_To = null;
