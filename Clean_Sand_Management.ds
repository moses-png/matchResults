												for each  r in Payment_Receipt_Details[Customer_Deposit_Voucher == input.Customer_Deposit_Voucher && ID != input.ID]
												{
													if(ifnull(r.Line_Number,0) > max_line)
													{
														max_line = r.Line_Number;
													}
												}
												input.Line_Number = max_line + 1;
												input.Customer = cd.Display_Name_Customer;
												input.Amount_Not_Allocated = ifnull(cd.Total_Amount_Not_Allocated,0.0);
