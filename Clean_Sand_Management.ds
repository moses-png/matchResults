			On_Bill_Selected1 as "On Bill Selected"
			{
				type =  form
				form = Bill_Details

				record event = on add or edit

				on user input of Bill
				{
					actions 
					{
						custom deluge script
						(
											// Fetch selected Bill record
										bill_rec = Bill[ID == input.Bill];
										if(bill_rec.ID != null)
										{
											// Build display name: Bill Name - Bill Number
											input.Display_Name_Bill = bill_rec.Bill_Name + " - " + bill_rec.Bill_Number;
										}
										else
										{
											// Clear if no bill selected
											input.Display_Name_Bill = "";
										}
										if(input.Stock_Receiving_Details != null)
										{
											recv_id = input.Stock_Receiving_Details.ID;
											recv_rec = Stock_Receiving_Details[ID == recv_id];
											if(recv_rec.ID != null)
											{
												if(input.Bill != null)
												{
													recv_rec.Stock_Receiving_Details_Status="Invoiced";
												}
												else
												{
													recv_rec.Stock_Receiving_Details_Status="Received";
												}
											}
										}
						)
					}
				}

			}
			On_Item_Selected7 as "On Item Selected"
			{
				type =  form
				form = Bill_Details

				record event = on add or edit

				on user input of Item
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Concrete Bill Details
										// On User Input: Item (PO Detail)
										// =======================================
										input.Display_Name_Item = null;
										input.Unit_Of_Measure = null;
										input.Display_Name_Unit_Of_Measure = null;
										input.Quantity_Billable = 0.0;
										input.Base_Unit_Of_Measure = null;
										input.Quantity_In_Base_Unit = 0.0;
										input.Rate_In_Base_Unit = 0.0;
										if(input.Item != null)
										{
											po_det = Purchase_Order_Details[ID == input.Item];
											if(po_det.ID != null && po_det.Item != null)
											{
												item_rec = po_det.Item;
												name = ifnull(item_rec.Item_Name,"");
												sku = ifnull(item_rec.SKU,"");
												if(sku != "")
												{
													input.Display_Name_Item = name + " - " + sku;
												}
												else
												{
													input.Display_Name_Item = name;
												}
												input.Base_Unit_Of_Measure = item_rec.Display_Name_Base_Unit_Of_Measure;
												input.Unit_Of_Measure = po_det.Unit_Of_Measure;
												if(po_det.Unit_Of_Measure != null)
												{
													input.Display_Name_Unit_Of_Measure = po_det.Unit_Of_Measure.Unit_Of_Measure_Name;
												}
												input.Quantity_Billable = ifnull(po_det.Quantity_Unbilled,0.0);
												if(input.Quantity != null && input.Quantity > 0 && input.Unit_Of_Measure != null)
												{
													base_qty = store_management.po.convert_to_base_qty_from_concrete(item_rec.ID,input.Unit_Of_Measure,input.Quantity);
													if(base_qty != null && base_qty > 0)
													{
														input.Quantity_In_Base_Unit = base_qty;
														current_line = ifnull(input.Quantity,0.0) * ifnull(input.Rate,0.0);
														if(current_line > 0)
														{
															input.Rate_In_Base_Unit = current_line / base_qty;
														}
													}
												}
											}
										}
										// Bill total check
										if(input.Bill != null)
										{
											bill_rec = Bill[ID == input.Bill];
											if(bill_rec.ID != null)
											{
												total_amt = 0.0;
												for each  row in bill_rec.Bill_Details
												{
													if(row.ID != input.ID)
													{
														total_amt = total_amt + ifnull(row.Line_Total,0.0);
													}
												}
												current_line = ifnull(input.Quantity,0.0) * ifnull(input.Rate,0.0);
												new_total = total_amt + current_line;
												diff = new_total - ifnull(bill_rec.Bill_Total,0.0);
												if(diff >= 1)
												{
													alert "Cannot add this item. Total exceeds Bill Total (" + bill_rec.Bill_Total + ").";
													return;
												}
											}
										}
						)
					}
				}

			}
			On_Quantity_Selected2 as "On Quantity Selected"
			{
				type =  form
				form = Bill_Details

				record event = on add or edit

				on user input of Quantity
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Bill Details
										// On User Input: Quantity
										// =======================================
										// Reset first
										input.Quantity_In_Base_Unit = 0.0;
										input.Rate_In_Base_Unit = 0.0;
										if(input.Quantity != null && input.Quantity > 0)
										{
											item_id = null;
											base_qty = 0.0;
											// 1) Purchase Order billing
											if(input.Item != null)
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID != null && po_det.Item != null)
												{
													item_id = po_det.Item;
												}
											}
											// 2) Stock Receiving billing
											else if(input.Stock_Receiving_Details != null)
											{
												sr_det = Stock_Receiving_Details[ID == input.Stock_Receiving_Details];
												if(sr_det.ID != null)
												{
													if(sr_det.Item != null)
													{
														po_det = Purchase_Order_Details[ID == sr_det.Item];
														if(po_det.ID != null && po_det.Item != null)
														{
															item_id = po_det.Item;
														}
													}
													else if(sr_det.Stock_Created != null)
													{
														bundle_rec = Stock_Bundling_Note[ID == sr_det.Stock_Created];
														if(bundle_rec.ID != null && bundle_rec.Item != null)
														{
															item_id = bundle_rec.Item;
														}
													}
													else if(sr_det.Item_Issuing_Details != null)
													{
														iss_det = Item_Issuing_Details[ID == sr_det.Item_Issuing_Details];
														if(iss_det.ID != null && iss_det.Item != null)
														{
															item_id = iss_det.Item;
														}
													}
												}
											}
											// 3) Parts & Consumables billing
											else if(input.Parts_Consumables != null)
											{
												pc = Parts_Consumables[ID == input.Parts_Consumables];
												if(pc.ID != null && pc.Item != null)
												{
													item_id = pc.Item;
												}
											}
											// Convert quantity to base unit
											if(item_id != null && input.Unit_Of_Measure != null)
											{
												base_qty = store_management.po.convert_to_base_qty_from_concrete(item_id,input.Unit_Of_Measure,input.Quantity);
												if(base_qty != null && base_qty > 0)
												{
													input.Quantity_In_Base_Unit = base_qty;
													current_line = ifnull(input.Quantity,0.0) * ifnull(input.Rate,0.0);
													if(current_line > 0)
													{
														input.Rate_In_Base_Unit = current_line / base_qty;
													}
												}
											}
										}
										// Bill total validation
										if(input.Bill != null)
										{
											bill_rec = Bill[ID == input.Bill];
											if(bill_rec.ID != null)
											{
												total_amt = 0.0;
												for each  row in bill_rec.Bill_Details
												{
													if(row.ID != input.ID)
													{
														total_amt = total_amt + ifnull(row.Line_Total,0.0);
													}
												}
												current_line = ifnull(input.Quantity,0.0) * ifnull(input.Rate,0.0);
												new_total = total_amt + current_line;
												diff = new_total - ifnull(bill_rec.Bill_Total,0.0);
												if(diff > 10)
												{
													alert "Cannot add this item. Total exceeds Bill Total by " + diff.toString() + ". Maximum allowed excess is 10.";
													input.Quantity_In_Base_Unit = 0.0;
													input.Rate_In_Base_Unit = 0.0;
													return;
												}
											}
										}
						)
					}
				}

			}
			On_Rate_Selected1 as "On Rate Selected"
			{
				type =  form
				form = Bill_Details

				record event = on add or edit

				on user input of Rate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Bill Details - On User Input: Rate
										// =======================================
										input.Quantity_In_Base_Unit = 0.0;
										input.Rate_In_Base_Unit = 0.0;
										if(input.Rate != null && input.Rate > 0)
										{
											if(input.Quantity == null || input.Quantity <= 0)
											{
												alert "Please enter Quantity first.";
												input.Rate = null;
												return;
											}
											item_id = null;
											uom_id = input.Unit_Of_Measure;
											if(input.Item != null)
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID != null && po_det.Item != null)
												{
													item_id = po_det.Item;
												}
											}
											else if(input.Stock_Receiving_Details != null)
											{
												sr_det = Stock_Receiving_Details[ID == input.Stock_Receiving_Details];
												if(sr_det.ID != null && sr_det.Item != null)
												{
													po_det = Purchase_Order_Details[ID == sr_det.Item];
													if(po_det.ID != null && po_det.Item != null)
													{
														item_id = po_det.Item;
													}
												}
											}
											else if(input.Parts_Consumables != null)
											{
												pc = Parts_Consumables[ID == input.Parts_Consumables];
												if(pc.ID != null && pc.Item != null)
												{
													item_id = pc.Item;
												}
											}
											if(item_id != null && uom_id != null)
											{
												base_qty = store_management.po.convert_to_base_qty_from_concrete(item_id,uom_id,input.Quantity);
												if(base_qty != null && base_qty > 0)
												{
													current_line = ifnull(input.Quantity,0.0) * ifnull(input.Rate,0.0);
													if(input.Bill != null)
													{
														bill_rec = Bill[ID == input.Bill];
														if(bill_rec.ID != null)
														{
															total_amt = 0.0;
															for each  row in bill_rec.Bill_Details
															{
																if(row.ID != input.ID)
																{
																	total_amt = total_amt + ifnull(row.Line_Total,0.0);
																}
															}
															new_total = total_amt + current_line;
															diff = new_total - ifnull(bill_rec.Bill_Total,0.0);
															if(diff > 10)
															{
																alert "Cannot add this item. Total exceeds Bill Total by " + diff.toString() + ". Maximum allowed excess is 10.";
																input.Quantity_In_Base_Unit = 0.0;
																input.Rate_In_Base_Unit = 0.0;
																return;
															}
														}
													}
													input.Quantity_In_Base_Unit = base_qty;
													input.Rate_In_Base_Unit = current_line / base_qty;
												}
											}
										}
						)
					}
				}

			}
			Finalize2 as "Finalize"
			{
				type =  form
				form = Bill_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// CONCRETE BILL DETAILS
										// =======================================
										rec = Bill_Details[ID == input.ID];
										// =====================================================
										// 1) Update current Bill Details row FIRST
										// =====================================================
										if(rec.ID != null)
										{
											if(rec.Details_Date == null)
											{
												rec.Details_Date=zoho.currenttime;
											}
											if(rec.Bill != null)
											{
												rec.Bill_Details_Status="Billed";
											}
											else
											{
												rec.Bill_Details_Status="Draft";
											}
										}
										// =====================================================
										// 2) Auto Line Number
										// =====================================================
										if(rec.ID != null && rec.Bill != null && rec.Line_Number == null || rec.Line_Number <= 0)
										{
											next_line_no = 1;
											existing_rows = Bill_Details[Bill == rec.Bill] sort by Line_Number desc;
											for each  ex in existing_rows
											{
												next_line_no = ifnull(ex.Line_Number,0) + 1;
												break;
											}
											rec.Line_Number=next_line_no;
										}
										// =====================================================
										// 3) Recalculate CURRENT Bill Header
										// =====================================================
										if(rec.ID != null && rec.Bill != null)
										{
											new_bill = Bill[ID == rec.Bill];
											if(new_bill.ID != null)
											{
												details_total = 0.0;
												for each  bd1 in Bill_Details[Bill == new_bill.ID]
												{
													details_total = details_total + ifnull(bd1.Line_Total,0.0);
												}
												services_total = 0.0;
												for each  srv in Service_Details[Bill == new_bill.ID]
												{
													services_total = services_total + ifnull(srv.Line_Total,0.0);
												}
												grand_total = round(details_total + services_total,2);
												new_bill.Services_Total=round(services_total,2);
												new_bill.Total_Amount=grand_total;
												if(new_bill.Tax_Amount == null)
												{
													new_bill.Tax_Amount=0.0;
												}
												if(new_bill.Discount_Amount == null)
												{
													new_bill.Discount_Amount=0.0;
												}
												if(new_bill.Amount_Paid == null)
												{
													new_bill.Amount_Paid=0.0;
												}
												tax_amt = round(ifnull(new_bill.Tax_Amount,0.0),2);
												disc_amt = round(ifnull(new_bill.Discount_Amount,0.0),2);
												paid_amt = round(ifnull(new_bill.Amount_Paid,0.0),2);
												gross_due = round(grand_total + tax_amt - disc_amt,2);
												if(gross_due < 0)
												{
													gross_due = 0.0;
												}
												balance_due = round(gross_due - paid_amt,2);
												if(balance_due < 0)
												{
													balance_due = 0.0;
												}
												new_bill.Amount_Due=gross_due;
												new_bill.Balance_Due=balance_due;
												if(grand_total > 0)
												{
													new_bill.Bill_Status="Billed";
												}
												else
												{
													new_bill.Bill_Status="Draft";
												}
												if(paid_amt <= 0)
												{
													new_bill.Payment_Status="Not Paid";
												}
												else if(balance_due > 0)
												{
													new_bill.Payment_Status="Partially Paid";
												}
												else
												{
													new_bill.Payment_Status="Paid";
												}
											}
										}
										// =====================================================
										// 4) Recalculate PREVIOUS Bill if moved
										// =====================================================
										if(rec.ID != null && rec.Previous_Bill != null && rec.Previous_Bill != rec.Bill)
										{
											old_bill = Bill[ID == rec.Previous_Bill];
											if(old_bill.ID != null)
											{
												old_details_total = 0.0;
												for each  bd2 in Bill_Details[Bill == old_bill.ID]
												{
													old_details_total = old_details_total + ifnull(bd2.Line_Total,0.0);
												}
												old_services_total = 0.0;
												for each  srv2 in Service_Details[Bill == old_bill.ID]
												{
													old_services_total = old_services_total + ifnull(srv2.Line_Total,0.0);
												}
												old_grand_total = round(old_details_total + old_services_total,2);
												old_bill.Services_Total=round(old_services_total,2);
												old_bill.Total_Amount=old_grand_total;
												old_tax = round(ifnull(old_bill.Tax_Amount,0.0),2);
												old_disc = round(ifnull(old_bill.Discount_Amount,0.0),2);
												old_paid = round(ifnull(old_bill.Amount_Paid,0.0),2);
												old_gross = round(old_grand_total + old_tax - old_disc,2);
												if(old_gross < 0)
												{
													old_gross = 0.0;
												}
												old_balance_due = round(old_gross - old_paid,2);
												if(old_balance_due < 0)
												{
													old_balance_due = 0.0;
												}
												old_bill.Amount_Due=old_gross;
												old_bill.Balance_Due=old_balance_due;
												old_bill.Bill_Status=if(old_grand_total > 0,"Billed","Draft");
												if(old_paid <= 0)
												{
													old_bill.Payment_Status="Not Paid";
												}
												else if(old_balance_due > 0)
												{
													old_bill.Payment_Status="Partially Paid";
												}
												else
												{
													old_bill.Payment_Status="Paid";
												}
											}
										}
										// =====================================================
										// 5) STORE BILL / PO LOGIC ONLY WHEN ITEM EXISTS
										// =====================================================
										po_det = Purchase_Order_Details[ID == rec.Item];
										if(po_det.ID != null)
										{
											// Base quantity conversion
											if(rec.Quantity != null && rec.Quantity > 0 && rec.Rate != null && rec.Rate > 0 && rec.Unit_Of_Measure != null)
											{
												if(po_det.Item != null)
												{
													factor = store_management.po.convert_to_base_qty_from_concrete(po_det.Item,rec.Unit_Of_Measure,1);
													if(factor != null && factor > 0)
													{
														current_line_total = round(rec.Quantity * rec.Rate,2);
														rec.Quantity_In_Base_Unit=rec.Quantity * factor;
														rec.Rate_In_Base_Unit=if(rec.Quantity_In_Base_Unit > 0,current_line_total / rec.Quantity_In_Base_Unit,0.0);
													}
													else
													{
														rec.Quantity_In_Base_Unit=0.0;
														rec.Rate_In_Base_Unit=0.0;
													}
												}
											}
											// Recalculate PO Detail billing quantities
											total_qty_billed = 0.0;
											for each  bd in Bill_Details[Item == po_det.ID]
											{
												total_qty_billed = total_qty_billed + ifnull(bd.Quantity,0.0);
											}
											po_det.Quantity_Billed=total_qty_billed;
											po_det.Quantity_Unbilled=ifnull(po_det.Quantity_Billable,0.0) - total_qty_billed;
											if(po_det.Quantity_Unbilled < 0)
											{
												po_det.Quantity_Unbilled=0.0;
											}
											if(ifnull(po_det.Quantity_Billable,0.0) <= 0)
											{
												po_det.Billing_Status="Not Billed";
											}
											else if(po_det.Quantity_Billed >= po_det.Quantity_Billable)
											{
												po_det.Billing_Status="Fully Billed";
											}
											else
											{
												po_det.Billing_Status="Partially Billed";
											}
											// Recalculate PO Header
											if(po_det.Purchase_Order != null)
											{
												po = Purchase_Order[ID == po_det.Purchase_Order];
												if(po.ID != null)
												{
													total_billed_amount = 0.0;
													for each  line in Purchase_Order_Details[Purchase_Order == po.ID]
													{
														for each  lbd in Bill_Details[Item == line.ID]
														{
															total_billed_amount = total_billed_amount + ifnull(lbd.Line_Total,0.0);
														}
													}
													po.PO_Billed_Total=round(total_billed_amount,2);
													po_total = round(ifnull(po.PO_Total,0.0),2);
													if(po.PO_Billed_Total <= 0)
													{
														po.Bill_Status="Not Billed";
													}
													else if(po_total > 0 && po.PO_Billed_Total < po_total)
													{
														po.Bill_Status="Partially Billed";
													}
													else
													{
														po.Bill_Status="Billed";
													}
													thisapp.po.update_po_receiving_status(po.ID);
													store_bill_resp = store_management.po.update_po_bill_status_from_concrete(po.PO_Number,po.PO_Date,po.Company,ifnull(po.PO_Billed_Total,0.0));
													info store_bill_resp;
												}
											}
											// Update Item Default Cost
											unit_cost_base = ifnull(rec.Rate_In_Base_Unit,0.0);
											if(po_det.Item != null && unit_cost_base > 0)
											{
												store_management.stock.update_item_default_cost_from_concrete(po_det.Item,unit_cost_base);
											}
										}
										if(input.Item != null)
										{
											po_det = Purchase_Order_Details[ID == input.Item.ID];
											if(po_det.ID != null && po_det.Purchase_Order != null)
											{
												thisapp.po.update_po_receiving_status(po_det.Purchase_Order.ID);
											}
										}
										// =====================================================
										// 6) Stock Receiving Status
										// =====================================================
										if(rec.Stock_Receiving_Details != null)
										{
											recv_rec = Stock_Receiving_Details[ID == rec.Stock_Receiving_Details];
											if(recv_rec.ID != null)
											{
												recv_rec.Rate=ifnull(rec.Rate,0.0);
												if(rec.Bill != null)
												{
													recv_rec.Stock_Receiving_Details_Status="Invoiced";
												}
												else
												{
													recv_rec.Stock_Receiving_Details_Status="Received";
												}
											}
										}
										// =====================================================
										// PARTS & CONSUMABLES + WORK ORDER TASK STATUS
										// =====================================================
										bd = Bill_Details[ID == input.ID];
										if(bd.ID == null)
										{
											info "Bill Details record was not found.";
											return;
										}
										if(bd.Parts_Consumables == null)
										{
											info "No Parts & Consumables record selected.";
											return;
										}
										// ---------------------------------------------
										// 1) GET PARTS & CONSUMABLES RECORD
										// ---------------------------------------------
										pc_id = bd.Parts_Consumables;
										pc = Parts_Consumables[ID == pc_id];
										if(pc.ID == null)
										{
											info "Parts & Consumables record was not found.";
											return;
										}
										// ---------------------------------------------
										// 2) UPDATE PARTS & CONSUMABLES STATUS
										// ---------------------------------------------
										if(bd.Bill != null)
										{
											pc.Item_Status="Billed";
										}
										else
										{
											pc.Item_Status="Issued";
										}
										info "Parts & Consumables status updated to: " + pc.Item_Status;
										// ---------------------------------------------
										// 3) GET LINKED WORK ORDER TASK
										// ---------------------------------------------
										if(pc.Work_Order_Task_Number == null)
										{
											info "Parts & Consumables has no Work Order Task.";
											return;
										}
										wot_id = pc.Work_Order_Task_Number;
										wot = Work_Order_Tasks[ID == wot_id];
										if(wot.ID == null)
										{
											info "Linked Work Order Task was not found.";
											return;
										}
										// ---------------------------------------------
										// 4) UPDATE WORK ORDER TASK STATUS
										// ---------------------------------------------
										info "Current task status: " + wot.Work_Order_Task_Status;
										if(bd.Bill != null && wot.Work_Order_Task_Status == "Invoicing")
										{
											wot.Work_Order_Task_Status="Invoiced";
											info "Work Order Task updated to Invoiced.";
										}
										else
										{
											info "Task was not updated. Current status: " + wot.Work_Order_Task_Status;
										}
										// =====================================================
										// 8) Sync Group Expense
										// =====================================================
										if(rec.Group != null && rec.Line_Total != null && rec.Line_Total >= 0)
										{
											new_amount = round(ifnull(rec.Line_Total,0.0),2);
											old_amount = round(ifnull(rec.Last_Synced_Group_Amount,0.0),2);
											delta_amount = round(new_amount - old_amount,2);
											if(delta_amount != 0)
											{
												pay_date = zoho.currentdate;
												if(rec.Bill != null && rec.Bill.Bill_Date != null)
												{
													pay_date = rec.Bill.Bill_Date;
												}
												payload = Map();
												payload.put("Group_ID",rec.Group.ID);
												payload.put("Amount_Delta",delta_amount);
												payload.put("Payment_Date",pay_date);
												payload.put("Source_Group","Store Purchases");
												resp = payment_management.createGroupExpenseFromStoreBill(payload);
												if(resp != null && resp.get("ok") == true)
												{
													rec.Last_Synced_Group_Amount=new_amount;
												}
												else
												{
													info resp;
												}
											}
										}
										// =====================================================
										// 9) Refresh Previous Bill
										// =====================================================
										rec.Previous_Bill=rec.Bill;
										// =====================================================
										// 10) POST TO BUSINESS DIVISION DETAILS
										// =====================================================
										post = Map();
										post.put("Display_Name_Application","Concrete Products Management");
										post.put("Source_Form","Bill Details");
										post.put("Source_Record_ID",rec.ID.toString());
										post.put("CPM_Bill_Details",rec.ID);
										if(rec.Bill != null)
										{
											post.put("Voucher_Number",ifnull(rec.Bill.Bill_Number,""));
											post.put("Transaction_Date",rec.Bill.Bill_Date);
										}
										else
										{
											post.put("Voucher_Number","");
											post.put("Transaction_Date",rec.Details_Date);
										}
										post.put("Business_Division",null);
										post.put("Display_Name_Business_Division","");
										post.put("Amount_To_Receive",0.0);
										post.put("Amount_Received",0.0);
										post.put("Amount_Not_Received",0.0);
										post.put("Amount_To_Pay",ifnull(rec.Line_Total,0.0));
										post.put("Amount_Paid",0.0);
										post.put("Amount_Not_Paid",ifnull(rec.Line_Total,0.0));
										grapes_group.concreteproducts.postBusinessDivisionDetail(post);
						)
					}
				}

			}
			On_Bill_Selected as "On Bill Selected"
			{
				type =  form
				form = Service_Details

				record event = on add or edit

				on user input of Bill
				{
					actions 
					{
						custom deluge script
						(
											if(input.Bill != null)
										{
											bill_rec = Bill[ID == input.Bill];
											if(bill_rec.ID != null)
											{
												input.Display_Name_Bill = bill_rec.Bill_Name + " - " + bill_rec.Bill_Number;
											}
											else
											{
												input.Display_Name_Bill = "";
											}
										}
										else
										{
											input.Display_Name_Bill = "";
										}
						)
					}
				}

			}
			Finalize3 as "Finalize"
			{
				type =  form
				form = Service_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// UPDATE BILL TOTALS
										// =====================================================
										if(input.Bill != null)
										{
											bill_rec = Bill[ID == input.Bill];
											if(bill_rec.ID != null)
											{
												bill_details_total = 0.0;
												for each  bd in Bill_Details[Bill == bill_rec.ID]
												{
													bill_details_total = bill_details_total + ifnull(bd.Line_Total,0.0);
												}
												service_total = 0.0;
												for each  sd in Service_Details[Bill == bill_rec.ID]
												{
													service_total = service_total + ifnull(sd.Line_Total,0.0);
												}
												grand_total = bill_details_total + service_total;
												tax_amt = ifnull(bill_rec.Tax_Amount,0.0);
												disc_amt = ifnull(bill_rec.Discount_Amount,0.0);
												paid_amt = ifnull(bill_rec.Amount_Paid,0.0);
												bill_rec.Services_Total=service_total;
												bill_rec.Total_Amount=grand_total;
												bill_rec.Tax_Amount=tax_amt;
												bill_rec.Discount_Amount=disc_amt;
												bill_rec.Amount_Paid=paid_amt;
												gross_due = grand_total + tax_amt - disc_amt;
												if(gross_due < 0)
												{
													gross_due = 0.0;
												}
												bill_rec.Amount_Due=gross_due;
												balance_due = gross_due - paid_amt;
												if(balance_due < 0)
												{
													balance_due = 0.0;
												}
												bill_rec.Balance_Due=balance_due;
												if(grand_total > 0)
												{
													bill_rec.Bill_Status="Billed";
												}
												else
												{
													bill_rec.Bill_Status="Draft";
												}
												if(paid_amt <= 0)
												{
													bill_rec.Payment_Status="Not Paid";
												}
												else if(paid_amt < gross_due)
												{
													bill_rec.Payment_Status="Partially Paid";
												}
												else
												{
													bill_rec.Payment_Status="Paid";
												}
												selected_group_id = null;
												highest_group_total = 0.0;
												group_totals = Map();
												for each  row in Bill_Details[Bill == bill_rec.ID]
												{
													if(row.Group != null)
													{
														gkey = row.Group.ID.toString();
														existing_total = ifnull(group_totals.get(gkey),0.0);
														row_total = ifnull(row.Line_Total,0.0);
														group_totals.put(gkey,existing_total + row_total);
													}
												}
												for each  gkey2 in group_totals.keys()
												{
													g_total = ifnull(group_totals.get(gkey2),0.0);
													if(g_total > highest_group_total)
													{
														highest_group_total = g_total;
														selected_group_id = gkey2.toLong();
													}
												}
												if(selected_group_id != null && input.Line_Total != null && input.Line_Total >= 0)
												{
													new_amount = round(ifnull(input.Line_Total,0.0),2);
													old_amount = round(ifnull(input.Last_Synced_Group_Amount,0.0),2);
													old_group_id = input.Last_Synced_Group_ID;
													pay_date = zoho.currentdate;
													if(input.Bill.Bill_Date != null)
													{
														pay_date = input.Bill.Bill_Date;
													}
													if(old_group_id != null && old_group_id != selected_group_id && old_amount != 0)
													{
														reverse_payload = Map();
														reverse_payload.put("Group_ID",old_group_id);
														reverse_payload.put("Amount_Delta",0 - old_amount);
														reverse_payload.put("Payment_Date",pay_date);
														reverse_payload.put("Source_Group","Store Services");
														reverse_resp = payment_management.createGroupExpenseFromStoreBill(reverse_payload);
														if(reverse_resp == null || reverse_resp.get("ok") != true)
														{
															info reverse_resp;
														}
													}
													delta_amount = new_amount;
													if(old_group_id != null && old_group_id == selected_group_id)
													{
														delta_amount = round(new_amount - old_amount,2);
													}
													if(delta_amount != 0)
													{
														payload = Map();
														payload.put("Group_ID",selected_group_id);
														payload.put("Amount_Delta",delta_amount);
														payload.put("Payment_Date",pay_date);
														payload.put("Source_Group","Store Services");
														resp = payment_management.createGroupExpenseFromStoreBill(payload);
														if(resp != null && resp.get("ok") == true)
														{
															input.Last_Synced_Group_Amount = new_amount;
															input.Last_Synced_Group_ID = selected_group_id;
														}
														else
														{
															info resp;
														}
													}
													else
													{
														input.Last_Synced_Group_Amount = new_amount;
														input.Last_Synced_Group_ID = selected_group_id;
													}
												}
												else
												{
													info "No Bill Details group found for this Bill. Service amount was not synced to Group Expenses.";
												}
											}
										}
										// =====================================================
										// POST SERVICE DETAILS TO BUSINESS DIVISION DETAILS
										// =====================================================
										posting_dt = zoho.currenttime;
										if(input.Bill != null && input.Bill.Bill_Date != null)
										{
											posting_dt = input.Bill.Bill_Date;
										}
										post = Map();
										post.put("Display_Name_Application","Concrete Product Management");
										post.put("Source_Form","Service Details");
										post.put("Source_Record_ID",input.ID.toString());
										if(input.Bill != null)
										{
											post.put("Voucher_Number",ifnull(input.Bill.Bill_Number,""));
										}
										else
										{
											post.put("Voucher_Number","");
										}
										post.put("Transaction_Date",posting_dt);
										post.put("Business_Division",null);
										post.put("Display_Name_Business_Division","");
										post.put("Amount_To_Receive",0.0);
										post.put("Amount_Received",0.0);
										post.put("Amount_Not_Received",0.0);
										post.put("Amount_To_Pay",ifnull(input.Line_Total,0.0));
										post.put("Amount_Paid",0.0);
										post.put("Amount_Not_Paid",ifnull(input.Line_Total,0.0));
										grapes_group.concreteproducts.postBusinessDivisionDetail(post);
						)
					}
				}

			}
			Set_Up_Form9 as "Set Up Form"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// PURCHASE ORDER - SET UP FORM
										// ======================================
										// --------------------------------------
										// HEADER CONTROLS
										// --------------------------------------
										hide Display_Name_Company;
										disable PO_Total;
										disable PO_Status;
										disable PO_Total_Paid;
										disable Payment_Status;
										disable Receive_Status;
										hide PO_Billed_Total;
										hide PO_Total_Paid;
										// ======================================
										// SUBFORM CONTROLS
										// ======================================
										disable PO_Details.Purchase_Order_Number;
										disable PO_Details.Line_Total;
										// Hide subform display/system fields
										hide PO_Details.Display_Name_Item;
										hide PO_Details.Display_Name_Unit_Of_Measure;
										hide PO_Details.Quantity_Received;
										hide PO_Details.Quantity_Remaining;
										hide PO_Details.Purchase_Order_Details_Number;
										hide PO_Details.Quantity_in_Base_Unit_Of_Measure;
										hide PO_Details.Receiving_Status;
										hide PO_Details.Quantity_Billed;
										hide PO_Details.Quantity_Billable;
										hide PO_Details.Billing_Status;
										hide PO_Details.Display_Name_Purchase_Order;
										//hide PO_Details.Display_Name_From_Store;
										hide PO_Details.Purchase_Order_Number;
										// ================================
										// SET UP FORM
										// ================================
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										disable Bill_Status;
										disable Payment_Status;
										disable PO_Number;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			Set_Up_Form11 as "Set Up Form"
			{
				type =  form
				form = Bill

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// HIDE DISPLAY FIELDS
										// =====================================================
										hide Display_Name_Vendor;
										hide Services.Display_Name_Invoice;
										hide Services.Display_Name_Service;
										hide Bill_Details.Display_Name_Bill;
										hide Bill_Details.Display_Name_Item;
										hide Bill_Details.Display_Name_Unit_Of_Measure;
										hide Payment_Made_Details.Display_Name_Bill;
										hide Payment_Made_Details.Display_Name_Payment_Made_Voucher;
										hide Payment_Made_Details.Display_Name_Vendor;
										// =====================================================
										// SHOW / HIDE MAIN SECTIONS
										// =====================================================
										hide Customer;
										hide Vendor;
										if(input.ID == null)
										{
											hide Services;
										}
										else
										{
											show Services;
										}
										// =====================================================
										// BACK END
										// =====================================================
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// Logged-in user
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// =====================================================
										// BILL TYPE
										// =====================================================
										hide Vendor;
										hide Customer;
										hide Employee_Vendor;
										hide Sales_Voucher;
										hide Invoice;
										if(input.Bill_Type == "Store Bill")
										{
											show Vendor;
										}
										else if(input.Bill_Type == "Employee Bill")
										{
											show Employee_Vendor;
										}
										else if(input.Bill_Type == "Sales Voucher Bill")
										{
											show Customer;
											show Sales_Voucher;
										}
										if(input.Bill_Type == "Invoice Bill")
										{
											disable Bill_Name;
											disable Bill_Number;
										}
										if(input.Bill_Type == "Sales Voucher Bill")
										{
											disable Bill_Name;
											disable Bill_Number;
										}
										else
										{
											enable Bill_Name;
											enable Bill_Number;
										}
										disable Services_Total;
										disable Total_Amount;
										disable Tax_Amount;
										disable Discount_Amount;
										disable Amount_Due;
										disable Amount_Paid;
										disable Balance_Due;
										disable Bill_Status;
										disable Payment_Status;
										// =====================================================
										// SERVICES SUBFORM
										// =====================================================
										disable Services.Service;
										disable Services.Description;
										disable Services.Quantity;
										disable Services.Rate;
										hide Services.Invoice;
										hide Services.Last_Synced_Group_ID;
										hide Services.Last_Synced_Group_Amount;
										hide Services.Created_By_Name;
										hide Services.Created_By_Email;
										hide Services.Created_By_Time;
										hide Services.Updated_By_Name;
										hide Services.Updated_By_Email;
										hide Services.Updated_By_Time;
										hide Services.User_Name;
										hide Services.User_Email;
										hide Services.User_Role;
										// =====================================================
										// PAYMENT MADE DETAILS SUBFORM
										// =====================================================
										hide Payment_Made_Details.Payment_Type;
										hide Payment_Made_Details.Amount_Not_Allocated;
										hide Payment_Made_Details.Created_By_Name;
										hide Payment_Made_Details.Created_By_Email;
										hide Payment_Made_Details.Created_By_Time;
										hide Payment_Made_Details.Updated_By_Name;
										hide Payment_Made_Details.Updated_By_Email;
										hide Payment_Made_Details.Updated_By_Time;
										hide Payment_Made_Details.User_Name;
										hide Payment_Made_Details.User_Email;
										hide Payment_Made_Details.User_Role;
										disable Payment_Made_Details.Payment_Made_Voucher;
										disable Payment_Made_Details.Line_Number;
										disable Payment_Made_Details.Payment_Document;
										disable Payment_Made_Details.Amount_Due;
										disable Payment_Made_Details.Amount_Allocated;
										disable Payment_Made_Details.Amount_Paid;
										disable Payment_Made_Details.Balance_Due;
						)
					}
				}

			}
			Set_Up_Form12 as "Set Up Form"
			{
				type =  form
				form = Bill_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.ID != null)
										{
											input.Previous_Bill = input.Bill;
										}
										else
										{
											input.Previous_Bill = null;
										}
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// =====================================================
										// 1. HIDE ALL SECTIONS FIRST
										// =====================================================
										hide Bill_Details;
										hide Bill_Details_Totals;
										hide Tracking_Details;
										hide Business_Details;
										hide Sync_Details;
										// =====================================================
										// 2. HIDE DISPLAY NAME FIELDS
										// =====================================================
										hide Display_Name_Bill;
										hide Display_Name_Item;
										hide Display_Name_Unit_Of_Measure;
										hide Display_Name_Group;
										hide Display_Name_Division;
										hide Display_Name_Business_Site;
										hide Display_Name_Business_Division;
										// =====================================================
										// 3. HIDE BASE UNIT FIELDS
										// =====================================================
										hide Base_Unit_Of_Measure;
										hide Quantity_In_Base_Unit;
										hide Rate_In_Base_Unit;
										// =====================================================
										// 4. HIDE CONDITIONAL FIELDS
										// =====================================================
										hide Stock_Receiving_Details;
										hide Parts_Consumables;
										hide Item;
										hide Unit_Of_Measure;
										hide Quantity_Billable;
										hide Source;
										hide Business_Division;
										hide Reference;
										hide Expense_Type;
										hide Details;
										// =====================================================
										// 5. SHOW COMMON SECTIONS
										// =====================================================
										show Bill_Details;
										show Bill_Details_Totals;
										// =====================================================
										// 6. SHOW COMMON FIELDS
										// =====================================================
										show Bill;
										show Details_Date;
										show Line_Number;
										show Quantity;
										show Details;
										show Rate;
										show Account;
										show Current_Site;
										show Group;
										show Source_Form;
										show Source_Record_ID;
										show Bill_Details_Status;
										// =====================================================
										// 7. EMPLOYEE / DOCUMENT TRANSPORT
										// =====================================================
										if(input.ID != null && input.Expense_Type == "Document Transport")
										{
											show Bill_Details;
											show Bill_Details_Totals;
											show Tracking_Details;
											show Sync_Details;
											hide Business_Details;
											show Details_Date;
											show Line_Number;
											show Reference;
											show Expense_Type;
											show Details;
											show Quantity;
											show Rate;
											show Account;
											show Current_Site;
											show Group;
											show Bill_Details_Status;
											show Source_Form;
											show Source_Record_ID;
											disable Details_Date;
											disable Reference;
											disable Expense_Type;
											disable Details;
											disable Quantity;
											disable Account;
											disable Current_Site;
											disable Source_Form;
											disable Source_Record_ID;
											disable Bill_Details_Status;
											disable Last_Synced_Group_Amount;
											disable Previous_Bill;
										}
										// =====================================================
										// 8. STORE BILL DETAILS
										// =====================================================
										else if(input.Stock_Receiving_Details != null)
										{
											// ----------------------------------------
											// Sections
											// ----------------------------------------
											show Bill_Details;
											show Bill_Details_Totals;
											show Tracking_Details;
											show Sync_Details;
											// ----------------------------------------
											// Needed Fields
											// ----------------------------------------
											show Stock_Receiving_Details;
											show Bill;
											show Details_Date;
											show Line_Number;
											show Item;
											show Unit_Of_Measure;
											show Quantity;
											show Rate;
											show Account;
											show Current_Site;
											show Group;
											show Source_Form;
											show Source_Record_ID;
											show Bill_Details_Status;
											disable Stock_Receiving_Details;
											disable Details_Date;
											disable Item;
											disable Unit_Of_Measure;
											disable Quantity;
											disable Previous_Bill;
											disable Account;
											disable Current_Site;
											disable Source_Form;
											disable Source_Record_ID;
											disable Last_Synced_Group_Amount;
											disable Bill_Details_Status;
											// ----------------------------------------
											// Hide Base Unit Fields
											// ----------------------------------------
											hide Base_Unit_Of_Measure;
											hide Quantity_In_Base_Unit;
											hide Rate_In_Base_Unit;
										}
										// =====================================================
										// 8. WORK ORDER / PARTS & CONSUMABLES BILL DETAILS
										// =====================================================
										else if(input.Parts_Consumables != null)
										{
											show Bill_Details;
											show Bill_Details_Totals;
											show Tracking_Details;
											show Sync_Details;
											hide Business_Details;
											show Bill;
											show Details_Date;
											show Line_Number;
											show Parts_Consumables;
											show Details;
											show Quantity;
											show Rate;
											show Previous_Bill;
											show Account;
											show Current_Site;
											show Group;
											show Source_Form;
											show Source_Record_ID;
											show Last_Synced_Group_Amount;
											show Bill_Details_Status;
											disable Parts_Consumables;
											disable Details_Date;
											enable Line_Number;
											disable Details;
											disable Quantity;
											disable Rate;
											disable Previous_Bill;
											disable Account;
											disable Current_Site;
											disable Source_Form;
											disable Source_Record_ID;
											disable Last_Synced_Group_Amount;
											disable Bill_Details_Status;
											hide Stock_Receiving_Details;
											hide Item;
											hide Unit_Of_Measure;
											hide Base_Unit_Of_Measure;
											hide Quantity_In_Base_Unit;
											hide Rate_In_Base_Unit;
											hide Quantity_Billable;
										}
										// =====================================================
										// 9. DEFAULT EMPLOYEE DETAILS
										// =====================================================
										else
										{
											show Tracking_Details;
											show Source;
											show Account;
											show Current_Site;
											hide Business_Details;
											hide Sync_Details;
										}
						)
					}
				}

			}
			Set_Up_Form13 as "Set Up Form"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =============================================
										// Item Issuing Details -> Set Up Form OPTIMIZED
										// Load of form only
										// No heavy lookups here
										// =============================================
										// BACK END
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// Logged-in user info only
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// =============================================
										// Hide display/helper fields
										// =============================================
										hide Display_Name_Issuing_Voucher;
										hide Display_Name_Item;
										hide Display_Name_Taken_By;
										hide Display_Name_Unit_Of_Measure;
										hide Quantity_Returned;
										hide Quantity_Returned_in_Base_Unit_Of_Measure;
										hide Display_Name_Issued_By;
										hide Status;
										hide Notes;
										hide Status_Details;
										hide Items_Image;
										// =============================================
										// Disable system fields
										// =============================================
										disable Global_Available_Stock;
										disable Store_Available_Stock;
										disable Quantity_in_Base_Unit_Of_Measure;
										disable Item_Issuing_Number;
										disable Line_Total;
										disable Store;
										disable Request_Voucher;
										disable Cost;
										disable Status;
										// =============================================
										// Request source fields
										// Hide all first
										// =============================================
										req_type = ifnull(input.Request_Voucher_Type,"").trim();
										hide Employee_Voucher;
										hide Work_Order_Task;
										hide Sales_Voucher;
										hide Item_Taken;
										show Item;
										if(req_type == "Employee Voucher")
										{
											show Employee_Voucher;
										}
										else if(req_type == "Work Order Task")
										{
											show Work_Order_Task;
										}
										else if(req_type == "Sales Voucher")
										{
											show Sales_Voucher;
											show Item_Taken;
											show Items_Image;
											hide Item;
											input.Employee_Voucher = null;
											input.Work_Order_Task = null;
										}
										else if(req_type == "Internal Transfer")
										{
											input.Request_Voucher = ifnull(input.Item_Issuing_Number,"");
											input.Employee_Voucher = null;
											input.Work_Order_Task = null;
											input.Sales_Voucher = null;
											input.Item_Taken = null;
										}
										else
										{
											input.Request_Voucher = "";
											input.Employee_Voucher = null;
											input.Work_Order_Task = null;
											input.Sales_Voucher = null;
											input.Item_Taken = null;
										}
										// =============================================
										// Cancel / did not come back fields
										// =============================================
										hide Cancel_This_Line_Item;
										hide Reason_Why_Cancelled;
										hide Didn_t_Come_Back;
										hide Why;
										hide Reason_Why_Didn_t_Come_Back;
										if(input.ID != null)
										{
											show Didn_t_Come_Back;
											show Cancel_This_Line_Item;
											if(input.Cancel_This_Line_Item == true)
											{
												show Reason_Why_Cancelled;
											}
											if(input.Didn_t_Come_Back == true)
											{
												show Why;
												show Reason_Why_Didn_t_Come_Back;
											}
										}
										// =============================================
										// Expected return date
										// Do not query Item here
										// Let On Item Selected handle tool check
										// =============================================
										hide Expected_Return_Date;
										// =============================================
										// Draft edit lock
										// =============================================
										if(input.ID != null && input.Status == "Draft")
										{
											disable Issuing_Voucher;
											disable Line_Number;
											disable Request_Voucher_Type;
											disable Employee_Voucher;
											disable Work_Order_Task;
											//disable Sand_Sales;
											//disable Stock_Sales;
											//disable Stock_Bundling_Note;
											hide Issuing_Voucher;
											hide Store;
											hide Line_Number;
											hide Taken_By;
											hide Didn_t_Come_Back;
											show Cancel_This_Line_Item;
										}
						)
					}
				}

			}
			Set_Up_Form14 as "Set Up Form"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// Stock Receiving Details -> Set Up Form
										// ======================================
										// ===============================
										// BACK END
										// ===============================
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// Logged-in user info
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// --------------------------------------
										// Always hide helper/display fields
										// --------------------------------------
										hide Display_Name_Stock_Receiving_Voucher;
										hide Display_Name_Voucher;
										hide Display_Name_Item;
										hide Display_Name_Unit_Of_Measure_Received;
										hide Display_Name_Received_By;
										hide Display_Name_Receiving_Type;
										// --------------------------------------
										// Always lock calculated / system fields
										// --------------------------------------
										disable Store;
										disable Quantity_to_Receive;
										disable Display_Name_Unit_Of_Measure_to_Receive;
										disable Quantity_in_Base_Unit_Of_Measure_Received;
										disable Display_Name_Unit_Of_Measure_Received;
										disable Display_Name_Unit_Of_Measure_to_Receive;
										disable Stock_Receiving_Voucher_and_Number;
										disable Stock_Receiving_Details_Status;
										disable Rate;
										disable Line_Total;
										// --------------------------------------
										// Hide fields by default
										// --------------------------------------
										hide Rate;
										hide Line_Total;
										hide Purchase_Order;
										hide Voucher;
										hide Item;
										hide Transfer_Item;
										hide Internal_Transfer_Number;
										hide Stock_Return_Number;
										hide Item_Issuing_Details;
										hide Tool_Return_Number;
										// --------------------------------------
										// Disable source fields by default
										// --------------------------------------
										disable Purchase_Order;
										disable Voucher;
										disable Item;
										disable Transfer_Item;
										disable Internal_Transfer_Number;
										disable Stock_Return_Number;
										disable Item_Issuing_Details;
										// --------------------------------------
										// CREATE MODE (New Record)
										// --------------------------------------
										if(input.ID == null)
										{
											show Stock_Receiving_Voucher;
											show Stock_Receiving_Voucher_Number;
											show Stock_Condition;
											show Notes;
											show Quantity_to_Receive;
											show Quantity_Received;
											show Unit_Of_Measure_Received;
											enable Stock_Receiving_Voucher;
											enable Stock_Receiving_Voucher_Number;
											enable Stock_Condition;
											enable Notes;
											enable Quantity_Received;
											enable Unit_Of_Measure_Received;
											disable Quantity_to_Receive;
											if(input.Receiving_Type == "Purchase Order")
											{
												show Purchase_Order;
												show Item;
												enable Purchase_Order;
												enable Item;
											}
											else if(input.Receiving_Type == "Internal Transfer")
											{
												show Internal_Transfer_Number;
												show Transfer_Item;
												enable Internal_Transfer_Number;
												enable Transfer_Item;
											}
											else if(input.Receiving_Type == "Stock Bundling Note")
											{
												show Voucher;
												show Stock_Created;
												enable Voucher;
												enable Stock_Created;
											}
											else if(input.Receiving_Type == "Stock Return")
											{
												show Stock_Return_Number;
												show Item_Issuing_Details;
												enable Stock_Return_Number;
												enable Item_Issuing_Details;
											}
											else if(input.Receiving_Type == "Tool Return")
											{
												show Tool_Return_Number;
												enable Item_Issuing_Details;
											}
											else
											{
												hide Purchase_Order;
												hide Voucher;
												hide Item;
												hide Transfer_Item;
												hide Internal_Transfer_Number;
												hide Voucher;
												hide Stock_Created;
												hide Tool_Return_Number;
												hide Item_Issuing_Details;
											}
										}
										// --------------------------------------
										// EDIT MODE
										// --------------------------------------
										else
										{
											disable Stock_Receiving_Voucher;
											disable Stock_Receiving_Voucher_Number;
											enable Stock_Condition;
											disable Notes;
											enable Quantity_Received;
											disable Unit_Of_Measure_Received;
											if(input.Receiving_Type == "Purchase Order")
											{
												show Purchase_Order;
												show Item;
												disable Purchase_Order;
												disable Item;
											}
											else if(input.Receiving_Type == "Internal Transfer")
											{
												show Internal_Transfer_Number;
												show Transfer_Item;
												disable Internal_Transfer_Number;
												disable Transfer_Item;
											}
											else if(input.Receiving_Type == "Stock Bundling Note")
											{
												show Voucher;
												show Stock_Created;
												enable Voucher;
												enable Stock_Created;
											}
											else if(input.Receiving_Type == "Stock Return")
											{
												show Stock_Return_Number;
												show Item_Issuing_Details;
												disable Stock_Return_Number;
												disable Item_Issuing_Details;
											}
											else if(input.Receiving_Type == "Tool Return")
											{
												show Tool_Return_Number;
												disable Item_Issuing_Details;
											}
											else
											{
												hide Purchase_Order;
												hide Voucher;
												hide Item;
												hide Transfer_Item;
												hide Voucher;
												hide Stock_Created;
												hide Internal_Transfer_Number;
												hide Stock_Return_Number;
												hide Tool_Return_Number;
												hide Item_Issuing_Details;
											}
										}
						)
					}
				}

			}
