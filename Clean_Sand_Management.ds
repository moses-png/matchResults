											disable Last_Synced_Group_Amount;
											disable Bill_Details_Status;
											hide Base_Unit_Of_Measure;
											hide Quantity_In_Base_Unit;
											hide Rate_In_Base_Unit;
										}
										// =====================================================
										// 8. WORK ORDER / PARTS & CONSUMABLES BILL DETAILS
										// =====================================================
										else if(input.Parts_Consumables != null)
										{
											show Bill_Details;
											show Bill_Details_Totals;
											show Tracking_Details;
											show Sync_Details;
											hide Business_Details;
											show Bill;
											show Details_Date;
											show Line_Number;
											show Parts_Consumables;
											show Details;
											show Quantity;
											show Rate;
											show Previous_Bill;
											show Account;
											show Current_Site;
											show Group;
											show Source_Form;
											show Source_Record_ID;
											show Last_Synced_Group_Amount;
											show Bill_Details_Status;
											disable Parts_Consumables;
											disable Details_Date;
											enable Line_Number;
											disable Details;
											disable Quantity;
											disable Rate;
											disable Previous_Bill;
											disable Account;
											disable Current_Site;
											disable Source_Form;
											disable Source_Record_ID;
											disable Last_Synced_Group_Amount;
											disable Bill_Details_Status;
											hide Stock_Receiving_Details;
											hide Item;
											hide Unit_Of_Measure;
											hide Base_Unit_Of_Measure;
											hide Quantity_In_Base_Unit;
											hide Rate_In_Base_Unit;
											hide Quantity_Billable;
										}
										// =====================================================
										// 9. DEFAULT EMPLOYEE DETAILS
										// =====================================================
										else
										{
											show Tracking_Details;
											show Source;
											show Account;
											show Current_Site;
											hide Business_Details;
											hide Sync_Details;
										}
						)
					}
				}

			}
			Set_Up_Form13 as "Set Up Form"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =============================================
										// Item Issuing Details -> Set Up Form OPTIMIZED
										// Load of form only
										// No heavy lookups here
										// =============================================
										// BACK END
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// =============================================
										// Hide display/helper fields
										// =============================================
										hide Display_Name_Issuing_Voucher;
										hide Display_Name_Item;
										hide Display_Name_Taken_By;
										hide Display_Name_Unit_Of_Measure;
										hide Quantity_Returned;
										hide Quantity_Returned_in_Base_Unit_Of_Measure;
										hide Display_Name_Issued_By;
										hide Status;
										hide Notes;
										hide Status_Details;
										hide Items_Image;
										// =============================================
										// Disable system fields
										// =============================================
										disable Global_Available_Stock;
										disable Store_Available_Stock;
										disable Quantity_in_Base_Unit_Of_Measure;
										disable Item_Issuing_Number;
										disable Line_Total;
										disable Store;
										disable Request_Voucher;
										disable Cost;
										disable Status;
										// =============================================
										// Request source fields
										// Hide all first
										// =============================================
										req_type = ifnull(input.Request_Voucher_Type,"").trim();
										hide Employee_Voucher;
										hide Work_Order_Task;
										hide Sales_Voucher;
										hide Item_Taken;
										show Item;
										if(req_type == "Employee Voucher")
										{
											show Employee_Voucher;
										}
										else if(req_type == "Work Order Task")
										{
											show Work_Order_Task;
										}
										else if(req_type == "Sales Voucher")
										{
											show Sales_Voucher;
											show Item_Taken;
											show Items_Image;
											hide Item;
											input.Employee_Voucher = null;
											input.Work_Order_Task = null;
										}
										else if(req_type == "Internal Transfer")
										{
											input.Request_Voucher = ifnull(input.Item_Issuing_Number,"");
											input.Employee_Voucher = null;
											input.Work_Order_Task = null;
											input.Sales_Voucher = null;
											input.Item_Taken = null;
										}
										else
										{
											input.Request_Voucher = "";
											input.Employee_Voucher = null;
											input.Work_Order_Task = null;
											input.Sales_Voucher = null;
											input.Item_Taken = null;
										}
										// =============================================
										// Cancel / did not come back fields
										// =============================================
										hide Cancel_This_Line_Item;
										hide Reason_Why_Cancelled;
										hide Didn_t_Come_Back;
										hide Why;
										hide Reason_Why_Didn_t_Come_Back;
										if(input.ID != null)
										{
											show Didn_t_Come_Back;
											show Cancel_This_Line_Item;
											if(input.Cancel_This_Line_Item == true)
											{
												show Reason_Why_Cancelled;
											}
											if(input.Didn_t_Come_Back == true)
											{
												show Why;
												show Reason_Why_Didn_t_Come_Back;
											}
										}
										// =============================================
										hide Expected_Return_Date;
										// =============================================
										// Draft edit lock
										// =============================================
										if(input.ID != null && input.Status == "Draft")
										{
											disable Issuing_Voucher;
											disable Line_Number;
											disable Request_Voucher_Type;
											disable Employee_Voucher;
											disable Work_Order_Task;
											hide Issuing_Voucher;
											hide Store;
											hide Line_Number;
											hide Taken_By;
											hide Didn_t_Come_Back;
											show Status_Details;
											show Cancel_This_Line_Item;
										}
						)
					}
				}

			}
			Set_Up_Form14 as "Set Up Form"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// Stock Receiving Details -> Set Up Form
										// ======================================
										// ===============================
										// BACK END
										// ===============================
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// Logged-in user info
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// --------------------------------------
										// Always hide helper/display fields
										// --------------------------------------
										hide Display_Name_Stock_Receiving_Voucher;
										hide Display_Name_Voucher;
										hide Display_Name_Item;
										hide Display_Name_Unit_Of_Measure_Received;
										hide Display_Name_Received_By;
										hide Display_Name_Receiving_Type;
										hide Stock_Created;
										// --------------------------------------
										// Always lock calculated / system fields
										// --------------------------------------
										disable Store;
										disable Quantity_to_Receive;
										disable Display_Name_Unit_Of_Measure_to_Receive;
										disable Quantity_in_Base_Unit_Of_Measure_Received;
										disable Display_Name_Unit_Of_Measure_Received;
										disable Display_Name_Unit_Of_Measure_to_Receive;
										disable Stock_Receiving_Voucher_and_Number;
										disable Stock_Receiving_Details_Status;
										disable Rate;
										disable Line_Total;
										// --------------------------------------
										// Hide fields by default
										// --------------------------------------
										hide Rate;
										hide Line_Total;
										hide Purchase_Order;
										hide Voucher;
										hide Item;
										hide Transfer_Item;
										hide Internal_Transfer_Number;
										hide Stock_Return_Number;
										hide Item_Issuing_Details;
										hide Tool_Return_Number;
										// --------------------------------------
										// Disable source fields by default
										// --------------------------------------
										disable Purchase_Order;
										disable Voucher;
										disable Item;
										disable Transfer_Item;
										disable Internal_Transfer_Number;
										disable Stock_Return_Number;
										disable Item_Issuing_Details;
										// --------------------------------------
										// CREATE MODE (New Record)
										// --------------------------------------
										if(input.ID == null)
										{
											show Stock_Receiving_Voucher;
											show Stock_Receiving_Voucher_Number;
											show Stock_Condition;
											show Notes;
											show Quantity_to_Receive;
											show Quantity_Received;
											show Unit_Of_Measure_Received;
											enable Stock_Receiving_Voucher;
											enable Stock_Receiving_Voucher_Number;
											enable Stock_Condition;
											enable Notes;
											enable Quantity_Received;
											enable Unit_Of_Measure_Received;
											disable Quantity_to_Receive;
											if(input.Receiving_Type == "Purchase Order")
											{
												show Purchase_Order;
												show Item;
												enable Purchase_Order;
												enable Item;
											}
											else if(input.Receiving_Type == "Internal Transfer")
											{
												show Internal_Transfer_Number;
												show Transfer_Item;
												enable Internal_Transfer_Number;
												enable Transfer_Item;
											}
											else if(input.Receiving_Type == "Stock Return")
											{
												show Stock_Return_Number;
												show Item_Issuing_Details;
												enable Stock_Return_Number;
												enable Item_Issuing_Details;
											}
											else if(input.Receiving_Type == "Tool Return")
											{
												show Tool_Return_Number;
												enable Item_Issuing_Details;
											}
											else
											{
												hide Purchase_Order;
												hide Voucher;
												hide Item;
												hide Transfer_Item;
												hide Internal_Transfer_Number;
												hide Tool_Return_Number;
												hide Item_Issuing_Details;
											}
										}
										// --------------------------------------
										// EDIT MODE
										// --------------------------------------
										else
										{
											disable Stock_Receiving_Voucher;
											disable Stock_Receiving_Voucher_Number;
											enable Stock_Condition;
											disable Notes;
											enable Quantity_Received;
											disable Unit_Of_Measure_Received;
											if(input.Receiving_Type == "Purchase Order")
											{
												show Purchase_Order;
												show Item;
												disable Purchase_Order;
												disable Item;
											}
											else if(input.Receiving_Type == "Internal Transfer")
											{
												show Internal_Transfer_Number;
												show Transfer_Item;
												disable Internal_Transfer_Number;
												disable Transfer_Item;
											}
											else if(input.Receiving_Type == "Stock Return")
											{
												show Stock_Return_Number;
												show Item_Issuing_Details;
												disable Stock_Return_Number;
												disable Item_Issuing_Details;
											}
											else if(input.Receiving_Type == "Tool Return")
											{
												show Tool_Return_Number;
												disable Item_Issuing_Details;
											}
											else
											{
												hide Purchase_Order;
												hide Voucher;
												hide Item;
												hide Transfer_Item;
												hide Internal_Transfer_Number;
												hide Stock_Return_Number;
												hide Tool_Return_Number;
												hide Item_Issuing_Details;
											}
										}
						)
					}
				}

			}
