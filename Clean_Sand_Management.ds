			On_Vendor_Type_Selected as "On Vendor  Type Selected"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on user input of Vendor_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Vendor_Type == "External Vendor")
										{
											show Vendor;
											hide Employee_Vendor;
											hide Customer_Vendor;
											input.Employee_Vendor = null;
											input.Customer_Vendor = null;
										}
										else if(input.Vendor_Type == "Employee Vendor")
										{
											show Employee_Vendor;
											hide Vendor;
											hide Customer_Vendor;
											input.Vendor = null;
											input.Customer_Vendor = null;
										}
										else if(input.Vendor_Type == "Customer Vendor")
										{
											show Customer_Vendor;
											hide Vendor;
											hide Employee_Vendor;
											input.Vendor = null;
											input.Employee_Vendor = null;
										}
										else
										{
											hide Vendor;
											hide Employee_Vendor;
											hide Customer_Vendor;
											input.Vendor = null;
											input.Employee_Vendor = null;
											input.Customer_Vendor = null;
											input.Display_Name_Vendor = "";
										}
						)
					}
				}

			}
			Full_Validation21 as "Full Validation"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = List();
										if(input.Payment_Account == null)
										{
											errors.add("• Payment Account is required.");
										}
										if(input.Vendor_Type == null || input.Vendor_Type == "")
										{
											errors.add("• Vendor Type is required.");
										}
										if(input.Vendor_Type == "Employee Vendor" && input.Employee_Vendor == null)
										{
											errors.add("• Employee Vendor is required.");
										}
										if(input.Vendor_Type == "External Vendor" && input.Vendor == null)
										{
											errors.add("• Vendor is required.");
										}
										if(input.Total_Amount_Paid == null || input.Total_Amount_Paid <= 0)
										{
											errors.add("• Total Amount Paid must be greater than 0.");
										}
										total_allocated = 0.0;
										for each  md in input.Made_Details
										{
											if(md.Payment_Document == null || md.Payment_Document == "")
											{
												errors.add("• Payment Document is required on line " + md.Line_Number);
											}
											if(md.Payment_Document == "Bill" && md.Bill == null)
											{
												errors.add("• Bill is required on line " + md.Line_Number);
											}
											if(md.Amount_Allocated == null || md.Amount_Allocated <= 0)
											{
												errors.add("• Amount Allocated must be greater than 0 on line " + md.Line_Number);
											}
											total_allocated = total_allocated + ifnull(md.Amount_Allocated,0.0);
										}
										if(total_allocated > ifnull(input.Total_Amount_Paid,0.0))
										{
											errors.add("• Total Amount Allocated cannot exceed Total Amount Paid.");
										}
										existing = Payment_Made_Voucher[Payment_Made_Number == input.Payment_Made_Number && ID != input.ID];
										if(existing.ID != null)
										{
											alert "Payment Made Number already exists.";
											cancel submit;
										}
										if(errors.size() > 0)
										{
											msg = "Please fix the following:\n\n";
											for each  e in errors
											{
												msg = msg + e + "\n";
											}
											alert msg;
											cancel submit;
										}
										if(input.Payment_Made_Date == null)
										{
											input.Payment_Made_Date = zoho.currenttime;
										}
						)
					}
				}

			}
