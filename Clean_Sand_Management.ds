										hide Measurement_Status;
										hide Document_Stage;
										// -------------------------
										// 4) CREATE MODE
										// -------------------------
										if(input.ID == null)
										{
											if(ifnull(input.User_Email,"").toLowerCase().startsWith("phmac001"))
											{
												input.Phone_Used_Site = "Freedom City Mall - ARA338";
											}
											if(ifnull(input.User_Email,"").toLowerCase().startsWith("phmaj001"))
											{
												input.Phone_Used_Site = "Concrete Products - ARB282";
											}
											show Bed_Length;
											show Bed_Width;
											show Bed_Height;
											show Bed_Height_2;
											show Truck_Size_1;
											show Truck_Size_2;
											hide Voucher_Footer_Details;
											hide Head_Office_Section;
											show Voucher;
											hide Voucher_Details;
										}
										// -------------------------
										// 5) EDIT MODE
										// -------------------------
										else
										{
											if(input.Document_Stage == "Draft")
											{
												disable Voucher;
												disable Number_Plate;
												disable Truck_Type;
												disable Number_of_Tyres;
												disable Front_Image;
												disable Front_Side_Image;
												show Bed_Length_Confirmed;
