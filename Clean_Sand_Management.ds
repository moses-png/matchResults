										{
											emp_name = ifnull(input.Employee.Employee_Name,"").trim();
											emp_no = ifnull(input.Employee.Employee_Number,"").trim();
											if(emp_name != "" && emp_no != "")
											{
												input.Display_Name_Employee = emp_name + " - " + emp_no;
											}
											else if(emp_name != "")
											{
												input.Display_Name_Employee = emp_name;
											}
											else if(emp_no != "")
											{
												input.Display_Name_Employee = emp_no;
											}
											else
											{
												input.Display_Name_Employee = "";
											}
										}
										else
										{
											input.Display_Name_Employee = "";
										}
						)
					}
				}

			}
