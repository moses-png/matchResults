											input.Global_Available_Stock = null;
											input.Store_Available_Stock = null;
											input.Quantity = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
										}
						)
					}
				}

			}
			Full_Validation7 as "Full Validation"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Item Issuing Details - Full Validation
										// =======================================
										errors = List();
										hdr = null;
										old_rec = null;
										req_type = "";
										stock_cond = "";
										qty_val = 0.0;
										new_base_qty = null;
										old_base_qty = 0.0;
										extra_needed = 0.0;
										store_stock = 0.0;
										is_tool = false;
										current_status = ifnull(input.Status,"").trim();
										saved_status = "";
										if(input.ID != null)
										{
											old_rec = Item_Issuing_Details[ID == input.ID];
											if(old_rec.ID != null)
											{
												saved_status = ifnull(old_rec.Status,"").trim();
											}
										}
										if(input.Issuing_Voucher == null)
										{
											errors.add("• Please select the Issuing Voucher.");
										}
										else
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID == null)
											{
												errors.add("• Selected Issuing Voucher was not found.");
											}
											else if(hdr.Store == null)
											{
												errors.add("• The selected Issuing Voucher has no Store.");
											}
										}
										if(input.Line_Number == null || input.Line_Number <= 0)
										{
											errors.add("• Line Number is required.");
										}
										if(input.Issuing_Voucher != null && input.Line_Number != null && input.Line_Number > 0)
										{
											dup = Item_Issuing_Details[Issuing_Voucher == input.Issuing_Voucher && Line_Number == input.Line_Number && ID != input.ID];
											if(dup.count() > 0)
											{
												errors.add("• Line Number " + input.Line_Number + " is already used.");
											}
										}
										req_type = ifnull(input.Request_Voucher_Type,"").trim();
										if(req_type == "")
										{
											errors.add("• Please select Request Voucher Type.");
										}
										if(req_type == "Employee Voucher" && input.Employee_Voucher == null)
										{
											errors.add("• Please select Employee Voucher.");
										}
										else if(req_type == "Work Order Task" && input.Work_Order_Task == null)
										{
											errors.add("• Please select Work Order Task.");
										}
										if(req_type == "Sales Voucher" || req_type == "Sand Sales" || req_type == "Stock Sales")
										{
											if(input.Sales_Voucher == null)
											{
												alert "Sales Voucher is required.";
												cancel submit;
											}
											if(input.Item_Taken == null)
											{
												alert "Item Taken is required.";
												cancel submit;
											}
											if(input.Items_Image == null)
											{
												alert "Items Image is required.";
												cancel submit;
											}
											if(input.Item == null)
											{
												alert "Item could not be resolved from Item Taken.";
												cancel submit;
											}
											if(input.Stock_Condition == null || input.Stock_Condition.trim() == "")
											{
												alert "Stock Condition is required.";
												cancel submit;
											}
											if(input.Unit_Of_Measure == null)
											{
												alert "Unit Of Measure is required.";
												cancel submit;
											}
											if(input.Cost == null || input.Cost < 0)
											{
												alert "Cost is required.";
												cancel submit;
											}
											if(input.Store_Available_Stock == null)
											{
												alert "Store Available Stock is missing.";
												cancel submit;
											}
											if(input.Global_Available_Stock == null)
											{
												alert "Global Available Stock is missing.";
												cancel submit;
											}
										}
										if(input.Item == null)
										{
											errors.add("• Please select the Item.");
										}
										stock_cond = ifnull(input.Stock_Condition,"").trim();
										if(stock_cond == "")
										{
											input.Stock_Condition = "New";
											stock_cond = "New";
										}
										if(input.Unit_Of_Measure == null)
										{
											errors.add("• Please select Unit Of Measure.");
										}
										if(input.Quantity == null)
										{
											errors.add("• Quantity must be greater than zero.");
										}
										else
										{
											qty_val = input.Quantity.toDecimal();
											if(qty_val <= 0)
											{
												errors.add("• Quantity must be greater than zero.");
											}
										}
										if(input.Taken_By == null)
										{
											errors.add("• Please select who took the item.");
										}
										if(input.Item != null && input.Unit_Of_Measure != null && input.Quantity != null && qty_val > 0)
										{
											check = store_management.po.check_uom_conversion_from_masaka_site_management(input.Item,input.Unit_Of_Measure);
											if(check == null || check.get("ok") != true)
											{
												errors.add("• " + ifnull(check.get("message"),"UOM conversion failed."));
											}
											else
											{
												tmp_base_qty = store_management.po.convert_to_base_qty_from_masaka_site_management(input.Item,input.Unit_Of_Measure,input.Quantity);
												if(tmp_base_qty == null)
												{
													errors.add("• Calculated base quantity is invalid.");
												}
												else
												{
													new_base_qty = tmp_base_qty.toDecimal();
													if(new_base_qty <= 0)
													{
														errors.add("• Calculated base quantity is invalid.");
													}
													else
													{
														input.Quantity_in_Base_Unit_Of_Measure = new_base_qty;
													}
												}
											}
										}
										should_validate_stock = false;
										if(req_type == "Employee Voucher")
										{
											if(input.ID == null)
											{
												should_validate_stock = true;
											}
											else if(current_status == "Approved" || current_status == "Issued" || current_status == "Borrowed")
											{
												should_validate_stock = true;
											}
										}
										else
										{
											if(input.ID != null && saved_status == "Approved" && current_status == "Approved")
											{
												should_validate_stock = true;
											}
										}
										if(should_validate_stock == true)
										{
											if(hdr != null && hdr.ID != null && hdr.Store != null && input.Item != null && new_base_qty != null && new_base_qty > 0)
											{
												stock_map = store_management.po.get_item_store_cost_from_masaka_site_management(input.Item,hdr.Store,stock_cond);
												store_stock = ifnull(stock_map.get("store_stock"),0.0).toDecimal();
												input.Store_Available_Stock = store_stock;
												input.Global_Available_Stock = ifnull(stock_map.get("global_stock"),0.0);
												old_base_qty = 0.0;
												if(input.ID != null && old_rec != null && old_rec.ID != null)
												{
													old_base_qty = ifnull(old_rec.Quantity_in_Base_Unit_Of_Measure,0.0).toDecimal();
												}
												if(req_type != "Employee Voucher" && saved_status == "Approved")
												{
													old_base_qty = 0.0;
												}
												extra_needed = new_base_qty - old_base_qty;
												if(extra_needed < 0)
												{
													extra_needed = 0.0;
												}
												if(extra_needed > 0)
												{
													if(store_stock <= 0)
													{
														errors.add("• No stock available in this Store for " + stock_cond + " condition.");
													}
													else if(extra_needed > store_stock)
													{
														errors.add("• Insufficient store stock. Required: " + extra_needed + " (Base UoM). Available: " + store_stock + " (Base UoM).");
													}
												}
											}
										}
										if(input.Item != null)
										{
											if(input.Item.Is_Tool == true)
											{
												is_tool = true;
											}
										}
										calc_line_total = ifnull(input.Quantity,0.0) * ifnull(input.Cost,0.0);
										if(is_tool == false && stock_cond != "Used")
										{
											if(calc_line_total <= 0)
											{
												errors.add("• Line Total cannot be zero. Please check Quantity or Cost.");
											}
										}
										else
										{
											if(input.Line_Total == null)
											{
												input.Line_Total = 0.0;
											}
										}
										if(is_tool && req_type != "Internal Transfer" && input.Expected_Return_Date == null)
										{
											errors.add("• Expected Return Date is required for tools unless Request Voucher Type is Internal Transfer.");
										}
										if(input.ID != null && input.Cancel_This_Line_Item == true)
										{
											if(input.Reason_Why_Cancelled == null || input.Reason_Why_Cancelled.trim() == "")
											{
												errors.add("• Please enter the reason why this line item was cancelled.");
											}
										}
										if(errors.isEmpty() == false)
										{
											msg = "Please fix the following:\n\n";
											for each  err in errors
											{
												msg = msg + err + "\n";
											}
											alert msg;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize_On_Delete1 as "Finalize On Delete"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// ITEM ISSUING DETAILS - FINALIZE ON DELETE
										// =====================================
										source_form_val = "Clean Sand Management - Item Issuing Details";
										// -------------------------------------
										// 1) Reverse Store stock posted from 
										// -------------------------------------
										store_reverse_resp = store_management.delete_item_issuing_from_CleanSand(input.ID);
										info store_reverse_resp;
										// -------------------------------------
										emp_rows = Employee_Issuing_Details[Source_Record_ID == input.ID && Source_Form == source_form_val];
										for each  erd in emp_rows
										{
											delete from Employee_Issuing_Details[ID == erd.ID];
										}
										vid_rows = Voucher_Issuing_Details[Source_Record_ID == input.ID && Source_Form == source_form_val];
										for each  vid in vid_rows
										{
											delete from Voucher_Issuing_Details[ID == vid.ID];
										}
						)
					}
				}

			}
