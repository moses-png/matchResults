			On_Net_Weight_Selected as "On Net Weight Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Net_Weight
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// WEIGHBRIDGE CALCULATION
										// =====================================================
										if(input.Gross_Weight != null)
										{
											net_weight_val = ifnull(input.Net_Weight,0.0);
											gross_weight_val = ifnull(input.Gross_Weight,0.0);
											if(net_weight_val > 0 && gross_weight_val > 0)
											{
												if(gross_weight_val >= net_weight_val)
												{
													input.Actual_Tonnes = round((gross_weight_val - net_weight_val) / 1000.0,2);
													input.Actual_Payment = round(input.Actual_Tonnes * ifnull(input.Rate_per_Ton,0.0),2);
													input.Sub_Total = input.Actual_Payment;
													input.Tax_Amount = ifnull(input.Tax_Amount,0.0);
													if(input.Discount_Type == "None" || input.Discount_Type == null)
													{
														input.Discount_Amount = 0.0;
													}
													input.Grand_Total = round(input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0.0),2);
													total_settled = ifnull(input.Amount_Paid,0.0) + ifnull(input.Amount_Credited,0.0);
													input.Balance_Due = round(input.Grand_Total - total_settled,2);
													if(input.Balance_Due < 0 && total_settled > 0)
													{
														input.Payment_Status = "Over Paid";
													}
													else if(input.Balance_Due == 0 && total_settled > 0)
													{
														if(ifnull(input.Amount_Credited,0.0) > 0 && ifnull(input.Amount_Paid,0.0) == 0)
														{
															input.Payment_Status = "Credit";
														}
														else
														{
															input.Payment_Status = "Paid";
														}
													}
													else if(input.Balance_Due > 0 && total_settled > 0)
													{
														input.Payment_Status = "Partially Paid";
													}
													else
													{
														input.Payment_Status = "Unpaid";
													}
												}
												else
												{
													alert "Gross Weight cannot be less than Net Weight.";
													input.Actual_Tonnes = null;
													input.Actual_Payment = null;
												}
											}
											else
											{
												input.Actual_Tonnes = null;
												input.Actual_Payment = null;
											}
										}
										else
										{
											input.Actual_Tonnes = null;
											input.Actual_Payment = null;
											input.Sub_Total = ifnull(input.Initial_Payment,0.0);
											input.Grand_Total = round(input.Sub_Total + ifnull(input.Tax_Amount,0.0) - ifnull(input.Discount_Amount,0.0),2);
											input.Balance_Due = round(input.Grand_Total - ifnull(input.Amount_Paid,0.0) - ifnull(input.Amount_Credited,0.0),2);
											if(input.Balance_Due < 0)
											{
												input.Amount_Returned = round(input.Balance_Due * -1,2);
											}
											else
											{
												input.Amount_Returned = 0.0;
											}
										}
						)
					}
				}

			}
