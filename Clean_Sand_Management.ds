			Full_Validation25 as "Full Validation"
			{
				type =  form
				form = Card_Sequence

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										if(input.Site == null)
										{
											errors = errors + "\n• Site is required.";
										}
										if(input.Prefix == null || input.Prefix.trim() == "")
										{
											errors = errors + "\n• Prefix is required.";
										}
										if(input.Next_Number == null)
										{
											errors = errors + "\n• Next Number is required.";
										}
										else if(input.Next_Number < 0)
										{
											errors = errors + "\n• Next Number cannot be negative.";
										}
										if(input.Card_Status == null || input.Card_Status.trim() == "")
										{
											errors = errors + "\n• Card Status is required.";
										}
										if(input.Rate_per_CBM == null)
										{
											errors = errors + "\n• Rate per CBM is required.";
										}
										else if(input.Rate_per_CBM < 0)
										{
											errors = errors + "\n• Rate per CBM cannot be negative.";
										}
										dup = Card_Sequence[Site == input.Site && Prefix == input.Prefix && ID != input.ID];
										if(dup.count() > 0)
										{
											errors = errors + "\n• Card Sequence already exists for this Site and Prefix.";
										}
										if(errors != "")
										{
											alert errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize_On_Create41 as "Finalize On Create"
			{
				type =  form
				form = Cash_Envelope

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
										// ======================================
										// CASH ENVELOPE → ON CREATE
										// ======================================
										input.Cash_Envelope_Status = "Open";
										siteId = null;
										if(input.Site != null)
										{
											siteId = input.Site.ID;
										}
										if(siteId != null && input.ID != null)
										{
											oldEnv = Cash_Envelope[Site == input.Site && ID != input.ID && Cash_Envelope_Status == "Open"];
											for each  e in oldEnv
											{
												e.Cash_Envelope_Status="In Safe";
											}
										}
										else
										{
											ps = ifnull(input.Display_Name_Site,"").trim();
											if(ps != "" && input.ID != null)
											{
												oldEnv2 = Cash_Envelope[Display_Name_Site == ps && ID != input.ID && Cash_Envelope_Status == "Open"];
												for each  e2 in oldEnv2
												{
													e2.Cash_Envelope_Status="In Safe";
												}
											}
										}
						)
					}
				}

			}
