			Full_Validation26 as "Full Validation"
			{
				type =  form
				form = Cash_Envelope

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										if(input.Cashier_Envelope == null)
										{
											errors = errors + "\n• Cashier Envelope is required.";
										}
										if(input.Cash_Envelope_Number == null || input.Cash_Envelope_Number.trim() == "")
										{
											errors = errors + "\n• Cash Envelope Number is required.";
										}
										else
										{
											if(!input.Cash_Envelope_Number.startsWith("E"))
											{
												errors = errors + "\n• Cash Envelope Number must start with letter 'E'.";
											}
										}
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
										alert "Heads up: When you open this new Cash Envelope, the previous one for this site will automatically change to 'In Safe'.";
						)
					}
				}

			}
