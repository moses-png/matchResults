			On_Item_Issuing_Voucher_S as "On Item Issuing Voucher Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Issuing_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Issuing_Voucher != null)
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID != null)
											{
												input.Display_Name_Issuing_Voucher = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"");
												input.Display_Name_Issued_By = ifnull(hdr.Issued_By,"");
												if(hdr.Store != null)
												{
													input.Store = ifnull(hdr.Store.Asset_Name,"") + " - " + ifnull(hdr.Store.Asset_ID,"");
												}
												else
												{
													input.Store = null;
												}
												voucher_name = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim();
												if(input.Line_Number != null && input.Line_Number > 0)
												{
													ln = input.Line_Number;
													lineNo = if(ln < 10,"0" + ln.toString(),ln.toString());
													if(voucher_name != "")
													{
														input.Item_Issuing_Number = voucher_name + "-" + lineNo;
													}
													else
													{
														input.Item_Issuing_Number = "-" + lineNo;
													}
												}
												else
												{
													if(voucher_name != "")
													{
														input.Item_Issuing_Number = voucher_name + "-";
													}
													else
													{
														input.Item_Issuing_Number = null;
													}
												}
											}
											else
											{
												input.Display_Name_Issuing_Voucher = null;
												input.Display_Name_Issued_By = null;
												input.Store = null;
												input.Item_Issuing_Number = null;
											}
										}
										else
										{
											input.Display_Name_Issuing_Voucher = null;
											input.Display_Name_Issued_By = null;
											input.Store = null;
											input.Item_Issuing_Number = null;
										}
						)
					}
				}

			}
			On_Item_Selected1 as "On Item Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Item
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										//ITEM ISSUING DETAILS
										// ON ITEM SELECTED
										// ======================================================
										// 1) ITEM CLEARED
										// ======================================================
										if(input.Item == null)
										{
											input.Display_Name_Item = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Cost = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											input.Global_Available_Stock = null;
											input.Store_Available_Stock = null;
											input.Quantity = null;
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Status = null;
											hide Expected_Return_Date;
											input.Expected_Return_Date = null;
											return;
										}
										// ======================================================
										// 2) ITEM ID
										// ======================================================
										item_id = null;
										item_id = input.Item.ID;
										if(item_id == null)
										{
											alert "Selected item could not be resolved.";
											input.Item = null;
											return;
										}
										// ======================================================
										// 3) RESOLVE STORE FROM ISSUING VOUCHER
										// ======================================================
										store_id = null;
										if(input.Issuing_Voucher != null)
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID != null && hdr.Store != null)
											{
												store_id = hdr.Store.ID;
											}
										}
										if(store_id == null)
										{
											alert "This voucher has no Store selected. Please check the Item Issuing Voucher header.";
											input.Item = null;
											input.Display_Name_Item = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Cost = null;
											input.Global_Available_Stock = null;
											input.Store_Available_Stock = null;
											return;
										}
										// ======================================================
										// 4) STOCK CONDITION
										// ======================================================
										cond = ifnull(input.Stock_Condition,"").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = cond;
										}
										// ======================================================
										// 5) GET ITEM + STOCK + COST + UOM FROM STORE MANAGEMENT
										// ======================================================
										stock_map = store_management.po.get_item_store_cost_from_masaka_site_management(item_id,store_id,cond);
										if(stock_map == null)
										{
											alert "Could not get item stock details from Store Management.";
											input.Display_Name_Item = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Cost = 0.0;
											input.Global_Available_Stock = 0.0;
											input.Store_Available_Stock = 0.0;
											return;
										}
										// ======================================================
										// 6) FILL ITEM DISPLAY
										// ======================================================
										input.Display_Name_Item = ifnull(stock_map.get("display_name_item"),"");
										// ======================================================
										// 7) FILL STOCK + COST
										// ======================================================
										input.Global_Available_Stock = ifnull(stock_map.get("global_stock"),0.0);
										input.Store_Available_Stock = ifnull(stock_map.get("store_stock"),0.0);
										input.Cost = ifnull(stock_map.get("cost"),0.0);
										// ======================================================
										// 8) FILL UOM
										// ======================================================
										input.Unit_Of_Measure = stock_map.get("base_uom");
										input.Display_Name_Unit_Of_Measure = ifnull(stock_map.get("base_uom_name"),"");
										if(input.Unit_Of_Measure == null)
										{
											alert "Base Unit of Measure is missing for this item in Store Management.";
										}
										// ======================================================
										// 9) CLEAR OLD QUANTITY CALCULATIONS ONLY
										// ======================================================
										input.Quantity = null;
										input.Quantity_in_Base_Unit_Of_Measure = null;
										input.Line_Total = null;
										Rate_In_Base_Unit = 0.0;
										// ======================================================
										// 10) STATUS / TOOL HANDLING
										// ======================================================
										req_type = ifnull(input.Request_Voucher_Type,"").trim();
										is_tool = ifnull(stock_map.get("is_tool"),false);
										if(is_tool == true && req_type != "Internal Transfer")
										{
											show Expected_Return_Date;
											input.Status = "Borrowed";
										}
										else if(is_tool == true && req_type == "Internal Transfer")
										{
											hide Expected_Return_Date;
											input.Expected_Return_Date = null;
											input.Status = "Transferring";
										}
										else
										{
											hide Expected_Return_Date;
											input.Expected_Return_Date = null;
											input.Status = "Issued";
										}
						)
					}
				}

			}
			On_Item_Taken_Selected as "On Item Taken Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Item_Taken
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// ITEM ISSUING DETAILS
										// ======================================================
										// 1) ITEM_TAKEN CLEARED
										if(input.Item_Taken == null)
										{
											input.Item = null;
											input.Display_Name_Item = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Cost = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											input.Global_Available_Stock = null;
											input.Store_Available_Stock = null;
											input.Quantity = null;
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Status = null;
											hide Expected_Return_Date;
											input.Expected_Return_Date = null;
											return;
										}
										// 2) GET ITEM FROM ITEM_TAKEN
										if(input.Item_Taken.Item == null)
										{
											alert "Selected Sales Voucher item has no Item.";
											input.Item_Taken = null;
											input.Item = null;
											return;
										}
										input.Item = input.Item_Taken.Item;
										item_id = input.Item.ID;
										if(item_id == null)
										{
											alert "Selected item could not be resolved.";
											input.Item_Taken = null;
											input.Item = null;
											return;
										}
										// 3) RESOLVE STORE FROM ISSUING VOUCHER
										store_id = null;
										if(input.Issuing_Voucher != null)
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID != null && hdr.Store != null)
											{
												store_id = hdr.Store.ID;
											}
										}
										if(store_id == null)
										{
											alert "This voucher has no Store selected. Please check the Item Issuing Voucher header.";
											input.Item_Taken = null;
											input.Item = null;
											input.Display_Name_Item = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Cost = null;
											input.Global_Available_Stock = null;
											input.Store_Available_Stock = null;
											return;
										}
										// 4) STOCK CONDITION
										cond = ifnull(input.Stock_Condition,"").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = cond;
										}
										// ======================================================
										// 5) GET ITEM + STOCK + COST + UOM FROM STORE MANAGEMENT
										// ======================================================
										stock_map = store_management.po.get_item_store_cost_from_masaka_site_management(item_id,store_id,cond);
										if(stock_map == null)
										{
											alert "Could not get item stock details from Store Management.";
											input.Display_Name_Item = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Cost = 0.0;
											input.Global_Available_Stock = 0.0;
											input.Store_Available_Stock = 0.0;
											return;
										}
										// 6) FILL ITEM DISPLAY
										input.Display_Name_Item = ifnull(stock_map.get("display_name_item"),"");
										// 7) FILL STOCK + COST
										input.Global_Available_Stock = ifnull(stock_map.get("global_stock"),0.0);
										input.Store_Available_Stock = ifnull(stock_map.get("store_stock"),0.0);
										input.Cost = ifnull(stock_map.get("cost"),0.0);
										// 8) FILL UOM
										input.Unit_Of_Measure = stock_map.get("base_uom");
										input.Display_Name_Unit_Of_Measure = ifnull(stock_map.get("base_uom_name"),"");
										if(input.Unit_Of_Measure == null)
										{
											alert "Base Unit of Measure is missing for this item in Store Management.";
										}
										// 9) CLEAR QUANTITY CALCULATIONS FOR NOW
										input.Quantity = null;
										input.Quantity_in_Base_Unit_Of_Measure = null;
										input.Line_Total = null;
										Rate_In_Base_Unit = 0.0;
						)
					}
				}

			}
			On_Line_Number_Selected as "On Line Number Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Line_Number
				{
					actions 
					{
						custom deluge script
						(
											if(input.Line_Number != null && input.Line_Number > 0)
										{
											ln = input.Line_Number;
											lineNo = if(ln < 10,"0" + ln.toString(),ln.toString());
										}
										else
										{
											input.Item_Issuing_Number = null;
											if(input.Request_Voucher_Type == "Internal Transfer")
											{
												input.Request_Voucher = null;
											}
											return;
										}
										if(input.Issuing_Voucher != null)
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID != null && ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim() != "")
											{
												input.Item_Issuing_Number = hdr.Display_Name_Item_Issuing_Voucher + "-" + lineNo;
											}
											else
											{
												input.Item_Issuing_Number = "-" + lineNo;
											}
										}
										else
										{
											input.Item_Issuing_Number = "-" + lineNo;
										}
										if(input.Request_Voucher_Type == "Internal Transfer")
										{
											input.Request_Voucher = input.Item_Issuing_Number;
										}
						)
					}
				}

			}
			On_Quantity_Selected1 as "On Quantity Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Quantity
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// ITEM ISSUING DETAILS — ON QUANTITY CHANGED
										// ======================================================
										if(input.Item == null || input.Unit_Of_Measure == null)
										{
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// Resolve Store
										store_id = null;
										if(input.Issuing_Voucher != null)
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID != null && hdr.Store != null)
											{
												store_id = hdr.Store.ID;
											}
										}
										if(store_id == null)
										{
											alert "This Issuing Voucher has no Store selected.";
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// Stock condition
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = cond;
										}
										// Always refresh stock/cost first
										stock_map = store_management.po.get_item_store_cost_from_masaka_site_management(input.Item.ID,store_id,cond);
										if(stock_map != null)
										{
											input.Global_Available_Stock = ifnull(stock_map.get("global_stock"),0.0);
											input.Store_Available_Stock = ifnull(stock_map.get("store_stock"),0.0);
											if(input.Cost == null || input.Cost <= 0)
											{
												input.Cost = ifnull(stock_map.get("cost"),0.0);
											}
										}
										// If quantity is blank, stop after refreshing stock
										if(input.Quantity == null || input.Quantity <= 0)
										{
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// UOM validation
										check = store_management.po.check_uom_conversion_from_masaka_site_management(input.Item.ID,input.Unit_Of_Measure.ID);
										if(check.get("ok") != true)
										{
											alert check.get("message");
											input.Unit_Of_Measure = null;
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// Convert to base quantity
										resp = store_management.po.recalculate_po_detail_line_from_masaka_site_management(input.Item.ID,input.Unit_Of_Measure.ID,input.Quantity,ifnull(input.Cost,0.0));
										base_qty = ifnull(resp.get("qty_in_base"),0.0);
										if(base_qty <= 0)
										{
											alert "Calculated base quantity is invalid.";
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure = base_qty;
										// Stock warning
										if(base_qty > ifnull(input.Store_Available_Stock,0.0))
										{
											alert "Insufficient store stock. Available: " + ifnull(input.Store_Available_Stock,0.0) + " Base UOM. Required: " + base_qty;
											input.Quantity = null;
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// Line total
										input.Line_Total = (base_qty * ifnull(input.Cost,0.0)).round(2);
										// Rate in base unit
										if(base_qty > 0 && input.Line_Total != null && input.Line_Total > 0)
										{
											Rate_In_Base_Unit = (input.Line_Total / base_qty).round(2);
										}
										else
										{
											Rate_In_Base_Unit = 0.0;
										}
						)
					}
				}

			}
			On_Reason_Why_Cancelled_S as "On Reason Why Cancelled Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

