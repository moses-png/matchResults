											input.Display_Name_Site_To = input.Site_To.Display_Name_Asset_Name;
											if(input.Site_Location_To != null)
											{
												input.Delivery_To = input.Display_Name_Site_To + " - " + input.Site_Location_To.Site_Location_Name;
											}
											else
											{
												input.Delivery_To = input.Display_Name_Site_To;
											}
										}
										else
										{
											input.Display_Name_Site_To = "";
											input.Site_Location_To = null;
											input.Delivery_To = "";
