			On_Transfer_Item_Selected as "On Transfer Item Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Transfer_Item
				{
					actions 
					{
						custom deluge script
						(
											if(input.Transfer_Item != null)
										{
											// =====================================================
											// DISPLAY NAME TRANSFER ITEM
											// =====================================================
											Display_Name_Transfer_Item = ifnull(input.Transfer_Item.Transfer_Number,"");
											// =====================================================
											// CLEAR FIELDS BEFORE FILLING
											// =====================================================
											input.Display_Name_Item = null;
											input.Quantity_to_Receive = null;
											input.Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_to_Receive = null;
											input.Quantity_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											// =====================================================
											// ITEM DISPLAY NAME
											// =====================================================
											input.Display_Name_Item = ifnull(input.Transfer_Item.Display_Name_Item,"");
											// Enrich display name from the linked item
											if(input.Transfer_Item.Item != null)
											{
												itemName = ifnull(input.Transfer_Item.Item.Item_Name,"");
												itemSKU = ifnull(input.Transfer_Item.Item.SKU,"");
												if(itemName != "" && itemSKU != "")
												{
													input.Display_Name_Item = itemName + " - " + itemSKU;
												}
												else if(itemName != "")
												{
													input.Display_Name_Item = itemName;
												}
											}
											// =====================================================
											// UNIT OF MEASURE
											// Use values already saved on Stock Transfer Form
											// =====================================================
											if(input.Transfer_Item.Unit_Of_Measure != null)
											{
												input.Unit_Of_Measure_Received = input.Transfer_Item.Unit_Of_Measure;
											}
											uom_display = ifnull(input.Transfer_Item.Display_Name_Unit_of_Measure,"");
											input.Display_Name_Unit_Of_Measure_Received = uom_display;
											input.Display_Name_Unit_Of_Measure_to_Receive = uom_display;
											// =====================================================
											// QUANTITY REMAINING
											// =====================================================
											qty_sent = ifnull(input.Transfer_Item.Quantity,0.0);
											qty_already_received = ifnull(input.Transfer_Item.Quantity_Received,0.0);
											qty_remaining = qty_sent - qty_already_received;
											if(qty_remaining < 0)
											{
												qty_remaining = 0.0;
											}
											if(qty_remaining > 0)
											{
												input.Quantity_to_Receive = qty_remaining;
											}
											else
											{
												input.Quantity_to_Receive = null;
												info "This transfer has already been fully received.";
											}
											// =====================================================
											// STOCK CONDITION
											// =====================================================
											transfer_condition = ifnull(input.Transfer_Item.Stock_Condition,"").trim();
											if(transfer_condition != "")
											{
												input.Stock_Condition = transfer_condition;
											}
											else
											{
												input.Stock_Condition = "New";
											}
											// =====================================================
											// USER ENTERS ACTUAL QUANTITY RECEIVED
											// =====================================================
											input.Quantity_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										}
										else
										{
											Display_Name_Transfer_Item = null;
											input.Display_Name_Item = null;
											input.Quantity_to_Receive = null;
											input.Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_to_Receive = null;
											input.Quantity_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Stock_Condition = null;
										}
						)
					}
				}

			}
			On_Number_Plate_Selected as "On Number Plate Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Number_Plate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Number_Plate != null)
										{
											number_plate_text = ifnull(input.Number_Plate.Number_Plate,"").trim();
											tsf_number_text = ifnull(input.Number_Plate.TSF_Number,"").trim();
											if(number_plate_text != "" && tsf_number_text != "")
											{
												input.Display_Name_Number_Plate = number_plate_text + " - " + tsf_number_text;
											}
											else if(number_plate_text != "")
											{
												input.Display_Name_Number_Plate = number_plate_text;
											}
											else if(tsf_number_text != "")
											{
												input.Display_Name_Number_Plate = tsf_number_text;
											}
											else
											{
												input.Display_Name_Number_Plate = "";
											}
											input.Truck_Type = ifnull(input.Number_Plate.Display_Name_Truck_Type,"");
										}
										else
										{
											input.Display_Name_Number_Plate = "";
											input.Truck_Type = "";
											input.Truck_Measurement = null;
											input.Truck_Size_1 = 0;
											input.Truck_Size_2 = 0;
											input.Truck_Size = "";
											input.Truck_CBM = 0.0;
										}
										// Recalculate totals
										input.Sub_Total = ifnull(input.Sub_Total,0.0);
										input.Tax_Amount = ifnull(input.Tax_Amount,0.0);
										if(input.Discount_Type == "None" || input.Discount_Type == null)
										{
											input.Discount_Amount = 0.0;
										}
										input.Grand_Total = input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0.0);
										input.Balance_Due = input.Grand_Total - ifnull(input.Amount_Paid,0.0) - ifnull(input.Amount_Credited,0.0);
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0.0;
										}
										if(input.Balance_Due <= 0 && input.Grand_Total > 0)
										{
											input.Payment_Status = "Paid";
										}
										else if(ifnull(input.Amount_Paid,0.0) + ifnull(input.Amount_Credited,0.0) > 0)
										{
											input.Payment_Status = "Partially Paid";
										}
										else
										{
											input.Payment_Status = "Unpaid";
										}
						)
					}
				}

			}
			On_Rate_Per_CBM_Selected as "On Rate Per CBM Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Rate_per_CBM
				{
					actions 
					{
						custom deluge script
						(
											// ==================================================
										// RATE PER CBM: RECALCULATE SAND SALES TOTALS
										// ==================================================
										truck_cbm_val = ifnull(input.Truck_CBM,0.0);
										rate_per_cbm_val = ifnull(input.Rate_per_CBM,0.0);
										sand_total = truck_cbm_val * rate_per_cbm_val;
										input.Initial_Payment = sand_total;
										input.Sub_Total = sand_total;
										input.Tax_Amount = ifnull(input.Tax_Amount,0.0);
										if(input.Discount_Type == "None" || input.Discount_Type == null)
										{
											input.Discount_Amount = 0.0;
										}
										input.Grand_Total = input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0.0);
										input.Balance_Due = input.Grand_Total - ifnull(input.Amount_Paid,0.0) - ifnull(input.Amount_Credited,0.0);
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0.0;
										}
										if(input.Grand_Total <= 0)
										{
											input.Payment_Status = "Unpaid";
										}
										else if(input.Balance_Due <= 0)
										{
											input.Payment_Status = "Paid";
										}
										else if(ifnull(input.Amount_Paid,0.0) + ifnull(input.Amount_Credited,0.0) > 0)
										{
											input.Payment_Status = "Partially Paid";
										}
										else
										{
											input.Payment_Status = "Unpaid";
										}
						)
					}
				}

			}
			On_Sales_Type_Selected1 as "On Sales Type Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Sales_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Sales_Type == "Sand Sales")
										{
											show Sand_Sales;
											show Number_Plate;
											show Card_Number;
											show Truck_Type;
											show Truck_Measurement;
											show Truck_Size_1;
											show Truck_Size_2;
											show Truck_Size;
											show Truck_CBM;
											show Item;
											show Unit_Of_Measure;
											show Store_Item_Stock;
											show Quantity_Available;
											show Rate_per_CBM;
											hide Product_Details;
										}
										else
										{
											hide Sand_Sales;
											hide Number_Plate;
											hide Delivery_Note;
											hide Truck_Type;
											hide Card_Number;
											hide Truck_Measurement;
											hide Truck_Size_1;
											hide Truck_Size_2;
											hide Truck_Size;
											hide Truck_CBM;
											hide Item;
											hide Unit_Of_Measure;
											hide Store_Item_Stock;
											hide Quantity_Available;
											hide Rate_per_CBM;
											input.Number_Plate = null;
											input.Delivery_Note = null;
											input.Card_Number = "";
											input.Truck_Type = "";
											input.Truck_Measurement = null;
											input.Truck_Size_1 = null;
											input.Truck_Size_2 = null;
											input.Truck_Size = null;
											input.Truck_CBM = null;
											input.Item = null;
											input.Unit_Of_Measure = null;
											input.Store_Item_Stock = null;
											input.Quantity_Available = null;
											input.Rate_per_CBM = null;
											show Product_Details;
											itemTotal = 0.0;
											for each  r in input.Product_Details
											{
												itemTotal = itemTotal + ifnull(r.Line_Total,0.0);
											}
											input.Sub_Total = round(itemTotal,2);
											input.Grand_Total = input.Sub_Total + ifnull(input.Tax_Amount,0.0) - ifnull(input.Discount_Amount,0.0);
											input.Balance_Due = input.Grand_Total - ifnull(input.Amount_Paid,0.0) - ifnull(input.Amount_Credited,0.0);
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0.0;
											}
											if(input.Balance_Due <= 0 && input.Grand_Total > 0)
											{
												input.Payment_Status = "Paid";
											}
											else if(ifnull(input.Amount_Paid,0.0) + ifnull(input.Amount_Credited,0.0) > 0)
											{
												input.Payment_Status = "Partially Paid";
											}
											else
											{
												input.Payment_Status = "Unpaid";
											}
										}
						)
					}
				}

			}
			On_Store_Item_Stock_Selec2 as "On Store Item Stock Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Store_Item_Stock
