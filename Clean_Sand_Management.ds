										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
						)
					}
				}

			}
			Set_Up_Form20 as "Set Up Form"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// PURCHASE ORDER - SET UP FORM
										// ======================================
										// --------------------------------------
										// HEADER CONTROLS
										// --------------------------------------
										disable PO_Total;
										disable PO_Status;
										disable PO_Total_Paid;
										disable Payment_Status;
										disable Receive_Status;
										hide PO_Billed_Total;
										hide PO_Total_Paid;
										hide Reason_Why_Closed;
										// ======================================
										// SUBFORM CONTROLS
										// ======================================
										disable PO_Details.Purchase_Order_Number;
										disable PO_Details.Line_Total;
										hide PO_Details.Display_Name_Item;
										hide PO_Details.Display_Name_Unit_Of_Measure;
										hide Site;
										hide Display_Name_Employee_Voucher;
										hide PO_Details.Quantity_Received;
										hide PO_Details.Quantity_Remaining;
										hide PO_Details.Purchase_Order_Details_Number;
										hide PO_Details.Quantity_in_Base_Unit_Of_Measure;
										hide PO_Details.Receiving_Status;
										hide PO_Details.Quantity_Unbilled;
										hide PO_Details.Quantity_Billed;
										hide PO_Details.Quantity_Billable;
										hide PO_Details.Billing_Status;
										hide PO_Details.Display_Name_Purchase_Order;
										hide PO_Details.Purchase_Order_Number;
										// ================================
										// SET UP FORM
										// ================================
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										disable Bill_Status;
										disable Payment_Status;
										disable PO_Number;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// ===============================================
										// HIDE PO DETAILS SUBFORM BACKEND FIELDS
										// ===============================================
										hide PO_Details.User_Role;
										hide PO_Details.User_Name;
										hide PO_Details.User_Email;
										hide PO_Details.Created_By_Name;
										hide PO_Details.Created_By_Email;
										hide PO_Details.Created_By_Time;
										hide PO_Details.Updated_By_Name;
										hide PO_Details.Updated_By_Email;
										hide PO_Details.Updated_By_Time;
										if(input.ID != null)
										{
											show Close_Purchase_Order;
										}
										else
										{
											hide Close_Purchase_Order;
										}
						)
					}
				}

			}
			On_Item_Selected3 as "On Item Selected"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on user input of PO_Details.Item
				{
					actions 
					{
						custom deluge script
						(
											for each  po_det in input.PO_Details
										{
											if(po_det.Item != null)
											{
												name = ifnull(po_det.Item.Item_Name,"").trim();
												sku = ifnull(po_det.Item.SKU,"").trim();
												po_det.Display_Name_Item=if(sku != "",name + " - " + sku,name);
												if(po_det.Unit_Of_Measure == null)
												{
													po_det.Unit_Of_Measure=po_det.Item.Base_Unit_Of_Measure;
												}
												if(po_det.Unit_Of_Measure != null)
												{
													po_det.Display_Name_Unit_Of_Measure=po_det.Unit_Of_Measure.Unit_Of_Measure_Name;
												}
												else
												{
													po_det.Display_Name_Unit_Of_Measure=null;
												}
											}
											else
											{
												po_det.Display_Name_Item=null;
												po_det.Unit_Of_Measure=null;
												po_det.Display_Name_Unit_Of_Measure=null;
												po_det.Quantity_in_Base_Unit_Of_Measure=null;
												po_det.Line_Total=null;
												continue;
											}
											if(po_det.Item != null && po_det.Unit_Of_Measure != null)
											{
												check = store_management.po.check_uom_conversion_from_masaka_site_management(po_det.Item,po_det.Unit_Of_Measure);
												if(check.get("ok") != true)
												{
													alert check.get("message");
													po_det.Unit_Of_Measure=null;
													po_det.Display_Name_Unit_Of_Measure=null;
													po_det.Quantity_in_Base_Unit_Of_Measure=null;
													po_det.Line_Total=null;
												}
												else
												{
													resp = store_management.po.recalculate_po_detail_line_from_masaka_site_management(po_det.Item,po_det.Unit_Of_Measure,po_det.Quantity_Ordered,po_det.Unit_Cost);
													po_det.Display_Name_Unit_Of_Measure=resp.get("display_uom_name");
													po_det.Quantity_in_Base_Unit_Of_Measure=resp.get("qty_in_base");
													po_det.Line_Total=resp.get("line_total");
												}
											}
										}
										po_total = 0.0;
										for each  po_line in input.PO_Details
										{
											po_total = po_total + ifnull(po_line.Line_Total,0.0);
										}
										input.PO_Total = po_total;
						)
					}
				}

			}
			On_Quantity_Ordered_Selec as "On Quantity Ordered Selected"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on user input of PO_Details.Quantity_Ordered
				{
					actions 
					{
						custom deluge script
						(
											for each  po_det in input.PO_Details
										{
											if(po_det.Item == null || po_det.Unit_Of_Measure == null)
											{
												po_det.Quantity_in_Base_Unit_Of_Measure=null;
												po_det.Line_Total=null;
												continue;
											}
											check = store_management.po.check_uom_conversion_from_masaka_site_management(po_det.Item,po_det.Unit_Of_Measure);
											if(check.get("ok") != true)
											{
												alert check.get("message");
												po_det.Quantity_in_Base_Unit_Of_Measure=null;
												po_det.Line_Total=null;
												continue;
											}
											resp = store_management.po.recalculate_po_detail_line_from_masaka_site_management(po_det.Item,po_det.Unit_Of_Measure,po_det.Quantity_Ordered,po_det.Unit_Cost);
											po_det.Display_Name_Unit_Of_Measure=resp.get("display_uom_name");
											po_det.Quantity_in_Base_Unit_Of_Measure=resp.get("qty_in_base");
											po_det.Line_Total=resp.get("line_total");
											if(po_det.Quantity_Ordered != null)
											{
												received_qty = ifnull(po_det.Quantity_Received,0.0);
												po_det.Quantity_Remaining=po_det.Quantity_Ordered - received_qty;
												if(po_det.Quantity_Remaining < 0)
												{
													po_det.Quantity_Remaining=0.0;
												}
											}
										}
										po_total = 0.0;
										for each  po_det in input.PO_Details
										{
											po_total = po_total + ifnull(po_det.Line_Total,0.0);
										}
										input.PO_Total = po_total;
						)
					}
				}

			}
