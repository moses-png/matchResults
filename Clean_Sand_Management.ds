			On_Purchase_Order_Selecte as "On Purchase Order Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Purchase_Order
				{
					actions 
					{
						custom deluge script
						(
											if(input.Purchase_Order != null)
										{
											po = Purchase_Order[ID == input.Purchase_Order];
											if(po.ID != null)
											{
												full_name = "";
												site_name = ifnull(po.Site,"").trim();
												po_number = ifnull(po.PO_Number,"").trim();
												if(site_name != "")
												{
													full_name = site_name;
												}
												if(po_number != "")
												{
													if(full_name != "")
													{
														full_name = full_name + " - " + po_number;
													}
													else
													{
														full_name = po_number;
													}
												}
												input.Display_Name_Voucher = full_name;
											}
											else
											{
												input.Display_Name_Voucher = null;
											}
											input.Item = null;
											input.Display_Name_Item = null;
											input.Quantity_to_Receive = null;
											input.Display_Name_Unit_Of_Measure_to_Receive = null;
											input.Quantity_Received = null;
											input.Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										}
										else
										{
											input.Display_Name_Voucher = null;
											input.Item = null;
											input.Display_Name_Item = null;
											input.Quantity_to_Receive = null;
											input.Display_Name_Unit_Of_Measure_to_Receive = null;
											input.Quantity_Received = null;
											input.Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										}
						)
					}
				}

			}
			On_Quantity_Received_Sele as "On Quantity Received Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Quantity_Received
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ON QUANTITY RECEIVED
										// =====================================================
										if(input.Unit_Of_Measure_Received == null)
										{
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										if(input.Quantity_Received == null || input.Quantity_Received <= 0)
										{
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										if(input.Receiving_Type == "Internal Transfer")
										{
											to_receive = ifnull(input.Quantity_to_Receive,0.0);
											if(input.Quantity_Received != to_receive)
											{
												alert "For Internal Transfer, Quantity Received must equal Quantity to Receive: " + to_receive;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										else if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return")
										{
											to_receive = ifnull(input.Quantity_to_Receive,0.0);
											if(input.Quantity_Received > to_receive)
											{
												alert "You cannot return more than the remaining quantity. Remaining: " + to_receive;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										else if(input.Receiving_Type == "Purchase Order")
										{
											to_receive = ifnull(input.Quantity_to_Receive,0.0);
											if(input.Quantity_Received > to_receive)
											{
												alert "You cannot receive more than the remaining quantity. Remaining: " + to_receive;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										item_id = null;
										if(input.Receiving_Type == "Purchase Order")
										{
											if(input.Item != null)
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID != null && po_det.Item != null)
												{
													item_id = po_det.Item;
												}
											}
										}
										else if(input.Receiving_Type == "Internal Transfer")
										{
											if(input.Transfer_Item != null && input.Transfer_Item.Item != null)
											{
												item_id = input.Transfer_Item.Item;
											}
										}
										else if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return")
										{
											if(input.Item_Issuing_Details != null)
											{
												issue_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
												if(issue_rec.ID != null && issue_rec.Item != null)
												{
													item_id = issue_rec.Item;
												}
											}
										}
										else
										{
											if(input.Item != null)
											{
												item_id = input.Item;
											}
										}
										if(item_id == null)
										{
											alert "The item could not be identified.";
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										check = store_management.po.check_uom_conversion_from_masaka_site_management(item_id,input.Unit_Of_Measure_Received);
										if(check == null)
										{
											alert "No response was returned while checking the UOM conversion.";
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										if(ifnull(check.get("ok"),false) != true)
										{
											error_message = "UOM conversion failed.";
											if(check.get("message") != null)
											{
												error_message = check.get("message").toString();
											}
											alert error_message;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										resp = store_management.po.recalculate_po_detail_line_from_masaka_site_management(item_id,input.Unit_Of_Measure_Received,input.Quantity_Received,ifnull(input.Rate,0.0));
										if(resp == null)
										{
											alert "No response was returned while converting the quantity.";
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										base_qty = ifnull(resp.get("qty_in_base"),0.0);
										if(base_qty <= 0)
										{
											alert "Unable to calculate the quantity in base unit.";
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure_Received = base_qty.round(2);
										if(input.Rate != null && input.Rate >= 0)
										{
											input.Line_Total = (input.Quantity_Received * input.Rate).round(2);
										}
										else
										{
											input.Line_Total = null;
										}
						)
					}
				}

			}
			On_Rate_Selected2 as "On Rate Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Rate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Receiving_Type == "Internal Transfer")
										{
											if(input.Rate != null && input.Quantity_Received != null)
											{
												input.Line_Total = input.Rate * input.Quantity_Received;
											}
											else
											{
												input.Line_Total = null;
											}
										}
						)
					}
				}

			}
			On_Receiving_Type_Selecte as "On Receiving Type Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Receiving_Type
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// Stock Receiving Details -> On Receiving Type Selected
										// ========================================
										hide Voucher;
										hide Purchase_Order;
										hide Item;
										hide Item_Issuing_Details;
										hide Internal_Transfer_Number;
										hide Item_Issuing_Details;
										hide Stock_Return_Number;
										hide Tool_Return_Number;
										hide Transfer_Item;
										disable Voucher;
										disable Purchase_Order;
										disable Item;
										disable Item_Issuing_Details;
										disable Internal_Transfer_Number;
										disable Stock_Return_Number;
										disable Tool_Return_Number;
										disable Item_Issuing_Details;
										input.Voucher = null;
										input.Purchase_Order = null;
										Stock_Created = null;
										input.Item_Issuing_Details = null;
										input.Item_Issuing_Details = null;
										input.Internal_Transfer_Number = null;
										input.Stock_Return_Number = null;
										input.Tool_Return_Number = null;
										input.Display_Name_Voucher = null;
										input.Display_Name_Item = null;
										input.Display_Name_Receiving_Type = ifnull(input.Receiving_Type,"");
										input.Item = null;
										input.Stock_Condition = null;
										input.Notes = null;
										input.Quantity_to_Receive = null;
										input.Quantity_Received = null;
										input.Unit_Of_Measure_Received = null;
										input.Display_Name_Unit_Of_Measure_to_Receive = null;
										input.Display_Name_Unit_Of_Measure_Received = null;
										input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										input.Line_Total = null;
										input.Rate = null;
										if(input.Receiving_Type == "Purchase Order")
										{
											show Purchase_Order;
											show Item;
											enable Purchase_Order;
											enable Item;
										}
										else if(input.Receiving_Type == "Internal Transfer")
										{
											show Internal_Transfer_Number;
											show Transfer_Item;
											enable Internal_Transfer_Number;
											enable Transfer_Item;
										}
										else if(input.Receiving_Type == "Stock Return")
										{
											show Stock_Return_Number;
											show Item_Issuing_Details;
											enable Stock_Return_Number;
											enable Item_Issuing_Details;
										}
										else if(input.Receiving_Type == "Tool Return")
										{
											show Tool_Return_Number;
											show Item_Issuing_Details;
											enable Tool_Return_Number;
											enable Item_Issuing_Details;
										}
						)
					}
				}

			}
			On_Stock_Receiving_Vouche as "On Stock Receiving Voucher Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Stock_Receiving_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Stock_Receiving_Voucher != null)
										{
											srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
											if(srv.ID != null)
											{
												input.Display_Name_Stock_Receiving_Voucher = srv.Display_Name_Stock_Receiving_Book;
												if(srv.Store != null)
												{
													input.Store = srv.Store.Asset_Name + " - " + srv.Store.Asset_ID;
												}
												else
												{
													input.Store = null;
												}
												input.Display_Name_Received_By = srv.Received_By;
												num_txt = null;
												if(input.Stock_Receiving_Voucher_Number != null && input.Stock_Receiving_Voucher_Number > 0)
												{
													if(input.Stock_Receiving_Voucher_Number < 10)
													{
														num_txt = "0" + input.Stock_Receiving_Voucher_Number.toString();
													}
													else
													{
														num_txt = input.Stock_Receiving_Voucher_Number.toString();
													}
													input.Stock_Receiving_Voucher_and_Number = srv.Display_Name_Stock_Receiving_Book + "-" + num_txt;
												}
												else
												{
													input.Stock_Receiving_Voucher_and_Number = srv.Display_Name_Stock_Receiving_Book;
												}
											}
											else
											{
												input.Display_Name_Stock_Receiving_Voucher = null;
												input.Store = null;
												input.Display_Name_Received_By = null;
												input.Stock_Receiving_Voucher_and_Number = null;
											}
										}
										else
										{
											input.Display_Name_Stock_Receiving_Voucher = null;
											input.Store = null;
											input.Display_Name_Received_By = null;
											input.Stock_Receiving_Voucher_and_Number = null;
										}
						)
					}
				}

			}
			On_Stock_Receiving_Vouche1 as "On Stock Receiving Voucher Number Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Stock_Receiving_Voucher_Number
				{
					actions 
					{
						custom deluge script
						(
											num_txt = null;
										if(input.Stock_Receiving_Voucher_Number != null)
										{
											if(input.Stock_Receiving_Voucher_Number < 10)
											{
												num_txt = "0" + input.Stock_Receiving_Voucher_Number.toString();
											}
											else
											{
												num_txt = input.Stock_Receiving_Voucher_Number.toString();
											}
										}
										if(input.Stock_Receiving_Voucher != null && num_txt != null)
										{
											srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
											if(srv.ID != null)
											{
												voucher_name = ifnull(srv.Display_Name_Stock_Receiving_Book,"").trim();
												if(voucher_name != "")
												{
													input.Stock_Receiving_Voucher_and_Number = voucher_name + "-" + num_txt;
												}
												else
												{
													input.Stock_Receiving_Voucher_and_Number = num_txt;
												}
											}
											else
											{
												input.Stock_Receiving_Voucher_and_Number = num_txt;
											}
										}
										else if(num_txt != null)
										{
											input.Stock_Receiving_Voucher_and_Number = num_txt;
										}
										else
										{
											input.Stock_Receiving_Voucher_and_Number = null;
										}
						)
					}
				}

			}
			On_Unit_Of_Measure_Receiv as "On Unit Of Measure Received Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Unit_Of_Measure_Received
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ON UNIT OF MEASURE RECEIVED SELECTED
										// =====================================================
										if(input.Unit_Of_Measure_Received != null)
										{
											input.Display_Name_Unit_Of_Measure_Received = input.Unit_Of_Measure_Received.Unit_Of_Measure_Name;
										}
										else
										{
											input.Display_Name_Unit_Of_Measure_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										// =====================================================
										// LOAD SOURCE DETAILS
										// =====================================================
										issue_rec = null;
										if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
										}
										// =====================================================
										// INTERNAL TRANSFER UOM VALIDATION
										// =====================================================
										if(input.Receiving_Type == "Internal Transfer")
										{
											if(input.Transfer_Item == null)
											{
												alert "Stock Transfer Item is required.";
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
											transfer_uom_id = input.Transfer_Item.Unit_Of_Measure;
											transfer_display_uom = ifnull(input.Transfer_Item.Display_Name_Unit_of_Measure,"");
											if(transfer_uom_id != null && input.Unit_Of_Measure_Received != transfer_uom_id)
											{
												alert "For Internal Transfer, Unit Of Measure Received must be the same as the transferred Unit Of Measure.";
												input.Unit_Of_Measure_Received = transfer_uom_id;
												input.Display_Name_Unit_Of_Measure_Received = transfer_display_uom;
												input.Display_Name_Unit_Of_Measure_to_Receive = transfer_display_uom;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										// =====================================================
										// STOCK RETURN / TOOL RETURN UOM VALIDATION
										// =====================================================
										else if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return")
										{
											if(issue_rec != null && issue_rec.ID != null && issue_rec.Unit_Of_Measure != null && input.Unit_Of_Measure_Received != issue_rec.Unit_Of_Measure)
											{
												alert "For " + input.Receiving_Type + ", Unit Of Measure Received must be the same as the issued Unit Of Measure.";
												input.Unit_Of_Measure_Received = issue_rec.Unit_Of_Measure;
												input.Display_Name_Unit_Of_Measure_Received = issue_rec.Unit_Of_Measure.Unit_Of_Measure_Name;
												input.Display_Name_Unit_Of_Measure_to_Receive = issue_rec.Unit_Of_Measure.Unit_Of_Measure_Name;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										// =====================================================
										// GET ACTUAL ITEM ID
										// =====================================================
										item_id = null;
										// -----------------------------------------------------
										// PURCHASE ORDER
										// -----------------------------------------------------
										if(input.Receiving_Type == "Purchase Order")
										{
											if(input.Item != null)
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID != null && po_det.Item != null)
												{
													item_id = po_det.Item;
												}
											}
										}
										// -----------------------------------------------------
										// INTERNAL TRANSFER
										// -----------------------------------------------------
										else if(input.Receiving_Type == "Internal Transfer")
										{
											if(input.Transfer_Item != null && input.Transfer_Item.Item != null)
											{
												item_id = input.Transfer_Item.Item;
											}
										}
										// -----------------------------------------------------
										// STOCK RETURN / TOOL RETURN
										// -----------------------------------------------------
										else if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return")
										{
											if(issue_rec != null && issue_rec.ID != null && issue_rec.Item != null)
											{
												item_id = issue_rec.Item;
											}
										}
										// -----------------------------------------------------
										// OTHER RECEIVING TYPES
										// -----------------------------------------------------
										else
										{
											if(input.Item != null)
											{
												item_id = input.Item;
											}
										}
										// =====================================================
										// INTERNAL TRANSFER QUANTITY SAFETY
										// =====================================================
										if(input.Receiving_Type == "Internal Transfer" && input.Transfer_Item != null && input.Quantity_Received != null && input.Quantity_Received > 0)
										{
											quantity_sent = ifnull(input.Transfer_Item.Quantity,0.0);
											quantity_already_received = ifnull(input.Transfer_Item.Quantity_Received,0.0);
											quantity_remaining = quantity_sent - quantity_already_received;
											if(quantity_remaining < 0)
											{
												quantity_remaining = 0.0;
											}
											if(input.Quantity_Received > quantity_remaining)
											{
												alert "Quantity Received cannot exceed the remaining transferred quantity of " + quantity_remaining + ".";
												input.Quantity_Received = null;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										// =====================================================
										// CONVERT RECEIVED QUANTITY TO BASE UOM
										// =====================================================
										if(item_id != null && input.Unit_Of_Measure_Received != null && input.Quantity_Received != null && input.Quantity_Received > 0)
										{
											check = store_management.po.check_uom_conversion_from_masaka_site_management(item_id,input.Unit_Of_Measure_Received);
											if(check != null && ifnull(check.get("ok"),false) == true)
											{
												recalc_resp = store_management.po.recalculate_po_detail_line_from_masaka_site_management(item_id,input.Unit_Of_Measure_Received,input.Quantity_Received,ifnull(input.Rate,0.0));
												if(recalc_resp != null)
												{
													base_qty = ifnull(recalc_resp.get("qty_in_base"),0.0);
													if(base_qty > 0)
													{
														input.Quantity_in_Base_Unit_Of_Measure_Received = base_qty.round(2);
													}
													else
													{
														input.Quantity_in_Base_Unit_Of_Measure_Received = null;
														input.Line_Total = null;
														alert "The converted base quantity is zero or invalid.";
													}
												}
												else
												{
													input.Quantity_in_Base_Unit_Of_Measure_Received = null;
													input.Line_Total = null;
													alert "No response was returned while converting the received quantity.";
												}
											}
											else
											{
												error_message = "UOM conversion failed.";
												if(check != null && check.get("message") != null)
												{
													error_message = check.get("message").toString();
												}
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												alert error_message;
											}
										}
										else
										{
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
										}
										// =====================================================
										// LINE TOTAL
										// =====================================================
										if(input.Quantity_Received != null && input.Quantity_Received > 0 && input.Rate != null && input.Rate >= 0)
										{
											input.Line_Total = (input.Quantity_Received * input.Rate).round(2);
										}
										else
										{
											input.Line_Total = null;
										}
						)
					}
				}

			}
			Full_Validation13 as "Full Validation"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// STOCK RECEIVING DETAILS
										// FULL VALIDATION
										// =======================================
										errors = List();
										rtype = ifnull(input.Receiving_Type,"").trim();
										stock_cond = ifnull(input.Stock_Condition,"").trim();
										qty_received = ifnull(input.Quantity_Received,0.0);
										old_rec = null;
										if(input.ID != null)
										{
											old_rec = Stock_Receiving_Details[ID == input.ID];
										}
										if(input.Stock_Receiving_Voucher == null)
										{
											errors.add("• Please select the Stock Receiving Voucher.");
										}
										else
										{
											srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
											if(srv.ID == null || srv.Store == null)
											{
												errors.add("• The selected Stock Receiving Voucher has no destination Store.");
											}
											else
											{
												destination_store = srv.Store;
											}
										}
										if(input.Stock_Receiving_Voucher_Number == null || input.Stock_Receiving_Voucher_Number <= 0)
										{
											errors.add("• Stock Receiving Voucher Number is required.");
										}
										if(input.Stock_Receiving_Voucher != null && input.Stock_Receiving_Voucher_Number != null)
										{
											dup = Stock_Receiving_Details[Stock_Receiving_Voucher == input.Stock_Receiving_Voucher && Stock_Receiving_Voucher_Number == input.Stock_Receiving_Voucher_Number && ID != input.ID];
											if(dup.count() > 0)
											{
												errors.add("• This Stock Receiving Voucher Number has already been.");
											}
										}
										if(rtype == "")
										{
											errors.add("• Please select Receiving Type.");
										}
										if(stock_cond == "")
										{
											errors.add("• Stock Condition is required.");
										}
										if(qty_received <= 0)
										{
											errors.add("• Quantity Received must be greater than zero.");
										}
										if(input.Unit_Of_Measure_Received == null)
										{
											errors.add("• Unit Of Measure Received is required.");
										}
										actual_item_id = null;
										actual_item_rec = null;
										po_det = null;
										issue_rec = null;
										selected_issue_id = null;
										// =======================================
										// RECEIVING TYPE VALIDATION
										// =======================================
										if(rtype == "Purchase Order")
										{
											if(input.Purchase_Order == null)
											{
												errors.add("• Purchase Order is required.");
											}
											else if(input.Item == null)
											{
												errors.add("• Purchase Order line Item is required.");
											}
											else
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID == null || po_det.Item == null)
												{
													errors.add("• The selected Purchase Order line is invalid.");
												}
												else
												{
													actual_item_id = po_det.Item;
													po_stock_cond = ifnull(po_det.Stock_Condition,"").trim();
													if(po_stock_cond == "")
													{
														errors.add("• The selected Purchase Order line has no Stock Condition.");
													}
													else if(stock_cond != po_stock_cond)
													{
														errors.add("• Stock Condition must match PO line. PO has: " + po_stock_cond + ".");
													}
												}
											}
											if(input.Voucher != null || input.Internal_Transfer_Number != null || input.Stock_Return_Number != null || input.Tool_Return_Number != null || input.Transfer_Item != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Purchase Order, only Purchase Order fields should be filled.");
											}
										}
										// -----------------------------------------------------
										// INTERNAL TRANSFER
										// -----------------------------------------------------
										else if(rtype == "Internal Transfer")
										{
											if(input.Internal_Transfer_Number == null)
											{
												errors.add("• Internal Transfer Number is required.");
											}
											else if(input.Transfer_Item == null)
											{
												errors.add("• Stock Transfer Item is required.");
											}
											else
											{
												transfer_qty = ifnull(input.Transfer_Item.Quantity,0.0);
												transfer_received_qty = ifnull(input.Transfer_Item.Quantity_Received,0.0);
												transfer_remaining_qty = transfer_qty - transfer_received_qty;
												if(transfer_remaining_qty < 0)
												{
													transfer_remaining_qty = 0.0;
												}
												transfer_base_qty = ifnull(input.Transfer_Item.Quantity_in_Base_Unit_Of_Measure,0.0);
												transfer_base_received_qty = ifnull(input.Transfer_Item.Quantity_Received_in_Base_Unit_Of_Measure,0.0);
												transfer_base_remaining_qty = transfer_base_qty - transfer_base_received_qty;
												if(transfer_base_remaining_qty < 0)
												{
													transfer_base_remaining_qty = 0.0;
												}
												transfer_uom_id = input.Transfer_Item.Unit_Of_Measure;
												transfer_status = ifnull(input.Transfer_Item.Receiving_Status,"Not Received");
												source_store = input.Transfer_Item.Issuing_Store;
												transfer_stock_condition = ifnull(input.Transfer_Item.Stock_Condition,"");
												actual_item_id = input.Transfer_Item.Item;
											}
											if(input.Purchase_Order != null || input.Item != null || input.Voucher != null || input.Stock_Return_Number != null || input.Tool_Return_Number != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Internal Transfer receiving, only Internal Transfer fields should be filled.");
											}
										}
										else if(rtype == "Stock Return")
										{
											if(input.Stock_Return_Number == null)
											{
												errors.add("• Stock Return Number is required.");
											}
											else if(input.Item_Issuing_Details == null)
											{
												errors.add("• Stock Return Item Issuing Details is required.");
											}
											else
											{
												selected_issue_id = input.Item_Issuing_Details;
												issue_rec = Item_Issuing_Details[ID == selected_issue_id];
												if(issue_rec.ID == null || issue_rec.Item == null)
												{
													errors.add("• The selected Stock Return Item Issuing Details record is invalid.");
												}
												else
												{
													actual_item_id = issue_rec.Item;
												}
											}
											if(input.Purchase_Order != null || input.Item != null || input.Voucher != null || input.Internal_Transfer_Number != null || input.Tool_Return_Number != null || input.Transfer_Item != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Stock Return, only Stock Return fields should be filled.");
											}
										}
										else if(rtype == "Tool Return")
										{
											if(input.Tool_Return_Number == null)
											{
												errors.add("• Tool Return Number is required.");
											}
											else if(input.Item_Issuing_Details == null)
											{
												errors.add("• Tool Return Item Issuing Details is required.");
											}
											else
											{
												selected_issue_id = input.Item_Issuing_Details;
												issue_rec = Item_Issuing_Details[ID == selected_issue_id];
												if(issue_rec.ID == null || issue_rec.Item == null)
												{
													errors.add("• The selected Tool Return Item Issuing Details record is invalid.");
												}
												else
												{
													actual_item_id = issue_rec.Item;
												}
											}
											if(input.Purchase_Order != null || input.Item != null || input.Voucher != null || input.Internal_Transfer_Number != null || input.Stock_Return_Number != null || input.Transfer_Item != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Tool Return, only Tool Return fields should be filled.");
											}
										}
										else if(rtype != "")
										{
											errors.add("• Unsupported Receiving Type.");
										}
										base_qty = null;
										input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										if(actual_item_id != null && input.Unit_Of_Measure_Received != null && qty_received > 0)
										{
											check = store_management.po.check_uom_conversion_from_concrete(actual_item_id,input.Unit_Of_Measure_Received);
											if(check == null || check.get("ok") != true)
											{
												errors.add("• " + ifnull(check.get("message"),"UOM conversion failed."));
											}
											else
											{
												base_qty = store_management.po.convert_to_base_qty_from_concrete(actual_item_id,input.Unit_Of_Measure_Received,input.Quantity_Received);
												if(base_qty == null || base_qty <= 0)
												{
													errors.add("• Calculated base quantity is invalid.");
												}
												else
												{
													input.Quantity_in_Base_Unit_Of_Measure_Received = base_qty;
												}
											}
										}
										if(rtype == "Purchase Order" && po_det != null && po_det.ID != null)
										{
											qty_remaining = ifnull(po_det.Quantity_Remaining,0.0);
											old_qty_this_row = 0.0;
											if(old_rec != null && old_rec.ID != null)
											{
												old_qty_this_row = ifnull(old_rec.Quantity_Received,0.0);
											}
											max_allowed = qty_remaining + old_qty_this_row;
											if(qty_received > max_allowed)
											{
												errors.add("• You cannot receive more than Quantity Remaining. Maximum allowed: " + max_allowed + ".");
											}
										}
										is_transfer_return = false;
										if(rtype == "Internal Transfer")
										{
											is_transfer_return = true;
										}
										else if(rtype == "Stock Return")
										{
											is_transfer_return = true;
										}
										else if(rtype == "Tool Return")
										{
											is_transfer_return = true;
										}
										if(is_transfer_return == true && issue_rec != null && issue_rec.ID != null)
										{
											if(ifnull(issue_rec.Status,"") == "Cancelled")
											{
												errors.add("• Cancelled issuing records cannot be received.");
											}
											issued_qty = ifnull(issue_rec.Quantity,0.0);
											returned_qty = ifnull(issue_rec.Quantity_Returned,0.0);
											remaining_issue_qty = issued_qty - returned_qty;
											if(remaining_issue_qty < 0)
											{
												remaining_issue_qty = 0.0;
											}
											if(remaining_issue_qty <= 0)
											{
												errors.add("• This issuing record has already been fully received.");
											}
											else if(qty_received > remaining_issue_qty)
											{
												errors.add("• You cannot receive more than the remaining issued quantity.");
											}
											if(issue_rec.Unit_Of_Measure != null && input.Unit_Of_Measure_Received != null && input.Unit_Of_Measure_Received != issue_rec.Unit_Of_Measure)
											{
												errors.add("• Unit Of Measure Received must match the issued Unit Of Measure.");
											}
											if(rtype == "Internal Transfer")
											{
												existing_transfer = Stock_Receiving_Details[Receiving_Type == "Internal Transfer" && Transfer_Item == selected_issue_id && ID != input.ID];
												if(existing_transfer.count() > 0)
												{
													errors.add("• This Item Issuing Details record has already been received as an Internal Transfer.");
												}
												if(input.Quantity_to_Receive != null && qty_received != input.Quantity_to_Receive)
												{
													errors.add("• For Internal Transfer, Quantity Received must exactly match Quantity to Receive.");
												}
												source_store = "";
												destination_store_name = "";
												if(issue_rec.Issuing_Voucher != null)
												{
													iss_hdr = Item_Issuing_Voucher[ID == issue_rec.Issuing_Voucher];
													if(iss_hdr.ID != null)
													{
														source_store = ifnull(iss_hdr.Display_Name_Store,"").trim();
													}
												}
												if(srv != null && srv.ID != null)
												{
													destination_store_name = ifnull(srv.Display_Name_Store,"").trim();
												}
												if(source_store == "")
												{
													errors.add("• The source Item Issuing Voucher has no Store.");
												}
												else if(destination_store_name != "" && source_store == destination_store_name)
												{
													errors.add("• Source Store and Destination Store cannot be the same for Internal Transfer.");
												}
											}
											else if(rtype == "Stock Return")
											{
											}
											else if(rtype == "Tool Return")
											{
												if(stock_cond == "New")
												{
													errors.add("• Tool Return cannot be received as New.");
												}
											}
										}
										if(errors.size() > 0)
										{
											msg = "Please fix the following:\n\n";
											for each  err_msg in errors
											{
												msg = msg + err_msg + "\n";
											}
											alert msg;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize_On_Delete7 as "Finalize On Delete"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// STOCK RECEIVING DETAILS - FINALIZE ON DELETE
										// ======================================================
										// ---------------------------------------
										// 1) GET SRV HEADER
										// ---------------------------------------
										if(input.Stock_Receiving_Voucher == null)
										{
											return;
										}
										srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
										if(srv.ID == null || srv.Store == null)
										{
											return;
										}
										store_id = srv.Store;
										ref_no = ifnull(input.Stock_Receiving_Voucher_and_Number,"").trim();
										if(ref_no == "")
										{
											ref_no = ifnull(srv.Display_Name_Stock_Receiving_Book,"").trim();
										}
										if(ref_no == "")
										{
											ref_no = input.ID.toString();
										}
										// ---------------------------------------
										// 2) COMMON VALUES
										// ---------------------------------------
										rtype = ifnull(input.Receiving_Type,"").trim();
										recv_qty = ifnull(input.Quantity_Received,0.0);
										recv_base_qty = ifnull(input.Quantity_in_Base_Unit_Of_Measure_Received,0.0);
										// ---------------------------------------
										// 3) RESOLVE RECORDS
										// ---------------------------------------
										if(rtype == "Purchase Order" && input.Item != null)
										{
											po_det_resolve = Purchase_Order_Details[ID == input.Item];
											if(po_det_resolve.ID == null)
											{
												info "Purchase Order Detail could not be found.";
											}
										}
										else if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_resolve = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_resolve.ID == null)
											{
												info "Item Issuing Detail could not be found.";
											}
										}
										// ---------------------------------------
										// 4) REVERSE STORE STOCK POSTED
										// ---------------------------------------
										store_reverse_resp = store_management.delete_stock_receiving_from_CleanSand(input.ID);
										info store_reverse_resp;
										// ======================================================
										// A) PURCHASE ORDER DELETE REVERSAL
										// ======================================================
										if(rtype == "Purchase Order" && input.Item != null)
										{
											po_det = Purchase_Order_Details[ID == input.Item];
											if(po_det.ID != null && po_det.Item != null)
											{
												bill_rows = Bill_Details[Stock_Receiving_Details == input.ID];
												for each  bd in bill_rows
												{
													delete from Bill_Details[ID == bd.ID];
												}
												total_received = 0.0;
												remaining_rows = Stock_Receiving_Details[Receiving_Type == "Purchase Order" && Item == input.Item && ID != input.ID && Stock_Receiving_Details_Status == "Received"];
												for each  rr in remaining_rows
												{
													total_received = total_received + ifnull(rr.Quantity_Received,0.0);
												}
												total_received = total_received.round(2);
												qty_ordered = ifnull(po_det.Quantity_Ordered,0.0);
												qty_billed = ifnull(po_det.Quantity_Billed,0.0);
												qty_remaining = qty_ordered - total_received;
												if(qty_remaining < 0)
												{
													qty_remaining = 0.0;
												}
												qty_unbilled = total_received - qty_billed;
												if(qty_unbilled < 0)
												{
													qty_unbilled = 0.0;
												}
												po_det.Quantity_Received=total_received;
												po_det.Quantity_Remaining=qty_remaining.round(2);
												po_det.Quantity_Unbilled=qty_unbilled.round(2);
												po_det.Quantity_Billable=qty_unbilled.round(2);
												if(total_received <= 0)
												{
													po_det.Receiving_Status="Not Received";
												}
												else if(total_received >= qty_ordered)
												{
													po_det.Receiving_Status="Fully Received";
												}
												else
												{
													po_det.Receiving_Status="Partially Received";
												}
												if(po_det.Purchase_Order != null)
												{
													thisapp.po.update_po_receiving_status(po_det.Purchase_Order);
												}
											}
										}
										// ======================================================
										// B) TOOL RETURN / STOCK RETURN DELETE REVERSAL
										// ======================================================
										else if(rtype == "Tool Return" || rtype == "Stock Return" && input.Item_Issuing_Details != null)
										{
											issue_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_rec.ID != null)
											{
												total_returned = 0.0;
												total_returned_base = 0.0;
												return_rows = Stock_Receiving_Details[Receiving_Type == "Tool Return" || Receiving_Type == "Stock Return" && Item_Issuing_Details == input.Item_Issuing_Details && ID != input.ID && Stock_Receiving_Details_Status == "Received"];
												for each  ret in return_rows
												{
													total_returned = total_returned + ifnull(ret.Quantity_Received,0.0);
													total_returned_base = total_returned_base + ifnull(ret.Quantity_in_Base_Unit_Of_Measure_Received,0.0);
												}
												issue_rec.Quantity_Returned=total_returned;
												issue_rec.Quantity_Returned_in_Base_Unit_Of_Measure=total_returned_base;
												issued_base = ifnull(issue_rec.Quantity_in_Base_Unit_Of_Measure,0.0);
												if(total_returned_base >= issued_base && issued_base > 0)
												{
													issue_rec.Status="Returned";
												}
												else if(rtype == "Tool Return")
												{
													issue_rec.Status="Borrowed";
												}
												else
												{
													issue_rec.Status="Issued";
												}
											}
										}
										else if(rtype == "Internal Transfer")
										{
											reverse_payload = Map();
											reverse_payload.put("Receive_Source_Record_ID",input.ID);
											reverse_payload.put("Receive_Source_Form","Stock Receiving Details");
											reverse_payload.put("Receive_Application","Masaka Site Management");
											transfer_reverse_resp = store_management.stock_transfer.reverse_transfer_receiving(reverse_payload);
											info transfer_reverse_resp;
											if(transfer_reverse_resp == null || transfer_reverse_resp.get("ok") != true)
											{
												if(transfer_reverse_resp != null)
												{
													info ifnull(transfer_reverse_resp.get("message"),"Internal Transfer receiving reversal failed.");
												}
												else
												{
													info "Internal Transfer receiving reversal returned no response.";
												}
											}
										}
										// ======================================================
										// D) DELETE EMPLOYEE RECEIVING DETAILS
										// ======================================================
										emp_rows = Employee_Receiving_Details[Source_Record_ID == input.ID && Source_Form == "Stock Receiving Details"];
										for each  erd in emp_rows
										{
											delete from Employee_Receiving_Details[ID == erd.ID];
										}
										// ======================================================
										// E) DELETE VOUCHER RECEIVING DETAILS
										// ======================================================
										vrd_rows = Voucher_Receiving_Details[Source_Record_ID == input.ID && Source_Form == "Stock Receiving Details"];
										for each  vrd in vrd_rows
										{
											delete from Voucher_Receiving_Details[ID == vrd.ID];
										}
										// ======================================================
										// DONE
										// ======================================================
										info "Stock Receiving Details delete reversal completed.";
						)
					}
				}

			}
