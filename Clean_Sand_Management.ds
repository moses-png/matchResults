			On_Number_Plate_Selected2 as "On Number Plate Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Number_Plate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Number_Plate != null)
										{
											input.Display_Name_Number_Plate = input.Number_Plate.Number_Plate;
											input.Truck_Type = input.Number_Plate.Display_Name_Truck_Type;
										}
										else
										{
											input.Display_Name_Number_Plate = "";
											input.Truck_Type = "";
											input.Truck_Measurement = null;
											input.Truck_Size_1 = 0;
											input.Truck_Size_2 = 0;
											input.Truck_Size = "";
											input.Truck_CBM = 0.0;
										}
										// Recalculate totals
										input.Sub_Total = ifnull(input.Sub_Total,0.0);
										input.Tax_Amount = ifnull(input.Tax_Amount,0.0);
										if(input.Discount_Type == "None" || input.Discount_Type == null)
										{
											input.Discount_Amount = 0.0;
										}
										input.Grand_Total = input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0.0);
										input.Balance_Due = input.Grand_Total - ifnull(input.Amount_Paid,0.0) - ifnull(input.Amount_Credited,0.0);
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0.0;
										}
										if(input.Balance_Due <= 0 && input.Grand_Total > 0)
										{
											input.Payment_Status = "Paid";
										}
										else if(ifnull(input.Amount_Paid,0.0) + ifnull(input.Amount_Credited,0.0) > 0)
										{
											input.Payment_Status = "Partially Paid";
										}
										else
										{
											input.Payment_Status = "Unpaid";
										}
						)
					}
				}

			}
			On_Sales_Type_Selected as "On Sales Type Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Sales_Type
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// SALES TYPE - ON USER INPUT
										// =====================================================
										if(input.Sales_Type == "Sand Sales")
										{
											show Sand_Sales;
											show Number_Plate;
											show Card_Number;
											show Delivery_Note;
											show Truck_Type;
											show Truck_Measurement;
											show Truck_Size_1;
											show Truck_Size_2;
											show Truck_Size;
											show Truck_CBM;
											show Item;
											show Unit_Of_Measure;
											show Store_Item_Stock;
											show Quantity_Available;
											show Rate_per_CBM;
											hide Product_Details;
										}
										else
										{
											hide Sand_Sales;
											hide Number_Plate;
											hide Delivery_Note;
											hide Truck_Type;
											hide Card_Number;
											hide Truck_Measurement;
											hide Truck_Size_1;
											hide Truck_Size_2;
											hide Truck_Size;
											hide Truck_CBM;
											hide Item;
											hide Unit_Of_Measure;
											hide Store_Item_Stock;
											hide Quantity_Available;
											hide Rate_per_CBM;
											input.Number_Plate = null;
											input.Delivery_Note = null;
											input.Card_Number = "";
											input.Truck_Type = "";
											input.Truck_Measurement = null;
											input.Truck_Size_1 = null;
											input.Truck_Size_2 = null;
											input.Truck_Size = null;
											input.Truck_CBM = null;
											input.Item = null;
											input.Unit_Of_Measure = null;
											input.Store_Item_Stock = null;
											input.Quantity_Available = null;
											input.Rate_per_CBM = null;
											show Product_Details;
											itemTotal = 0.0;
											for each  r in input.Product_Details
											{
												itemTotal = itemTotal + ifnull(r.Line_Total,0.0);
											}
											input.Sub_Total = round(itemTotal,2);
											input.Grand_Total = input.Sub_Total + ifnull(input.Tax_Amount,0.0) - ifnull(input.Discount_Amount,0.0);
											input.Balance_Due = input.Grand_Total - ifnull(input.Amount_Paid,0.0) - ifnull(input.Amount_Credited,0.0);
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0.0;
											}
											if(input.Balance_Due <= 0 && input.Grand_Total > 0)
											{
												input.Payment_Status = "Paid";
											}
											else if(ifnull(input.Amount_Paid,0.0) + ifnull(input.Amount_Credited,0.0) > 0)
											{
												input.Payment_Status = "Partially Paid";
											}
											else
											{
												input.Payment_Status = "Unpaid";
											}
										}
						)
					}
				}

			}
			On_Truck_Measurement_Sele as "On Truck Measurement Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Truck_Measurement
				{
					actions 
					{
						custom deluge script
						(
											// Sales Voucher -> On Truck Measurement Selected
										recalculate_totals = false;
										if(input.Truck_Measurement == null)
										{
											if(input.Truck_Size_1 != null || input.Truck_Size_2 != null || input.Truck_CBM != null)
											{
												recalculate_totals = true;
											}
											input.Truck_Size_1 = null;
											input.Truck_Size_2 = null;
											input.Truck_Size = null;
											input.Truck_CBM = null;
										}
										else
										{
											old_size_1 = input.Truck_Size_1;
											old_size_2 = input.Truck_Size_2;
											old_cbm = input.Truck_CBM;
											input.Truck_Size_1 = input.Truck_Measurement.Truck_Size_1;
											input.Truck_Size_2 = input.Truck_Measurement.Truck_Size_2;
											new_cbm = 0.0;
											if(input.Truck_Size == "Truck Size 1")
											{
												new_cbm = ifnull(input.Truck_Size_1,0.0);
											}
											else if(input.Truck_Size == "Truck Size 2")
											{
												new_cbm = ifnull(input.Truck_Size_2,0.0);
											}
											else
											{
												input.Truck_CBM = null;
											}
											if(input.Truck_Size == "Truck Size 1" || input.Truck_Size == "Truck Size 2")
											{
												input.Truck_CBM = round(new_cbm,1);
											}
											if(old_size_1 != input.Truck_Size_1 || old_size_2 != input.Truck_Size_2 || old_cbm != input.Truck_CBM)
											{
												recalculate_totals = true;
											}
										}
										if(recalculate_totals == true)
										{
											input.Sub_Total = round(ifnull(input.Truck_CBM,0.0) * ifnull(input.Rate_per_CBM,0.0),2);
											input.Tax_Amount = ifnull(input.Tax_Amount,0.0);
											if(input.Discount_Type == "None" || input.Discount_Type == null)
											{
												input.Discount_Amount = 0.0;
											}
											input.Grand_Total = round(input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0.0),2);
											if(input.Grand_Total < 0)
											{
												input.Grand_Total = 0.0;
											}
											input.Balance_Due = round(input.Grand_Total - ifnull(input.Amount_Paid,0.0) - ifnull(input.Amount_Credited,0.0),2);
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0.0;
											}
											if(input.Grand_Total <= 0)
											{
												input.Payment_Status = "Unpaid";
											}
											else if(input.Balance_Due <= 0)
											{
												input.Payment_Status = "Paid";
											}
											else if(ifnull(input.Amount_Paid,0.0) + ifnull(input.Amount_Credited,0.0) > 0)
											{
												input.Payment_Status = "Partially Paid";
											}
											else
											{
												input.Payment_Status = "Unpaid";
											}
										}
						)
					}
				}

			}
			On_Truck_Size_Selected as "On Truck Size Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Truck_Size
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// Sales Voucher -> Truck Size On User Input
										// Pick CBM based on selected Truck Size, then recalculate totals
										// Uses fields directly: Truck_CBM * Rate_per_CBM
										// No sand_total, no item_total, no Sales_Type check
										// =====================================================
										old_cbm = input.Truck_CBM;
										recalculate_totals = false;
										// 0) Guard: if Truck_Size not chosen
										if(input.Truck_Size == null || input.Truck_Size == "")
										{
											if(input.Truck_CBM != null)
											{
												recalculate_totals = true;
											}
											input.Truck_CBM = null;
										}
										else
										{
											// 1) Pick CBM based on selected Truck Size
											cbm = 0.0;
											if(input.Truck_Size == "Truck Size 1")
											{
												cbm = ifnull(input.Truck_Size_1,0.0);
											}
											else if(input.Truck_Size == "Truck Size 2")
											{
												cbm = ifnull(input.Truck_Size_2,0.0);
											}
											else
											{
												cbm = 0.0;
											}
											input.Truck_CBM = round(cbm,1);
											if(old_cbm != input.Truck_CBM)
											{
												recalculate_totals = true;
											}
										}
										// 2) Recalculate totals only if Truck_CBM changed
										if(recalculate_totals == true)
										{
											input.Sub_Total = round(ifnull(input.Truck_CBM,0.0) * ifnull(input.Rate_per_CBM,0.0),2);
											input.Tax_Amount = ifnull(input.Tax_Amount,0.0);
											if(input.Discount_Type == "None" || input.Discount_Type == null)
											{
												input.Discount_Amount = 0.0;
											}
											input.Grand_Total = round(input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0.0),2);
											if(input.Grand_Total < 0)
											{
												input.Grand_Total = 0.0;
											}
											input.Balance_Due = round(input.Grand_Total - ifnull(input.Amount_Paid,0.0) - ifnull(input.Amount_Credited,0.0),2);
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0.0;
											}
											if(input.Grand_Total <= 0)
											{
												input.Payment_Status = "Unpaid";
											}
											else if(input.Balance_Due <= 0)
											{
												input.Payment_Status = "Paid";
											}
											else if(ifnull(input.Amount_Paid,0.0) + ifnull(input.Amount_Credited,0.0) > 0)
											{
												input.Payment_Status = "Partially Paid";
											}
											else
											{
												input.Payment_Status = "Unpaid";
											}
										}
						)
					}
				}

			}
