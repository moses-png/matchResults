			On_Item_Selected8 as "On Item Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Parts_Consumables.Item
				{
					actions 
					{
						custom deluge script
						(
											// ===== ITEM SELECTED =====
										if(row.Item != null)
										{
											row.Labour=null;
											row.Display_Name_Item_Labour=ifnull(row.Item.Item_Name,"") + " - " + ifnull(row.Item.SKU,"");
											row.Unit_Cost=ifnull(row.Item.Default_Cost,0);
											// Use the UOM display field available on imported Item
											row.Unit_Of_Measure=ifnull(row.Item.Display_Name_Base_Unit_Of_Measure,"");
											row.Quantity=null;
											row.Line_Total=null;
										}
										else
										{
											row.Unit_Cost=null;
											row.Unit_Of_Measure="";
											row.Quantity=null;
											row.Line_Total=null;
											if(row.Labour == null)
											{
												row.Display_Name_Item_Labour="";
											}
										}
										// ===== RECALCULATE TOTALS =====
										parts_rows = List();
										for each  r in input.Parts_Consumables
										{
											m = Map();
											m.put("Item",r.Item);
											m.put("Labour",r.Labour);
											m.put("Quantity",r.Quantity);
											m.put("Unit Cost",r.Unit_Cost);
											parts_rows.add(m);
										}
										input.Parts_Total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
										input.Labour_Total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Parts_Total,input.Labour_Total);
						)
					}
				}

			}
			On_Store_Manager_Selected as "On Store Manager Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Store_Manager
				{
					actions 
					{
						custom deluge script
						(
