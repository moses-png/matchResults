			On_Discount_Type_Selected1 as "On Discount Type Selected"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on user input of Discount_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Discount_Type == "None")
										{
											hide Discount_Percentage;
											hide Discount_Amount;
											input.Discount_Percentage = 0;
											input.Discount_Amount = 0;
										}
										else if(input.Discount_Type == "Percentage")
										{
											show Discount_Percentage;
											hide Discount_Amount;
											input.Discount_Amount = 0;
										}
										else if(input.Discount_Type == "Amount")
										{
											hide Discount_Percentage;
											show Discount_Amount;
											input.Discount_Percentage = 0;
										}
						)
					}
				}

			}
			On_Discount_Percentage_Se1 as "On Discount Percentage Selected"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on user input of Discount_Percentage
				{
					actions 
					{
						custom deluge script
						(
											if(input.Discount_Percentage == null)
										{
											input.Discount_Percentage = 0;
										}
										if(input.Discount_Percentage > 100)
										{
											alert "Discount Percentage cannot be greater than 100%.";
											input.Discount_Percentage = 100;
										}
										discount_amt = ifnull(input.Sub_Total,0) * ifnull(input.Discount_Percentage,0) / 100;
										input.Discount_Amount = discount_amt;
										input.Grand_Total = ifnull(input.Sub_Total,0) + ifnull(input.Tax_Amount,0) - discount_amt;
										input.Balance_Due = ifnull(input.Grand_Total,0) - ifnull(input.Amount_Paid,0);
						)
					}
				}

			}
			On_Discount_Amount_Select1 as "On Discount Amount Selected"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on user input of Discount_Amount
				{
					actions 
					{
						custom deluge script
						(
											if(input.Discount_Amount == null)
										{
											input.Discount_Amount = 0;
										}
										if(input.Discount_Amount > ifnull(input.Sub_Total,0))
										{
											alert "Discount Amount cannot be greater than Sub Total.";
											input.Discount_Amount = ifnull(input.Sub_Total,0);
										}
										input.Grand_Total = ifnull(input.Sub_Total,0) + ifnull(input.Tax_Amount,0) - ifnull(input.Discount_Amount,0);
										input.Balance_Due = ifnull(input.Grand_Total,0) - ifnull(input.Amount_Paid,0);
						)
					}
				}

			}
			On_Tax_Amount_Selected as "On Tax Amount Selected"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on user input of Tax_Amount
				{
					actions 
					{
						custom deluge script
						(
											sub_total = ifnull(input.Sub_Total,0.0);
										discount = ifnull(input.Discount_Amount,0.0);
										grand_total = sub_total - discount + ifnull(input.Tax_Amount,0.0);
										input.Grand_Total = grand_total;
										input.Balance_Due = grand_total - ifnull(input.Amount_Paid,0.0);
						)
					}
				}

			}
			On_Cancel_Invoice_Selecte1 as "On Cancel Invoice Selected"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on user input of Cancel_Invoice
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_Invoice == true)
										{
											show Reason_Why_Cancelled;
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = "";
										}
						)
					}
				}

			}
			Finalize14 as "Finalize"
			{
				type =  form
				form = Invoice_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ==============================
										// RECALCULATE PARENT INVOICE TOTALS ONLY
										// ==============================
										if(input.Invoice != null)
										{
											inv = Invoice[ID == input.Invoice];
											if(inv.ID != null)
											{
												sub_total = 0.0;
												total_tax = 0.0;
												for each  d in Invoice_Details[Invoice == inv.ID]
												{
													sub_total = sub_total + ifnull(d.Line_Total,0.0);
													total_tax = total_tax + ifnull(d.Tax_Amount,0.0);
												}
												for each  s in inv.Services
												{
													sub_total = sub_total + ifnull(s.Line_Total,0.0);
												}
												sub_total = round(sub_total,2);
												total_tax = round(total_tax,2);
												inv.Sub_Total=sub_total;
												inv.Tax_Amount=total_tax;
												if(inv.Discount_Amount == null)
												{
													inv.Discount_Amount=0.0;
												}
												if(inv.Discount_Percentage == null)
												{
													inv.Discount_Percentage=0.0;
												}
												if(inv.Amount_Paid == null)
												{
													inv.Amount_Paid=0.0;
												}
												discount_amt = 0.0;
												if(inv.Discount_Type == "Percentage")
												{
													discount_amt = sub_total * inv.Discount_Percentage / 100;
													discount_amt = round(discount_amt,2);
													inv.Discount_Amount=discount_amt;
												}
												else if(inv.Discount_Type == "Amount")
												{
													discount_amt = ifnull(inv.Discount_Amount,0.0);
													if(discount_amt > sub_total)
													{
														discount_amt = sub_total;
														inv.Discount_Amount=sub_total;
													}
												}
												else
												{
													discount_amt = 0.0;
													inv.Discount_Amount=0.0;
													inv.Discount_Percentage=0.0;
												}
												grand_total = sub_total - discount_amt + total_tax;
												if(grand_total < 0)
												{
													grand_total = 0.0;
												}
												inv.Grand_Total=round(grand_total,2);
												balance_due = grand_total - ifnull(inv.Amount_Paid,0.0);
												if(balance_due < 0)
												{
													balance_due = 0.0;
												}
												inv.Balance_Due=round(balance_due,2);
											}
										}
										// =====================================================
										// INSERT OR UPDATE TAX LINE IN BILL DETAILS
										// =====================================================
										tax_amount = ifnull(input.Tax_Amount,0.0);
										if(tax_amount > 0)
										{
											invoice_display = ifnull(input.Display_Name_Invoice,"").trim();
											line_number = ifnull(input.Line_Number,0);
											tax_reference = invoice_display + " - " + line_number;
											item_display = "";
											if(input.Item != null)
											{
												item_display = input.Item.toString();
											}
											existing_tax = Bill_Details[Source_Form == "Invoice Details" && Source_Record_ID == input.ID];
											if(existing_tax.ID == null)
											{
												insert into Bill_Details
												[
													Bill=input.Invoice
													Line_Number=input.Line_Number
													Source="Invoice Details"
													Reference=tax_reference
													Display_Name_Item=item_display
													Details=ifnull(input.Details,"")
													Quantity=1
													Rate=tax_amount
													Account=ifnull(input.Account,"")
													Current_Site=ifnull(input.Site,"")
													Source_Form="Invoice Details"
													Source_Record_ID=input.ID
													Details_Date=zoho.currentdate
													Added_User=zoho.loginuser
												]
											}
											else
											{
												existing_tax.Bill=input.Invoice;
												existing_tax.Line_Number=input.Line_Number;
												existing_tax.Source="Invoice Details";
												existing_tax.Reference=tax_reference;
												existing_tax.Display_Name_Item=item_display;
												existing_tax.Details=ifnull(input.Details,"");
												existing_tax.Quantity=1;
												existing_tax.Rate=tax_amount;
												existing_tax.Account=ifnull(input.Account,"");
												existing_tax.Current_Site=ifnull(input.Site,"");
												existing_tax.Source_Form="Invoice Details";
												existing_tax.Source_Record_ID=input.ID;
												existing_tax.Details_Date=zoho.currentdate;
											}
										}
										else
										{
											old_tax_rows = Bill_Details[Source_Form == "Invoice Details" && Source_Record_ID == input.ID];
											for each  old_tax in old_tax_rows
											{
												delete from Bill_Details[ID == old_tax.ID];
											}
										}
										// =====================================================
										// UPDATE SALES VOUCHER BUSINESS DIVISION FROM INVOICE
										// =====================================================
										if(input.Sales_Voucher != null)
										{
											sales_voucher_id = input.Sales_Voucher.ID;
											sv = Sales_Voucher[ID == sales_voucher_id];
											if(sv.ID != null)
											{
												invoice_amount = round(ifnull(input.Line_Total,0.0),2);
												post = Map();
												post.put("CPM_Sales_Voucher",sv.ID);
												post.put("CPM_Invoice_Details",input.ID);
												post.put("Voucher_Number",input.Invoice);
												post.put("Transaction_Date",input.Details_Date);
												post.put("Invoice_Amount",invoice_amount);
												invoice_sync_resp = grapes_group.concreteproducts.updateSalesVoucherFromInvoiceDetail(post);
												info invoice_sync_resp;
											}
											else
											{
												info "Sales Voucher record was not found.";
											}
										}
										else
										{
											info "Invoice Details has no Sales Voucher lookup.";
										}
						)
					}
				}

			}
			Finalize_On_Delete10 as "Finalize On Delete"
			{
				type =  form
				form = Invoice_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											inv = Invoice[ID == input.Invoice];
										if(inv.ID != null)
										{
											sub_total = 0.0;
											for each  d in Invoice_Details[Invoice == inv.ID]
											{
												sub_total = sub_total + ifnull(d.Line_Total,0.0);
											}
											inv.Sub_Total=sub_total;
											inv.Grand_Total=sub_total;
											inv.Balance_Due=sub_total - ifnull(inv.Amount_Paid,0.0);
											if(sub_total > 0)
											{
												inv.Invoice_Status="Invoiced";
											}
											else
											{
												inv.Invoice_Status="Draft";
											}
										}
						)
					}
				}

			}
			Finalize15 as "Finalize"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_Invoice == true)
										{
											input.Invoice_Status = "Cancelled";
										}
										else if(input.Send_Invoice == true)
										{
											input.Invoice_Status = "Invoiced";
											if(input.Date_Sent == null)
											{
												input.Date_Sent = zoho.currentdate;
											}
										}
										else
										{
											input.Invoice_Status = "Draft";
										}
										// ==============================
										// INVOICE FINALIZE TOTALS
										// ==============================
										sub_total = 0.0;
										for each  d in Invoice_Details[Invoice == input.ID]
										{
											sub_total = sub_total + ifnull(d.Line_Total,0.0);
										}
										for each  s in input.Services
										{
											if(input.Invoice_Number != null && input.Invoice_Number != "")
											{
												s.Display_Name_Invoice=input.Invoice_Number;
											}
											sub_total = sub_total + ifnull(s.Line_Total,0.0);
										}
										input.Sub_Total = sub_total;
										discount_amt = ifnull(input.Discount_Amount,0.0);
										if(input.Discount_Type == "Percentage")
										{
											discount_amt = sub_total * ifnull(input.Discount_Percentage,0.0) / 100;
											input.Discount_Amount = discount_amt;
										}
										grand_total = sub_total - discount_amt + ifnull(input.Tax_Amount,0.0);
										if(grand_total < 0)
										{
											grand_total = 0;
										}
										input.Grand_Total = grand_total;
										balance_due = grand_total - ifnull(input.Amount_Paid,0.0);
										if(balance_due < 0)
										{
											balance_due = 0;
										}
										input.Balance_Due = balance_due;
						)
					}
				}

			}
			On_Send_Invoice_Selected as "On Send Invoice Selected"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on user input of Send_Invoice
				{
					actions 
					{
						custom deluge script
						(
											if(input.Send_Invoice == true && ifnull(input.Tax_Amount,0) > 0)
										{
											show Fiscal_Document_Number;
											show Date_Sent;
										}
										else
										{
											hide Fiscal_Document_Number;
											hide Date_Sent;
											input.Fiscal_Document_Number = "";
											input.Date_Sent = null;
										}
						)
					}
				}

			}
			Full_Validation_On_Create2 as "Full Validation On Create"
			{
				type =  form
				form = Invoice

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Company == null)
										{
											alert "Company is required.";
											cancel submit;
										}
										if(input.Invoice_Date == null)
										{
											alert "Invoice Date is required.";
											cancel submit;
										}
										if(input.Invoice_Number == null || input.Invoice_Number.trim() == "")
										{
											alert "Invoice Number is required.";
											cancel submit;
										}
										if(input.Customer == null)
										{
											alert "Customer is required.";
											cancel submit;
										}
										//====================================================
										//INVOICE NUMBER
										//====================================================
										if(input.Company != null && isNull(input.Invoice_Number))
										{
											docKey = Document_Key[Voucher_Type == "Invoice" && Document_Key_Status == "Active"];
											if(docKey.ID != null)
											{
												vno = employee_management.Generate_Voucher_Number(docKey.ID);
												if(vno != null && vno != "" && vno != "LIMIT_REACHED")
												{
													input.Invoice_Number = vno;
												}
												else if(vno == "LIMIT_REACHED")
												{
													alert "Invoice number limit reached.";
												}
												else
												{
													alert "Unable to generate Invoice Number.";
												}
											}
											else
											{
												alert "No active Document Key found for Invoice.";
											}
										}
						)
					}
				}

			}
			Full_Validation22 as "Full Validation"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Company == null)
										{
											alert "Company is required.";
											cancel submit;
										}
										if(input.Invoice_Date == null)
										{
											alert "Invoice Date is required.";
											cancel submit;
										}
										if(input.Invoice_Number == null || input.Invoice_Number.trim() == "")
										{
											alert "Invoice Number is required.";
											cancel submit;
										}
										if(input.Customer == null)
										{
											alert "Customer is required.";
											cancel submit;
										}
										if(input.Send_Invoice == true && input.Cancel_Invoice == true)
										{
											alert "An Invoice cannot be Sent and Cancelled at the same time.";
											cancel submit;
										}
										if(input.Send_Invoice == true && ifnull(input.Tax_Amount,0) > 0 && input.Fiscal_Document_Number == null || input.Fiscal_Document_Number.trim() == "")
										{
											alert "FD Number is required when sending an invoice with tax.";
											cancel submit;
										}
										if(input.Cancel_Invoice == true && input.Reason_Why_Cancelled == null || input.Reason_Why_Cancelled.trim() == "")
										{
											alert "Reason Why Cancelled is required When Cancelling an Invoice.";
											cancel submit;
										}
						)
					}
				}

			}
			On_Payment_Made_Voucher_S as "On Payment Made Voucher Selected"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on user input of Payment_Made_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Payment_Made_Voucher != null)
										{
											input.Display_Name_Payment_Made_Voucher = input.Payment_Made_Voucher.Payment_Made_Number;
											input.Display_Name_Vendor = input.Payment_Made_Voucher.Display_Name_Vendor;
											// Pull amount not allocated
											input.Amount_Not_Allocated = ifnull(input.Payment_Made_Voucher.Total_Amount_Not_Allocated,0);
											// Line number
											line_no = 1;
											rows = Payment_Made_Details[Payment_Made_Voucher == input.Payment_Made_Voucher];
											if(rows.count() > 0)
											{
												line_no = rows.count() + 1;
											}
											input.Line_Number = line_no;
										}
										else
										{
											input.Display_Name_Payment_Made_Voucher = "";
											input.Display_Name_Vendor = "";
											input.Amount_Not_Allocated = 0;
											input.Line_Number = null;
										}
						)
					}
				}

			}
			On_Bill_Selected3 as "On Bill Selected"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on user input of Bill
				{
					actions 
					{
						custom deluge script
						(
											if(input.Bill != null)
										{
											input.Display_Name_Bill = input.Bill.Display_Name_Vendor;
											input.Amount_Due = ifnull(input.Bill.Balance_Due,0);
											input.Amount_Allocated = 0;
											input.Amount_Paid = 0;
											input.Balance_Due = ifnull(input.Bill.Balance_Due,0);
										}
										else
										{
											input.Display_Name_Bill = "";
											input.Amount_Due = 0;
											input.Amount_Allocated = 0;
											input.Amount_Paid = 0;
											input.Balance_Due = 0;
										}
						)
					}
				}

			}
			On_Amount_Paid_Selected1 as "On Amount Paid Selected"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on user input of Amount_Paid
				{
					actions 
					{
						custom deluge script
						(
											if(input.Amount_Paid == null)
										{
											input.Amount_Paid = 0;
										}
										if(input.Amount_Paid > input.Amount_Not_Allocated)
										{
											alert "Amount Paid cannot be greater than Amount Not Allocated.";
											input.Amount_Paid = 0;
											return;
										}
										input.Amount_Allocated = input.Amount_Paid;
										input.Balance_Due = input.Amount_Due - input.Amount_Paid;
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0;
										}
						)
					}
				}

			}
			Finalize16 as "Finalize"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// PAYMENT MADE DETAILS — FINALIZE
										// ======================================================
										if(input.Payment_Made_Voucher != null)
										{
											rec = Payment_Made_Voucher[ID == input.Payment_Made_Voucher.ID];
											if(rec.ID != null)
											{
												input.Amount_Allocated = ifnull(input.Amount_Paid,0.0);
												// Update Bill
												if(input.Bill != null)
												{
													bill_rec = Bill[ID == input.Bill.ID];
													if(bill_rec.ID != null)
													{
														total_paid_for_bill = 0.0;
														for each  pmv in Payment_Made_Voucher[ID != null]
														{
															for each  row2 in pmv.Made_Details
															{
																if(row2.Bill != null && row2.Bill.ID == bill_rec.ID)
																{
																	total_paid_for_bill = total_paid_for_bill + ifnull(row2.Amount_Paid,0.0);
																}
															}
														}
														original_bill_amount = ifnull(bill_rec.Total_Amount,0.0);
														new_due = original_bill_amount - total_paid_for_bill;
														if(new_due < 0)
														{
															new_due = 0.0;
														}
														bill_rec.Amount_Paid=total_paid_for_bill;
														bill_rec.Amount_Due=new_due;
														bill_rec.Balance_Due=new_due;
														if(new_due <= 0)
														{
															bill_rec.Payment_Status="Paid";
														}
														else if(total_paid_for_bill > 0)
														{
															bill_rec.Payment_Status="Partially Paid";
														}
														else
														{
															bill_rec.Payment_Status="Unpaid";
														}
													}
												}
												// Recalculate Payment Made Voucher totals
												total_charges = 0.0;
												for each  ch in rec.Charge_Details
												{
													total_charges = total_charges + ifnull(ch.Amount,0.0);
												}
												total_allocated = 0.0;
												for each  det in rec.Made_Details
												{
													total_allocated = total_allocated + ifnull(det.Amount_Paid,0.0);
												}
												rec.Total_Charges=total_charges;
												rec.Total_Amount_Allocated=total_allocated;
												rec.Total_Amount_Not_Allocated=ifnull(rec.Total_Amount_Paid,0.0) - total_charges - total_allocated;
												if(rec.Total_Amount_Not_Allocated < 0)
												{
													rec.Total_Amount_Not_Allocated=0.0;
												}
												if(total_allocated == 0)
												{
													rec.Payment_Made_Voucher_Status="Unassigned";
												}
												else if(rec.Total_Amount_Not_Allocated > 0)
												{
													rec.Payment_Made_Voucher_Status="Partially Assigned";
												}
												else
												{
													rec.Payment_Made_Voucher_Status="Fully Assigned";
												}
												// =====================================================
												// UPDATE SALES RETURN AMOUNT PAID
												// =====================================================
												if(input.Payment_Document == "Sales Return" && input.Sales_Return != null)
												{
													sr = Sales_Return[ID == input.Sales_Return];
													if(sr.ID != null)
													{
														paid_total = 0.0;
														payments = Payment_Made_Details[Sales_Return == sr.ID];
														for each  p in payments
														{
															paid_total = paid_total + ifnull(p.Amount_Paid,0.0);
														}
														sr.Amount_Paid=paid_total;
														sr.Balance_Due=ifnull(sr.Grand_Total,0.0) - paid_total;
														if(sr.Balance_Due <= 0)
														{
															sr.Sales_Return_Status="Paid";
														}
														else if(paid_total > 0)
														{
															sr.Sales_Return_Status="Partially Paid";
														}
														else
														{
															sr.Sales_Return_Status="Unpaid";
														}
													}
												}
												// Sync to Group
												if(ifnull(input.Amount_Paid,0.0) > 0)
												{
													post = Map();
													post.put("Display_Name_Application","Concrete Products Management");
													post.put("Source_Form","Payment Made Details");
													post.put("Source_Record_ID",input.ID.toString());
													post.put("CPM_Payment_Made_Details",input.ID);
													post.put("Voucher_Number",ifnull(rec.Payment_Made_Number,""));
													post.put("Transaction_Date",rec.Payment_Made_Date);
													post.put("Business_Division",null);
													post.put("Display_Name_Business_Division","");
													post.put("Amount_To_Receive",0.0);
													post.put("Amount_Received",0.0);
													post.put("Amount_Not_Received",0.0);
													post.put("Amount_To_Pay",0.0);
													post.put("Amount_Paid",ifnull(input.Amount_Paid,0.0));
													post.put("Amount_Not_Paid",ifnull(input.Amount_Paid,0.0) * -1);
													grapes_group.concreteproducts.postBusinessDivisionDetail(post);
												}
												// Sync Payment Made Details to Payment Management
												if(input.ID != null && input.Payment_Type == "Cash")
												{
													description = "";
													doc_name = "";
													if(ifnull(input.Display_Name_Bill,"") != "")
													{
														doc_name = input.Display_Name_Bill;
														if(doc_name.contains(" - "))
														{
															doc_name = doc_name.getPrefix(" - ");
														}
													}
													if(ifnull(input.Payment_Document,"") != "")
													{
														description = input.Payment_Document;
													}
													if(doc_name != "")
													{
														if(description != "")
														{
															description = description + " - ";
														}
														description = description + doc_name;
													}
													transaction_date_txt = "";
													if(rec.Payment_Made_Date != null)
													{
														transaction_date_txt = rec.Payment_Made_Date.toString("dd-MMM-yyyy");
													}
													created_time_txt = "";
													if(input.Created_By_Time != null)
													{
														created_time_txt = input.Created_By_Time.toString("dd-MMM-yyyy HH:mm:ss");
													}
													updated_time_txt = "";
													if(input.Updated_By_Time != null)
													{
														updated_time_txt = input.Updated_By_Time.toString("dd-MMM-yyyy HH:mm:ss");
													}
													payload = Map();
													payload.put("Payment_Voucher_Source_ID",rec.ID.toLong());
													payload.put("Display_Name_Payment_Voucher",ifnull(input.Display_Name_Payment_Made_Voucher,""));
													payload.put("Line_Number",input.Line_Number);
													payload.put("Description",description);
													payload.put("Amount_Allocated",ifnull(input.Amount_Allocated,0.0));
													payload.put("Application","Concrete Products Management");
													payload.put("Transaction_Date",transaction_date_txt);
													payload.put("Source_Form","Payment Made Details");
													payload.put("Source_Record_ID",input.ID.toLong());
													payload.put("Voucher_Number",ifnull(rec.Payment_Made_Number,""));
													payload.put("User_Name",ifnull(input.User_Name,""));
													payload.put("User_Email",ifnull(input.User_Email,""));
													payload.put("User_Role",ifnull(input.User_Role,""));
													payload.put("Created_By_Name",ifnull(input.Created_By_Name,""));
													payload.put("Created_By_Email",ifnull(input.Created_By_Email,""));
													payload.put("Created_By_Time",created_time_txt);
													payload.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
													payload.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
													payload.put("Updated_By_Time",updated_time_txt);
													sync_resp = payment_management.syncPaymentMadeDetailsFromConcrete2(payload);
													info sync_resp;
													info sync_resp;
													if(sync_resp != null && sync_resp.get("ok") == true)
													{
														account_id_val = sync_resp.get("account_id");
														if(account_id_val != null)
														{
															refresh_resp = payment_management.refreshAccountTransactionLog(account_id_val.toLong());
															info refresh_resp;
														}
													}
												}
											}
										}
										// ==========================================
										// UPDATE PURCHASE ORDER AFTER PAYMENT CHANGE
										// ==========================================
										if(input.Bill != null)
										{
											bill_id = input.Bill.ID;
											po_ids = List();
											bill_detail_rows = Bill_Details[Bill == bill_id];
											for each  bd in bill_detail_rows
											{
												if(bd.Item != null)
												{
													po_det = Purchase_Order_Details[ID == bd.Item.ID];
													if(po_det.ID != null && po_det.Purchase_Order != null)
													{
														po_id = po_det.Purchase_Order.ID;
														if(!po_ids.contains(po_id))
														{
															po_ids.add(po_id);
														}
													}
												}
											}
											for each  po_id in po_ids
											{
												thisapp.po.update_po_receiving_status(po_id);
											}
										}
						)
					}
				}

			}
			On_Transaction_Type_Selec as "On Transaction Type Selected"
			{
				type =  form
				form = Payment_Charges

				record event = on add or edit

				on user input of Transaction_Type
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ON USER INPUT OF Transaction_Type
										// =====================================================
										if(input.Transaction_Type == "Payment Made")
										{
											show Payment_Made_Voucher;
											hide Payment_Receipt_Voucher;
											input.Payment_Receipt_Voucher = null;
											input.Display_Name_Payment_Voucher = "";
										}
										else if(input.Transaction_Type == "Payment Received")
										{
											show Payment_Receipt_Voucher;
											hide Payment_Made_Voucher;
											input.Payment_Made_Voucher = null;
											input.Display_Name_Payment_Voucher = "";
										}
										else
										{
											hide Payment_Made_Voucher;
											hide Payment_Receipt_Voucher;
											input.Payment_Made_Voucher = null;
											input.Payment_Receipt_Voucher = null;
											input.Display_Name_Payment_Voucher = "";
										}
						)
					}
				}

			}
