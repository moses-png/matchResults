			On_Vendor_Type_Selected as "On Vendor Type Selected"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on user input of Vendor_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Vendor_Type == "External Vendor")
										{
											show Vendor;
											hide Employee_Vendor;
											hide Customer_Vendor;
											input.Employee_Vendor = null;
											input.Customer_Vendor = null;
										}
										else if(input.Vendor_Type == "Employee Vendor")
										{
											show Employee_Vendor;
											hide Vendor;
											hide Customer_Vendor;
											input.Vendor = null;
											input.Customer_Vendor = null;
										}
										else if(input.Vendor_Type == "Customer Vendor")
										{
											show Customer_Vendor;
											hide Vendor;
											hide Employee_Vendor;
											input.Vendor = null;
											input.Employee_Vendor = null;
										}
										else
										{
											hide Vendor;
											hide Employee_Vendor;
											hide Customer_Vendor;
											input.Vendor = null;
											input.Employee_Vendor = null;
											input.Customer_Vendor = null;
											input.Display_Name_Vendor = "";
										}
						)
					}
				}

			}
			Add_Row_Charge_Details_ as "Add Row \"Charge Details\""
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on add row of Charge_Details
				{
					actions 
					{
						custom deluge script
						(
											max_line = 0;
										for each  r in input.Charge_Details
										{
											if(ifnull(r.Line_Number,0) > max_line)
											{
												max_line = r.Line_Number;
											}
										}
										row.Line_Number=max_line + 1;
										row.Transaction_Type="Payment Made";
										row.Display_Name_Payment_Voucher=ifnull(input.Payment_Made_Number,"");
										row.Amount=0;
						)
					}
				}

			}
			Add_Row_Made_Details_ as "Add Row \"Made Details\""
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on add row of Made_Details
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PAYMENT MADE VOUCHER - MADE DETAILS
										// ON ADDITION OF ROW
										// =====================================================
										max_line = 0;
										for each  md in input.Made_Details
										{
											if(md.Line_Number != null && md.Line_Number > max_line)
											{
												max_line = md.Line_Number;
											}
										}
										row.Line_Number=max_line + 1;
										if(ifnull(input.Payment_Made_Number,"") != "")
										{
											row.Display_Name_Payment_Made_Voucher=input.Payment_Made_Number;
										}
										else
										{
											row.Display_Name_Payment_Made_Voucher="";
										}
										if(input.Vendor_Type == "Employee Vendor" && input.Employee_Vendor != null)
										{
											empName = ifnull(input.Employee_Vendor.Employee_Name,"").trim();
											if(input.Employee_Vendor.Employee_Number != null)
											{
												row.Display_Name_Vendor=empName + " - " + input.Employee_Vendor.Employee_Number.toString();
											}
											else
											{
												row.Display_Name_Vendor=empName;
											}
										}
										else if(input.Vendor_Type == "External Vendor" && input.Vendor != null)
										{
											row.Display_Name_Vendor=input.Display_Name_Vendor;
										}
										else
										{
											row.Display_Name_Vendor="";
										}
										row.Amount_Due=0.0;
										row.Amount_Not_Allocated=ifnull(input.Total_Amount_Not_Allocated,0.0);
										row.Amount_Allocated=0.0;
										row.Amount_Paid=0.0;
										row.Balance_Due=0.0;
						)
					}
				}

			}
			Delete_Row_Charge_Details as "Delete Row \"Charge Details\""
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on delete row of Charge_Details
				{
					actions 
					{
						custom deluge script
						(
											total_charges = 0.0;
										for each  chg in input.Charge_Details
										{
											total_charges = total_charges + ifnull(chg.Amount,0);
										}
										input.Total_Charges = total_charges;
										input.Total_Amount_Not_Allocated = ifnull(input.Total_Amount_Paid,0) - ifnull(input.Total_Charges,0) - ifnull(input.Total_Amount_Allocated,0);
										if(input.Total_Amount_Not_Allocated < 0)
										{
											input.Total_Amount_Not_Allocated = 0;
										}
						)
					}
				}

			}
			Delete_Row_Made_Details_ as "Delete Row \"Made Details\""
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on delete row of Made_Details
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PAYMENT MADE VOUCHER - MADE DETAILS
										// ON DELETE ROW
										// =====================================================
										total_allocated = 0.0;
										ln = 1;
										for each  md in input.Made_Details
										{
											md.Line_Number=ln;
											ln = ln + 1;
											total_allocated = total_allocated + ifnull(md.Amount_Allocated,0.0);
										}
										input.Total_Amount_Allocated = round(total_allocated,2);
										total_paid = ifnull(input.Total_Amount_Paid,0.0);
										not_allocated = round(total_paid - total_allocated,2);
										if(not_allocated < 0)
										{
											not_allocated = 0.0;
										}
										input.Total_Amount_Not_Allocated = not_allocated;
										if(total_allocated <= 0)
										{
											input.Payment_Made_Voucher_Status = "Unassigned";
										}
										else if(not_allocated > 0)
										{
											input.Payment_Made_Voucher_Status = "Partially Assigned";
										}
										else
										{
											input.Payment_Made_Voucher_Status = "Assigned";
										}
						)
					}
				}

			}
			Full_Validation17 as "Full Validation"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = List();
										if(input.Payment_Account == null)
										{
											errors.add("• Payment Account is required.");
										}
										if(input.Vendor_Type == null || input.Vendor_Type == "")
										{
											errors.add("• Vendor Type is required.");
										}
										if(input.Vendor_Type == "Employee Vendor" && input.Employee_Vendor == null)
										{
											errors.add("• Employee Vendor is required.");
										}
										if(input.Vendor_Type == "External Vendor" && input.Vendor == null)
										{
											errors.add("• Vendor is required.");
										}
										if(input.Total_Amount_Paid == null || input.Total_Amount_Paid <= 0)
										{
											errors.add("• Total Amount Paid must be greater than 0.");
										}
										total_allocated = 0.0;
										for each  md in input.Made_Details
										{
											if(md.Payment_Document == null || md.Payment_Document == "")
											{
												errors.add("• Payment Document is required on line " + md.Line_Number);
											}
											if(md.Payment_Document == "Bill" && md.Bill == null)
											{
												errors.add("• Bill is required on line " + md.Line_Number);
											}
											if(md.Amount_Allocated == null || md.Amount_Allocated <= 0)
											{
												errors.add("• Amount Allocated must be greater than 0 on line " + md.Line_Number);
											}
											total_allocated = total_allocated + ifnull(md.Amount_Allocated,0.0);
										}
										if(total_allocated > ifnull(input.Total_Amount_Paid,0.0))
										{
											errors.add("• Total Amount Allocated cannot exceed Total Amount Paid.");
										}
										if(errors.size() > 0)
										{
											msg = "Please fix the following:\n\n";
											for each  e in errors
											{
												msg = msg + e + "\n";
											}
											alert msg;
											cancel submit;
										}
										if(input.Payment_Made_Date == null)
										{
											input.Payment_Made_Date = zoho.currenttime;
										}
						)
					}
				}

			}
			Finalize13 as "Finalize"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// PAYMENT MADE VOUCHER — FINALIZE
										// ======================================================
										rec = Payment_Made_Voucher[ID == input.ID];
										if(rec.ID != null)
										{
											if(rec.Payment_Made_Date == null)
											{
												rec.Payment_Made_Date=zoho.currenttime;
											}
											total_charges = 0.0;
											for each  ch in rec.Charge_Details
											{
												total_charges = total_charges + ifnull(ch.Amount,0.0);
											}
											total_allocated = 0.0;
											for each  det in rec.Made_Details
											{
												paid_amt = ifnull(det.Amount_Paid,0.0);
												det.Amount_Allocated=paid_amt;
												total_allocated = total_allocated + paid_amt;
												if(det.Bill != null)
												{
													bill_rec = Bill[ID == det.Bill];
													if(bill_rec.ID != null)
													{
														total_paid_for_bill = 0.0;
														for each  pmv in Payment_Made_Voucher[ID != null]
														{
															for each  row2 in pmv.Made_Details
															{
																if(row2.Bill == bill_rec.ID)
																{
																	total_paid_for_bill = total_paid_for_bill + ifnull(row2.Amount_Paid,0.0);
																}
															}
														}
														original_bill_amount = ifnull(bill_rec.Total_Amount,0.0);
														bill_rec.Amount_Paid=total_paid_for_bill;
														new_due = original_bill_amount - total_paid_for_bill;
														if(new_due < 0)
														{
															new_due = 0.0;
														}
														bill_rec.Amount_Due=new_due;
														bill_rec.Balance_Due=new_due;
														if(new_due <= 0)
														{
															bill_rec.Payment_Status="Paid";
														}
														else if(total_paid_for_bill > 0)
														{
															bill_rec.Payment_Status="Partially Paid";
														}
														else
														{
															bill_rec.Payment_Status="Unpaid";
														}
														if(paid_amt > 0)
														{
															post = Map();
															post.put("Display_Name_Application","Clean Sand Management");
															post.put("Source_Form","Payment Made Details");
															post.put("Source_Record_ID",det.ID.toString());
															post.put("Voucher_Number",ifnull(rec.Payment_Made_Number,""));
															post.put("Transaction_Date",rec.Payment_Made_Date);
															post.put("Business_Division",null);
															post.put("Display_Name_Business_Division","");
															post.put("Amount_To_Receive",0.0);
															post.put("Amount_Received",0.0);
															post.put("Amount_Not_Received",0.0);
															post.put("Amount_To_Pay",0.0);
															post.put("Amount_Paid",paid_amt);
															post.put("Amount_Not_Paid",0.0);
															grapes_group.concreteproducts.postBusinessDivisionDetail(post);
														}
													}
												}
											}
											rec.Total_Charges=total_charges;
											rec.Total_Amount_Allocated=total_allocated;
											rec.Total_Amount_Not_Allocated=ifnull(rec.Total_Amount_Paid,0.0) - total_charges - total_allocated;
											if(rec.Total_Amount_Not_Allocated < 0)
											{
												rec.Total_Amount_Not_Allocated=0.0;
											}
											if(total_allocated == 0)
											{
												rec.Payment_Made_Voucher_Status="Unassigned";
											}
											else if(rec.Total_Amount_Not_Allocated > 0)
											{
												rec.Payment_Made_Voucher_Status="Partially Assigned";
											}
											else
											{
												rec.Payment_Made_Voucher_Status="Fully Assigned";
											}
										}
										// =====================================================
										// SYNC CLEAN SAND PAYMENT MADE VOUCHER
										// =====================================================
										if(input.ID != null)
										{
											if(input.Payment_Made_Date == null)
											{
												input.Payment_Made_Date = zoho.currenttime;
											}
											input.Payment_Made_Voucher_Status = "Draft";
											payment_date_txt = input.Payment_Made_Date.toString("yyyy-MM-dd");
											created_time_txt = "";
											if(input.Created_By_Time != null)
											{
												created_time_txt = input.Created_By_Time.toString("yyyy-MM-dd HH:mm:ss");
											}
											updated_time_txt = zoho.currenttime.toString("yyyy-MM-dd HH:mm:ss");
											payload = Map();
											payload.put("Transaction_Type","Credit");
											payload.put("Account",input.Payment_Account);
											payload.put("Display_Name_Account",ifnull(input.Display_Name_Payment_Account,""));
											payload.put("Payment_Number",ifnull(input.Payment_Made_Number,""));
											payload.put("Payment_Date",payment_date_txt);
											payload.put("Description",ifnull(input.Vendor_Type,""));
											payload.put("Total_Amount_Received",0.0);
											payload.put("Total_Amount_Paid",ifnull(input.Total_Amount_Paid,0.0));
											payload.put("Payment_Voucher_Status","Draft");
											payload.put("Application","Clean Sand Management");
											payload.put("Transaction_Date",payment_date_txt);
											payload.put("Source_Form","Payment Made Voucher");
											payload.put("Source_Record_ID",input.ID.toLong());
											payload.put("Voucher_Number",ifnull(input.Payment_Made_Number,""));
											payload.put("User_Name",ifnull(input.User_Name,""));
											payload.put("User_Email",ifnull(input.User_Email,""));
											payload.put("User_Role",ifnull(input.User_Role,""));
											payload.put("Created_By_Name",ifnull(input.Created_By_Name,""));
											payload.put("Created_By_Email",ifnull(input.Created_By_Email,""));
											payload.put("Created_By_Time",created_time_txt);
											payload.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
											payload.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
											payload.put("Updated_By_Time",updated_time_txt);
											sync_resp = payment_management.syncPaymentMadeVoucherFromCleanSand(payload);
											info sync_resp;
											payment_dt = input.Payment_Made_Date;
											if(payment_dt == null)
											{
												payment_dt = zoho.currenttime;
											}
											txn = Map();
											txn.put("Transaction_Date",payment_dt);
											txn.put("Account",input.Payment_Account);
											txn.put("Display_Name_Account",ifnull(input.Display_Name_Payment_Account,""));
											txn.put("Transaction_Type","Credit");
											txn.put("Amount",ifnull(input.Total_Amount_Paid,0.0));
											txn.put("Reference_Type","Payment Made Voucher");
											txn.put("Reference_Number",ifnull(input.Payment_Made_Number,""));
											txn.put("Application","Clean Sand Management");
											txn.put("Source_Form","Payment Made Voucher");
											txn.put("Source_Record_ID",input.ID);
											txn.put("Notes",ifnull(input.Display_Name_Vendor,""));
											txn.put("User_Name",ifnull(input.User_Name,""));
											txn.put("User_Email",ifnull(input.User_Email,""));
											txn.put("User_Role",ifnull(input.User_Role,""));
											txn.put("Created_By_Name",ifnull(input.Created_By_Name,""));
											txn.put("Created_By_Email",ifnull(input.Created_By_Email,""));
											txn.put("Created_By_Time",input.Created_By_Time);
											txn.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
											txn.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
											txn.put("Updated_By_Time",zoho.currenttime);
											txn_resp = payment_management.createOrUpdateAccountTransactionLog(txn);
											info txn_resp;
											payment_management.Recalculate_Unconfirmed_Account_Totals();
										}
										// ==============================
										// SUBFORM DETAILS PAYLOAD
										// ==============================
										for each  row in input.Made_Details
										{
											info "CHECK ROW = " + row;
											info "PAYMENT TYPE = " + ifnull(row.Payment_Type,"");
											info "AMOUNT ALLOCATED = " + ifnull(row.Amount_Allocated,0.0);
											info "AMOUNT PAID = " + ifnull(row.Amount_Paid,0.0);
											if(ifnull(row.Payment_Type,"").trim() == "Cash")
											{
												amount_to_sync = ifnull(row.Amount_Allocated,0.0);
												if(amount_to_sync <= 0)
												{
													amount_to_sync = ifnull(row.Amount_Paid,0.0);
												}
												description = "";
												doc_name = "";
												if(row.Bill != null)
												{
													doc_name = ifnull(row.Display_Name_Voucher,"");
												}
												if(ifnull(row.Payment_Document,"") != "")
												{
													description = row.Payment_Document;
												}
												if(doc_name != "")
												{
													if(description != "")
													{
														description = description + " - ";
													}
													description = description + doc_name;
												}
												detail_source_id = row.ID.toLong();
												detail_payload = Map();
												detail_payload.put("Payment_Voucher_Source_ID",input.ID.toLong());
												detail_payload.put("Display_Name_Payment_Voucher",ifnull(input.Payment_Made_Number,""));
												detail_payload.put("Line_Number",row.Line_Number);
												detail_payload.put("Description",description);
												detail_payload.put("Amount_Allocated",amount_to_sync);
												detail_payload.put("Application","Clean Sand Management");
												detail_payload.put("Transaction_Date",payment_date_txt);
												detail_payload.put("Source_Form","Payment Made Details");
												detail_payload.put("Source_Record_ID",detail_source_id);
												detail_payload.put("Voucher_Number",ifnull(input.Payment_Made_Number,""));
												detail_payload.put("User_Name",ifnull(input.User_Name,""));
												detail_payload.put("User_Email",ifnull(input.User_Email,""));
												detail_payload.put("User_Role",ifnull(input.User_Role,""));
												detail_payload.put("Created_By_Name",ifnull(input.Created_By_Name,""));
												detail_payload.put("Created_By_Email",ifnull(input.Created_By_Email,""));
												detail_payload.put("Created_By_Time",created_time_txt);
												detail_payload.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
												detail_payload.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
												detail_payload.put("Updated_By_Time",updated_time_txt);
												info "DETAIL PAYLOAD = " + detail_payload;
												detail_resp = payment_management.syncPaymentMadeDetailsFromCleanSand(detail_payload);
												info detail_resp;
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete12 as "Finalize On Delete"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PAYMENT RECEIPT VOUCHER FINALIZE ON DELETE
										// =====================================================
										// -----------------------------------------------------
										// Delete synced Payment Voucher from Payment Management
										// -----------------------------------------------------
										delete_payload = Map();
										delete_payload.put("Source_Record_ID",input.ID);
										delete_payload.put("Source_Form","Payment Made Voucher");
										delete_resp = payment_management.deletePaymentMadeVoucherFromCleanSand(delete_payload);
										info delete_resp;
										// -----------------------------------------------------
										// Delete Account Transaction Log
										// -----------------------------------------------------
										account_payload = Map();
										account_payload.put("Source_Record_ID",input.ID);
										account_payload.put("Source_Form","Payment Made Voucher");
										account_resp = payment_management.deleteAccountTransactionLog(account_payload);
										info account_resp;
						)
					}
				}

			}
