	 			column = 1   
				width = medium
			)
			Service_Task_Checkbox
			(
				type = checkboxes	
				displayname = "Service Task Checkbox"
				values = {"All Items Installed","Used Items Returned to Store","Work Done Completed"}
	 			row = 7
	 			column = 1   
				width = medium
			)
			Checked_By_Email
			(
    			type = email
				displayname = "Checked By Email"
				maxchar = 80
	 			row = 7
	 			column = 1   
				width = medium
				personal data = true
			)
			Back_End
			(
				type = section
				displayname = "Back End"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 8
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 8
	 			column = 1   
				width = medium
				personal data = true
			)
			User_Role
			(
    			type = text
				displayname = "User Role"
	 			row = 8
	 			column = 1   
				width = medium
			)
			Created_By_Name
			(
    			type = text
				displayname = "Created By Name"
	 			row = 8
	 			column = 1   
				width = medium
			)
			Created_By_Email
			(
    			type = email
				displayname = "Created By Email"
				maxchar = 80
	 			row = 8
	 			column = 1   
				width = medium
				personal data = true
			)
			Created_By_Time
			(
    			type = datetime
				displayname = "Created By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 8
	 			column = 1   
				width = medium
			)
			Updated_By_Name
			(
    			type = text
				displayname = "Updated By Name"
	 			row = 8
	 			column = 1   
				width = medium
			)
			Updated_By_Email
			(
    			type = email
				displayname = "Updated By Email"
				maxchar = 80
	 			row = 8
	 			column = 1   
				width = medium
				personal data = true
			)
			Updated_By_Time
			(
    			type = datetime
				displayname = "Updated By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 8
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
