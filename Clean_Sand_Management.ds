			On_Unit_Of_Measure_Select9 as "On Unit Of Measure Selected"
			{
				type =  form
				form = Material_Request_Voucher

				record event = on add or edit

				on user input of Material_Request_Details.Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											for each  req_det in input.Material_Request_Details
										{
											if(req_det.Unit_Of_Measure == null || req_det.Item == null)
											{
												req_det.Display_Name_Unit_Of_Measure=null;
												req_det.Quantity_in_Base_Unit_Of_Measure=null;
												continue;
											}
											check = store_management.po.check_uom_conversion_from_masaka_site_management(req_det.Item,req_det.Unit_Of_Measure);
											if(check == null || check.get("ok") != true)
											{
												alert ifnull(check.get("message"),"UOM conversion failed.");
												req_det.Unit_Of_Measure=null;
												req_det.Display_Name_Unit_Of_Measure=null;
												req_det.Quantity_in_Base_Unit_Of_Measure=null;
												continue;
											}
											req_det.Display_Name_Unit_Of_Measure=req_det.Unit_Of_Measure.Unit_Of_Measure_Name;
											base_qty = store_management.po.convert_to_base_qty_from_masaka_site_management(req_det.Item,req_det.Unit_Of_Measure,ifnull(req_det.Quantity,0.0));
											if(base_qty != null && base_qty > 0)
											{
												req_det.Quantity_in_Base_Unit_Of_Measure=base_qty;
											}
											else
											{
												req_det.Quantity_in_Base_Unit_Of_Measure=null;
											}
										}
						)
					}
				}

			}
			On_Quantity_Issued_Select as "On Quantity Issued Selected"
			{
				type =  form
				form = Material_Request_Voucher

				record event = on add or edit

				on user input of Material_Request_Details.Quantity_Issued
				{
					actions 
					{
						custom deluge script
						(
											for each  req_det in input.Material_Request_Details
										{
											if(req_det.Item == null || req_det.Unit_Of_Measure == null)
											{
												req_det.Quantity_Issued_in_Base_Unit_Of_Measure=null;
												continue;
											}
											if(req_det.Quantity_Issued == null || req_det.Quantity_Issued < 0)
											{
												req_det.Quantity_Issued_in_Base_Unit_Of_Measure=null;
												continue;
											}
											check = store_management.po.check_uom_conversion_from_masaka_site_management(req_det.Item,req_det.Unit_Of_Measure);
											if(check == null || check.get("ok") != true)
											{
												alert ifnull(check.get("message"),"UOM conversion failed.");
												req_det.Quantity_Issued_in_Base_Unit_Of_Measure=null;
												continue;
											}
											issued_base_qty = store_management.po.convert_to_base_qty_from_masaka_site_management(req_det.Item,req_det.Unit_Of_Measure,req_det.Quantity_Issued);
											if(issued_base_qty != null && issued_base_qty >= 0)
											{
												req_det.Quantity_Issued_in_Base_Unit_Of_Measure=issued_base_qty;
											}
											else
											{
												req_det.Quantity_Issued_in_Base_Unit_Of_Measure=null;
											}
											if(req_det.Quantity != null && req_det.Quantity_Issued > req_det.Quantity)
											{
												alert "Quantity Issued cannot be greater than Quantity Requested.";
												req_det.Quantity_Issued=null;
												req_det.Quantity_Issued_in_Base_Unit_Of_Measure=null;
											}
										}
						)
					}
				}

			}
			On_Quantity_Returned_Sele as "On Quantity Returned Selected"
			{
				type =  form
				form = Material_Request_Voucher

				record event = on add or edit

				on user input of Material_Request_Details.Quantity_Returned
				{
					actions 
					{
						custom deluge script
						(
											for each  req_det in input.Material_Request_Details
										{
											if(req_det.Item == null || req_det.Unit_Of_Measure == null)
											{
												req_det.Quantity_Returned_in_Base_Unit_Of_Measure=null;
												continue;
											}
											if(req_det.Quantity_Returned == null || req_det.Quantity_Returned < 0)
											{
												req_det.Quantity_Returned_in_Base_Unit_Of_Measure=null;
												continue;
											}
											check = store_management.po.check_uom_conversion_from_masaka_site_management(req_det.Item,req_det.Unit_Of_Measure);
											if(check == null || check.get("ok") != true)
											{
												alert ifnull(check.get("message"),"UOM conversion failed.");
												req_det.Quantity_Returned_in_Base_Unit_Of_Measure=null;
												continue;
											}
											returned_base_qty = store_management.po.convert_to_base_qty_from_masaka_site_management(req_det.Item,req_det.Unit_Of_Measure,req_det.Quantity_Returned);
											if(returned_base_qty != null && returned_base_qty >= 0)
											{
												req_det.Quantity_Returned_in_Base_Unit_Of_Measure=returned_base_qty;
											}
											else
											{
												req_det.Quantity_Returned_in_Base_Unit_Of_Measure=null;
											}
											if(req_det.Quantity_Issued != null && req_det.Quantity_Returned > req_det.Quantity_Issued)
											{
												alert "Quantity Returned cannot be greater than Quantity Issued.";
												req_det.Quantity_Returned=null;
												req_det.Quantity_Returned_in_Base_Unit_Of_Measure=null;
											}
										}
						)
					}
				}

			}
			Full_Validation_On_Create8 as "Full Validation On Create"
			{
				type =  form
				form = Material_Request_Voucher

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Material_Request_Number == null || input.Material_Request_Number.trim() == "")
										{
											doc_key = Document_Key[Voucher_Type == "Material Request Voucher" && Document_Key_Status == "Active"];
											if(doc_key.ID == null)
											{
												alert "Document Key for Material Request Voucher is not configured.";
												cancel submit;
											}
											prefix_value = ifnull(doc_key.Prefix,"UAB");
											next_no = ifnull(doc_key.Next_Number,1);
											max_no = ifnull(doc_key.Max_Number,999);
											if(next_no > max_no)
											{
												alert "Material Request Voucher sequence has reached the maximum number.";
												cancel submit;
											}
											if(next_no < 10)
											{
												num_text = "00" + next_no;
											}
											else if(next_no < 100)
											{
												num_text = "0" + next_no;
											}
											else
											{
												num_text = next_no.toString();
											}
											input.Material_Request_Number = prefix_value + num_text;
											doc_key.Next_Number=next_no + 1;
										}
										// =======================================
										// MATERIAL REQUEST VOUCHER - VALIDATION
										// =======================================
										errors = "";
										// Create or Edit
										if(input.ID == null)
										{
											is_create = true;
										}
										else
										{
											is_create = false;
										}
										// =======================================
										// HEADER VALIDATION - ON CREATE
										// =======================================
										if(is_create == true)
										{
											if(input.Request_Date == null)
											{
												errors = errors + "\n• Request Date is required.";
											}
											if(input.Site == null)
											{
												errors = errors + "\n• Site is required.";
											}
											if(input.Description == null || input.Description.trim() == "")
											{
												errors = errors + "\n• Description is required.";
											}
											if(input.Work_Order == null)
											{
												errors = errors + "\n• Work Order is required.";
											}
											if(input.Issue == null)
											{
												errors = errors + "\n• Issue is required.";
											}
											if(input.Work_Order_Task == null)
											{
												errors = errors + "\n• Work Order Task is required.";
											}
											if(input.User == null)
											{
												errors = errors + "\n• User is required.";
											}
											if(input.Works_Coordinator == null)
											{
												errors = errors + "\n• Works Coordinator is required.";
											}
											// ===================================
											// SUBFORM VALIDATION
											// ===================================
											if(input.Material_Request_Details == null || input.Material_Request_Details.count() == 0)
											{
												errors = errors + "\n• Add at least one Material Request Detail.";
											}
											else
											{
												row_no = 1;
												for each  req_det in input.Material_Request_Details
												{
													if(req_det.Item == null)
													{
														errors = errors + "\n• Row " + row_no + ": Item is required.";
													}
													if(req_det.Quantity == null || req_det.Quantity <= 0)
													{
														errors = errors + "\n• Row " + row_no + ": Quantity Requested must be greater than zero.";
													}
													if(req_det.Unit_Of_Measure == null)
													{
														errors = errors + "\n• Row " + row_no + ": Unit Of Measure is required.";
													}
													row_no = row_no + 1;
												}
											}
										}
										// =======================================
										// FINAL ERROR GATE
										// =======================================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize18 as "Finalize"
			{
				type =  form
				form = Material_Request_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Generate Material Request Voucher Numbers
										// =======================================
										for each  req_det in input.Material_Request_Details
										{
											line_no = ifnull(req_det.Line_Number,0);
											if(line_no < 10)
											{
												line_text = "0" + line_no;
											}
											else
											{
												line_text = line_no.toString();
											}
											req_det.Material_Request_Voucher_Number=input.Material_Request_Number + "-" + line_text;
											req_det.Display_Name_Material_Request_Voucher=req_det.Material_Request_Voucher_Number;
											if(input.Work_Order_Task != null)
											{
												req_det.Work_Order_Task_Number=input.Work_Order_Task;
											}
											else
											{
												req_det.Work_Order_Task_Number=null;
											}
										}
										// =======================================
										// CREATED OR EDITED
										// =======================================
										u = thisapp.audit.getLoginAuditInfo();
										user_email_val = u.get("email");
										// =======================================
										// IN DRAFT
										// =======================================
										if(input.Date_Time_Requested == null || input.Requested_By_Email == null || input.Requested_By_Email.trim() == "")
										{
											input.Document_Status = "Draft";
											input.Date_Time_Requested = zoho.currenttime;
											input.Requested_By_Email = user_email_val;
											input.Date_Time_Approved = null;
											input.Approved_By_Email = null;
											return;
										}
										// =======================================
										// NEXT EDIT: APPROVE OR CANCEL
										// =======================================
										current_status = ifnull(input.Document_Status,"Draft").trim();
										if(current_status == "Draft")
										{
											if(input.Cancel_Voucher == true)
											{
												input.Document_Status = "Cancelled";
												input.Date_Time_Approved = null;
												input.Approved_By_Email = null;
												return;
											}
											else
											{
												input.Document_Status = "Approved";
												input.Date_Time_Approved = zoho.currenttime;
												input.Approved_By_Email = user_email_val;
												return;
											}
										}
										// =======================================
										// APPROVED -> ISSUED
										// =======================================
										if(input.Document_Status == "Approved")
										{
											input.Document_Status = "Issued";
											input.Date_Time_Issued = zoho.currenttime;
											input.Issued_By_Email = zoho.loginuserid;
										}
										// =======================================
										// ISSUED -> COMPLETED
										// =======================================
										if(input.Document_Status == "Issued")
										{
											input.Document_Status = "Completed";
											input.Date_Time_Work_Checked = zoho.currenttime;
											input.Checked_By_Email = zoho.loginuserid;
										}
						)
					}
				}

			}
			Delete_Row_Materials_Requ as "Delete Row \"Materials Request Details\""
			{
				type =  form
				form = Material_Request_Voucher

				record event = on add or edit

				on delete row of Material_Request_Details
				{
					actions 
					{
						custom deluge script
						(
											line_no = 1;
										for each  req_det in input.Material_Request_Details
										{
											if(req_det != row)
											{
												req_det.Line_Number=line_no;
												if(line_no < 10)
												{
													line_text = "0" + line_no;
												}
												else
												{
													line_text = line_no.toString();
												}
												if(input.Material_Request_Number != null && input.Material_Request_Number.trim() != "")
												{
													req_det.Material_Request_Voucher_Number=input.Material_Request_Number + "-" + line_text;
													req_det.Display_Name_Material_Request_Voucher=input.Material_Request_Number + "-" + line_text;
												}
												line_no = line_no + 1;
											}
										}
						)
					}
				}

			}
			On_Cancel_Voucher_Selecte3 as "On Cancel Voucher Selected"
			{
				type =  form
				form = Material_Request_Voucher

				record event = on add or edit

				on user input of Cancel_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_Voucher == true)
										{
											show Reason_Why_Cancelled;
											input.Date_Time_Approved = null;
											input.Approved_By_Email = null;
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = null;
										}
						)
					}
				}

			}
			Full_Validation24 as "Full Validation"
			{
				type =  form
				form = Material_Request_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// DRAFT REVIEW VALIDATION (EDIT ONLY)
										// =======================================
										if(input.ID != null && input.Document_Status == "Draft")
										{
											if(input.Cancel_Voucher == true)
											{
												if(input.Reason_Why_Cancelled == null || input.Reason_Why_Cancelled.trim() == "")
												{
													alert "Reason Why Cancelled is Required.";
													cancel submit;
												}
											}
											else
											{
												if(input.Supply_Manager == null)
												{
													alert "Supply Manager is Required before Approval.";
													cancel submit;
												}
											}
										}
										// =======================================
										// APPROVED STAGE VALIDATION
										// =======================================
										if(input.Document_Status == "Approved")
										{
											if(input.Store_Manager == null)
											{
												alert "Store Manager is Required.";
												cancel submit;
											}
											row_no = 1;
											for each  req_det in input.Material_Request_Details
											{
												if(req_det.Quantity_Issued == null || req_det.Quantity_Issued <= 0)
												{
													alert "Row " + row_no + ": Quantity Issued is required.";
													cancel submit;
												}
												if(req_det.Quantity_Returned == null)
												{
													alert "Row " + row_no + ": Quantity Returned is required.";
													cancel submit;
												}
												row_no = row_no + 1;
											}
										}
										// =======================================
										// ISSUED STAGE VALIDATION
										// =======================================
										if(input.Document_Status == "Issued")
										{
											if(input.Job_Done_Checklist == null || input.Job_Done_Checklist.size() != 4)
											{
												alert "Please Complete the Job Done Checklist Before Completing the Request.";
												cancel submit;
											}
										}
						)
					}
				}

			}
