			On_Bed_Height_Selected as "On Bed Height Selected"
			{
				type =  form
				form = Truck_Measurement

				record event = on add or edit

				on user input of Bed_Height
				{
					actions 
					{
						custom deluge script
						(
											res = thisapp.truck.compute_sizes(input.Bed_Length,input.Bed_Width,input.Bed_Height,input.Bed_Height_2);
										input.Truck_Size_1 = res.get("size1");
										input.Truck_Size_2 = res.get("size2");
										// 2️⃣ Bed-level differences
										input.Bed_Length_Difference = (ifnull(input.Bed_Length_Confirmed,0.0) - ifnull(input.Bed_Length,0.0)).round(3);
										input.Bed_Width_Difference = (ifnull(input.Bed_Width_Confirmed,0.0) - ifnull(input.Bed_Width,0.0)).round(3);
										input.Bed_Height_Difference = (ifnull(input.Bed_Height_Confirmed,0.0) - ifnull(input.Bed_Height,0.0)).round(3);
										input.Bed_Height_2_Difference = (ifnull(input.Bed_Height_2_Confirmed,0.0) - ifnull(input.Bed_Height_2,0.0)).round(3);
										// 3️⃣ Truck size differences
										input.Truck_Size_1_Difference = (ifnull(input.Truck_Size_1_Confirmed,0.0) - ifnull(input.Truck_Size_1,0.0)).round(3);
										input.Truck_Size_2_Difference = (ifnull(input.Truck_Size_2_Confirmed,0.0) - ifnull(input.Truck_Size_2,0.0)).round(3);
						)
					}
				}

			}
