												if(input.Task_Location == "Suppliers")
												{
													show Party_From;
													show Party_Location_From;
													enable Party_From;
													enable Party_Location_From;
													hide Site_From;
													hide Site_Location_From;
													if(is_create)
													{
														input.Site_From = null;
														input.Site_Location_From = null;
													}
												}
												else
												{
													show Site_From;
													show Site_Location_From;
													enable Site_From;
													enable Site_Location_From;
													hide Party_From;
													hide Party_Location_From;
													if(is_create)
													{
														input.Party_From = null;
														input.Party_Location_From = null;
													}
												}
												show Site_To;
												show Site_Location_To;
												enable Site_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
											}
											else if(jobNo == "TJS03")
											{
												show Pick_Up_Section;
												show Batch_Number_From;
												show Tractor_Work_Report;
												hide Card;
												hide Work_Order_Task;
												hide Truck_Movement_Voucher;
												hide Task_Location;
												hide Small_Notes;
												if(is_create)
												{
													input.Card = null;
													input.Work_Order_Task = null;
													input.Truck_Movement_Voucher = null;
													input.Task_Location = null;
													input.Small_Notes = null;
													input.Party_From = null;
													input.Party_Location_From = null;
													input.Party_To = null;
													input.Party_Location_To = null;
												}
												show Site_From;
												disable Site_From;
												show Site_Location_From;
												enable Site_Location_From;
												hide Party_From;
												hide Party_Location_From;
												show Site_To;
												disable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
											}
											else if(jobNo == "TJS04")
											{
												show Pick_Up_Section;
												show Truck_Movement_Voucher;
												enable Truck_Movement_Voucher;
												hide Card;
												hide Work_Order_Task;
												hide Batch_Number_From;
												hide Task_Location;
												show Small_Notes;
												enable Small_Notes;
												if(is_create)
												{
													input.Card = null;
													input.Work_Order_Task = null;
													input.Batch_Number_From = null;
													input.Task_Location = null;
													input.Site_From = null;
													input.Site_Location_From = null;
													input.Party_To = null;
													input.Party_Location_To = null;
												}
												show Party_From;
												disable Party_From;
												show Party_Location_From;
												enable Party_Location_From;
												hide Site_From;
												hide Site_Location_From;
												show Site_To;
												enable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
											}
										}
										else
										{
											hide Pick_Up_Section;
											hide Delivery_Section;
											hide Line_Summary;
											hide Card;
											hide Work_Order_Task;
											hide Batch_Number_From;
											hide Truck_Movement_Voucher;
											hide Task_Location;
											hide Small_Notes;
											if(is_create)
											{
												input.Card = null;
												input.Work_Order_Task = null;
												input.Batch_Number_From = null;
												input.Truck_Movement_Voucher = null;
												input.Task_Location = null;
												input.Small_Notes = null;
											}
										}
										// =======================
										// 4. CREATE MODE
										// =======================
										if(is_create)
										{
											hide Delivery_Section;
											hide Party_To;
											hide Party_Location_To;
											hide Site_To;
											hide Site_Location_To;
											hide Delivery_To;
