			Full_Validation30 as "Full Validation"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PAYMENT MADE VOUCHER - VALIDATION
										// =====================================================
										errors = List();
										amount_due = ifnull(input.Amount_Due,0.0);
										amount_not_allocated = ifnull(input.Amount_Not_Allocated,0.0);
										amount_paid = ifnull(input.Amount_Paid,0.0);
										if(amount_paid <= 0)
										{
											errors.add("• Amount Paid must be greater than zero.");
										}
										if(amount_paid > amount_due)
										{
											errors.add("• Amount Paid cannot be greater than Amount Due.");
										}
										if(amount_paid > amount_not_allocated)
										{
											errors.add("• Amount Paid cannot be greater than Amount Not Allocated.");
										}
										if(errors.size() > 0)
										{
											alert errors.toString("\n");
											cancel submit;
										}
										input.Amount_Allocated = amount_paid;
										input.Balance_Due = amount_due - amount_paid;
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0.0;
										}
						)
					}
				}

			}
