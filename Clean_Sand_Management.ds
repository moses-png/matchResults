			On_Customer_Type_Selected as "On Customer Type Selected"
			{
				type =  form
				form = Customer_Register

				record event = on add or edit

				on user input of Customer_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Customer_Type == "Cash")
										{
											show Customer_Name;
											hide Customer;
											hide Credit_Management;
											input.Customer = null;
											input.Credit_Allowed = false;
											input.Credit_Limit = null;
											input.Credit_Days_Allowed = null;
										}
										else if(input.Customer_Type == "Credit")
										{
											hide Customer_Name;
											show Customer;
											show Credit_Management;
										}
										else
										{
											hide Customer_Name;
											hide Customer;
											hide Credit_Management;
										}
						)
					}
				}

			}
