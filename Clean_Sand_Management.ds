			Set_Up_Form8 as "Set Up Form"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ==========================================
										// FUEL RECEIVING VOUCHER — FORM SETUP
										// ==========================================
										// ===== BACK END FIELDS (HIDE + DISABLE) =====
										hide Back_End;
										hide User_Name;
										hide User_Email;
										hide User_Role;
										hide Created_By_Name;
										hide Created_By_Email;
										hide Created_By_Time;
										hide Updated_By_Name;
										hide Updated_By_Email;
										hide Updated_By_Time;
										hide Display_Name_Asset;
										hide Display_Name_Item_Issuing_Detail;
										hide Display_Name_Voucher;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// ===== DISABLE SYSTEM FIELDS =====
										disable Fuel_Receiving_Voucher;
										disable Supplied_By;
										// ===== HIDE BY DEFAULT =====
										hide Fuel_Receiving_Voucher;
										// ===== CREATE MODE =====
										if(input.ID == null)
										{
											hide Fuel_Receiving_Voucher;
											hide Vendor;
											hide Store;
											hide Display_Name_Store;
											hide Item_Issuing_Detail;
											hide Supplied_By;
											hide Rate;
											hide Status;
											hide Total;
										}
										// ===== EDIT MODE =====
										else
										{
											show Fuel_Receiving_Voucher;
											show Supplied_By;
											show Rate;
											show Status;
											disable Fuel_Issuing_Time;
											disable Issued_By;
											disable Quantity;
											disable Rate;
											disable Total;
											disable Vendor;
											disable Voucher;
											disable Asset;
											disable Odometer;
											hide Odometer;
											disable Fuel_Level_After;
											disable Fuel_Level_Before;
											disable Status;
											if(input.Issued_By == "Vendor")
											{
												show Vendor;
												hide Store;
												hide Display_Name_Store;
												hide Item_Issuing_Detail;
											}
											else if(input.Issued_By == "Fuel Tank")
											{
												show Store;
												show Display_Name_Store;
												hide Vendor;
												show Item_Issuing_Detail;
											}
											else
											{
												hide Vendor;
												hide Store;
												hide Display_Name_Store;
												hide Item_Issuing_Detail;
											}
										}
						)
					}
				}

			}
