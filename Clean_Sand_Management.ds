			Full_Validation18 as "Full Validation"
			{
				type =  form
				form = Meter_Reading

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// METER READING -> FULL VALIDATION
										// ======================================
										errors = "";
										if(input.ID == null)
										{
											is_create = true;
										}
										else
										{
											is_create = false;
										}
										meter_img = ifnull(input.Meter_Image.toString(),"").trim();
										// ======================================
										// REQUIRED FIELDS
										// ======================================
										if(input.Employee_Voucher == null)
										{
											errors = errors + "\n• Employee Voucher is required.";
										}
										if(input.Meter_Type == null)
										{
											errors = errors + "\n• Meter Type is required.";
										}
										if(input.Meter == null)
										{
											errors = errors + "\n• Meter is required.";
										}
										if(input.Unit_Of_Measure == null || input.Unit_Of_Measure == "")
										{
											errors = errors + "\n• Unit Of Measure is required.";
										}
										if(input.Current_Reading == null)
										{
											errors = errors + "\n• Current Reading is required.";
										}
										if(input.Current_Reading_Date == null)
										{
											errors = errors + "\n• Current Reading Date is required.";
										}
										if(meter_img == "")
										{
											errors = errors + "\n• Meter Image is required.";
										}
										if(input.Previous_Reading != null && input.Current_Reading != null)
										{
											if(input.Current_Reading < input.Previous_Reading)
											{
												errors = errors + "\n• Current Reading cannot be less than Previous Reading.";
											}
										}
										// ======================================
										// RECALCULATE CONSUMPTION
										// ======================================
										if(input.Current_Reading != null)
										{
											if(input.Previous_Reading == null)
											{
												input.Previous_Reading = 0;
											}
											if(input.Current_Reading >= input.Previous_Reading)
											{
												baseConsumption = input.Current_Reading - input.Previous_Reading;
												finalConsumption = baseConsumption;
												if(input.Unit_Of_Measure != null && input.Unit_Of_Measure.contains("CT Ratio"))
												{
													parts = input.Unit_Of_Measure.toList(" ");
													if(parts.size() >= 3)
													{
														ctRatioText = parts.get(2);
														if(ctRatioText != null && ctRatioText != "")
														{
															finalConsumption = baseConsumption * ctRatioText.toDecimal();
														}
													}
												}
												input.Consumption = finalConsumption;
											}
										}
										// ======================================
										// STOP SUBMISSION IF ERRORS EXIST
										// ======================================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize14 as "Finalize"
			{
				type =  form
				form = Meter_Reading

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// METER READING -> FINALIZE
										// ======================================
										if(input.Current_Reading_Date == null)
										{
											input.Current_Reading_Date = zoho.currenttime;
										}
										// ======================================
										// RECALCULATE CONSUMPTION
										// ======================================
										baseConsumption = ifnull(input.Current_Reading,0.0) - ifnull(input.Previous_Reading,0.0);
										finalConsumption = baseConsumption;
										if(input.Unit_Of_Measure != null && input.Unit_Of_Measure.contains("CT Ratio"))
										{
											parts = input.Unit_Of_Measure.toList(" ");
											if(parts.size() >= 3)
											{
												ctRatioText = parts.get(2);
												if(ctRatioText != null && ctRatioText != "")
												{
													finalConsumption = baseConsumption * ctRatioText.toDecimal();
												}
											}
										}
										input.Consumption = finalConsumption;
										// ======================================
										// CURRENT INVOICE DETAIL
										// ======================================
										existingDetail = Invoice_Details[Source_Form == "Meter Reading" && Source_Record_ID == input.ID];
										detailText = "Previous Reading Date: " + ifnull(input.Previous_Reading_Date,"").toString() + "\n" + "Previous Reading: " + ifnull(input.Previous_Reading,0).toString() + "\n" + "Current Reading: " + ifnull(input.Current_Reading,0).toString() + "\n" + "Current Reading Date: " + ifnull(input.Current_Reading_Date,"").toString() + "\n" + "Meter: " + ifnull(input.Meter.Asset_Name,"") + " - " + ifnull(input.Meter.Asset_ID,"") + "\n" + "Site: " + ifnull(input.Current_Site,"") + "\n" + "Unit Of Measure: " + ifnull(input.Unit_Of_Measure,"");
										if(existingDetail.count() > 0)
										{
											for each  d in existingDetail
											{
												d.Display_Name_Voucher=ifnull(input.Display_Name_Voucher,"");
												d.Item=ifnull(input.Meter.Asset_Name,"Meter Reading");
												d.Details=detailText;
												d.Quantity=ifnull(input.Consumption,0.0);
												d.Rate=null;
												d.Account=ifnull(input.Account,"");
												d.Site=ifnull(input.Current_Site,"");
												d.Source_Form="Meter Reading";
												d.Source_Record_ID=input.ID;
												break;
											}
										}
										else
										{
											insert into Invoice_Details
											[
												Display_Name_Voucher=input.Display_Name_Voucher
												Item=ifnull(input.Meter.Asset_Name,"Meter Reading")
												Details=detailText
												Quantity=ifnull(input.Consumption,0.0)
												Rate=null
												Account=ifnull(input.Account,"")
												Site=ifnull(input.Current_Site,"")
												Source_Form="Meter Reading"
												Source_Record_ID=input.ID
												Added_User=zoho.loginuser
											]
										}
										// ======================================
										// FIX NEXT METER READING + NEXT INVOICE DETAIL
										// ======================================
										if(input.Meter != null && input.Current_Reading_Date != null)
										{
											nextList = Meter_Reading[Meter == input.Meter && ID != input.ID && Current_Reading_Date > input.Current_Reading_Date] sort by Current_Reading_Date asc;
											for each  n in nextList
											{
												n.Previous_Reading=ifnull(input.Current_Reading,0.0);
												n.Previous_Reading_Date=input.Current_Reading_Date;
												nextBaseConsumption = ifnull(n.Current_Reading,0.0) - ifnull(input.Current_Reading,0.0);
												nextFinalConsumption = nextBaseConsumption;
												if(n.Unit_Of_Measure != null && n.Unit_Of_Measure.contains("CT Ratio"))
												{
													nextParts = n.Unit_Of_Measure.toList(" ");
													if(nextParts.size() >= 3)
													{
														nextCtRatioText = nextParts.get(2);
														if(nextCtRatioText != null && nextCtRatioText != "")
														{
															nextFinalConsumption = nextBaseConsumption * nextCtRatioText.toDecimal();
														}
													}
												}
												n.Consumption=nextFinalConsumption;
												nextInvoiceDetail = Invoice_Details[Source_Form == "Meter Reading" && Source_Record_ID == n.ID];
												nextDetailText = "Previous Reading Date: " + ifnull(n.Previous_Reading_Date,"").toString() + "\n" + "Previous Reading: " + ifnull(n.Previous_Reading,0).toString() + "\n" + "Current Reading: " + ifnull(n.Current_Reading,0).toString() + "\n" + "Current Reading Date: " + ifnull(n.Current_Reading_Date,"").toString() + "\n" + "Meter: " + ifnull(n.Meter.Asset_Name,"") + " - " + ifnull(n.Meter.Asset_ID,"") + "\n" + "Site: " + ifnull(n.Current_Site,"") + "\n" + "Unit Of Measure: " + ifnull(n.Unit_Of_Measure,"");
												if(nextInvoiceDetail.count() > 0)
												{
													for each  nd in nextInvoiceDetail
													{
														nd.Details=nextDetailText;
														nd.Quantity=ifnull(n.Consumption,0.0);
														nd.Rate=null;
														break;
													}
												}
												break;
											}
										}
										// -------------------------------------
										// SYNC METER READING TO ASSET MANAGEMENT
										// -------------------------------------
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = ifnull(u.get("name"),"");
										input.User_Email = ifnull(u.get("email"),"");
										input.User_Role = ifnull(u.get("role"),"");
										if(input.Meter != null && input.Current_Reading != null)
										{
											if(input.Current_Reading_Date == null)
											{
												input.Current_Reading_Date = zoho.currenttime;
											}
											prevReading = ifnull(input.Previous_Reading,0.0);
											currReading = ifnull(input.Current_Reading,0.0);
											consumptionVal = round(currReading - prevReading,2);
											if(consumptionVal < 0)
											{
												consumptionVal = 0.0;
											}
											asset_payload = Map();
											asset_payload.put("Asset_ID",input.Meter);
											asset_payload.put("Date_Time_Recorded",input.Current_Reading_Date);
											asset_payload.put("Odometer_Reading",currReading);
											asset_payload.put("Previous_Odometer",prevReading);
											asset_payload.put("Distance_Since_Last",consumptionVal);
											asset_payload.put("Unit_of_Measure",input.Unit_Of_Measure);
											asset_payload.put("Odometer_Source_Form","Clean Sand Management - Meter Reading");
											asset_payload.put("Source_Record_ID",input.ID);
											asset_payload.put("Reference",input.Meter);
											asset_payload.put("Notes","Auto-created from Clean Sand Management Meter Reading");
											asset_payload.put("User_Name",input.User_Name);
											asset_payload.put("User_Email",input.User_Email);
											asset_payload.put("User_Role",input.User_Role);
											asset_payload.put("Created_By_Name",input.User_Name);
											asset_payload.put("Created_By_Email",input.User_Email);
											asset_payload.put("Created_By_Time",zoho.currenttime);
											info "ASSET MILEAGE LOG SYNC PAYLOAD:";
											info asset_payload;
											asset_resp = asset_management.syncMileageLogFromMeterReading(asset_payload);
											info "ASSET MILEAGE LOG SYNC RESPONSE:";
											info asset_resp;
										}
										else
										{
											info "ASSET MILEAGE LOG SYNC SKIPPED.";
										}
						)
					}
				}

			}
			On_Customer_Deposit_Vouch as "On Customer Deposit Voucher Selected"
