			Set_Up_Form25 as "Set Up Form"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										//Back End
										hide Back_End;
										//SUB FORMS
										hide Charge_Details.Payment_Receipt_Voucher;
										hide Charge_Details.Transaction_Type;
										hide Charge_Details.Display_Name_Payment_Voucher;
										hide Charge_Details.User_Name;
										hide Charge_Details.User_Email;
										hide Charge_Details.User_Role;
										hide Charge_Details.Created_By_Name;
										hide Charge_Details.Created_By_Email;
										hide Charge_Details.Created_By_Time;
										hide Charge_Details.Updated_By_Name;
										hide Charge_Details.Updated_By_Email;
										hide Charge_Details.Updated_By_Time;
										//DISABLE FIELDS
										//Receipt Details
										disable Display_Name_Payment_Account;
										//disable Payment_Made_Date;
										hide Charge_Details.Payment_Made_Voucher;
										//Customer Details
										disable Display_Name_Vendor;
										//Receipt Amount Details
										disable Total_Charges;
										disable Total_Amount_Allocated;
										disable Total_Amount_Not_Allocated;
										disable Payment_Made_Voucher_Status;
										//Back End
										hide Made_Details.User_Name;
										hide Made_Details.User_Email;
										hide Made_Details.User_Role;
										hide Made_Details.Created_By_Name;
										hide Made_Details.Created_By_Email;
										hide Made_Details.Created_By_Time;
										hide Made_Details.Updated_By_Name;
										hide Made_Details.Updated_By_Email;
										hide Made_Details.Updated_By_Time;
										hide Made_Details.Display_Name_Bill;
										hide Charge_Details.Payment_Made_Voucher;
										// Hide backend
										hide Back_End;
										hide Display_Name_Payment_Account;
										hide Display_Name_Vendor;
										hide Customer_Vendor;
										// Subform hidden fields
										hide Made_Details.Display_Name_Payment_Made_Voucher;
										hide Made_Details.Payment_Type;
										disable Display_Name_Payment_Account;
										disable Display_Name_Vendor;
										disable Total_Amount_Allocated;
										disable Total_Amount_Not_Allocated;
										disable Payment_Made_Voucher_Status;
										disable Made_Details.Display_Name_Payment_Made_Voucher;
										hide Made_Details.Display_Name_Vendor;
										disable Made_Details.Line_Number;
										disable Made_Details.Amount_Due;
										disable Made_Details.Amount_Allocated;
										disable Made_Details.Balance_Due;
										disable Charge_Details.Line_Number;
										if(input.Vendor_Type == "External Vendor")
										{
											show Vendor;
											hide Employee_Vendor;
											hide Customer_Vendor;
										}
										else if(input.Vendor_Type == "Employee Vendor")
										{
											show Employee_Vendor;
											hide Vendor;
											hide Customer_Vendor;
										}
										else if(input.Vendor_Type == "Customer Vendor")
										{
											show Customer_Vendor;
											hide Vendor;
											hide Employee_Vendor;
										}
										else
										{
											hide Vendor;
											hide Employee_Vendor;
											hide Customer_Vendor;
										}
						)
					}
				}

			}
