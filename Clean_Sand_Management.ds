											else if(next_no < 100)
											{
												num_text = "0" + next_no;
											}
											else
											{
												num_text = next_no.toString();
											}
											input.Work_Order_Number = prefix_value + num_text;
											doc_key.Next_Number=next_no + 1;
										}
						)
					}
				}

			}
