			Set_Up_Form18 as "Set Up Form"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//HIDE FIELDS
										//Receipt Details
										hide Display_Name_Receiving_Account;
										//Customer Details
										hide Display_Name_Customer;
										hide Display_Name_Cashier_Envelope;
										hide Display_Name_Cash_Envelope;
										//Receipt Amount Details
										//Back End
										hide Back_End;
										hide Payment_Receipt_Details;
										//SUB FORMS
										hide Charge_Details.Transaction_Type;
										hide Charge_Details.Display_Name_Payment_Voucher;
										hide Charge_Details.User_Name;
										hide Charge_Details.User_Email;
										hide Charge_Details.User_Role;
										hide Charge_Details.Created_By_Name;
										hide Charge_Details.Created_By_Email;
										hide Charge_Details.Created_By_Time;
										hide Charge_Details.Updated_By_Name;
										hide Charge_Details.Updated_By_Email;
										hide Charge_Details.Updated_By_Time;
										//DISABLE FIELDS
										//Receipt Details
										disable Display_Name_Receiving_Account;
										//disable Payment_Receipt_Date;
										//Customer Details
										disable Display_Name_Customer;
										//Receipt Amount Details
										disable Total_Charges;
										disable Total_Amount_Allocated;
										disable Total_Amount_Not_Allocated;
										disable Payment_Receipt_Voucher_Status;
										//Back End
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										//SUBFORMS
										//Charge Details
										disable Charge_Details.Transaction_Type;
										disable Charge_Details.Display_Name_Payment_Voucher;
										disable Charge_Details.Line_Number;
										disable Charge_Details.User_Name;
										disable Charge_Details.User_Email;
										disable Charge_Details.User_Role;
										disable Charge_Details.Created_By_Name;
										disable Charge_Details.Created_By_Email;
										disable Charge_Details.Created_By_Time;
										disable Charge_Details.Updated_By_Name;
										disable Charge_Details.Updated_By_Email;
										disable Charge_Details.Updated_By_Time;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			Finalize_On_Create18 as "Finalize On Create"
			{
				type =  form
