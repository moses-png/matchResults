			Set_Up_Form as "Set Up Form"
			{
				type =  form
				form = Customer_Register

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Hide everything initially
										hide Customer_Name;
										hide Customer;
										hide Customer_Code;
										hide Display_Name_Customer;
										hide Credit_Management;
										hide TIN_Number;
										disable Total_Quotations;
										disable Total_Sales_Orders;
										disable Total_Revenue;
										disable Total_Paid;
										disable Outstanding_Balance;
										disable Last_Purchase_Date;
										// Customer Type logic
										if(input.Customer_Type == "Cash")
										{
											show Customer_Name;
										}
										else if(input.Customer_Type == "Credit")
										{
											show Customer;
											show Credit_Management;
										}
										// Tax Invoice logic
										if(input.Tax_Invoice_Required == true)
										{
											show TIN_Number;
										}
										hide Back_End;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
