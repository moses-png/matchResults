			On_Vendor_Service_Type_Se as "On Vendor Service Type Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Vendor_Service_Type
				{
					actions 
					{
						custom deluge script
						(
											// User input of Vendor_Service_Type (Work_Order_Tasks)
										isLabourService = false;
										isItemsService = false;
										if(input.Vendor_Service_Type == "Labour Only" || input.Vendor_Service_Type == "Tractor Work Report" || input.Vendor_Service_Type == "Truck Movement Voucher")
										{
											isLabourService = true;
										}
										else if(input.Vendor_Service_Type == "Items Only")
										{
											isItemsService = true;
										}
										if(isLabourService)
										{
											show Parts_Consumables;
											show Parts_Consumables.Labour;
											hide Parts_Consumables.Item;
											hide Parts_Total;
											show Labour_Total;
											show Grand_Total;
											hide Store_Manager;
											hide Display_Name_Store_Manager;
											input.Store_Manager = null;
											input.Display_Name_Store_Manager = "";
											for each  r in input.Parts_Consumables
											{
												if(r.Item != null)
												{
													r.Item=null;
													r.Display_Name_Item_Labour="";
													r.Quantity=null;
													r.Unit_Cost=null;
													r.Unit_Of_Measure="";
													r.Line_Total=null;
												}
											}
										}
										else if(isItemsService)
										{
											show Parts_Consumables;
											show Parts_Consumables.Item;
											hide Parts_Consumables.Labour;
											show Parts_Total;
											hide Labour_Total;
											show Grand_Total;
											show Store_Manager;
											//show Display_Name_Store_Manager;
											enable Store_Manager;
											if(input.Store_Manager != null)
											{
												input.Display_Name_Store_Manager = input.Store_Manager.Employee_Name + " - " + ifnull(input.Store_Manager.Employee_Number,"");
											}
											else
											{
												input.Display_Name_Store_Manager = "";
											}
											for each  r in input.Parts_Consumables
											{
												if(r.Labour != null)
												{
													r.Labour=null;
													r.Display_Name_Item_Labour="";
													r.Quantity=null;
													r.Unit_Cost=null;
													r.Unit_Of_Measure="";
													r.Line_Total=null;
												}
											}
										}
										else
										{
											hide Parts_Consumables;
											hide Parts_Total;
											hide Labour_Total;
											hide Grand_Total;
											hide Store_Manager;
											hide Display_Name_Store_Manager;
											input.Store_Manager = null;
											input.Display_Name_Store_Manager = "";
										}
										// ---- Recalculate totals ----
										parts_rows = List();
										for each  rr in input.Parts_Consumables
										{
											m = Map();
											m.put("Item",rr.Item);
											m.put("Labour",rr.Labour);
											m.put("Quantity",rr.Quantity);
											m.put("Unit Cost",rr.Unit_Cost);
											parts_rows.add(m);
										}
										input.Parts_Total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
										input.Labour_Total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Parts_Total,input.Labour_Total);
						)
					}
				}

			}
			On_Addition_Of_Row2 as "On Addition Of Row"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on add row of Parts_Consumables
				{
					actions 
					{
						custom deluge script
						(
											// Display Work Order Task Number into the row (must exist in subform)
										row.Display_Name_Work_Order_Task_Number=input.Work_Order_Task_Number;
										// Line Number
										max_line = 0;
										for each  r in input.Parts_Consumables
										{
											if(r.Line_Number != null && r.Line_Number > max_line)
											{
												max_line = r.Line_Number;
											}
										}
										row.Line_Number=max_line + 1;
						)
					}
				}

			}
			On_Labour_Selected as "On Labour Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Parts_Consumables.Labour
				{
					actions 
					{
						custom deluge script
						(
											// ===== LABOUR SELECTED: make row a Labour row, reset amounts =====
										if(row.Labour != null)
										{
											// Make it Labour-only
											row.Item=null;
											// Set display: Labour Name
											row.Display_Name_Item_Labour=row.Labour.Labour_Name;
											// Reset row amounts
											row.Quantity=null;
											row.Unit_Cost=null;
											row.Line_Total=null;
										}
										else
										{
											// If Labour cleared, clear display ONLY if Item is empty
											if(row.Item == null)
											{
												row.Display_Name_Item_Labour="";
											}
										}
										// ===== RECALCULATE TOTALS (build LIST(Map) for your functions) =====
										parts_rows = List();
										for each  r in input.Parts_Consumables
										{
											m = Map();
											m.put("Item",r.Item);
											m.put("Labour",r.Labour);
											m.put("Quantity",r.Quantity);
											m.put("Unit Cost",r.Unit_Cost);
											parts_rows.add(m);
										}
										input.Parts_Total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
										input.Labour_Total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Parts_Total,input.Labour_Total);
						)
					}
				}

			}
			On_Quantity_Selected4 as "On Quantity Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Parts_Consumables.Quantity
				{
					actions 
					{
						custom deluge script
						(
											// 1) Always update THIS row line total
										row.Line_Total=thisapp.asset_calc.asset_calc_line_total(row.Quantity,row.Unit_Cost);
										// 2) Parent totals: only if the parent record already exists (Edit mode)
										if(input.ID != null)
										{
											rec = Work_Order_Tasks[ID == input.ID];
											// Only proceed if record exists
											if(rec.count() > 0)
											{
												parts_rows = List();
												for each  r in rec.Parts_Consumables
												{
													m = Map();
													m.put("Item",r.Item);
													m.put("Labour",r.Labour);
													m.put("Quantity",r.Quantity);
													m.put("Unit Cost",r.Unit_Cost);
													parts_rows.add(m);
												}
												parts_total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
												labour_total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
												grand_total = thisapp.asset_calc.asset_calc_grand_total(parts_total,labour_total);
												rec.Parts_Total=parts_total;
												rec.Labour_Total=labour_total;
												rec.Grand_Total=grand_total;
											}
										}
						)
					}
				}

			}
			On_Unit_Of_Measure_Select4 as "On Unit Of Measure Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Parts_Consumables.Unit_Of_Measure
				{
					actions 
