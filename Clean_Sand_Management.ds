										}
										//DISABLE FIELDS
										disable Display_Name_Site;
										disable Delivery_Note_Date;
										disable Display_Name_Customer;
										disable Display_Name_Purchase_Order;
										disable Display_Name_Receipt_Officer_Daily_Voucher;
										disable Truck_Type;
										disable Display_Name_Prepared_By;
										disable Delivery_Note_Status;
										disable Reason_for_Cancelling;
										disable Sales_Voucher;
										//disable Cashier_Envelope;
										disable User_Email;
										disable User_Name;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Time;
										disable Created_By_Email;
										disable Updated_By_Name;
										disable Updated_By_Time;
										disable Updated_By_Email;
										//HIDE FIELDS
										//Voucher Details
										hide Display_Name_Site;
										//CUstomer Details
										hide Display_Name_Customer;
										hide Display_Name_Purchase_Order;
										//Truck Details
										hide TSF_Number;
										//Receipt Officer
										//hide Receipt_Officer;
										//hide Prepared_By;
										//Cashier Section
										hide Cashier_Section;
										hide Sales_Voucher;
										//hide Cashier_Envelope;
										//Status Details
										hide Status_Details;
										hide Cancel_Voucher;
										hide Reason_for_Cancelling;
										hide Delivery_Note_Status;
										hide Display_Name_Receipt_Officer_Daily_Voucher;
										hide Display_Name_Prepared_By;
										hide Notes;
										//Back End
										hide Back_End;
										hide User_Email;
										hide User_Name;
										hide User_Role;
										hide Created_By_Name;
										hide Created_By_Time;
										hide Created_By_Email;
										hide Updated_By_Name;
										hide Updated_By_Time;
										hide Updated_By_Email;
										if(input.Delivery_Note_Date == null)
										{
											input.Delivery_Note_Date = zoho.currenttime;
										}
										// ==================================================
										// CUSTOMER OVERRIDE (Delivery Note): hide PO + Location + Delivery Date
										// ==================================================
										if(input.Customer != null)
										{
											custName = ifnull(input.Customer.Display_Name_Customer,"").trim();
											if(custName == "Mrsand - 20" || custName == "Grapes Trucks - 18")
											{
												// Hide
												hide Purchase_Order;
												hide Purchase_Order_Details;
												hide Location;
												hide Delivery_Note_Date;
											}
											else
											{
												// Show for other customers
												show Purchase_Order;
												show Purchase_Order_Details;
												show Location;
												show Delivery_Note_Date;
											}
										}
						)
					}
				}

			}
