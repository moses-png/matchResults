													}
												}
												reference_text = reference_text + " - End";
												end_source_record_id = input.ID.toString() + "-END";
												end_mileage_resp = asset_management.logMileageFromMasaka(asset_id,input.Odometer_End,input.Time_End,reference_text,"Truck Movement Voucher",end_source_record_id);
												info end_mileage_resp;
