			On_Cancel_Voucher_Selecte as "On Cancel Voucher Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Cancel_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_Voucher == true)
										{
											show Reason_Why_Cancelled;
											input.Payment_Status = "Cancelled";
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = "";
										}
						)
					}
				}

			}
			On_Customer_Selected6 as "On Customer Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											if(input.Customer != null)
										{
											input.Display_Name_Customer = input.Customer.Display_Name_Customer;
										}
										else
										{
											input.Display_Name_Customer = "";
										}
						)
					}
