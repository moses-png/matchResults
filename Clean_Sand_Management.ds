												input.Display_Name_Base_Unit_Of_Measure = input.Item.Base_Unit_Of_Measure.Unit_Of_Measure_Name;
											}
											else
											{
												input.Base_Unit_Of_Measure = null;
												input.Display_Name_Base_Unit_Of_Measure = "";
											}
											if(input.Item.Item_Category != null && input.Item.Item_Category.Division != null)
											{
												input.Display_Name_Division = input.Item.Item_Category.Division.Division_Letter;
											}
											else
											{
												input.Display_Name_Division = "";
											}
											input.Business_Division = null;
											input.Display_Name_Business_Division = "";
											input.Quantity_Available = ifnull(input.Item.Stock_On_Hand,0);
											input.Quantity = 0;
											input.Quantity_in_Base_Unit_Of_Measure = 0;
											input.Unit_Price = 0;
											input.Line_Total = 0;
											input.Tax_Amount = 0;
										}
										else
										{
											input.Display_Name_Item = "";
											input.Display_Name_Division = "";
											input.Business_Division = null;
											input.Display_Name_Business_Division = "";
											input.Base_Unit_Of_Measure = null;
											input.Display_Name_Base_Unit_Of_Measure = "";
											input.Quantity_Available = 0;
											input.Quantity = 0;
											input.Quantity_in_Base_Unit_Of_Measure = 0;
											input.Unit_Price = 0;
											input.Line_Total = 0;
											input.Tax_Amount = 0;
										}
