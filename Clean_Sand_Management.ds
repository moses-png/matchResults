			Finalize12 as "Finalize"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ====================================================
										// 1) Auto-fill Fuel Issuing Time
										// ====================================================
										if(input.ID == null)
										{
											if(input.Fuel_Issuing_Time == null)
											{
												input.Fuel_Issuing_Time = zoho.currenttime;
											}
										}
										// ====================================================
										// 2) BILL DETAILS
										// ====================================================
										account_text = "";
										current_site_text = "";
										description_text = "";
										asset_text = "";
										voucher_text = "";
										issued_by_text = "";
										supplied_by_text = "";
										fuel_before_text = "";
										odometer_text = "";
										fuel_after_text = "";
										if(input.Asset != null)
										{
											asset_text = ifnull(input.Asset.Asset_Name,"") + " - " + ifnull(input.Asset.Asset_ID,"");
											account_text = asset_text;
											current_site_text = ifnull(input.Asset.Current_Site,"");
										}
										voucher_text = ifnull(input.Fuel_Receiving_Voucher,"");
										issued_by_text = ifnull(input.Issued_By,"");
										supplied_by_text = ifnull(input.Supplied_By,"");
										if(input.Fuel_Level_Before != null)
										{
											fuel_before_text = input.Fuel_Level_Before.toString();
										}
										if(input.Odometer != null)
										{
											odometer_text = input.Odometer.toString();
										}
										if(input.Fuel_Level_After != null)
										{
											fuel_after_text = input.Fuel_Level_After.toString();
										}
										description_text = "Asset: " + asset_text + "\nVoucher: " + voucher_text + "\nIssued By: " + issued_by_text + "\nSupplied By: " + supplied_by_text + "\nFuel Level Before: " + fuel_before_text + "\nOdometer: " + odometer_text + "\nFuel Level After: " + fuel_after_text;
										if(input.Fuel_Issuing_Time != null)
										{
											description_text = description_text + "\nFuel Issuing Time: " + input.Fuel_Issuing_Time.toString("dd-MMM-yyyy HH:mm:ss");
										}
										// ====================================================
										// 3) CREATE OR UPDATE BILL DETAILS
										// ====================================================
										source_text = input.Fuel_Receiving_Voucher + " - Fuel Receiving Voucher";
										existing_bd = Bill_Details[Reference == input.Fuel_Receiving_Voucher && Source == source_text];
										for each  bd in existing_bd
										{
											bd.Source=source_text;
											bd.Reference=input.Fuel_Receiving_Voucher;
											bd.Source_Form="Fuel Receiving Voucher";
											bd.Source_Record_ID=input.ID;
											bd.Display_Name_Item="Fuel";
											bd.Details=description_text;
											bd.Quantity=ifnull(input.Quantity,0.0);
											bd.Rate=ifnull(input.Rate,0.0);
											bd.Account=account_text;
											bd.Bill_Details_Status="Draft";
											bd.Current_Site=current_site_text;
											break;
										}
										if(existing_bd.count() == 0)
										{
											insert into Bill_Details
											[
												Source=source_text
												Reference=input.Fuel_Receiving_Voucher
												Source_Form="Fuel Receiving Voucher"
												Source_Record_ID=input.ID
												Display_Name_Item="Fuel"
												Details=description_text
												Quantity=ifnull(input.Quantity,0.0)
												Rate=ifnull(input.Rate,0.0)
												Account=account_text
												Current_Site=current_site_text
												Bill_Details_Status="Draft"
												Added_User=zoho.loginuser
											]
										}
										// ====================================================
										// 4) CREATE / UPDATE ASSET MILEAGE LOG IN ASSET MANAGEMENT
										// ====================================================
										if(input.Asset != null && input.Fuel_Issuing_Time != null && input.Odometer != null)
										{
											mileage_resp = asset_management.logMileageFromMasaka(input.Asset.ID,ifnull(input.Odometer,0.0),input.Fuel_Issuing_Time,ifnull(input.Fuel_Receiving_Voucher,""),"Fuel Receiving Voucher",input.ID.toString());
											info mileage_resp;
										}
										// ====================================================
										// 4) CREATE / UPDATE Totals ASSET MANAGEMENT
										// ====================================================
										if(input.Asset != null)
										{
											asset_management.asset.refresh_asset_costs(input.Asset.toLong());
										}
										if(input.Asset != null)
										{
											amount_val = 0.0;
											income_val = 0.0;
											expense_val = 0.0;
											issued_by_text = ifnull(input.Issued_By,"");
											supplied_by_text = ifnull(input.Supplied_By,"");
											voucher_text = ifnull(input.Fuel_Receiving_Voucher,"");
											desc_text = "";
											desc_text = desc_text + "Issued By: " + issued_by_text + "\n";
											desc_text = desc_text + "Supplied By: " + supplied_by_text + "\n";
											desc_text = desc_text + "Voucher: " + voucher_text + "\n";
											desc_text = desc_text + "Odometer: " + ifnull(input.Odometer,0.0).toString() + "\n";
											desc_text = desc_text + "Quantity: " + ifnull(input.Quantity,0.0).toString();
											payload = Map();
											payload.put("Transaction_Date",ifnull(input.Fuel_Issuing_Time,zoho.currenttime));
											payload.put("Transaction_Status","Draft");
											payload.put("Transaction_Description",desc_text);
											payload.put("Asset",input.Asset.ID);
											payload.put("Display_Name_Asset",ifnull(input.Display_Name_Asset,""));
											payload.put("Transaction_Direction","Expense");
											payload.put("Amount",amount_val);
											payload.put("Income",income_val);
											payload.put("Expenses",expense_val);
											payload.put("Application","Masaka Site Management");
											payload.put("Source_Form","Fuel Receiving Voucher");
											payload.put("Source_Record_ID",input.ID);
											payload.put("Notes",voucher_text);
											resp = asset_management.createOrUpdateAssetTransactionLog(payload);
											info resp;
										}
						)
					}
				}

			}
			Finalize_On_Delete14 as "Finalize On Delete"
			{
				type =  form
				form = Payment_Made_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PAYMENT MADE DETAILS FINALIZE ON DELETE
										// =====================================================
										// -----------------------------------------------------
										// Delete Synced Payment Made Detail
										// -----------------------------------------------------
										delete_payload = Map();
										delete_payload.put("Source_Record_ID",input.ID);
										delete_payload.put("Source_Form","Payment Made Details");
										delete_resp = payment_management.deletePaymentMadeDetailsFromMasakaSiteManagement(delete_payload);
										info delete_resp;
										// ======================================================
										// PAYMENT MADE DETAILS — ON DELETE
										// ======================================================
										if(input.Payment_Made_Voucher != null)
										{
											pmv = Payment_Made_Voucher[ID == input.Payment_Made_Voucher];
											if(pmv.ID != null)
											{
												total_paid = ifnull(pmv.Total_Amount_Paid,0.0);
												total_charges = ifnull(pmv.Total_Charges,0.0);
												detail_allocated = 0.0;
												for each  det in Payment_Made_Details[Payment_Made_Voucher == pmv.ID && ID != input.ID]
												{
													detail_allocated = detail_allocated + ifnull(det.Amount_Allocated,0.0);
												}
												amount_allocated = total_charges + detail_allocated;
												balance = total_paid - amount_allocated;
												if(balance < 0)
												{
													balance = 0.0;
												}
												pmv.Total_Amount_Allocated=amount_allocated;
												pmv.Total_Amount_Not_Allocated=balance;
												if(balance <= 0 && amount_allocated > 0)
												{
													pmv.Payment_Made_Voucher_Status="Allocated";
												}
												else if(amount_allocated > 0)
												{
													pmv.Payment_Made_Voucher_Status="Partially Allocated";
												}
												else
												{
													pmv.Payment_Made_Voucher_Status="Unassigned";
												}
											}
										}
										// =====================================================
										// PAYMENT - ON VALIDATE DELETE
										// =====================================================
										payment_rec = Payment_Made_Details[ID == input.ID];
										if(payment_rec.ID != null && payment_rec.Bill != null)
										{
											bill_id = payment_rec.Bill.ID;
											po_ids = List();
											bill_detail_rows = Bill_Details[Bill == bill_id];
											for each  bd in bill_detail_rows
											{
												if(bd.Item != null)
												{
													po_det = Purchase_Order_Details[ID == bd.Item.ID];
													if(po_det.ID != null && po_det.Purchase_Order != null)
													{
														po_id = po_det.Purchase_Order.ID;
														if(!po_ids.contains(po_id))
														{
															po_ids.add(po_id);
														}
													}
												}
											}
											for each  po_id in po_ids
											{
												thisapp.po.update_po_receiving_status(po_id);
											}
										}
						)
					}
				}

			}
