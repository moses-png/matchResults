										// =======================
										else
										{
											if(input.Truck_Movement_Voucher_Status == "In Progress")
											{
												disable Voucher;
												disable Job;
												disable Card;
												disable Work_Done;
												disable Odometer_Start;
												disable Pick_Up_Image;
												show Pick_Up_Section;
