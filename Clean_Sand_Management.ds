			On_Resolve_Issue_Selected as "On Resolve Issue Selected"
			{
				type =  form
				form = Asset_Issues

				record event = on add or edit

				on user input of Resolve_Issue
				{
					actions 
					{
						custom deluge script
						(
											if(input.Resolve_Issue == true)
										{
											input.Issue_Status = "Resolved";
											show Reason_Why_Resolved;
