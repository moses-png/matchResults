											disable Bill_Details_Status;
											disable Last_Synced_Group_Amount;
											disable Previous_Bill;
										}
										// =====================================================
										// 8. STORE BILL DETAILS
										// =====================================================
										else if(input.Stock_Receiving_Details != null)
										{
											show Bill_Details;
