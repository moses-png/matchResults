			On_Batch_Number_From_Sele1 as "On Batch Number From Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Batch_Number_From
				{
					actions 
					{
						custom deluge script
						(
											if(input.Batch_Number_From != null)
										{
											sp = Stock_Production[ID == input.Batch_Number_From];
											if(sp.ID != null)
											{
												input.Site_From = sp.Site;
												input.Display_Name_Site_From = ifnull(sp.Display_Name_Site,"");
												input.Work_Done = ifnull(sp.Materials_Produced,"");
												input.Pick_Up_From = ifnull(input.Display_Name_Site_From,"");
												Deliver_To = ifnull(input.Display_Name_Site_To,"");
											}
										}
										else
										{
											input.Site_From = null;
											input.Display_Name_Site_From = "";
											input.Pick_Up_From = "";
											input.Site_To = null;
											input.Display_Name_Site_To = "";
											Deliver_To = "";
											input.Work_Done = "";
										}
						)
					}
				}

			}
			On_Batch_Number_To_Select1 as "On Batch Number To Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Batch_Number_To
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// TRUCK MOVEMENT VOUCHER
										// ========================================
										if(input.Batch_Number_To != null)
										{
											if(input.Batch_Number_To.Site != null)
											{
												input.Site_To = input.Batch_Number_To.Site;
												input.Display_Name_Site_To = ifnull(input.Batch_Number_To.Display_Name_Site,"");
											}
											else
											{
												input.Site_To = null;
												input.Display_Name_Site_To = "";
											}
										}
										else
										{
											input.Site_To = null;
											input.Display_Name_Site_To = "";
										}
						)
					}
				}

			}
			On_Cancel_Voucher_Selecte3 as "On Cancel Voucher Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Cancel_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_Voucher == true)
										{
											show Reason_Why_Cancelled;
											input.Truck_Movement_Voucher_Status = "Cancelled";
											input.Odometer_End = null;
											input.Time_End = null;
											input.Line_Distance_Travelled = 0;
											input.Line_Duration_Minutes = 0;
											input.Cost_Per_Odometer = 0;
											input.Line_Total = 0;
											disable Odometer_End;
											disable Time_End;
											disable Party_To;
											disable Party_Location_To;
											disable Site_To;
											disable Site_Location_To;
											disable Delivery_To_Image;
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = null;
											input.Truck_Movement_Voucher_Status = "In Progress";
											enable Odometer_End;
											enable Time_End;
											enable Party_To;
											enable Party_Location_To;
											enable Site_To;
											enable Site_Location_To;
											enable Delivery_To_Image;
										}
						)
					}
				}

			}
			On_Card_Selected as "On Card Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Card
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// USER INPUT: SALES VOUCHER
										// =====================================================
										if(input.Card != null)
										{
											salesVoucherNo = ifnull(input.Card.Sales_Voucher_Number,"").trim();
											numberPlate = ifnull(input.Card.Display_Name_Number_Plate,"").trim();
											if(salesVoucherNo != "" && numberPlate != "")
											{
												input.Display_Name_Card = salesVoucherNo + " - " + numberPlate;
												input.Work_Done = "Truck Movement for Sales Voucher " + salesVoucherNo + " - " + numberPlate;
											}
											else if(salesVoucherNo != "")
											{
												input.Display_Name_Card = salesVoucherNo;
												input.Work_Done = "Truck Movement for Sales Voucher " + salesVoucherNo;
											}
											else if(numberPlate != "")
											{
												input.Display_Name_Card = numberPlate;
												input.Work_Done = "Truck Movement for " + numberPlate;
											}
											else
											{
												input.Display_Name_Card = "";
												input.Work_Done = "";
											}
											input.Display_Name_Site_From = ifnull(input.Card.Display_Name_Site,"");
											input.Pick_Up_From = ifnull(input.Card.Display_Name_Site,"");
											if(input.Card.Voucher != null)
											{
												input.Site_From = input.Card.Voucher.Site;
											}
											else
											{
												input.Site_From = null;
											}
											// =====================================================
											// SALES VOUCHER GRAND TOTAL AS MATERIAL COST
											// =====================================================
											input.Material_Cost = ifnull(input.Card.Grand_Total,0.0);
										}
										else
										{
											input.Display_Name_Card = "";
											input.Work_Done = "";
											input.Site_From = null;
											input.Display_Name_Site_From = "";
											input.Site_Location_From = null;
											input.Pick_Up_From = "";
											input.Material_Cost = 0.0;
										}
										// =====================================================
										// CALCULATE LINE TOTAL
										// =====================================================
										input.Line_Total = round(ifnull(input.Material_Cost,0.0) + ifnull(input.Service_Cost,0.0) + ifnull(input.Fuel_Cost,0.0) + ifnull(input.Labour_Cost,0.0),2);
										// =====================================================
										// CALCULATE COST PER ODOMETER
										// =====================================================
										distance_travelled = ifnull(input.Line_Distance_Travelled,0.0);
										if(distance_travelled > 0)
										{
											input.Cost_Per_Odometer = round(input.Line_Total / distance_travelled,2);
										}
										else
										{
											input.Cost_Per_Odometer = 0.0;
										}
						)
					}
				}

			}
			On_Job_Selected1 as "On Job Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Job
				{
					actions 
					{
						custom deluge script
						(
											if(input.Job != null)
										{
											input.Display_Name_Job = input.Job.Job_No + " - " + input.Job.Job_Name;
											jobNo = input.Job.Job_No;
											// ==================================
											// TJS01 - Card Sales
											// ==================================
											if(jobNo == "TJS01")
											{
												show Pick_Up_Section;
												show Card;
												enable Card;
												hide Work_Order_Task;
												input.Work_Order_Task = null;
												hide Batch_Number_From;
												input.Batch_Number_From = null;
												hide Truck_Movement_Voucher;
												input.Truck_Movement_Voucher = null;
												hide Task_Location;
												input.Task_Location = null;
												hide Small_Notes;
												input.Small_Notes = null;
												show Site_From;
												show Site_Location_From;
												disable Site_From;
												enable Site_Location_From;
												show Site_To;
												show Site_Location_To;
												disable Site_To;
												enable Site_Location_To;
												hide Party_From;
												hide Party_Location_From;
												input.Party_From = null;
												input.Party_Location_From = null;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
											}
											// ==================================
											// TJS02 - Service Task
											// ==================================
											else if(jobNo == "TJS02")
											{
												show Pick_Up_Section;
												show Work_Order_Task;
												enable Work_Order_Task;
												show Task_Location;
												enable Task_Location;
												show Small_Notes;
												enable Small_Notes;
												hide Card;
												input.Card = null;
												hide Batch_Number_From;
												input.Batch_Number_From = null;
												hide Truck_Movement_Voucher;
												input.Truck_Movement_Voucher = null;
												show Site_To;
												show Site_Location_To;
												enable Site_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
												if(input.Task_Location == "Company Sites")
												{
													show Site_From;
													show Site_Location_From;
													enable Site_From;
													enable Site_Location_From;
													hide Party_From;
													hide Party_Location_From;
													input.Party_From = null;
													input.Party_Location_From = null;
												}
												else if(input.Task_Location == "Suppliers")
												{
													show Party_From;
													show Party_Location_From;
													enable Party_From;
													enable Party_Location_From;
													hide Site_From;
													hide Site_Location_From;
													input.Site_From = null;
													input.Site_Location_From = null;
												}
												else
												{
													hide Site_From;
													hide Site_Location_From;
													input.Site_From = null;
													input.Site_Location_From = null;
													hide Party_From;
													hide Party_Location_From;
													input.Party_From = null;
													input.Party_Location_From = null;
												}
											}
											// ==================================
											// TJS03 - Stock Production
											// ==================================
											else if(jobNo == "TJS03")
											{
												show Pick_Up_Section;
												show Batch_Number_From;
												hide Card;
												input.Card = null;
												hide Work_Order_Task;
												input.Work_Order_Task = null;
												hide Truck_Movement_Voucher;
												input.Truck_Movement_Voucher = null;
												hide Task_Location;
												input.Task_Location = null;
												hide Small_Notes;
												input.Small_Notes = null;
												show Site_From;
												disable Site_From;
												show Site_Location_From;
												enable Site_Location_From;
												show Site_To;
												disable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_From;
												hide Party_Location_From;
												input.Party_From = null;
												input.Party_Location_From = null;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
											}
											// ==================================
											// TJS04 - Return Truck To Site
											// ==================================
											else if(jobNo == "TJS04")
											{
												show Pick_Up_Section;
												show Truck_Movement_Voucher;
												enable Truck_Movement_Voucher;
												hide Card;
												input.Card = null;
												hide Work_Order_Task;
												input.Work_Order_Task = null;
												hide Batch_Number_From;
												input.Batch_Number_From = null;
												hide Task_Location;
												input.Task_Location = null;
												show Party_From;
												show Party_Location_From;
												disable Party_From;
												enable Party_Location_From;
												hide Site_From;
												hide Site_Location_From;
												input.Site_From = null;
												input.Site_Location_From = null;
												show Site_To;
												show Site_Location_To;
												enable Site_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
											}
										}
										else
										{
											hide Pick_Up_Section;
											hide Batch_Number_From;
											hide Card;
											hide Work_Order_Task;
											hide Truck_Movement_Voucher;
											hide Task_Location;
											hide Small_Notes;
											input.Card = null;
											input.Work_Order_Task = null;
											input.Batch_Number_From = null;
											input.Truck_Movement_Voucher = null;
											input.Task_Location = null;
											input.Small_Notes = null;
											input.Display_Name_Job = null;
											show Site_From;
											show Site_Location_From;
											enable Site_From;
											enable Site_Location_From;
											show Site_To;
											show Site_Location_To;
											enable Site_To;
											enable Site_Location_To;
											show Party_From;
											show Party_Location_From;
											enable Party_From;
											enable Party_Location_From;
											show Party_To;
											show Party_Location_To;
											enable Party_To;
											enable Party_Location_To;
										}
						)
					}
				}

			}
			On_Odometer_End_Selected1 as "On Odometer End Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Odometer_End
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ON ODOMETER END SELECTED
										// =====================================================
										if(input.Odometer_End != null)
										{
											if(input.Odometer_Start == null)
											{
												alert "Please enter Odometer Start first.";
												input.Odometer_End = null;
												input.Line_Distance_Travelled = 0.0;
											}
											else
											{
												distance = input.Odometer_End - input.Odometer_Start;
												if(distance < 0)
												{
													alert "Odometer End cannot be less than Odometer Start.";
													input.Odometer_End = null;
													input.Line_Distance_Travelled = 0.0;
												}
												else
												{
													input.Line_Distance_Travelled = round(distance,2);
												}
											}
										}
										else
										{
											input.Line_Distance_Travelled = 0.0;
										}
										// =====================================================
										// LINE TOTAL
										// =====================================================
										input.Line_Total = round(ifnull(input.Material_Cost,0.0) + ifnull(input.Service_Cost,0.0) + ifnull(input.Fuel_Cost,0.0) + ifnull(input.Labour_Cost,0.0),2);
										// =====================================================
										// COST PER ODOMETER
										// =====================================================
										if(ifnull(input.Line_Distance_Travelled,0.0) > 0)
										{
											input.Cost_Per_Odometer = round(input.Line_Total / input.Line_Distance_Travelled,2);
										}
										else
										{
											input.Cost_Per_Odometer = 0.0;
										}
						)
					}
				}

			}
			On_Odometer_Start_Selecte1 as "On Odometer Start Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Odometer_Start
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ON ODOMETER START SELECTED
										// =====================================================
										// =====================================================
										// 1. CALCULATE DISTANCE TRAVELLED
										// =====================================================
										if(input.Odometer_Start != null)
										{
											if(input.Odometer_End == null)
											{
												input.Line_Distance_Travelled = 0.0;
											}
											else
											{
												distance = input.Odometer_End - input.Odometer_Start;
												if(distance < 0)
												{
													alert "Odometer End cannot be less than Odometer Start.";
													input.Odometer_End = null;
													input.Line_Distance_Travelled = 0.0;
												}
												else
												{
													input.Line_Distance_Travelled = round(distance,2);
												}
											}
										}
										else
										{
											input.Line_Distance_Travelled = 0.0;
										}
										// =====================================================
										// 2. CALCULATE LINE TOTAL
										// =====================================================
										material_cost = ifnull(input.Material_Cost,0.0);
										service_cost = ifnull(input.Service_Cost,0.0);
										fuel_cost = ifnull(input.Fuel_Cost,0.0);
										labour_cost = ifnull(input.Labour_Cost,0.0);
										line_total = material_cost + service_cost + fuel_cost + labour_cost;
										input.Line_Total = round(line_total,2);
										// =====================================================
										// 3. CALCULATE COST PER ODOMETER
										// =====================================================
										distance_travelled = ifnull(input.Line_Distance_Travelled,0.0);
										if(distance_travelled > 0)
										{
											input.Cost_Per_Odometer = round(input.Line_Total / distance_travelled,2);
										}
										else
										{
											input.Cost_Per_Odometer = 0.0;
										}
						)
					}
				}

			}
			Full_Validation_On_Create5 as "Full Validation On Create"
			{
				type =  form
				form = Asset_Issues

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Issue_Number == null || input.Issue_Number.trim() == "")
										{
											doc_key = Document_Key[Voucher_Type == "Issue" && Document_Key_Status == "Active"];
											if(doc_key.ID == null)
											{
												alert "Document Key for Issue is not configured.";
												cancel submit;
											}
											prefix_value = ifnull(doc_key.Prefix,"ZCB-ISSUE");
											next_no = ifnull(doc_key.Next_Number,1);
											if(next_no < 10)
											{
												num_text = "000" + next_no;
											}
											else if(next_no < 100)
											{
												num_text = "00" + next_no;
											}
											else if(next_no < 1000)
											{
												num_text = "0" + next_no;
											}
											else
											{
												num_text = next_no.toString();
											}
											input.Issue_Number = prefix_value + "-" + num_text;
											doc_key.Next_Number=next_no + 1;
										}
										if(isNull(input.Number_Of_Work_Order_Tasks))
										{
											input.Number_Of_Work_Order_Tasks = 0;
										}
										if(isNull(input.Total_Service_Task_Cost))
										{
											input.Total_Service_Task_Cost = 0.0;
										}
										if(input.Asset != null)
										{
											input.Display_Name_Asset = ifnull(input.Asset.Display_Name_Asset_Name,"");
										}
										else
										{
											input.Display_Name_Asset = "";
										}
										// DEFAULTS FIRST
										if(input.Issue_Status == null)
										{
											input.Issue_Status = "Draft";
										}
										if(input.Work_Order_Status == null)
										{
											input.Work_Order_Status = "Draft";
										}
										if(input.Reported_Date == null)
										{
											input.Reported_Date = zoho.currenttime;
										}
										if(input.Asset == null)
										{
											alert "Asset is required.";
											cancel submit;
										}
										if(input.Odometer_Reading == null || input.Odometer_Reading <= 0)
										{
											alert "Odometer Reading is required.";
											cancel submit;
										}
										if(input.Issue == null || input.Issue.trim() == "")
										{
											alert "Issue is required.";
											cancel submit;
										}
										if(input.Issue_Description == null || input.Issue_Description.trim() == "")
										{
											alert "Issue Description is required.";
											cancel submit;
										}
										if(input.Severity == null)
										{
											alert "Severity is required.";
											cancel submit;
										}
										if(input.Issue_Status == null)
										{
											alert "Status is required.";
											cancel submit;
										}
										if(input.Reported_Date == null)
										{
											input.Reported_Date = zoho.currenttime;
										}
										mile_resp = asset_management.validateAssetMileage(input.Asset.ID,input.Odometer_Reading,input.Reported_Date,"Asset Issues",input.ID.toString());
										if(mile_resp.get("ok") != true)
										{
											alert mile_resp.get("message");
											cancel submit;
										}
										input.Odometer_Reading = mile_resp.get("Odometer_Reading");
						)
					}
				}

			}
