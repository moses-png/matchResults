						custom deluge script
						(
											hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										//hide Display_Name_Item_Issuing_Voucher;
										// Lock system-driven fields
										disable Current_Site;
										disable Display_Name_Item_Issuing_Voucher;
										disable Item_Issuing_Date;
										disable Issued_By;
										disable Display_Name_Store;
										disable Item_Issuing_Details.Why;
										disable Item_Issuing_Details.Reason_Why_Didn_t_Come_Back;
										//hide fields
										hide Display_Name_Store;
										hide Display_Name_Item_Issuing_Voucher;
										hide Item_Issuing_Details;
						)
					}
				}

			}
			On_Customer_Selected1 as "On Customer Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											if(input.Customer != null)
										{
											input.Display_Name_Customer = input.Customer.Display_Name_Customer;
											if(input.Customer.Delivery_Note_Required == true)
											{
												show Delivery_Note;
											}
											else
											{
												hide Delivery_Note;
												input.Delivery_Note = null;
											}
										}
										else
										{
											input.Display_Name_Customer = "";
