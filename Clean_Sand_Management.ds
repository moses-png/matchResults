										}
										else if(input.Party_To != null)
										{
											customerName = ifnull(input.Party_To.Customer_Name,"").toString().trim();
											customerCode = ifnull(input.Party_To.Customer_Code,"").toString().trim();
											if(customerName != "" && customerCode != "")
											{
