			Set_Up_Form45 as "Set Up Form"
			{
				type =  form
				form = Vendor_Register

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Vendor_Name;
										hide Vendor;
										hide Vendor_Code;
										hide Display_Name_Vendor;
										hide Payment_Credit_Management;
										hide TIN_Number;
										if(input.Vendor_Type == "Cash")
										{
											show Vendor_Name;
										}
										else if(input.Vendor_Type == "Credit")
										{
											show Vendor;
											show Payment_Credit_Management;
										}
										if(input.Tax_Invoice_Required == true)
										{
											show TIN_Number;
										}
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										hide Back_End;
										disable Total_Purchase_Orders;
										disable Total_Bills;
										disable Total_Payments_Made;
										disable Outstanding_Payables;
										disable Last_Bill_Date;
										disable Last_Payment_Date;
						)
					}
				}

			}
