			Add_Row_PO_Details_ as "Add Row \"PO Details\""
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on add row of PO_Details
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// PURCHASE ORDER — New Row in PO_Details
										// ===============================
										full_name = "";
										site_name = ifnull(input.Site,"").trim();
										po_number = ifnull(input.PO_Number,"").trim();
										if(site_name != "")
										{
											full_name = site_name;
										}
										if(po_number != "")
										{
											if(full_name != "")
											{
												full_name = full_name + " - " + po_number;
											}
											else
											{
												full_name = po_number;
											}
										}
										Display_Name_Purchase_Order = full_name;
										line_no = 0;
										for each  po_det in input.PO_Details
										{
											if(po_det.Item != null)
											{
												line_no = line_no + 1;
												po_det.Purchase_Order_Number=line_no;
												po_det.Display_Name_Purchase_Order=full_name;
												if(po_number != "")
												{
													po_det.Purchase_Order_Details_Number=po_number + " - " + line_no.toString();
												}
												else
												{
													po_det.Purchase_Order_Details_Number=line_no.toString();
												}
											}
											else
											{
												po_det.Purchase_Order_Number=null;
												po_det.Purchase_Order_Details_Number=null;
												po_det.Display_Name_Purchase_Order=full_name;
											}
										}
						)
					}
				}

			}
			Delete_Row_PO_Details_ as "Delete Row \"PO Details\""
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on delete row of PO_Details
				{
					actions 
					{
						custom deluge script
						(
											// PURCHASE ORDER — On Delete Row in PO_Details
										if(row.ID != null)
										{
											delete from Purchase_Order_Details[ID == row.ID];
										}
										full_name = "";
										site_name = ifnull(input.Site,"").trim();
										po_number = ifnull(input.PO_Number,"").trim();
										if(site_name != "")
										{
											full_name = site_name;
										}
										if(po_number != "")
										{
											if(full_name != "")
											{
												full_name = full_name + " - " + po_number;
											}
											else
											{
												full_name = po_number;
											}
										}
										Display_Name_Purchase_Order = full_name;
										line_no = 0;
										po_total = 0.0;
										for each  po_det in input.PO_Details
										{
											if(po_det.Item != null)
											{
												line_no = line_no + 1;
												po_det.Purchase_Order_Number=line_no;
												po_det.Display_Name_Purchase_Order=full_name;
												if(po_number != "")
												{
													po_det.Purchase_Order_Details_Number=po_number + " - " + line_no.toString();
												}
												else
												{
													po_det.Purchase_Order_Details_Number=line_no.toString();
												}
												po_total = po_total + ifnull(po_det.Line_Total,0.0);
											}
											else
											{
												po_det.Purchase_Order_Number=null;
												po_det.Purchase_Order_Details_Number=null;
												po_det.Display_Name_Purchase_Order=full_name;
											}
										}
										input.PO_Total = po_total;
						)
					}
				}

			}
			Full_Validation11 as "Full Validation"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										if(input.PO_Type == null || input.PO_Type.trim() == "")
										{
											errors = errors + "\n• PO Type is required.";
										}
										if(input.Employee_Voucher == null)
										{
											errors = errors + "\n• Employee Voucher is required.";
										}
										if(input.Site == null || input.Site.trim() == "")
										{
											errors = errors + "\n• Site is required.";
										}
										if(input.PO_Date == null)
										{
											errors = errors + "\n• PO Date is required.";
										}
										else if(input.PO_Date > zoho.currentdate)
										{
											errors = errors + "\n• PO Date cannot be in the future.";
										}
										if(input.PO_Details == null || input.PO_Details.count() == 0)
										{
											errors = errors + "\n• At least one Purchase Order Detail row is required.";
										}
										line_no = 0;
										for each  row in input.PO_Details
										{
											line_no = line_no + 1;
											if(row.Item == null)
											{
												errors = errors + "\n• Row " + line_no + ": Item is required.";
											}
											if(row.Quantity_Ordered == null || row.Quantity_Ordered <= 0)
											{
												errors = errors + "\n• Row " + line_no + ": Quantity Ordered must be greater than 0.";
											}
											if(row.Unit_Of_Measure == null)
											{
												errors = errors + "\n• Row " + line_no + ": Unit Of Measure is required.";
											}
											if(row.Unit_Cost == null || row.Unit_Cost < 0)
											{
												errors = errors + "\n• Row " + line_no + ": Unit Cost must be zero or greater.";
											}
										}
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize4 as "Finalize"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ===============================================
										// PURCHASE ORDER – FINALIZE
										// ===============================================
										// ===============================================
										// DISPLAY NAME PURCHASE ORDER
										// ===============================================
										display_name = "";
										if(input.Site != null && input.Site.trim() != "")
										{
											display_name = input.Site.trim();
										}
										if(input.PO_Number != null && input.PO_Number.trim() != "")
										{
											if(display_name != "")
											{
												display_name = display_name + " - " + input.PO_Number.trim();
											}
											else
											{
												display_name = input.PO_Number.trim();
											}
										}
										Display_Name_Purchase_Order = display_name;
										// -----------------------------------------------
										// 3) Build Purchase Order Display Name
										// -----------------------------------------------
										full_name = "";
										site_name = ifnull(input.Site,"").trim();
										po_number = ifnull(input.PO_Number,"").trim();
										if(site_name != "" && po_number != "")
										{
											full_name = site_name + " - " + po_number;
										}
										else if(site_name != "")
										{
											full_name = site_name;
										}
										else
										{
											full_name = po_number;
										}
										Display_Name_Purchase_Order = full_name;
										// -----------------------------------------------
										// 4) Renumber PO Details + refresh display fields
										// -----------------------------------------------
										line_no = 0;
										po_total = 0.0;
										input.PO_Billed_Total = ifnull(input.PO_Billed_Total,0.0);
										input.PO_Total_Paid = ifnull(input.PO_Total_Paid,0.0);
										for each  po_det in input.PO_Details
										{
											if(po_det.Item != null)
											{
												line_no = line_no + 1;
												po_det.Purchase_Order_Number=line_no;
												po_det.Display_Name_Purchase_Order=full_name;
												if(po_number != "")
												{
													po_det.Purchase_Order_Details_Number=po_number + " - " + line_no.toString();
												}
												else
												{
													po_det.Purchase_Order_Details_Number=line_no.toString();
												}
												name_txt = ifnull(po_det.Item.Item_Name,"").trim();
												sku_txt = ifnull(po_det.Item.SKU,"").trim();
												if(sku_txt != "")
												{
													po_det.Display_Name_Item=name_txt + " - " + sku_txt;
												}
												else
												{
													po_det.Display_Name_Item=name_txt;
												}
												if(po_det.Unit_Of_Measure != null)
												{
													po_det.Display_Name_Unit_Of_Measure=po_det.Unit_Of_Measure.Unit_Of_Measure_Name;
												}
												else
												{
													po_det.Display_Name_Unit_Of_Measure="";
												}
												po_total = po_total + ifnull(po_det.Line_Total,0.0);
											}
											else
											{
												po_det.Purchase_Order_Number=null;
												po_det.Purchase_Order_Details_Number="";
												po_det.Display_Name_Purchase_Order=full_name;
												po_det.Display_Name_Item="";
												po_det.Display_Name_Unit_Of_Measure="";
												po_det.Quantity_Received=ifnull(po_det.Quantity_Received,0.0);
												po_det.Quantity_Remaining=ifnull(po_det.Quantity_Remaining,ifnull(po_det.Quantity_Ordered,0.0));
												po_det.Quantity_Billable=ifnull(po_det.Quantity_Billable,0.0);
												po_det.Quantity_Billed=ifnull(po_det.Quantity_Billed,0.0);
												po_det.Quantity_Unbilled=ifnull(po_det.Quantity_Unbilled,ifnull(po_det.Quantity_Billable,0.0));
											}
										}
										input.PO_Total = po_total;
										// -----------------------------------------------
										// CLOSE PURCHASE ORDER
										// -----------------------------------------------
										if(input.Close_Purchase_Order == true)
										{
											if(input.Reason_Why_Closed == null || input.Reason_Why_Closed.trim() == "")
											{
											}
											input.PO_Status = "Closed";
										}
										// -----------------------------------------------
										// 5) Build payload for Store Management sync
										// -----------------------------------------------
										payload = Map();
										payload.put("Source_Record_ID",input.ID);
										payload.put("Source_Form","Clean Sand Management - Purchase Order");
										payload.put("PO_Type","External Purchase");
										payload.put("Employee_Voucher",input.Display_Name_Employee_Voucher);
										payload.put("Site",input.Site);
										payload.put("PO_Number",input.PO_Number);
										payload.put("PO_Date",input.PO_Date);
										payload.put("Receive_Status",input.Receive_Status);
										payload.put("PO_Status",input.PO_Status);
										payload.put("PO_Total",input.PO_Total);
										payload.put("Bill_Status",input.Bill_Status);
										payload.put("PO_Billed_Total",input.PO_Billed_Total);
										payload.put("Payment_Status",input.Payment_Status);
										payload.put("PO_Total_Paid",input.PO_Total_Paid);
										lines = List();
										for each  po_det in input.PO_Details
										{
											if(po_det.Item != null)
											{
												line = Map();
												line.put("Display_Name_Purchase_Order",po_det.Display_Name_Purchase_Order);
												line.put("Purchase_Order_Number",po_det.Purchase_Order_Number);
												line.put("Purchase_Order_Details_Number",po_det.Purchase_Order_Details_Number);
												line.put("Item",po_det.Item);
												line.put("Display_Name_Item",po_det.Display_Name_Item);
												line.put("Stock_Condition",po_det.Stock_Condition);
												line.put("Quantity_Ordered",po_det.Quantity_Ordered);
												line.put("Unit_Of_Measure",po_det.Unit_Of_Measure);
												line.put("Display_Name_Unit_Of_Measure",po_det.Display_Name_Unit_Of_Measure);
												line.put("Unit_Cost",po_det.Unit_Cost);
												line.put("Line_Total",po_det.Line_Total);
												line.put("Quantity_in_Base_Unit_Of_Measure",po_det.Quantity_in_Base_Unit_Of_Measure);
												line.put("Quantity_Received",po_det.Quantity_Received);
												line.put("Quantity_Remaining",po_det.Quantity_Remaining);
												line.put("Receiving_Status",po_det.Receiving_Status);
												line.put("Quantity_Billable",po_det.Quantity_Billable);
												line.put("Quantity_Billed",po_det.Quantity_Billed);
												line.put("Quantity_Unbilled",po_det.Quantity_Unbilled);
												line.put("Billing_Status",po_det.Billing_Status);
												lines.add(line);
											}
										}
										payload.put("Lines",lines);
										// -----------------------------------------------
										// 6) Sync to Store Management
										// -----------------------------------------------
										resp = store_management.po.syncPurchaseOrderFromCleanSand(payload);
										info resp;
						)
					}
				}

			}
			Finalize_On_Delete3 as "Finalize On Delete"
			{
				type =  form
				form = Purchase_Order

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------------------------------------
										// Purchase Order - Finalize On Delete
										// ------------------------------------------------------------
										source_record_id = input.ID.toString();
										source_form = "Clean Sand Management - Purchase Order";
										// ------------------------------------------------------------
										// 1) Delete Purchase Order Details
										// ------------------------------------------------------------
										po_details = Purchase_Order_Details[Purchase_Order == input.ID];
										for each  po_det in po_details
										{
											delete from Purchase_Order_Details[ID == po_det.ID];
										}
										// ------------------------------------------------------------
										// 2) Delete synced Store Purchase Order and Store PO Details
										// ------------------------------------------------------------
										resp = store_management.deletePurchaseOrderFromCleanSand(source_record_id,source_form);
										info resp;
						)
					}
				}

			}
