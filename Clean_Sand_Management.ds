												site_name = ifnull(po.Site,"").trim();
												po_number = ifnull(po.PO_Number,"").trim();
												if(site_name != "")
												{
													full_name = site_name;
												}
												if(po_number != "")
												{
													if(full_name != "")
													{
														full_name = full_name + " - " + po_number;
													}
													else
													{
														full_name = po_number;
													}
												}
												input.Display_Name_Voucher = full_name;
											}
											else
											{
												input.Display_Name_Voucher = null;
											}
											input.Item = null;
											input.Display_Name_Item = null;
											input.Quantity_to_Receive = null;
											input.Display_Name_Unit_Of_Measure_to_Receive = null;
											input.Quantity_Received = null;
											input.Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										}
										else
										{
											input.Display_Name_Voucher = null;
											input.Item = null;
											input.Display_Name_Item = null;
											input.Quantity_to_Receive = null;
											input.Display_Name_Unit_Of_Measure_to_Receive = null;
											input.Quantity_Received = null;
											input.Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										}
						)
					}
				}

			}
			On_Quantity_Received_Sele as "On Quantity Received Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Quantity_Received
				{
					actions 
					{
						custom deluge script
						(
											// ----------------------------------------
										// On Quantity Received
										// ----------------------------------------
										if(input.Unit_Of_Measure_Received == null)
										{
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										if(input.Quantity_Received == null || input.Quantity_Received <= 0)
										{
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										if(input.Receiving_Type == "Internal Transfer")
										{
											to_receive = ifnull(input.Quantity_to_Receive,0.0);
											if(input.Quantity_Received != to_receive)
											{
												alert "For Internal Transfer, Quantity Received must equal Quantity to Receive: " + to_receive;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										else if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return")
										{
											to_receive = ifnull(input.Quantity_to_Receive,0.0);
											if(input.Quantity_Received > to_receive)
											{
												alert "You cannot return more than remaining. Remaining: " + to_receive;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										else if(input.Receiving_Type == "Purchase Order")
										{
											to_receive = ifnull(input.Quantity_to_Receive,0.0);
											if(input.Quantity_Received > to_receive)
											{
												alert "You cannot receive more than remaining. Remaining: " + to_receive;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										item_id = null;
										if(input.Receiving_Type == "Purchase Order")
										{
											if(input.Item != null)
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID != null)
												{
													item_id = po_det.Item;
												}
											}
										}
										else if(input.Receiving_Type == "Internal Transfer")
										{
											if(input.Transfer_Item != null)
											{
												item_id = input.Transfer_Item.Item;
											}
										}
										else if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return")
										{
											if(input.Item_Issuing_Details != null)
											{
												issue_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
												if(issue_rec.ID != null)
												{
													item_id = issue_rec.Item;
												}
											}
										}
										else
										{
											item_id = input.Item;
										}
										if(item_id == null)
										{
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										check = store_management.po.check_uom_conversion_from_masaka_site_management(item_id,input.Unit_Of_Measure_Received);
										if(check == null || check.get("ok") != true)
										{
											alert ifnull(check.get("message"),"UOM conversion failed.");
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										resp = store_management.po.recalculate_po_detail_line_from_masaka_site_management(item_id,input.Unit_Of_Measure_Received,input.Quantity_Received,ifnull(input.Rate,0.0));
										base_qty = ifnull(resp.get("qty_in_base"),0.0);
										if(base_qty <= 0)
										{
											alert "Unable to calculate quantity in base unit.";
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure_Received = base_qty.round(2);
										if(input.Receiving_Type == "Internal Transfer")
										{
											if(input.Rate != null)
											{
												input.Line_Total = input.Quantity_Received * input.Rate;
											}
											else
											{
												input.Line_Total = null;
											}
										}
										else
										{
											input.Line_Total = null;
										}
						)
					}
				}

			}
			On_Rate_Selected as "On Rate Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Rate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Receiving_Type == "Internal Transfer")
										{
											if(input.Rate != null && input.Quantity_Received != null)
											{
												input.Line_Total = input.Rate * input.Quantity_Received;
											}
											else
											{
												input.Line_Total = null;
											}
										}
						)
					}
				}

			}
			On_Receiving_Type_Selecte as "On Receiving Type Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Receiving_Type
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// Stock Receiving Details -> On Receiving Type Selected
										// ========================================
										hide Voucher;
										hide Purchase_Order;
										hide Item;
										hide Item_Issuing_Details;
										hide Internal_Transfer_Number;
										hide Item_Issuing_Details;
										hide Stock_Return_Number;
										hide Tool_Return_Number;
										hide Transfer_Item;
										disable Voucher;
										disable Purchase_Order;
										disable Item;
										disable Item_Issuing_Details;
										disable Internal_Transfer_Number;
										disable Stock_Return_Number;
										disable Tool_Return_Number;
										disable Item_Issuing_Details;
										input.Voucher = null;
										input.Purchase_Order = null;
										input.Stock_Created = null;
										input.Item_Issuing_Details = null;
										input.Item_Issuing_Details = null;
										input.Internal_Transfer_Number = null;
										input.Stock_Return_Number = null;
										input.Tool_Return_Number = null;
										input.Display_Name_Voucher = null;
										input.Display_Name_Item = null;
										input.Display_Name_Receiving_Type = ifnull(input.Receiving_Type,"");
										input.Item = null;
										input.Stock_Condition = null;
										input.Notes = null;
										input.Quantity_to_Receive = null;
										input.Quantity_Received = null;
										input.Unit_Of_Measure_Received = null;
										input.Display_Name_Unit_Of_Measure_to_Receive = null;
										input.Display_Name_Unit_Of_Measure_Received = null;
										input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										input.Line_Total = null;
										input.Rate = null;
										if(input.Receiving_Type == "Purchase Order")
										{
											show Purchase_Order;
											show Item;
											enable Purchase_Order;
											enable Item;
										}
										else if(input.Receiving_Type == "Internal Transfer")
										{
											show Internal_Transfer_Number;
											show Transfer_Item;
											enable Internal_Transfer_Number;
											enable Transfer_Item;
										}
										else if(input.Receiving_Type == "Stock Return")
										{
											show Stock_Return_Number;
											show Item_Issuing_Details;
											enable Stock_Return_Number;
											enable Item_Issuing_Details;
										}
										else if(input.Receiving_Type == "Tool Return")
										{
											show Tool_Return_Number;
											show Item_Issuing_Details;
											enable Tool_Return_Number;
											enable Item_Issuing_Details;
										}
						)
					}
				}

			}
			On_Stock_Receiving_Vouche as "On Stock Receiving Voucher Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Stock_Receiving_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Stock_Receiving_Voucher != null)
										{
											srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
											if(srv.ID != null)
											{
												input.Display_Name_Stock_Receiving_Voucher = srv.Display_Name_Stock_Receiving_Book;
												if(srv.Store != null)
												{
													input.Store = srv.Store.Asset_Name + " - " + srv.Store.Asset_ID;
												}
												else
												{
													input.Store = null;
												}
												input.Display_Name_Received_By = srv.Received_By;
												num_txt = null;
												if(input.Stock_Receiving_Voucher_Number != null && input.Stock_Receiving_Voucher_Number > 0)
												{
													if(input.Stock_Receiving_Voucher_Number < 10)
													{
														num_txt = "0" + input.Stock_Receiving_Voucher_Number.toString();
													}
													else
													{
														num_txt = input.Stock_Receiving_Voucher_Number.toString();
													}
													input.Stock_Receiving_Voucher_and_Number = srv.Display_Name_Stock_Receiving_Book + "-" + num_txt;
												}
												else
												{
													input.Stock_Receiving_Voucher_and_Number = srv.Display_Name_Stock_Receiving_Book;
												}
											}
											else
											{
												input.Display_Name_Stock_Receiving_Voucher = null;
												input.Store = null;
												input.Display_Name_Received_By = null;
												input.Stock_Receiving_Voucher_and_Number = null;
											}
										}
										else
										{
											input.Display_Name_Stock_Receiving_Voucher = null;
											input.Store = null;
											input.Display_Name_Received_By = null;
											input.Stock_Receiving_Voucher_and_Number = null;
										}
						)
					}
				}

			}
			On_Unit_Of_Measure_Receiv as "On Unit Of Measure Received Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Unit_Of_Measure_Received
				{
					actions 
					{
						custom deluge script
						(
											// ----------------------------------------
										// ON UNIT OF MEASURE RECEIVED SELECTED
										// ----------------------------------------
										if(input.Unit_Of_Measure_Received != null)
										{
											input.Display_Name_Unit_Of_Measure_Received = input.Unit_Of_Measure_Received.Unit_Of_Measure_Name;
										}
										else
										{
											input.Display_Name_Unit_Of_Measure_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											input.Line_Total = null;
											return;
										}
										// =====================================================
										// LOAD SOURCE DETAILS
										// =====================================================
										issue_rec = null;
										if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
										}
										// =====================================================
										// INTERNAL TRANSFER UOM VALIDATION
										// =====================================================
										if(input.Receiving_Type == "Internal Transfer")
										{
											if(input.Transfer_Item == null)
											{
												alert "Stock Transfer Item is required.";
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
											transfer_uom_id = input.Transfer_Item.Unit_Of_Measure;
											transfer_display_uom = ifnull(input.Transfer_Item.Display_Name_Unit_of_Measure,"");
											if(transfer_uom_id != null && input.Unit_Of_Measure_Received != transfer_uom_id)
											{
												alert "For Internal Transfer, Unit Of Measure Received must be the same as the transferred Unit Of Measure.";
												input.Unit_Of_Measure_Received = transfer_uom_id;
												input.Display_Name_Unit_Of_Measure_Received = transfer_display_uom;
												input.Display_Name_Unit_Of_Measure_to_Receive = transfer_display_uom;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										// =====================================================
										// STOCK RETURN / TOOL RETURN UOM VALIDATION
										// =====================================================
										else if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return")
										{
											if(issue_rec != null && issue_rec.ID != null && issue_rec.Unit_Of_Measure != null && input.Unit_Of_Measure_Received != issue_rec.Unit_Of_Measure)
											{
												alert "For " + input.Receiving_Type + ", Unit Of Measure Received must be the same as the issued Unit Of Measure.";
												input.Unit_Of_Measure_Received = issue_rec.Unit_Of_Measure;
												input.Display_Name_Unit_Of_Measure_Received = issue_rec.Unit_Of_Measure.Unit_Of_Measure_Name;
												input.Display_Name_Unit_Of_Measure_to_Receive = issue_rec.Unit_Of_Measure.Unit_Of_Measure_Name;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										// =====================================================
										// GET ACTUAL ITEM ID
										// =====================================================
										item_id = null;
										// -----------------------------------------------------
										// PURCHASE ORDER
										// -----------------------------------------------------
										if(input.Receiving_Type == "Purchase Order")
										{
											if(input.Item != null)
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID != null && po_det.Item != null)
												{
													item_id = po_det.Item;
												}
											}
										}
										// -----------------------------------------------------
										// INTERNAL TRANSFER
										// -----------------------------------------------------
										else if(input.Receiving_Type == "Internal Transfer")
										{
											if(input.Transfer_Item != null && input.Transfer_Item.Item != null)
											{
												item_id = input.Transfer_Item.Item;
											}
										}
										// -----------------------------------------------------
										// STOCK RETURN / TOOL RETURN
										// -----------------------------------------------------
										else if(input.Receiving_Type == "Stock Return" || input.Receiving_Type == "Tool Return")
										{
											if(issue_rec != null && issue_rec.ID != null && issue_rec.Item != null)
											{
												item_id = issue_rec.Item;
											}
										}
										// -----------------------------------------------------
										// OTHER RECEIVING TYPES
										// -----------------------------------------------------
										else
										{
											if(input.Item != null)
											{
												item_id = input.Item;
											}
										}
										// =====================================================
										// CONVERT RECEIVED QUANTITY TO BASE UOM
										// =====================================================
										if(item_id != null && input.Unit_Of_Measure_Received != null && input.Quantity_Received != null && input.Quantity_Received > 0)
										{
											check = store_management.po.check_uom_conversion_from_masaka_site_management(item_id,input.Unit_Of_Measure_Received);
											if(check != null && check.get("ok") == true)
											{
												recalc_resp = store_management.po.recalculate_po_detail_line_from_masaka_site_management(item_id,input.Unit_Of_Measure_Received,input.Quantity_Received,ifnull(input.Rate,0.0));
												if(recalc_resp != null)
												{
													base_qty = ifnull(recalc_resp.get("qty_in_base"),0.0);
													if(base_qty > 0)
													{
														input.Quantity_in_Base_Unit_Of_Measure_Received = base_qty.round(2);
													}
													else
													{
														input.Quantity_in_Base_Unit_Of_Measure_Received = null;
													}
												}
												else
												{
													alert "No response was returned while converting the received quantity.";
													input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												}
											}
											else
											{
												error_message = "UOM conversion failed.";
												if(check != null)
												{
													error_message = ifnull(check.get("message"),error_message);
												}
												alert error_message;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											}
										}
										else
										{
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										}
										// =====================================================
										// INTERNAL TRANSFER QUANTITY SAFETY
										// =====================================================
										if(input.Receiving_Type == "Internal Transfer" && input.Transfer_Item != null && input.Quantity_Received != null && input.Quantity_Received > 0)
										{
											quantity_sent = ifnull(input.Transfer_Item.Quantity,0.0);
											quantity_already_received = ifnull(input.Transfer_Item.Quantity_Received,0.0);
											quantity_remaining = quantity_sent - quantity_already_received;
											if(quantity_remaining < 0)
											{
												quantity_remaining = 0.0;
											}
											if(input.Quantity_Received > quantity_remaining)
											{
												alert "Quantity Received cannot exceed the remaining transferred quantity of " + quantity_remaining + ".";
												input.Quantity_Received = null;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
												input.Line_Total = null;
												return;
											}
										}
										// =====================================================
										// LINE TOTAL
										// =====================================================
										if(input.Quantity_Received != null && input.Quantity_Received > 0 && input.Rate != null && input.Rate >= 0)
										{
											input.Line_Total = (input.Quantity_Received * input.Rate).round(2);
										}
										else
										{
											input.Line_Total = null;
										}
						)
					}
				}

			}
			On_Voucher_Selected as "On Voucher Selected"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Voucher != null)
										{
											input.Display_Name_Voucher = ifnull(input.Voucher.Voucher_Number,"") + " - " + ifnull(input.Voucher.Display_Name_Employee,"");
											if(input.Receiving_Type == "Stock Bundling Note")
											{
												// Clear detail fields so user selects the exact Stock_Created row
												input.Stock_Created = null;
												Display_Name_Stock_Created = null;
												input.Item = null;
												input.Display_Name_Item = null;
												input.Quantity_to_Receive = null;
												input.Quantity_Received = null;
												input.Unit_Of_Measure_Received = null;
												input.Display_Name_Unit_Of_Measure_Received = null;
												input.Quantity_in_Base_Unit_Of_Measure_Received = null;
											}
										}
										else
										{
											input.Display_Name_Voucher = null;
											input.Stock_Created = null;
											Display_Name_Stock_Created = null;
											input.Item = null;
											input.Display_Name_Item = null;
											input.Quantity_to_Receive = null;
											input.Quantity_Received = null;
											input.Unit_Of_Measure_Received = null;
											input.Display_Name_Unit_Of_Measure_Received = null;
											input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										}
						)
					}
				}

			}
			Finalize_On_Create17 as "Finalize On Create"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// STOCK RECEIVING DETAILS - FINALIZE
										// ======================================================
										// 1) AUDIT
										u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
										// 2) RESOLVE RECEIVING HEADER / STORE
										srv_found = false;
										store_id = null;
										srv_name = "";
										srv_store_display = "";
										srv_received_by = "";
										for each  srv in Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher]
										{
											srv_found = true;
											store_id = srv.Store;
											srv_name = ifnull(srv.Display_Name_Stock_Receiving_Book,"").trim();
											srv_store_display = ifnull(srv.Display_Name_Store,"");
											srv_received_by = ifnull(srv.Received_By,"");
											break;
										}
										if(srv_found == false || store_id == null)
										{
											return;
										}
										// 3) BUILD RECEIVING VOUCHER NUMBER
										num_txt = "";
										if(input.Stock_Receiving_Voucher_Number != null && input.Stock_Receiving_Voucher_Number > 0)
										{
											if(input.Stock_Receiving_Voucher_Number < 10)
											{
												num_txt = "0" + input.Stock_Receiving_Voucher_Number.toString();
											}
											else
											{
												num_txt = input.Stock_Receiving_Voucher_Number.toString();
											}
										}
										if(srv_name != "" && num_txt != "")
										{
											input.Stock_Receiving_Voucher_and_Number = srv_name + "-" + num_txt;
										}
										else if(srv_name != "")
										{
											input.Stock_Receiving_Voucher_and_Number = srv_name;
										}
										else
										{
											input.Stock_Receiving_Voucher_and_Number = null;
										}
										ref_no = ifnull(input.Stock_Receiving_Voucher_and_Number,"").trim();
										if(ref_no == "")
										{
											ref_no = input.ID.toString();
										}
										// 4) REFRESH DISPLAY FIELDS
										input.Display_Name_Stock_Receiving_Voucher = srv_name;
										input.Store = srv_store_display;
										input.Display_Name_Received_By = srv_received_by;
										// 5) COMMON VALUES
										rtype = ifnull(input.Receiving_Type,"").trim();
										qty = ifnull(input.Quantity_Received,0.0);
										uom_id = input.Unit_Of_Measure_Received;
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
										}
										if(qty <= 0 || uom_id == null)
										{
											return;
										}
										// =====================================================
										// 6) RESOLVE ACTUAL ITEM + COST SOURCE
										// =====================================================
										actual_item_id = null;
										po_detail_id = null;
										po_unit_cost = 0.0;
										base_uom_name = "";
										// -----------------------------------------------------
										// PURCHASE ORDER
										// -----------------------------------------------------
										if(rtype == "Purchase Order" && input.Item != null)
										{
											po_det = Purchase_Order_Details[ID == input.Item];
											if(po_det.ID != null && po_det.Item != null)
											{
												po_detail_id = po_det.ID;
												actual_item_id = po_det.Item;
												po_unit_cost = ifnull(po_det.Unit_Cost,0.0);
												base_uom_name = ifnull(po_det.Display_Name_Unit_Of_Measure,"");
											}
										}
										// -----------------------------------------------------
										// INTERNAL TRANSFER
										// -----------------------------------------------------
										else if(rtype == "Internal Transfer" && input.Transfer_Item != null)
										{
											transfer_id_val = input.Transfer_Item.ID;
											if(transfer_id_val == null || transfer_id_val <= 0)
											{
												info "Stock Transfer ID is invalid.";
												return;
											}
											if(input.Transfer_Item.Item != null)
											{
												actual_item_id = input.Transfer_Item.Item;
											}
											else
											{
												info "The selected Stock Transfer record has no Item.";
												return;
											}
											receive_payload = Map();
											receive_payload.put("Transfer_ID",transfer_id_val);
											receive_payload.put("Receiving_Number",ifnull(input.Stock_Receiving_Voucher_and_Number,""));
											receive_payload.put("Receive_Date",zoho.currentdate);
											receive_payload.put("Receiving_Store",input.Store);
											receive_payload.put("Quantity_Received",qty);
											receive_payload.put("Unit_Of_Measure_Received",uom_id);
											receive_payload.put("Quantity_Received_in_Base_Unit_Of_Measure",ifnull(input.Quantity_in_Base_Unit_Of_Measure_Received,0.0));
											receive_payload.put("Received_By",ifnull(srv_received_by,""));
											receive_payload.put("Receive_Application","Masaka Site Management");
											receive_payload.put("Receive_Source_Form","Stock Receiving Details");
											receive_payload.put("Receive_Source_Record_ID",input.ID);
											receive_resp = store_management.stock_transfer.update_transfer_receiving_details(receive_payload);
											info receive_resp;
											if(receive_resp == null || receive_resp.get("ok") != true)
											{
												error_message = "Stock Transfer receiving synchronization failed.";
												if(receive_resp != null)
												{
													error_message = ifnull(receive_resp.get("message"),error_message);
												}
												info error_message;
												return;
											}
											if(receive_resp.get("base_quantity_received") != null)
											{
												input.Quantity_in_Base_Unit_Of_Measure_Received = receive_resp.get("base_quantity_received").toDecimal();
											}
											if(receive_resp.get("unit_cost_base") != null)
											{
												po_unit_cost = receive_resp.get("unit_cost_base").toDecimal();
											}
											else if(input.Transfer_Item.Unit_Cost != null)
											{
												po_unit_cost = ifnull(input.Transfer_Item.Unit_Cost,0.0);
											}
											else
											{
												po_unit_cost = ifnull(input.Rate,0.0);
											}
										}
										// -----------------------------------------------------
										// STOCK RETURN / TOOL RETURN
										// -----------------------------------------------------
										else if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_item_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_item_rec.ID != null)
											{
												actual_item_id = issue_item_rec.Item;
											}
										}
										// -----------------------------------------------------
										// FINAL ITEM CHECK
										// -----------------------------------------------------
										if(actual_item_id == null)
										{
											info "Actual item could not be resolved for receiving type: " + rtype;
											return;
										}
										// 7) RESOLVE COST
										cost_for_store_default = 0.0;
										if(rtype == "Purchase Order")
										{
											cost_for_store_default = po_unit_cost;
										}
										else if(rtype == "Internal Transfer")
										{
											cost_for_store_default = ifnull(input.Rate,0.0);
										}
										else if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_cost_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_cost_rec.ID != null)
											{
												cost_for_store_default = ifnull(issue_cost_rec.Cost,0.0);
											}
										}
										else
										{
											cost_for_store_default = ifnull(input.Rate,0.0);
										}
										input.Rate = cost_for_store_default;
										input.Line_Total = (qty * cost_for_store_default).round(2);
										resp = store_management.stock.receive_stock_from_masaka_site_management(actual_item_id,store_id,srv_store_display,qty,uom_id,cond,cost_for_store_default,ref_no,input.ID);
										info resp;
										if(resp == null || resp.get("ok") != true)
										{
											if(resp != null)
											{
												info resp.get("message");
											}
											input.Stock_Receiving_Details_Status = "Draft";
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure_Received = ifnull(resp.get("base_qty"),0.0);
										input.Stock_Receiving_Details_Status = "Received";
										// 8b) CREATE BILL DETAILS FOR PURCHASE ORDERS
										if(rtype == "Purchase Order" && cond != "Used")
										{
											details_date_val = zoho.currentdate;
											details_val = "";
											if(input.Display_Name_Voucher != null && input.Display_Name_Voucher != "")
											{
												details_val = "Purchase Order: " + input.Display_Name_Voucher;
											}
											if(srv_store_display != null && srv_store_display != "")
											{
												if(details_val != "")
												{
													details_val = details_val + "\n";
												}
												details_val = details_val + "Store: " + srv_store_display;
											}
											if(input.Display_Name_Received_By != null && input.Display_Name_Received_By != "")
											{
												if(details_val != "")
												{
													details_val = details_val + "\n";
												}
												details_val = details_val + "Received By: " + input.Display_Name_Received_By;
											}
											if(input.Receiving_Type != null && input.Receiving_Type != "")
											{
												if(details_val != "")
												{
													details_val = details_val + "\n";
												}
												details_val = details_val + "Receiving Type: " + input.Receiving_Type;
											}
											bd_exists = false;
											for each  bd_chk in Bill_Details[Stock_Receiving_Details == input.ID]
											{
												bd_exists = true;
												break;
											}
											if(bd_exists == false)
											{
												insert into Bill_Details
												[
													Stock_Receiving_Details=input.ID
													Item=input.Item
													Display_Name_Item=input.Display_Name_Item
													Details_Date=details_date_val
													Details=details_val
													Quantity=input.Quantity_Received
													Unit_Of_Measure=input.Unit_Of_Measure_Received
													Display_Name_Unit_Of_Measure=input.Display_Name_Unit_Of_Measure_Received
													Quantity_Billable=input.Quantity_Received
													Base_Unit_Of_Measure=base_uom_name
													Quantity_In_Base_Unit=input.Quantity_in_Base_Unit_Of_Measure_Received
													Account=srv_store_display
													Current_Site=srv_store_display
													Reference=input.Stock_Receiving_Voucher_and_Number
													Source_Record_ID=input.ID
													Source_Form="Stock Receiving Details"
													Bill_Details_Status="Draft"
													Created_By_Name=u.get("name")
													Created_By_Email=u.get("email")
													Created_By_Time=zoho.currenttime
													Added_User=zoho.loginuser
												]
											}
										}
										// 9) UPDATE CONCRETE PO DETAIL + HEADER
										if(rtype == "Purchase Order" && po_detail_id != null)
										{
											po_det_status = Purchase_Order_Details[ID == po_detail_id];
											if(po_det_status.ID != null)
											{
												old_received = ifnull(po_det_status.Quantity_Received,0.0);
												new_received = old_received + ifnull(input.Quantity_Received,0.0);
												po_det_status.Quantity_Received=new_received;
												po_det_status.Quantity_Remaining=ifnull(po_det_status.Quantity_Ordered,0.0) - new_received;
												if(po_det_status.Quantity_Remaining < 0)
												{
													po_det_status.Quantity_Remaining=0.0;
												}
												if(new_received <= 0)
												{
													po_det_status.Receiving_Status="Not Received";
												}
												else if(new_received >= ifnull(po_det_status.Quantity_Ordered,0.0))
												{
													po_det_status.Receiving_Status="Fully Received";
												}
												else
												{
													po_det_status.Receiving_Status="Partially Received";
												}
												po_det_status.Quantity_Billable=new_received;
												po_det_status.Quantity_Unbilled=new_received - ifnull(po_det_status.Quantity_Billed,0.0);
												if(po_det_status.Quantity_Unbilled < 0)
												{
													po_det_status.Quantity_Unbilled=0.0;
												}
												if(po_det_status.Purchase_Order != null)
												{
													thisapp.po.update_po_receiving_status(po_det_status.Purchase_Order);
													po_rec_status = Purchase_Order[ID == po_det_status.Purchase_Order];
													if(po_rec_status.ID != null)
													{
														employee_voucher_text = ifnull(po_rec_status.Display_Name_Employee_Voucher,"").trim();
														store_resp = store_management.po.receive_po_detail_from_masaka_site_management(po_rec_status.PO_Number,po_rec_status.PO_Date,po_rec_status.Display_Name_Employee_Voucher,po_det_status.Purchase_Order_Details_Number,input.Quantity_Received,ifnull(po_det_status.Unit_Cost,0.0));
														info store_resp;
													}
												}
											}
										}
										// =====================================================
										// CREATE EMPLOYEE RECEIVING DETAILS
										// =====================================================
										if(rtype == "Stock Return" || rtype == "Tool Return" || rtype == "Stock Receiving Note" || rtype == "Stock Bundling Note")
										{
											erd_exists = Employee_Receiving_Details[Source_Record_ID == input.ID && Source_Form == "Stock Receiving Details"];
											if(erd_exists.ID == null)
											{
												recv_voucher = null;
												recv_voucher_display = "";
												line_no = ifnull(input.Stock_Receiving_Voucher_Number,0);
												item_display = ifnull(input.Display_Name_Item,"");
												item_issuing_detail_txt = "";
												if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
												{
													issue_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
													if(issue_rec.ID != null)
													{
														line_no = ifnull(issue_rec.Line_Number,line_no);
														item_display = ifnull(issue_rec.Display_Name_Item,item_display);
														item_issuing_detail_txt = ifnull(issue_rec.Item_Issuing_Number,"");
														if(issue_rec.Employee_Voucher != null)
														{
															recv_voucher = issue_rec.Employee_Voucher;
															recv_voucher_display = ifnull(issue_rec.Employee_Voucher.Voucher_Number,"");
														}
														else if(input.Voucher != null)
														{
															recv_voucher = input.Voucher;
															recv_voucher_display = ifnull(input.Display_Name_Voucher,"");
														}
													}
												}
												else if(rtype == "Stock Receiving Note" || rtype == "Stock Bundling Note" && input.Voucher != null)
												{
													recv_voucher = input.Voucher;
													recv_voucher_display = ifnull(input.Display_Name_Voucher,"");
												}
												if(recv_voucher != null)
												{
													insert into Employee_Receiving_Details
													[
														Voucher=recv_voucher
														Display_Name_Voucher=recv_voucher_display
														Line_Number=line_no
														Display_Name_Item=item_display
														Quantity=input.Quantity_Received
														Stock_Receiving_Detail=ifnull(input.Stock_Receiving_Voucher_and_Number,"")
														Source_Record_ID=input.ID.toString()
														Source_Form="Stock Receiving Details"
														Added_User=zoho.loginuser
													]
												}
											}
										}
										// =====================================================
										// CREATE / UPDATE VOUCHER RECEIVING DETAILS
										// =====================================================
										source_form_val = "Stock Receiving Details";
										voucher_recv_id = null;
										voucher_recv_display = "";
										voucher_line_no = ifnull(input.Stock_Receiving_Voucher_Number,0);
										voucher_item_display = ifnull(input.Display_Name_Item,"");
										if(input.Stock_Receiving_Voucher != null)
										{
											srv_rec = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
											if(srv_rec.ID != null && srv_rec.Stock_Receiving_Book != null)
											{
												voucher_recv_id = srv_rec.Stock_Receiving_Book;
												voucher_recv_display = ifnull(srv_rec.Display_Name_Stock_Receiving_Book,"");
											}
										}
										if(voucher_recv_id != null)
										{
											existing_vrd = Voucher_Receiving_Details[Source_Record_ID == input.ID && Source_Form == source_form_val];
											if(existing_vrd.ID != null)
											{
												existing_vrd.Voucher=voucher_recv_id;
												existing_vrd.Display_Name_Voucher=voucher_recv_display;
												existing_vrd.Line_Number=voucher_line_no;
												existing_vrd.Display_Name_Item=voucher_item_display;
												existing_vrd.Quantity_Received=input.Quantity_Received;
												existing_vrd.Source_Record_ID=input.ID;
												existing_vrd.Source_Form=source_form_val;
											}
											else
											{
												insert into Voucher_Receiving_Details
												[
													Voucher=voucher_recv_id
													Display_Name_Voucher=voucher_recv_display
													Line_Number=voucher_line_no
													Display_Name_Item=voucher_item_display
													Quantity_Received=input.Quantity_Received
													Source_Record_ID=input.ID
													Source_Form=source_form_val
													Added_User=zoho.loginuser
												]
											}
										}
						)
					}
				}

			}
			On_Cancel_This_Line_Item_ as "On Cancel This Line Item Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Cancel_This_Line_Item
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_This_Line_Item == true)
										{
											show Reason_Why_Cancelled;
											input.Status = "Cancelled";
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = "";
										}
						)
					}
				}

			}
			On_Didn_t_Come_Back_Selec as "On Didn't Come Back Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Didn_t_Come_Back
				{
					actions 
					{
						custom deluge script
						(
											hide Why;
										hide Reason_Why_Didn_t_Come_Back;
										if(input.Didn_t_Come_Back == true)
										{
											show Why;
											show Reason_Why_Didn_t_Come_Back;
										}
										else
										{
											input.Why = null;
											input.Reason_Why_Didn_t_Come_Back = null;
										}
						)
					}
				}

			}
			On_Employee_Voucher_Selec1 as "On Employee Voucher Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Employee_Voucher
