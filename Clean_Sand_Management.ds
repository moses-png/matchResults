			On_Effective_To_Selected as "On Effective To Selected"
			{
				type =  form
				form = Product_Price_Register

				record event = on add or edit

				on user input of Effective_To
				{
					actions 
					{
						custom deluge script
						(
											if(input.Effective_To != null)
										{
											if(input.Effective_From != null && input.Effective_To < input.Effective_From)
											{
												alert "Effective To cannot be earlier than Effective From.";
												input.Effective_To = null;
												return;
											}
											if(input.Effective_To < zoho.currentdate)
											{
												input.Status = "Inactive";
											}
											else
											{
												input.Status = "Active";
											}
										}
						)
					}
				}

			}
