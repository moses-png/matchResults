			Set_Up_Form7 as "Set Up Form"
			{
				type =  form
				form = Machine_Start_Of_Day

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Machine Start of Day -> On Load (Set Up Form)
										// -------------------------
										// 1) HIDE BACK-END FIELDS
										// -------------------------
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										hide Display_Name_Site;
										hide Display_Name_Asset_Type;
										hide Display_Name_Asset;
										//hide Time_Started;
										hide End_Work;
										//hide Time_Ended;
										hide Voucher_Status;
										hide Truck_Movement_Voucher;
										hide Back_End;
										hide User_Name;
										hide User_Email;
										hide User_Role;
										hide Created_By_Name;
										hide Created_By_Email;
										hide Created_By_Time;
										hide Updated_By_Name;
										hide Updated_By_Email;
										hide Updated_By_Time;
										// -------------------------
										// 2) DISABLE FIELDS (always)
										// -------------------------
										disable Display_Name_Voucher;
										disable Display_Name_Employee;
										disable Display_Name_Voucher_Type;
										disable Display_Name_Site;
										disable Display_Name_Asset_Type;
										//disable Time_Started;
										//disable Time_Ended;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// -------------------------
										// 3) CREATE vs EDIT BEHAVIOR
										// -------------------------
										is_create = input.ID == null;
										// ---------- ON CREATE ----------
										if(is_create)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											if(input.User_Role == "Tractor Operator")
											{
												input.Display_Name_Voucher_Type = "Tractor Work Report";
											}
											else if(input.User_Role == "Truck Operator")
											{
												input.Display_Name_Voucher_Type = "Truck Movement Voucher";
											}
											else if(input.User_Role == "Drager Operator")
											{
												input.Display_Name_Voucher_Type = "Drager Work Report";
											}
											else
											{
												input.Display_Name_Voucher_Type = null;
											}
											show Voucher;
											show Asset;
											show Odometer_Start;
											show Odometer_Start_Image;
											hide Odometer_End;
											hide Odometer_End_Image;
											show Voucher_Status;
											disable Voucher_Status;
										}
										else
										{
											show Voucher;
											show Odometer_Start;
											show Odometer_Start_Image;
											show Odometer_End;
											show Odometer_End_Image;
											show Voucher_Status;
											if(input.Voucher_Status == "Open" || input.Voucher_Status == null)
											{
												disable Voucher;
												disable Asset;
												disable Odometer_Start;
												disable Odometer_Start_Image;
												disable Fuel_Start_Level;
												show End_Work;
												show Odometer_End;
												show Odometer_End_Image;
												enable Odometer_End;
												enable Odometer_End_Image;
												disable Voucher_Status;
											}
											else
											{
												disable Voucher;
												disable Asset;
												disable Odometer_Start;
												disable Odometer_Start_Image;
												disable Odometer_End;
												disable Odometer_End_Image;
												disable Voucher_Status;
											}
										}
						)
					}
				}

			}
			On_Voucher_Selected4 as "On Voucher Selected"
			{
				type =  form
				form = Machine_Start_Of_Day

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											// Machine Start of Day -> On Voucher Selected
										if(input.Voucher == null)
										{
											input.Display_Name_Voucher = null;
											input.Display_Name_Voucher_Type = null;
											input.Display_Name_Site = null;
											input.Display_Name_Asset_Type = null;
											input.Display_Name_Employee = null;
											return;
										}
										voucher_rec = Voucher_Register[ID == input.Voucher];
										if(voucher_rec.ID == null)
										{
											input.Display_Name_Voucher = null;
											input.Display_Name_Voucher_Type = null;
											input.Display_Name_Site = null;
											input.Display_Name_Asset_Type = null;
											input.Display_Name_Employee = null;
											return;
										}
										input.Display_Name_Voucher = ifnull(voucher_rec.Voucher_Number,"");
										input.Display_Name_Voucher_Type = ifnull(voucher_rec.Display_Name_Voucher_Type,"");
										input.Display_Name_Site = ifnull(voucher_rec.Display_Name_Site,"");
										if(voucher_rec.Display_Name_Employee != null)
										{
											input.Display_Name_Employee = voucher_rec.Display_Name_Employee;
										}
										else
										{
											input.Display_Name_Employee = "";
										}
										vType = ifnull(voucher_rec.Display_Name_Voucher_Type,"");
										if(vType == "Tractor Work Report")
										{
											input.Display_Name_Asset_Type = "Tractors";
										}
										else if(vType == "Truck Movement Voucher")
										{
											input.Display_Name_Asset_Type = "Trucks";
										}
										else if(vType == "Drager Work Report")
										{
											input.Display_Name_Asset_Type = "Dragers";
										}
										else
										{
											input.Display_Name_Asset_Type = null;
										}
						)
					}
				}

			}
			Full_Validation12 as "Full Validation"
			{
				type =  form
				form = Machine_Start_Of_Day

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											is_create = input.ID == null;
										errors = "";
										if(input.Voucher != null)
										{
											existing = Machine_Start_Of_Day[Voucher == input.Voucher && ID != input.ID];
											if(existing.count() > 0)
											{
												errors = errors + "\n• A Machine Start of Day record already exists for this Voucher.";
											}
										}
										if(is_create)
										{
											if(input.Voucher == null)
											{
												errors = errors + "\n• Voucher is required.";
											}
											if(input.Asset == null)
											{
												errors = errors + "\n• Asset is required.";
											}
											if(input.Odometer_Start == null)
											{
												errors = errors + "\n• Odometer Start is required.";
											}
											if(input.Odometer_Start_Image == null || input.Odometer_Start_Image.isEmpty())
											{
												errors = errors + "\n• Odometer Start Image is required.";
											}
										}
										else
										{
											if(input.Odometer_End == null)
											{
												errors = errors + "\n• Odometer End is required.";
											}
											if(input.Odometer_End_Image == null || input.Odometer_End_Image.isEmpty())
											{
												errors = errors + "\n• Odometer End Image is required.";
											}
											if(input.Odometer_Start != null && input.Odometer_End != null)
											{
												if(input.Odometer_End < input.Odometer_Start)
												{
													errors = errors + "\n• Odometer End cannot be less than Odometer Start.";
												}
											}
										}
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize8 as "Finalize"
			{
				type =  form
				form = Machine_Start_Of_Day

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// MACHINE START OF DAY -> FINALIZE / ON SUBMIT
										// =====================================================
										now_ts = zoho.currenttime;
										is_create = false;
										if(input.Added_Time != null && input.Modified_Time != null)
										{
											if(input.Added_Time.toLong() == input.Modified_Time.toLong())
											{
												is_create = true;
											}
										}
										v = null;
										if(input.Voucher != null)
										{
											v = Voucher_Register[ID == input.Voucher.ID];
										}
										// =====================================================
										// ON CREATE
										// =====================================================
										if(is_create)
										{
											if(input.Time_Started == null)
											{
												input.Time_Started = now_ts;
											}
											if(isNull(input.Voucher_Status) || input.Voucher_Status == "")
											{
												input.Voucher_Status = "Open";
											}
											if(v != null)
											{
												if(input.Asset != null)
												{
													v.Asset=input.Asset.ID;
												}
												if(input.Odometer_Start != null)
												{
													v.Odometer_Start=input.Odometer_Start;
												}
												if(input.Fuel_Start_Level != null)
												{
													v.Fuel_Start_Level=input.Fuel_Start_Level;
												}
												if(input.Time_Started != null)
												{
													v.Start_Time=input.Time_Started;
												}
												v.Machine_Start_Of_Day=input.ID;
											}
										}
										// =====================================================
										// ON EDIT
										// =====================================================
										else
										{
											if(v != null)
											{
												if(input.Asset != null)
												{
													v.Asset=input.Asset.ID;
												}
												if(input.Odometer_Start != null)
												{
													v.Odometer_Start=input.Odometer_Start;
												}
												if(input.Fuel_Start_Level != null)
												{
													v.Fuel_Start_Level=input.Fuel_Start_Level;
												}
												if(input.Time_Started != null)
												{
													v.Start_Time=input.Time_Started;
												}
											}
											if(input.Odometer_End != null)
											{
												if(input.Time_Ended == null)
												{
													input.Time_Ended = now_ts;
												}
												input.Voucher_Status = "Closed";
												if(v != null)
												{
													v.Odometer_End=input.Odometer_End;
													if(input.Fuel_End_Level != null)
													{
														v.Fuel_End_Level=input.Fuel_End_Level;
													}
													v.End_Time=input.Time_Ended;
												}
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete16 as "Finalize On Delete"
			{
				type =  form
				form = Machine_Start_Of_Day

				record event = on delete

				on success
				{
