			On_Bill_Type_Selected as "On Bill Type Selected"
			{
				type =  form
				form = Bill

				record event = on add or edit

				on user input of Bill_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Bill_Type == "Store Bill")
										{
											show Vendor;
											hide Employee_Vendor;
											hide Sales_Voucher;
											hide Customer;
											hide Invoice;
											hide Display_Name_Vendor;
											input.Employee_Vendor = null;
											input.Sales_Voucher = null;
											input.Customer = null;
											input.Invoice = null;
											input.Display_Name_Vendor = "";
										}
										else if(input.Bill_Type == "Employee Bill")
										{
											hide Vendor;
											show Employee_Vendor;
											hide Sales_Voucher;
											hide Customer;
											hide Invoice;
											hide Display_Name_Vendor;
											input.Vendor = null;
											input.Customer = null;
											input.Invoice = null;
											input.Sales_Voucher = null;
										}
										else if(input.Bill_Type == "Invoice Bill")
										{
											show Invoice;
											hide Employee_Vendor;
											show Vendor;
											hide Sales_Voucher;
											hide Display_Name_Vendor;
											input.Vendor = null;
											input.Employee_Vendor = null;
											input.Display_Name_Vendor = "";
										}
										else if(input.Bill_Type == "Sales Voucher Bill")
										{
											show Customer;
											hide Employee_Vendor;
											hide Vendor;
											hide Invoice;
											show Sales_Voucher;
											hide Display_Name_Vendor;
											input.Vendor = null;
											input.Invoice = null;
											input.Employee_Vendor = null;
											input.Display_Name_Vendor = "";
										}
										else
										{
											hide Vendor;
											hide Employee_Vendor;
											hide Sales_Voucher;
											hide Customer;
											hide Invoice;
											hide Display_Name_Vendor;
										}
						)
					}
				}

			}
