			Set_Up_Form38 as "Set Up Form"
			{
				type =  form
				form = Customer_Deposit_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
