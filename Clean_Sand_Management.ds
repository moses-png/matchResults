										hide Truck_Movement_Details.Party_Location_To;
										hide Truck_Movement_Details.Site_To;
										hide Truck_Movement_Details.Display_Name_Site_To;
										hide Truck_Movement_Details.Site_Location_To;
										hide Truck_Movement_Details.Reason_Why_Cancelled;
