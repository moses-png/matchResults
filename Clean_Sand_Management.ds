												show Employee_Issuing_Details;
												show Voucher_Header;
												show Quantity_To_Be_Created;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												show Quantity_Created;
												show Allow_Excess_Material_Issued;
												disable Asset;
												disable Item;
												disable Quantity_To_Be_Created;
												show Notes;
												show Not_Created;
												enable Not_Created;
												if(input.Allow_Excess_Material_Issued == true)
												{
													show Reason_Why_Material_Issued_Exceeded_Formula;
													enable Reason_Why_Material_Issued_Exceeded_Formula;
												}
											}
											if(voucherType == "Drager Work Report")
											{
												show Voucher_Header;
												show Asset;
												show Machine_Start_of_Day;
												show Start_Time;
												show Odometer_Start;
											}
											if(voucherType == "Item Issuing Form")
											{
												hide Employee_Issuing_Details;
												show Voucher_Issuing_Details;
												hide Voucher_Issuing_Details.Display_Name_Voucher;
												hide Voucher_Issuing_Details.Source_Record_ID;
												hide Voucher_Issuing_Details.Source_Form;
												show Voucher_Footer;
												show Voucher_Cost;
											}
											if(voucherType == "Occurency Report")
											{
												show Voucher_Header;
												show Management_Location;
												show Incident_Details;
											}
											if(voucherType == "Store Receiving Book")
											{
												hide Employee_Issuing_Details;
												show Voucher_Receiving_Details;
												hide Voucher_Receiving_Details.Display_Name_Voucher;
												hide Voucher_Receiving_Details.Source_Record_ID;
												hide Voucher_Receiving_Details.Source_Form;
											}
											show Manager_Section;
											show Cancel_Voucher;
											enable Cancel_Voucher;
										}
										// =====================================================
										// ON EDIT + HEAD OFFICE
										// =====================================================
										else if(!is_create && st == "Head Office")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
											{
												hide Employee_Issuing_Details;
												show Voucher_Header;
												show Asset;
												show Item;
												show Quantity_To_Be_Created;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												disable Asset;
												disable Item;
												disable Quantity_To_Be_Created;
												show Notes;
												show Not_Created;
											}
											show Manager_Section;
											show Cancel_Voucher;
											if(input.Cancel_Voucher == true)
											{
												show Cancellation_Reason;
											}
											show Head_Office;
											show Seen;
											enable Seen;
										}
										// =====================================================
										// ON EDIT + HUMAN RESOURCE
										// =====================================================
										else if(!is_create && st == "Human Resource")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											enable Document_Type;
											show Voucher_Type;
											enable Voucher_Type;
											show Voucher_Number;
											enable Voucher_Number;
											show Employee;
											show Date_Time_In;
											enable Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											enable Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
											{
												show Employee_Issuing_Details;
												show Voucher_Header;
												show Employee_Receiving_Details;
												show Stock_Bundling_Note;
												show Voucher_Footer;
												show Voucher_Cost;
												show Notes;
												show Not_Created;
											}
											show Manager_Section;
											show Cancel_Voucher;
											enable Cancel_Voucher;
										}
										// =====================================================
										// ON EDIT + AUDITED
										// =====================================================
										else if(!is_create && st == "Audited")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											enable Voucher_Status;
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
											{
												hide Employee_Issuing_Details;
												show Voucher_Header;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												show Notes;
												show Not_Created;
											}
											show Voucher_Cost;
											show End_Time;
											show Odometer_End;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											if(input.Cancel_Voucher == true)
											{
												show Cancellation_Reason;
											}
											show Head_Office;
											show Seen;
											if(input.Seen == true)
											{
												hide Reason_for_not_Seen;
											}
											else
											{
												show Reason_for_not_Seen;
											}
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
											show Back_End;
											show User_Name;
											show User_Email;
											show User_Role;
											show Created_By_Name;
											show Created_By_Email;
											show Created_By_Time;
											show Updated_By_Name;
											show Updated_By_Email;
											show Updated_By_Time;
										}
										// =====================================================
										// ON EDIT + CLEARED
										// =====================================================
										else if(!is_create && st == "Cleared")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Shift_Voucher_Summary;
											show Opening_Vouchers;
											show Vouchers_Issued;
											show Vouchers_Returned;
											show Outstanding_Vouchers;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											show Head_Office;
											show Seen;
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
											show Back_End;
										}
										// =====================================
										// FINAL NOTES CONTROL
										// =====================================
										if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
										{
											show Notes;
											show Not_Created;
											if(input.Not_Created == true)
											{
												show Reason_Why_Not_Created;
												enable Reason_Why_Not_Created;
											}
										}
										else
										{
											hide Notes;
											hide Not_Created;
											hide Reason_Why_Not_Created;
											disable Reason_Why_Not_Created;
										}
										// =====================================
										// FORCE SHOW EXISTING DETAILS
										// =====================================
										if(input.Employee_Issuing_Details.count() > 0)
										{
											show Employee_Issuing_Details;
										}
										if(input.Voucher_Issuing_Details.count() > 0)
										{
											show Voucher_Issuing_Details;
										}
										if(input.Voucher_Receiving_Details.count() > 0)
										{
											show Voucher_Receiving_Details;
										}
						)
					}
				}

			}
			On_Company_Selected as "On Company Selected"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on user input of Company
				{
					actions 
					{
						custom deluge script
						(
											// 1) Display Name Company
										if(input.Company != null)
										{
											input.Display_Name_Company = input.Company.Company_Name + " - " + input.Company.Company_ID;
										}
										else
										{
											input.Display_Name_Company = "";
										}
										// 2) Build Display Name Purchase Order
										full_name = "";
										if(input.PO_Type == "Internal Transfer")
										{
											if(input.PO_Number != null && input.PO_Number.trim() != "")
											{
												full_name = "Internal Transfer - " + input.PO_Number.trim();
											}
											else
											{
												full_name = "Internal Transfer";
											}
										}
										else
										{
											if(input.Company != null)
											{
												full_name = input.Company.Company_Name + " - " + input.Company.Company_ID;
											}
											if(full_name != "" && input.PO_Number != null && input.PO_Number.trim() != "")
											{
												full_name = full_name + " - " + input.PO_Number.trim();
											}
											else if(input.PO_Number != null && input.PO_Number.trim() != "")
											{
												full_name = input.PO_Number.trim();
											}
										}
										// 3) Save on header
										Display_Name_Purchase_Order = full_name;
										// 4) Push to each PO Detail row
										for each  po_det in input.PO_Details
										{
											po_det.Display_Name_Purchase_Order=full_name;
											if(po_det.Purchase_Order_Number == null || po_det.Purchase_Order_Number == 0)
											{
												po_det.Purchase_Order_Number=input.PO_Number;
											}
										}
						)
					}
				}

			}
			On_Item_Selected4 as "On Item Selected"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on user input of PO_Details.Item
				{
					actions 
					{
						custom deluge script
						(
											// Trigger: On user input of Item in PO Lines OR On PO_Type change
										for each  po_det in input.PO_Details
										{
											if(po_det.Item != null)
											{
												name = ifnull(po_det.Item.Item_Name,"").trim();
												sku = ifnull(po_det.Item.SKU,"").trim();
												po_det.Display_Name_Item=if(sku != "",name + " - " + sku,name);
												if(po_det.Unit_Of_Measure == null)
												{
													po_det.Unit_Of_Measure=po_det.Item.Base_Unit_Of_Measure;
												}
												if(po_det.Unit_Of_Measure != null)
												{
													po_det.Display_Name_Unit_Of_Measure=po_det.Unit_Of_Measure.Unit_Of_Measure_Name;
												}
												else
												{
													po_det.Display_Name_Unit_Of_Measure=null;
												}
											}
											else
											{
												po_det.Display_Name_Item=null;
												po_det.Unit_Of_Measure=null;
												po_det.Display_Name_Unit_Of_Measure=null;
												po_det.Quantity_in_Base_Unit_Of_Measure=null;
												po_det.Line_Total=null;
												continue;
											}
											if(po_det.Item != null && po_det.Unit_Of_Measure != null)
											{
												check = store_management.po.check_uom_conversion_from_concrete(po_det.Item,po_det.Unit_Of_Measure);
												if(check.get("ok") != true)
												{
													alert check.get("message");
													po_det.Unit_Of_Measure=null;
													po_det.Display_Name_Unit_Of_Measure=null;
													po_det.Quantity_in_Base_Unit_Of_Measure=null;
													po_det.Line_Total=null;
												}
												else
												{
													resp = store_management.po.recalculate_po_detail_line_from_concrete(po_det.Item,po_det.Unit_Of_Measure,po_det.Quantity_Ordered,po_det.Unit_Cost);
													po_det.Display_Name_Unit_Of_Measure=resp.get("display_uom_name");
													po_det.Quantity_in_Base_Unit_Of_Measure=resp.get("qty_in_base");
													po_det.Line_Total=resp.get("line_total");
												}
											}
										}
										po_total = 0.0;
										for each  po_line in input.PO_Details
										{
											po_total = po_total + ifnull(po_line.Line_Total,0.0);
										}
										input.PO_Total = po_total;
						)
					}
				}

			}
			On_Addition_Of_Row1 as "On Addition Of Row"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on add row of PO_Details
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// PURCHASE ORDER — New Row in PO_Details
										// External Purchase only
										// ===============================
										// 1) Build header display name safely
										full_name = "";
										if(input.Company != null)
										{
											company_name = ifnull(input.Company.Company_Name,"").trim();
											company_id = ifnull(input.Company.Company_ID,"").trim();
											if(company_name != "" && company_id != "")
											{
												full_name = company_name + " - " + company_id;
											}
											else if(company_name != "")
											{
												full_name = company_name;
											}
										}
										if(full_name != "" && input.PO_Number != null && input.PO_Number.trim() != "")
										{
											full_name = full_name + " - " + input.PO_Number.trim();
										}
										else if(full_name == "" && input.PO_Number != null && input.PO_Number.trim() != "")
										{
											full_name = input.PO_Number.trim();
										}
										// 2) Renumber lines + push display values
										line_no = 0;
										for each  po_det in input.PO_Details
										{
											if(po_det.Item != null)
											{
												line_no = line_no + 1;
												po_det.Purchase_Order_Number=line_no;
												po_det.Display_Name_Purchase_Order=full_name;
												if(input.PO_Number != null && input.PO_Number.trim() != "")
												{
													po_det.Purchase_Order_Details_Number=input.PO_Number.trim() + " - " + line_no.toString();
												}
												else
												{
													po_det.Purchase_Order_Details_Number=line_no.toString();
												}
											}
											else
											{
												po_det.Purchase_Order_Number=null;
												po_det.Purchase_Order_Details_Number=null;
												po_det.Display_Name_Purchase_Order=full_name;
											}
										}
						)
					}
				}

			}
			On_Deletion_Of_Row as "On Deletion Of Row"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on delete row of PO_Details
				{
					actions 
					{
						custom deluge script
						(
											// PURCHASE ORDER — On Delete Row in PO_Details
										if(row.ID != null)
										{
											delete from Purchase_Order_Details[ID == row.ID];
										}
										// Rebuild header display name
										full_name = "";
										if(input.Company != null)
										{
											company_name = ifnull(input.Company.Company_Name,"").trim();
											company_id = ifnull(input.Company.Company_ID,"").trim();
											if(company_name != "" && company_id != "")
											{
												full_name = company_name + " - " + company_id;
											}
											else
											{
												full_name = company_name;
											}
										}
										if(full_name != "" && input.PO_Number != null && input.PO_Number.trim() != "")
										{
											full_name = full_name + " - " + input.PO_Number.trim();
										}
										// Renumber remaining rows
										line_no = 0;
										po_total = 0.0;
										for each  po_det in input.PO_Details
										{
											if(po_det.Item != null)
											{
												line_no = line_no + 1;
												po_det.Purchase_Order_Number=line_no;
												po_det.Display_Name_Purchase_Order=full_name;
												if(input.PO_Number != null && input.PO_Number.trim() != "")
												{
													po_det.Purchase_Order_Details_Number=input.PO_Number.trim() + " - " + line_no.toString();
												}
												else
												{
													po_det.Purchase_Order_Details_Number=line_no.toString();
												}
												po_total = po_total + ifnull(po_det.Line_Total,0.0);
											}
											else
											{
												po_det.Purchase_Order_Number=null;
												po_det.Purchase_Order_Details_Number=null;
												po_det.Display_Name_Purchase_Order=full_name;
											}
										}
										input.PO_Total = po_total;
						)
					}
				}

			}
			On_PO_Number_Selected as "On PO Number Selected"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on user input of PO_Number
				{
					actions 
					{
						custom deluge script
						(
											full_name = "";
										if(input.Company != null)
										{
											full_name = input.Company.Company_Name + " - " + input.Company.Company_ID;
										}
										if(input.PO_Number != null && input.PO_Number.trim() != "")
										{
											if(full_name != "")
											{
												full_name = full_name + " - " + input.PO_Number.trim();
											}
											else
											{
												full_name = input.PO_Number.trim();
											}
										}
										// Update header
										Display_Name_Purchase_Order = full_name;
										// Update detail rows
										for each  po_det in input.PO_Details
										{
											po_det.Display_Name_Purchase_Order=full_name;
										}
						)
					}
				}

			}
			On_Quantity_Ordered_Selec as "On Quantity Ordered Selected"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on user input of PO_Details.Quantity_Ordered
				{
					actions 
					{
						custom deluge script
						(
											// PURCHASE ORDER – PO Lines: On Quantity Ordered Changed
										for each  po_det in input.PO_Details
										{
											if(po_det.Item == null || po_det.Unit_Of_Measure == null)
											{
												po_det.Quantity_in_Base_Unit_Of_Measure=null;
												po_det.Line_Total=null;
												continue;
											}
											check = store_management.po.check_uom_conversion_from_concrete(po_det.Item,po_det.Unit_Of_Measure);
											if(check.get("ok") != true)
											{
												alert check.get("message");
												po_det.Quantity_in_Base_Unit_Of_Measure=null;
												po_det.Line_Total=null;
												continue;
											}
											resp = store_management.po.recalculate_po_detail_line_from_concrete(po_det.Item,po_det.Unit_Of_Measure,po_det.Quantity_Ordered,po_det.Unit_Cost);
											po_det.Display_Name_Unit_Of_Measure=resp.get("display_uom_name");
											po_det.Quantity_in_Base_Unit_Of_Measure=resp.get("qty_in_base");
											po_det.Line_Total=resp.get("line_total");
											if(po_det.Quantity_Ordered != null)
											{
												received_qty = ifnull(po_det.Quantity_Received,0.0);
												po_det.Quantity_Remaining=po_det.Quantity_Ordered - received_qty;
												if(po_det.Quantity_Remaining < 0)
												{
													po_det.Quantity_Remaining=0.0;
												}
											}
										}
										po_total = 0.0;
										for each  po_det in input.PO_Details
										{
											po_total = po_total + ifnull(po_det.Line_Total,0.0);
										}
										input.PO_Total = po_total;
						)
					}
				}

			}
