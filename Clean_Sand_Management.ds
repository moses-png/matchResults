			On_Credit_Amount_Selected as "On Credit Amount Selected"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on user input of Credit_Amount
				{
					actions 
					{
						custom deluge script
						(
											credit_amount = ifnull(input.Credit_Amount,0);
										if(credit_amount > ifnull(input.Amount_Due,0))
										{
											input.Credit_Amount = input.Amount_Due;
											credit_amount = input.Amount_Due;
										}
										input.Balance_Due = ifnull(input.Amount_Due,0) - credit_amount;
						)
					}
				}

			}
			Full_Validation5 as "Full Validation"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Credit_Note_Date == null)
										{
											input.Credit_Note_Date = zoho.currentdate;
										}
										if(input.Credit_Note_Number == null || input.Credit_Note_Number == "")
										{
											doc = Document_Key[Voucher_Type == "Credit Note" && Document_Key_Status == "Active"];
											if(doc.ID == null)
											{
												alert "No active Document Key found for Credit Note.";
												cancel submit;
											}
											next_no = ifnull(doc.Next_Number,1);
											if(next_no < 10)
											{
												num_txt = "0000" + next_no;
											}
											else if(next_no < 100)
											{
												num_txt = "000" + next_no;
											}
											else if(next_no < 1000)
											{
												num_txt = "00" + next_no;
											}
											else if(next_no < 10000)
											{
												num_txt = "0" + next_no;
											}
											else
											{
												num_txt = "" + next_no;
											}
											input.Credit_Note_Number = doc.Prefix + num_txt;
											doc.Next_Number=next_no + 1;
										}
										errors = List();
										if(input.Sales_Voucher == null)
										{
											errors.add("• Sales Voucher is required.");
										}
										if(input.Customer == null)
										{
											errors.add("• Customer is required.");
										}
										amount_due_val = ifnull(input.Amount_Due,0.0);
										if(amount_due_val <= 0)
										{
											errors.add("• Amount Due must be greater than zero.");
										}
										credit_amount_val = ifnull(input.Credit_Amount,0.0);
										if(credit_amount_val <= 0)
										{
											errors.add("• Credit Amount must be greater than zero.");
										}
										if(credit_amount_val > 0 && amount_due_val > 0 && credit_amount_val > amount_due_val)
										{
											errors.add("• Credit Amount cannot be greater than Amount Due.");
										}
										available_credit_val = ifnull(input.Available_Credit,0.0);
										if(credit_amount_val > 0 && credit_amount_val > available_credit_val)
										{
											errors.add("• Credit Amount cannot be greater than Available Credit.");
										}
										if(input.Credit_Days_Allowed == null || input.Credit_Days_Allowed < 0)
										{
											errors.add("• Credit Days Allowed cannot be empty or negative.");
										}
										if(input.Credit_Note_Date == null)
										{
											errors.add("• Credit Note Date is required.");
										}
										if(input.Credit_Note_Number == null || input.Credit_Note_Number.trim() == "")
										{
											errors.add("• Credit Note Number is required.");
										}
										else
										{
											dup = Credit_Note[Credit_Note_Number == input.Credit_Note_Number.trim() && ID != input.ID];
											if(dup.count() > 0)
											{
												errors.add("• This Credit Note Number has already been used.");
											}
										}
										if(errors.size() > 0)
										{
											alert "Please fix the following:\n" + errors.toString("\n");
											cancel submit;
										}
										input.Balance_Due = amount_due_val - credit_amount_val;
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0.0;
										}
										if(input.Due_Date == null && input.Credit_Note_Date != null && input.Credit_Days_Allowed != null)
										{
											input.Due_Date = input.Credit_Note_Date.addDay(input.Credit_Days_Allowed);
										}
						)
					}
				}

			}
			Finalize_On_Delete2 as "Finalize On Delete"
			{
				type =  form
				form = Purchase_Order

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------------------------------------
										// Purchase Order - Finalize On Delete
										// ------------------------------------------------------------
										source_record_id = input.ID.toString();
										source_form = "Masaka Site Management - Purchase Order";
										// ------------------------------------------------------------
										// 1) Delete Purchase Order Details
										// ------------------------------------------------------------
										po_details = Purchase_Order_Details[Purchase_Order == input.ID];
										for each  po_det in po_details
										{
											delete from Purchase_Order_Details[ID == po_det.ID];
										}
										// ------------------------------------------------------------
										// 2) Delete synced Store Purchase Order and Store PO Details
										// ------------------------------------------------------------
										resp = store_management.deletePurchaseOrderFromMasakaSiteManagement(source_record_id,source_form);
										info resp;
						)
					}
				}

			}
			Full_Validation3 as "Full Validation"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										if(input.PO_Type == null || input.PO_Type.trim() == "")
										{
											errors = errors + "\n• PO Type is required.";
										}
										if(input.Employee_Voucher == null)
										{
											errors = errors + "\n• Employee Voucher is required.";
										}
										if(input.Site == null || input.Site.trim() == "")
										{
											errors = errors + "\n• Site is required.";
										}
										if(input.PO_Date == null)
										{
											errors = errors + "\n• PO Date is required.";
										}
										else if(input.PO_Date > zoho.currentdate)
										{
											errors = errors + "\n• PO Date cannot be in the future.";
										}
										if(input.PO_Details == null || input.PO_Details.count() == 0)
										{
											errors = errors + "\n• At least one Purchase Order Detail row is required.";
										}
										line_no = 0;
										for each  row in input.PO_Details
										{
											line_no = line_no + 1;
											if(row.Item == null)
											{
												errors = errors + "\n• Row " + line_no + ": Item is required.";
											}
											if(row.Stock_Condition == null || ifnull(row.Stock_Condition,"").trim() == "")
											{
												errors = errors + "\n• Row " + line_no + ": Stock Condition is required.";
											}
											if(row.Quantity_Ordered == null || row.Quantity_Ordered <= 0)
											{
												errors = errors + "\n• Row " + line_no + ": Quantity Ordered must be greater than 0.";
											}
											if(row.Unit_Of_Measure == null)
											{
												errors = errors + "\n• Row " + line_no + ": Unit Of Measure is required.";
											}
											if(row.Unit_Cost == null || row.Unit_Cost < 0)
											{
												errors = errors + "\n• Row " + line_no + ": Unit Cost must be zero or greater.";
											}
										}
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation4 as "Full Validation"
			{
				type =  form
				form = Item_Issuing_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Item Issuing Voucher - Validation On Create
										// =======================================
										// 1) Store is required
										if(input.Store == null)
										{
											alert "Please select the Store.";
											cancel submit;
										}
										// 2) Item Issuing Date is required
										if(input.Item_Issuing_Date == null)
										{
											alert "Item Issuing Date is missing. Check the selected Voucher record.";
											cancel submit;
										}
										// 3) Prevent duplicate Item Issuing Voucher
										if(input.Item_Issuing_Voucher != null)
										{
											dup_voucher = Item_Issuing_Voucher[Item_Issuing_Voucher == input.Item_Issuing_Voucher];
											if(dup_voucher.count() > 0)
											{
												alert "This Item Issuing Voucher has already been used.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Full_Validation6 as "Full Validation"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Item Issuing Details - Full Validation
										// =======================================
										errors = List();
										hdr = null;
										old_rec = null;
										req_type = "";
										stock_cond = "";
										qty_val = 0.0;
										new_base_qty = null;
										old_base_qty = 0.0;
										extra_needed = 0.0;
										store_stock = 0.0;
										is_tool = false;
										current_status = ifnull(input.Status,"").trim();
										saved_status = "";
										if(input.ID != null)
										{
											old_rec = Item_Issuing_Details[ID == input.ID];
											if(old_rec.ID != null)
											{
												saved_status = ifnull(old_rec.Status,"").trim();
											}
										}
										// 1) ISSUING VOUCHER
										if(input.Issuing_Voucher == null)
										{
											errors.add("• Please select the Issuing Voucher.");
										}
										else
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID == null)
											{
												errors.add("• Selected Issuing Voucher was not found.");
											}
											else if(hdr.Store == null)
											{
												errors.add("• The selected Issuing Voucher has no Store.");
											}
										}
										// 2) LINE NUMBER
										if(input.Line_Number == null || input.Line_Number <= 0)
										{
											errors.add("• Line Number is required.");
										}
										// 3) DUPLICATE LINE NUMBER
										if(input.Issuing_Voucher != null && input.Line_Number != null && input.Line_Number > 0)
										{
											dup = Item_Issuing_Details[Issuing_Voucher == input.Issuing_Voucher && Line_Number == input.Line_Number && ID != input.ID];
											if(dup.count() > 0)
											{
												errors.add("• Line Number " + input.Line_Number + " is already used.");
											}
										}
										// 4) REQUEST VOUCHER TYPE
										req_type = ifnull(input.Request_Voucher_Type,"").trim();
										if(req_type == "")
										{
											errors.add("• Please select Request Voucher Type.");
										}
										// 5) SOURCE VALIDATION
										if(req_type == "Employee Voucher" && input.Employee_Voucher == null)
										{
											errors.add("• Please select Employee Voucher.");
										}
										else if(req_type == "Work Order Task" && input.Work_Order_Task == null)
										{
											errors.add("• Please select Work Order Task.");
										}
										if(req_type == "Sales Voucher" || req_type == "Sand Sales" || req_type == "Stock Sales")
										{
											if(input.Sales_Voucher == null)
											{
												alert "Sales Voucher is required.";
												cancel submit;
											}
											if(input.Item_Taken == null)
											{
												alert "Item Taken is required.";
												cancel submit;
											}
											if(input.Items_Image == null)
											{
												alert "Items Image is required.";
												cancel submit;
											}
											if(input.Item == null)
											{
												alert "Item could not be resolved from Item Taken.";
												cancel submit;
											}
											if(input.Stock_Condition == null || input.Stock_Condition.trim() == "")
											{
												alert "Stock Condition is required.";
												cancel submit;
											}
											if(input.Unit_Of_Measure == null)
											{
												alert "Unit Of Measure is required.";
												cancel submit;
											}
											if(input.Cost == null || input.Cost < 0)
											{
												alert "Cost is required.";
												cancel submit;
											}
											if(input.Store_Available_Stock == null)
											{
												alert "Store Available Stock is missing.";
												cancel submit;
											}
											if(input.Global_Available_Stock == null)
											{
												alert "Global Available Stock is missing.";
												cancel submit;
											}
										}
										// 6) ITEM
										if(input.Item == null)
										{
											errors.add("• Please select the Item.");
										}
										// 7) STOCK CONDITION DEFAULT
										stock_cond = ifnull(input.Stock_Condition,"").trim();
										if(stock_cond == "")
										{
											input.Stock_Condition = "New";
											stock_cond = "New";
										}
										// 8) UNIT OF MEASURE
										if(input.Unit_Of_Measure == null)
										{
											errors.add("• Please select Unit Of Measure.");
										}
										// 9) QUANTITY
										if(input.Quantity == null)
										{
											errors.add("• Quantity must be greater than zero.");
										}
										else
										{
											qty_val = input.Quantity.toDecimal();
											if(qty_val <= 0)
											{
												errors.add("• Quantity must be greater than zero.");
											}
										}
										// 10) TAKEN BY
										if(input.Taken_By == null)
										{
											errors.add("• Please select who took the item.");
										}
										// 11) UOM CONVERSION + BASE QTY
										if(input.Item != null && input.Unit_Of_Measure != null && input.Quantity != null && qty_val > 0)
										{
											check = store_management.po.check_uom_conversion_from_masaka_site_management(input.Item,input.Unit_Of_Measure);
											if(check == null || check.get("ok") != true)
											{
												errors.add("• " + ifnull(check.get("message"),"UOM conversion failed."));
											}
											else
											{
												tmp_base_qty = store_management.po.convert_to_base_qty_from_masaka_site_management(input.Item,input.Unit_Of_Measure,input.Quantity);
												if(tmp_base_qty == null)
												{
													errors.add("• Calculated base quantity is invalid.");
												}
												else
												{
													new_base_qty = tmp_base_qty.toDecimal();
													if(new_base_qty <= 0)
													{
														errors.add("• Calculated base quantity is invalid.");
													}
													else
													{
														input.Quantity_in_Base_Unit_Of_Measure = new_base_qty;
													}
												}
											}
										}
										// 12) STOCK VALIDATION
										should_validate_stock = false;
										if(req_type == "Employee Voucher")
										{
											if(input.ID == null)
											{
												should_validate_stock = true;
											}
											else if(current_status == "Approved" || current_status == "Issued" || current_status == "Borrowed")
											{
												should_validate_stock = true;
											}
										}
										else
										{
											if(input.ID != null && saved_status == "Approved" && current_status == "Approved")
											{
												should_validate_stock = true;
											}
										}
										if(should_validate_stock == true)
										{
											if(hdr != null && hdr.ID != null && hdr.Store != null && input.Item != null && new_base_qty != null && new_base_qty > 0)
											{
												stock_map = store_management.po.get_item_store_cost_from_masaka_site_management(input.Item,hdr.Store,stock_cond);
												store_stock = ifnull(stock_map.get("store_stock"),0.0).toDecimal();
												input.Store_Available_Stock = store_stock;
												input.Global_Available_Stock = ifnull(stock_map.get("global_stock"),0.0);
												old_base_qty = 0.0;
												if(input.ID != null && old_rec != null && old_rec.ID != null)
												{
													old_base_qty = ifnull(old_rec.Quantity_in_Base_Unit_Of_Measure,0.0).toDecimal();
												}
												if(req_type != "Employee Voucher" && saved_status == "Approved")
												{
													old_base_qty = 0.0;
												}
												extra_needed = new_base_qty - old_base_qty;
												if(extra_needed < 0)
												{
													extra_needed = 0.0;
												}
												if(extra_needed > 0)
												{
													if(store_stock <= 0)
													{
														errors.add("• No stock available in this Store for " + stock_cond + " condition.");
													}
													else if(extra_needed > store_stock)
													{
														errors.add("• Insufficient store stock. Required: " + extra_needed + " (Base UoM). Available: " + store_stock + " (Base UoM).");
													}
												}
											}
										}
										// 13) TOOL CHECK
										if(input.Item != null)
										{
											if(input.Item.Is_Tool == true)
											{
												is_tool = true;
											}
										}
										// 14) LINE TOTAL VALIDATION
										calc_line_total = ifnull(input.Quantity,0.0) * ifnull(input.Cost,0.0);
										if(is_tool == false && stock_cond != "Used")
										{
											if(calc_line_total <= 0)
											{
												errors.add("• Line Total cannot be zero. Please check Quantity or Cost.");
											}
										}
										else
										{
											if(input.Line_Total == null)
											{
												input.Line_Total = 0.0;
											}
										}
										// 15) TOOL RETURN DATE VALIDATION
										if(is_tool && req_type != "Internal Transfer" && input.Expected_Return_Date == null)
										{
											errors.add("• Expected Return Date is required for tools unless Request Voucher Type is Internal Transfer.");
										}
										// 16) EDIT ONLY CANCELLATION VALIDATION
										if(input.ID != null && input.Cancel_This_Line_Item == true)
										{
											if(input.Reason_Why_Cancelled == null || input.Reason_Why_Cancelled.trim() == "")
											{
												errors.add("• Please enter the reason why this line item was cancelled.");
											}
										}
										// FINAL
										if(errors.isEmpty() == false)
										{
											msg = "Please fix the following:\n\n";
											for each  err in errors
											{
												msg = msg + err + "\n";
											}
											alert msg;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation7 as "Full Validation"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// STOCK RECEIVING DETAILS
										// FULL VALIDATION
										// =======================================
										errors = List();
										rtype = ifnull(input.Receiving_Type,"").trim();
										stock_cond = ifnull(input.Stock_Condition,"").trim();
										qty_received = ifnull(input.Quantity_Received,0.0);
										old_rec = null;
										if(input.ID != null)
										{
											old_rec = Stock_Receiving_Details[ID == input.ID];
										}
										if(input.Stock_Receiving_Voucher == null)
										{
											errors.add("• Please select the Stock Receiving Voucher.");
										}
										else
										{
											srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
											if(srv.ID == null || srv.Store == null)
											{
												errors.add("• The selected Stock Receiving Voucher has no destination Store.");
											}
											else
											{
												destination_store = srv.Store;
											}
										}
										if(input.Stock_Receiving_Voucher_Number == null || input.Stock_Receiving_Voucher_Number <= 0)
										{
											errors.add("• Stock Receiving Voucher Number is required.");
										}
										if(input.Stock_Receiving_Voucher != null && input.Stock_Receiving_Voucher_Number != null)
										{
											dup = Stock_Receiving_Details[Stock_Receiving_Voucher == input.Stock_Receiving_Voucher && Stock_Receiving_Voucher_Number == input.Stock_Receiving_Voucher_Number && ID != input.ID];
											if(dup.count() > 0)
											{
												errors.add("• This Stock Receiving Voucher Number has already been.");
											}
										}
										if(rtype == "")
										{
											errors.add("• Please select Receiving Type.");
										}
										if(stock_cond == "")
										{
											errors.add("• Stock Condition is required.");
										}
										if(qty_received <= 0)
										{
											errors.add("• Quantity Received must be greater than zero.");
										}
										if(input.Unit_Of_Measure_Received == null)
										{
											errors.add("• Unit Of Measure Received is required.");
										}
										actual_item_id = null;
										actual_item_rec = null;
										po_det = null;
										issue_rec = null;
										selected_issue_id = null;
										// =======================================
										// RECEIVING TYPE VALIDATION
										// =======================================
										if(rtype == "Purchase Order")
										{
											if(input.Purchase_Order == null)
											{
												errors.add("• Purchase Order is required.");
											}
											else if(input.Item == null)
											{
												errors.add("• Purchase Order line Item is required.");
											}
											else
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID == null || po_det.Item == null)
												{
													errors.add("• The selected Purchase Order line is invalid.");
												}
												else
												{
													actual_item_id = po_det.Item;
													po_stock_cond = ifnull(po_det.Stock_Condition,"").trim();
													if(po_stock_cond == "")
													{
														errors.add("• The selected Purchase Order line has no Stock Condition.");
													}
													else if(stock_cond != po_stock_cond)
													{
														errors.add("• Stock Condition must match PO line. PO has: " + po_stock_cond + ".");
													}
												}
											}
											if(input.Voucher != null || input.Internal_Transfer_Number != null || input.Stock_Return_Number != null || input.Tool_Return_Number != null || input.Transfer_Item != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Purchase Order, only Purchase Order fields should be filled.");
											}
										}
										// -----------------------------------------------------
										// INTERNAL TRANSFER
										// -----------------------------------------------------
										else if(rtype == "Internal Transfer")
										{
											if(input.Internal_Transfer_Number == null)
											{
												errors.add("• Internal Transfer Number is required.");
											}
											else if(input.Transfer_Item == null)
											{
												errors.add("• Stock Transfer Item is required.");
											}
											else
											{
												transfer_qty = ifnull(input.Transfer_Item.Quantity,0.0);
												transfer_received_qty = ifnull(input.Transfer_Item.Quantity_Received,0.0);
												transfer_remaining_qty = transfer_qty - transfer_received_qty;
												if(transfer_remaining_qty < 0)
												{
													transfer_remaining_qty = 0.0;
												}
												transfer_base_qty = ifnull(input.Transfer_Item.Quantity_in_Base_Unit_Of_Measure,0.0);
												transfer_base_received_qty = ifnull(input.Transfer_Item.Quantity_Received_in_Base_Unit_Of_Measure,0.0);
												transfer_base_remaining_qty = transfer_base_qty - transfer_base_received_qty;
												if(transfer_base_remaining_qty < 0)
												{
													transfer_base_remaining_qty = 0.0;
												}
												transfer_uom_id = input.Transfer_Item.Unit_Of_Measure;
												transfer_status = ifnull(input.Transfer_Item.Receiving_Status,"Not Received");
												source_store = input.Transfer_Item.Issuing_Store;
												transfer_stock_condition = ifnull(input.Transfer_Item.Stock_Condition,"");
												actual_item_id = input.Transfer_Item.Item;
											}
											if(input.Purchase_Order != null || input.Item != null || input.Voucher != null || input.Stock_Return_Number != null || input.Tool_Return_Number != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Internal Transfer receiving, only Internal Transfer fields should be filled.");
											}
										}
										else if(rtype == "Stock Return")
										{
											if(input.Stock_Return_Number == null)
											{
												errors.add("• Stock Return Number is required.");
											}
											else if(input.Item_Issuing_Details == null)
											{
												errors.add("• Stock Return Item Issuing Details is required.");
											}
											else
											{
												selected_issue_id = input.Item_Issuing_Details;
												issue_rec = Item_Issuing_Details[ID == selected_issue_id];
												if(issue_rec.ID == null || issue_rec.Item == null)
												{
													errors.add("• The selected Stock Return Item Issuing Details record is invalid.");
												}
												else
												{
													actual_item_id = issue_rec.Item;
												}
											}
											if(input.Purchase_Order != null || input.Item != null || input.Voucher != null || input.Internal_Transfer_Number != null || input.Tool_Return_Number != null || input.Transfer_Item != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Stock Return, only Stock Return fields should be filled.");
											}
										}
										else if(rtype == "Tool Return")
										{
											if(input.Tool_Return_Number == null)
											{
												errors.add("• Tool Return Number is required.");
											}
											else if(input.Item_Issuing_Details == null)
											{
												errors.add("• Tool Return Item Issuing Details is required.");
											}
											else
											{
												selected_issue_id = input.Item_Issuing_Details;
												issue_rec = Item_Issuing_Details[ID == selected_issue_id];
												if(issue_rec.ID == null || issue_rec.Item == null)
												{
													errors.add("• The selected Tool Return Item Issuing Details record is invalid.");
												}
												else
												{
													actual_item_id = issue_rec.Item;
												}
											}
											if(input.Purchase_Order != null || input.Item != null || input.Voucher != null || input.Internal_Transfer_Number != null || input.Stock_Return_Number != null || input.Transfer_Item != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Tool Return, only Tool Return fields should be filled.");
											}
										}
										else if(rtype != "")
										{
											errors.add("• Unsupported Receiving Type.");
										}
										base_qty = null;
										input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										if(actual_item_id != null && input.Unit_Of_Measure_Received != null && qty_received > 0)
										{
											check = store_management.po.check_uom_conversion_from_concrete(actual_item_id,input.Unit_Of_Measure_Received);
											if(check == null || check.get("ok") != true)
											{
												errors.add("• " + ifnull(check.get("message"),"UOM conversion failed."));
											}
											else
											{
												base_qty = store_management.po.convert_to_base_qty_from_concrete(actual_item_id,input.Unit_Of_Measure_Received,input.Quantity_Received);
												if(base_qty == null || base_qty <= 0)
												{
													errors.add("• Calculated base quantity is invalid.");
												}
												else
												{
													input.Quantity_in_Base_Unit_Of_Measure_Received = base_qty;
												}
											}
										}
										if(rtype == "Purchase Order" && po_det != null && po_det.ID != null)
										{
											qty_remaining = ifnull(po_det.Quantity_Remaining,0.0);
											old_qty_this_row = 0.0;
											if(old_rec != null && old_rec.ID != null)
											{
												old_qty_this_row = ifnull(old_rec.Quantity_Received,0.0);
											}
											max_allowed = qty_remaining + old_qty_this_row;
											if(qty_received > max_allowed)
											{
												errors.add("• You cannot receive more than Quantity Remaining. Maximum allowed: " + max_allowed + ".");
											}
										}
										is_transfer_return = false;
										if(rtype == "Internal Transfer")
										{
											is_transfer_return = true;
										}
										else if(rtype == "Stock Return")
										{
											is_transfer_return = true;
										}
										else if(rtype == "Tool Return")
										{
											is_transfer_return = true;
										}
										if(is_transfer_return == true && issue_rec != null && issue_rec.ID != null)
										{
											if(ifnull(issue_rec.Status,"") == "Cancelled")
											{
												errors.add("• Cancelled issuing records cannot be received.");
											}
											issued_qty = ifnull(issue_rec.Quantity,0.0);
											returned_qty = ifnull(issue_rec.Quantity_Returned,0.0);
											remaining_issue_qty = issued_qty - returned_qty;
											if(remaining_issue_qty < 0)
											{
												remaining_issue_qty = 0.0;
											}
											if(remaining_issue_qty <= 0)
											{
												errors.add("• This issuing record has already been fully received.");
											}
											else if(qty_received > remaining_issue_qty)
											{
												errors.add("• You cannot receive more than the remaining issued quantity.");
											}
											if(issue_rec.Unit_Of_Measure != null && input.Unit_Of_Measure_Received != null && input.Unit_Of_Measure_Received != issue_rec.Unit_Of_Measure)
											{
												errors.add("• Unit Of Measure Received must match the issued Unit Of Measure.");
											}
											if(rtype == "Internal Transfer")
											{
												existing_transfer = Stock_Receiving_Details[Receiving_Type == "Internal Transfer" && Transfer_Item == selected_issue_id && ID != input.ID];
												if(existing_transfer.count() > 0)
												{
													errors.add("• This Item Issuing Details record has already been received as an Internal Transfer.");
												}
												if(input.Quantity_to_Receive != null && qty_received != input.Quantity_to_Receive)
												{
													errors.add("• For Internal Transfer, Quantity Received must exactly match Quantity to Receive.");
												}
												source_store = "";
												destination_store_name = "";
												if(issue_rec.Issuing_Voucher != null)
												{
													iss_hdr = Item_Issuing_Voucher[ID == issue_rec.Issuing_Voucher];
													if(iss_hdr.ID != null)
													{
														source_store = ifnull(iss_hdr.Display_Name_Store,"").trim();
													}
												}
												if(srv != null && srv.ID != null)
												{
													destination_store_name = ifnull(srv.Display_Name_Store,"").trim();
												}
												if(source_store == "")
												{
													errors.add("• The source Item Issuing Voucher has no Store.");
												}
												else if(destination_store_name != "" && source_store == destination_store_name)
												{
													errors.add("• Source Store and Destination Store cannot be the same for Internal Transfer.");
												}
											}
											else if(rtype == "Stock Return")
											{
											}
											else if(rtype == "Tool Return")
											{
												if(stock_cond == "New")
												{
													errors.add("• Tool Return cannot be received as New.");
												}
											}
										}
										if(errors.size() > 0)
										{
											msg = "Please fix the following:\n\n";
											for each  err_msg in errors
											{
												msg = msg + err_msg + "\n";
											}
											alert msg;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation8 as "Full Validation"
			{
				type =  form
				form = Stock_Receiving_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Stock Receiving Voucher Validation
										// On Create / On Validate
										// =======================================
										// 1) Stock Receiving Book required
										if(input.Stock_Receiving_Book == null)
										{
											alert "Please select Stock Receiving Book.";
											cancel submit;
										}
										// 2) Store required
										if(input.Store == null)
										{
											alert "Please select the Store.";
											cancel submit;
										}
										// 3) Received By required
										if(input.Received_By == null || input.Received_By.trim() == "")
										{
											alert "Received By is required.";
											cancel submit;
										}
										// 4) Prevent duplicate Stock Receiving Book only
										existing_rec = Stock_Receiving_Voucher[Stock_Receiving_Book == input.Stock_Receiving_Book && ID != input.ID];
										if(existing_rec.ID != null)
										{
											alert "This Stock Receiving Book has already been used.";
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation9 as "Full Validation"
			{
				type =  form
				form = Bill

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Bill (Parent) - ON VALIDATE
										// =======================================
										// =======================================
										// BILL DATE VALIDATION
										// =======================================
										if(input.Bill_Date == null)
										{
											alert "Bill Date is required.";
											cancel submit;
										}
										// Future dated Bills may remain Draft,
										// but cannot be marked as Billed.
										if(input.Bill_Date > zoho.currentdate && input.Billed == true)
										{
											alert "A future dated Bill cannot be marked as Billed.";
											cancel submit;
										}
										// 2) Bill Type based required fields
										if(input.Bill_Type == "External Bill")
										{
											if(input.Vendor == null)
											{
												alert "Vendor is required for Store Bill.";
												cancel submit;
											}
										}
										else if(input.Bill_Type == "Employee Bill")
										{
											if(input.Employee_Vendor == null)
											{
												alert "Employee Vendor is required for Employee Bill.";
												cancel submit;
											}
										}
										else if(input.Bill_Type == "Sales Voucher Bill")
										{
											if(input.Sales_Voucher == null)
											{
												alert "Sales Voucher is required for Sales Voucher Bill.";
												cancel submit;
											}
										}
										// 3) Bill Name required
										if(isnull(input.Bill_Name) || input.Bill_Name.trim() == "")
										{
											alert "Bill Name is required.";
											cancel submit;
										}
										// 4) Bill Number required
										if(isnull(input.Bill_Number) || input.Bill_Number.trim() == "")
										{
											alert "Bill Number is required.";
											cancel submit;
										}
										// ===============================
										// PREVENT DUPLICATE BILL ENTRY
										// ===============================
										if(input.Bill_Type == "Store Bill")
										{
											dup = Bill[Bill_Number == input.Bill_Number && Bill_Name == input.Bill_Name && Vendor == input.Vendor && Bill_Type == input.Bill_Type && ID != input.ID];
											if(dup.count() > 0)
											{
												alert "Duplicate Store Bill detected.";
												cancel submit;
											}
										}
										else if(input.Bill_Type == "Employee Bill")
										{
											dup = Bill[Bill_Number == input.Bill_Number && Bill_Name == input.Bill_Name && Employee_Vendor == input.Employee_Vendor && Bill_Type == input.Bill_Type && ID != input.ID];
											if(dup.count() > 0)
											{
												alert "Duplicate Employee Bill detected.";
												cancel submit;
											}
										}
										else if(input.Bill_Type == "Sales Voucher Bill")
										{
											dup = Bill[Bill_Number == input.Bill_Number && Bill_Name == input.Bill_Name && Sales_Voucher == input.Sales_Voucher && Bill_Type == input.Bill_Type && ID != input.ID];
											if(dup.count() > 0)
											{
												alert "Duplicate Sales Voucher Bill detected.";
												cancel submit;
											}
										}
										// =======================================
										// VALIDATE BILL DETAILS TOTAL
										// =======================================
										// Month Bills are automatically distributed
										// from Bill Total during finalization,
										// so do not apply the normal exceed check.
										if(!input.Bill_Number.contains("Month"))
										{
											details_total = 0.0;
											for each  det in input.Bill_Details
											{
												details_total = details_total + ifnull(det.Line_Total,0.0);
											}
											if(details_total > ifnull(input.Bill_Total,0.0))
											{
												alert "Details exceed Bill Total!";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Full_Validation10 as "Full Validation"
			{
				type =  form
				form = Bill_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Concrete Bill Details
										// =======================================
										errors = List();
										is_store_bill = false;
										is_parts_bill = false;
										is_document_transport = false;
										// -------------------------------
										// 1) Detect Bill Detail Type
										// -------------------------------
										if(input.Expense_Type == "Document Transport")
										{
											is_document_transport = true;
										}
										else if(input.Stock_Receiving_Details != null)
										{
											is_store_bill = true;
										}
										else if(input.Parts_Consumables != null)
										{
											is_parts_bill = true;
										}
										if(input.Bill == null)
										{
											errors.add("• Bill is required.");
										}
										// =====================================================
										// A) DOCUMENT TRANSPORT
										// =====================================================
										if(is_document_transport)
										{
											if(input.Details_Date == null)
											{
												errors.add("• Details Date is required.");
											}
											if(input.Reference == null || input.Reference.trim() == "")
											{
												errors.add("• Reference is required.");
											}
											if(input.Details == null || input.Details.trim() == "")
											{
												errors.add("• Details is required.");
											}
											if(input.Quantity == null || input.Quantity <= 0)
											{
												errors.add("• Quantity must be greater than 0.");
											}
											if(input.Rate == null || input.Rate < 0)
											{
												errors.add("• Rate is required.");
											}
											if(input.Account == null || input.Account.trim() == "")
											{
												errors.add("• Account is required.");
											}
										}
										// =====================================================
										// B) STORE BILL DETAILS ONLY
										// =====================================================
										else if(is_store_bill)
										{
											if(input.Item == null)
											{
												errors.add("• Item is required.");
											}
											if(input.Unit_Of_Measure == null)
											{
												errors.add("• Unit Of Measure is required.");
											}
											if(input.Quantity == null || input.Quantity <= 0)
											{
												errors.add("• Quantity must be greater than 0.");
											}
											if(input.Rate == null || input.Rate < 0)
											{
												errors.add("• Rate is required.");
											}
											billable = ifnull(input.Quantity_Billable,0.0);
											if(input.Quantity != null && input.Quantity > billable)
											{
												errors.add("• You cannot bill more than Quantity Billable (" + billable.toString() + ").");
											}
											base_qty = ifnull(input.Quantity_In_Base_Unit,0.0);
											if(base_qty <= 0 && input.Item != null && input.Unit_Of_Measure != null && input.Quantity != null && input.Quantity > 0)
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID != null && po_det.Item != null)
												{
													item_id = po_det.Item;
													check = store_management.po.check_uom_conversion_from_concrete(item_id,input.Unit_Of_Measure);
													if(check == null || check.get("ok") != true)
													{
														errors.add("• " + ifnull(check.get("message"),"UOM conversion failed."));
													}
													else
													{
														bq = store_management.po.convert_to_base_qty_from_concrete(item_id,input.Unit_Of_Measure,input.Quantity);
														if(bq != null && bq > 0)
														{
															input.Quantity_In_Base_Unit = bq;
															base_qty = bq;
														}
													}
												}
											}
											if(base_qty <= 0)
											{
												errors.add("• Quantity in Base Unit could not be calculated. Check Unit Of Measure conversion.");
											}
											line_total_val = 0.0;
											if(input.Quantity != null && input.Rate != null)
											{
												line_total_val = round(input.Quantity * input.Rate,2);
											}
											if(line_total_val > 0 && base_qty > 0)
											{
												input.Rate_In_Base_Unit = round(line_total_val / base_qty,2);
											}
											else
											{
												input.Rate_In_Base_Unit = 0.0;
											}
										}
										// =====================================================
										// C) WORK ORDER / PARTS & CONSUMABLES BILL DETAILS
										// =====================================================
										else if(is_parts_bill)
										{
											if(input.Details == null || input.Details.trim() == "")
											{
												errors.add("• Details is required for Parts & Consumables.");
											}
											if(input.Quantity == null || input.Quantity <= 0)
											{
												errors.add("• Quantity must be greater than 0.");
											}
											if(input.Rate == null || input.Rate < 0)
											{
												errors.add("• Rate is required.");
											}
										}
										// =====================================================
										// D) DEFAULT / MANUAL EMPLOYEE DETAILS
										// =====================================================
										else
										{
											if(input.Account == null || input.Account.trim() == "")
											{
												errors.add("• Account is required.");
											}
											if(input.Current_Site == null || input.Current_Site.trim() == "")
											{
												errors.add("• Current Site is required.");
											}
										}
										// =====================================================
										// 3) Check Bill Total limit - applies to all bill types
										// =====================================================
										if(input.Bill != null)
										{
											bill_rec = Bill[ID == input.Bill];
											if(bill_rec.ID != null)
											{
												bill_total = ifnull(bill_rec.Bill_Total,0.0);
												if(bill_total <= 0)
												{
													bill_total = ifnull(bill_rec.Amount_Due,0.0);
												}
												allowed_excess = 10.0;
												existing_total = 0.0;
												existing_lines = Bill_Details[Bill == bill_rec.ID];
												for each  row in existing_lines
												{
													if(input.ID != null && row.ID == input.ID)
													{
														continue;
													}
													existing_total = existing_total + ifnull(row.Line_Total,0.0);
												}
												current_line_total = 0.0;
												if(input.Quantity != null && input.Rate != null)
												{
													current_line_total = round(input.Quantity * input.Rate,2);
												}
												else
												{
													current_line_total = ifnull(input.Line_Total,0.0);
												}
												new_total = existing_total + current_line_total;
												excess_amount = new_total - bill_total;
												if(excess_amount > allowed_excess)
												{
													errors.add("• Details Total exceeds Bill Total by " + excess_amount.toString() + ". Maximum allowed excess is 10.");
												}
											}
										}
										if(errors.size() > 0)
										{
											msg = "Please fix the following:\n\n";
											for each  err_msg in errors
											{
												msg = msg + err_msg + "\n";
											}
											alert msg;
											cancel submit;
										}
						)
					}
				}

			}
			Set_Up_Form_On_Edit as "Set Up Form On Edit"
			{
				type =  form
				form = Voucher_Register

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------
										// 3) MODE + STATUS
										// ------------------------------
										is_create = input.ID == null;
										st = ifnull(input.Voucher_Status,"Issued");
										// Get selected voucher type from ONE lookup field: Voucher_Type
										voucherType = "";
										if(input.Voucher_Type != null)
										{
											voucherType = ifnull(input.Voucher_Type.Voucher_Type,"").trim();
										}
										// Optional: keep display name field synced if the field still exists
										input.Display_Name_Voucher_Type = voucherType;
										// =====================================================
										// NOTES CONTROL - DEFAULT HIDE
										// =====================================================
										hide Notes;
										hide Not_Created;
										hide Reason_Why_Not_Created;
										disable Reason_Why_Not_Created;
										// =====================================================
										// DEFAULT STATUS ON CREATE
										// =====================================================
										if(is_create && input.Voucher_Status == null)
										{
											input.Voucher_Status = "Issued";
											st = "Issued";
										}
										// =====================================================
										// ON CREATE
										// =====================================================
										if(is_create)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											enable Issued_By;
											enable Document_Type;
											enable Voucher_Type;
											enable Voucher_Number;
											enable Employee;
										}
										// =====================================================
										// ON EDIT + Status = ISSUED
										// =====================================================
										else if(!is_create && st == "Issued")
										{
											show Issued_By;
											show Site;
											show Voucher_Return;
											show Received_By;
											enable Received_By;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											if(voucherType == "Item Issuing Form")
											{
												show Asset;
												show Voucher_Issuing_Details;
											}
											if(voucherType == "Occurency Report")
											{
												show Voucher_Header;
												show Management_Location;
												enable Management_Location;
												show Incident_Details;
												enable Incident_Details.Time;
												enable Incident_Details.Incident_Type;
												enable Incident_Details.Incident;
											}
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
											{
												show Voucher_Header;
												show Employee_Receiving_Details;
												show Stock_Bundling_Note;
												show Stock_Bundling_Note.Asset;
												show Stock_Bundling_Note.Quantity_To_Be_Created;
												show Stock_Bundling_Note.Item;
												show Stock_Bundling_Note.Line_Number;
												enable Stock_Bundling_Note.Asset;
												enable Stock_Bundling_Note.Quantity_To_Be_Created;
												enable Stock_Bundling_Note.Item;
												show Notes;
												show Not_Created;
												enable Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
													enable Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
													disable Reason_Why_Not_Created;
												}
											}
											if(voucherType == "Store Receiving Book")
											{
												show Asset;
												show Voucher_Receiving_Details;
											}
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Display_Name_Issued_By;
												hide Received_By;
												hide Display_Name_Received_By;
												show Voucher_Return;
												show Date_Time_Out;
												show Hours_Worked;
												show Shift;
												enable Shift;
											}
										}
										// =====================================================
										// ON EDIT + Status = CLOSED
										// =====================================================
										else if(!is_create && st == "Closed")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Display_Name_Issued_By;
												hide Received_By;
												hide Display_Name_Received_By;
												show Manager_Section;
												show Manager_Time;
												show Cancel_Voucher;
												show Case_Number;
												show Employee_Taking_To_Head_Office;
												show How_to_Take_to_Head_Office;
												show Time_Sent_to_Head_Office;
												enable Case_Number;
												enable Employee_Taking_To_Head_Office;
												enable How_to_Take_to_Head_Office;
												enable Cancel_Voucher;
												if(input.Cancel_Voucher == true)
												{
													show Cancellation_Reason;
													enable Cancellation_Reason;
												}
												else
												{
													hide Cancellation_Reason;
												}
											}
										}
										// =====================================================
										// ON EDIT + Status = RETURNED
										// =====================================================
										else if(!is_create && st == "Returned")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Received_By;
												hide Display_Name_Received_By;
											}
											show Issued_By;
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											if(voucherType == "Cashier Envelope")
											{
												hide Voucher_Header;
												hide Voucher_Footer;
											}
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
											{
												show Employee_Issuing_Details;
												show Voucher_Header;
												show Quantity_To_Be_Created;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												show Quantity_Created;
												disable Asset;
												disable Item;
												disable Quantity_To_Be_Created;
												show Notes;
												show Not_Created;
												enable Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
													enable Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
													disable Reason_Why_Not_Created;
												}
												if(input.Allow_Excess_Material_Issued == true)
												{
													show Reason_Why_Material_Issued_Exceeded_Formula;
													enable Reason_Why_Material_Issued_Exceeded_Formula;
												}
												else
												{
													hide Reason_Why_Material_Issued_Exceeded_Formula;
												}
											}
											if(voucherType == "Drager Work Report")
											{
												show Voucher_Header;
												show Asset;
												show Machine_Start_Of_Day;
												show Start_Time;
												show Odometer_Start;
											}
											if(voucherType == "Item Issuing Form")
											{
												hide Employee_Issuing_Details;
												show Voucher_Issuing_Details;
												disable Voucher_Issuing_Details.Display_Name_Voucher;
