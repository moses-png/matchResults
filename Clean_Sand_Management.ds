			Finalize_On_Delete11 as "Finalize On Delete"
			{
				type =  form
				form = Service_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Bill != null)
										{
											bill_rec = Bill[ID == input.Bill];
											if(bill_rec.ID != null)
											{
												bill_details_total = 0.0;
												for each  bd in Bill_Details[Bill == bill_rec.ID]
												{
													bill_details_total = bill_details_total + ifnull(bd.Line_Total,0.0);
												}
												service_total = 0.0;
												for each  sd in Service_Details[Bill == bill_rec.ID && ID != input.ID]
												{
													service_total = service_total + ifnull(sd.Line_Total,0.0);
												}
												bill_rec.Services_Total=service_total;
												grand_total = bill_details_total + service_total;
												bill_rec.Total_Amount=grand_total;
												tax_amt = ifnull(bill_rec.Tax_Amount,0.0);
												disc_amt = ifnull(bill_rec.Discount_Amount,0.0);
												paid_amt = ifnull(bill_rec.Amount_Paid,0.0);
												gross_due = grand_total + tax_amt - disc_amt;
												if(gross_due < 0)
												{
													gross_due = 0.0;
												}
												bill_rec.Amount_Due=gross_due;
												balance_due = gross_due - paid_amt;
												if(balance_due < 0)
												{
													balance_due = 0.0;
												}
												bill_rec.Balance_Due=balance_due;
												if(grand_total > 0)
												{
													bill_rec.Bill_Status="Billed";
												}
												else
												{
													bill_rec.Bill_Status="Draft";
												}
												if(paid_amt <= 0)
												{
													bill_rec.Payment_Status="Not Paid";
												}
												else if(paid_amt < gross_due)
												{
													bill_rec.Payment_Status="Partially Paid";
												}
												else
												{
													bill_rec.Payment_Status="Paid";
												}
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete12 as "Finalize On Delete"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											payload = Map();
										payload.put("Source_Record_ID",input.ID.toLong());
										payload.put("Source_Form","Payment Receipt Voucher");
										resp = payment_management.deletePaymentVoucherFromConcrete(payload);
										info resp;
										payload = Map();
										payload.put("Source_Form","Payment Receipt Voucher");
										payload.put("Source_Record_ID",input.ID);
										resp = payment_management.deleteAccountTransactionLog(payload);
										info resp;
						)
					}
				}

			}
			Full_Validation_On_Create4 as "Full Validation On Create"
			{
				type =  form
				form = Customer_Deposit_Details

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// GENERATE CUSTOMER DEPOSIT NUMBER - INDEPENDENT FORM
										// =====================================================
										if(ifnull(input.Customer_Deposit_Number,"") == "")
										{
											prefix_key = "CAAA";
											seq = Sequences[Sequence_Key == prefix_key && Is_Active == true];
											if(seq.ID == null)
											{
												alert "Sequence not found for Customer Deposit Number.";
												cancel submit;
											}
											next_num = ifnull(seq.Next_Number,1);
											if(next_num > ifnull(seq.Max_Number,9999))
											{
												alert "Customer Deposit Number has reached the maximum limit.";
												cancel submit;
											}
											if(next_num < 10)
											{
												num_str = "000" + next_num;
											}
											else if(next_num < 100)
											{
												num_str = "00" + next_num;
											}
											else if(next_num < 1000)
											{
												num_str = "0" + next_num;
											}
											else
											{
												num_str = "" + next_num;
											}
											input.Customer_Deposit_Number = "CAAA" + num_str;
											input.Customer_Deposit_Date = zoho.currenttime;
											seq.Next_Number=next_num + 1;
										}
						)
					}
				}

			}
