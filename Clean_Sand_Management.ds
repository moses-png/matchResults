			Delete_Row_Product_Detail as "Delete Row Product Details"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on delete row of Product_Details
				{
					actions 
					{
						custom deluge script
						(
											line_no = 1;
										sub_total = 0;
										tax_total = 0;
										for each  r in input.Product_Details
										{
											r.Line_Number=line_no;
											line_no = line_no + 1;
											sub_total = sub_total + ifnull(r.Line_Total,0);
											tax_total = tax_total + ifnull(r.Tax_Amount,0);
										}
										input.Sub_Total = sub_total;
										input.Tax_Amount = tax_total;
										input.Grand_Total = input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0);
										input.Balance_Due = input.Grand_Total - ifnull(input.Amount_Paid,0) - ifnull(input.Amount_Credited,0);
						)
					}
				}

			}
			Finalize6 as "Finalize"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// FINALIZE SALES VOUCHER
										// =====================================================
										if(input.Sales_Type == "Sand Sales")
										{
											actual_item_id = null;
											if(input.Item != null)
											{
												product_price_rec = Product_Price_Register[ID == input.Item];
												if(product_price_rec.ID != null && product_price_rec.Item != null)
												{
													actual_item_id = product_price_rec.Item;
												}
											}
											if(actual_item_id == null)
											{
												info "The selected Product Price record has no linked Item.";
											}
											else
											{
												line_total = round(ifnull(input.Truck_CBM,0.0) * ifnull(input.Rate_per_CBM,0.0),2);
												existingLine = Sales_Voucher_Details[Sales_Voucher == input.ID];
												if(existingLine.count() == 0)
												{
													insert into Sales_Voucher_Details
													[
														Sales_Voucher=input.ID
														Display_Name_Sales_Voucher=input.Sales_Voucher_Number
														Line_Number=1
														Store_Item_Stock=input.Store_Item_Stock
														Store=input.Store
														Display_Name_Store=input.Display_Name_Store
														Quantity_Available=ifnull(input.Quantity_Available,0.0)
														Item=actual_item_id
														Display_Name_Item=input.Display_Name_Item
														Base_Unit_Of_Measure=input.Unit_Of_Measure
														Display_Name_Base_Unit_Of_Measure=input.Display_Name_Unit_Of_Measure
														Quantity=ifnull(input.Truck_CBM,0.0)
														Quantity_in_Base_Unit_Of_Measure=ifnull(input.Truck_CBM,0.0)
														Quantity_Issued_in_Base_Unit_Of_Measure=0
														Quantity_Not_Issued_in_Base_Unit_Of_Measure=ifnull(input.Truck_CBM,0.0)
														Issue_Status="Not Issued"
														Unit_Price=ifnull(input.Rate_per_CBM,0.0)
														Line_Total=line_total
														Tax_Amount=0
														Added_User=zoho.loginuser
													]
												}
												else
												{
													for each  sandLine in existingLine
													{
														sandLine.Store_Item_Stock=input.Store_Item_Stock;
														sandLine.Store=input.Store;
														sandLine.Display_Name_Store=input.Display_Name_Store;
														sandLine.Quantity_Available=ifnull(input.Quantity_Available,0.0);
														sandLine.Item=actual_item_id;
														sandLine.Display_Name_Item=input.Display_Name_Item;
														sandLine.Base_Unit_Of_Measure=input.Unit_Of_Measure;
														sandLine.Display_Name_Base_Unit_Of_Measure=input.Display_Name_Unit_Of_Measure;
														sandLine.Quantity=ifnull(input.Truck_CBM,0.0);
														sandLine.Quantity_in_Base_Unit_Of_Measure=ifnull(input.Truck_CBM,0.0);
														sandLine.Quantity_Issued_in_Base_Unit_Of_Measure=0;
														sandLine.Quantity_Not_Issued_in_Base_Unit_Of_Measure=ifnull(input.Truck_CBM,0.0);
														sandLine.Issue_Status="Not Issued";
														sandLine.Unit_Price=ifnull(input.Rate_per_CBM,0.0);
														sandLine.Line_Total=line_total;
														sandLine.Tax_Amount=ifnull(sandLine.Tax_Amount,0.0);
													}
												}
											}
										}
										// =====================================================
										// UPDATE SELECTED DELIVERY NOTE FROM SALES VOUCHER
										// =====================================================
										if(input.Delivery_Note != null)
										{
											truck_type_id = null;
											if(input.Truck_Type != null && input.Truck_Type.trim() != "")
											{
												truck_type_rec = Truck_Type[Truck_Type_Name == input.Truck_Type.trim()];
												if(truck_type_rec.ID != null)
												{
													truck_type_id = truck_type_rec.ID;
												}
											}
											dn = Delivery_Note[ID == input.Delivery_Note];
											if(dn.ID != null)
											{
												dn.Customer=input.Customer;
												dn.Display_Name_Customer=input.Display_Name_Customer;
												dn.Number_Plate=input.Number_Plate;
												dn.Truck_Type=truck_type_id;
												dn.TSF_Number=if(input.Number_Plate != null,ifnull(input.Number_Plate.TSF_Number,""),"");
												dn.Display_Name_Sales_Voucher=input.Sales_Voucher_Number;
											}
										}
										previous_payment_status = input.Payment_Status;
										// =====================================================
										// 1) RECALCULATE SALES VOUCHER DETAILS TOTALS
										// =====================================================
										details_sub_total = 0.0;
										tax_total = 0.0;
										for each  line in Sales_Voucher_Details[Sales_Voucher == input.ID]
										{
											details_sub_total = details_sub_total + ifnull(line.Line_Total,0.0);
											tax_total = tax_total + ifnull(line.Tax_Amount,0.0);
										}
										// =====================================================
										// 2) RECALCULATE SERVICES SUBFORM TOTALS
										// =====================================================
										services_total = 0.0;
										for each  srv in input.Services
										{
											service_line_total = ifnull(srv.Quantity,0.0) * ifnull(srv.Rate,0.0);
											services_total = services_total + service_line_total;
										}
										// =====================================================
										// 3) RECALCULATE PAYMENT RECEIPTS
										// =====================================================
										amount_paid_total = 0.0;
										amount_credited_total = 0.0;
										for each  pay in Payment_Receipt_Details[Sales_Voucher == input.ID]
										{
											amount_paid_total = amount_paid_total + ifnull(pay.Amount_Allocated,0.0);
											amount_credited_total = amount_credited_total + ifnull(pay.Amount_Credited,0.0);
										}
										amount_paid_total = round(amount_paid_total,2);
										amount_credited_total = round(amount_credited_total,2);
										input.Amount_Paid = amount_paid_total;
										input.Amount_Credited = amount_credited_total;
										total_settled = amount_paid_total + amount_credited_total;
										// =====================================================
										// 4) DETERMINE WHETHER INITIAL PAYMENT WAS CLEARED
										// =====================================================
										initial_payment_val = ifnull(input.Initial_Payment,0.0);
										initial_payment_cleared = false;
										if(previous_payment_status == "Paid" || previous_payment_status == "Credit")
										{
											initial_payment_cleared = true;
										}
										if(initial_payment_val > 0 && total_settled >= initial_payment_val)
										{
											initial_payment_cleared = true;
										}
										if(input.Actual_Payment != null && input.Actual_Payment > 0)
										{
											initial_payment_cleared = true;
										}
										// =====================================================
										// 5) VALIDATE AND CALCULATE WEIGHBRIDGE RESULTS
										// =====================================================
										valid_weighbridge = false;
										net_weight_val = ifnull(input.Net_Weight,0.0);
										gross_weight_val = ifnull(input.Gross_Weight,0.0);
										rate_per_ton_val = ifnull(input.Rate_per_Ton,0.0);
										if(initial_payment_cleared == true && input.Gross_Weight != null && net_weight_val > 0 && gross_weight_val > 0 && gross_weight_val >= net_weight_val && rate_per_ton_val > 0)
										{
											valid_weighbridge = true;
											input.Actual_Tonnes = round((gross_weight_val - net_weight_val) / 1000.0,2);
											input.Actual_Payment = round(input.Actual_Tonnes * rate_per_ton_val,2);
										}
										else
										{
											if(input.Gross_Weight == null || net_weight_val <= 0 || gross_weight_val <= 0)
											{
												input.Actual_Tonnes = null;
												input.Actual_Payment = null;
											}
										}
										// =====================================================
										// 6) DETERMINE SUBTOTAL
										// =====================================================
										if(valid_weighbridge == true)
										{
											sub_total = ifnull(input.Actual_Payment,0.0) + services_total;
										}
										else
										{
											sub_total = details_sub_total + services_total;
										}
										input.Sub_Total = round(sub_total,2);
										input.Tax_Amount = round(tax_total,2);
										// =====================================================
										// 7) DISCOUNT
										// =====================================================
										discount_amt = 0.0;
										if(input.Discount_Type == "Percentage")
										{
											discount_amt = round(input.Sub_Total * ifnull(input.Discount_Percentage,0.0) / 100.0,2);
										}
										else if(input.Discount_Type == "Amount")
										{
											discount_amt = ifnull(input.Discount_Amount,0.0);
										}
										input.Discount_Amount = round(discount_amt,2);
										// =====================================================
										// 8) GRAND TOTAL
										// =====================================================
										grand_total = round(input.Sub_Total + input.Tax_Amount - input.Discount_Amount,2);
										input.Grand_Total = grand_total;
										balance_due = round(grand_total - total_settled,2);
										input.Balance_Due = balance_due;
										// =====================================================
										// 10) PAYMENT STATUS
										// =====================================================
										if(input.Cancel_Voucher == true)
										{
											input.Payment_Status = "Cancelled";
										}
										else if(balance_due < 0 && total_settled > 0)
										{
											input.Payment_Status = "Over Paid";
										}
										else if(balance_due == 0 && total_settled > 0)
										{
											if(amount_credited_total > 0 && amount_paid_total == 0)
											{
												input.Payment_Status = "Credit";
											}
											else
											{
												input.Payment_Status = "Paid";
											}
										}
										else if(balance_due > 0 && amount_paid_total > 0)
										{
											input.Payment_Status = "Partially Paid";
										}
										else if(balance_due > 0 && amount_credited_total > 0)
										{
											input.Payment_Status = "Partially Credited";
										}
										else
										{
											input.Payment_Status = "Unpaid";
										}
										// =====================================================
										// 8) CREATE OR UPDATE BILL FOR SERVICES
										// =====================================================
										if(services_total > 0)
										{
											bill_id = null;
											bill_display_name = "Sales Voucher - " + input.Sales_Voucher_Number;
											existing_bill = Bill[Sales_Voucher == input.ID];
											if(existing_bill.ID != null)
											{
												existing_bill.Bill_Date=input.Sales_Voucher_Date;
												existing_bill.Bill_Type="Sales Voucher Bill";
												existing_bill.Customer=input.Customer;
												existing_bill.Sales_Voucher=input.ID;
												existing_bill.Display_Name_Vendor=input.Display_Name_Customer;
												existing_bill.Bill_Name="Sales Voucher";
												existing_bill.Bill_Number=input.Sales_Voucher_Number;
												existing_bill.Bill_Total=services_total;
												existing_bill.Services_Total=services_total;
												existing_bill.Total_Amount=services_total;
												existing_bill.Amount_Due=services_total;
												paid_bill = ifnull(existing_bill.Amount_Paid,0.0);
												bill_balance = services_total - paid_bill;
												if(bill_balance < 0)
												{
													bill_balance = 0.0;
												}
												existing_bill.Balance_Due=bill_balance;
												existing_bill.Bill_Status="Draft";
												if(paid_bill <= 0)
												{
													existing_bill.Payment_Status="Not Paid";
												}
												else if(bill_balance <= 0)
												{
													existing_bill.Payment_Status="Paid";
												}
												else
												{
													existing_bill.Payment_Status="Partially Paid";
												}
												bill_id = existing_bill.ID;
											}
											else
											{
												bill_id = insert into Bill
												[
													Bill_Date=input.Sales_Voucher_Date
													Bill_Type="Sales Voucher Bill"
													Customer=input.Customer
													Sales_Voucher=input.ID
													Display_Name_Vendor=input.Display_Name_Customer
													Bill_Name="Sales Voucher"
													Bill_Number=input.Sales_Voucher_Number
													Bill_Total=services_total
													Services_Total=services_total
													Total_Amount=services_total
													Amount_Due=services_total
													Amount_Paid=0.0
													Balance_Due=services_total
													Bill_Status="Draft"
													Payment_Status="Not Paid"
													Added_User=zoho.loginuser
												];
											}
											// =====================================================
											// 9) UPDATE SERVICES SUBFORM WITH BILL
											// =====================================================
											if(bill_id != null)
											{
												for each  srv in input.Services
												{
													srv.Bill=bill_id;
													srv.Display_Name_Voucher=bill_display_name;
												}
											}
										}
										// =====================================================
										// 10) POST SALES VOUCHER TOTALS TO BUSINESS DIVISION DETAILS
										// =====================================================
										post = Map();
										post.put("Display_Name_Application","Clean Sand Management");
										post.put("Source_Form","Sales Voucher");
										post.put("MSM_Sales_Voucher",input.ID);
										post.put("Source_Record_ID",input.ID.toString());
										post.put("Voucher_Number",input.Sales_Voucher_Number);
										post.put("Transaction_Date",input.Sales_Voucher_Date);
										post.put("Business_Division",null);
										post.put("Display_Name_Business_Division","");
										post.put("Amount_To_Receive",ifnull(input.Grand_Total,0.0));
										post.put("Amount_Received",0.0);
										post.put("Amount_Not_Received",ifnull(input.Grand_Total,0.0));
										post.put("Amount_To_Pay",0.0);
										post.put("Amount_Paid",0.0);
										post.put("Amount_Not_Paid",0.0);
										grapes_group.cleansandmanagement.postBusinessDivisionDetail(post);
										// =====================================================
										// UPDATE CUSTOMER PERFORMANCE
										// =====================================================
										if(input.Customer != null)
										{
											thisapp.customer.update_customer_performance(input.Customer);
										}
										if(input.ID != null)
										{
											old_rec = Sales_Voucher[ID == input.ID];
											if(old_rec.ID != null)
											{
												if(old_rec.Customer != null && old_rec.Customer != input.Customer)
												{
													thisapp.customer.update_customer_performance(old_rec.Customer);
												}
											}
										}
						)
					}
				}

			}
			Full_Validation_On_Delete as "Full Validation On Delete"
			{
				type =  form
				form = Sales_Voucher

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											payments = Payment_Receipt_Details[Sales_Voucher == input.ID];
										if(payments.count() > 0)
										{
											alert "This Sales Voucher has payment allocations and cannot be deleted.";
											cancel delete;
										}
						)
					}
				}

			}
