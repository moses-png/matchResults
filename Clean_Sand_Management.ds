			Full_Validation_On_Create3 as "Full Validation On Create"
			{
				type =  form
				form = Asset_Issues

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Issue_Number == null || input.Issue_Number.trim() == "")
										{
											doc_key = Document_Key[Voucher_Type == "Issue" && Document_Key_Status == "Active"];
											if(doc_key.ID == null)
											{
												alert "Document Key for Issue is not configured.";
												cancel submit;
											}
											prefix_value = ifnull(doc_key.Prefix,"ZCA-ISSUE");
											next_no = ifnull(doc_key.Next_Number,1);
											if(next_no < 10)
											{
												num_text = "000" + next_no;
											}
											else if(next_no < 100)
											{
												num_text = "00" + next_no;
											}
											else if(next_no < 1000)
											{
												num_text = "0" + next_no;
											}
											else
											{
												num_text = next_no.toString();
											}
											input.Issue_Number = prefix_value + "-" + num_text;
											doc_key.Next_Number=next_no + 1;
										}
										if(isNull(input.Number_Of_Work_Order_Tasks))
										{
											input.Number_Of_Work_Order_Tasks = 0;
										}
										if(isNull(input.Total_Service_Task_Cost))
										{
											input.Total_Service_Task_Cost = 0.0;
										}
										if(input.Asset != null)
										{
											input.Display_Name_Asset = ifnull(input.Asset.Display_Name_Asset_Name,"");
										}
										else
										{
											input.Display_Name_Asset = "";
										}
										// DEFAULTS FIRST
										if(input.Issue_Status == null)
										{
											input.Issue_Status = "Draft";
										}
										if(input.Work_Order_Status == null)
										{
											input.Work_Order_Status = "Draft";
										}
										if(input.Reported_Date == null)
										{
											input.Reported_Date = zoho.currenttime;
										}
										if(input.Asset == null)
										{
											alert "Asset is required.";
											cancel submit;
										}
										if(input.Odometer_Reading == null || input.Odometer_Reading <= 0)
										{
											alert "Odometer Reading is required.";
											cancel submit;
										}
										if(input.Issue == null || input.Issue.trim() == "")
										{
											alert "Issue is required.";
											cancel submit;
										}
										if(input.Issue_Description == null || input.Issue_Description.trim() == "")
										{
											alert "Issue Description is required.";
											cancel submit;
										}
										if(input.Severity == null)
										{
											alert "Severity is required.";
											cancel submit;
										}
										if(input.Issue_Status == null)
										{
											alert "Status is required.";
											cancel submit;
										}
										if(input.Reported_Date == null)
										{
											input.Reported_Date = zoho.currenttime;
										}
										mile_resp = asset_management.validateAssetMileage(input.Asset.ID,input.Odometer_Reading,input.Reported_Date,"Asset Issues",input.ID.toString());
										if(mile_resp.get("ok") != true)
										{
											alert mile_resp.get("message");
											cancel submit;
										}
										input.Odometer_Reading = mile_resp.get("Odometer_Reading");
						)
					}
				}

			}
