			Full_Validation34 as "Full Validation"
			{
				type =  form
				form = Service_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// SERVICE DETAILS - FULL VALIDATION
										// =======================================
										errors = List();
										if(input.Service == null)
										{
											errors.add("• Service is required.");
										}
										if(input.Bill == null)
										{
											errors.add("• Bill is required.");
										}
										description_text = ifnull(input.Description,"").trim();
										if(description_text == "")
										{
											errors.add("• Description is required.");
										}
										else if(description_text.length() < 20)
										{
											errors.add("• Description must contain at least 20 characters.");
										}
										if(input.Quantity == null || input.Quantity <= 0)
										{
											errors.add("• Quantity must be greater than 0.");
										}
										if(input.Rate == null || input.Rate <= 0)
										{
											errors.add("• Rate must be greater than 0.");
										}
										// =======================================
										// BLOCK SUBMISSION
										// =======================================
										if(errors.size() > 0)
										{
											error_message = "Please correct the following:\n\n";
											for each  error_text in errors
											{
												error_message = error_message + error_text + "\n";
											}
											alert error_message;
											cancel submit;
										}
						)
					}
				}

			}
