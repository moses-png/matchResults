			On_Job_Selected as "On Job Selected"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on user input of Job
				{
					actions 
					{
						custom deluge script
						(
											if(input.Job != null)
										{
											input.Display_Name_Job = input.Job.Job_No + " - " + input.Job.Job_Name;
											jobNo = input.Job.Job_No;
											// ==================================
											// TJS02 - Service Task
											// ==================================
											if(jobNo == "TJS02")
											{
												show Work_Order_Task;
												enable Work_Order_Task;
												hide Batch_Number_From;
												hide Batch_Number_To;
												hide Truck_Movement_Voucher;
												input.Batch_Number_From = null;
												input.Batch_Number_To = null;
												input.Truck_Movement_Voucher = null;
											}
											// ==================================
											// TJS03 - Stock Production
											// ==================================
											else if(jobNo == "TJS03")
											{
												show Batch_Number_From;
												enable Batch_Number_From;
												hide Work_Order_Task;
												hide Truck_Movement_Voucher;
												input.Work_Order_Task = null;
												input.Truck_Movement_Voucher = null;
											}
											// ==================================
											// TJS04 - Truck Movement
											// ==================================
											else if(jobNo == "TJS04")
											{
												show Truck_Movement_Voucher;
												enable Truck_Movement_Voucher;
												show Batch_Number_From;
												disable Batch_Number_From;
												show Batch_Number_To;
												disable Batch_Number_To;
												hide Work_Order_Task;
												input.Work_Order_Task = null;
											}
											// ==================================
											// DEFAULT
											// ==================================
											else
											{
												hide Work_Order_Task;
												hide Batch_Number_From;
												hide Batch_Number_To;
												hide Truck_Movement_Voucher;
												input.Work_Order_Task = null;
												input.Batch_Number_From = null;
												input.Batch_Number_To = null;
												input.Truck_Movement_Voucher = null;
											}
										}
										else
										{
											hide Work_Order_Task;
											hide Batch_Number_From;
											hide Batch_Number_To;
											hide Truck_Movement_Voucher;
											input.Work_Order_Task = null;
											input.Batch_Number_From = null;
											input.Batch_Number_To = null;
											input.Truck_Movement_Voucher = null;
											input.Display_Name_Job = null;
										}
						)
					}
				}

			}
			On_Odometer_End_Selected as "On Odometer End Selected"
