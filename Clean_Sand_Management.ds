											if(voucherType == "Supervisor Voucher")
											{
												hide Received_By;
												hide Display_Name_Received_By;
											}
											show Issued_By;
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											if(voucherType == "Cashier Envelope")
											{
												hide Voucher_Header;
												hide Voucher_Footer;
											}
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
