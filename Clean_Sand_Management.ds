			Full_Validation_On_Create3 as "Full Validation On Create"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											prefix_value = "FAA";
										if(input.ID == null && input.Fuel_Receiving_Voucher == null || input.Fuel_Receiving_Voucher.trim() == "")
										{
											new_voucher = asset_management.getNextSequence(prefix_value);
											if(new_voucher == null || new_voucher == "")
											{
												alert "Sequence not configured for " + prefix_value + " in Sequences form.";
												cancel submit;
											}
											dupe = Fuel_Receiving_Voucher[Fuel_Receiving_Voucher == new_voucher];
											if(dupe.count() > 0)
											{
												alert "Duplicate detected (" + new_voucher + "). Please try again.";
												cancel submit;
											}
											input.Fuel_Receiving_Voucher = new_voucher;
										}
						)
					}
				}

			}
			On_Asset_Selected3 as "On Asset Selected"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add or edit

				on user input of Asset
				{
					actions 
					{
						custom deluge script
						(
											if(input.Asset != null)
										{
											input.Display_Name_Asset = input.Asset.Asset_Name + " - " + input.Asset.Asset_ID;
											if(input.Fuel_Issuing_Time == null)
											{
												input.Fuel_Issuing_Time = zoho.currenttime;
											}
											if(input.Asset.Odometer_Unit_Of_Measure == "days")
											{
												// ==========================================
												// GET DAY ODOMETER FROM ASSET MANAGEMENT
												// ==========================================
												reported_date = input.Fuel_Issuing_Time.toDate();
												odo_result = asset_management.mileage.get_days_odometer_readings(input.Asset.ID,reported_date);
												if(odo_result != null && odo_result.get("ok") == true)
												{
													input.Odometer = ifnull(odo_result.get("reported_odometer"),0.0);
												}
												else
												{
													input.Odometer = 0.0;
													if(odo_result != null)
													{
														info odo_result.get("message");
													}
												}
												disable Odometer;
											}
											else
											{
												input.Odometer = null;
												enable Odometer;
											}
										}
										else
										{
											input.Display_Name_Asset = null;
											input.Odometer = null;
											enable Odometer;
										}
						)
					}
				}

			}
