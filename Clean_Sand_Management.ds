			On_Delivery_Location_Sele as "On Delivery Location Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Delivery_Location
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// CARD SALES
										// USER INPUT OF DELIVERY LOCATION
										// =====================================================
										if(input.Job != null && input.Job.Job_No == "TJS01")
										{
											if(input.Delivery_Location == "Company Sites")
											{
												show Site_To;
												show Site_Location_To;
												enable Site_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Display_Name_Party_To = "";
												input.Party_Location_To = null;
												input.Delivery_To = "";
											}
											else if(input.Delivery_Location == "Suppliers")
											{
												show Party_To;
												show Party_Location_To;
												enable Party_To;
												enable Party_Location_To;
												hide Site_To;
												hide Site_Location_To;
												input.Site_To = null;
												input.Display_Name_Site_To = "";
												input.Site_Location_To = null;
												input.Delivery_To = "";
											}
											else
											{
												hide Site_To;
												hide Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
												input.Site_To = null;
												input.Display_Name_Site_To = "";
												input.Site_Location_To = null;
												input.Party_To = null;
												input.Display_Name_Party_To = "";
												input.Party_Location_To = null;
												input.Delivery_To = "";
											}
										}
						)
					}
				}

			}
			Finalize24 as "Finalize"
			{
				type =  form
				form = Bill

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// MASAKA SITE MANAGEMENT BILL - FINALIZE
										// =====================================================
										if(input.Billed == true)
										{
											input.Bill_Status = "Billed";
											for each  row in input.Bill_Details
											{
												if(row.Bill_Details_Status != "Cancelled")
												{
													row.Bill_Details_Status="Billed";
												}
											}
											if(input.Bill_Number != null && input.Bill_Number.contains("Month"))
											{
												bill_total = ifnull(input.Bill_Total,0.0);
												total_quantity = 0.0;
												for each  row in input.Bill_Details
												{
													if(row.Bill_Details_Status != "Cancelled")
													{
														total_quantity = total_quantity + ifnull(row.Quantity,0.0);
													}
												}
												if(bill_total > 0 && total_quantity > 0)
												{
													rate_per_unit = bill_total / total_quantity;
													for each  row in input.Bill_Details
													{
														if(row.Bill_Details_Status != "Cancelled")
														{
															row.Rate=rate_per_unit;
														}
													}
												}
												services_total = 0.0;
												for each  service_row in input.Services
												{
													services_total = services_total + ifnull(service_row.Line_Total,0.0);
												}
												input.Services_Total = services_total;
												input.Total_Amount = bill_total + services_total;
												tax_amount = ifnull(input.Tax_Amount,0.0);
												discount_amount = ifnull(input.Discount_Amount,0.0);
												input.Amount_Due = input.Total_Amount + tax_amount - discount_amount;
												amount_paid = ifnull(input.Amount_Paid,0.0);
												input.Balance_Due = input.Amount_Due - amount_paid;
											}
										}
										else
										{
											input.Bill_Status = "Draft";
										}
										// ------------------------------------------------------------
										// REBUILD BACKDATED EMPLOYEE BILL WHEN BILLED
										// ------------------------------------------------------------
										if(input.ID != null && input.Billed == true && input.Bill_Type == "Employee Bill" && ifnull(input.Bill_Total,0.0) == 0)
										{
											processed_voucher_keys = List();
											sync_success_count = 0;
											sync_failed_count = 0;
											voucher_details = Bill_Details[Bill == input.ID && Source_Form == "Masaka Site Management - Voucher Register"];
											for each  bill_detail in voucher_details
											{
												if(bill_detail.Source_Record_ID != null)
												{
													voucher_id = bill_detail.Source_Record_ID;
													voucher_key = voucher_id.toString();
													if(!processed_voucher_keys.contains(voucher_key))
													{
														processed_voucher_keys.add(voucher_key);
														voucher_record = Voucher_Register[ID == voucher_id];
														if(voucher_record.ID != null)
														{
															try 
															{
																sync_response = thisapp.billing.syncEmployeeBilling(voucher_record.ID);
																info sync_response;
																if(sync_response != null && ifnull(sync_response.get("ok"),false) == true)
																{
																	sync_success_count = sync_success_count + 1;
																}
																else
																{
																	sync_failed_count = sync_failed_count + 1;
																}
															}					catch (sync_error)
															{
																sync_failed_count = sync_failed_count + 1;
																info sync_error;
															}
														}
														else
														{
															sync_failed_count = sync_failed_count + 1;
															info "Voucher was not found: " + voucher_key;
														}
													}
												}
											}
											// Recalculate after all voucher rates have been restored.
											total_response = thisapp.billing.recalculateBillTotals(input.ID);
											info total_response;
											info "Voucher sync successes: " + sync_success_count;
											info "Voucher sync failures: " + sync_failed_count;
										}
						)
					}
				}

			}
