			Finalize9 as "Finalize"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// FINALIZE SALES VOUCHER
										// =====================================================
										if(input.Sales_Type == "Sand Sales")
										{
											line_total = round(ifnull(input.Truck_CBM,0.0) * ifnull(input.Rate_per_CBM,0.0),2);
											existingLine = Sales_Voucher_Details[Sales_Voucher == input.ID];
											if(existingLine.count() == 0)
											{
												insert into Sales_Voucher_Details
												[
													Sales_Voucher=input.ID
													Display_Name_Sales_Voucher=input.Sales_Voucher_Number
													Line_Number=1
													Store_Item_Stock=input.Store_Item_Stock
													Store=input.Store
													Display_Name_Store=input.Display_Name_Store
													Quantity_Available=input.Quantity_Available
													Item=input.Item
													Display_Name_Item=input.Display_Name_Item
													Base_Unit_Of_Measure=input.Unit_Of_Measure
													Display_Name_Base_Unit_Of_Measure=input.Display_Name_Unit_Of_Measure
													Quantity=input.Truck_CBM
													Quantity_in_Base_Unit_Of_Measure=input.Truck_CBM
													Quantity_Issued_in_Base_Unit_Of_Measure=0
													Quantity_Not_Issued_in_Base_Unit_Of_Measure=input.Truck_CBM
													Issue_Status="Not Issued"
													Unit_Price=input.Rate_per_CBM
													Line_Total=line_total
													Tax_Amount=0
													Added_User=zoho.loginuser
												]
											}
											else
											{
												for each  sandLine in existingLine
												{
													sandLine.Store_Item_Stock=input.Store_Item_Stock;
													sandLine.Store=input.Store;
													sandLine.Display_Name_Store=input.Display_Name_Store;
													sandLine.Quantity_Available=input.Quantity_Available;
													sandLine.Item=input.Item;
													sandLine.Display_Name_Item=input.Display_Name_Item;
													sandLine.Base_Unit_Of_Measure=input.Unit_Of_Measure;
													sandLine.Display_Name_Base_Unit_Of_Measure=input.Display_Name_Unit_Of_Measure;
													sandLine.Quantity=input.Truck_CBM;
													sandLine.Quantity_in_Base_Unit_Of_Measure=input.Truck_CBM;
													sandLine.Quantity_Issued_in_Base_Unit_Of_Measure=0;
													sandLine.Quantity_Not_Issued_in_Base_Unit_Of_Measure=input.Truck_CBM;
													sandLine.Issue_Status="Not Issued";
													sandLine.Unit_Price=input.Rate_per_CBM;
													sandLine.Line_Total=line_total;
													sandLine.Tax_Amount=ifnull(sandLine.Tax_Amount,0);
												}
											}
										}
										// =====================================================
										// 1) RECALCULATE SALES VOUCHER DETAILS TOTALS
										// =====================================================
										sub_total = 0.0;
										tax_total = 0.0;
										for each  line in Sales_Voucher_Details[Sales_Voucher == input.ID]
										{
											sub_total = sub_total + ifnull(line.Line_Total,0.0);
											tax_total = tax_total + ifnull(line.Tax_Amount,0.0);
										}
										// =====================================================
										// 2) RECALCULATE SERVICES SUBFORM TOTALS
										// =====================================================
										services_total = 0.0;
										for each  srv in input.Services
										{
											line_total = ifnull(srv.Quantity,0.0) * ifnull(srv.Rate,0.0);
											services_total = services_total + line_total;
										}
										sub_total = sub_total + services_total;
										input.Sub_Total = sub_total;
										input.Tax_Amount = tax_total;
										// =====================================================
										// 3) DISCOUNT
										// =====================================================
										discount_amt = 0.0;
										if(input.Discount_Type == "Percentage")
										{
											discount_amt = sub_total * ifnull(input.Discount_Percentage,0.0) / 100;
										}
										else if(input.Discount_Type == "Amount")
										{
											discount_amt = ifnull(input.Discount_Amount,0.0);
										}
										input.Discount_Amount = discount_amt;
										// =====================================================
										// 4) GRAND TOTAL
										// =====================================================
										grand_total = sub_total + tax_total - discount_amt;
										if(grand_total < 0)
										{
											grand_total = 0.0;
										}
										input.Grand_Total = grand_total;
										// =====================================================
										// 5) PAYMENT RECEIPTS
										// =====================================================
										amount_paid_total = 0.0;
										amount_credited_total = 0.0;
										for each  pay in Payment_Receipt_Details[Sales_Voucher == input.ID]
										{
											amount_paid_total = amount_paid_total + ifnull(pay.Amount_Allocated,0.0);
											amount_credited_total = amount_credited_total + ifnull(pay.Amount_Credited,0.0);
										}
										input.Amount_Paid = amount_paid_total;
										input.Amount_Credited = amount_credited_total;
										// =====================================================
										// 6) BALANCE DUE
										// =====================================================
										balance_due = grand_total - amount_paid_total - amount_credited_total;
										if(balance_due < 0)
										{
											balance_due = 0.0;
										}
										input.Balance_Due = balance_due;
										// =====================================================
										// 7) PAYMENT STATUS
										// =====================================================
										if(input.Cancel_Voucher == true)
										{
											input.Payment_Status = "Cancelled";
										}
										else if(grand_total <= 0)
										{
											input.Payment_Status = "Unpaid";
										}
										else if(balance_due == 0)
										{
											if(amount_credited_total > 0 && amount_paid_total == 0)
											{
												input.Payment_Status = "Credit";
											}
											else
											{
												input.Payment_Status = "Paid";
											}
										}
										else if(amount_paid_total > 0)
										{
											input.Payment_Status = "Partially Paid";
										}
										else if(amount_credited_total > 0)
										{
											input.Payment_Status = "Partially Credited";
										}
										else
										{
											input.Payment_Status = "Unpaid";
										}
										// =====================================================
										// 8) CREATE OR UPDATE BILL FOR SERVICES
										// =====================================================
										if(services_total > 0)
										{
											bill_id = null;
											bill_display_name = "Sales Voucher - " + input.Sales_Voucher_Number;
											existing_bill = Bill[Sales_Voucher == input.ID];
											if(existing_bill.ID != null)
											{
												existing_bill.Bill_Date=input.Sales_Voucher_Date;
												existing_bill.Bill_Type="Sales Voucher Bill";
												existing_bill.Customer=input.Customer;
												existing_bill.Sales_Voucher=input.ID;
												existing_bill.Display_Name_Vendor=input.Display_Name_Customer;
												existing_bill.Bill_Name="Sales Voucher";
												existing_bill.Bill_Number=input.Sales_Voucher_Number;
												existing_bill.Bill_Total=services_total;
												existing_bill.Services_Total=services_total;
												existing_bill.Total_Amount=services_total;
												existing_bill.Amount_Due=services_total;
												paid_bill = ifnull(existing_bill.Amount_Paid,0.0);
												bill_balance = services_total - paid_bill;
												if(bill_balance < 0)
												{
													bill_balance = 0.0;
												}
												existing_bill.Balance_Due=bill_balance;
												existing_bill.Bill_Status="Draft";
												if(paid_bill <= 0)
												{
													existing_bill.Payment_Status="Not Paid";
												}
												else if(bill_balance <= 0)
												{
													existing_bill.Payment_Status="Paid";
												}
												else
												{
													existing_bill.Payment_Status="Partially Paid";
												}
												bill_id = existing_bill.ID;
											}
											else
											{
												bill_id = insert into Bill
												[
													Bill_Date=input.Sales_Voucher_Date
													Bill_Type="Sales Voucher Bill"
													Customer=input.Customer
													Sales_Voucher=input.ID
													Display_Name_Vendor=input.Display_Name_Customer
													Bill_Name="Sales Voucher"
													Bill_Number=input.Sales_Voucher_Number
													Bill_Total=services_total
													Services_Total=services_total
													Total_Amount=services_total
													Amount_Due=services_total
													Amount_Paid=0.0
													Balance_Due=services_total
													Bill_Status="Draft"
													Payment_Status="Not Paid"
													Added_User=zoho.loginuser
												];
											}
											// =====================================================
											// 9) UPDATE SERVICES SUBFORM WITH BILL
											// =====================================================
											if(bill_id != null)
											{
												for each  srv in input.Services
												{
													srv.Bill=bill_id;
													srv.Display_Name_Invoice=bill_display_name;
												}
											}
										}
										// =====================================================
										// 9) OPEN PAYMENT FORM
										// =====================================================
										if(input.Balance_Due > 0)
										{
											openUrl("#Form:Payment_Receipt_Details","same window");
										}
										// =====================================================
										// 10) POST SALES VOUCHER TOTALS TO BUSINESS DIVISION DETAILS
										// =====================================================
										post = Map();
										post.put("Display_Name_Application","Concrete Products Management");
										post.put("Source_Form","Sales Voucher");
										post.put("Source_Record_ID",input.ID.toString());
										post.put("Voucher_Number",input.Sales_Voucher_Number);
										post.put("CPM_Sales_Voucher",input.ID);
										post.put("Transaction_Date",input.Sales_Voucher_Date);
										post.put("Business_Division",null);
										post.put("Display_Name_Business_Division","");
										post.put("Amount_To_Receive",ifnull(input.Grand_Total,0.0));
										post.put("Amount_Received",0.0);
										post.put("Amount_Not_Received",ifnull(input.Grand_Total,0.0));
										post.put("Amount_To_Pay",0.0);
										post.put("Amount_Paid",0.0);
										post.put("Amount_Not_Paid",0.0);
										grapes_group.concreteproducts.postBusinessDivisionDetail(post);
										// =====================================================
										// UPDATE CUSTOMER PERFORMANCE
										// =====================================================
										if(input.Customer != null)
										{
											thisapp.customer.update_customer_performance(input.Customer);
										}
										if(input.ID != null)
										{
											old_rec = Sales_Voucher[ID == input.ID];
											if(old_rec.ID != null)
											{
												if(old_rec.Customer != null && old_rec.Customer != input.Customer)
												{
													thisapp.customer.update_customer_performance(old_rec.Customer);
												}
											}
										}
						)
					}
				}

			}
			Full_Validation_On_Create as "Full Validation On Create"
			{
				type =  form
				form = Sales_Voucher

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Sales_Voucher_Date == null)
										{
											input.Sales_Voucher_Date = zoho.currentdate;
										}
										if(input.Sales_Voucher_Number == null || input.Sales_Voucher_Number == "")
										{
											doc = Document_Key[Voucher_Type == "Sales Voucher" && Document_Key_Status == "Active"];
											if(doc.ID == null)
											{
												alert "No active Document Key found for Sales Voucher.";
												cancel submit;
											}
											next_no = ifnull(doc.Next_Number,1);
											if(next_no < 10)
											{
												num_txt = "0000" + next_no;
											}
											else if(next_no < 100)
											{
												num_txt = "000" + next_no;
											}
											else if(next_no < 1000)
											{
												num_txt = "00" + next_no;
											}
											else if(next_no < 10000)
											{
												num_txt = "0" + next_no;
											}
											else
											{
												num_txt = "" + next_no;
											}
											input.Sales_Voucher_Number = doc.Prefix + "-" + num_txt;
											doc.Next_Number=next_no + 1;
										}
										for each  row in input.Product_Details
										{
											row.Display_Name_Sales_Voucher=input.Sales_Voucher_Number;
										}
										//===================================================
										// GENERATION OF CARD NUMBERS
										//===================================================
										if(input.Sales_Type == "Sand Sales" && input.Card_Number == null || input.Card_Number == "")
										{
											seq = Sequences[Sequence_Key == "CB" && Is_Active == true];
											if(seq.ID == null)
											{
												alert "CBsequence not found.";
												cancel submit;
											}
											next_no = ifnull(seq.Next_Number,1);
											if(next_no > ifnull(seq.Max_Number,999))
											{
												alert "CB sequence has reached the maximum number (999).";
												cancel submit;
											}
											if(next_no < 10)
											{
												num = "00" + next_no;
											}
											else if(next_no < 100)
											{
												num = "0" + next_no;
											}
											else
											{
												num = "" + next_no;
											}
											input.Card_Number = "CB" + num;
											seq.Next_Number=next_no + 1;
										}
						)
					}
				}

			}
			On_Amount_Allocated_Selec as "On Amount Allocated Selected"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on user input of Amount_Allocated
				{
					actions 
					{
						custom deluge script
						(
											amount_allocated = ifnull(input.Amount_Allocated,0.0);
										// CASH DEPOSIT
										if(input.Payment_Document == "Cash Deposit" && input.Customer_Deposit_Voucher != null)
										{
											deposit_available = ifnull(input.Customer_Deposit_Voucher.Total_Amount_Not_Allocated,0.0);
											amount_due = ifnull(input.Amount_Due,0.0);
											input.Amount_Not_Allocated = deposit_available;
											if(amount_allocated > amount_due)
											{
												alert "Amount Allocated cannot be greater than Amount Due.";
												input.Amount_Allocated = amount_due;
												amount_allocated = amount_due;
											}
											if(amount_allocated > deposit_available)
											{
												alert "Amount Allocated cannot exceed Customer Deposit Available.";
												input.Amount_Allocated = deposit_available;
												amount_allocated = deposit_available;
											}
											input.Balance_Due = amount_due - amount_allocated;
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0.0;
											}
										}
										else if(input.Payment_Receipt_Voucher != null)
										{
											voucher_total = ifnull(input.Payment_Receipt_Voucher.Total_Amount_Received,0.0);
											already_allocated = 0.0;
											for each  rec in Payment_Receipt_Details[Payment_Receipt_Voucher == input.Payment_Receipt_Voucher && ID != input.ID]
											{
												already_allocated = already_allocated + ifnull(rec.Amount_Allocated,0.0);
											}
											available = voucher_total - already_allocated;
											if(available < 0)
											{
												available = 0.0;
											}
											input.Amount_Not_Allocated = available;
											if(input.Payment_Document == "Sales Voucher" || input.Payment_Document == "Invoice")
											{
												amount_due = ifnull(input.Amount_Due,0.0);
												if(amount_allocated > amount_due)
												{
													alert "Amount Allocated cannot be greater than Amount Due.";
													input.Amount_Allocated = amount_due;
													amount_allocated = amount_due;
												}
												input.Balance_Due = amount_due - amount_allocated;
												if(input.Balance_Due < 0)
												{
													input.Balance_Due = 0.0;
												}
											}
											if(amount_allocated > available)
											{
												alert "Amount Allocated cannot exceed Amount Not Allocated. Available amount is: " + available;
												input.Amount_Allocated = available;
												amount_allocated = available;
											}
										}
						)
					}
				}

			}
			On_Total_Amount_Received_ as "On Total Amount Received Selected"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on user input of Total_Amount_Received
				{
					actions 
					{
						custom deluge script
						(
											total_received = ifnull(input.Total_Amount_Received,0);
										total_charges = ifnull(input.Total_Charges,0);
										amount_allocated = ifnull(input.Total_Amount_Allocated,0);
										// Net amount available after charges
										net_received = total_received - total_charges;
										if(net_received < 0)
										{
											net_received = 0;
										}
										input.Total_Amount_Not_Allocated = net_received - amount_allocated;
										if(input.Total_Amount_Not_Allocated < 0)
										{
											input.Total_Amount_Not_Allocated = 0;
										}
						)
					}
				}

			}
			Add_Row_Charge_Details as "Add Row Charge Details"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on add row of Charge_Details
				{
					actions 
					{
						custom deluge script
						(
											max_line = 0;
										for each  r in input.Charge_Details
										{
											if(ifnull(r.Line_Number,0) > max_line)
											{
												max_line = r.Line_Number;
											}
										}
										row.Line_Number=max_line + 1;
										row.Transaction_Type="Payment Received";
										row.Display_Name_Payment_Voucher=ifnull(input.Payment_Receipt_Number,"");
										row.Amount=0;
						)
					}
				}

			}
			On_Amount_Selected as "On Amount Selected"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on user input of Charge_Details.Amount
				{
					actions 
					{
						custom deluge script
						(
											total_charges = 0.0;
										for each  chg in input.Charge_Details
										{
											total_charges = total_charges + ifnull(chg.Amount,0);
										}
										input.Total_Charges = total_charges;
										total_received = ifnull(input.Total_Amount_Received,0);
										total_allocated = ifnull(input.Total_Amount_Allocated,0);
										input.Total_Amount_Not_Allocated = total_received - total_charges - total_allocated;
										if(input.Total_Amount_Not_Allocated < 0)
										{
											input.Total_Amount_Not_Allocated = 0;
										}
						)
					}
				}

			}
			Delete_Row_Charge_Details as "Delete Row Charge Details"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on delete row of Charge_Details
				{
					actions 
					{
						custom deluge script
						(
											total_charges = 0.0;
										for each  chg in input.Charge_Details
										{
											total_charges = total_charges + ifnull(chg.Amount,0);
										}
										input.Total_Charges = total_charges;
										input.Total_Amount_Not_Allocated = ifnull(input.Total_Amount_Received,0) - ifnull(input.Total_Charges,0) - ifnull(input.Total_Amount_Allocated,0);
										if(input.Total_Amount_Not_Allocated < 0)
										{
											input.Total_Amount_Not_Allocated = 0;
										}
						)
					}
				}

			}
			On_Customer_Selected3 as "On Customer Selected"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											if(input.Customer != null)
										{
											input.Display_Name_Customer = input.Customer.Display_Name_Customer;
											input.Credit_Limit = ifnull(input.Customer.Credit_Limit,0);
											input.Current_Outstanding_Balance = ifnull(input.Customer.Current_Outstanding_Balance,0);
											input.Available_Credit = ifnull(input.Customer.Available_Credit,0);
											input.Credit_Days_Allowed = ifnull(input.Customer.Credit_Days_Allowed,0);
											input.Credit_Amount = ifnull(input.Balance_Due,0);
											if(input.Credit_Amount > input.Available_Credit)
											{
												input.Credit_Amount = input.Available_Credit;
											}
											input.Due_Date = zoho.currentdate.addDay(input.Credit_Days_Allowed);
										}
						)
					}
				}

			}
			On_Payment_Type_Selected as "On Payment Type Selected"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on user input of Payment_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Payment_Type == "Cash")
										{
											show Payment_Receipt_Voucher;
											show Amount_Not_Allocated;
											show Amount_Allocated;
											hide Credit_Note_Voucher;
											hide Amount_Credited;
											hide Customer_Deposit_Voucher;
										}
										else if(input.Payment_Type == "Credit")
										{
											hide Payment_Receipt_Voucher;
											show Credit_Note_Voucher;
											show Amount_Credited;
											hide Amount_Allocated;
											hide Amount_Not_Allocated;
											hide Customer_Deposit_Voucher;
										}
										else if(input.Payment_Type == "Cash Deposit")
										{
											show Amount_Not_Allocated;
											show Amount_Allocated;
											show Customer_Deposit_Voucher;
											hide Payment_Receipt_Voucher;
											hide Credit_Note_Voucher;
											hide Amount_Credited;
										}
										else
										{
											hide Payment_Receipt_Voucher;
											hide Credit_Note_Voucher;
											hide Amount_Allocated;
											hide Amount_Not_Allocated;
											hide Amount_Credited;
											hide Customer_Deposit_Voucher;
										}
						)
					}
				}

			}
			On_Credit_Note_Voucher_Se as "On Credit Note Voucher Selected"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on user input of Credit_Note_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Credit_Note_Voucher != null)
										{
											input.Display_Name_Voucher = input.Credit_Note_Voucher.Credit_Note_Number;
											input.Payment_Document = "Sales Voucher";
											input.Sales_Voucher = input.Credit_Note_Voucher.Sales_Voucher;
											if(input.Sales_Voucher != null)
											{
												input.Display_Name_Invoice_Voucher = input.Sales_Voucher.Sales_Voucher_Number;
											}
											input.Amount_Due = ifnull(input.Credit_Note_Voucher.Amount_Due,0);
											input.Amount_Credited = ifnull(input.Credit_Note_Voucher.Credit_Amount,0);
											input.Balance_Due = ifnull(input.Amount_Due,0) - ifnull(input.Amount_Credited,0);
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0;
											}
											disable Amount_Credited;
										}
										else
										{
											input.Display_Name_Voucher = "";
											input.Sales_Voucher = null;
											input.Display_Name_Invoice_Voucher = "";
											input.Amount_Due = 0;
											input.Amount_Credited = 0;
											input.Balance_Due = 0;
											enable Amount_Credited;
										}
						)
					}
				}

			}
			On_Sales_Voucher_Selected2 as "On Sales Voucher Selected"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on user input of Sales_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Sales_Voucher != null)
										{
											input.Display_Name_Sales_Voucher = input.Sales_Voucher.Sales_Voucher_Number;
											input.Customer = input.Sales_Voucher.Customer;
											input.Display_Name_Customer = input.Sales_Voucher.Display_Name_Customer;
											input.Amount_Due = ifnull(input.Sales_Voucher.Balance_Due,0);
											input.Credit_Amount = ifnull(input.Sales_Voucher.Balance_Due,0);
											input.Balance_Due = ifnull(input.Amount_Due,0) - ifnull(input.Credit_Amount,0);
										}
						)
					}
				}

			}
			On_Credit_Amount_Selected as "On Credit Amount Selected"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on user input of Credit_Amount
				{
					actions 
					{
						custom deluge script
						(
											credit_amount = ifnull(input.Credit_Amount,0);
										if(credit_amount > ifnull(input.Amount_Due,0))
										{
											input.Credit_Amount = input.Amount_Due;
											credit_amount = input.Amount_Due;
										}
										input.Balance_Due = ifnull(input.Amount_Due,0) - credit_amount;
						)
					}
				}

			}
			Full_Validation5 as "Full Validation"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Credit_Note_Date == null)
										{
											input.Credit_Note_Date = zoho.currentdate;
										}
										if(input.Credit_Note_Number == null || input.Credit_Note_Number == "")
										{
											doc = Document_Key[Voucher_Type == "Credit Note" && Document_Key_Status == "Active"];
											if(doc.ID == null)
											{
												alert "No active Document Key found for Credit Note.";
												cancel submit;
											}
											next_no = ifnull(doc.Next_Number,1);
											if(next_no < 10)
											{
												num_txt = "0000" + next_no;
											}
											else if(next_no < 100)
											{
												num_txt = "000" + next_no;
											}
											else if(next_no < 1000)
											{
												num_txt = "00" + next_no;
											}
											else if(next_no < 10000)
											{
												num_txt = "0" + next_no;
											}
											else
											{
												num_txt = "" + next_no;
											}
											input.Credit_Note_Number = doc.Prefix + num_txt;
											doc.Next_Number=next_no + 1;
										}
										if(input.Sales_Voucher == null)
										{
											alert "Sales Voucher is required.";
											cancel submit;
										}
										if(input.ID == null)
										{
											duplicate_credit_note = Credit_Note[Credit_Note_Number == input.Credit_Note_Number];
										}
										else
										{
											duplicate_credit_note = Credit_Note[Credit_Note_Number == input.Credit_Note_Number && ID != input.ID];
										}
										if(duplicate_credit_note.count() > 0)
										{
											alert "Credit Note Number already exists.";
											cancel submit;
										}
										if(input.Customer == null)
										{
											alert "Customer is required.";
											cancel submit;
										}
										if(ifnull(input.Amount_Due,0) <= 0)
										{
											alert "Amount Due must be greater than zero.";
											cancel submit;
										}
										if(ifnull(input.Credit_Amount,0) <= 0)
										{
											alert "Credit Amount must be greater than zero.";
											cancel submit;
										}
										if(input.Credit_Amount > input.Amount_Due)
										{
											alert "Credit Amount cannot be greater than Amount Due.";
											cancel submit;
										}
										if(input.Credit_Amount > ifnull(input.Available_Credit,0))
										{
											alert "Credit Amount cannot be greater than Available Credit.";
											cancel submit;
										}
										input.Balance_Due = ifnull(input.Amount_Due,0) - ifnull(input.Credit_Amount,0);
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0;
										}
										if(input.Credit_Days_Allowed == null || input.Credit_Days_Allowed < 0)
										{
											alert "Credit Days Allowed cannot be empty or negative.";
											cancel submit;
										}
										if(input.Due_Date == null)
										{
											input.Due_Date = input.Credit_Note_Date.addDay(input.Credit_Days_Allowed);
										}
						)
					}
				}

			}
			Finalize_On_Delete2 as "Finalize On Delete"
			{
				type =  form
				form = Purchase_Order

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------------------------------------
										// Purchase Order - Finalize On Delete
										// Delete Concrete PO Details and call Store Management
										// ------------------------------------------------------------
										source_record_id = input.ID.toString();
										source_form = "Concrete Products - Purchase Order";
										// 1) Delete Concrete Purchase Order Details
										po_details = Purchase_Order_Details[Purchase_Order == input.ID];
										for each  po_det in po_details
										{
											delete from Purchase_Order_Details[ID == po_det.ID];
										}
										// 2) Delete synced Store Purchase Order and Store PO Details
										resp = store_management.deletePurchaseOrderFromConcrete(source_record_id,source_form);
										info resp;
						)
					}
				}

			}
			Full_Validation3 as "Full Validation"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										if(input.PO_Type == null || input.PO_Type.trim() == "")
										{
											errors = errors + "\n• PO Type is required.";
										}
										if(input.PO_Type != "Internal Transfer" && input.Company == null)
										{
											errors = errors + "\n• Company is required.";
										}
										if(input.PO_Date == null)
										{
											errors = errors + "\n• PO Date is required.";
										}
										else if(input.PO_Date > zoho.currentdate)
										{
											errors = errors + "\n• PO Date cannot be in the future.";
										}
										if(input.PO_Details == null || input.PO_Details.count() == 0)
										{
											errors = errors + "\n• At least one Purchase Order Detail row is required.";
										}
										line_no = 0;
										for each  row in input.PO_Details
										{
											line_no = line_no + 1;
											if(row.Item == null)
											{
												errors = errors + "\n• Row " + line_no + ": Item is required.";
											}
											if(row.Quantity_Ordered == null || row.Quantity_Ordered <= 0)
											{
												errors = errors + "\n• Row " + line_no + ": Quantity Ordered must be greater than 0.";
											}
											if(row.Unit_Of_Measure == null)
											{
												errors = errors + "\n• Row " + line_no + ": Unit Of Measure is required.";
											}
											if(row.Unit_Cost == null || row.Unit_Cost < 0)
											{
												errors = errors + "\n• Row " + line_no + ": Unit Cost is required.";
											}
											//if(input.PO_Type == "Internal Transfer" && row.From_Store == null)
											//{
											//errors = errors + "\n• Row " + line_no + ": From Store is required for Internal Transfer.";
											//}
										}
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation4 as "Full Validation"
			{
				type =  form
				form = Item_Issuing_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Item Issuing Voucher - Validation On Create
										// =======================================
										// 1) Store is required
										if(input.Store == null)
										{
											alert "Please select the Store.";
											cancel submit;
										}
										// 2) Item Issuing Date is required
										if(input.Item_Issuing_Date == null)
										{
											alert "Item Issuing Date is missing. Check the selected Voucher record.";
											cancel submit;
										}
										// 3) Prevent duplicate Item Issuing Voucher
										if(input.Item_Issuing_Voucher != null)
										{
											dup_voucher = Item_Issuing_Voucher[Item_Issuing_Voucher == input.Item_Issuing_Voucher];
											if(dup_voucher.count() > 0)
											{
												alert "This Item Issuing Voucher has already been used.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Full_Validation6 as "Full Validation"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Item Issuing Details - Full Validation
										// Created or Edited
										// Create:
										//   Employee Voucher validates stock immediately
										//   Other types save Draft/Approved without stock blocking
										// Edit:
										//   Non-employee validates stock only Approved -> Issued
										//   Employee Voucher validates stock when issuing/borrowed
										// =======================================
										errors = List();
										hdr = null;
										old_rec = null;
										req_type = "";
										stock_cond = "";
										qty_val = 0.0;
										new_base_qty = null;
										old_base_qty = 0.0;
										extra_needed = 0.0;
										store_stock = 0.0;
										is_tool = false;
										current_status = ifnull(input.Status,"").trim();
										saved_status = "";
										if(input.ID != null)
										{
											old_rec = Item_Issuing_Details[ID == input.ID];
											if(old_rec.ID != null)
											{
												saved_status = ifnull(old_rec.Status,"").trim();
											}
										}
										// 1) ISSUING VOUCHER
										if(input.Issuing_Voucher == null)
										{
											errors.add("• Please select the Issuing Voucher.");
										}
										else
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID == null)
											{
												errors.add("• Selected Issuing Voucher was not found.");
											}
											else if(hdr.Store == null)
											{
												errors.add("• The selected Issuing Voucher has no Store.");
											}
										}
										// 2) LINE NUMBER
										if(input.Line_Number == null || input.Line_Number <= 0)
										{
											errors.add("• Line Number is required.");
										}
										// 3) DUPLICATE LINE NUMBER
										if(input.Issuing_Voucher != null && input.Line_Number != null && input.Line_Number > 0)
										{
											dup = Item_Issuing_Details[Issuing_Voucher == input.Issuing_Voucher && Line_Number == input.Line_Number && ID != input.ID];
											if(dup.count() > 0)
											{
												errors.add("• Line Number " + input.Line_Number + " is already used.");
											}
										}
										// 4) REQUEST VOUCHER TYPE
										req_type = ifnull(input.Request_Voucher_Type,"").trim();
										if(req_type == "")
										{
											errors.add("• Please select Request Voucher Type.");
										}
										// 5) SOURCE VALIDATION
										if(req_type == "Employee Voucher" && input.Employee_Voucher == null)
										{
											errors.add("• Please select Employee Voucher.");
										}
										else if(req_type == "Work Order Task" && input.Work_Order_Task == null)
										{
											errors.add("• Please select Work Order Task.");
										}
										if(req_type == "Sales Voucher" || req_type == "Sand Sales" || req_type == "Stock Sales")
										{
											if(input.Sales_Voucher == null)
											{
												alert "Sales Voucher is required.";
												cancel submit;
											}
											if(input.Item_Taken == null)
											{
												alert "Item Taken is required.";
												cancel submit;
											}
											if(input.Items_Image == null)
											{
												alert "Items Image is required.";
												cancel submit;
											}
											if(input.Item == null)
											{
												alert "Item could not be resolved from Item Taken.";
												cancel submit;
											}
											if(input.Stock_Condition == null || input.Stock_Condition.trim() == "")
											{
												alert "Stock Condition is required.";
												cancel submit;
											}
											if(input.Unit_Of_Measure == null)
											{
												alert "Unit Of Measure is required.";
												cancel submit;
											}
											if(input.Cost == null || input.Cost < 0)
											{
												alert "Cost is required.";
												cancel submit;
											}
											if(input.Store_Available_Stock == null)
											{
												alert "Store Available Stock is missing.";
												cancel submit;
											}
											if(input.Global_Available_Stock == null)
											{
												alert "Global Available Stock is missing.";
												cancel submit;
											}
										}
										// 6) ITEM
										if(input.Item == null)
										{
											errors.add("• Please select the Item.");
										}
										// 7) STOCK CONDITION DEFAULT
										stock_cond = ifnull(input.Stock_Condition,"").trim();
										if(stock_cond == "")
										{
											input.Stock_Condition = "New";
											stock_cond = "New";
										}
										// 8) UNIT OF MEASURE
										if(input.Unit_Of_Measure == null)
										{
											errors.add("• Please select Unit Of Measure.");
										}
										// 9) QUANTITY
										if(input.Quantity == null)
										{
											errors.add("• Quantity must be greater than zero.");
										}
										else
										{
											qty_val = input.Quantity.toDecimal();
											if(qty_val <= 0)
											{
												errors.add("• Quantity must be greater than zero.");
											}
										}
										// 10) TAKEN BY
										if(input.Taken_By == null)
										{
											errors.add("• Please select who took the item.");
										}
										// 11) UOM CONVERSION + BASE QTY
										if(input.Item != null && input.Unit_Of_Measure != null && input.Quantity != null && qty_val > 0)
										{
											check = store_management.po.check_uom_conversion_from_concrete(input.Item,input.Unit_Of_Measure);
											if(check == null || check.get("ok") != true)
											{
												errors.add("• " + ifnull(check.get("message"),"UOM conversion failed."));
											}
											else
											{
												tmp_base_qty = store_management.po.convert_to_base_qty_from_concrete(input.Item,input.Unit_Of_Measure,input.Quantity);
												if(tmp_base_qty == null)
												{
													errors.add("• Calculated base quantity is invalid.");
												}
												else
												{
													new_base_qty = tmp_base_qty.toDecimal();
													if(new_base_qty <= 0)
													{
														errors.add("• Calculated base quantity is invalid.");
													}
													else
													{
														input.Quantity_in_Base_Unit_Of_Measure = new_base_qty;
													}
												}
											}
										}
										// 12) STOCK VALIDATION
										should_validate_stock = false;
										if(req_type == "Employee Voucher")
										{
											if(input.ID == null)
											{
												should_validate_stock = true;
											}
											else if(current_status == "Approved" || current_status == "Issued" || current_status == "Borrowed")
											{
												should_validate_stock = true;
											}
										}
										else
										{
											if(input.ID != null && saved_status == "Approved" && current_status == "Approved")
											{
												should_validate_stock = true;
											}
										}
										if(should_validate_stock == true)
										{
											if(hdr != null && hdr.ID != null && hdr.Store != null && input.Item != null && new_base_qty != null && new_base_qty > 0)
											{
												stock_map = store_management.po.get_item_store_cost_from_concrete(input.Item,hdr.Store,stock_cond);
												store_stock = ifnull(stock_map.get("store_stock"),0.0).toDecimal();
												input.Store_Available_Stock = store_stock;
												input.Global_Available_Stock = ifnull(stock_map.get("global_stock"),0.0);
												old_base_qty = 0.0;
												if(input.ID != null && old_rec != null && old_rec.ID != null)
												{
													old_base_qty = ifnull(old_rec.Quantity_in_Base_Unit_Of_Measure,0.0).toDecimal();
												}
												if(req_type != "Employee Voucher" && saved_status == "Approved")
												{
													old_base_qty = 0.0;
												}
												extra_needed = new_base_qty - old_base_qty;
												if(extra_needed < 0)
												{
													extra_needed = 0.0;
												}
												if(extra_needed > 0)
												{
													if(store_stock <= 0)
													{
														errors.add("• No stock available in this Store for " + stock_cond + " condition.");
													}
													else if(extra_needed > store_stock)
													{
														errors.add("• Insufficient store stock. Required: " + extra_needed + " (Base UoM). Available: " + store_stock + " (Base UoM).");
													}
												}
											}
										}
										// 13) TOOL CHECK
										if(input.Item != null)
										{
											if(input.Item.Is_Tool == true)
											{
												is_tool = true;
											}
										}
										// 14) LINE TOTAL VALIDATION
										calc_line_total = ifnull(input.Quantity,0.0) * ifnull(input.Cost,0.0);
										if(is_tool == false && stock_cond != "Used")
										{
											if(calc_line_total <= 0)
											{
												errors.add("• Line Total cannot be zero. Please check Quantity or Cost.");
											}
										}
										else
										{
											if(input.Line_Total == null)
											{
												input.Line_Total = 0.0;
											}
										}
										// 15) TOOL RETURN DATE VALIDATION
										if(is_tool && req_type != "Internal Transfer" && input.Expected_Return_Date == null)
										{
											errors.add("• Expected Return Date is required for tools unless Request Voucher Type is Internal Transfer.");
										}
										// 16) EDIT ONLY CANCELLATION VALIDATION
										if(input.ID != null && input.Cancel_This_Line_Item == true)
										{
											if(input.Reason_Why_Cancelled == null || input.Reason_Why_Cancelled.trim() == "")
											{
												errors.add("• Please enter the reason why this line item was cancelled.");
											}
										}
										// FINAL
										if(errors.isEmpty() == false)
										{
											msg = "Please fix the following:\n\n";
											for each  err in errors
											{
												msg = msg + err + "\n";
											}
											alert msg;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation7 as "Full Validation"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// CONCRETE STOCK RECEIVING DETAILS
										// FULL VALIDATION
										// =======================================
										errors = List();
										rtype = ifnull(input.Receiving_Type,"").trim();
										stock_cond = ifnull(input.Stock_Condition,"").trim();
										qty_received = ifnull(input.Quantity_Received,0.0);
										old_rec = null;
										if(input.ID != null)
										{
											old_rec = Stock_Receiving_Details[ID == input.ID];
										}
										// COMMON REQUIRED
										if(input.Stock_Receiving_Voucher == null)
										{
											errors.add("• Please select the Stock Receiving Voucher.");
										}
										else
										{
											srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
											if(srv.ID == null || srv.Store == null)
											{
												errors.add("• The selected Stock Receiving Voucher has no destination Store.");
											}
											else
											{
												destination_store = srv.Store;
											}
										}
										if(input.Stock_Receiving_Voucher_Number == null || input.Stock_Receiving_Voucher_Number <= 0)
										{
											errors.add("• Stock Receiving Voucher Number is required.");
										}
										if(rtype == "")
										{
											errors.add("• Please select Receiving Type.");
										}
										if(stock_cond == "")
										{
											errors.add("• Stock Condition is required.");
										}
										if(qty_received <= 0)
										{
											errors.add("• Quantity Received must be greater than zero.");
										}
										if(input.Unit_Of_Measure_Received == null)
										{
											errors.add("• Unit Of Measure Received is required.");
										}
										actual_item_id = null;
										actual_item_rec = null;
										po_det = null;
										issue_rec = null;
										selected_issue_id = null;
										// =======================================
										// RECEIVING TYPE VALIDATION
										// =======================================
										if(rtype == "Purchase Order")
										{
											if(input.Purchase_Order == null)
											{
												errors.add("• Purchase Order is required.");
											}
											else if(input.Item == null)
											{
												errors.add("• Purchase Order line Item is required.");
											}
											else
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID == null || po_det.Item == null)
												{
													errors.add("• The selected Purchase Order line is invalid.");
												}
												else
												{
													actual_item_id = po_det.Item;
													po_stock_cond = ifnull(po_det.Stock_Condition,"").trim();
													if(po_stock_cond == "")
													{
														errors.add("• The selected Purchase Order line has no Stock Condition.");
													}
													else if(stock_cond != po_stock_cond)
													{
														errors.add("• Stock Condition must match PO line. PO has: " + po_stock_cond + ".");
													}
												}
											}
											if(input.Voucher != null || input.Stock_Created != null || input.Stock_Return_Number != null || input.Tool_Return_Number != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Purchase Order, only Purchase Order fields should be filled.");
											}
										}
										else if(rtype == "Stock Receiving Note" || rtype == "Stock Bundling Note")
										{
											if(input.Voucher == null)
											{
												errors.add("• Voucher is required.");
											}
											else if(input.Stock_Created == null)
											{
												errors.add("• Stock Created is required.");
											}
											else if(input.Stock_Created.Item == null)
											{
												errors.add("• Stock Created has no linked Item.");
											}
											else
											{
												actual_item_id = input.Stock_Created.Item.ID;
												actual_item_rec = input.Stock_Created.Item;
											}
											if(input.Purchase_Order != null || input.Item != null || input.Stock_Return_Number != null || input.Tool_Return_Number != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Stock Receiving/Bundling Note, PO and Item Issuing fields must be blank.");
											}
										}
										// -----------------------------------------------------
										// INTERNAL TRANSFER
										// -----------------------------------------------------
										else if(rtype == "Internal Transfer")
										{
											if(input.Internal_Transfer_Number == null)
											{
												errors.add("• Internal Transfer Number is required.");
											}
											else if(input.Transfer_Item == null)
											{
												errors.add("• Stock Transfer Item is required.");
											}
											else
											{
												transfer_qty = ifnull(input.Transfer_Item.Quantity,0.0);
												transfer_received_qty = ifnull(input.Transfer_Item.Quantity_Received,0.0);
												transfer_remaining_qty = transfer_qty - transfer_received_qty;
												if(transfer_remaining_qty < 0)
												{
													transfer_remaining_qty = 0.0;
												}
												transfer_base_qty = ifnull(input.Transfer_Item.Quantity_in_Base_Unit_Of_Measure,0.0);
												transfer_base_received_qty = ifnull(input.Transfer_Item.Quantity_Received_in_Base_Unit_Of_Measure,0.0);
												transfer_base_remaining_qty = transfer_base_qty - transfer_base_received_qty;
												if(transfer_base_remaining_qty < 0)
												{
													transfer_base_remaining_qty = 0.0;
												}
												transfer_uom_id = input.Transfer_Item.Unit_Of_Measure;
												transfer_status = ifnull(input.Transfer_Item.Receiving_Status,"Not Received");
												source_store = input.Transfer_Item.Issuing_Store;
												transfer_stock_condition = ifnull(input.Transfer_Item.Stock_Condition,"");
												actual_item_id = input.Transfer_Item.Item;
											}
											if(input.Purchase_Order != null || input.Item != null || input.Voucher != null || input.Stock_Return_Number != null || input.Tool_Return_Number != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Internal Transfer receiving, only Internal Transfer fields should be filled.");
											}
										}
										else if(rtype == "Stock Return")
										{
											if(input.Stock_Return_Number == null)
											{
												errors.add("• Item Issuing Number is required.");
											}
											else if(input.Item_Issuing_Details == null)
											{
												errors.add("• Item Issuing Details is required.");
											}
											else
											{
												selected_issue_id = input.Item_Issuing_Details;
												issue_rec = Item_Issuing_Details[ID == selected_issue_id];
												if(issue_rec.ID == null || issue_rec.Item == null)
												{
													errors.add("• The selected Item Issuing Details record is invalid.");
												}
												else
												{
													actual_item_id = issue_rec.Item;
												}
											}
											if(input.Purchase_Order != null || input.Item != null || input.Voucher != null || input.Stock_Created != null || input.Tool_Return_Number != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Stock Return, only Stock Return fields should be filled.");
											}
										}
										else if(rtype == "Tool Return")
										{
											if(input.Tool_Return_Number == null)
											{
												errors.add("• Item Issuing Number is required.");
											}
											else if(input.Item_Issuing_Details == null)
											{
												errors.add("• Item Issuing Details is required.");
											}
											else
											{
												selected_issue_id = input.Item_Issuing_Details;
												issue_rec = Item_Issuing_Details[ID == selected_issue_id];
												if(issue_rec.ID == null || issue_rec.Item == null)
												{
													errors.add("• The selected Item Issuing Details record is invalid.");
												}
												else
												{
													actual_item_id = issue_rec.Item;
												}
											}
											if(input.Purchase_Order != null || input.Item != null || input.Voucher != null || input.Stock_Created != null || input.Stock_Return_Number != null || input.Item_Issuing_Details != null)
											{
												errors.add("• For Tool Return, only Tool Return fields should be filled.");
											}
										}
										else if(rtype != "")
										{
											errors.add("• Unsupported Receiving Type.");
										}
										// UOM + BASE QTY
										base_qty = null;
										input.Quantity_in_Base_Unit_Of_Measure_Received = null;
										if(actual_item_id != null && input.Unit_Of_Measure_Received != null && qty_received > 0)
										{
											check = store_management.po.check_uom_conversion_from_concrete(actual_item_id,input.Unit_Of_Measure_Received);
											if(check == null || check.get("ok") != true)
											{
												errors.add("• " + ifnull(check.get("message"),"UOM conversion failed."));
											}
											else
											{
												base_qty = store_management.po.convert_to_base_qty_from_concrete(actual_item_id,input.Unit_Of_Measure_Received,input.Quantity_Received);
												if(base_qty == null || base_qty <= 0)
												{
													errors.add("• Calculated base quantity is invalid.");
												}
												else
												{
													input.Quantity_in_Base_Unit_Of_Measure_Received = base_qty;
												}
											}
										}
										// PO LIMIT
										if(rtype == "Purchase Order" && po_det != null && po_det.ID != null)
										{
											qty_remaining = ifnull(po_det.Quantity_Remaining,0.0);
											old_qty_this_row = 0.0;
											if(old_rec != null && old_rec.ID != null)
											{
												old_qty_this_row = ifnull(old_rec.Quantity_Received,0.0);
											}
											max_allowed = qty_remaining + old_qty_this_row;
											if(qty_received > max_allowed)
											{
												errors.add("• You cannot receive more than Quantity Remaining. Maximum allowed: " + max_allowed + ".");
											}
										}
										// TRANSFER / RETURN RULES
										is_transfer_return = false;
										if(rtype == "Internal Transfer")
										{
											is_transfer_return = true;
										}
										else if(rtype == "Stock Return")
										{
											is_transfer_return = true;
										}
										else if(rtype == "Tool Return")
										{
											is_transfer_return = true;
										}
										if(is_transfer_return == true && issue_rec != null && issue_rec.ID != null)
										{
											if(ifnull(issue_rec.Status,"") == "Cancelled")
											{
												errors.add("• Cancelled issuing records cannot be received.");
											}
											issued_qty = ifnull(issue_rec.Quantity,0.0);
											returned_qty = ifnull(issue_rec.Quantity_Returned,0.0);
											remaining_issue_qty = issued_qty - returned_qty;
											if(remaining_issue_qty < 0)
											{
												remaining_issue_qty = 0.0;
											}
											if(remaining_issue_qty <= 0)
											{
												errors.add("• This issuing record has already been fully received.");
											}
											else if(qty_received > remaining_issue_qty)
											{
												errors.add("• You cannot receive more than the remaining issued quantity.");
											}
											if(issue_rec.Unit_Of_Measure != null && input.Unit_Of_Measure_Received != null && input.Unit_Of_Measure_Received != issue_rec.Unit_Of_Measure)
											{
												errors.add("• Unit Of Measure Received must match the issued Unit Of Measure.");
											}
											if(rtype == "Internal Transfer")
											{
												existing_transfer = Stock_Receiving_Details[Receiving_Type == "Internal Transfer" && Transfer_Item == selected_issue_id && ID != input.ID];
												if(existing_transfer.count() > 0)
												{
													errors.add("• This Item Issuing Details record has already been received as an Internal Transfer.");
												}
												if(input.Quantity_to_Receive != null && qty_received != input.Quantity_to_Receive)
												{
													errors.add("• For Internal Transfer, Quantity Received must exactly match Quantity to Receive.");
												}
												source_store = null;
												if(issue_rec.Issuing_Voucher != null)
												{
													iss_hdr = Item_Issuing_Voucher[ID == issue_rec.Issuing_Voucher];
													if(iss_hdr.ID != null)
													{
														source_store = ifnull(iss_hdr.Display_Name_Store,"").trim();
													}
												}
												if(srv != null && srv.ID != null)
												{
													destination_store_name = ifnull(srv.Display_Name_Store,"").trim();
												}
												if(source_store == "")
												{
													errors.add("• The source Item Issuing Voucher has no Store.");
												}
												else if(destination_store_name != "" && source_store == destination_store_name)
												{
													errors.add("• Source Store and Destination Store cannot be the same for Internal Transfer.");
												}
											}
											else if(rtype == "Stock Return")
											{
											}
											else if(rtype == "Tool Return")
											{
												if(stock_cond == "New")
												{
													errors.add("• Tool Return cannot be received as New.");
												}
											}
										}
										if(errors.size() > 0)
										{
											msg = "Please fix the following:\n\n";
											for each  err_msg in errors
											{
												msg = msg + err_msg + "\n";
											}
											alert msg;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation8 as "Full Validation"
			{
				type =  form
				form = Stock_Receiving_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Stock Receiving Voucher Validation
										// On Create / On Validate
										// =======================================
										// 1) Stock Receiving Book required
										if(input.Stock_Receiving_Book == null)
										{
											alert "Please select Stock Receiving Book.";
											cancel submit;
										}
										// 2) Store required
										if(input.Store == null)
										{
											alert "Please select the Store.";
											cancel submit;
										}
										// 3) Received By required
										if(input.Received_By == null || input.Received_By.trim() == "")
										{
											alert "Received By is required.";
											cancel submit;
										}
										// 4) Prevent duplicate Stock Receiving Book only
										existing_rec = Stock_Receiving_Voucher[Stock_Receiving_Book == input.Stock_Receiving_Book && ID != input.ID];
										if(existing_rec.ID != null)
										{
											alert "This Stock Receiving Book has already been used.";
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation9 as "Full Validation"
			{
				type =  form
				form = Bill

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Bill (Parent) - ON VALIDATE
										// =======================================
										// 1) Bill Date required + cannot be future
										if(input.Bill_Date == null)
										{
											alert "Bill Date is required.";
											cancel submit;
										}
										else if(input.Bill_Date > zoho.currentdate)
										{
											alert "Bill Date cannot be in the future.";
											cancel submit;
										}
										// 2) Bill Type based required fields
										if(input.Bill_Type == "Store Bill")
										{
											if(input.Vendor == null)
											{
												alert "Vendor is required for Store Bill.";
												cancel submit;
											}
										}
										else if(input.Bill_Type == "Employee Bill")
										{
											if(input.Employee_Vendor == null)
											{
												alert "Employee Vendor is required for Employee Bill.";
												cancel submit;
											}
										}
										else if(input.Bill_Type == "Sales Voucher Bill")
										{
											if(input.Sales_Voucher == null)
											{
												alert "Sales Voucher is required for Sales Voucher Bill.";
												cancel submit;
											}
										}
										// 3) Bill Name required
										if(isnull(input.Bill_Name) || input.Bill_Name.trim() == "")
										{
											alert "Bill Name is required.";
											cancel submit;
										}
										// 4) Bill Number required
										if(isnull(input.Bill_Number) || input.Bill_Number.trim() == "")
										{
											alert "Bill Number is required.";
											cancel submit;
										}
										// ===============================
										// PREVENT DUPLICATE BILL ENTRY
										// ===============================
										if(input.Bill_Type == "Store Bill")
										{
											dup = Bill[Bill_Number == input.Bill_Number && Bill_Name == input.Bill_Name && Vendor == input.Vendor && Bill_Type == input.Bill_Type && ID != input.ID];
											if(dup.count() > 0)
											{
												alert "Duplicate Store Bill detected.";
												cancel submit;
											}
										}
										else if(input.Bill_Type == "Employee Bill")
										{
											dup = Bill[Bill_Number == input.Bill_Number && Bill_Name == input.Bill_Name && Employee_Vendor == input.Employee_Vendor && Bill_Type == input.Bill_Type && ID != input.ID];
											if(dup.count() > 0)
											{
												alert "Duplicate Employee Bill detected.";
												cancel submit;
											}
										}
										else if(input.Bill_Type == "Sales Voucher Bill")
										{
											dup = Bill[Bill_Number == input.Bill_Number && Bill_Name == input.Bill_Name && Sales_Voucher == input.Sales_Voucher && Bill_Type == input.Bill_Type && ID != input.ID];
											if(dup.count() > 0)
											{
												alert "Duplicate Sales Voucher Bill detected.";
												cancel submit;
											}
										}
										// Calculate total of details
										details_total = 0.0;
										for each  det in input.Bill_Details
										{
											details_total = details_total + ifnull(det.Line_Total,0.0);
										}
										// BLOCK if exceeding
										if(details_total > ifnull(input.Bill_Total,0.0))
										{
											alert "Details exceed Bill Total!";
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation10 as "Full Validation"
			{
				type =  form
				form = Bill_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =======================================
										// Concrete Bill Details
										// On Validate - Based on Bill Detail Type
										// =======================================
										errors = List();
										is_store_bill = false;
										is_parts_bill = false;
										is_document_transport = false;
										// -------------------------------
										// 1) Detect Bill Detail Type
										// -------------------------------
										if(input.Expense_Type == "Document Transport")
										{
											is_document_transport = true;
										}
										else if(input.Stock_Receiving_Details != null)
										{
											is_store_bill = true;
										}
										else if(input.Parts_Consumables != null)
										{
											is_parts_bill = true;
										}
										// -------------------------------
										// 2) Common required fields
										// -------------------------------
										if(input.Bill == null)
										{
											errors.add("• Bill is required.");
										}
										//if(input.Expense_Type == null || input.Expense_Type == "")
										//{
										//errors.add("• Expense Type is required.");
										//}
										// =====================================================
										// A) DOCUMENT TRANSPORT
										// =====================================================
										if(is_document_transport)
										{
											if(input.Details_Date == null)
											{
												errors.add("• Details Date is required.");
											}
											if(input.Reference == null || input.Reference.trim() == "")
											{
												errors.add("• Reference is required.");
											}
											if(input.Details == null || input.Details.trim() == "")
											{
												errors.add("• Details is required.");
											}
											if(input.Quantity == null || input.Quantity <= 0)
											{
												errors.add("• Quantity must be greater than 0.");
											}
											if(input.Rate == null || input.Rate < 0)
											{
												errors.add("• Rate is required.");
											}
											if(input.Account == null || input.Account.trim() == "")
											{
												errors.add("• Account is required.");
											}
										}
										// =====================================================
										// B) STORE BILL DETAILS ONLY
										// =====================================================
										else if(is_store_bill)
										{
											if(input.Item == null)
											{
												errors.add("• Item is required.");
											}
											if(input.Unit_Of_Measure == null)
											{
												errors.add("• Unit Of Measure is required.");
											}
											if(input.Quantity == null || input.Quantity <= 0)
											{
												errors.add("• Quantity must be greater than 0.");
											}
											if(input.Rate == null || input.Rate < 0)
											{
												errors.add("• Rate is required.");
											}
											// Quantity Billable check ONLY for Store Bill
											billable = ifnull(input.Quantity_Billable,0.0);
											if(input.Quantity != null && input.Quantity > billable)
											{
												errors.add("• You cannot bill more than Quantity Billable (" + billable.toString() + ").");
											}
											// Base quantity conversion ONLY for Store Bill
											base_qty = ifnull(input.Quantity_In_Base_Unit,0.0);
											if(base_qty <= 0 && input.Item != null && input.Unit_Of_Measure != null && input.Quantity != null && input.Quantity > 0)
											{
												po_det = Purchase_Order_Details[ID == input.Item];
												if(po_det.ID != null && po_det.Item != null)
												{
													item_id = po_det.Item;
													check = store_management.po.check_uom_conversion_from_concrete(item_id,input.Unit_Of_Measure);
													if(check == null || check.get("ok") != true)
													{
														errors.add("• " + ifnull(check.get("message"),"UOM conversion failed."));
													}
													else
													{
														bq = store_management.po.convert_to_base_qty_from_concrete(item_id,input.Unit_Of_Measure,input.Quantity);
														if(bq != null && bq > 0)
														{
															input.Quantity_In_Base_Unit = bq;
															base_qty = bq;
														}
													}
												}
											}
											if(base_qty <= 0)
											{
												errors.add("• Quantity in Base Unit could not be calculated. Check Unit Of Measure conversion.");
											}
											// Rate in base unit ONLY for Store Bill
											line_total_val = 0.0;
											if(input.Quantity != null && input.Rate != null)
											{
												line_total_val = round(input.Quantity * input.Rate,2);
											}
											if(line_total_val > 0 && base_qty > 0)
											{
												input.Rate_In_Base_Unit = round(line_total_val / base_qty,2);
											}
											else
											{
												input.Rate_In_Base_Unit = 0.0;
											}
										}
										// =====================================================
										// C) WORK ORDER / PARTS & CONSUMABLES BILL DETAILS
										// =====================================================
										else if(is_parts_bill)
										{
											if(input.Details == null || input.Details.trim() == "")
											{
												errors.add("• Details is required for Parts & Consumables.");
											}
											if(input.Quantity == null || input.Quantity <= 0)
											{
												errors.add("• Quantity must be greater than 0.");
											}
											if(input.Rate == null || input.Rate < 0)
											{
												errors.add("• Rate is required.");
											}
										}
										// =====================================================
										// D) DEFAULT / MANUAL EMPLOYEE DETAILS
										// =====================================================
										else
										{
											if(input.Account == null || input.Account.trim() == "")
											{
												errors.add("• Account is required.");
											}
											if(input.Current_Site == null || input.Current_Site.trim() == "")
											{
												errors.add("• Current Site is required.");
											}
										}
										// =====================================================
										// 3) Check Bill Total limit - applies to all bill types
										// =====================================================
										if(input.Bill != null)
										{
											bill_rec = Bill[ID == input.Bill];
											if(bill_rec.ID != null)
											{
												bill_total = ifnull(bill_rec.Bill_Total,0.0);
												if(bill_total <= 0)
												{
													bill_total = ifnull(bill_rec.Amount_Due,0.0);
												}
												allowed_excess = 10.0;
												existing_total = 0.0;
												existing_lines = Bill_Details[Bill == bill_rec.ID];
												for each  row in existing_lines
												{
													if(input.ID != null && row.ID == input.ID)
													{
														continue;
													}
													existing_total = existing_total + ifnull(row.Line_Total,0.0);
												}
												current_line_total = 0.0;
												if(input.Quantity != null && input.Rate != null)
												{
													current_line_total = round(input.Quantity * input.Rate,2);
													//input.Line_Total = current_line_total;
												}
												else
												{
													current_line_total = ifnull(input.Line_Total,0.0);
												}
												new_total = existing_total + current_line_total;
												excess_amount = new_total - bill_total;
												if(excess_amount > allowed_excess)
												{
													errors.add("• Details Total exceeds Bill Total by " + excess_amount.toString() + ". Maximum allowed excess is 10.");
												}
											}
										}
										// FINAL
										if(errors.size() > 0)
										{
											msg = "Please fix the following:\n\n";
											for each  err_msg in errors
											{
												msg = msg + err_msg + "\n";
											}
											alert msg;
											cancel submit;
										}
						)
					}
				}

			}
			Set_Up_Form_On_Edit as "Set Up Form On Edit"
			{
				type =  form
				form = Voucher_Register

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------
										// 3) MODE + STATUS
										// ------------------------------
										is_create = input.ID == null;
										st = ifnull(input.Voucher_Status,"Issued");
										// Get selected voucher type from ONE lookup field: Voucher_Type
										voucherType = "";
										if(input.Voucher_Type != null)
										{
											voucherType = ifnull(input.Voucher_Type.Voucher_Type,"").trim();
										}
										// Optional: keep display name field synced if the field still exists
										input.Display_Name_Voucher_Type = voucherType;
										// =====================================================
										// NOTES CONTROL - DEFAULT HIDE
										// =====================================================
										hide Notes;
										hide Not_Created;
										hide Reason_Why_Not_Created;
										disable Reason_Why_Not_Created;
										// =====================================================
										// DEFAULT STATUS ON CREATE
										// =====================================================
										if(is_create && input.Voucher_Status == null)
										{
											input.Voucher_Status = "Issued";
											st = "Issued";
										}
										// =====================================================
										// ON CREATE
										// =====================================================
										if(is_create)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											enable Issued_By;
											enable Document_Type;
											enable Voucher_Type;
											enable Voucher_Number;
											enable Employee;
										}
										// =====================================================
										// ON EDIT + Status = ISSUED
										// =====================================================
										else if(!is_create && st == "Issued")
										{
											show Issued_By;
											show Site;
											show Voucher_Return;
											show Received_By;
											enable Received_By;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											if(voucherType == "Item Issuing Form")
											{
												show Asset;
												show Voucher_Issuing_Details;
											}
											if(voucherType == "Occurency Report")
											{
												show Voucher_Header;
												show Management_Location;
												enable Management_Location;
												show Incident_Details;
												enable Incident_Details.Time;
												enable Incident_Details.Incident_Type;
												enable Incident_Details.Incident;
											}
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
											{
												show Voucher_Header;
												show Employee_Receiving_Details;
												show Stock_Bundling_Note;
												show Stock_Bundling_Note.Asset;
												show Stock_Bundling_Note.Quantity_To_Be_Created;
												show Stock_Bundling_Note.Item;
												show Stock_Bundling_Note.Line_Number;
												enable Stock_Bundling_Note.Asset;
												enable Stock_Bundling_Note.Quantity_To_Be_Created;
												enable Stock_Bundling_Note.Item;
												show Notes;
												show Not_Created;
												enable Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
													enable Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
													disable Reason_Why_Not_Created;
												}
											}
											if(voucherType == "Store Receiving Book")
											{
												show Asset;
												show Voucher_Receiving_Details;
											}
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Display_Name_Issued_By;
												hide Received_By;
												hide Display_Name_Received_By;
												show Voucher_Return;
												show Date_Time_Out;
												show Hours_Worked;
												show Shift;
												enable Shift;
											}
										}
										// =====================================================
										// ON EDIT + Status = CLOSED
										// =====================================================
										else if(!is_create && st == "Closed")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Display_Name_Issued_By;
												hide Received_By;
												hide Display_Name_Received_By;
												show Manager_Section;
												show Manager_Time;
												show Cancel_Voucher;
												show Case_Number;
												show Employee_Taking_To_Head_Office;
												show How_to_Take_to_Head_Office;
												show Time_Sent_to_Head_Office;
												enable Case_Number;
												enable Employee_Taking_To_Head_Office;
												enable How_to_Take_to_Head_Office;
												enable Cancel_Voucher;
												if(input.Cancel_Voucher == true)
												{
													show Cancellation_Reason;
													enable Cancellation_Reason;
												}
												else
												{
													hide Cancellation_Reason;
												}
											}
										}
										// =====================================================
										// ON EDIT + Status = RETURNED
										// =====================================================
										else if(!is_create && st == "Returned")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Received_By;
												hide Display_Name_Received_By;
											}
											show Issued_By;
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											if(voucherType == "Cashier Envelope")
											{
												hide Voucher_Header;
												hide Voucher_Footer;
											}
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
											{
												show Employee_Issuing_Details;
												show Voucher_Header;
												show Quantity_To_Be_Created;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												show Quantity_Created;
												disable Asset;
												disable Item;
												disable Quantity_To_Be_Created;
												show Notes;
												show Not_Created;
												enable Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
													enable Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
													disable Reason_Why_Not_Created;
												}
												if(input.Allow_Excess_Material_Issued == true)
												{
													show Reason_Why_Material_Issued_Exceeded_Formula;
													enable Reason_Why_Material_Issued_Exceeded_Formula;
												}
												else
												{
													hide Reason_Why_Material_Issued_Exceeded_Formula;
												}
											}
											if(voucherType == "Drager Work Report")
											{
												show Voucher_Header;
												show Asset;
												show Machine_Start_of_Day;
												show Start_Time;
												show Odometer_Start;
											}
											if(voucherType == "Item Issuing Form")
											{
												hide Employee_Issuing_Details;
												show Voucher_Issuing_Details;
												disable Voucher_Issuing_Details.Display_Name_Voucher;
												hide Voucher_Issuing_Details.Display_Name_Voucher;
												disable Voucher_Issuing_Details.Line_Number;
												disable Voucher_Issuing_Details.Display_Name_Item;
												disable Voucher_Issuing_Details.Quantity;
												disable Voucher_Issuing_Details.Cost;
												disable Voucher_Issuing_Details.Request_Voucher;
												disable Voucher_Issuing_Details.Source_Record_ID;
												hide Voucher_Issuing_Details.Source_Record_ID;
												disable Voucher_Issuing_Details.Source_Form;
												hide Voucher_Issuing_Details.Source_Form;
												show Voucher_Footer;
												show Voucher_Cost;
											}
											if(voucherType == "Occurency Report")
											{
												show Voucher_Header;
												show Management_Location;
												show Incident_Details;
											}
											if(voucherType == "Store Receiving Book")
											{
												hide Employee_Issuing_Details;
												show Voucher_Receiving_Details;
												disable Voucher_Receiving_Details.Display_Name_Voucher;
												hide Voucher_Receiving_Details.Display_Name_Voucher;
												disable Voucher_Receiving_Details.Line_Number;
												disable Voucher_Receiving_Details.Display_Name_Item;
												disable Voucher_Receiving_Details.Quantity_Received;
												disable Voucher_Receiving_Details.Source_Record_ID;
												hide Voucher_Receiving_Details.Source_Record_ID;
												disable Voucher_Receiving_Details.Source_Form;
												hide Voucher_Receiving_Details.Source_Form;
											}
											show Manager_Section;
											show Cancel_Voucher;
											enable Cancel_Voucher;
										}
										// =====================================================
										// ON EDIT + Status = HEAD OFFICE
										// =====================================================
										else if(!is_create && st == "Head Office")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
											{
												hide Employee_Issuing_Details;
												show Voucher_Header;
												show Asset;
												show Item;
												show Quantity_To_Be_Created;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												disable Asset;
												disable Item;
												disable Quantity_To_Be_Created;
												show Notes;
												show Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
												}
											}
											show Manager_Section;
											show Cancel_Voucher;
											if(input.Cancel_Voucher == true)
											{
												show Cancellation_Reason;
											}
											else
											{
												hide Cancellation_Reason;
											}
											show Head_Office;
											show Seen;
											enable Seen;
										}
										// =====================================================
										// ON EDIT + Status = HUMAN RESOURCE
										// =====================================================
										else if(!is_create && st == "Human Resource")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											enable Document_Type;
											show Voucher_Type;
											enable Voucher_Type;
											show Voucher_Number;
											enable Voucher_Number;
											show Employee;
											show Date_Time_In;
											enable Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											enable Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
											{
												hide Employee_Issuing_Details;
												show Voucher_Header;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												show Notes;
												show Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
												}
											}
											show Manager_Section;
											show Cancel_Voucher;
											enable Cancel_Voucher;
										}
										// =====================================================
										// ON EDIT + Status = AUDITED
										// =====================================================
										else if(!is_create && st == "Audited")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											enable Voucher_Status;
											if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
											{
												hide Employee_Issuing_Details;
												show Voucher_Header;
												show Employee_Receiving_Details;
												show Voucher_Footer;
												show Voucher_Cost;
												show Notes;
												show Not_Created;
												if(input.Not_Created == true)
												{
													show Reason_Why_Not_Created;
												}
												else
												{
													hide Reason_Why_Not_Created;
												}
											}
											show Voucher_Cost;
											show End_Time;
											show Odometer_End;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											if(input.Cancel_Voucher == true)
											{
												show Cancellation_Reason;
											}
											else
											{
												hide Cancellation_Reason;
											}
											show Head_Office;
											show Seen;
											if(input.Seen == true)
											{
												hide Reason_for_not_Seen;
											}
											else
											{
												show Reason_for_not_Seen;
											}
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
											show Back_End;
											show User_Name;
											show User_Email;
											show User_Role;
											show Created_By_Name;
											show Created_By_Email;
											show Created_By_Time;
											show Updated_By_Name;
											show Updated_By_Email;
											show Updated_By_Time;
										}
										// =====================================================
										// ON EDIT + Status = CLEARED
										// =====================================================
										else if(!is_create && st == "Cleared")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Shift_Voucher_Summary;
											show Opening_Vouchers;
											show Vouchers_Issued;
											show Vouchers_Returned;
											show Outstanding_Vouchers;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											show Head_Office;
											show Seen;
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
											show Back_End;
										}
										// =====================================
										// FINAL NOTES CONTROL
										// Only Stock Receiving Note / Stock Bundling Note
										// =====================================
										if(voucherType == "Stock Receiving Note" || voucherType == "Stock Bundling Note")
										{
											show Notes;
											show Not_Created;
											if(input.Not_Created == true)
											{
												show Reason_Why_Not_Created;
												enable Reason_Why_Not_Created;
											}
											else
											{
												hide Reason_Why_Not_Created;
												disable Reason_Why_Not_Created;
											}
										}
										else
										{
											hide Notes;
											hide Not_Created;
											hide Reason_Why_Not_Created;
											disable Reason_Why_Not_Created;
										}
										// =====================================
										// FORCE SHOW EXISTING IMPORTED DETAILS
										// =====================================
										if(input.Employee_Issuing_Details.count() > 0)
										{
											show Employee_Issuing_Details;
										}
										if(input.Voucher_Issuing_Details.count() > 0)
										{
											show Voucher_Issuing_Details;
										}
										if(input.Voucher_Receiving_Details.count() > 0)
										{
											show Voucher_Receiving_Details;
										}
						)
					}
				}

			}
			Finalize10 as "Finalize"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ON SUCCESS FINALIZE
										// =====================================================
										// SECTION 1a: DIGITAL VOUCHER NUMBER
										// =====================================================
										voucher_no = ifnull(input.Voucher_Number,"").trim();
										if(input.Document_Type == "Digital Voucher" && input.Voucher_Type != null && voucher_no == "")
										{
											vno = employee_management.Generate_Voucher_Number(input.Voucher_Type.ID);
											if(vno != null && vno != "" && vno != "LIMIT_REACHED")
											{
												input.Voucher_Number = vno;
												if(input.ID != null)
												{
													rec = Voucher_Register[ID == input.ID];
													if(rec.ID != null)
													{
														rec.Voucher_Number=vno;
													}
												}
											}
										}
										// =====================================================
										// SECTION 1b: VARIABLES
										// =====================================================
										now_ts = zoho.currenttime;
										case_no = "";
										case_no_final = "";
										detailText = "";
										transport_dt = now_ts;
										total_vouchers = 0;
										employee_take_name = "";
										voucherType = "";
										if(input.Voucher_Type != null)
										{
											voucherType = ifnull(input.Voucher_Type.Voucher_Type,"").trim();
										}
										input.Display_Name_Voucher_Type = voucherType;
										bill_details_date = zoho.currentdate;
										if(input.Date_Time_In != null)
										{
											bill_details_date = input.Date_Time_In.toDate();
										}
										// =====================================================
										// SECTION 2: DISPLAY NAMES
										// =====================================================
										if(input.Issued_By != null)
										{
											input.Display_Name_Issued_By = ifnull(input.Issued_By.Voucher_Number,"") + " - " + ifnull(input.Issued_By.Display_Name_Employee,"");
										}
										else
										{
											input.Display_Name_Issued_By = null;
										}
										if(input.Site != null)
										{
											input.Display_Name_Site = input.Site.Display_Name_Asset_Name;
										}
										else
										{
											input.Display_Name_Site = null;
										}
										if(input.Employee != null && input.Employee.Employee_Name != null && input.Employee.Employee_Number != null)
										{
											input.Display_Name_Employee = input.Employee.Employee_Name.toString() + " - " + input.Employee.Employee_Number.trim();
										}
										else
										{
											input.Display_Name_Employee = null;
										}
										// =====================================================
										// SECTION 3: CASE / TRANSFER REGISTER
										// =====================================================
										if(input.ID != null && input.Voucher_Status == "Head Office" && voucherType == "Supervisor Voucher")
										{
											case_no = ifnull(input.Case_Number,"").trim();
											if(case_no != "")
											{
												transport_dt = zoho.currenttime;
												employee_take_name = "";
												if(input.Time_Sent_to_Head_Office != null)
												{
													transport_dt = input.Time_Sent_to_Head_Office;
												}
												if(input.Employee_Taking_To_Head_Office != null)
												{
													employee_take_name = ifnull(input.Employee_Taking_To_Head_Office.Employee_Name,"") + " - " + ifnull(input.Employee_Taking_To_Head_Office.Employee_Number,"");
												}
												attached_count = 0;
												detailText = "";
												attachedVouchers = Voucher_Register[Issued_By == input.ID];
												for each  av in attachedVouchers
												{
													av.Case_Number=case_no;
													attached_count = attached_count + 1;
													detailText = detailText + ifnull(av.Voucher_Number,"") + " - " + ifnull(av.Display_Name_Voucher_Type,"") + " - " + ifnull(av.Display_Name_Employee,"") + "\n";
												}
												total_vouchers = attached_count + 1;
												syncInput = Map();
												syncInput.put("Case_Number",case_no);
												syncInput.put("Transport_Date",transport_dt);
												syncInput.put("How_To_Take_To_Head_Office",ifnull(input.How_to_Take_to_Head_Office,""));
												syncInput.put("From_Site",ifnull(input.Display_Name_Site,""));
												syncInput.put("Employee_Taking_To_Head_Office",employee_take_name);
												syncInput.put("Source_Record_ID",input.ID);
												syncInput.put("Number_Of_Vouchers",total_vouchers);
												syncResp = employee_management.syncConcreteVoucherTransferRegister(syncInput);
												if(syncResp != null && syncResp.get("ok") == true)
												{
													info "Voucher Transfer Register synchronized successfully.";
													info "Transfer Register ID: " + ifnull(syncResp.get("Voucher_Transfer_Register_ID"),"");
												}
												else
												{
													info "Voucher Transfer Register synchronization failed: " + ifnull(syncResp.get("msg"),"Unknown synchronization error");
												}
											}
											else
											{
												info "Transfer Register not synchronized because Case Number is empty.";
											}
										}
										if(input.How_to_Take_to_Head_Office == "Transport Required")
										{
											if(input.Employee_Taking_To_Head_Office != null)
											{
												if(detailText == null || detailText == "")
												{
													detailText = "";
													issuedVouchers = Voucher_Register[Issued_By.Voucher_Number == input.Voucher_Number];
													for each  v in issuedVouchers
													{
														detailText = detailText + ifnull(v.Voucher_Number,"") + " - " + ifnull(v.Display_Name_Voucher_Type,"") + " - " + ifnull(v.Display_Name_Employee,"") + "\n";
													}
												}
												refVal = input.Voucher_Number + " - " + ifnull(input.Employee_Taking_To_Head_Office.Employee_Name,"") + " - " + ifnull(input.Employee_Taking_To_Head_Office.Employee_Number,"");
												existingBD = Bill_Details[Reference == refVal && Source_Record_ID == input.ID && Source_Form == "Concrete Products Management - Supervisor Voucher" && Expense_Type == "Document Transport"];
												if(existingBD.count() == 0)
												{
													insert into Bill_Details
													[
														Details_Date=bill_details_date
														Reference=refVal
														Details=detailText
														Expense_Type="Document Transport"
														Quantity=1.00
														Account=input.Display_Name_Site
														Current_Site=input.Display_Name_Site
														Source_Record_ID=input.ID
														Source_Form="Concrete Products Management - Supervisor Voucher"
														Bill_Details_Status="Draft"
														Added_User=zoho.loginuser
													]
												}
											}
										}
										// =====================================================
										// SECTION 6E: CREATE OR UPDATE EMPLOYEE BILL
										// CONCRETE PRODUCTS MANAGEMENT
										// =====================================================
										if(input.ID != null && input.Employee != null)
										{
											bill_record_ready = false;
											vDate = zoho.currentdate;
											if(input.Date_Time_In != null)
											{
												vDate = input.Date_Time_In.toDate();
											}
											voucherType = ifnull(input.Voucher_Type,"").trim();
											voucherNumber = ifnull(input.Voucher_Number,"").trim();
											sourceVal = ifnull(input.Display_Name_Employee,"").trim();
											accountVal = ifnull(input.Display_Name_Site,"").trim();
											siteVal = ifnull(input.Display_Name_Site,"").trim();
											if(accountVal == "")
											{
												accountVal = "Unassigned Account";
											}
											employeeID = input.Employee.ID;
											empName = ifnull(input.Employee.Employee_Name,"").trim();
											billName = empName;
											displayVendorName = empName;
											if(input.Employee.Employee_Number != null)
											{
												displayVendorName = empName + " - " + input.Employee.Employee_Number.toString();
											}
											dailyAllowance = 0.0;
											weeklyAllowance = 0.0;
											monthlySalary = 0.0;
											allowanceInput = Map();
											allowanceInput.put("Employee_ID",employeeID);
											allowanceResp = employee_management.getEmployeeActiveAllowance(allowanceInput);
											if(allowanceResp != null)
											{
												dailyAllowance = ifnull(allowanceResp.get("Daily_Allowance"),0.0);
												weeklyAllowance = ifnull(allowanceResp.get("Weekly_Allowance"),0.0);
												monthlySalary = ifnull(allowanceResp.get("Monthly_Salary"),0.0);
											}
											billPeriods = List();
											if(dailyAllowance > 0 || weeklyAllowance > 0)
											{
												billPeriods.add("Weekly");
											}
											if(monthlySalary > 0)
											{
												billPeriods.add("Monthly");
											}
											for each  billPeriod in billPeriods
											{
												billDate = vDate;
												billNumber = "";
												if(billPeriod == "Weekly")
												{
													weekDate = vDate;
													dayNum = weekDate.getDayOfWeek();
													if(dayNum == 1)
													{
														daysToMonday = 1;
													}
													else
													{
														daysToMonday = 2 - dayNum;
													}
													billDate = weekDate.addDay(daysToMonday);
													weekNo = billDate.getWeekOfYear();
													weekTxt = weekNo.toString();
													if(weekNo < 10)
													{
														weekTxt = "0" + weekTxt;
													}
													billNumber = billDate.getYear().toString() + " Week " + weekTxt;
												}
												else if(billPeriod == "Monthly")
												{
													monthTxt = vDate.toString("MM");
													yearTxt = vDate.toString("yyyy");
													billDate = vDate;
													billNumber = yearTxt + " Month " + monthTxt;
												}
												if(billNumber != "")
												{
													existingBill = Bill[Employee_Vendor == employeeID && Bill_Number == billNumber && Bill_Type == "Employee Bill"];
													if(existingBill.ID != null)
													{
														employeeBill = existingBill;
														employeeBill.Bill_Date=billDate;
														employeeBill.Display_Name_Vendor=displayVendorName;
														employeeBill.Bill_Name=billName;
													}
													else
													{
														newBillID = insert into Bill
														[
															Bill_Date=billDate
															Bill_Type="Employee Bill"
															Employee_Vendor=employeeID
															Display_Name_Vendor=displayVendorName
															Bill_Name=billName
															Bill_Number=billNumber
															Bill_Status="Draft"
															Payment_Status="Not Paid"
															Added_User=zoho.loginuser
														];
														employeeBill = Bill[ID == newBillID];
													}
													if(employeeBill.ID != null)
													{
														if(voucherType == "Stock Bundling Note")
														{
															savedVoucher = Voucher_Register[ID == input.ID];
															for each  sb in savedVoucher.Stock_Bundling_Note
															{
																lineNumber = ifnull(sb.Line_Number,0);
																sourceKey = voucherNumber + "-" + lineNumber.toString();
																sourceFormText = "Concrete Products Management - Stock Bundling Note";
																expenseType = billPeriod + " Payment";
																detailText = "Voucher Number: " + voucherNumber;
																detailText = detailText + "\nVoucher Type: " + voucherType;
																detailText = detailText + "\nEmployee: " + ifnull(input.Display_Name_Employee,"");
																detailText = detailText + "\nSite: " + ifnull(input.Display_Name_Site,"");
																detailText = detailText + "\nLine Number: " + lineNumber.toString();
																detailText = detailText + "\nItem: " + ifnull(sb.Display_Name_Item,"");
																detailText = detailText + "\nQuantity To Be Created: " + ifnull(sb.Quantity_To_Be_Created,0.0).toString();
																detailText = detailText + "\nQuantity Created: " + ifnull(sb.Quantity_Created,0.0).toString();
																existingBD = Bill_Details[Bill == employeeBill.ID && Source_Record_ID == input.ID && Source_Form == sourceFormText && Reference == sourceKey && Expense_Type == expenseType];
																if(existingBD.ID == null)
																{
																	newDetailID = insert into Bill_Details
																	[
																		Bill=employeeBill.ID
																		Display_Name_Bill=empName + " - " + billNumber
																		Details_Date=vDate
																		Source=sourceVal
																		Reference=sourceKey
																		Line_Number=lineNumber
																		Display_Name_Item=ifnull(sb.Display_Name_Item,"")
																		Details=detailText
																		Expense_Type=expenseType
																		Quantity=ifnull(sb.Quantity_Created,0.0)
																		Account=accountVal
																		Current_Site=siteVal
																		Source_Record_ID=input.ID
																		Source_Form=sourceFormText
																		Bill_Details_Status="Draft"
																		Added_User=zoho.loginuser
																	];
																	if(newDetailID != null)
																	{
																		bill_record_ready = true;
																	}
																}
																else
																{
																	existingBD.Display_Name_Bill=empName + " - " + billNumber;
																	existingBD.Details_Date=vDate;
																	existingBD.Source=sourceVal;
																	existingBD.Reference=sourceKey;
																	existingBD.Line_Number=lineNumber;
																	existingBD.Display_Name_Item=ifnull(sb.Display_Name_Item,"");
																	existingBD.Details=detailText;
																	existingBD.Expense_Type=expenseType;
																	existingBD.Quantity=ifnull(sb.Quantity_Created,0.0);
																	existingBD.Account=accountVal;
																	existingBD.Current_Site=siteVal;
																	existingBD.Source_Record_ID=input.ID;
																	existingBD.Source_Form=sourceFormText;
																	bill_record_ready = true;
																}
															}
														}
														else
														{
															sourceFormText = "Concrete Products Management - Voucher Register";
															expenseType = billPeriod + " Payment";
															detailText = "Voucher Number: " + voucherNumber;
															detailText = detailText + "\nVoucher Type: " + voucherType;
															detailText = detailText + "\nEmployee: " + ifnull(input.Display_Name_Employee,"");
															detailText = detailText + "\nSite: " + ifnull(input.Display_Name_Site,"");
															existingBD = Bill_Details[Bill == employeeBill.ID && Source_Record_ID == input.ID && Source_Form == sourceFormText && Expense_Type == expenseType];
															if(existingBD.ID == null)
															{
																newDetailID = insert into Bill_Details
																[
																	Bill=employeeBill.ID
																	Display_Name_Bill=empName + " - " + billNumber
																	Details_Date=vDate
																	Source=sourceVal
																	Reference=voucherNumber
																	Details=detailText
																	Expense_Type=expenseType
																	Quantity=1.00
																	Account=accountVal
																	Current_Site=siteVal
																	Source_Record_ID=input.ID
																	Source_Form=sourceFormText
																	Bill_Details_Status="Draft"
																	Added_User=zoho.loginuser
																];
																if(newDetailID != null)
																{
																	bill_record_ready = true;
																}
															}
															else
															{
																existingBD.Display_Name_Bill=empName + " - " + billNumber;
																existingBD.Details_Date=vDate;
																existingBD.Source=sourceVal;
																existingBD.Reference=voucherNumber;
																existingBD.Details=detailText;
																existingBD.Expense_Type=expenseType;
																existingBD.Quantity=1.00;
																existingBD.Account=accountVal;
																existingBD.Current_Site=siteVal;
																existingBD.Source_Record_ID=input.ID;
																existingBD.Source_Form=sourceFormText;
																bill_record_ready = true;
															}
														}
													}
												}
											}
										}
										// =====================================================
										// SECTION 5: UPDATE TRANSFER REGISTER COUNT
										// =====================================================
										case_no_final = ifnull(input.Case_Number,"").trim();
										if(case_no_final != "")
										{
											employee_management.updateVoucherTransferRegisterCount(case_no_final);
										}
										// =====================================================
										// SECTION 6: RECALCULATE COSTS AND QUANTITY CREATED
										// =====================================================
										if(input.ID != null)
										{
											thisapp.recalculateVoucherMaterialsCost(input.ID);
											thisapp.updateVoucherQuantityCreated(input.ID);
										}
						)
					}
				}

			}
			On_Voucher_Type_Selected as "On Voucher Type Selected"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on user input of Voucher_Type
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// ON USER INPUT: Voucher_Type
										// Voucher_Type is now ONE lookup to Document_Key
										// ========================================
										if(input.Voucher_Type == null)
										{
											return;
										}
										// Get selected voucher type name from Document Key
										voucherType = ifnull(input.Voucher_Type.Voucher_Type,"").trim();
										// Sync display field if you still keep it
										input.Display_Name_Voucher_Type = voucherType;
										// ========================================
										// DOCUMENT TYPE RULE
										// ========================================
										if(input.Document_Type == "Digital Voucher")
										{
											disable Voucher_Number;
										}
										else if(input.Document_Type == "Physical Voucher")
										{
											enable Voucher_Number;
										}
										else
										{
											input.Voucher_Number = null;
											disable Voucher_Number;
										}
										// ========================================
										// RESET FIRST
										// ========================================
										show Issued_By;
										//show Display_Name_Issued_By;
										show Received_By;
										show Display_Name_Received_By;
										hide Site;
										hide Display_Name_Site;
										hide Voucher_Header;
										hide Management_Location;
										hide Asset;
										hide Machine_Start_of_Day;
										hide Start_Time;
										hide Odometer_Start;
										hide Item;
										hide Display_Name_Item;
										hide Quantity_To_Be_Created;
										hide Fuel_Start_Level;
										hide Employee_Issuing_Details;
										hide Voucher_Issuing_Details;
										hide Voucher_Receiving_Details;
										hide Stock_Bundling_Note;
										hide Employee_Receiving_Details;
										hide Incident_Details;
										hide Truck_Measurement_Details;
										hide Voucher_Issuing_Details;
										hide Voucher_Receiving_Details;
										hide Voucher_Footer;
										hide Voucher_Cost;
										hide End_Time;
										hide Odometer_End;
										hide Fuel_End_Level;
										// ========================================
										// DOCUMENT TYPES
										// ========================================
										if(voucherType == "Item Issuing Form")
										{
											hide Voucher_Issuing_Details;
										}
										if(voucherType == "Kitchen Voucher")
										{
											//ADD FIELDS
										}
										if(voucherType == "Occurency Report")
										{
											show Voucher_Header;
											show Management_Location;
											show Incident_Details;
										}
										if(voucherType == "Occurency Report Phone")
										{
											//ADD FIELDS
										}
										if(voucherType == "Parking Controller Voucher")
										{
											//ADD FIELDS
										}
										if(voucherType == "Receipt Officer Daily Report")
										{
											show Truck_Measurement_Details;
										}
										if(voucherType == "Stock Bundling Note")
										{
											show Stock_Bundling_Note;
											show Stock_Bundling_Note.Line_Number;
											show Stock_Bundling_Note.Item;
											enable Stock_Bundling_Note.Item;
											show Stock_Bundling_Note.Quantity_To_Be_Created;
											enable Stock_Bundling_Note.Quantity_To_Be_Created;
											show Stock_Bundling_Note.Asset;
											enable Stock_Bundling_Note.Asset;
										}
										if(voucherType == "Stock Receiving Note")
										{
											show Voucher_Header;
											show Asset;
											show Item;
											show Quantity_To_Be_Created;
											enable Asset;
											enable Item;
											enable Quantity_To_Be_Created;
										}
										if(voucherType == "Store Receiving Book")
										{
											hide Voucher_Receiving_Details;
										}
										if(voucherType == "Supervisor Voucher")
										{
											hide Issued_By;
											hide Display_Name_Issued_By;
											hide Received_By;
											hide Display_Name_Received_By;
											show Site;
											enable Site;
											show Display_Name_Site;
											input.Voucher_Status = "Issued";
										}
										if(voucherType == "Tractor Work Report")
										{
											show Voucher_Header;
											show Asset;
											show Machine_Start_of_Day;
											show Start_Time;
											show Odometer_Start;
											hide Employee_Issuing_Details;
											show Voucher_Footer;
											show Voucher_Cost;
											show End_Time;
											show Odometer_End;
										}
										if(voucherType == "Truck Movement Voucher")
										{
											show Voucher_Header;
											show Asset;
											show Machine_Start_of_Day;
											show Start_Time;
											show Odometer_Start;
											show Employee_Issuing_Details;
											show Voucher_Footer;
											show Voucher_Cost;
											show End_Time;
											show Odometer_End;
										}
						)
					}
				}

			}
			On_Sales_Voucher_Selected3 as "On Sales Voucher Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Sales_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Sales_Voucher != null)
										{
											input.Request_Voucher = input.Sales_Voucher.Sales_Voucher_Number;
											input.Item_Taken = null;
											input.Item = null;
										}
										else
										{
											input.Request_Voucher = "";
											input.Item_Taken = null;
										}
						)
					}
				}

			}
			On_Item_Taken_Selected as "On Item Taken Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Item_Taken
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// ITEM ISSUING DETAILS
										// ON ITEM_TAKEN SELECTED
										// Stops after STOCK SUMMARY + UOM
										// ======================================================
										// 1) ITEM_TAKEN CLEARED
										if(input.Item_Taken == null)
										{
											input.Item = null;
											input.Display_Name_Item = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Cost = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											input.Global_Available_Stock = null;
											input.Store_Available_Stock = null;
											input.Quantity = null;
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Status = null;
											hide Expected_Return_Date;
											input.Expected_Return_Date = null;
											return;
										}
										// 2) GET ITEM FROM ITEM_TAKEN
										if(input.Item_Taken.Item == null)
										{
											alert "Selected Sales Voucher item has no Item.";
											input.Item_Taken = null;
											input.Item = null;
											return;
										}
										input.Item = input.Item_Taken.Item;
										item_id = input.Item.ID;
										if(item_id == null)
										{
											alert "Selected item could not be resolved.";
											input.Item_Taken = null;
											input.Item = null;
											return;
										}
										// 3) RESOLVE STORE FROM ISSUING VOUCHER
										store_id = null;
										if(input.Issuing_Voucher != null)
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID != null && hdr.Store != null)
											{
												store_id = hdr.Store.ID;
											}
										}
										if(store_id == null)
										{
											alert "This voucher has no Store selected. Please check the Item Issuing Voucher header.";
											input.Item_Taken = null;
											input.Item = null;
											input.Display_Name_Item = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Cost = null;
											input.Global_Available_Stock = null;
											input.Store_Available_Stock = null;
											return;
										}
										// 4) STOCK CONDITION
										cond = ifnull(input.Stock_Condition,"").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = cond;
										}
										// 5) GET STOCK SUMMARY FROM STORE MANAGEMENT
										stock_map = store_management.po.get_item_store_cost_from_concrete(item_id,store_id,cond);
										if(stock_map == null)
										{
											alert "Could not get item stock details from Store Management.";
											input.Display_Name_Item = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Cost = 0.0;
											input.Global_Available_Stock = 0.0;
											input.Store_Available_Stock = 0.0;
											return;
										}
										// 6) FILL ITEM DISPLAY
										input.Display_Name_Item = ifnull(stock_map.get("display_name_item"),"");
										// 7) FILL STOCK + COST
										input.Global_Available_Stock = ifnull(stock_map.get("global_stock"),0.0);
										input.Store_Available_Stock = ifnull(stock_map.get("store_stock"),0.0);
										input.Cost = ifnull(stock_map.get("cost"),0.0);
										// 8) FILL UOM
										input.Unit_Of_Measure = stock_map.get("base_uom");
										input.Display_Name_Unit_Of_Measure = ifnull(stock_map.get("base_uom_name"),"");
										if(input.Unit_Of_Measure == null)
										{
											alert "Base Unit of Measure is missing for this item in Store Management.";
										}
										// 9) CLEAR QUANTITY CALCULATIONS FOR NOW
										input.Quantity = null;
										input.Quantity_in_Base_Unit_Of_Measure = null;
										input.Line_Total = null;
										Rate_In_Base_Unit = 0.0;
						)
					}
				}

			}
			Finalize_On_Delete3 as "Finalize On Delete"
			{
				type =  form
				form = Sales_Voucher

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											data = Map();
										data.put("Source_Record_ID",input.ID);
										data.put("Source_Form","Sales Voucher Details");
										grapes_group.deleteBusinessDivisionDetail(data);
						)
					}
				}

			}
			Full_Validation_On_Delete as "Full Validation On Delete"
			{
				type =  form
				form = Sales_Voucher

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											payments = Payment_Receipt_Details[Sales_Voucher == input.ID];
										if(payments.count() > 0)
										{
											alert "This Sales Voucher has payment allocations and cannot be deleted.";
											cancel delete;
										}
						)
					}
				}

			}
			Finalize_On_Delete6 as "Finalize On Delete"
			{
				type =  form
				form = Asset_Issues

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// CONCRETE PRODUCTS - ASSET ISSUE FINALIZE ON DELETE
										// =====================================================
										mile_del_resp = asset_management.deleteMileageLogFromConcrete("Concrete Products Asset Issues",input.ID.toString());
										info mile_del_resp;
										mile_del_resp = asset_management.deleteMileageLogFromConcrete("Concrete Products Asset Issues - Work Order",input.ID.toString());
										info mile_del_resp;
						)
					}
				}

			}
			Finalize_On_Edit19 as "Finalize On Edit"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// CONCRETE STOCK RECEIVING DETAILS - FINALIZE ON EDIT
										// ======================================================
										// ------------------------------------------------------
										// 1) AUDIT
										// ------------------------------------------------------
										u = thisapp.audit.getLoginAuditInfo();
										input.Updated_By_Name = u.get("name");
										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
										// ------------------------------------------------------
										// 2) RESOLVE RECEIVING HEADER / STORE
										// ------------------------------------------------------
										if(input.Stock_Receiving_Voucher == null)
										{
											return;
										}
										srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
										if(srv.ID == null || srv.Store == null)
										{
											return;
										}
										store_id = srv.Store;
										srv_name = ifnull(srv.Display_Name_Stock_Receiving_Book,"").trim();
										srv_store_display = ifnull(srv.Display_Name_Store,"");
										srv_received_by = ifnull(srv.Received_By,"");
										// ------------------------------------------------------
										// 3) BUILD RECEIVING VOUCHER NUMBER
										// ------------------------------------------------------
										num_txt = "";
										if(input.Stock_Receiving_Voucher_Number != null && input.Stock_Receiving_Voucher_Number > 0)
										{
											if(input.Stock_Receiving_Voucher_Number < 10)
											{
												num_txt = "0" + input.Stock_Receiving_Voucher_Number.toString();
											}
											else
											{
												num_txt = input.Stock_Receiving_Voucher_Number.toString();
											}
										}
										if(srv_name != "" && num_txt != "")
										{
											input.Stock_Receiving_Voucher_and_Number = srv_name + "-" + num_txt;
										}
										else if(srv_name != "")
										{
											input.Stock_Receiving_Voucher_and_Number = srv_name;
										}
										else
										{
											input.Stock_Receiving_Voucher_and_Number = null;
										}
										ref_no = ifnull(input.Stock_Receiving_Voucher_and_Number,"").trim();
										if(ref_no == "")
										{
											ref_no = input.ID.toString();
										}
										// ------------------------------------------------------
										// 4) REFRESH DISPLAY FIELDS
										// ------------------------------------------------------
										input.Display_Name_Stock_Receiving_Voucher = srv_name;
										input.Store = srv_store_display;
										input.Display_Name_Received_By = srv_received_by;
										// ------------------------------------------------------
										// 5) COMMON VALUES
										// ------------------------------------------------------
										rtype = ifnull(input.Receiving_Type,"").trim();
										qty = ifnull(input.Quantity_Received,0.0);
										uom_id = input.Unit_Of_Measure_Received;
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
										}
										if(rtype == "Tool Return" && cond == "New")
										{
											cond = "In Service";
											input.Stock_Condition = "In Service";
										}
										if(qty <= 0 || uom_id == null)
										{
											return;
										}
										// ------------------------------------------------------
										// 6) RESOLVE ACTUAL ITEM
										// ------------------------------------------------------
										actual_item_id = null;
										po_detail_id = null;
										po_unit_cost = 0.0;
										base_uom_name = "";
										if(rtype == "Purchase Order" && input.Item != null)
										{
											po_det = Purchase_Order_Details[ID == input.Item];
											if(po_det.ID != null && po_det.Item != null)
											{
												po_detail_id = po_det.ID;
												actual_item_id = po_det.Item;
												po_unit_cost = ifnull(po_det.Unit_Cost,0.0);
												base_uom_name = ifnull(po_det.Display_Name_Unit_Of_Measure,"");
											}
										}
										// ======================================================
										// INTERNAL TRANSFER
										// ======================================================
										else if(rtype == "Internal Transfer" && input.Transfer_Item != null)
										{
											transfer_id_val = input.Transfer_Item.ID;
											if(transfer_id_val == null || transfer_id_val <= 0)
											{
												info "Stock Transfer ID is invalid.";
												input.Stock_Receiving_Details_Status = "Draft";
												return;
											}
											transfer_payload = Map();
											transfer_payload.put("Transfer_ID",transfer_id_val);
											transfer_payload.put("Receiving_Number",ifnull(input.Stock_Receiving_Voucher_and_Number,""));
											transfer_payload.put("Receive_Date",zoho.currentdate);
											transfer_payload.put("Receiving_Store",input.Store);
											transfer_payload.put("Quantity_Received",ifnull(input.Quantity_Received,0.0));
											transfer_payload.put("Unit_Of_Measure_Received",input.Unit_Of_Measure_Received);
											transfer_payload.put("Quantity_Received_in_Base_Unit_Of_Measure",ifnull(input.Quantity_in_Base_Unit_Of_Measure_Received,0.0));
											transfer_payload.put("Received_By",ifnull(srv_received_by,""));
											transfer_payload.put("Receive_Application","Concrete Products Management");
											transfer_payload.put("Receive_Source_Form","Stock Receiving Details");
											transfer_payload.put("Receive_Source_Record_ID",input.ID);
											transfer_resp = store_management.stock_transfer.update_transfer_receiving_details(transfer_payload);
											info transfer_resp;
											if(transfer_resp == null || transfer_resp.get("ok") != true)
											{
												error_message = "Unable to synchronize Stock Transfer receiving details.";
												if(transfer_resp != null)
												{
													error_message = ifnull(transfer_resp.get("message"),error_message);
												}
												info error_message;
												input.Stock_Receiving_Details_Status = "Draft";
												return;
											}
											transfer_loaded = true;
											if(transfer_resp.get("item_id") != null)
											{
												actual_item_id = transfer_resp.get("item_id").toLong();
											}
											else if(input.Transfer_Item.Item != null)
											{
												actual_item_id = input.Transfer_Item.Item;
											}
											base_uom_name = ifnull(transfer_resp.get("display_uom"),"");
											input.Display_Name_Item = ifnull(transfer_resp.get("display_name_item"),ifnull(input.Display_Name_Item,""));
											transfer_condition = ifnull(transfer_resp.get("stock_condition"),"New").trim();
											if(transfer_condition == "")
											{
												transfer_condition = "New";
											}
											input.Stock_Condition = transfer_condition;
											cond = transfer_condition;
											transfer_rate = ifnull(transfer_resp.get("unit_cost"),ifnull(input.Rate,0.0));
											input.Rate = transfer_rate;
										}
										else if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_rec.ID != null && issue_rec.Item != null)
											{
												actual_item_id = issue_rec.Item;
												base_uom_name = ifnull(issue_rec.Display_Name_Unit_Of_Measure,"");
											}
										}
										else if(rtype == "Stock Receiving Note" || rtype == "Stock Bundling Note" && input.Stock_Created != null)
										{
											actual_item_id = input.Stock_Created.Item;
										}
										if(actual_item_id == null)
										{
											return;
										}
										// ------------------------------------------------------
										// 7) RESOLVE COST FOR STORE POSTING
										// ------------------------------------------------------
										cost_for_store_default = 0.0;
										if(rtype == "Purchase Order")
										{
											cost_for_store_default = po_unit_cost;
										}
										else
										{
											cost_for_store_default = ifnull(input.Rate,0.0);
										}
										// ------------------------------------------------------
										// 8) POST STOCK INTO STORE MANAGEMENT
										// ------------------------------------------------------
										resp = store_management.stock.receive_stock_from_concrete(actual_item_id,store_id,qty,uom_id,cond,cost_for_store_default,ref_no,input.ID);
										info resp;
										if(resp == null || resp.get("ok") != true)
										{
											if(resp != null)
											{
												info resp.get("message");
											}
											input.Stock_Receiving_Details_Status = "Draft";
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure_Received = ifnull(resp.get("base_qty"),0.0);
										input.Stock_Receiving_Details_Status = "Received";
										// ======================================================
										// A) PURCHASE ORDER RECEIVING
										// ======================================================
										if(rtype == "Purchase Order" && po_detail_id != null)
										{
											po_det_status = Purchase_Order_Details[ID == po_detail_id];
											if(po_det_status.ID != null)
											{
												total_received = 0.0;
												all_receive_rows = Stock_Receiving_Details[Receiving_Type == "Purchase Order" && Item == po_detail_id && Stock_Receiving_Details_Status == "Received"];
												for each  rec_row in all_receive_rows
												{
													total_received = total_received + ifnull(rec_row.Quantity_Received,0.0);
												}
												qty_ordered = ifnull(po_det_status.Quantity_Ordered,0.0);
												qty_remaining = qty_ordered - total_received;
												if(qty_remaining < 0)
												{
													qty_remaining = 0.0;
												}
												po_det_status.Quantity_Received=total_received;
												po_det_status.Quantity_Remaining=qty_remaining;
												if(total_received <= 0)
												{
													po_det_status.Receiving_Status="Not Received";
												}
												else if(qty_remaining > 0)
												{
													po_det_status.Receiving_Status="Partially Received";
												}
												else
												{
													po_det_status.Receiving_Status="Fully Received";
												}
												po_det_status.Quantity_Billable=total_received;
												po_det_status.Quantity_Unbilled=total_received - ifnull(po_det_status.Quantity_Billed,0.0);
												if(po_det_status.Quantity_Unbilled < 0)
												{
													po_det_status.Quantity_Unbilled=0.0;
												}
												if(po_det_status.Purchase_Order != null)
												{
													thisapp.po.update_po_receiving_status(po_det_status.Purchase_Order);
												}
											}
										}
										// ======================================================
										// B) CREATE / UPDATE BILL DETAILS FOR PURCHASE ORDERS
										// ======================================================
										if(rtype == "Purchase Order")
										{
											existing_bd = Bill_Details[Stock_Receiving_Details == input.ID];
											if(cond != "Used")
											{
												if(existing_bd.ID != null)
												{
													existing_bd.Item=input.Item;
													existing_bd.Display_Name_Item=input.Display_Name_Item;
													existing_bd.Quantity=input.Quantity_Received;
													existing_bd.Unit_Of_Measure=input.Unit_Of_Measure_Received;
													existing_bd.Display_Name_Unit_Of_Measure=input.Display_Name_Unit_Of_Measure_Received;
													existing_bd.Quantity_Billable=input.Quantity_Received;
													existing_bd.Base_Unit_Of_Measure=base_uom_name;
													existing_bd.Quantity_In_Base_Unit=input.Quantity_in_Base_Unit_Of_Measure_Received;
													existing_bd.Account=srv_store_display;
													existing_bd.Current_Site=srv_store_display;
													existing_bd.Source_Record_ID=input.ID;
													existing_bd.Source_Form="Stock Receiving Details";
													existing_bd.Updated_By_Name=u.get("name");
													existing_bd.Updated_By_Email=u.get("email");
													existing_bd.Updated_By_Time=zoho.currenttime;
												}
												else
												{
													insert into Bill_Details
													[
														Stock_Receiving_Details=input.ID
														Item=input.Item
														Display_Name_Item=input.Display_Name_Item
														Quantity=input.Quantity_Received
														Unit_Of_Measure=input.Unit_Of_Measure_Received
														Display_Name_Unit_Of_Measure=input.Display_Name_Unit_Of_Measure_Received
														Quantity_Billable=input.Quantity_Received
														Base_Unit_Of_Measure=base_uom_name
														Quantity_In_Base_Unit=input.Quantity_in_Base_Unit_Of_Measure_Received
														Account=srv_store_display
														Current_Site=srv_store_display
														Source_Record_ID=input.ID
														Source_Form="Stock Receiving Details"
														Created_By_Name=u.get("name")
														Created_By_Email=u.get("email")
														Created_By_Time=zoho.currenttime
														Added_User=zoho.loginuser
													]
												}
											}
											else
											{
												if(existing_bd.ID != null)
												{
													delete from Bill_Details[ID == existing_bd.ID];
												}
											}
										}
										// ======================================================
										// C) STOCK RETURN / TOOL RETURN STATUS UPDATE
										// ======================================================
										if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_ret = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_ret.ID != null)
											{
												total_returned = 0.0;
												total_returned_base = 0.0;
												return_rows = Stock_Receiving_Details[Receiving_Type == "Stock Return" || Receiving_Type == "Tool Return" && Item_Issuing_Details == input.Item_Issuing_Details && Stock_Receiving_Details_Status == "Received"];
												for each  ret in return_rows
												{
													total_returned = total_returned + ifnull(ret.Quantity_Received,0.0);
													total_returned_base = total_returned_base + ifnull(ret.Quantity_in_Base_Unit_Of_Measure_Received,0.0);
												}
												issue_ret.Quantity_Returned=total_returned;
												issue_ret.Quantity_Returned_in_Base_Unit_Of_Measure=total_returned_base;
												issued_base = ifnull(issue_ret.Quantity_in_Base_Unit_Of_Measure,0.0);
												if(total_returned_base >= issued_base && issued_base > 0)
												{
													issue_ret.Status="Returned";
												}
												else
												{
													if(rtype == "Tool Return")
													{
														issue_ret.Status="Borrowed";
													}
													else
													{
														issue_ret.Status="Issued";
													}
												}
											}
										}
										// ======================================================
										// D) INTERNAL TRANSFER STATUS UPDATE
										// ======================================================
										if(rtype == "Internal Transfer" && input.Item_Issuing_Details != null)
										{
											issue_trans = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_trans.ID != null)
											{
												issue_trans.Status="Received";
											}
										}
										// ======================================================
										// E) STOCK BUNDLING NOTE / STOCK RECEIVING NOTE UPDATE
										// ======================================================
										if(rtype == "Stock Bundling Note" || rtype == "Stock Receiving Note" && input.Stock_Created != null)
										{
											bundle_rec = Stock_Bundling_Note[ID == input.Stock_Created];
											if(bundle_rec.ID != null)
											{
												qty_received_now = ifnull(input.Quantity_Received,0.0);
												qty_to_create = ifnull(bundle_rec.Quantity_To_Be_Created,0.0);
												bundle_rec.Quantity_Created=qty_received_now;
												bundle_rec.Stock_Receiving_Detail=ifnull(input.Stock_Receiving_Voucher_and_Number,"");
												if(qty_received_now <= 0)
												{
													bundle_rec.Stock_Status="Pending";
												}
												else if(qty_to_create > 0 && qty_received_now < qty_to_create)
												{
													bundle_rec.Stock_Status="Partially Received";
												}
												else
												{
													bundle_rec.Stock_Status="Received";
												}
											}
										}
										// ======================================================
										// F) CREATE / UPDATE EMPLOYEE RECEIVING DETAILS
										// ======================================================
										if(rtype == "Stock Return" || rtype == "Tool Return" || rtype == "Stock Receiving Note" || rtype == "Stock Bundling Note")
										{
											source_form_emp = "Concrete Products - Stock Receiving Details";
											recv_voucher = null;
											recv_voucher_display = "";
											line_no = ifnull(input.Stock_Receiving_Voucher_Number,0);
											item_display = ifnull(input.Display_Name_Item,"");
											if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
											{
												issue_emp = Item_Issuing_Details[ID == input.Item_Issuing_Details];
												if(issue_emp.ID != null)
												{
													line_no = ifnull(issue_emp.Line_Number,line_no);
													item_display = ifnull(issue_emp.Display_Name_Item,item_display);
													if(issue_emp.Employee_Voucher != null)
													{
														recv_voucher = issue_emp.Employee_Voucher;
														recv_voucher_display = ifnull(issue_emp.Employee_Voucher.Voucher_Number,"");
													}
													else if(input.Voucher != null)
													{
														recv_voucher = input.Voucher;
														recv_voucher_display = ifnull(input.Display_Name_Voucher,"");
													}
												}
											}
											else if(rtype == "Stock Receiving Note" || rtype == "Stock Bundling Note" && input.Voucher != null)
											{
												recv_voucher = input.Voucher;
												recv_voucher_display = ifnull(input.Display_Name_Voucher,"");
											}
											if(recv_voucher != null)
											{
												existing_erd = Employee_Receiving_Details[Source_Record_ID == input.ID && Source_Form == source_form_emp];
												if(existing_erd.ID != null)
												{
													existing_erd.Voucher=recv_voucher;
													existing_erd.Display_Name_Voucher=recv_voucher_display;
													existing_erd.Line_Number=line_no;
													existing_erd.Display_Name_Item=item_display;
													existing_erd.Quantity=input.Quantity_Received;
													existing_erd.Stock_Receiving_Detail=ifnull(input.Stock_Receiving_Voucher_and_Number,"");
													existing_erd.Source_Record_ID=input.ID;
													existing_erd.Source_Form=source_form_emp;
												}
												else
												{
													insert into Employee_Receiving_Details
													[
														Voucher=recv_voucher
														Display_Name_Voucher=recv_voucher_display
														Line_Number=line_no
														Display_Name_Item=item_display
														Quantity=input.Quantity_Received
														Stock_Receiving_Detail=ifnull(input.Stock_Receiving_Voucher_and_Number,"")
														Source_Record_ID=input.ID
														Source_Form=source_form_emp
														Added_User=zoho.loginuser
													]
												}
											}
										}
										// ======================================================
										// G) CREATE / UPDATE VOUCHER RECEIVING DETAILS
										// ======================================================
										source_form_vrd = "Concrete Products - Stock Receiving Details";
										voucher_recv_id = null;
										voucher_recv_display = "";
										voucher_line_no = ifnull(input.Stock_Receiving_Voucher_Number,0);
										voucher_item_display = ifnull(input.Display_Name_Item,"");
										if(srv.Stock_Receiving_Book != null)
										{
											voucher_recv_id = srv.Stock_Receiving_Book;
											voucher_recv_display = ifnull(srv.Display_Name_Stock_Receiving_Book,"");
										}
										if(voucher_recv_id != null)
										{
											existing_vrd = Voucher_Receiving_Details[Source_Record_ID == input.ID && Source_Form == source_form_vrd];
											if(existing_vrd.ID != null)
											{
												existing_vrd.Voucher=voucher_recv_id;
												existing_vrd.Display_Name_Voucher=voucher_recv_display;
												existing_vrd.Line_Number=voucher_line_no;
												existing_vrd.Display_Name_Item=voucher_item_display;
												existing_vrd.Quantity_Received=input.Quantity_Received;
												existing_vrd.Stock_Receiving_Detail=ifnull(input.Stock_Receiving_Voucher_and_Number,"");
												existing_vrd.Source_Record_ID=input.ID;
												existing_vrd.Source_Form=source_form_vrd;
											}
											else
											{
												insert into Voucher_Receiving_Details
												[
													Voucher=voucher_recv_id
													Display_Name_Voucher=voucher_recv_display
													Line_Number=voucher_line_no
													Display_Name_Item=voucher_item_display
													Quantity_Received=input.Quantity_Received
													Stock_Receiving_Detail=ifnull(input.Stock_Receiving_Voucher_and_Number,"")
													Source_Record_ID=input.ID
													Source_Form=source_form_vrd
													Added_User=zoho.loginuser
												]
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete7 as "Finalize On Delete"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// CONCRETE STOCK RECEIVING DETAILS - FINALIZE ON DELETE
										// ======================================================
										// ---------------------------------------
										// 1) GET SRV HEADER
										// ---------------------------------------
										if(input.Stock_Receiving_Voucher == null)
										{
											return;
										}
										srv = Stock_Receiving_Voucher[ID == input.Stock_Receiving_Voucher];
										if(srv.ID == null || srv.Store == null)
										{
											return;
										}
										store_id = srv.Store;
										ref_no = ifnull(input.Stock_Receiving_Voucher_and_Number,"").trim();
										if(ref_no == "")
										{
											ref_no = ifnull(srv.Display_Name_Stock_Receiving_Book,"").trim();
										}
										if(ref_no == "")
										{
											ref_no = input.ID.toString();
										}
										// ---------------------------------------
										// 2) COMMON VALUES
										// ---------------------------------------
										rtype = ifnull(input.Receiving_Type,"").trim();
										recv_qty = ifnull(input.Quantity_Received,0.0);
										recv_base_qty = ifnull(input.Quantity_in_Base_Unit_Of_Measure_Received,0.0);
										actual_item_id = null;
										// ---------------------------------------
										// 2B) SAFE RESOLVE STOCK CREATED ID
										// ---------------------------------------
										stock_created_id = null;
										old_srd = Stock_Receiving_Details[ID == input.ID];
										if(old_srd.ID != null)
										{
											stock_created_id = old_srd.Stock_Created;
										}
										// ---------------------------------------
										// 3) RESOLVE ACTUAL ITEM
										// ---------------------------------------
										if(rtype == "Purchase Order" && input.Item != null)
										{
											po_det_resolve = Purchase_Order_Details[ID == input.Item];
											if(po_det_resolve.ID != null && po_det_resolve.Item != null)
											{
												actual_item_id = po_det_resolve.Item;
											}
										}
										else if(rtype == "Internal Transfer" && input.Item_Issuing_Details != null)
										{
											issue_resolve = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_resolve.ID != null && issue_resolve.Item != null)
											{
												actual_item_id = issue_resolve.Item;
											}
										}
										else if(rtype == "Stock Return" || rtype == "Tool Return" && input.Item_Issuing_Details != null)
										{
											issue_resolve = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_resolve.ID != null && issue_resolve.Item != null)
											{
												actual_item_id = issue_resolve.Item;
											}
										}
										else if(rtype == "Stock Receiving Note" || rtype == "Stock Bundling Note" && stock_created_id != null)
										{
											bundle_resolve = Stock_Bundling_Note[ID == stock_created_id];
											if(bundle_resolve.ID != null && bundle_resolve.Item != null)
											{
												actual_item_id = bundle_resolve.Item;
											}
										}
										// ---------------------------------------
										// 4) REVERSE STORE STOCK POSTED FROM CONCRETE
										// ---------------------------------------
										store_reverse_resp = store_management.delete_stock_receiving_from_concrete(input.ID);
										info store_reverse_resp;
										// ======================================================
										// A) PURCHASE ORDER DELETE REVERSAL
										// ======================================================
										if(rtype == "Purchase Order" && input.Item != null)
										{
											po_det = Purchase_Order_Details[ID == input.Item];
											if(po_det.ID != null && po_det.Item != null)
											{
												bill_rows = Bill_Details[Stock_Receiving_Details == input.ID];
												for each  bd in bill_rows
												{
													delete from Bill_Details[ID == bd.ID];
												}
												total_received = 0.0;
												remaining_rows = Stock_Receiving_Details[Receiving_Type == "Purchase Order" && Item == input.Item && ID != input.ID && Stock_Receiving_Details_Status == "Received"];
												for each  rr in remaining_rows
												{
													total_received = total_received + ifnull(rr.Quantity_Received,0.0);
												}
												qty_ordered = ifnull(po_det.Quantity_Ordered,0.0);
												qty_remaining = qty_ordered - total_received;
												if(qty_remaining < 0)
												{
													qty_remaining = 0.0;
												}
												po_det.Quantity_Received=total_received;
												po_det.Quantity_Remaining=qty_remaining;
												po_det.Quantity_Billable=total_received;
												po_det.Quantity_Unbilled=total_received - ifnull(po_det.Quantity_Billed,0.0);
												if(po_det.Quantity_Unbilled < 0)
												{
													po_det.Quantity_Unbilled=0.0;
												}
												if(total_received <= 0)
												{
													po_det.Receiving_Status="Not Received";
												}
												else if(qty_remaining > 0)
												{
													po_det.Receiving_Status="Partially Received";
												}
												else
												{
													po_det.Receiving_Status="Fully Received";
												}
												if(po_det.Purchase_Order != null)
												{
													thisapp.po.update_po_receiving_status(po_det.Purchase_Order);
												}
											}
										}
										// ======================================================
										// B) STOCK BUNDLING NOTE / STOCK RECEIVING NOTE DELETE REVERSAL
										// ======================================================
										else if(rtype == "Stock Receiving Note" || rtype == "Stock Bundling Note" && stock_created_id != null)
										{
											bundle_rec = Stock_Bundling_Note[ID == stock_created_id];
											if(bundle_rec.ID != null)
											{
												qty_to_create = ifnull(bundle_rec.Quantity_To_Be_Created,0.0);
												total_created = 0.0;
												created_rows = Stock_Receiving_Details[Receiving_Type == "Stock Receiving Note" || Receiving_Type == "Stock Bundling Note" && Stock_Created == stock_created_id && ID != input.ID && Stock_Receiving_Details_Status == "Received"];
												for each  cr in created_rows
												{
													total_created = total_created + ifnull(cr.Quantity_Received,0.0);
												}
												bundle_rec.Quantity_Created=total_created;
												if(total_created <= 0)
												{
													bundle_rec.Stock_Status="Pending";
													bundle_rec.Stock_Receiving_Detail="";
												}
												else if(qty_to_create > 0 && total_created < qty_to_create)
												{
													bundle_rec.Stock_Status="Partially Received";
												}
												else
												{
													bundle_rec.Stock_Status="Received";
												}
											}
										}
										// ======================================================
										// C) TOOL RETURN / STOCK RETURN DELETE REVERSAL
										// ======================================================
										else if(rtype == "Tool Return" || rtype == "Stock Return" && input.Item_Issuing_Details != null)
										{
											issue_rec = Item_Issuing_Details[ID == input.Item_Issuing_Details];
											if(issue_rec.ID != null)
											{
												total_returned = 0.0;
												total_returned_base = 0.0;
												return_rows = Stock_Receiving_Details[Receiving_Type == "Tool Return" || Receiving_Type == "Stock Return" && Item_Issuing_Details == input.Item_Issuing_Details && ID != input.ID && Stock_Receiving_Details_Status == "Received"];
												for each  ret in return_rows
												{
													total_returned = total_returned + ifnull(ret.Quantity_Received,0.0);
													total_returned_base = total_returned_base + ifnull(ret.Quantity_in_Base_Unit_Of_Measure_Received,0.0);
												}
												issue_rec.Quantity_Returned=total_returned;
												issue_rec.Quantity_Returned_in_Base_Unit_Of_Measure=total_returned_base;
												issued_base = ifnull(issue_rec.Quantity_in_Base_Unit_Of_Measure,0.0);
												if(total_returned_base >= issued_base && issued_base > 0)
												{
													issue_rec.Status="Returned";
												}
												else
												{
													if(rtype == "Tool Return")
													{
														issue_rec.Status="Borrowed";
													}
													else
													{
														issue_rec.Status="Issued";
													}
												}
											}
										}
										// ======================================================
										// D) INTERNAL TRANSFER DELETE REVERSAL
										// ======================================================
										else if(rtype == "Internal Transfer")
										{
											reverse_payload = Map();
											reverse_payload.put("Receive_Source_Record_ID",input.ID);
											reverse_payload.put("Receive_Source_Form","Stock Receiving Details");
											reverse_payload.put("Receive_Application","Concrete Products Management");
											transfer_reverse_resp = store_management.stock_transfer.reverse_transfer_receiving(reverse_payload);
											info transfer_reverse_resp;
											if(transfer_reverse_resp == null || transfer_reverse_resp.get("ok") != true)
											{
												if(transfer_reverse_resp != null)
												{
													info ifnull(transfer_reverse_resp.get("message"),"Internal Transfer receiving reversal failed.");
												}
												else
												{
													info "Internal Transfer receiving reversal returned no response.";
												}
											}
										}
										// ======================================================
										// E) DELETE CONCRETE EMPLOYEE RECEIVING DETAILS
										// ======================================================
										emp_rows = Employee_Receiving_Details[Source_Record_ID == input.ID && Source_Form == "Concrete Products - Stock Receiving Details"];
										for each  erd in emp_rows
										{
											delete from Employee_Receiving_Details[ID == erd.ID];
										}
										// ======================================================
										// F) DELETE CONCRETE VOUCHER RECEIVING DETAILS
										// ======================================================
										vrd_rows = Voucher_Receiving_Details[Source_Record_ID == input.ID && Source_Form == "Concrete Products - Stock Receiving Details"];
										for each  vrd in vrd_rows
										{
											delete from Voucher_Receiving_Details[ID == vrd.ID];
										}
						)
					}
				}

			}
			Finalize_On_Delete8 as "Finalize On Delete"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// CONCRETE ITEM ISSUING DETAILS - FINALIZE ON DELETE
										// Reverses Store stock posted from Concrete
										// Deletes Employee Issuing Details
										// Deletes Voucher Issuing Details
										// =====================================
										source_form_val = "Concrete Products - Item Issuing Details";
										// -------------------------------------
										// 1) Reverse Store stock posted from Concrete
										// -------------------------------------
										// This function must exist in Store Management.
										// If not yet created, I will give it next.
										store_reverse_resp = store_management.delete_item_issuing_from_concrete(input.ID);
										info store_reverse_resp;
										// -------------------------------------
										// -------------------------------------
										// 3) Delete Concrete Employee Issuing Details row
										// Only Employee Voucher lines create this
										// -------------------------------------
										emp_rows = Employee_Issuing_Details[Source_Record_ID == input.ID && Source_Form == source_form_val];
										for each  erd in emp_rows
										{
											delete from Employee_Issuing_Details[ID == erd.ID];
										}
										// -------------------------------------
										// 4) Delete Concrete Voucher Issuing Details row
										// All Item Issuing Details lines create this
										// -------------------------------------
										vid_rows = Voucher_Issuing_Details[Source_Record_ID == input.ID && Source_Form == source_form_val];
										for each  vid in vid_rows
										{
											delete from Voucher_Issuing_Details[ID == vid.ID];
										}
						)
					}
				}

			}
			Finalize_On_Create4 as "Finalize On Create"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
										// ======================================================
										// PAYMENT MADE VOUCHER — FINALIZE ON CREATE
										// ======================================================
										if(input.Payment_Made_Date == null)
										{
											input.Payment_Made_Date = zoho.currenttime;
										}
						)
					}
				}

			}
