			Full_Validation29 as "Full Validation"
			{
				type =  form
				form = Truck_Type

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										if(input.Truck_Type_Name == null || input.Truck_Type_Name.trim() == "")
										{
											errors = errors + "\n• Truck Type Name is required.";
										}
										else
										{
											name = input.Truck_Type_Name.trim();
											dup = Truck_Type[Truck_Type_Name == name && ID != input.ID];
											if(dup.count() > 0)
											{
												errors = errors + "\n• Truck Type Name already exists.";
											}
										}
										if(input.Truck_Type_Status == null || input.Truck_Type_Status == "")
										{
											errors = errors + "\n• Truck Type Status is required.";
										}
										if(errors != "")
										{
											alert errors;
											cancel submit;
										}
						)
					}
				}

			}
