			On_Quantity_Ordered_Selec as "On Quantity Ordered Selected"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on user input of PO_Details.Quantity_Ordered
				{
					actions 
					{
						custom deluge script
						(
											for each  po_det in input.PO_Details
										{
											if(po_det.Item == null || po_det.Unit_Of_Measure == null)
											{
												po_det.Quantity_in_Base_Unit_Of_Measure=null;
												po_det.Line_Total=null;
												continue;
											}
											check = store_management.po.check_uom_conversion_from_masaka_site_management(po_det.Item,po_det.Unit_Of_Measure);
											if(check.get("ok") != true)
											{
												alert check.get("message");
												po_det.Quantity_in_Base_Unit_Of_Measure=null;
												po_det.Line_Total=null;
												continue;
											}
											resp = store_management.po.recalculate_po_detail_line_from_masaka_site_management(po_det.Item,po_det.Unit_Of_Measure,po_det.Quantity_Ordered,po_det.Unit_Cost);
											po_det.Display_Name_Unit_Of_Measure=resp.get("display_uom_name");
											po_det.Quantity_in_Base_Unit_Of_Measure=resp.get("qty_in_base");
											po_det.Line_Total=resp.get("line_total");
											if(po_det.Quantity_Ordered != null)
											{
												received_qty = ifnull(po_det.Quantity_Received,0.0);
												po_det.Quantity_Remaining=po_det.Quantity_Ordered - received_qty;
												if(po_det.Quantity_Remaining < 0)
												{
													po_det.Quantity_Remaining=0.0;
												}
											}
										}
										po_total = 0.0;
										for each  po_det in input.PO_Details
										{
											po_total = po_total + ifnull(po_det.Line_Total,0.0);
										}
										input.PO_Total = po_total;
						)
					}
				}

			}
			On_Unit_Cost_Selected as "On Unit Cost Selected"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on user input of PO_Details.Unit_Cost
				{
					actions 
					{
						custom deluge script
						(
											for each  po_det in input.PO_Details
										{
											if(po_det.Item == null || po_det.Unit_Of_Measure == null)
											{
												po_det.Line_Total=null;
												continue;
											}
											check = store_management.po.check_uom_conversion_from_masaka_site_management(po_det.Item,po_det.Unit_Of_Measure);
											if(check.get("ok") != true)
											{
												alert check.get("message");
												po_det.Line_Total=null;
												continue;
											}
											resp = store_management.po.recalculate_po_detail_line_from_masaka_site_management(po_det.Item,po_det.Unit_Of_Measure,po_det.Quantity_Ordered,po_det.Unit_Cost);
											po_det.Display_Name_Unit_Of_Measure=resp.get("display_uom_name");
											po_det.Quantity_in_Base_Unit_Of_Measure=resp.get("qty_in_base");
											po_det.Line_Total=resp.get("line_total");
										}
										po_total = 0.0;
										for each  po_det in input.PO_Details
										{
											po_total = po_total + ifnull(po_det.Line_Total,0.0);
										}
										input.PO_Total = po_total;
						)
					}
				}

			}
			On_Unit_Of_Measure_Select1 as "On Unit Of Measure Selected"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

