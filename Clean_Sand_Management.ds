			Full_Validation_On_Edit as "Full Validation On Edit"
			{
				type =  form
				form = Asset_Issues

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Work_Order_Number == null || input.Work_Order_Number.trim() == "")
										{
											doc_key = Document_Key[Voucher_Type == "Work Order" && Document_Key_Status == "Active"];
											if(doc_key.ID == null)
											{
												alert "Document Key for Work Order is not configured.";
