			Set_Up_Form35 as "Set Up Form"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// BACK END (CREATE & EDIT)
										// =====================================================
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// =====================================================
										// BACK END USER NAME
										// =====================================================
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// =====================================================
										//DISABLE FIELDS / HIDE FIELDS
										// =====================================================
										hide Display_Name_Sales_Voucher;
										hide Display_Name_Customer;
										hide Reason_why_Cancelled;
										disable Credit_Limit;
										disable Current_Outstanding_Balance;
										disable Available_Credit;
										disable Credit_Days_Allowed;
										disable Due_Date;
										disable Balance_Due;
										disable Customer;
										disable Credit_Note_Status;
										disable Amount_Due;
						)
					}
