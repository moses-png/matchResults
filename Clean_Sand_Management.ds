			On_Item_Issuing_Voucher_S as "On Item Issuing Voucher Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Issuing_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Issuing_Voucher != null)
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID != null)
											{
												// 1. Display Name Issuing Voucher
												input.Display_Name_Issuing_Voucher = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"");
												// 2. Display Name Issued By
												input.Display_Name_Issued_By = ifnull(hdr.Issued_By,"");
												// 3. Store
												if(hdr.Store != null)
												{
													input.Store = ifnull(hdr.Store.Asset_Name,"") + " - " + ifnull(hdr.Store.Asset_ID,"");
												}
												else
												{
													input.Store = null;
												}
												// 4. Item Issuing Number preview
												voucher_name = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim();
												if(input.Line_Number != null && input.Line_Number > 0)
												{
													ln = input.Line_Number;
													lineNo = if(ln < 10,"0" + ln.toString(),ln.toString());
													if(voucher_name != "")
													{
														input.Item_Issuing_Number = voucher_name + "-" + lineNo;
													}
													else
													{
														input.Item_Issuing_Number = "-" + lineNo;
													}
												}
												else
												{
													if(voucher_name != "")
													{
														input.Item_Issuing_Number = voucher_name + "-";
													}
													else
													{
														input.Item_Issuing_Number = null;
													}
												}
											}
											else
											{
												input.Display_Name_Issuing_Voucher = null;
												input.Display_Name_Issued_By = null;
												input.Store = null;
												input.Item_Issuing_Number = null;
											}
										}
										else
										{
											input.Display_Name_Issuing_Voucher = null;
											input.Display_Name_Issued_By = null;
											input.Store = null;
											input.Item_Issuing_Number = null;
										}
						)
					}
				}

			}
			On_Item_Selected6 as "On Item Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Item
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// CONCRETE - ITEM ISSUING DETAILS
										// ON ITEM SELECTED
										// Uses Store Management function
										// ======================================================
										// ======================================================
										// 1) ITEM CLEARED
										// ======================================================
										if(input.Item == null)
										{
											input.Display_Name_Item = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Cost = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											input.Global_Available_Stock = null;
											input.Store_Available_Stock = null;
											input.Quantity = null;
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Status = null;
											hide Expected_Return_Date;
											input.Expected_Return_Date = null;
											return;
										}
										// ======================================================
										// 2) ITEM ID
										// ======================================================
										item_id = null;
										item_id = input.Item.ID;
										if(item_id == null)
										{
											alert "Selected item could not be resolved.";
											input.Item = null;
											return;
										}
										// ======================================================
										// 3) RESOLVE STORE FROM ISSUING VOUCHER
										// ======================================================
										store_id = null;
										if(input.Issuing_Voucher != null)
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID != null && hdr.Store != null)
											{
												store_id = hdr.Store.ID;
											}
										}
										if(store_id == null)
										{
											alert "This voucher has no Store selected. Please check the Item Issuing Voucher header.";
											input.Item = null;
											input.Display_Name_Item = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Cost = null;
											input.Global_Available_Stock = null;
											input.Store_Available_Stock = null;
											return;
										}
										// ======================================================
										// 4) STOCK CONDITION
										// ======================================================
										cond = ifnull(input.Stock_Condition,"").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = cond;
										}
										// ======================================================
										// 5) GET ITEM + STOCK + COST + UOM FROM STORE MANAGEMENT
										// ======================================================
										stock_map = store_management.po.get_item_store_cost_from_concrete(item_id,store_id,cond);
										if(stock_map == null)
										{
											alert "Could not get item stock details from Store Management.";
											input.Display_Name_Item = null;
											input.Unit_Of_Measure = null;
											input.Display_Name_Unit_Of_Measure = null;
											input.Cost = 0.0;
											input.Global_Available_Stock = 0.0;
											input.Store_Available_Stock = 0.0;
											return;
										}
										// ======================================================
										// 6) FILL ITEM DISPLAY
										// ======================================================
										input.Display_Name_Item = ifnull(stock_map.get("display_name_item"),"");
										// ======================================================
										// 7) FILL STOCK + COST
										// ======================================================
										input.Global_Available_Stock = ifnull(stock_map.get("global_stock"),0.0);
										input.Store_Available_Stock = ifnull(stock_map.get("store_stock"),0.0);
										input.Cost = ifnull(stock_map.get("cost"),0.0);
										// ======================================================
										// 8) FILL UOM
										// ======================================================
										input.Unit_Of_Measure = stock_map.get("base_uom");
										input.Display_Name_Unit_Of_Measure = ifnull(stock_map.get("base_uom_name"),"");
										if(input.Unit_Of_Measure == null)
										{
											alert "Base Unit of Measure is missing for this item in Store Management.";
										}
										// ======================================================
										// 9) CLEAR OLD QUANTITY CALCULATIONS ONLY
										// ======================================================
										input.Quantity = null;
										input.Quantity_in_Base_Unit_Of_Measure = null;
										input.Line_Total = null;
										Rate_In_Base_Unit = 0.0;
										// ======================================================
										// 10) STATUS / TOOL HANDLING
										// ======================================================
										req_type = ifnull(input.Request_Voucher_Type,"").trim();
										is_tool = ifnull(stock_map.get("is_tool"),false);
										if(is_tool == true && req_type != "Internal Transfer")
										{
											show Expected_Return_Date;
											input.Status = "Borrowed";
										}
										else if(is_tool == true && req_type == "Internal Transfer")
										{
											hide Expected_Return_Date;
											input.Expected_Return_Date = null;
											input.Status = "Transferring";
										}
										else
										{
											hide Expected_Return_Date;
											input.Expected_Return_Date = null;
											input.Status = "Issued";
										}
						)
					}
				}

			}
			On_Line_Number_Selected as "On Line Number Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Line_Number
				{
					actions 
					{
						custom deluge script
						(
											// Format line number first
										if(input.Line_Number != null && input.Line_Number > 0)
										{
											ln = input.Line_Number;
											lineNo = if(ln < 10,"0" + ln.toString(),ln.toString());
										}
										else
										{
											input.Item_Issuing_Number = null;
											if(input.Request_Voucher_Type == "Internal Transfer")
											{
												input.Request_Voucher = null;
											}
											return;
										}
										// If Issuing Voucher exists, prepend it
										if(input.Issuing_Voucher != null)
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID != null && ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim() != "")
											{
												input.Item_Issuing_Number = hdr.Display_Name_Item_Issuing_Voucher + "-" + lineNo;
											}
											else
											{
												input.Item_Issuing_Number = "-" + lineNo;
											}
										}
										else
										{
											// Voucher empty → show line only
											input.Item_Issuing_Number = "-" + lineNo;
										}
										// Sync Request Voucher AFTER Item Issuing Number is finalized
										if(input.Request_Voucher_Type == "Internal Transfer")
										{
											input.Request_Voucher = input.Item_Issuing_Number;
										}
						)
					}
				}

			}
			On_Quantity_Entered as "On Quantity Entered"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Quantity
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// ITEM ISSUING DETAILS — ON QUANTITY CHANGED
										// Concrete Management
										// ======================================================
										if(input.Item == null || input.Unit_Of_Measure == null)
										{
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// Resolve Store
										store_id = null;
										if(input.Issuing_Voucher != null)
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID != null && hdr.Store != null)
											{
												store_id = hdr.Store.ID;
											}
										}
										if(store_id == null)
										{
											alert "This Issuing Voucher has no Store selected.";
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// Stock condition
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = cond;
										}
										// Always refresh stock/cost first
										stock_map = store_management.po.get_item_store_cost_from_concrete(input.Item.ID,store_id,cond);
										if(stock_map != null)
										{
											input.Global_Available_Stock = ifnull(stock_map.get("global_stock"),0.0);
											input.Store_Available_Stock = ifnull(stock_map.get("store_stock"),0.0);
											if(input.Cost == null || input.Cost <= 0)
											{
												input.Cost = ifnull(stock_map.get("cost"),0.0);
											}
										}
										// If quantity is blank, stop after refreshing stock
										if(input.Quantity == null || input.Quantity <= 0)
										{
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// UOM validation
										check = store_management.po.check_uom_conversion_from_concrete(input.Item.ID,input.Unit_Of_Measure.ID);
										if(check.get("ok") != true)
										{
											alert check.get("message");
											input.Unit_Of_Measure = null;
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// Convert to base quantity
										resp = store_management.po.recalculate_po_detail_line_from_concrete(input.Item.ID,input.Unit_Of_Measure.ID,input.Quantity,ifnull(input.Cost,0.0));
										base_qty = ifnull(resp.get("qty_in_base"),0.0);
										if(base_qty <= 0)
										{
											alert "Calculated base quantity is invalid.";
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure = base_qty;
										// Stock warning
										if(base_qty > ifnull(input.Store_Available_Stock,0.0))
										{
											alert "Insufficient store stock. Available: " + ifnull(input.Store_Available_Stock,0.0) + " Base UOM. Required: " + base_qty;
											input.Quantity = null;
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// Line total
										input.Line_Total = (base_qty * ifnull(input.Cost,0.0)).round(2);
										// Rate in base unit
										if(base_qty > 0 && input.Line_Total != null && input.Line_Total > 0)
										{
											Rate_In_Base_Unit = (input.Line_Total / base_qty).round(2);
										}
										else
										{
											Rate_In_Base_Unit = 0.0;
										}
						)
					}
				}

			}
			On_Reason_Why_Cancelled_S as "On Reason Why Cancelled Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Reason_Why_Cancelled
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_This_Line_Item == true)
										{
											show Reason_Why_Cancelled;
											enable Reason_Why_Cancelled;
										}
										else
										{
											input.Reason_Why_Cancelled = null;
											hide Reason_Why_Cancelled;
											disable Reason_Why_Cancelled;
										}
						)
					}
				}

			}
			On_Request_Voucher_Type_S as "On Request Voucher Type Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Request_Voucher_Type
				{
					actions 
					{
						custom deluge script
						(
											hide Employee_Voucher;
										hide Work_Order_Task;
										hide Sales_Voucher;
										hide Item_Taken;
										if(input.Request_Voucher_Type == "Employee Voucher")
										{
											show Employee_Voucher;
										}
										else if(input.Request_Voucher_Type == "Work Order Task")
										{
											show Work_Order_Task;
										}
										else if(input.Request_Voucher_Type == "Sales Voucher")
										{
											show Sales_Voucher;
											show Item_Taken;
											show Items_Image;
											hide Item;
										}
										else if(input.Request_Voucher_Type == "Internal Transfer")
										{
											input.Request_Voucher = ifnull(input.Item_Issuing_Number,"");
										}
										else
										{
											input.Request_Voucher = "";
										}
						)
					}
				}

			}
			On_Stock_Condition_Select as "On Stock Condition Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Stock_Condition
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// Concrete Products - Item Issuing Details
										// On Stock Condition Selected
										// Cross application: Store Management
										// ========================================
										if(input.Item == null)
										{
											input.Stock_Condition = null;
											input.Global_Available_Stock = null;
											input.Store_Available_Stock = null;
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											input.Cost = null;
											return;
										}
										// Resolve Store
										store_id = null;
										if(input.Issuing_Voucher != null)
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID != null && hdr.Store != null)
											{
												store_id = hdr.Store.ID;
											}
										}
										if(store_id == null)
										{
											alert "This voucher has no Store selected. Please check the Item Issuing Voucher header.";
											input.Stock_Condition = null;
											input.Global_Available_Stock = null;
											input.Store_Available_Stock = null;
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											input.Cost = null;
											return;
										}
										// Stock Condition
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = cond;
										}
										// Refresh stock/cost from Store Management
										stock_map = store_management.po.get_item_store_cost_from_concrete(input.Item.ID,store_id,cond);
										if(stock_map != null)
										{
											input.Global_Available_Stock = ifnull(stock_map.get("global_stock"),0.0);
											input.Store_Available_Stock = ifnull(stock_map.get("store_stock"),0.0);
											input.Cost = ifnull(stock_map.get("cost"),0.0);
											if(input.Unit_Of_Measure == null)
											{
												input.Unit_Of_Measure = stock_map.get("base_uom");
												input.Display_Name_Unit_Of_Measure = ifnull(stock_map.get("base_uom_name"),"");
											}
										}
										else
										{
											input.Global_Available_Stock = 0.0;
											input.Store_Available_Stock = 0.0;
											input.Cost = 0.0;
										}
										// Recalculate only if quantity already exists
										if(input.Quantity != null && input.Quantity > 0 && input.Unit_Of_Measure != null)
										{
											check = store_management.po.check_uom_conversion_from_concrete(input.Item.ID,input.Unit_Of_Measure.ID);
											if(check != null && check.get("ok") == true)
											{
												base_qty = store_management.po.convert_to_base_qty_from_concrete(input.Item.ID,input.Unit_Of_Measure.ID,input.Quantity);
												if(base_qty != null && base_qty > 0)
												{
													input.Quantity_in_Base_Unit_Of_Measure = base_qty;
													input.Line_Total = (base_qty * ifnull(input.Cost,0.0)).round(2);
												}
												else
												{
													input.Quantity_in_Base_Unit_Of_Measure = null;
													input.Line_Total = null;
												}
											}
											else
											{
												input.Quantity_in_Base_Unit_Of_Measure = null;
												input.Line_Total = null;
											}
										}
										else
										{
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
										}
						)
					}
				}

			}
			On_Unit_Of_Measure_Select2 as "On Unit Of Measure Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											// ----------------------------------------
										// 1) Basic checks
										// ----------------------------------------
										if(input.Item == null || input.Unit_Of_Measure == null)
										{
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// ----------------------------------------
										// 2) Resolve store from voucher
										// ----------------------------------------
										store_id = null;
										if(input.Issuing_Voucher != null)
										{
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID != null && hdr.Store != null)
											{
												store_id = hdr.Store.ID;
											}
										}
										if(store_id == null)
										{
											alert "The voucher has no Store assigned. Please check the Issuing Voucher.";
											return;
										}
										// ----------------------------------------
										// 3) Stock condition
										// ----------------------------------------
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = cond;
										}
										// ----------------------------------------
										// 4) Refresh stock and cost first
										// ----------------------------------------
										stock_map = store_management.po.get_item_store_cost_from_concrete(input.Item.ID,store_id,cond);
										if(stock_map != null)
										{
											input.Store_Available_Stock = ifnull(stock_map.get("store_stock"),0.0);
											input.Global_Available_Stock = ifnull(stock_map.get("global_stock"),0.0);
											if(input.Cost == null || input.Cost <= 0)
											{
												input.Cost = ifnull(stock_map.get("cost"),0.0);
											}
										}
										// Stop here if quantity is blank
										if(input.Quantity == null || input.Quantity <= 0)
										{
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// ----------------------------------------
										// 5) Ensure UoM conversion exists
										// ----------------------------------------
										check = store_management.po.check_uom_conversion_from_concrete(input.Item.ID,input.Unit_Of_Measure.ID);
										if(check == null || check.get("ok") != true)
										{
											msg = "Unit of Measure conversion is missing.";
											if(check != null)
											{
												msg = ifnull(check.get("message"),msg);
											}
											alert msg;
											input.Unit_Of_Measure = null;
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// ----------------------------------------
										// 6) Convert to base quantity
										// ----------------------------------------
										base_qty = store_management.po.convert_to_base_qty_from_concrete(input.Item.ID,input.Unit_Of_Measure.ID,input.Quantity);
										if(base_qty == null || base_qty <= 0)
										{
											alert "Calculated base quantity is invalid.";
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure = base_qty;
										// ----------------------------------------
										// 7) Validate stock
										// ----------------------------------------
										store_stock = ifnull(input.Store_Available_Stock,0.0);
										if(base_qty > store_stock)
										{
											alert "Insufficient store stock. Available: " + store_stock + " (Base UoM).";
											input.Quantity_in_Base_Unit_Of_Measure = null;
											input.Line_Total = null;
											Rate_In_Base_Unit = 0.0;
											return;
										}
										// ----------------------------------------
										// 8) Calculate Line Total
										// ----------------------------------------
										input.Line_Total = (base_qty * ifnull(input.Cost,0.0)).round(2);
										// ----------------------------------------
										// 9) Rate in base unit
										// ----------------------------------------
										if(base_qty > 0 && input.Line_Total != null && input.Line_Total > 0)
										{
											Rate_In_Base_Unit = (input.Line_Total / base_qty).round(2);
										}
										else
										{
											Rate_In_Base_Unit = 0.0;
										}
						)
					}
				}

			}
			On_Work_Order_Task_Select as "On Work Order Task Selected"
			{
				type =  form
				form = Item_Issuing_Details

