			On_Total_Amount_Received_ as "On Total Amount Received Selected"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on user input of Total_Amount_Received
				{
					actions 
					{
						custom deluge script
						(
											total_received = ifnull(input.Total_Amount_Received,0);
										total_charges = ifnull(input.Total_Charges,0);
										amount_allocated = ifnull(input.Total_Amount_Allocated,0);
										// Net amount available after charges
										net_received = total_received - total_charges;
										if(net_received < 0)
										{
											net_received = 0;
										}
										input.Total_Amount_Not_Allocated = net_received - amount_allocated;
										if(input.Total_Amount_Not_Allocated < 0)
										{
											input.Total_Amount_Not_Allocated = 0;
										}
						)
					}
				}

			}
			Add_Row_Charge_Details_1 as "Add Row \"Charge Details\""
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on add row of Charge_Details
				{
					actions 
					{
						custom deluge script
						(
											max_line = 0;
										for each  r in input.Charge_Details
										{
											if(ifnull(r.Line_Number,0) > max_line)
											{
												max_line = r.Line_Number;
											}
										}
										row.Line_Number=max_line + 1;
										row.Transaction_Type="Payment Received";
										row.Display_Name_Payment_Voucher=ifnull(input.Payment_Receipt_Number,"");
										row.Amount=0;
						)
					}
				}

			}
			Delete_Row_Charge_Details1 as "Delete Row \"Charge Details\""
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on delete row of Charge_Details
				{
					actions 
					{
						custom deluge script
						(
											total_charges = 0.0;
										for each  chg in input.Charge_Details
										{
											total_charges = total_charges + ifnull(chg.Amount,0);
										}
										input.Total_Charges = total_charges;
										input.Total_Amount_Not_Allocated = ifnull(input.Total_Amount_Received,0) - ifnull(input.Total_Charges,0) - ifnull(input.Total_Amount_Allocated,0);
										if(input.Total_Amount_Not_Allocated < 0)
										{
											input.Total_Amount_Not_Allocated = 0;
										}
						)
					}
				}

			}
			Full_Validation20 as "Full Validation"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Receiving_Account == null)
										{
											alert "Receiving Account is required.";
											cancel submit;
										}
										if(input.Payment_Receipt_Number == null || input.Payment_Receipt_Number.trim() == "")
										{
											alert "Payment Receipt Number is required.";
											cancel submit;
										}
										if(input.Payment_Receipt_Date == null)
										{
											input.Payment_Receipt_Date = zoho.currenttime;
										}
										if(input.Customer == null)
										{
											alert "Customer is required.";
											cancel submit;
										}
										if(input.Total_Amount_Received == null || input.Total_Amount_Received <= 0)
										{
											alert "Total Amount Received must be greater than 0.";
											cancel submit;
										}
										if(input.Payment_Receipt_Number != null && input.Payment_Receipt_Number != "")
										{
											dupe = Payment_Receipt_Voucher[Payment_Receipt_Number == input.Payment_Receipt_Number && ID != input.ID];
											if(dupe.ID != null)
											{
												alert "Duplicate Payment Receipt Number found: " + input.Payment_Receipt_Number;
												cancel submit;
											}
										}
						)
					}
				}

			}
			Finalize16 as "Finalize"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											rec = Payment_Receipt_Voucher[ID == input.ID];
										if(rec.ID != null)
										{
											if(rec.Payment_Receipt_Date == null)
											{
												rec.Payment_Receipt_Date=zoho.currenttime;
											}
											total_charges = 0.0;
											for each  chg in rec.Charge_Details
											{
												total_charges = total_charges + ifnull(chg.Amount,0);
											}
											rec.Total_Charges=total_charges;
											total_allocated = 0.0;
											for each  det in Payment_Receipt_Details[Payment_Receipt_Voucher == rec.ID]
											{
												total_allocated = total_allocated + ifnull(det.Amount_Allocated,0);
											}
											rec.Total_Amount_Allocated=total_allocated;
											rec.Total_Amount_Not_Allocated=ifnull(rec.Total_Amount_Received,0) - ifnull(rec.Total_Charges,0) - ifnull(rec.Total_Amount_Allocated,0);
											if(rec.Total_Amount_Not_Allocated < 0)
											{
												rec.Total_Amount_Not_Allocated=0;
											}
											if(ifnull(rec.Total_Amount_Allocated,0) == 0)
											{
												rec.Payment_Receipt_Voucher_Status="Unassigned";
											}
											else if(rec.Total_Amount_Not_Allocated > 0)
											{
												rec.Payment_Receipt_Voucher_Status="Partially Assigned";
											}
											else
											{
												rec.Payment_Receipt_Voucher_Status="Fully Assigned";
											}
										}
										if(input.ID != null)
										{
											receipt_datetime_txt = "";
											receipt_date_txt = "";
											if(input.Payment_Receipt_Date != null)
											{
												receipt_datetime_txt = input.Payment_Receipt_Date.toString("yyyy-MM-dd HH:mm:ss");
												receipt_date_txt = input.Payment_Receipt_Date.toString("yyyy-MM-dd");
											}
											created_time_txt = "";
											if(input.Created_By_Time != null)
											{
												created_time_txt = input.Created_By_Time.toString("yyyy-MM-dd HH:mm:ss");
											}
											updated_time_txt = "";
											if(input.Updated_By_Time != null)
											{
												updated_time_txt = input.Updated_By_Time.toString("yyyy-MM-dd HH:mm:ss");
											}
											// ==============================
											// SYNC PAYMENT VOUCHER
											// ==============================
											payload = Map();
											payload.put("Transaction_Type","Debit");
											payload.put("Account",input.Receiving_Account);
											payload.put("Display_Name_Account",ifnull(input.Display_Name_Receiving_Account,""));
											payload.put("Payment_Number",ifnull(input.Payment_Receipt_Number,""));
											payload.put("Payment_Date",receipt_date_txt);
											payload.put("Payment_Date_Time",receipt_datetime_txt);
											payload.put("Description",ifnull(input.Display_Name_Customer,""));
											payload.put("Total_Amount_Received",ifnull(input.Total_Amount_Received,0.0));
											payload.put("Total_Amount_Paid",0.0);
											payload.put("Payment_Voucher_Status","Draft");
											payload.put("Application","Clean Sand Management");
											payload.put("Transaction_Date",receipt_date_txt);
											payload.put("Source_Form","Payment Receipt Voucher");
											payload.put("Source_Record_ID",input.ID.toLong());
											payload.put("Voucher_Number",ifnull(input.Payment_Receipt_Number,""));
											payload.put("User_Name",ifnull(input.User_Name,""));
											payload.put("User_Email",ifnull(input.User_Email,""));
											payload.put("User_Role",ifnull(input.User_Role,""));
											payload.put("Created_By_Name",ifnull(input.Created_By_Name,""));
											payload.put("Created_By_Email",ifnull(input.Created_By_Email,""));
											payload.put("Created_By_Time",created_time_txt);
											payload.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
											payload.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
											payload.put("Updated_By_Time",updated_time_txt);
											sync_resp = payment_management.syncPaymentVoucherFromCleanSand(payload);
											info sync_resp;
											// ==============================
											// ACCOUNT TRANSACTION LOG
											// ==============================
											receipt_dt = input.Payment_Receipt_Date;
											if(receipt_dt == null)
											{
												receipt_dt = zoho.currenttime;
											}
											txn = Map();
											txn.put("Transaction_Date",receipt_dt);
											txn.put("Account",input.Receiving_Account);
											txn.put("Display_Name_Account",ifnull(input.Display_Name_Receiving_Account,""));
											txn.put("Transaction_Type","Debit");
											txn.put("Amount",ifnull(input.Total_Amount_Received,0.0));
											txn.put("Reference_Type","Payment Receipt Voucher");
											txn.put("Reference_Number",ifnull(input.Payment_Receipt_Number,""));
											txn.put("Application","Clean Sand Management");
											txn.put("Source_Form","Payment Receipt Voucher");
											txn.put("Source_Record_ID",input.ID);
											txn.put("Notes",ifnull(input.Display_Name_Customer,""));
											txn.put("User_Name",ifnull(input.User_Name,""));
											txn.put("User_Email",ifnull(input.User_Email,""));
											txn.put("User_Role",ifnull(input.User_Role,""));
											txn.put("Created_By_Name",ifnull(input.Created_By_Name,""));
											txn.put("Created_By_Email",ifnull(input.Created_By_Email,""));
											txn.put("Created_By_Time",input.Created_By_Time);
											txn.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
											txn.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
											txn.put("Updated_By_Time",zoho.currenttime);
											txn_resp = payment_management.createOrUpdateAccountTransactionLog(txn);
											info txn_resp;
											payment_management.Recalculate_Unconfirmed_Account_Totals();
										}
										// ==============================
										// OPEN PAYMENT DETAILS FORM
										// ==============================
										if(input.Total_Amount_Not_Allocated > 0)
										{
											openUrl("#Form:Payment_Receipt_Details","same window");
										}
										// =====================================================
										// UPDATE CUSTOMER PERFORMANCE
										// =====================================================
										if(input.Customer != null)
										{
											thisapp.customer.update_customer_performance(input.Customer);
										}
						)
					}
				}

			}
