			Full_Validation_On_Delete1 as "Full Validation On Delete"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// PAYMENT RECEIPT VOUCHER — FULL VALIDATION ON DELETE
										// ======================================================
										errors = "";
										if(input.ID == null)
										{
											errors = errors + "\n• Payment Receipt Voucher record was not found.";
										}
										else
										{
											details_count = 0;
											allocated_total = 0.0;
											credited_total = 0.0;
											for each  det in Payment_Receipt_Details[Payment_Receipt_Voucher == input.ID]
											{
												details_count = details_count + 1;
												allocated_total = allocated_total + ifnull(det.Amount_Allocated,0.0);
												credited_total = credited_total + ifnull(det.Amount_Credited,0.0);
											}
											if(details_count > 0)
											{
												errors = errors + "\n• This Payment Receipt Voucher has " + details_count.toString() + " assigned Payment Receipt Detail record(s).";
												if(allocated_total > 0)
												{
													errors = errors + "\n• Total Amount Allocated: " + allocated_total.round(2).toString();
												}
												if(credited_total > 0)
												{
													errors = errors + "\n• Total Amount Credited: " + credited_total.round(2).toString();
												}
											}
											charges_count = 0;
											charges_total = 0.0;
											for each  ch in Payment_Charges[Payment_Receipt_Voucher == input.ID]
											{
												charges_count = charges_count + 1;
												charges_total = charges_total + ifnull(ch.Amount,0.0);
											}
											if(charges_count > 0)
											{
												errors = errors + "\n• This Payment Receipt Voucher has " + charges_count.toString() + " Payment Charge record(s)." + "\n• Total Charges: " + charges_total.round(2).toString();
											}
										}
										// ------------------------------------------------------
										// 4. Final gate
										// ------------------------------------------------------
										if(errors != "")
										{
											alert "This Payment Receipt Voucher cannot be deleted.";
											cancel delete;
										}
						)
					}
				}

			}
