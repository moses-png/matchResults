			Full_Validation_On_Delete1 as "Full Validation On Delete"
			{
				type =  form
				form = Stock_Receiving_Details

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// STOCK RECEIVING DETAILS – VALIDATION ON DELETE
										// ======================================================
										bill_detail_exists = false;
										for each  bd in Bill_Details[Stock_Receiving_Details == input.ID]
										{
											bill_detail_exists = true;
											break;
										}
										if(bill_detail_exists)
										{
											alert "You Cannot Delete this Record.";
											cancel delete;
										}
						)
					}
				}

			}
