			Full_Validation2 as "Full Validation"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Credit_Note_Date == null)
										{
											input.Credit_Note_Date = zoho.currentdate;
										}
										if(input.Credit_Note_Number == null || input.Credit_Note_Number == "")
										{
											doc = Document_Key[Voucher_Type == "Credit Note" && Document_Key_Status == "Active"];
											if(doc.ID == null)
											{
												alert "No active Document Key found for Credit Note.";
												cancel submit;
											}
											next_no = ifnull(doc.Next_Number,1);
											if(next_no < 10)
											{
												num_txt = "0000" + next_no;
											}
											else if(next_no < 100)
											{
												num_txt = "000" + next_no;
											}
											else if(next_no < 1000)
											{
												num_txt = "00" + next_no;
											}
											else if(next_no < 10000)
											{
												num_txt = "0" + next_no;
											}
											else
											{
												num_txt = "" + next_no;
											}
											input.Credit_Note_Number = doc.Prefix + num_txt;
											doc.Next_Number=next_no + 1;
										}
										if(input.Sales_Voucher == null)
										{
											alert "Sales Voucher is required.";
											cancel submit;
										}
										if(input.Customer == null)
										{
											alert "Customer is required.";
											cancel submit;
										}
										if(ifnull(input.Amount_Due,0) <= 0)
										{
											alert "Amount Due must be greater than zero.";
											cancel submit;
										}
										if(ifnull(input.Credit_Amount,0) <= 0)
										{
											alert "Credit Amount must be greater than zero.";
											cancel submit;
										}
										if(input.Credit_Amount > input.Amount_Due)
										{
											alert "Credit Amount cannot be greater than Amount Due.";
											cancel submit;
										}
										if(input.Credit_Amount > ifnull(input.Available_Credit,0))
										{
											alert "Credit Amount cannot be greater than Available Credit.";
											cancel submit;
										}
										input.Balance_Due = ifnull(input.Amount_Due,0) - ifnull(input.Credit_Amount,0);
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0;
										}
										if(input.Credit_Days_Allowed == null || input.Credit_Days_Allowed < 0)
										{
											alert "Credit Days Allowed cannot be empty or negative.";
											cancel submit;
										}
										if(input.Due_Date == null)
										{
											input.Due_Date = input.Credit_Note_Date.addDay(input.Credit_Days_Allowed);
										}
						)
					}
				}

			}
			Full_Validation_On_Create1 as "Full Validation On Create"
			{
				type =  form
				form = Customer_Deposit_Details

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// GENERATE CUSTOMER DEPOSIT NUMBER
										// =====================================================
										if(ifnull(input.Customer_Deposit_Number,"") == "")
										{
											prefix_key = "CDN";
											seq = Document_Key[Prefix == prefix_key && Document_Key_Status == "Active"];
											if(seq.ID == null)
											{
												alert "Sequence not found for Customer Deposit Number.";
												cancel submit;
											}
											next_num = ifnull(seq.Next_Number,1);
											if(next_num > ifnull(seq.Max_Number,9999))
											{
												alert "Customer Deposit Number has reached the maximum limit.";
												cancel submit;
											}
											if(next_num < 10)
											{
												num_str = "000" + next_num;
											}
											else if(next_num < 100)
											{
												num_str = "00" + next_num;
											}
											else if(next_num < 1000)
											{
												num_str = "0" + next_num;
											}
											else
											{
												num_str = "" + next_num;
											}
											input.Customer_Deposit_Number = "CDN" + num_str;
											input.Customer_Deposit_Date = zoho.currenttime;
											seq.Next_Number=next_num + 1;
										}
						)
					}
				}

			}
