			Rate_Per_Ton_Selected as "Rate Per Ton Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Rate_per_Ton
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// Sales Voucher -> Rate per Ton On User Input
										// =====================================================
										amount_paid_val = ifnull(input.Amount_Paid,0.0);
										amount_credited_val = ifnull(input.Amount_Credited,0.0);
										total_settled = amount_paid_val + amount_credited_val;
										initial_payment_val = ifnull(input.Initial_Payment,0.0);
										initial_payment_cleared = false;
										if(initial_payment_val > 0 && total_settled >= initial_payment_val)
										{
											initial_payment_cleared = true;
										}
										// =====================================================
										// APPLY WEIGHBRIDGE ACTUAL PAYMENT
										// =====================================================
										if(initial_payment_cleared == true && input.Gross_Weight != null && input.Actual_Tonnes != null && input.Actual_Tonnes > 0 && input.Rate_per_Ton != null && input.Rate_per_Ton > 0)
										{
											input.Actual_Payment = round(input.Actual_Tonnes * input.Rate_per_Ton,2);
											input.Sub_Total = input.Actual_Payment;
											input.Tax_Amount = ifnull(input.Tax_Amount,0.0);
											if(input.Discount_Type == "None" || input.Discount_Type == null)
											{
												input.Discount_Amount = 0.0;
											}
											input.Grand_Total = round(input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0.0),2);
											input.Balance_Due = round(input.Grand_Total - total_settled,2);
											if(input.Balance_Due < 0)
											{
												input.Payment_Status = "Over Paid";
											}
											else if(input.Balance_Due == 0)
											{
												if(amount_credited_val > 0 && amount_paid_val == 0)
												{
													input.Payment_Status = "Credit";
												}
												else
												{
													input.Payment_Status = "Paid";
												}
											}
											else if(amount_paid_val > 0)
											{
												input.Payment_Status = "Partially Paid";
											}
											else if(amount_credited_val > 0)
											{
												input.Payment_Status = "Partially Credited";
											}
											else
											{
												input.Payment_Status = "Unpaid";
											}
										}
										else
										{
											input.Actual_Payment = null;
											input.Sub_Total = initial_payment_val;
											input.Tax_Amount = ifnull(input.Tax_Amount,0.0);
											if(input.Discount_Type == "None" || input.Discount_Type == null)
											{
												input.Discount_Amount = 0.0;
											}
											input.Grand_Total = round(input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0.0),2);
											input.Balance_Due = round(input.Grand_Total - total_settled,2);
											if(input.Balance_Due < 0)
											{
												input.Payment_Status = "Over Paid";
											}
											else if(input.Balance_Due == 0 && total_settled > 0)
											{
												if(amount_credited_val > 0 && amount_paid_val == 0)
												{
													input.Payment_Status = "Credit";
												}
												else
												{
													input.Payment_Status = "Paid";
												}
											}
											else if(amount_paid_val > 0)
											{
												input.Payment_Status = "Partially Paid";
											}
											else if(amount_credited_val > 0)
											{
												input.Payment_Status = "Partially Credited";
											}
											else
											{
												input.Payment_Status = "Unpaid";
											}
										}
						)
					}
				}

			}
			On_Payment_Document_Selec1 as "On Payment Document Selected"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on user input of Payment_Document
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// Payment Made Details -> Payment Document On User Input
										// =====================================================
										input.Bill = null;
										input.Sales_Voucher = null;
										input.Amount_Due = 0.0;
										input.Amount_Allocated = 0.0;
										input.Amount_Paid = 0.0;
										input.Balance_Due = 0.0;
										hide Bill;
										hide Sales_Voucher;
										// =====================================================
										// BILL SELECTED
										// =====================================================
										if(input.Payment_Document == "Bill")
										{
											show Bill;
											hide Sales_Voucher;
										}
										// =====================================================
										// SALES VOUCHER SELECTED
										// =====================================================
										else if(input.Payment_Document == "Sales Voucher")
										{
											hide Bill;
											show Sales_Voucher;
										}
										// =====================================================
										// NO DOCUMENT SELECTED
										// =====================================================
										else
										{
											hide Bill;
											hide Sales_Voucher;
										}
						)
					}
				}

			}
			On_Sales_Voucher_Selected6 as "On Sales Voucher Selected"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on user input of Sales_Voucher
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// Payment Made Details -> Sales Voucher On User Input
										// =====================================================
										if(input.Sales_Voucher != null)
										{
											voucher_number = ifnull(input.Sales_Voucher.Sales_Voucher_Number,"");
											customer_name = ifnull(input.Sales_Voucher.Display_Name_Customer,"");
											if(voucher_number != "" && customer_name != "")
											{
												input.Display_Name_Voucher = voucher_number + " - " + customer_name;
											}
											else if(voucher_number != "")
											{
												input.Display_Name_Voucher = voucher_number;
											}
											else
											{
												input.Display_Name_Voucher = customer_name;
											}
											voucher_balance = ifnull(input.Sales_Voucher.Balance_Due,0.0);
											if(voucher_balance < 0)
											{
												amount_due_val = voucher_balance * -1;
											}
											else
											{
												amount_due_val = voucher_balance;
											}
											input.Amount_Due = round(amount_due_val,2);
											input.Amount_Allocated = 0.0;
											input.Amount_Paid = 0.0;
											input.Balance_Due = input.Amount_Due;
										}
										else
										{
											input.Display_Name_Voucher = "";
											input.Amount_Due = 0.0;
											input.Amount_Allocated = 0.0;
											input.Amount_Paid = 0.0;
											input.Balance_Due = 0.0;
										}
						)
					}
				}

			}
