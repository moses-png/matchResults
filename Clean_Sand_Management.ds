			Set_Up_Form39 as "Set Up Form"
			{
				type =  form
				form = Sales_Return_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Logged-in user
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										hide Back_End;
										// ======================================
										// HIDE DISPLAY NAME FIELDS
										// ======================================
										hide Display_Name_Sales_Return_Number;
										hide Display_Name_Sales_Voucher_Detail;
										hide Display_Name_Item;
										hide Display_Name_Unit_Of_Measure;
										// ======================================
										// DISABLE SYSTEM CONTROLLED FIELDS
										// ======================================
										disable Sales_Return_Detail_Number;
										disable Line_Number;
										disable Customer;
										disable Item;
										disable Unit_Price;
										disable Quantity_Sold;
										disable Unit_Of_Measure;
										disable Quantity_Sold_in_Base_Unit_Of_Measure;
										disable Quantity_To_Be_Returned_in_Base_Unit_Of_Measure;
										disable Quantity_Remaining;
										disable Quantity_Remaining_in_Base_Unit_Of_Measure;
										disable Line_Total;
										disable Status;
						)
					}
				}

			}
			Finalize12 as "Finalize"
			{
				type =  form
				form = Sales_Return_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ==============================
										// FINALIZE SALES RETURN DETAIL
										// ==============================
										input.Status = "Returned";
										if(input.Sales_Return_Number != null)
										{
											sr = Sales_Return[ID == input.Sales_Return_Number];
											if(sr.ID != null)
											{
												//sr.Sales_Return_Status="Not Paid";
												sub_total = 0.0;
												for each  d in Sales_Return_Details[Sales_Return_Number == sr.ID]
												{
													sub_total = sub_total + ifnull(d.Line_Total,0.0);
												}
												sr.Sub_Total=sub_total;
												sr.Grand_Total=sub_total;
												if(input.Sales_Voucher_Detail != null)
												{
													svd = Sales_Voucher_Details[ID == input.Sales_Voucher_Detail];
													if(svd.ID != null)
													{
														svd.Quantity_Not_Issued_in_Base_Unit_Of_Measure=ifnull(input.Quantity_Remaining_in_Base_Unit_Of_Measure,0.0);
													}
												}
											}
										}
						)
					}
				}

			}
			Full_Validation24 as "Full Validation"
			{
				type =  form
