			Full_Validation33 as "Full Validation"
			{
				type =  form
				form = Site_Locations

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// SITE LOCATIONS
										// VALIDATION
										// =====================================================
										errors = "";
										// =====================================================
										// DEFAULT STATUS
										// =====================================================
										if(input.Status == null || input.Status.trim() == "")
										{
											input.Status = "Active";
										}
										// =====================================================
										// SITE
										// =====================================================
										if(input.Site == null)
										{
											errors = errors + "\n• Please select the Site.";
										}
										// =====================================================
										// SITE LOCATION NAME
										// =====================================================
										location_name = ifnull(input.Site_Location_Name,"").trim();
										if(location_name == "")
										{
											errors = errors + "\n• Please enter the Site Location Name.";
										}
										// =====================================================
										// DUPLICATE CHECK
										// =====================================================
										if(errors == "")
										{
											duplicate = Site_Locations[Site == input.Site && Site_Location_Name == location_name && Status == "Active"];
											if(duplicate.count() > 0)
											{
												if(input.ID == null)
												{
													errors = errors + "\n• An active Site Location with this name already exists for the selected Site.";
												}
												else
												{
													for each  rec in duplicate
													{
														if(rec.ID != input.ID)
														{
															errors = errors + "\n• An active Site Location with this name already exists for the selected Site.";
															break;
														}
													}
												}
											}
										}
										// =====================================================
										// STOP SAVE
										// =====================================================
										if(errors != "")
										{
											alert errors;
											cancel submit;
										}
						)
					}
				}

			}
