			On_Bill_Selected4 as "On Bill Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Services.Bill
				{
					actions 
					{
						custom deluge script
						(
											if(row.Bill != null)
										{
											bill_rec = Bill[ID == row.Bill];
											if(bill_rec.ID != null)
											{
												row.Display_Name_Voucher=ifnull(bill_rec.Bill_Name,"") + " - " + ifnull(bill_rec.Bill_Number,"");
											}
										}
										else
										{
											row.Display_Name_Voucher="";
										}
						)
					}
				}

			}
