			Set_Up_Form46 as "Set Up Form"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// TRACTOR WORK REPORT -> SET UP FORM
										// ========================================
										// =======================
										// DISABLE FIELDS
										// =======================
										disable Display_Name_Voucher;
										disable Display_Name_Employee;
										disable Display_Name_Site;
										disable Display_Name_Asset;
										disable Line_Number;
										disable Work_Done;
										disable Time_Start;
										disable Time_End;
										disable Reason_Why_Cancelled;
										disable Line_Duration_Minutes;
										disable Line_Hours_Worked;
										disable Tractor_Work_Report_Status;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// =======================
										// HIDE FIELDS DEFAULT
										// =======================
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										hide Display_Name_Site;
										hide Display_Name_Asset;
										hide Display_Name_Card;
										hide Card;
										hide Work_Order_Task;
										hide Batch_Number;
										hide Time_Start;
										hide Odometer_End;
										hide Time_End;
										hide Image_After;
										hide Cancel_Voucher;
										hide Reason_Why_Cancelled;
										hide Line_Summary;
										hide Cost_Per_Odometer;
										hide Total_Cost;
										hide Line_Duration_Minutes;
										hide Line_Hours_Worked;
										hide Tractor_Work_Report_Status;
										hide Back_End;
										hide Line_Number;
										// =======================
										// CREATE MODE
										// =======================
										if(input.ID == null)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											show Voucher;
											show Location;
											show Job;
											show Work_Done;
											show Odometer_Start;
											hide Card;
											hide Work_Order_Task;
											hide Batch_Number;
											hide Odometer_End;
											hide Time_Start;
											hide Time_End;
											hide Line_Duration_Minutes;
											hide Line_Hours_Worked;
											hide Tractor_Work_Report_Status;
										}
										// =======================
										// EDIT MODE
										// =======================
										else
										{
											show Voucher;
											show Line_Number;
											show Location;
											show Job;
											show Work_Done;
											show Odometer_Start;
											show Odometer_End;
											show Cancel_Voucher;
											show Tractor_Work_Report_Status;
											disable Voucher;
											disable Location;
											disable Job;
											disable Odometer_Start;
											// IMPORTANT: Control Work_Done properly
											if(input.Tractor_Work_Report_Status == "Completed")
											{
												disable Work_Done;
											}
											else
											{
												enable Work_Done;
											}
											if(input.Cancel_Voucher == true)
											{
												show Reason_Why_Cancelled;
											}
											// =======================
											// JOB-BASED SHOW / HIDE
											// =======================
											if(input.Job != null)
											{
												jobNo = input.Job.Job_No;
												if(jobNo == "TJS01")
												{
													show Card;
													show Batch_Number;
													enable Card;
													enable Batch_Number;
													hide Work_Order_Task;
												}
												else if(jobNo == "TJS02")
												{
													show Work_Order_Task;
													enable Work_Order_Task;
													hide Card;
													hide Batch_Number;
												}
												else if(jobNo == "TJS03")
												{
													show Batch_Number;
													enable Batch_Number;
													hide Card;
													hide Work_Order_Task;
												}
												else
												{
													hide Card;
													hide Work_Order_Task;
													hide Batch_Number;
												}
											}
											else
											{
												hide Card;
												hide Work_Order_Task;
												hide Batch_Number;
											}
											// =======================
											// STATUS: IN PROGRESS
											// =======================
											if(input.Tractor_Work_Report_Status == "In Progress")
											{
												disable Image_Before;
												hide Image_Before;
												disable Card;
												disable Batch_Number;
												disable Work_Done;
												show Image_After;
												show Odometer_End;
												show Time_End;
											}
											// =======================
											// STATUS: COMPLETED
											// =======================
											if(input.Tractor_Work_Report_Status == "Completed")
											{
												show Image_Before;
												show Image_After;
												show Odometer_End;
												show Time_Start;
												show Time_End;
												show Line_Duration_Minutes;
												show Line_Hours_Worked;
												disable Voucher;
												enable Location;
												enable Job;
												disable Odometer_Start;
												disable Odometer_End;
												disable Card;
												disable Work_Order_Task;
												disable Time_Start;
												disable Time_End;
											}
										}
						)
					}
				}

			}
			On_Batch_Number_Selected as "On Batch Number Selected"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on user input of Batch_Number
				{
					actions 
					{
						custom deluge script
						(
											if(input.Batch_Number != null)
										{
											batchNo = ifnull(input.Batch_Number.Batch_Number,"");
											autoText = "Stock Production";
											if(batchNo != "")
											{
												autoText = "Stock Production - " + batchNo;
											}
											input.Work_Done = autoText;
											productionSite = ifnull(input.Batch_Number.Display_Name_Site,"");
											currentSite = ifnull(input.Display_Name_Site,"");
											if(currentSite != "" && productionSite != "" && currentSite != productionSite)
											{
												alert "The selected Stock Production batch belongs to a different site.";
												input.Batch_Number = null;
												input.Work_Done = null;
											}
										}
						)
					}
				}

			}
			On_Cancel_Voucher_Selecte4 as "On Cancel Voucher Selected"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on user input of Cancel_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_Voucher == true)
										{
											show Reason_Why_Cancelled;
											enable Reason_Why_Cancelled;
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = null;
										}
						)
					}
				}

			}
			On_Card_Selected1 as "On Card Selected"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on user input of Card
				{
					actions 
					{
						custom deluge script
						(
											if(input.Card != null)
										{
											input.Work_Order_Task = null;
											cardNo = ifnull(input.Card.Card_Number,"").trim();
											numberPlate = ifnull(input.Card.Display_Name_Number_Plate,"").trim();
											if(cardNo != "" && numberPlate != "")
											{
												input.Display_Name_Card = cardNo + " - " + numberPlate;
												input.Work_Done = cardNo + " - " + numberPlate;
											}
											else if(cardNo != "")
											{
												input.Display_Name_Card = cardNo;
												input.Work_Done = cardNo;
											}
											else if(numberPlate != "")
											{
												input.Display_Name_Card = numberPlate;
												input.Work_Done = numberPlate;
											}
											else
											{
												input.Display_Name_Card = null;
												input.Work_Done = null;
											}
										}
										else
										{
											input.Display_Name_Card = null;
											if(input.Work_Order_Task == null)
											{
												input.Work_Done = null;
											}
										}
						)
					}
				}

			}
			On_Job_Selected2 as "On Job Selected"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on user input of Job
				{
					actions 
					{
						custom deluge script
						(
											if(input.Job != null)
										{
											jobNo = input.Job.Job_No;
											// ==================================
											// TJS01 - Card Sales
											// ==================================
											if(jobNo == "TJS01")
											{
												show Card;
												enable Card;
												show Batch_Number;
												enable Batch_Number;
												hide Work_Order_Task;
												input.Work_Order_Task = null;
											}
											// ==================================
											// TJS02 - Service Task
											// ==================================
											else if(jobNo == "TJS02")
											{
												show Work_Order_Task;
												enable Work_Order_Task;
												hide Card;
												input.Card = null;
												hide Batch_Number;
												input.Batch_Number = null;
											}
											// ==================================
											// TJS03 - Stock Production
											// ==================================
											else if(jobNo == "TJS03")
											{
												show Batch_Number;
												enable Batch_Number;
												hide Card;
												hide Work_Order_Task;
												input.Card = null;
												input.Work_Order_Task = null;
											}
										}
										else
										{
											hide Batch_Number;
											hide Card;
											hide Work_Order_Task;
											input.Card = null;
											input.Work_Order_Task = null;
											input.Batch_Number = null;
										}
						)
					}
				}

			}
			On_Odometer_End_Selected2 as "On Odometer End Selected"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on user input of Odometer_End
				{
					actions 
					{
						custom deluge script
						(
											if(input.Odometer_Start != null && input.Odometer_End != null)
										{
											if(input.Odometer_End >= input.Odometer_Start)
											{
												input.Line_Hours_Worked = input.Odometer_End - input.Odometer_Start;
											}
											else
											{
												alert "Odometer End cannot be less than Odometer Start";
												input.Odometer_End = null;
												input.Line_Hours_Worked = null;
											}
										}
										else
										{
											input.Line_Hours_Worked = null;
										}
						)
					}
				}

			}
			On_Odometer_Start_Selecte2 as "On Odometer Start Selected"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on user input of Odometer_Start
				{
					actions 
					{
						custom deluge script
						(
											if(input.Odometer_Start != null)
										{
											if(input.Odometer_End != null)
											{
												if(input.Odometer_Start <= input.Odometer_End)
												{
													input.Line_Hours_Worked = input.Odometer_End - input.Odometer_Start;
												}
												else
												{
													alert "Odometer Start cannot be greater than Odometer End";
													input.Odometer_Start = null;
													input.Line_Hours_Worked = null;
												}
											}
											else
											{
												input.Line_Hours_Worked = null;
											}
										}
										else
										{
											input.Line_Hours_Worked = null;
										}
						)
					}
				}

			}
			On_Time_End_Selected1 as "On Time End Selected"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on user input of Time_End
				{
					actions 
					{
						custom deluge script
						(
											if(input.Time_Start != null && input.Time_End != null)
										{
											diffMillis = input.Time_End.toLong() - input.Time_Start.toLong();
											if(diffMillis >= 0)
											{
												input.Line_Duration_Minutes = round(diffMillis / 60000.0,2);
											}
											else
											{
												alert "Time End cannot be before Time Start";
												input.Time_End = null;
												input.Line_Duration_Minutes = null;
											}
										}
										else
										{
											input.Line_Duration_Minutes = null;
										}
						)
					}
				}

			}
			On_Time_Start_Selected1 as "On Time Start Selected"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on user input of Time_Start
				{
					actions 
					{
						custom deluge script
						(
											if(input.Time_Start != null && input.Time_End != null)
										{
											diffMillis = input.Time_End.toLong() - input.Time_Start.toLong();
											if(diffMillis >= 0)
											{
												input.Line_Duration_Minutes = round(diffMillis / 60000.0,2);
											}
											else
											{
												alert "Time End cannot be before Time Start";
												input.Time_End = null;
												input.Line_Duration_Minutes = null;
											}
										}
										else
										{
											input.Line_Duration_Minutes = null;
										}
						)
					}
				}

			}
			On_Voucher_Selected6 as "On Voucher Selected"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on user input of Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Voucher != null)
										{
											input.Display_Name_Voucher = input.Voucher.Voucher_Number;
											empName = ifnull(input.Voucher.Employee.Employee_Name,"").trim();
											empNo = ifnull(input.Voucher.Employee.Employee_Number,"").toString().trim();
											if(empName != "" && empNo != "")
											{
												input.Display_Name_Employee = empName + " - " + empNo;
											}
											else if(empName != "")
											{
												input.Display_Name_Employee = empName;
											}
											else
											{
												input.Display_Name_Employee = null;
											}
											input.Display_Name_Site = input.Voucher.Display_Name_Site;
											if(input.Voucher.Asset != null)
											{
												input.Display_Name_Asset = input.Voucher.Asset.Asset_Name + " - " + input.Voucher.Asset.Asset_ID;
											}
											else
											{
												input.Display_Name_Asset = null;
											}
											existing = Tractor_Work_Report[Voucher == input.Voucher];
											if(existing.count() > 0)
											{
												maxLine = 0;
												for each  rec in existing
												{
													if(rec.Line_Number != null && rec.Line_Number > maxLine)
													{
														maxLine = rec.Line_Number;
													}
												}
												input.Line_Number = maxLine + 1;
											}
											else
											{
												input.Line_Number = 1;
											}
										}
										else
										{
											input.Display_Name_Voucher = null;
											input.Display_Name_Employee = null;
											input.Display_Name_Site = null;
											input.Display_Name_Asset = null;
											input.Line_Number = null;
										}
						)
					}
				}

			}
			On_Work_Order_Task_Select2 as "On Work Order Task Selected"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on user input of Work_Order_Task
				{
					actions 
					{
						custom deluge script
						(
											if(input.Work_Order_Task != null)
										{
											input.Card = null;
											taskNo = ifnull(input.Work_Order_Task.Work_Order_Task_Number,"").trim();
											taskDesc = ifnull(input.Work_Order_Task.Task_Description,"").trim();
											if(taskNo != "" && taskDesc != "")
											{
												input.Work_Done = taskNo + " - " + taskDesc;
											}
											else if(taskNo != "")
											{
												input.Work_Done = taskNo;
											}
											else if(taskDesc != "")
											{
												input.Work_Done = taskDesc;
											}
											else
											{
												input.Work_Done = null;
											}
										}
										else
										{
											if(input.Card == null)
											{
												input.Work_Done = null;
											}
										}
						)
					}
				}

			}
			Finalize19 as "Finalize"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											info "===== TRACTOR WORK REPORT FINALIZE START =====";
										jobNo = "";
										if(input.Job != null)
										{
											jobNo = ifnull(input.Job.Job_No,"");
										}
										is_create = false;
										if(input.Added_Time != null && input.Modified_Time != null)
										{
											if(input.Added_Time.toLong() == input.Modified_Time.toLong())
											{
												is_create = true;
											}
										}
										if(is_create)
										{
											if(input.Time_Start == null)
											{
												input.Time_Start = zoho.currenttime;
											}
										}
										else
										{
											if(input.Cancel_Voucher == true)
											{
												input.Tractor_Work_Report_Status = "Cancelled";
											}
											else if(input.Tractor_Work_Report_Status == "In Progress")
											{
												if(input.Time_End == null)
												{
													input.Time_End = zoho.currenttime;
												}
												if(input.Time_Start != null && input.Time_End != null)
												{
													diffMillis = input.Time_End.toLong() - input.Time_Start.toLong();
													if(diffMillis >= 0)
													{
														input.Line_Duration_Minutes = round(diffMillis / 60000.0,2);
														input.Line_Hours_Worked = round(diffMillis / 3600000.0,2);
													}
													else
													{
														input.Line_Duration_Minutes = null;
														input.Line_Hours_Worked = null;
													}
												}
												if(jobNo == "TJS03")
												{
													input.Tractor_Work_Report_Status = "Loaded";
												}
												else
												{
													input.Tractor_Work_Report_Status = "Completed";
												}
											}
										}
										// ========================================
										// TJS01 - CREATE BATCH STOCK OUT
										// ========================================
										if(jobNo == "TJS01" && input.Tractor_Work_Report_Status == "Completed")
										{
											if(input.Card != null && input.Batch_Number != null)
											{
												sourceID = input.ID;
												existingBatchStock = Batch_Stock[Source_Record_ID == sourceID];
												if(existingBatchStock.count() == 0)
												{
													lastLine = Batch_Stock[Batch_Number == input.Batch_Number] sort by Line_Number desc;
													nextLine = 1;
													currentBalance = 0.0;
													for each  l in lastLine
													{
														nextLine = ifnull(l.Line_Number,0) + 1;
														currentBalance = ifnull(l.Running_Balance,0.0);
														break;
													}
													qtyOut = 0 - ifnull(input.Card.Truck_CBM,0.0);
													newBalance = currentBalance + qtyOut;
													insert into Batch_Stock
													[
														Batch_Number=input.Batch_Number
														Display_Name_Batch_Number=input.Batch_Number.Batch_Number
														Line_Number=nextLine
														Batch_Time=input.Time_End
														Batch_Type="Out"
														Reference=input.Card.Card_Number + " - " + input.Card.Display_Name_Number_Plate
														Quantity=qtyOut
														Running_Balance=newBalance
														Source_Record_ID=sourceID
														Source_Form="Masaka Site Management - Tractor Work Report"
														Added_User=zoho.loginuser
													]
												}
											}
										}
						)
					}
				}

			}
			Full_Validation31 as "Full Validation"
			{
				type =  form
				form = Tractor_Work_Report

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										// safer create check
										if(input.ID == null)
										{
											is_create = true;
										}
										else
										{
											is_create = false;
										}
										before_img = ifnull(input.Image_Before.toString(),"").trim();
										after_img = ifnull(input.Image_After.toString(),"").trim();
										if(input.Cancel_Voucher == true)
										{
											if(isNull(input.Reason_Why_Cancelled) || input.Reason_Why_Cancelled.trim() == "")
											{
												errors = errors + "\n• Reason Why Cancelled is required when Cancelled is checked.";
											}
										}
										if(is_create)
										{
											if(input.Voucher == null)
											{
												errors = errors + "\n• Voucher is required.";
											}
											if(input.Location == null)
											{
												errors = errors + "\n• Location is required.";
											}
											if(input.Job == null)
											{
												errors = errors + "\n• Job is required.";
											}
											else
											{
												jobNo = input.Job.Job_No;
												if(jobNo == "TJS01" && input.Card == null)
												{
													errors = errors + "\n• Card is required for Card Sales.";
												}
												else if(jobNo == "TJS02" && input.Work_Order_Task == null)
												{
													errors = errors + "\n• Work Order Task is required for Service Task.";
												}
												else if(jobNo == "TJS03" && input.Batch_Number == null)
												{
													errors = errors + "\n• Stock Production is required for Stock Production job.";
												}
											}
											if(input.Odometer_Start == null)
											{
												errors = errors + "\n• Odometer Start is required.";
											}
											if(before_img == "")
											{
												errors = errors + "\n• Image Before is required on create.";
											}
										}
										else
										{
											if(input.Cancel_Voucher != true && input.Tractor_Work_Report_Status == "In Progress" && input.Odometer_End == null)
											{
												errors = errors + "\n• Odometer End is required when Status is In Progress and the record is not cancelled.";
											}
											if(after_img == "")
											{
												errors = errors + "\n• Image After is required on edit.";
											}
										}
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
