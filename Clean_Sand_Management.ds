			Full_Validation30 as "Full Validation"
			{
				type =  form
				form = Delivery_Note

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// DELIVERY NOTE -> VALIDATION
										// ===============================
										errors = "";
										if(input.ID == null)
										{
											if(input.Receipt_Officer_Daily_Voucher == null)
											{
												errors = errors + "\n• Receipt Officer Daily Voucher is required.";
											}
											if(input.Site == null)
											{
												errors = errors + "\n• Site is required.";
											}
											if(input.Delivery_Note_Date == null)
											{
												input.Delivery_Note_Date = zoho.currenttime;
											}
											if(input.Delivery_Note_Number == null || input.Delivery_Note_Number.trim() == "")
											{
												errors = errors + "\n• Delivery Note Number is required.";
											}
										}
										else
										{
											custName = "";
											noPO = false;
											if(input.Customer != null)
											{
												custName = ifnull(input.Customer.Display_Name_Customer,"").trim();
												noPO = custName == "Mrsand - 20" || custName == "Grapes Trucks - 18";
											}
											if(input.Customer == null)
											{
												errors = errors + "\n• Customer is required.";
											}
											if(!noPO && input.Customer_Purchase_Order == null)
											{
												errors = errors + "\n• Purchase Order is required.";
											}
											if(!noPO)
											{
												poLines = input.Customer_Purchase_Order_Details;
												if(poLines == null || poLines.isEmpty())
												{
													errors = errors + "\n• Purchase Order Details is required. Add at least one item line.";
												}
											}
											if(input.Number_Plate == null)
											{
												errors = errors + "\n• Number Plate is required.";
											}
											if(input.Cancel_Voucher == true)
											{
												if(input.Reason_Why_Cancelled == null || input.Reason_Why_Cancelled.trim() == "")
												{
													errors = errors + "\n• Reason Why Cancelled is required.";
												}
											}
											if(input.Prepared_By == null)
											{
												errors = errors + "\n• Prepared By is required.";
											}
										}
										// =====================================================
										// STOP SUBMISSION
										// =====================================================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation_On_Create10 as "Full Validation On Create"
			{
				type =  form
				form = Purchase_Order

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.PO_Number == null || input.PO_Number.trim() == "")
										{
											doc_key = Document_Key[Voucher_Type == "Purchase Order" && Document_Key_Status == "Active"];
											if(doc_key.ID == null)
											{
												alert "Document Key for Purchase Order is not configured.";
												cancel submit;
											}
											prefix_value = ifnull(doc_key.Prefix,"POC");
											next_no = ifnull(doc_key.Next_Number,1);
											max_no = ifnull(doc_key.Max_Number,99999);
											if(next_no > max_no)
											{
												alert "The maximum Purchase Order number has been reached.";
												cancel submit;
											}
											if(next_no < 10)
											{
												num_text = "0000" + next_no;
											}
											else if(next_no < 100)
											{
												num_text = "000" + next_no;
											}
											else if(next_no < 1000)
											{
												num_text = "00" + next_no;
											}
											else if(next_no < 10000)
											{
												num_text = "0" + next_no;
											}
											else
											{
												num_text = next_no.toString();
											}
											input.PO_Number = prefix_value + "-" + num_text;
											doc_key.Next_Number=next_no + 1;
										}
						)
					}
				}

			}
