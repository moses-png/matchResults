			Set_Up_Form36 as "Set Up Form"
			{
				type =  form
				form = Asset_Issues

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable Voucher;
										disable Reported_By;
										disable Site;
										disable Current_Site;
										disable Current_Custodian;
										disable Number_Of_Work_Order_Tasks;
										disable Total_Service_Task_Cost;
										disable Display_Name_Asset;
										disable Issue_Status;
										disable Labour_Total;
										disable Parts_Total;
										disable Issue_Number;
										disable Work_Order_Number;
										disable Work_Order_Date;
										disable Overall_End_Date;
										disable Overall_Start_Date;
										disable Odometer_Reading_Ended;
										disable Odometer_Reading_Started;
										disable Work_Order_Status;
										disable Reported_Date;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										//HIDE FIELDS
										hide Voucher;
										hide Site;
										hide Number_Of_Work_Order_Tasks;
										hide Total_Service_Task_Cost;
										hide Display_Name_Asset;
										hide Material_Request_Vouchers;
										hide Work_Order_Tasks;
										hide Reported_By;
										hide Current_Site;
										hide Current_Custodian;
										hide Issue_Status;
										hide Reason_Why_Cancelled;
										hide Reason_Why_Resolved;
										hide Display_Name_Work_Order_in_Charge_Of;
										//hide Issue_Number;
										hide Back_End;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// -------- CREATE MODE --------
										if(input.ID == null)
										{
											hide Work_Order;
											hide Issue_Status1;
											hide Resolve_Issue;
											hide Reason_Why_Resolved;
											hide Work_Order_Number;
											hide Work_Order_Date;
											hide Work_Order_in_Charge_Of;
											hide Work_Order_Odometer_Reading;
											hide Work_Order_Status;
											hide Cancel_Work_Order;
											hide Reason_Why_Cancelled;
											hide Overall_Start_Date;
											hide Overall_End_Date;
											hide Odometer_Reading_Started;
											hide Odometer_Reading_Ended;
											if(isNull(input.Number_Of_Work_Order_Tasks))
											{
												input.Number_Of_Work_Order_Tasks = 0;
											}
											if(isNull(input.Total_Service_Task_Cost))
											{
												input.Total_Service_Task_Cost = 0.0;
											}
											if(input.Asset != null)
											{
												input.Display_Name_Asset = ifnull(input.Asset.Display_Name_Asset_Name,"");
											}
											else
											{
												input.Display_Name_Asset = "";
											}
										}
										else
										{
											show Work_Order;
											show Issue_Status1;
											show Work_Order_Odometer_Reading;
											show Resolve_Issue;
											show Work_Order_Number;
											show Work_Order_Date;
											show Work_Order_in_Charge_Of;
											show Work_Order_Status;
											show Cancel_Work_Order;
											show Overall_Start_Date;
											show Overall_End_Date;
											show Odometer_Reading_Started;
											show Odometer_Reading_Ended;
											show Current_Site;
											show Current_Custodian;
											show Issue_Status;
											disable Employee_Voucher;
											disable Issue_Description;
											disable Odometer_Reading;
											disable Issue;
											disable Severity;
											disable Asset;
											if(input.Resolve_Issue == true)
											{
												show Reason_Why_Resolved;
											}
											else
											{
												hide Reason_Why_Resolved;
											}
											hide Reason_Why_Cancelled;
											if((input.Asset != null && input.Display_Name_Asset == null) || input.Display_Name_Asset == "")
											{
												input.Display_Name_Asset = ifnull(input.Asset.Display_Name_Asset_Name,"");
											}
										}
										//==================================
										// SYNC DETAILS
										// DAYS UNIT - USE DAYS PASSED ONLY
										//==================================
										hide Sync_Details;
										if(input.Asset != null && input.Asset.Odometer_Unit_Of_Measure == "days")
										{
											odo_today = 0;
											if(input.Asset.Date_Time_Odometer_Read != null)
											{
												last_date = input.Asset.Date_Time_Odometer_Read.toDate();
												days_passed = daysBetween(last_date,zoho.currentdate);
												if(days_passed < 0)
												{
													days_passed = 0;
												}
												odo_today = days_passed;
											}
											if(input.Odometer_Reading == null)
											{
												input.Odometer_Reading = odo_today;
											}
											if(input.Work_Order_Odometer_Reading == null)
											{
												input.Work_Order_Odometer_Reading = odo_today;
											}
											disable Odometer_Reading;
											disable Work_Order_Odometer_Reading;
										}
										else
										{
											enable Odometer_Reading;
											enable Work_Order_Odometer_Reading;
										}
						)
					}
				}

			}
			On_Amount_Paid_Selected1 as "On Amount Paid Selected"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on user input of Made_Details.Amount_Paid
				{
					actions 
					{
						custom deluge script
						(
											// Current row
										paid_amt = ifnull(row.Amount_Paid,0.0);
										due_amt = ifnull(row.Amount_Due,0.0);
										// Cannot pay more than due
										if(paid_amt > due_amt)
										{
											alert "Amount Paid cannot exceed Amount Due.";
											row.Amount_Paid=due_amt;
											paid_amt = due_amt;
										}
										// Copy paid amount to allocated
										row.Amount_Allocated=paid_amt;
										// Update row balance
										row.Balance_Due=due_amt - paid_amt;
										if(row.Balance_Due < 0)
										{
											row.Balance_Due=0.0;
										}
										// Recalculate voucher totals
										total_allocated = 0.0;
										for each  r in input.Made_Details
										{
											total_allocated = total_allocated + ifnull(r.Amount_Allocated,0.0);
										}
										input.Total_Amount_Allocated = total_allocated;
										input.Total_Amount_Not_Allocated = ifnull(input.Total_Amount_Paid,0.0) - ifnull(input.Total_Charges,0.0) - total_allocated;
										if(input.Total_Amount_Not_Allocated < 0)
										{
											input.Total_Amount_Not_Allocated = 0.0;
										}
						)
					}
				}

			}
			On_Bill_Selected4 as "On Bill Selected"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on user input of Made_Details.Bill
				{
					actions 
					{
						custom deluge script
						(
											if(row.Bill != null)
										{
											bill_rec = Bill[ID == row.Bill];
											if(bill_rec.ID != null)
											{
												row.Display_Name_Voucher=ifnull(bill_rec.Bill_Name,"") + " - " + ifnull(bill_rec.Bill_Number,"");
												bal_due = ifnull(bill_rec.Balance_Due,0.0);
												if(bal_due <= 0)
												{
													bal_due = ifnull(bill_rec.Amount_Due,0.0) - ifnull(bill_rec.Amount_Paid,0.0);
												}
												if(bal_due < 0)
												{
													bal_due = 0.0;
												}
												row.Amount_Due=bal_due;
												row.Amount_Allocated=0.0;
												row.Amount_Paid=0.0;
												row.Balance_Due=bal_due;
											}
										}
						)
					}
				}

			}
