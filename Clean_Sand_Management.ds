											}
											if(input.Rate == null || input.Rate <= 0)
											{
												errors = errors + "\n• Rate must be greater than zero.";
											}
											if(input.Invoice_Details_Status == null || input.Invoice_Details_Status.trim() == "")
											{
												input.Invoice_Details_Status = "Draft";
											}
										}
										// ======================================
										// EDIT VALIDATION
										// ======================================
										else
										{
											if(input.Invoice == null)
											{
												errors = errors + "\n• Invoice is required.";
