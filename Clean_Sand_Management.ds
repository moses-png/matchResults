			On_Discount_Amount_Select1 as "On Discount Amount Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Discount_Amount
				{
					actions 
					{
						custom deluge script
						(
											if(input.Discount_Amount == null)
										{
											input.Discount_Amount = 0;
										}
										if(input.Discount_Amount > ifnull(input.Sub_Total,0))
										{
											alert "Discount Amount cannot be greater than Sub Total.";
											input.Discount_Amount = ifnull(input.Sub_Total,0);
										}
										input.Grand_Total = ifnull(input.Sub_Total,0) + ifnull(input.Tax_Amount,0) - ifnull(input.Discount_Amount,0);
										input.Balance_Due = ifnull(input.Grand_Total,0) - ifnull(input.Amount_Paid,0) - ifnull(input.Amount_Credited,0);
						)
					}
				}

			}
			On_Discount_Percentage_Se1 as "On Discount Percentage Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Discount_Percentage
				{
					actions 
					{
						custom deluge script
						(
											if(input.Discount_Percentage != null)
										{
											input.Discount_Amount = ifnull(input.Sub_Total,0) * input.Discount_Percentage / 100;
										}
										else
										{
											input.Discount_Amount = 0;
										}
										input.Grand_Total = ifnull(input.Sub_Total,0) + ifnull(input.Tax_Amount,0) - ifnull(input.Discount_Amount,0);
										input.Balance_Due = ifnull(input.Grand_Total,0) - ifnull(input.Amount_Paid,0) - ifnull(input.Amount_Credited,0);
						)
					}
				}

			}
			On_Discount_Type_Selected1 as "On Discount Type Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Discount_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Discount_Type == "None")
										{
											input.Discount_Percentage = 0;
											input.Discount_Amount = 0;
											hide Discount_Amount;
											hide Discount_Type;
										}
										else if(input.Discount_Type == "Percentage")
										{
											input.Discount_Amount = ifnull(input.Sub_Total,0) * ifnull(input.Discount_Percentage,0) / 100;
											show Discount_Percentage;
											show Discount_Amount;
											enable Discount_Percentage;
										}
										else if(input.Discount_Type == "Amount")
										{
											input.Discount_Percentage = 0;
											hide Discount_Percentage;
											show Discount_Amount;
											enable Discount_Amount;
										}
										input.Grand_Total = ifnull(input.Sub_Total,0) + ifnull(input.Tax_Amount,0) - ifnull(input.Discount_Amount,0);
										input.Balance_Due = ifnull(input.Grand_Total,0) - ifnull(input.Amount_Paid,0) - ifnull(input.Amount_Credited,0);
						)
					}
				}

			}
			On_Item_Selected2 as "On Item Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Product_Details.Item
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// SALES VOUCHER
										// ON USER INPUT OF ITEM
										// =====================================================
										if(input.Item != null)
										{
											unit_price = ifnull(input.Item.Unit_Price,0.0);
											input.Display_Name_Item = ifnull(input.Item.Display_Name_Item,"");
											input.Rate_per_CBM = unit_price;
											calculated_rate_per_ton = unit_price * 0.68181818;
											input.Rate_per_Ton = round(calculated_rate_per_ton,2);
											info "ITEM: " + input.Item;
											info "UNIT PRICE: " + unit_price;
											info "RATE PER CBM: " + input.Rate_per_CBM;
											info "CALCULATED RATE PER TON: " + calculated_rate_per_ton;
											info "RATE PER TON FIELD: " + input.Rate_per_Ton;
										}
										else
										{
											input.Display_Name_Item = "";
											input.Rate_per_CBM = 0.0;
											input.Rate_per_Ton = 0.0;
										}
						)
					}
				}

			}
			On_Store_Selected2 as "On Store Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Product_Details.Store
				{
					actions 
					{
						custom deluge script
						(
											if(row.Store != null)
										{
											row.Display_Name_Store=row.Store.Asset_Name + " - " + row.Store.Asset_ID;
										}
										else
										{
											row.Display_Name_Store="";
										}
						)
					}
				}

			}
			On_Store_Item_Stock_Selec as "On Store Item Stock Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Product_Details.Store_Item_Stock
				{
					actions 
					{
						custom deluge script
						(
											if(row.Store_Item_Stock != null)
										{
											row.Store=row.Store_Item_Stock.Store;
											row.Display_Name_Store=row.Store.Asset_Name + " - " + row.Store.Asset_ID;
											row.Quantity_Available=ifnull(row.Store_Item_Stock.Qty_On_Hand,0);
										}
										else
										{
											row.Store=null;
											row.Display_Name_Store="";
											row.Quantity_Available=0;
										}
						)
					}
				}

			}
			On_Tax_Type_Selected as "On Tax Type Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Product_Details.Tax_Type
				{
					actions 
					{
						custom deluge script
						(
											if(row.Tax_Type != null)
										{
											row.Tax_Amount=ifnull(row.Line_Total,0) * ifnull(row.Tax_Type.Tax_Rate,0) / 100;
										}
										else
										{
											row.Tax_Amount=0;
										}
										sub_total = 0;
										tax_total = 0;
										for each  r in input.Product_Details
										{
											sub_total = sub_total + ifnull(r.Line_Total,0);
											tax_total = tax_total + ifnull(r.Tax_Amount,0);
										}
										input.Sub_Total = sub_total;
										input.Tax_Amount = tax_total;
										input.Grand_Total = input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0);
										input.Balance_Due = input.Grand_Total - ifnull(input.Amount_Paid,0) - ifnull(input.Amount_Credited,0);
						)
					}
				}

			}
			On_Unit_Of_Measure_Select3 as "On Unit Of Measure Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Product_Details.Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											if(row.Unit_Of_Measure != null)
										{
											row.Display_Name_Unit_Of_Measure=row.Unit_Of_Measure.Display_Name_Alternate_Unit_Of_Measure;
											conversion_factor = ifnull(row.Unit_Of_Measure.Conversion_Factor,1);
											// Quantity Available in selected UOM
											if(row.Store_Item_Stock != null)
											{
												row.Quantity_Available=ifnull(row.Store_Item_Stock.Qty_On_Hand,0) / conversion_factor;
											}
											else if(row.Item != null)
											{
												row.Quantity_Available=ifnull(row.Item.Stock_On_Hand,0) / conversion_factor;
											}
											else
											{
												row.Quantity_Available=0;
											}
											// Quantity in Base UOM
											if(row.Quantity != null)
											{
												row.Quantity_in_Base_Unit_Of_Measure=row.Quantity * conversion_factor;
											}
											else
											{
												row.Quantity_in_Base_Unit_Of_Measure=0;
											}
											price = Product_Price_Register[Item == row.Item && Unit_Of_Measure == row.Unit_Of_Measure && Status == "Active"];
											if(price.ID != null)
											{
												row.Unit_Price=price.Unit_Price;
											}
											else
											{
												row.Unit_Price=0;
											}
											row.Line_Total=ifnull(row.Quantity,0) * ifnull(row.Unit_Price,0);
										}
										else
										{
											row.Display_Name_Unit_Of_Measure="";
											row.Quantity_Available=0;
											row.Quantity_in_Base_Unit_Of_Measure=0;
											row.Unit_Price=0;
											row.Line_Total=0;
										}
						)
					}
				}

			}
			On_Unit_Price_Selected as "On Unit Price Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Product_Details.Unit_Price
				{
					actions 
					{
						custom deluge script
						(
											row.Line_Total=ifnull(row.Quantity,0) * ifnull(row.Unit_Price,0);
										if(row.Tax_Type != null)
										{
											row.Tax_Amount=row.Line_Total * ifnull(row.Tax_Type.Tax_Rate,0) / 100;
										}
										else
										{
											row.Tax_Amount=0;
										}
										sub_total = 0;
										tax_total = 0;
										for each  r in input.Product_Details
										{
											sub_total = sub_total + ifnull(r.Line_Total,0);
											tax_total = tax_total + ifnull(r.Tax_Amount,0);
										}
										input.Sub_Total = sub_total;
										input.Tax_Amount = tax_total;
										input.Grand_Total = input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0);
										input.Balance_Due = input.Grand_Total - ifnull(input.Amount_Paid,0) - ifnull(input.Amount_Credited,0);
						)
					}
				}

			}
