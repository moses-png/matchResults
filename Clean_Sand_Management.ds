			Set_Up_Form33 as "Set Up Form"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//Back End
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										hide Display_Name_Payment_Made_Voucher;
										hide Display_Name_Vendor;
										hide Display_Name_Voucher;
										hide Payment_Type;
										disable Line_Number;
										disable Amount_Due;
										disable Amount_Not_Allocated;
										disable Amount_Allocated;
										disable Balance_Due;
										hide Back_End;
										hide User_Name;
										hide User_Email;
										hide User_Role;
										hide Created_By_Name;
										hide Created_By_Email;
										hide Created_By_Time;
										hide Updated_By_Name;
										hide Updated_By_Email;
										hide Updated_By_Time;
										hide Bill;
										hide Sales_Voucher;
										if(input.Payment_Document == "Bill")
										{
											show Bill;
										}
										else if(input.Payment_Document == "Sales Voucher")
										{
											show Sales_Voucher;
										}
						)
					}
				}

			}
			On_Amount_Paid_Selected as "On Amount Paid Selected"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on user input of Amount_Paid
				{
					actions 
					{
						custom deluge script
						(
											if(input.Amount_Paid == null)
										{
											input.Amount_Paid = 0;
										}
										if(input.Amount_Paid > input.Amount_Not_Allocated)
										{
											alert "Amount Paid cannot be greater than Amount Not Allocated.";
											input.Amount_Paid = 0;
											return;
										}
										input.Amount_Allocated = input.Amount_Paid;
										input.Balance_Due = input.Amount_Due - input.Amount_Paid;
										if(input.Balance_Due < 0)
										{
											input.Balance_Due = 0;
										}
						)
					}
				}

			}
