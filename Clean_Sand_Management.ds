										{
											alert "Quantity Sold is required.";
											cancel submit;
										}
										if(input.Unit_Of_Measure == null)
										{
											alert "Unit Of Measure is required.";
											cancel submit;
										}
										if(input.Unit_Price == null)
										{
											alert "Unit Price is required.";
											cancel submit;
										}
										if(input.Quantity_To_Be_Returned == null)
										{
											alert "Quantity To Be Returned is required.";
											cancel submit;
										}
										if(input.Line_Total == null)
										{
											alert "Line Total is required.";
											cancel submit;
										}
										if(input.Quantity_Remaining == null)
										{
											alert "Quantity Remaining is required.";
											cancel submit;
										}
										if(input.Status == null || input.Status == "")
										{
											alert "Status is required.";
											cancel submit;
										}
						)
					}
				}

			}
