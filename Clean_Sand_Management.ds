			Set_Up_Form42 as "Set Up Form"
			{
				type =  form
				form = Material_Request_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// BACK END (CREATE & EDIT)
										// =====================================================
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// =====================================================
										// BACK END USER NAME
										// =====================================================
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										hide Display_Name_Issue;
										hide Display_Name_Work_Order_Task;
										hide Display_Name_Work_Order;
										hide Display_Name_User;
										hide Display_Name_Works_Coordinator;
										hide Display_Name_Supply_Manager;
										hide Display_Name_Store_Manager;
										hide Display_Name_Site;
										disable Request_Date;
										disable Material_Request_Number;
										disable Issue_Description;
										disable Issue;
										disable Date_Time_Requested;
										disable Date_Time_Approved;
										disable Date_Time_Issued;
										disable Date_Time_Work_Checked;
										disable Requested_By_Email;
										disable Approved_By_Email;
										disable Issued_By_Email;
										disable Checked_By_Email;
										hide Material_Request_Details.Material_Request_Voucher_Number;
										hide Material_Request_Details.Display_Name_Material_Request_Voucher;
										hide Material_Request_Details.Work_Order_Task_Number;
										hide Material_Request_Details.Display_Name_Item;
										hide Material_Request_Details.Display_Name_Unit_Of_Measure;
										hide Material_Request_Details.Quantity_in_Base_Unit_Of_Measure;
										hide Material_Request_Details.Quantity_Issued_in_Base_Unit_Of_Measure;
										hide Material_Request_Details.Quantity_Returned_in_Base_Unit_Of_Measure;
										hide Material_Request_Details.Quantity_Issued;
										hide Material_Request_Details.Quantity_Returned;
										hide Material_Request_Details.Status;
										hide Material_Request_Details.User_Name;
										hide Material_Request_Details.User_Email;
										hide Material_Request_Details.User_Role;
										hide Material_Request_Details.Created_By_Name;
										hide Material_Request_Details.Created_By_Email;
										hide Material_Request_Details.Created_By_Time;
										hide Material_Request_Details.Updated_By_Name;
										hide Material_Request_Details.Updated_By_Email;
										hide Material_Request_Details.Updated_By_Time;
										disable Material_Request_Details.Line_Number;
										// =======================================
										// FORM SETUP
										// =======================================
										if(input.ID == null)
										{
											is_create = true;
										}
										else
										{
											is_create = false;
										}
										// =======================================
										// ALWAYS HIDE DISPLAY-NAME FIELDS
										// =======================================
										hide Display_Name_User;
										hide Display_Name_Works_Coordinator;
										hide Display_Name_Supply_Manager;
										hide Display_Name_Store_Manager;
										// =======================================
										// ALWAYS DISABLE DATE/TIME AND EMAILS
										// =======================================
										disable Date_Time_Requested;
										disable Requested_By_Email;
										disable Date_Time_Approved;
										disable Approved_By_Email;
										disable Date_Time_Issued;
										disable Issued_By_Email;
										disable Date_Time_Work_Checked;
										disable Checked_By_Email;
										disable Material_Request_Details.SKU;
										// =======================================
										// CREATE
										// =======================================
										if(is_create == true)
										{
											show Approval_Section;
											show User;
											show Works_Coordinator;
											show Date_Time_Requested;
											show Requested_By_Email;
											hide Supply_Manager;
											hide Date_Time_Approved;
											hide Approved_By_Email;
											hide Store_Manager;
											hide Issued_By_Email;
											hide Date_Time_Issued;
											hide Status_Details;
											hide Document_Status;
											hide Cancel_Voucher;
											hide Reason_Why_Cancelled;
											hide Checklist_Section;
											hide Job_Done_Checklist;
											hide Checked_By_Email;
											hide Date_Time_Work_Checked;
										}
										// =======================================
										// EDIT
										// =======================================
										else
										{
											hide Approval_Section;
											hide User;
											hide Works_Coordinator;
											hide Date_Time_Requested;
											hide Requested_By_Email;
											hide Supply_Manager;
											hide Date_Time_Approved;
											hide Approved_By_Email;
											hide Store_Manager;
											hide Issued_By_Email;
											hide Date_Time_Issued;
											hide Status_Details;
											hide Document_Status;
											hide Cancel_Voucher;
											hide Reason_Why_Cancelled;
											hide Checklist_Section;
											hide Job_Done_Checklist;
											hide Checked_By_Email;
											hide Date_Time_Work_Checked;
											// ===================================
											// DRAFT: SUPPLY MANAGER
											// ===================================
											if(input.Document_Status == "Draft")
											{
												show Approval_Section;
												show Supply_Manager;
												show Status_Details;
												show Date_Time_Approved;
												show Approved_By_Email;
												show Document_Status;
												show Cancel_Voucher;
												disable Site;
												disable Description;
												disable Work_Order_Task;
												disable Work_Order;
												disable Material_Request_Details.Item;
												disable Material_Request_Details.Quantity;
												disable Material_Request_Details.Unit_Of_Measure;
												if(input.Cancel_Voucher == true)
												{
													show Reason_Why_Cancelled;
												}
												else
												{
													hide Reason_Why_Cancelled;
												}
											}
											// ===================================
											// APPROVED: STORE MANAGER
											// ===================================
											else if(input.Document_Status == "Approved")
											{
												show Approval_Section;
												show Store_Manager;
												show Issued_By_Email;
												show Date_Time_Issued;
												show Material_Request_Details.Quantity_Issued;
												show Material_Request_Details.Quantity_Returned;
												disable Site;
												disable Description;
												disable Work_Order_Task;
												disable Work_Order;
												disable Material_Request_Details.Item;
												disable Material_Request_Details.Quantity;
												disable Material_Request_Details.Unit_Of_Measure;
											}
											// ===================================
											// ISSUED: JOB CHECKLIST
											// ===================================
											else if(input.Document_Status == "Issued")
											{
												hide Approval_Section;
												show Material_Request_Details.Quantity_Issued;
												show Material_Request_Details.Quantity_Returned;
												disable Material_Request_Details.Quantity_Returned;
												disable Material_Request_Details.Quantity_Issued;
												disable Site;
												disable Description;
												disable Work_Order_Task;
												disable Work_Order;
												disable Material_Request_Details.Item;
												disable Material_Request_Details.Quantity;
												disable Material_Request_Details.Unit_Of_Measure;
												show Checklist_Section;
												show Job_Done_Checklist;
												show Checked_By_Email;
												show Date_Time_Work_Checked;
											}
											// ===================================
											// COMPLETED:
											// ===================================
											else if(input.Document_Status == "Completed")
											{
												show Approval_Section;
												show User;
												show Works_Coordinator;
												show Date_Time_Requested;
												show Requested_By_Email;
												show Supply_Manager;
												show Date_Time_Approved;
												show Approved_By_Email;
												show Store_Manager;
												show Issued_By_Email;
												show Date_Time_Issued;
												show Status_Details;
												show Document_Status;
												show Checklist_Section;
												show Job_Done_Checklist;
												show Checked_By_Email;
												show Date_Time_Work_Checked;
												disable Date_Time_Requested;
												disable Requested_By_Email;
												disable Supply_Manager;
												disable Date_Time_Approved;
												disable Approved_By_Email;
												disable Store_Manager;
												disable Issued_By_Email;
												disable Date_Time_Issued;
												disable Document_Status;
												disable Job_Done_Checklist;
												disable Checked_By_Email;
												disable Date_Time_Work_Checked;
												disable User;
												disable Works_Coordinator;
												disable Store_Manager;
												show Material_Request_Details.Quantity_Issued;
												show Material_Request_Details.Quantity_Returned;
												disable Material_Request_Details.Quantity_Returned;
												disable Material_Request_Details.Quantity_Issued;
												disable Site;
												disable Description;
												disable Work_Order_Task;
												disable Work_Order;
												disable Material_Request_Details.Item;
												disable Material_Request_Details.Quantity;
												disable Material_Request_Details.Unit_Of_Measure;
											}
											// ===================================
											// CANCELLED:
											// ===================================
											else if(input.Document_Status == "Cancelled")
											{
												show Approval_Section;
												show User;
												show Works_Coordinator;
												show Date_Time_Requested;
												show Requested_By_Email;
												show Supply_Manager;
												show Status_Details;
												show Document_Status;
												show Cancel_Voucher;
												show Reason_Why_Cancelled;
												disable User;
												disable Works_Coordinator;
												disable Supply_Manager;
												disable Cancel_Voucher;
												disable Reason_Why_Cancelled;
											}
										}
						)
					}
				}

			}
			Full_Validation_On_Create6 as "Full Validation On Create"
			{
				type =  form
				form = Sales_Return

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											seq = Document_Key[Voucher_Type == "Sales Return" && Document_Key_Status == "Active"];
										if(seq.ID != null)
										{
											next_no = ifnull(seq.Next_Number,1);
											next_no_text = next_no.toString();
											if(next_no < 10)
											{
												next_no_text = "0000" + next_no_text;
											}
											else if(next_no < 100)
											{
												next_no_text = "000" + next_no_text;
											}
											else if(next_no < 1000)
											{
												next_no_text = "00" + next_no_text;
											}
											else if(next_no < 10000)
											{
												next_no_text = "0" + next_no_text;
											}
											input.Sales_Return_Number = seq.Prefix + "-" + next_no_text;
											seq.Next_Number=next_no + 1;
										}
										if(input.Sales_Return_Date == null)
										{
											input.Sales_Return_Date = zoho.currentdate;
										}
										if(input.Sales_Return_Date == null)
										{
											alert "Sales Return Date is required.";
											cancel submit;
										}
										if(input.Sales_Voucher == null)
										{
											alert "Sales Voucher is required.";
											cancel submit;
										}
										if(input.Return_Type == null || input.Return_Type == "")
										{
											alert "Return Type is required.";
											cancel submit;
										}
										if(input.Reason_Why_Returned == null || input.Reason_Why_Returned.trim() == "")
										{
											alert "Reason Why Returned is required.";
											cancel submit;
										}
						)
					}
				}

			}
