			Full_Validation26 as "Full Validation"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										if(input.Sales_Type == null || input.Sales_Type == "")
										{
											errors = errors + "\n• Sales Type is required.";
										}
										if(errors != "")
										{
											alert errors;
											cancel submit;
										}
										if(input.Voucher == null)
										{
											errors = errors + "\n• Voucher is required.";
										}
										if(input.Customer == null)
										{
											errors = errors + "\n• Customer is required.";
										}
										if(input.Customer != null)
										{
											if(input.Customer.Delivery_Note_Required == true)
											{
												if(input.Delivery_Note == null)
												{
													errors = errors + "\n• Delivery Note is required for this customer.";
												}
											}
										}
										if(input.Sales_Type == "Item Sales")
										{
											for each  row in input.Product_Details
											{
												if(row.Item == null)
												{
													alert "Please select Item on line " + row.Line_Number;
													cancel submit;
												}
												if(row.Store_Item_Stock == null)
												{
													alert "Please select Store Item Stock on line " + row.Line_Number;
													cancel submit;
												}
												if(row.Unit_Of_Measure == null)
												{
													alert "Please select Unit Of Measure on line " + row.Line_Number;
													cancel submit;
												}
												if(row.Quantity == null || row.Quantity <= 0)
												{
													alert "Please enter Quantity greater than 0 on line " + row.Line_Number;
													cancel submit;
												}
											}
										}
										// -------------------------------
										// SAND SALES VALIDATION
										// -------------------------------
										if(input.Sales_Type == "Sand Sales")
										{
											if(input.Item == null)
											{
												errors = errors + "\n• Item is required for Sand Sales.";
											}
											if(input.Unit_Of_Measure == null)
											{
												errors = errors + "\n• Unit Of Measure is required for Sand Sales.";
											}
											if(input.Store_Item_Stock == null)
											{
												errors = errors + "\n• Store Item Stock is required for Sand Sales.";
											}
											if(input.Number_Plate == null)
											{
												errors = errors + "\n• Number Plate is required for Sand Sales.";
											}
											if(input.Truck_Measurement == null)
											{
												errors = errors + "\n• Truck Measurement is required for Sand Sales.";
											}
											if(input.Truck_Size == null || input.Truck_Size == "")
											{
												errors = errors + "\n• Truck Size is required for Sand Sales.";
											}
											if(ifnull(input.Truck_CBM,0.0) <= 0)
											{
												errors = errors + "\n• Truck CBM must be greater than 0.";
											}
											if(ifnull(input.Rate_per_CBM,0.0) <= 0)
											{
												errors = errors + "\n• Rate per CBM must be greater than 0.";
											}
											if(ifnull(input.Quantity_Available,0.0) < ifnull(input.Truck_CBM,0.0))
											{
												errors = errors + "\n• Quantity Available is less than Truck CBM.";
											}
										}
										// -------------------------------
										// FINAL ERROR
										// -------------------------------
										if(errors != "")
										{
											alert errors;
											cancel submit;
										}
										// =====================================================
										// WEIGH BRIDGE STATUS MOVEMENT
										// Draft -> In -> Out
										// =====================================================
										current_weigh_status = ifnull(input.Weigh_Bridge_Status,"Draft").trim();
										if(input.ID == null)
										{
											input.Weigh_Bridge_Status = "Draft";
										}
										else if(current_weigh_status == "" || current_weigh_status == "Draft")
										{
											input.Weigh_Bridge_Status = "In";
										}
										else if(current_weigh_status == "In")
										{
											if(input.Net_Weight != null && input.Net_Weight > 0 && input.Gross_Weight != null && input.Gross_Weight > 0 && input.Actual_Tonnes != null && input.Actual_Tonnes > 0)
											{
												input.Weigh_Bridge_Status = "Out";
											}
											else
											{
												input.Weigh_Bridge_Status = "In";
											}
										}
										else if(current_weigh_status == "Out")
										{
											input.Weigh_Bridge_Status = "Out";
										}
										// =====================================================
										// VALIDATE AND GENERATE GATE PASS CARD NUMBER
										// =====================================================
										if(input.Weigh_Bridge_Status == "Out")
										{
											if(input.Payment_Status != "Paid" && input.Payment_Status != "Credit")
											{
												alert "The Gate Pass Card cannot be generated. Payment Status must be Paid or Credit.";
												cancel submit;
											}
											else if(ifnull(input.Gate_Pass_Card_Number,"").trim() == "")
											{
												document_key = Document_Key[Voucher_Type == "Gate Pass Card" && Document_Key_Status == "Active"];
												if(document_key.ID == null)
												{
													alert "An active Gate Pass Card Document Key was not found.";
													cancel submit;
												}
												else
												{
													next_number = ifnull(document_key.Next_Number,1);
													max_number = ifnull(document_key.Max_Number,0);
													prefix_value = ifnull(document_key.Prefix,"GPC");
													if(max_number <= 0)
													{
														alert "The Gate Pass Card maximum number has not been configured.";
														cancel submit;
													}
													else if(next_number > max_number)
													{
														alert "The Gate Pass Card maximum number of " + max_number.toString() + " has been reached.";
														cancel submit;
													}
													else
													{
														number_text = next_number.toString();
														if(next_number < 10)
														{
															number_text = "00" + number_text;
														}
														else if(next_number < 100)
														{
															number_text = "0" + number_text;
														}
														input.Gate_Pass_Card_Number = document_key.Next_Number = next_number + 1;
													}
												}
											}
										}
						)
					}
				}

			}
