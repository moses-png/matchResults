											row_sb.Display_Name_Voucher=input.Voucher_Number;
										}
						)
					}
				}

			}
			Set_Up_Form5 as "Set Up Form"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------
										// 0) GET VOUCHER TYPE
										// ------------------------------
										voucherType = "";
