			Full_Validation24 as "Full Validation"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										// =============================
										// 1) REQUIRED MAIN FIELDS
										// =============================
										if(input.Issued_By == null)
										{
											errors = errors + "\n• Please select Issued By.";
										}
										if(input.Asset == null)
										{
											errors = errors + "\n• Asset is required.";
										}
										if(input.Fuel_Issuing_Time == null)
										{
											errors = errors + "\n• Fuel Issuing Time is required.";
										}
										if(input.Odometer == null)
										{
											errors = errors + "\n• Odometer is required.";
										}
										else if(input.Odometer < 0)
										{
											errors = errors + "\n• Odometer cannot be negative.";
										}
										if(input.Quantity == null)
										{
											errors = errors + "\n• Quantity is required.";
										}
										else if(input.Quantity <= 0)
										{
											errors = errors + "\n• Quantity must be greater than 0.";
										}
										if(input.Voucher == null)
										{
											errors = errors + "\n• Please select a Fuel Voucher.";
										}
										// =============================
										// 3) CONDITIONAL RULES
										// =============================
										if(input.Issued_By == "Vendor")
										{
											if(input.Vendor == null)
											{
												errors = errors + "\n• Please select a Vendor.";
											}
											if(input.Store != null)
											{
												errors = errors + "\n• Store must be empty when Issued By is Vendor.";
											}
											if(input.Item_Issuing_Detail != null)
											{
												errors = errors + "\n• Item Issuing Details must be empty when Issued By is Vendor.";
											}
										}
										else if(input.Issued_By == "Fuel Tank")
										{
											if(input.Store == null)
											{
												errors = errors + "\n• Please select a Store.";
											}
											if(input.Item_Issuing_Detail == null)
											{
												errors = errors + "\n• Please select Item Issuing Details.";
											}
											if(input.Vendor != null)
											{
												errors = errors + "\n• Vendor must be empty when Issued By is Fuel Tank.";
											}
										}
										resp = asset_management.validateAssetMileage(input.Asset.ID,input.Odometer,input.Fuel_Issuing_Time,"Fuel Receiving Voucher",input.ID.toString());
										if(resp.get("ok") != true)
										{
											alert resp.get("message");
											cancel submit;
										}
										// =============================
										// 4) FINAL GATE
										// =============================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
