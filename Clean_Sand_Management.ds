	 			row = 2
	 			column = 0   
				width = medium
			)
			Receiving_Type
			(
				type = picklist
				displayname = "Receiving Type"
				maxchar = 100
				values = {"Purchase Order","Internal Transfer","Stock Bundling Note","Stock Receiving Note","Tool Return","Stock Return"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Display_Name_Receiving_Type
			(
    			type = text
				displayname = "Display Name Receiving Type"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Internal_Transfer_Number
			(
				type = picklist	
				displayname = "Internal Transfer Number"
				values  = store_management.Stock_Transfer_Form[Receiving_Status == "Not Received" || Receiving_Status == "Partially Received"].ID
    			displayformat = [Transfer_Number]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Stock_Return_Number
			(
				type = picklist	
				displayname = "Stock Return Number"
				values  = Item_Issuing_Details[Status == "Issued" && Quantity_Returned <= 0].ID
    			displayformat = [Request_Voucher + " - " + Display_Name_Item]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Tool_Return_Number
			(
				type = picklist	
				displayname = "Tool Return Number"
				values  = Item_Issuing_Details[Item.Is_Tool == true && Status == "Borrowed"].ID
    			displayformat = [Request_Voucher + " - " + Display_Name_Item]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Purchase_Order
			(
				type = picklist	
				displayname = "Purchase Order"
				values  = Purchase_Order[PO_Status == "Open" && PO_Details.Quantity_Remaining > 0].ID
    			displayformat = [Display_Name_Company + " - " + PO_Number]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Voucher
			(
				type = picklist	
				values  = Voucher_Register[Stock_Bundling_Note.Stock_Status == "Pending"].ID
    			displayformat = [Voucher_Number + " - " + Display_Name_Employee]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
