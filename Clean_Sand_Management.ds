			Set_Up_Form4 as "Set Up Form"
			{
				type =  form
				form = Product_Price_Register

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//DISABLE FIELDS
										//Item Details
										disable Display_Name_Item;
										disable Display_Name_Unit_Of_Measure;
										//Back End
										disable User_Name;
										disable User_Email;
