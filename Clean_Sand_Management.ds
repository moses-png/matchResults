			Full_Validation27 as "Full Validation"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// DRAGER WORK REPORT -> FULL VALIDATION
										// ========================================
										errors = "";
										if(input.ID == null)
										{
											is_create = true;
										}
										else
										{
											is_create = false;
										}
										before_img = ifnull(input.Image_Before.toString(),"").trim();
										after_img = ifnull(input.Image_After.toString(),"").trim();
										if(input.Cancel_Voucher == true)
										{
											if(isNull(input.Reason_Why_Cancelled) || input.Reason_Why_Cancelled.trim() == "")
											{
												errors = errors + "\n• Reason Why Cancelled is required when Cancelled is checked.";
											}
										}
										if(is_create)
										{
											if(input.Voucher == null)
											{
												errors = errors + "\n• Voucher is required.";
											}
											if(input.Location == null)
											{
												errors = errors + "\n• Location is required.";
											}
											if(input.Job == null)
											{
												errors = errors + "\n• Job is required.";
											}
											else
											{
												jobNo = input.Job.Job_No;
												if(jobNo == "TJS01" && input.Batch_Number_From == null)
												{
													errors = errors + "\n• Batch Number is required for Drager production job.";
												}
												else if(jobNo == "TJS02" && input.Work_Order_Task == null)
												{
													errors = errors + "\n• Work Order Task is required for Drager service task.";
												}
											}
											if(input.Odometer_Start == null)
											{
												errors = errors + "\n• Odometer Start is required.";
											}
											if(before_img == "")
											{
												errors = errors + "\n• Image Before is required on create.";
											}
										}
										else
										{
											if(input.Cancel_Voucher != true && input.Drager_Work_Report_Status == "In Progress" && input.Odometer_End == null)
											{
												errors = errors + "\n• Odometer End is required when Status is In Progress and the record is not cancelled.";
											}
											if(after_img == "")
											{
												errors = errors + "\n• Image After is required on edit.";
											}
										}
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize17 as "Finalize"
			{
				type =  form
				form = Drager_Work_Report

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											info "===== DRAGER WORK REPORT FINALIZE START =====";
										// ========================================
										// CREATE OR EDIT CHECK
										// ========================================
										is_create = false;
										if(input.Added_Time != null && input.Modified_Time != null)
										{
											if(input.Added_Time.toLong() == input.Modified_Time.toLong())
											{
												is_create = true;
											}
										}
										// ========================================
										// ON CREATE
										// ========================================
										if(is_create)
										{
											if(input.Time_Start == null)
											{
												input.Time_Start = zoho.currenttime;
											}
											// Default
											input.Drager_Work_Report_Status = "In Progress";
											// ========================================
											// TJS03 - TRUCK MOVEMENT
											// ========================================
											if(input.Job != null && input.Job.Job_No == "TJS04")
											{
												input.Drager_Work_Report_Status = "Completed";
												if(input.Time_End == null)
												{
													input.Time_End = zoho.currenttime;
												}
												if(input.Time_Start != null && input.Time_End != null)
												{
													diffMillis = input.Time_End.toLong() - input.Time_Start.toLong();
													if(diffMillis >= 0)
													{
														input.Line_Duration_Minutes = round(diffMillis / 60000.0,2);
														input.Line_Hours_Worked = round(diffMillis / 3600000.0,2);
													}
													else
													{
														input.Line_Duration_Minutes = null;
														input.Line_Hours_Worked = null;
													}
												}
												if(input.Truck_Movement_Voucher != null)
												{
													tmv = Truck_Movement_Voucher[ID == input.Truck_Movement_Voucher];
													if(tmv.ID != null)
													{
														if(tmv.Truck_Movement_Voucher_Status == "Delivered")
														{
															tmv.Truck_Movement_Voucher_Status="Completed";
															info "Truck Movement updated to Completed on create.";
														}
													}
												}
											}
										}
										// ========================================
										// ON EDIT
										// ========================================
										else
										{
											if(input.Cancel_Voucher == true)
											{
												input.Drager_Work_Report_Status = "Cancelled";
											}
											else if(input.Drager_Work_Report_Status == "In Progress")
											{
												if(input.Time_End == null)
												{
													input.Time_End = zoho.currenttime;
												}
												if(input.Time_Start != null && input.Time_End != null)
												{
													diffMillis = input.Time_End.toLong() - input.Time_Start.toLong();
													if(diffMillis >= 0)
													{
														input.Line_Duration_Minutes = round(diffMillis / 60000.0,2);
														input.Line_Hours_Worked = round(diffMillis / 3600000.0,2);
													}
													else
													{
														input.Line_Duration_Minutes = null;
														input.Line_Hours_Worked = null;
													}
												}
												if(input.Job != null && input.Job.Job_No == "TJS01")
												{
													input.Drager_Work_Report_Status = "Loaded";
												}
												else
												{
													input.Drager_Work_Report_Status = "Completed";
												}
											}
										}
										// ========================================
										// CREATE BATCH STOCK OUT
										// ========================================
										if(input.Drager_Work_Report_Status == "Completed" || input.Drager_Work_Report_Status == "Loaded")
										{
											if(input.Job != null && input.Job.Job_No == "TJS01")
											{
												if(input.Batch_Number_From != null)
												{
													sourceID = input.ID;
													existingBatchStock = Batch_Stock[Source_Record_ID == sourceID];
													if(existingBatchStock.count() == 0)
													{
														lastLine = Batch_Stock[Batch_Number == input.Batch_Number_From] sort by Line_Number desc;
														nextLine = 1;
														currentBalance = 0.0;
														for each  l in lastLine
														{
															nextLine = ifnull(l.Line_Number,0) + 1;
															currentBalance = ifnull(l.Running_Balance,0.0);
															break;
														}
														qtyOut = -1;
														newBalance = currentBalance + qtyOut;
														insert into Batch_Stock
														[
															Batch_Number=input.Batch_Number_From
															Display_Name_Batch_Number=input.Batch_Number_From.Batch_Number
															Line_Number=nextLine
															Batch_Time=input.Time_End
															Batch_Type="Out"
															Reference=input.Display_Name_Voucher
															Quantity=qtyOut
															Running_Balance=newBalance
															Source_Record_ID=sourceID
															Source_Form="Drager Work Report"
															Added_User=zoho.loginuser
														]
														info "Batch Stock OUT created.";
													}
													else
													{
														info "Batch Stock OUT already exists.";
													}
												}
											}
										}
						)
					}
				}

			}
			Finalize_On_Delete15 as "Finalize On Delete"
			{
				type =  form
				form = Drager_Work_Report

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ========================================
										// FINALIZE ON DELETE
										// ========================================
										sourceID = input.ID;
										batchStockList = Batch_Stock[Source_Record_ID == sourceID && Source_Form == "Drager Work Report"];
										for each  bs in batchStockList
										{
											batchNo = bs.Batch_Number;
											deletedLine = bs.Line_Number;
											delete from Batch_Stock[ID == bs.ID];
											runningBalance = 0.0;
											previous = Batch_Stock[Batch_Number == batchNo && Line_Number < deletedLine] sort by Line_Number desc;
											for each  p in previous
											{
												runningBalance = ifnull(p.Running_Balance,0.0);
												break;
											}
											nextLines = Batch_Stock[Batch_Number == batchNo && Line_Number > deletedLine] sort by Line_Number asc;
											for each  rec in nextLines
											{
												runningBalance = runningBalance + ifnull(rec.Quantity,0.0);
												rec.Running_Balance=runningBalance;
											}
											info "Batch Stock OUT deleted and balances recalculated.";
										}
						)
					}
				}

			}
			Finalize_On_Create44 as "Finalize On Create"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
										// =====================================================
										// LOG START MILEAGE WHEN STATUS IS IN PROGRESS
										// =====================================================
										if(input.ID != null && input.Cancel_Voucher != true && input.Truck_Movement_Voucher_Status == "In Progress")
										{
											asset_id = null;
											if(input.Voucher != null && input.Voucher.Asset != null)
											{
												asset_id = input.Voucher.Asset.ID;
											}
											if(asset_id != null && input.Odometer_Start != null && input.Odometer_Start > 0 && input.Time_Start != null)
											{
												reference_text = ifnull(input.Display_Name_Voucher,"").trim();
												if(input.Line_Number != null)
												{
													if(reference_text != "")
													{
														reference_text = reference_text + " - " + input.Line_Number.toString();
													}
													else
													{
														reference_text = input.Line_Number.toString();
													}
												}
												reference_text = reference_text + " - Start";
												start_source_record_id = input.ID.toString() + "-START";
												start_mileage_resp = asset_management.logMileageFromMasaka(asset_id,input.Odometer_Start,input.Time_Start,reference_text,"Truck Movement Voucher",start_source_record_id);
												info start_mileage_resp;
											}
											else
											{
												info "Start mileage not logged: Asset, Odometer Start or Time Start is missing.";
											}
										}
						)
					}
					actions 
					{
					pushnotification
					(
						sender type : "users"
						to : "phmak00104@gmail.com"
						title : "Record Added"
						message : "${zoho.loginuserid} has added a record in form Truck Movement Voucher"
						view: "All_Truck_Movement_Vouchers"
					)
					}
				}

			}
			Finalize_On_Edit44 as "Finalize On Edit"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on edit

				on success
				{
					actions 
