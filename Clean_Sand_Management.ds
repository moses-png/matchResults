			Set_Up_Form4 as "Set Up Form"
			{
				type =  form
				form = Product_Price_Register

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//DISABLE FIELDS
										//Item Details
										disable Display_Name_Item;
										disable Display_Name_Unit_Of_Measure;
										//Back End
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										//HIDE FIELDS
										hide Display_Name_Item;
										hide Display_Name_Unit_Of_Measure;
										//Back End
										hide Back_End;
										if(input.ID == null)
										{
											input.Status = "Active";
											input.Effective_From = zoho.currentdate;
										}
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			On_Effective_To_Selected as "On Effective To Selected"
			{
				type =  form
				form = Product_Price_Register

				record event = on add or edit

				on user input of Effective_To
				{
					actions 
					{
						custom deluge script
						(
											if(input.Effective_To != null)
										{
											if(input.Effective_From != null && input.Effective_To < input.Effective_From)
											{
												alert "Effective To cannot be earlier than Effective From.";
												input.Effective_To = null;
												return;
											}
											if(input.Effective_To < zoho.currentdate)
											{
												input.Status = "Inactive";
											}
											else
											{
												input.Status = "Active";
											}
										}
						)
					}
				}

			}
