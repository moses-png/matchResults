			Full_Validation16 as "Full Validation"
			{
				type =  form
				form = Asset_Issues

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.ID != null)
										{
											if(input.Work_Order_Date == null)
											{
												input.Work_Order_Date = zoho.currenttime;
											}
											if(input.Resolve_Issue == true)
											{
												if(input.Reason_Why_Resolved == null || input.Reason_Why_Resolved.trim() == "")
												{
													alert "Please provide the Reason why the issue was resolved.";
													cancel submit;
												}
											}
											else
											{
												if(input.Work_Order_Date == null)
												{
													alert "Please enter the Work Order Date.";
													cancel submit;
												}
												if(input.Work_Order_Odometer_Reading == null)
												{
													alert "Please enter the Work Order Odometer Reading.";
													cancel submit;
												}
												if(input.Cancel_Work_Order == true)
												{
													if(input.Reason_Why_Cancelled == null || input.Reason_Why_Cancelled.trim() == "")
													{
														alert "Please provide the Reason Why the work order was cancelled.";
														cancel submit;
													}
													if(input.Work_Order_in_Charge_Of == null)
													{
														alert "Please select the Work Order in Charge Of.";
														cancel submit;
													}
												}
											}
										}
										mile_resp = asset_management.validateAssetMileage(input.Asset.ID,input.Odometer_Reading,input.Reported_Date,"Asset Issues",input.ID.toString());
										if(mile_resp.get("ok") != true)
										{
											alert mile_resp.get("message");
											cancel submit;
										}
										input.Odometer_Reading = mile_resp.get("Odometer_Reading");
						)
					}
				}

			}
			Finalize12 as "Finalize"
			{
				type =  form
				form = Asset_Issues

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// CLEAN SAND MANAGEMENT - ASSET ISSUE FINALIZE
										// =====================================================
										current_issue_status = ifnull(input.Issue_Status,"").toString().trim();
										current_work_order_status = ifnull(input.Work_Order_Status,"").toString().trim();
										has_work_order = false;
										if(input.Work_Order_Number != null && input.Work_Order_Number.toString().trim() != "")
										{
											has_work_order = true;
										}
										if(input.Asset != null && input.ID != null)
										{
											mile_log_resp = asset_management.logMileageFromCleanSand(input.Asset.ID,ifnull(input.Odometer_Reading,0.0),input.Reported_Date,ifnull(input.Issue_Number,""),"Asset Issues",input.ID.toString());
											info "CLEAN SAND ASSET ISSUE MILEAGE RESPONSE:";
											info mile_log_resp;
										}
										else if(input.Asset == null)
										{
											info "Mileage log skipped because Asset is unavailable.";
										}
										else
										{
											info "Mileage log skipped because Source Record ID is unavailable.";
										}
										if(input.Resolve_Issue == true)
										{
											input.Issue_Status = "Resolved";
											input.Work_Order_Status = "Cancelled";
										}
										else if(input.Cancel_Work_Order == true)
										{
											input.Issue_Status = "Cancelled";
											input.Work_Order_Status = "Cancelled";
										}
										else if(has_work_order == true)
										{
											if(current_issue_status != "Resolved" && current_issue_status != "Cancelled")
											{
												input.Issue_Status = "In Progress";
											}
											else
											{
												input.Issue_Status = current_issue_status;
											}
											if(current_work_order_status == "" || current_work_order_status == "Draft")
											{
												input.Work_Order_Status = "Pending";
											}
											else
											{
												input.Work_Order_Status = current_work_order_status;
											}
										}
										else
										{
											if(current_issue_status == "")
											{
												input.Issue_Status = "Draft";
											}
											else
											{
												input.Issue_Status = current_issue_status;
											}
											if(current_work_order_status == "")
											{
												input.Work_Order_Status = "Draft";
											}
											else
											{
												input.Work_Order_Status = current_work_order_status;
											}
										}
										status_to_sync = ifnull(input.Issue_Status,"").toString().trim();
										if(status_to_sync == "")
										{
											status_to_sync = "Draft";
											input.Issue_Status = "Draft";
										}
										if(input.ID != null)
										{
											asset_issue_payload = Map();
											asset_issue_payload.put("Source_Record_ID",input.ID);
											asset_issue_payload.put("Source_Form","Clean Sand Management - Asset Issues");
											asset_issue_payload.put("Voucher",input.Voucher);
											asset_issue_payload.put("Reported_By",input.Reported_By);
											asset_issue_payload.put("Site",input.Site);
											asset_issue_payload.put("Issue_Number",input.Issue_Number);
											asset_issue_payload.put("Asset",input.Asset);
											asset_issue_payload.put("Display_Name_Asset",input.Display_Name_Asset);
											asset_issue_payload.put("Current_Site",input.Current_Site);
											asset_issue_payload.put("Current_Custodian",input.Current_Custodian);
											asset_issue_payload.put("Odometer_Reading",ifnull(input.Odometer_Reading,0.0));
											asset_issue_payload.put("Reported_Date",input.Reported_Date);
											asset_issue_payload.put("Issue",input.Issue);
											asset_issue_payload.put("Issue_Description",input.Issue_Description);
											asset_issue_payload.put("Severity",input.Severity);
											asset_issue_payload.put("Status",status_to_sync);
											info "CLEAN SAND ASSET ISSUE SYNC PAYLOAD:";
											info asset_issue_payload;
											asset_issue_response = asset_management.syncAssetIssueFromCleanSand(asset_issue_payload);
											info "CLEAN SAND ASSET ISSUE SYNC RESPONSE:";
											info asset_issue_response;
											if(ifnull(asset_issue_response.get("ok"),false) == true)
											{
												info "CLEAN SAND ASSET ISSUE SYNC SUCCESSFUL: " + ifnull(asset_issue_response.get("message"),"Asset Issue synchronized successfully.");
											}
											else
											{
												info "CLEAN SAND ASSET ISSUE SYNC FAILED: " + ifnull(asset_issue_response.get("message"),"Unknown synchronization error.");
											}
										}
										else
										{
											info "Clean Sand Asset Issue sync skipped because Source Record ID is unavailable.";
										}
						)
					}
				}

			}
			On_Total_Amount_Paid_Sele as "On Total Amount Paid Selected"
			{
				type =  form
				form = Payment_Made_Voucher

				record event = on add or edit

				on user input of Total_Amount_Paid
				{
					actions 
					{
						custom deluge script
						(
											total_received = ifnull(input.Total_Amount_Paid,0);
										total_charges = ifnull(input.Total_Charges,0);
										amount_allocated = ifnull(input.Total_Amount_Allocated,0);
										// Net amount available after charges
										net_received = total_received - total_charges;
										if(net_received < 0)
										{
											net_received = 0;
										}
										input.Total_Amount_Not_Allocated = net_received - amount_allocated;
										if(input.Total_Amount_Not_Allocated < 0)
										{
											input.Total_Amount_Not_Allocated = 0;
										}
						)
					}
				}

			}
