			On_Credit_Amount_Selected as "On Credit Amount Selected"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on user input of Credit_Amount
				{
					actions 
					{
						custom deluge script
						(
											credit_amount = ifnull(input.Credit_Amount,0);
										if(credit_amount > ifnull(input.Amount_Due,0))
										{
											input.Credit_Amount = input.Amount_Due;
											credit_amount = input.Amount_Due;
										}
										input.Balance_Due = ifnull(input.Amount_Due,0) - credit_amount;
						)
					}
				}

			}
			On_Customer_Selected2 as "On Customer Selected"
			{
				type =  form
				form = Credit_Note

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											if(input.Customer != null)
										{
											input.Display_Name_Customer = input.Customer.Display_Name_Customer;
											input.Credit_Limit = ifnull(input.Customer.Credit_Limit,0);
											input.Current_Outstanding_Balance = ifnull(input.Customer.Current_Outstanding_Balance,0);
											input.Available_Credit = ifnull(input.Customer.Available_Credit,0);
											input.Credit_Days_Allowed = ifnull(input.Customer.Credit_Days_Allowed,0);
											input.Credit_Amount = ifnull(input.Balance_Due,0);
											if(input.Credit_Amount > input.Available_Credit)
											{
												input.Credit_Amount = input.Available_Credit;
											}
											input.Due_Date = zoho.currentdate.addDay(input.Credit_Days_Allowed);
										}
						)
					}
				}

			}
