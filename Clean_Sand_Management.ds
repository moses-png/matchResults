			Set_Up_Form30 as "Set Up Form"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// TRUCK MOVEMENT VOUCHER - ON LOAD
										// ======================================
										is_create = input.ID == null;
										// =======================
										// 1. DISABLE DISPLAY / AUTO FIELDS
										// =======================
										disable Display_Name_Voucher;
										disable Display_Name_Employee;
										disable Display_Name_Site;
										disable Display_Name_Asset;
										disable Line_Number;
										disable Number_Plate_Truck_Register;
										disable Work_Done;
										// ======================================
										//Pick Up Section
										// ======================================
										disable Display_Name_Party_From;
										disable Display_Name_Site_From;
										disable Pick_Up_From;
										disable Time_Start;
										// ======================================
										//Delivery Section
										// ======================================
										disable Display_Name_Party_To;
										disable Display_Name_Site_To;
										disable Delivery_To;
										disable Time_End;
										disable Reason_Why_Cancelled;
										disable Truck_Movement_Voucher_Status;
										// ======================================
										//Line Summary
										// ======================================
										disable Cost_Per_Odometer;
										disable Total_Cost;
										disable Line_Duration_Minutes;
										disable Line_Distance_Travelled;
										// ======================================
										//Back End
										// ======================================
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// =======================
										// 2. DEFAULT HIDE SECTIONS / JOB FIELDS
										// =======================
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										hide Display_Name_Site;
										hide Display_Name_Asset;
										hide Line_Number;
										hide Number_Plate_Truck_Register;
										hide Work_Order_Task;
										hide Truck_Movement_Voucher;
										hide Task_Location;
										hide Small_Notes;
										// ======================================
										//Pick Up Section
										// ======================================
										hide Pick_Up_Section;
										hide Display_Name_Party_From;
										hide Display_Name_Site_From;
										hide Time_Start;
										hide Display_Name_Job;
										// ======================================
										//Delivery Section
										// ======================================
										hide Delivery_Section;
										hide Display_Name_Party_To;
										hide Display_Name_Site_To;
										hide Time_End;
										hide Line_Summary;
										hide Back_End;
										// =======================
										// 3. JOB CONTROL
										// =======================
										if(input.Job != null)
										{
											jobNo = input.Job.Job_No;
											if(jobNo == "TJS01")
											{
												show Pick_Up_Section;
												hide Work_Order_Task;
												hide Truck_Movement_Voucher;
												hide Task_Location;
												hide Small_Notes;
												if(is_create)
												{
													input.Work_Order_Task = null;
													Batch_Number_From = null;
													input.Truck_Movement_Voucher = null;
													input.Task_Location = null;
													input.Small_Notes = null;
													input.Party_From = null;
													input.Party_Location_From = null;
													input.Site_To = null;
													input.Site_Location_To = null;
												}
												show Site_From;
												show Site_Location_From;
												disable Site_From;
												enable Site_Location_From;
												hide Party_From;
												hide Party_Location_From;
												show Party_To;
												show Party_Location_To;
												enable Party_To;
												enable Party_Location_To;
												hide Site_To;
												hide Site_Location_To;
											}
											else if(jobNo == "TJS02")
											{
												show Pick_Up_Section;
												show Work_Order_Task;
												enable Work_Order_Task;
												show Task_Location;
												enable Task_Location;
												show Small_Notes;
												enable Small_Notes;
												hide Truck_Movement_Voucher;
												if(is_create)
												{
													Card = null;
													Batch_Number_From = null;
													input.Truck_Movement_Voucher = null;
													input.Party_To = null;
													input.Party_Location_To = null;
												}
												if(input.Task_Location == "Suppliers")
												{
													show Party_From;
													show Party_Location_From;
													enable Party_From;
													enable Party_Location_From;
													hide Site_From;
													hide Site_Location_From;
													if(is_create)
													{
														input.Site_From = null;
														input.Site_Location_From = null;
													}
												}
												else
												{
													show Site_From;
													show Site_Location_From;
													enable Site_From;
													enable Site_Location_From;
													hide Party_From;
													hide Party_Location_From;
													if(is_create)
													{
														input.Party_From = null;
														input.Party_Location_From = null;
													}
												}
												show Site_To;
												show Site_Location_To;
												enable Site_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
											}
											else if(jobNo == "TJS03")
											{
												show Pick_Up_Section;
												show Tractor_Work_Report;
												hide Work_Order_Task;
												hide Truck_Movement_Voucher;
												hide Task_Location;
												hide Small_Notes;
												if(is_create)
												{
													Card = null;
													input.Work_Order_Task = null;
													input.Truck_Movement_Voucher = null;
													input.Task_Location = null;
													input.Small_Notes = null;
													input.Party_From = null;
													input.Party_Location_From = null;
													input.Party_To = null;
													input.Party_Location_To = null;
												}
												show Site_From;
												disable Site_From;
												show Site_Location_From;
												enable Site_Location_From;
												hide Party_From;
												hide Party_Location_From;
												show Site_To;
												disable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
											}
											else if(jobNo == "TJS04")
											{
												show Pick_Up_Section;
												show Truck_Movement_Voucher;
												enable Truck_Movement_Voucher;
												hide Work_Order_Task;
												hide Task_Location;
												show Small_Notes;
												enable Small_Notes;
												if(is_create)
												{
													Card = null;
													input.Work_Order_Task = null;
													Batch_Number_From = null;
													input.Task_Location = null;
													input.Site_From = null;
													input.Site_Location_From = null;
													input.Party_To = null;
													input.Party_Location_To = null;
												}
												show Party_From;
												disable Party_From;
												show Party_Location_From;
												enable Party_Location_From;
												hide Site_From;
												hide Site_Location_From;
												show Site_To;
												enable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
											}
										}
										else
										{
											hide Pick_Up_Section;
											hide Delivery_Section;
											hide Line_Summary;
											hide Work_Order_Task;
											hide Truck_Movement_Voucher;
											hide Task_Location;
											hide Small_Notes;
											if(is_create)
											{
												Card = null;
												input.Work_Order_Task = null;
												Batch_Number_From = null;
												input.Truck_Movement_Voucher = null;
												input.Task_Location = null;
												input.Small_Notes = null;
											}
										}
										// =======================
										// 4. CREATE MODE
										// =======================
										if(is_create)
										{
											hide Delivery_Section;
											hide Party_To;
											hide Party_Location_To;
											hide Site_To;
											hide Site_Location_To;
											hide Delivery_To;
											hide Odometer_End;
											hide Time_End;
											hide Delivery_To_Image;
											hide Cancel_Voucher;
											hide Reason_Why_Cancelled;
											hide Truck_Movement_Voucher_Status;
											hide Line_Summary;
										}
										// =======================
										// 5. EDIT MODE BY STATUS
										// =======================
										else
										{
											if(input.Truck_Movement_Voucher_Status == "In Progress")
											{
												disable Voucher;
												disable Job;
												disable Work_Done;
												disable Odometer_Start;
												disable Pick_Up_Image;
												show Pick_Up_Section;
												show Delivery_Section;
												if(input.Job != null)
												{
													jobNo2 = input.Job.Job_No;
													if(jobNo2 == "TJS01")
													{
														hide Task_Location;
														hide Small_Notes;
														show Party_To;
														show Party_Location_To;
														enable Party_To;
														enable Party_Location_To;
														hide Site_To;
														hide Site_Location_To;
														disable Site_Location_From;
													}
													else if(jobNo2 == "TJS02")
													{
														show Work_Order_Task;
														disable Work_Order_Task;
														show Task_Location;
														disable Task_Location;
														show Small_Notes;
														disable Small_Notes;
														if(input.Task_Location == "Suppliers")
														{
															show Party_From;
															show Party_Location_From;
															disable Party_From;
															disable Party_Location_From;
															hide Site_From;
															hide Site_Location_From;
														}
														else
														{
															show Site_From;
															show Site_Location_From;
															disable Site_From;
															disable Site_Location_From;
															hide Party_From;
															hide Party_Location_From;
														}
														show Site_To;
														show Site_Location_To;
														enable Site_To;
														enable Site_Location_To;
														hide Party_To;
														hide Party_Location_To;
													}
													else if(jobNo2 == "TJS03")
													{
														hide Task_Location;
														hide Small_Notes;
														show Site_From;
														disable Site_From;
														show Site_Location_From;
														disable Site_Location_From;
														show Site_To;
														disable Site_To;
														show Site_Location_To;
														enable Site_Location_To;
														hide Party_To;
														hide Party_Location_To;
														hide Party_From;
														hide Party_Location_From;
													}
													else if(jobNo2 == "TJS04")
													{
														show Truck_Movement_Voucher;
														disable Truck_Movement_Voucher;
														show Small_Notes;
														disable Small_Notes;
														show Party_From;
														disable Party_From;
														show Party_Location_From;
														disable Party_Location_From;
														hide Site_From;
														hide Site_Location_From;
														show Site_To;
														enable Site_To;
														show Site_Location_To;
														enable Site_Location_To;
														hide Party_To;
														hide Party_Location_To;
													}
												}
												show Odometer_End;
												show Delivery_To_Image;
												show Cancel_Voucher;
												enable Cancel_Voucher;
												hide Reason_Why_Cancelled;
												hide Line_Summary;
											}
											else if(input.Truck_Movement_Voucher_Status == "Completed")
											{
												show Pick_Up_Section;
												show Delivery_Section;
												show Line_Summary;
												hide Reason_Why_Cancelled;
												if(input.Job != null && input.Job.Job_No == "TJS02")
												{
													show Task_Location;
													show Small_Notes;
													disable Task_Location;
													disable Small_Notes;
													if(input.Task_Location == "Suppliers")
													{
														show Party_From;
														show Party_Location_From;
														disable Party_From;
														disable Party_Location_From;
														hide Site_From;
														hide Site_Location_From;
													}
													else
													{
														show Site_From;
														show Site_Location_From;
														disable Site_From;
														disable Site_Location_From;
														hide Party_From;
														hide Party_Location_From;
													}
												}
												else if(input.Job != null && input.Job.Job_No == "TJS04")
												{
													show Truck_Movement_Voucher;
													disable Truck_Movement_Voucher;
													show Small_Notes;
													disable Small_Notes;
												}
												else
												{
													hide Task_Location;
													hide Small_Notes;
												}
												disable Job;
												disable Work_Order_Task;
												disable Truck_Movement_Voucher;
												disable Work_Done;
												disable Task_Location;
												disable Small_Notes;
												disable Party_From;
												disable Party_Location_From;
												disable Site_From;
												disable Site_Location_From;
												disable Party_To;
												disable Party_Location_To;
												disable Site_To;
												disable Site_Location_To;
												disable Odometer_Start;
												disable Time_Start;
												disable Pick_Up_Image;
												disable Odometer_End;
												disable Time_End;
												disable Delivery_To_Image;
												show Cancel_Voucher;
												disable Cancel_Voucher;
												disable Truck_Movement_Voucher_Status;
											}
											else if(input.Truck_Movement_Voucher_Status == "Cancelled")
											{
												show Pick_Up_Section;
												show Delivery_Section;
												show Reason_Why_Cancelled;
												show Cancel_Voucher;
												if(input.Job != null && input.Job.Job_No == "TJS02")
												{
													show Task_Location;
													show Small_Notes;
													disable Task_Location;
													disable Small_Notes;
													if(input.Task_Location == "Suppliers")
													{
														show Party_From;
														show Party_Location_From;
														disable Party_From;
														disable Party_Location_From;
														hide Site_From;
														hide Site_Location_From;
													}
													else
													{
														show Site_From;
														show Site_Location_From;
														disable Site_From;
														disable Site_Location_From;
														hide Party_From;
														hide Party_Location_From;
													}
												}
												else if(input.Job != null && input.Job.Job_No == "TJS04")
												{
													show Truck_Movement_Voucher;
													disable Truck_Movement_Voucher;
													show Small_Notes;
													disable Small_Notes;
												}
												else
												{
													hide Task_Location;
													hide Small_Notes;
												}
												disable Cancel_Voucher;
												disable Job;
												disable Work_Order_Task;
												disable Truck_Movement_Voucher;
												disable Work_Done;
												disable Task_Location;
												disable Small_Notes;
												disable Party_From;
												disable Party_Location_From;
												disable Site_From;
												disable Site_Location_From;
												disable Party_To;
												disable Party_Location_To;
												disable Site_To;
												disable Site_Location_To;
												disable Odometer_Start;
												disable Time_Start;
												disable Pick_Up_Image;
												disable Odometer_End;
												disable Time_End;
												disable Delivery_To_Image;
												disable Reason_Why_Cancelled;
												disable Truck_Movement_Voucher_Status;
												hide Line_Summary;
											}
										}
						)
					}
				}

			}
			On_Cancel_Voucher_Selecte2 as "On Cancel Voucher Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Cancel_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_Voucher == true)
										{
											show Reason_Why_Cancelled;
											input.Truck_Movement_Voucher_Status = "Cancelled";
											input.Odometer_End = null;
											input.Time_End = null;
											input.Line_Distance_Travelled = 0;
											input.Line_Duration_Minutes = 0;
											input.Cost_Per_Odometer = 0;
											input.Total_Cost = 0;
											disable Odometer_End;
											disable Time_End;
											disable Party_To;
											disable Party_Location_To;
											disable Site_To;
											disable Site_Location_To;
											disable Delivery_To_Image;
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = null;
											input.Truck_Movement_Voucher_Status = "In Progress";
											enable Odometer_End;
											enable Time_End;
											enable Party_To;
											enable Party_Location_To;
											enable Site_To;
											enable Site_Location_To;
											enable Delivery_To_Image;
										}
						)
					}
				}

			}
			On_Job_Selected1 as "On Job Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Job
				{
					actions 
					{
						custom deluge script
						(
											if(input.Job != null)
										{
											input.Display_Name_Job = input.Job.Job_No + " - " + input.Job.Job_Name;
											jobNo = input.Job.Job_No;
											// ==================================
											// TJS01 - Card Sales
											// ==================================
											if(jobNo == "TJS01")
											{
												show Pick_Up_Section;
												hide Work_Order_Task;
												input.Work_Order_Task = null;
												hide Truck_Movement_Voucher;
												input.Truck_Movement_Voucher = null;
												hide Task_Location;
												input.Task_Location = null;
												hide Small_Notes;
												input.Small_Notes = null;
												show Site_From;
												show Site_Location_From;
												disable Site_From;
												enable Site_Location_From;
												show Site_To;
												show Site_Location_To;
												disable Site_To;
												enable Site_Location_To;
												hide Party_From;
												hide Party_Location_From;
												input.Party_From = null;
												input.Party_Location_From = null;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
											}
											// ==================================
											// TJS02 - Service Task
											// ==================================
											else if(jobNo == "TJS02")
											{
												show Pick_Up_Section;
												show Work_Order_Task;
												enable Work_Order_Task;
												show Task_Location;
												enable Task_Location;
												show Small_Notes;
												enable Small_Notes;
												hide Truck_Movement_Voucher;
												input.Truck_Movement_Voucher = null;
												show Site_To;
												show Site_Location_To;
												enable Site_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
												if(input.Task_Location == "Company Sites")
												{
													show Site_From;
													show Site_Location_From;
													enable Site_From;
													enable Site_Location_From;
													hide Party_From;
													hide Party_Location_From;
													input.Party_From = null;
													input.Party_Location_From = null;
												}
												else if(input.Task_Location == "Suppliers")
												{
													show Party_From;
													show Party_Location_From;
													enable Party_From;
													enable Party_Location_From;
													hide Site_From;
													hide Site_Location_From;
													input.Site_From = null;
													input.Site_Location_From = null;
												}
												else
												{
													hide Site_From;
													hide Site_Location_From;
													input.Site_From = null;
													input.Site_Location_From = null;
													hide Party_From;
													hide Party_Location_From;
													input.Party_From = null;
													input.Party_Location_From = null;
												}
											}
											// ==================================
											// TJS03 - Stock Production
											// ==================================
											else if(jobNo == "TJS03")
											{
												show Pick_Up_Section;
												hide Work_Order_Task;
												input.Work_Order_Task = null;
												hide Truck_Movement_Voucher;
												input.Truck_Movement_Voucher = null;
												hide Task_Location;
												input.Task_Location = null;
												hide Small_Notes;
												input.Small_Notes = null;
												show Site_From;
												disable Site_From;
												show Site_Location_From;
												enable Site_Location_From;
												show Site_To;
												disable Site_To;
												show Site_Location_To;
												enable Site_Location_To;
												hide Party_From;
												hide Party_Location_From;
												input.Party_From = null;
												input.Party_Location_From = null;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
											}
											// ==================================
											// TJS04 - Return Truck To Site
											// ==================================
											else if(jobNo == "TJS04")
											{
												show Pick_Up_Section;
												show Truck_Movement_Voucher;
												enable Truck_Movement_Voucher;
												hide Work_Order_Task;
												input.Work_Order_Task = null;
												hide Task_Location;
												input.Task_Location = null;
												show Party_From;
												show Party_Location_From;
												disable Party_From;
												enable Party_Location_From;
												hide Site_From;
												hide Site_Location_From;
												input.Site_From = null;
												input.Site_Location_From = null;
												show Site_To;
												show Site_Location_To;
												enable Site_To;
												enable Site_Location_To;
												hide Party_To;
												hide Party_Location_To;
												input.Party_To = null;
												input.Party_Location_To = null;
											}
										}
										else
										{
											hide Pick_Up_Section;
											hide Work_Order_Task;
											hide Truck_Movement_Voucher;
											hide Task_Location;
											hide Small_Notes;
											Card = null;
											input.Work_Order_Task = null;
											input.Truck_Movement_Voucher = null;
											input.Task_Location = null;
											input.Small_Notes = null;
											input.Display_Name_Job = null;
											show Site_From;
											show Site_Location_From;
											enable Site_From;
											enable Site_Location_From;
											show Site_To;
											show Site_Location_To;
											enable Site_To;
											enable Site_Location_To;
											show Party_From;
											show Party_Location_From;
											enable Party_From;
											enable Party_Location_From;
											show Party_To;
											show Party_Location_To;
											enable Party_To;
											enable Party_Location_To;
										}
						)
					}
				}

			}
			On_Odometer_End_Selected1 as "On Odometer End Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Odometer_End
				{
					actions 
					{
						custom deluge script
						(
											if(input.Odometer_End != null)
										{
											if(input.Odometer_Start != null)
											{
												distance = input.Odometer_End - input.Odometer_Start;
												if(distance < 0)
												{
													alert "Odometer End cannot be less than Odometer Start";
													input.Odometer_End = null;
													input.Line_Distance_Travelled = null;
													input.Total_Cost = null;
												}
												else
												{
													input.Line_Distance_Travelled = distance;
													if(input.Cost_Per_Odometer != null)
													{
														input.Total_Cost = distance * input.Cost_Per_Odometer;
													}
													else
													{
														input.Total_Cost = null;
													}
												}
											}
											else
											{
												alert "Please enter Odometer Start first";
												input.Odometer_End = null;
											}
										}
										else
										{
											input.Line_Distance_Travelled = null;
											input.Total_Cost = null;
										}
						)
					}
				}

			}
			On_Odometer_Start_Selecte1 as "On Odometer Start Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Odometer_Start
				{
					actions 
					{
						custom deluge script
						(
											if(input.Odometer_Start != null)
										{
											if(input.Odometer_End == null)
											{
												input.Line_Distance_Travelled = 0;
											}
											else
											{
												distance = input.Odometer_End - input.Odometer_Start;
												if(distance < 0)
												{
													alert "Odometer End cannot be less than Odometer Start";
													input.Odometer_Start = null;
													input.Line_Distance_Travelled = null;
												}
												else
												{
													input.Line_Distance_Travelled = distance;
												}
											}
										}
										else
										{
											input.Line_Distance_Travelled = null;
										}
						)
					}
				}

			}
