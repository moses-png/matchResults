		 functions
		 {
			 Deluge
			 {
				 map backfillCashPaymentMadeDetailsBatch()
                 {
                 	result = Map();
                 	// =====================================================
                 	// CHANGE THIS FOR EACH BATCH
                 	// Examples:
                 	// 0, 500, 1000, 1500...
                 	// =====================================================
                 	start_from = 0;
                 	batch_size = 500;
                 	end_at = start_from + batch_size - 1;
                 	loaded = 0;
                 	updated = 0;
                 	skipped = 0;
                 	failed = 0;
                 	failed_details = List();
                 	for each  rec in Payment_Made_Details[Amount_Paid > 0] sort by ID asc range from start_from to end_at
                 	{
                 		loaded = loaded + 1;
                 		amount_to_post = round(ifnull(rec.Amount_Paid,0.0),2);
                 		if(amount_to_post <= 0 || rec.Payment_Made_Voucher == null)
                 		{
                 			skipped = skipped + 1;
                 			continue;
                 		}
                 		// -----------------------------------------------
                 		// Load Payment Made Voucher header
                 		// -----------------------------------------------
                 		pmv = Payment_Made_Voucher[ID == rec.Payment_Made_Voucher];
                 		if(pmv.ID == null)
                 		{
                 			skipped = skipped + 1;
                 			continue;
                 		}
                 		voucher_number = ifnull(pmv.Payment_Made_Number,"").toString().trim();
                 		if(voucher_number == "")
                 		{
                 			skipped = skipped + 1;
                 			continue;
                 		}
                 		transaction_date = zoho.currentdate;
                 		if(pmv.Payment_Made_Date != null)
                 		{
                 			transaction_date = pmv.Payment_Made_Date;
                 		}
                 		// -----------------------------------------------
                 		// Build Grapes Group posting payload
                 		// -----------------------------------------------
                 		post = Map();
                 		post.put("Display_Name_Application","Masaka Site Management");
                 		post.put("Source_Form","Payment Made Details");
                 		post.put("Source_Record_ID",rec.ID.toString());
                 		post.put("Voucher_Number",voucher_number);
                 		// Lookup to Masaka Payment Made Details
                 		post.put("MSM_Payment_Made_Details",rec.ID);
                 		post.put("Transaction_Date",transaction_date);
                 		post.put("Business_Division",null);
                 		post.put("Display_Name_Business_Division","");
                 		// Receivable side
                 		post.put("Amount_To_Receive",0.0);
                 		post.put("Amount_Received",0.0);
                 		post.put("Amount_Not_Received",0.0);
                 		// Payable side
                 		post.put("Amount_To_Pay",0.0);
                 		post.put("Amount_Paid",amount_to_post);
                 		post.put("Amount_Not_Paid",amount_to_post * -1);
                 		resp = grapes_group.masakasite.postBusinessDivisionDetail(post);
                 		if(resp != null && ifnull(resp.get("ok"),false) == true)
                 		{
                 			updated = updated + 1;
                 		}
                 		else
                 		{
                 			failed = failed + 1;
                 			m = Map();
                 			m.put("Detail_ID",rec.ID);
                 			m.put("Voucher",voucher_number);
                 			m.put("Amount_Paid",amount_to_post);
                 			m.put("Response",resp);
                 			failed_details.add(m);
                 		}
                 	}
                 	result.put("start_from",start_from);
                 	result.put("end_at",end_at);
                 	result.put("batch_size",batch_size);
                 	result.put("loaded",loaded);
                 	result.put("updated",updated);
                 	result.put("skipped",skipped);
                 	result.put("failed",failed);
                 	result.put("failed_details",failed_details);
                 	if(loaded < batch_size)
                 	{
                 		result.put("last_batch",true);
                 	}
                 	else
                 	{
                 		result.put("last_batch",false);
                 	}
                 	info result;
                 	return result;
                 }
				 map backfillCashPaymentReceiptDetailsBatch()
                 {
                 	result = Map();
                 	// =====================================================
                 	// CHANGE THIS FOR EACH BATCH
                 	// =====================================================
                 	start_from = 10500;
                 	batch_size = 500;
                 	end_at = start_from + batch_size - 1;
                 	loaded = 0;
                 	updated = 0;
                 	skipped = 0;
                 	failed = 0;
                 	failed_details = List();
                 	for each  rec in Payment_Receipt_Details[Payment_Document == "Sales Voucher" && Sales_Voucher != null && Payment_Type == "Cash"] sort by ID asc range from start_from to end_at
                 	{
                 		loaded = loaded + 1;
                 		amount_to_post = round(ifnull(rec.Amount_Allocated,0.0),2);
                 		if(amount_to_post <= 0 || rec.Payment_Receipt_Voucher == null)
                 		{
                 			skipped = skipped + 1;
                 			continue;
                 		}
                 		post = Map();
                 		post.put("Display_Name_Application","Masaka Site Management");
                 		post.put("Source_Form","Payment Receipt Details");
                 		post.put("Source_Record_ID",rec.ID.toString());
                 		post.put("Voucher_Number",ifnull(rec.Display_Name_Voucher,""));
                 		// Lookup field
                 		post.put("MSM_Payment_Receipt_Details",rec.ID);
                 		post.put("Transaction_Date",rec.Payment_Receipt_Voucher.Payment_Receipt_Date);
                 		post.put("Business_Division",null);
                 		post.put("Display_Name_Business_Division","");
                 		// Receivable
                 		post.put("Amount_To_Receive",0.0);
                 		post.put("Amount_Received",amount_to_post);
                 		post.put("Amount_Not_Received",amount_to_post * -1);
                 		// Payable
                 		post.put("Amount_To_Pay",0.0);
                 		post.put("Amount_Paid",0.0);
                 		post.put("Amount_Not_Paid",0.0);
                 		resp = grapes_group.masakasite.postBusinessDivisionDetail(post);
                 		if(resp != null && ifnull(resp.get("ok"),false) == true)
                 		{
                 			updated = updated + 1;
                 		}
                 		else
                 		{
                 			failed = failed + 1;
                 			m = Map();
                 			m.put("Detail_ID",rec.ID);
                 			m.put("Voucher",ifnull(rec.Display_Name_Voucher,""));
                 			m.put("Amount_Allocated",amount_to_post);
                 			m.put("Response",resp);
                 			failed_details.add(m);
                 		}
                 	}
                 	result.put("start_from",start_from);
                 	result.put("end_at",end_at);
                 	result.put("batch_size",batch_size);
                 	result.put("loaded",loaded);
                 	result.put("updated",updated);
                 	result.put("skipped",skipped);
                 	result.put("failed",failed);
                 	result.put("failed_details",failed_details);
                 	result.put("last_batch",loaded < batch_size);
                 	info result;
                 	return result;
                 }
				 map backfillCashPaymentReceiptVoucherLookup()
                 {
                 	result = Map();
                 	start_from = 5000;
                 	batch_size = 1000;
                 	end_at = start_from + batch_size - 1;
                 	loaded = 0;
                 	updated = 0;
                 	already_filled = 0;
                 	not_found = 0;
                 	blank = 0;
                 	not_found_details = List();
                 	for each  rec in Payment_Receipt_Details[ID != 0] range from start_from to end_at
                 	{
                 		loaded = loaded + 1;
                 		if(ifnull(rec.Payment_Type,"") != "Cash")
                 		{
                 			continue;
                 		}
                 		if(rec.Payment_Receipt_Voucher != null)
                 		{
                 			already_filled = already_filled + 1;
                 			continue;
                 		}
                 		voucher_no = ifnull(rec.Display_Name_Voucher,"").trim();
                 		if(voucher_no == "")
                 		{
                 			blank = blank + 1;
                 			continue;
                 		}
                 		voucher = Payment_Receipt_Voucher[Payment_Receipt_Number == voucher_no];
                 		if(voucher.ID != null)
                 		{
                 			rec.Payment_Receipt_Voucher=voucher;
                 			updated = updated + 1;
                 		}
                 		else
                 		{
                 			not_found = not_found + 1;
                 			m = Map();
                 			m.put("Detail_ID",rec.ID);
                 			m.put("Voucher",voucher_no);
                 			not_found_details.add(m);
                 		}
                 	}
                 	result.put("loaded",loaded);
                 	result.put("updated",updated);
                 	result.put("already_filled",already_filled);
                 	result.put("blank",blank);
                 	result.put("not_found",not_found);
                 	result.put("not_found_details",not_found_details);
                 	info result;
                 	return result;
                 }
				 map backfillCashReceiptAllocations()
                 {
                 	result = Map();
                 	// Keep this at zero because processed vouchers leave the Unpaid filter
                 	start_from = 0;
                 	batch_size = 500;
                 	end_at = start_from + batch_size - 1;
                 	loaded_count = 0;
                 	processed_count = 0;
                 	allocated_count = 0;
                 	no_receipt_balance_count = 0;
                 	no_sales_balance_count = 0;
                 	missing_link_count = 0;
                 	failed_count = 0;
                 	failure_details = List();
                 	// =====================================================
                 	// LOOP ONLY THROUGH CASH ROWS LINKED TO UNPAID
                 	// SALES VOUCHERS
                 	// =====================================================
                 	for each  rec in Payment_Receipt_Details[Payment_Type == "Cash" && Payment_Receipt_Voucher != null && Sales_Voucher != null && Sales_Voucher.Payment_Status == "Unpaid"] range from start_from to end_at
                 	{
                 		loaded_count = loaded_count + 1;
                 		try 
                 		{
                 			receipt_id = rec.Payment_Receipt_Voucher.ID;
                 			sales_id = rec.Sales_Voucher.ID;
                 			receipt_rec = Payment_Receipt_Voucher[ID == receipt_id];
                 			sales_rec = Sales_Voucher[ID == sales_id];
                 			if(receipt_rec.ID == null || sales_rec.ID == null)
                 			{
                 				missing_link_count = missing_link_count + 1;
                 				continue;
                 			}
                 			// Extra safety check
                 			if(ifnull(sales_rec.Payment_Status,"").trim() != "Unpaid")
                 			{
                 				continue;
                 			}
                 			// =====================================================
                 			// 1. FIND RECEIPT MONEY AVAILABLE FOR THIS DETAIL
                 			// =====================================================
                 			other_receipt_allocated = 0.0;
                 			for each  other_det in Payment_Receipt_Details[Payment_Receipt_Voucher == receipt_id]
                 			{
                 				if(other_det.ID != rec.ID)
                 				{
                 					other_receipt_allocated = other_receipt_allocated + ifnull(other_det.Amount_Allocated,0.0);
                 				}
                 			}
                 			total_received = ifnull(receipt_rec.Total_Amount_Received,0.0);
                 			receipt_available = total_received - other_receipt_allocated;
                 			if(receipt_available < 0)
                 			{
                 				receipt_available = 0.0;
                 			}
                 			if(receipt_available <= 0)
                 			{
                 				no_receipt_balance_count = no_receipt_balance_count + 1;
                 				continue;
                 			}
                 			// =====================================================
                 			// 2. FIND SALES VOUCHER BALANCE BEFORE THIS DETAIL
                 			// =====================================================
                 			other_cash_allocated = 0.0;
                 			other_credit_allocated = 0.0;
                 			for each  sales_det in Payment_Receipt_Details[Sales_Voucher == sales_id && Payment_Document == "Sales Voucher"]
                 			{
                 				if(sales_det.ID != rec.ID)
                 				{
                 					payment_type = ifnull(sales_det.Payment_Type,"").trim();
                 					if(payment_type == "Cash")
                 					{
                 						other_cash_allocated = other_cash_allocated + ifnull(sales_det.Amount_Allocated,0.0);
                 					}
                 					else if(payment_type == "Credit")
                 					{
                 						other_credit_allocated = other_credit_allocated + ifnull(sales_det.Amount_Credited,0.0);
                 					}
                 				}
                 			}
                 			grand_total = ifnull(sales_rec.Grand_Total,0.0);
                 			sales_available = grand_total - other_cash_allocated - other_credit_allocated;
                 			if(sales_available < 0)
                 			{
                 				sales_available = 0.0;
                 			}
                 			if(sales_available <= 0)
                 			{
                 				no_sales_balance_count = no_sales_balance_count + 1;
                 				continue;
                 			}
                 			// =====================================================
                 			// 3. ALLOCATE AVAILABLE RECEIPT MONEY
                 			// =====================================================
                 			amount_to_allocate = receipt_available;
                 			if(amount_to_allocate > sales_available)
                 			{
                 				amount_to_allocate = sales_available;
                 			}
                 			rec.Payment_Document="Sales Voucher";
                 			rec.Display_Name_Invoice_Voucher=ifnull(sales_rec.Sales_Voucher_Number,"");
                 			rec.Customer=ifnull(sales_rec.Display_Name_Customer,"");
                 			rec.Amount_Due=sales_available;
                 			rec.Amount_Allocated=amount_to_allocate;
                 			detail_balance = sales_available - amount_to_allocate;
                 			if(detail_balance < 0)
                 			{
                 				detail_balance = 0.0;
                 			}
                 			rec.Balance_Due=detail_balance;
                 			if(sales_rec.Customer != null && sales_rec.Customer.Delivery_Note_Required == true)
                 			{
                 				rec.Delivery_Note=sales_rec.Delivery_Note;
                 			}
                 			else
                 			{
                 				rec.Delivery_Note=null;
                 			}
                 			// =====================================================
                 			// 4. RECALCULATE PAYMENT RECEIPT VOUCHER
                 			// =====================================================
                 			receipt_total_allocated = 0.0;
                 			for each  receipt_det in Payment_Receipt_Details[Payment_Receipt_Voucher == receipt_id]
                 			{
                 				receipt_total_allocated = receipt_total_allocated + ifnull(receipt_det.Amount_Allocated,0.0);
                 			}
                 			receipt_not_allocated = total_received - receipt_total_allocated;
                 			if(receipt_not_allocated < 0)
                 			{
                 				receipt_not_allocated = 0.0;
                 			}
                 			receipt_rec.Total_Amount_Allocated=receipt_total_allocated;
                 			receipt_rec.Total_Amount_Not_Allocated=receipt_not_allocated;
                 			if(receipt_total_allocated <= 0)
                 			{
                 				receipt_rec.Payment_Receipt_Voucher_Status="Unassigned";
                 			}
                 			else if(receipt_not_allocated > 0)
                 			{
                 				receipt_rec.Payment_Receipt_Voucher_Status="Partially Assigned";
                 			}
                 			else
                 			{
                 				receipt_rec.Payment_Receipt_Voucher_Status="Assigned";
                 			}
                 			for each  receipt_det2 in Payment_Receipt_Details[Payment_Receipt_Voucher == receipt_id]
                 			{
                 				receipt_det2.Amount_Not_Allocated=receipt_not_allocated;
                 			}
                 			// =====================================================
                 			// 5. RECALCULATE SALES VOUCHER
                 			// Cash   -> Amount Paid
                 			// Credit -> Amount Credited
                 			// =====================================================
                 			cash_total = 0.0;
                 			credit_total = 0.0;
                 			for each  sales_det2 in Payment_Receipt_Details[Sales_Voucher == sales_id && Payment_Document == "Sales Voucher"]
                 			{
                 				payment_type = ifnull(sales_det2.Payment_Type,"").trim();
                 				if(payment_type == "Cash")
                 				{
                 					cash_total = cash_total + ifnull(sales_det2.Amount_Allocated,0.0);
                 				}
                 				else if(payment_type == "Credit")
                 				{
                 					credit_total = credit_total + ifnull(sales_det2.Amount_Credited,0.0);
                 				}
                 			}
                 			sales_balance = grand_total - cash_total - credit_total;
                 			if(sales_balance < 0)
                 			{
                 				sales_balance = 0.0;
                 			}
                 			sales_rec.Amount_Paid=cash_total;
                 			sales_rec.Amount_Credited=credit_total;
                 			sales_rec.Balance_Due=sales_balance;
                 			if(grand_total > 0 && sales_balance <= 0)
                 			{
                 				if(credit_total > 0 && cash_total <= 0)
                 				{
                 					sales_rec.Payment_Status="Credit";
                 				}
                 				else
                 				{
                 					sales_rec.Payment_Status="Paid";
                 				}
                 			}
                 			else if(credit_total > 0 && cash_total > 0)
                 			{
                 				sales_rec.Payment_Status="Partially Paid";
                 			}
                 			else if(credit_total > 0)
                 			{
                 				sales_rec.Payment_Status="Partially Credited";
                 			}
                 			else if(cash_total > 0)
                 			{
                 				sales_rec.Payment_Status="Partially Paid";
                 			}
                 			else
                 			{
                 				sales_rec.Payment_Status="Unpaid";
                 			}
                 			processed_count = processed_count + 1;
                 			if(amount_to_allocate > 0)
                 			{
                 				allocated_count = allocated_count + 1;
                 			}
                 		}		catch (backfill_error)
                 		{
                 			failed_count = failed_count + 1;
                 			error_row = Map();
                 			error_row.put("payment_receipt_detail_id",rec.ID);
                 			error_row.put("message",backfill_error.toString());
                 			failure_details.add(error_row);
                 		}
                 	}
                 	result.put("ok",failed_count == 0);
                 	result.put("message","Unpaid cash receipt allocation backfill completed.");
                 	result.put("loaded_unpaid",loaded_count);
                 	result.put("processed",processed_count);
                 	result.put("allocated",allocated_count);
                 	result.put("no_receipt_balance",no_receipt_balance_count);
                 	result.put("no_sales_balance",no_sales_balance_count);
                 	result.put("missing_links",missing_link_count);
                 	result.put("failed",failed_count);
                 	result.put("failure_details",failure_details);
                 	info result;
                 	return result;
                 }
				 map backfillCreditNoteAmounts()
                 {
                 	result = Map();
                 	start_from = 1500;
                 	batch_size = 500;
                 	end_at = start_from + batch_size - 1;
                 	loaded = 0;
                 	updated = 0;
                 	already_filled = 0;
                 	no_amount_due = 0;
                 	failed = 0;
                 	failure_details = List();
                 	for each  credit_rec in Credit_Note[ID != 0] range from start_from to end_at
                 	{
                 		loaded = loaded + 1;
                 		try 
                 		{
                 			amount_due = ifnull(credit_rec.Amount_Due,0.0);
                 			credit_amount = ifnull(credit_rec.Credit_Amount,0.0);
                 			if(amount_due <= 0)
                 			{
                 				no_amount_due = no_amount_due + 1;
                 				continue;
                 			}
                 			// Fill Credit Amount when empty or zero
                 			if(credit_amount <= 0)
                 			{
                 				credit_amount = amount_due;
                 			}
                 			else
                 			{
                 				already_filled = already_filled + 1;
                 			}
                 			// Credit Amount must never exceed Amount Due
                 			if(credit_amount > amount_due)
                 			{
                 				credit_amount = amount_due;
                 			}
                 			credit_rec.Credit_Amount=credit_amount;
                 			balance_due = amount_due - credit_amount;
                 			if(balance_due < 0)
                 			{
                 				balance_due = 0.0;
                 			}
                 			credit_rec.Balance_Due=balance_due;
                 			updated = updated + 1;
                 		}		catch (backfill_error)
                 		{
                 			failed = failed + 1;
                 			error_row = Map();
                 			error_row.put("credit_note_id",credit_rec.ID);
                 			error_row.put("credit_note_number",ifnull(credit_rec.Credit_Note_Number,""));
                 			error_row.put("message",backfill_error.toString());
                 			failure_details.add(error_row);
                 		}
                 	}
                 	result.put("ok",failed == 0);
                 	result.put("message","Credit Note amount backfill completed.");
                 	result.put("start_from",start_from);
                 	result.put("next_start",start_from + loaded);
                 	result.put("loaded",loaded);
                 	result.put("updated",updated);
                 	result.put("already_filled",already_filled);
                 	result.put("no_amount_due",no_amount_due);
                 	result.put("failed",failed);
                 	result.put("failure_details",failure_details);
                 	info result;
                 	return result;
                 }
				 map backfillCreditNoteCustomerDetails()
                 {
                 	result = Map();
                 	start_from = 1200;
                 	batch_size = 500;
                 	end_at = start_from + batch_size - 1;
                 	loaded_count = 0;
                 	updated_count = 0;
                 	missing_customer_count = 0;
                 	failed_count = 0;
                 	failure_details = List();
                 	for each  credit_rec in Credit_Note[ID != 0] range from start_from to end_at
                 	{
                 		loaded_count = loaded_count + 1;
                 		if(credit_rec.Customer == null)
                 		{
                 			missing_customer_count = missing_customer_count + 1;
                 			continue;
                 		}
                 		try 
                 		{
                 			customer_rec = credit_rec.Customer;
                 			// ==========================================
                 			// COPY CUSTOMER CREDIT DETAILS
                 			// ==========================================
                 			credit_rec.Display_Name_Customer=ifnull(customer_rec.Display_Name_Customer,"");
                 			credit_rec.Credit_Limit=ifnull(customer_rec.Credit_Limit,0.0);
                 			credit_rec.Current_Outstanding_Balance=ifnull(customer_rec.Current_Outstanding_Balance,0.0);
                 			credit_rec.Available_Credit=ifnull(customer_rec.Available_Credit,0.0);
                 			credit_rec.Credit_Days_Allowed=ifnull(customer_rec.Credit_Days_Allowed,0);
                 			// ==========================================
                 			// CREDIT AMOUNT
                 			// ==========================================
                 			credit_amount = ifnull(credit_rec.Balance_Due,0.0);
                 			available_credit = ifnull(credit_rec.Available_Credit,0.0);
                 			if(credit_amount > available_credit)
                 			{
                 				credit_amount = available_credit;
                 			}
                 			if(credit_amount < 0)
                 			{
                 				credit_amount = 0.0;
                 			}
                 			credit_rec.Credit_Amount=credit_amount;
                 			// ==========================================
                 			// DUE DATE
                 			// Use Credit Note Date for historical records
                 			// ==========================================
                 			base_date = credit_rec.Credit_Note_Date;
                 			if(base_date == null)
                 			{
                 				base_date = zoho.currentdate;
                 			}
                 			credit_rec.Due_Date=base_date.addDay(ifnull(credit_rec.Credit_Days_Allowed,0));
                 			updated_count = updated_count + 1;
                 		}		catch (backfill_error)
                 		{
                 			failed_count = failed_count + 1;
                 			error_row = Map();
                 			error_row.put("credit_note_id",credit_rec.ID);
                 			error_row.put("credit_note_number",ifnull(credit_rec.Credit_Note_Number,""));
                 			error_row.put("customer",ifnull(credit_rec.Display_Name_Customer,""));
                 			error_row.put("message",backfill_error.toString());
                 			failure_details.add(error_row);
                 		}
                 	}
                 	result.put("ok",failed_count == 0);
                 	result.put("message","Credit Note customer details backfill completed.");
                 	result.put("start_from",start_from);
                 	result.put("next_start",start_from + loaded_count);
                 	result.put("loaded",loaded_count);
                 	result.put("updated",updated_count);
                 	result.put("missing_customer",missing_customer_count);
                 	result.put("failed",failed_count);
                 	result.put("failure_details",failure_details);
                 	info result;
                 	return result;
                 }
				 map backfillCreditNotePayments()
                 {
                 	result = Map();
                 	// Always remain at zero because processed vouchers leave the Unpaid filter
                 	start_from = 0;
                 	batch_size = 500;
                 	end_at = start_from + batch_size - 1;
                 	loaded_count = 0;
                 	processed_count = 0;
                 	payment_details_updated = 0;
                 	credit_notes_updated = 0;
                 	sales_vouchers_updated = 0;
                 	missing_payment_detail = 0;
                 	missing_credit_amount = 0;
                 	failed_count = 0;
                 	failure_details = List();
                 	// =====================================================
                 	// LOOP ONLY THROUGH CREDIT NOTES WHOSE SALES VOUCHER
                 	// IS CURRENTLY UNPAID
                 	// =====================================================
                 	for each  credit_rec in Credit_Note[Sales_Voucher != null && Sales_Voucher.Payment_Status == "Unpaid"] range from start_from to end_at
                 	{
                 		loaded_count = loaded_count + 1;
                 		try 
                 		{
                 			sales_id = credit_rec.Sales_Voucher.ID;
                 			sales_rec = Sales_Voucher[ID == sales_id];
                 			// Additional safety check
                 			if(sales_rec.ID == null)
                 			{
                 				continue;
                 			}
                 			if(ifnull(sales_rec.Payment_Status,"").trim() != "Unpaid")
                 			{
                 				continue;
                 			}
                 			// =====================================================
                 			// 1. ENSURE CREDIT NOTE AMOUNTS ARE CORRECT
                 			// =====================================================
                 			amount_due = ifnull(credit_rec.Amount_Due,0.0);
                 			credit_amount = ifnull(credit_rec.Credit_Amount,0.0);
                 			if(amount_due <= 0)
                 			{
                 				missing_credit_amount = missing_credit_amount + 1;
                 				continue;
                 			}
                 			// Backfill an empty Credit Amount from Amount Due
                 			if(credit_amount <= 0)
                 			{
                 				credit_amount = amount_due;
                 			}
                 			// Credit cannot exceed Amount Due
                 			if(credit_amount > amount_due)
                 			{
                 				credit_amount = amount_due;
                 			}
                 			credit_balance = amount_due - credit_amount;
                 			if(credit_balance < 0)
                 			{
                 				credit_balance = 0.0;
                 			}
                 			credit_rec.Credit_Amount=credit_amount;
                 			credit_rec.Balance_Due=credit_balance;
                 			// =====================================================
                 			// 2. UPDATE LINKED PAYMENT RECEIPT DETAILS
                 			// =====================================================
                 			detail_found = false;
                 			for each  pay_det in Payment_Receipt_Details[Credit_Note_Voucher == credit_rec.ID && Payment_Type == "Credit"]
                 			{
                 				detail_found = true;
                 				pay_det.Payment_Type="Credit";
                 				pay_det.Display_Name_Voucher=ifnull(credit_rec.Credit_Note_Number,"");
                 				pay_det.Payment_Document="Sales Voucher";
                 				pay_det.Sales_Voucher=sales_rec.ID;
                 				pay_det.Display_Name_Invoice_Voucher=ifnull(sales_rec.Sales_Voucher_Number,"");
                 				pay_det.Amount_Due=amount_due;
                 				pay_det.Amount_Credited=credit_amount;
                 				detail_balance = amount_due - credit_amount;
                 				if(detail_balance < 0)
                 				{
                 					detail_balance = 0.0;
                 				}
                 				pay_det.Balance_Due=detail_balance;
                 				if(pay_det.Customer == null)
                 				{
                 					pay_det.Customer=ifnull(sales_rec.Display_Name_Customer,"");
                 				}
                 				payment_details_updated = payment_details_updated + 1;
                 			}
                 			if(detail_found == false)
                 			{
                 				missing_payment_detail = missing_payment_detail + 1;
                 				continue;
                 			}
                 			// =====================================================
                 			// 3. REFRESH CREDIT NOTE DETAILS
                 			// =====================================================
                 			credit_rec.Sales_Voucher=sales_rec.ID;
                 			credit_rec.Display_Name_Sales_Voucher=ifnull(sales_rec.Sales_Voucher_Number,"");
                 			if(sales_rec.Customer != null)
                 			{
                 				credit_rec.Customer=sales_rec.Customer;
                 			}
                 			credit_rec.Display_Name_Customer=ifnull(sales_rec.Display_Name_Customer,"");
                 			credit_rec.Credit_Amount=credit_amount;
                 			credit_rec.Balance_Due=credit_balance;
                 			credit_notes_updated = credit_notes_updated + 1;
                 			// =====================================================
                 			// 4. RECALCULATE THE SALES VOUCHER
                 			//
                 			// Cash   -> Amount Paid
                 			// Credit -> Amount Credited
                 			// =====================================================
                 			cash_total = 0.0;
                 			credit_total = 0.0;
                 			for each  payment_rec in Payment_Receipt_Details[Sales_Voucher == sales_id && Payment_Document == "Sales Voucher"]
                 			{
                 				payment_type = ifnull(payment_rec.Payment_Type,"").trim();
                 				if(payment_type == "Cash")
                 				{
                 					cash_total = cash_total + ifnull(payment_rec.Amount_Allocated,0.0);
                 				}
                 				else if(payment_type == "Credit")
                 				{
                 					credit_total = credit_total + ifnull(payment_rec.Amount_Credited,0.0);
                 				}
                 			}
                 			grand_total = ifnull(sales_rec.Grand_Total,0.0);
                 			sales_balance = grand_total - cash_total - credit_total;
                 			if(sales_balance < 0)
                 			{
                 				sales_balance = 0.0;
                 			}
                 			sales_rec.Amount_Paid=cash_total;
                 			sales_rec.Amount_Credited=credit_total;
                 			sales_rec.Balance_Due=sales_balance;
                 			// =====================================================
                 			// 5. UPDATE PAYMENT STATUS
                 			// =====================================================
                 			if(grand_total > 0 && sales_balance <= 0)
                 			{
                 				// Entire Sales Voucher settled using cash and/or credit
                 				if(credit_total > 0 && cash_total <= 0)
                 				{
                 					sales_rec.Payment_Status="Credit";
                 				}
                 				else
                 				{
                 					sales_rec.Payment_Status="Paid";
                 				}
                 			}
                 			else if(credit_total > 0)
                 			{
                 				sales_rec.Payment_Status="Partially Credited";
                 			}
                 			else if(cash_total > 0)
                 			{
                 				sales_rec.Payment_Status="Partially Paid";
                 			}
                 			else
                 			{
                 				sales_rec.Payment_Status="Unpaid";
                 			}
                 			sales_vouchers_updated = sales_vouchers_updated + 1;
                 			processed_count = processed_count + 1;
                 		}		catch (backfill_error)
                 		{
                 			failed_count = failed_count + 1;
                 			error_row = Map();
                 			error_row.put("credit_note_id",credit_rec.ID);
                 			error_row.put("credit_note_number",ifnull(credit_rec.Credit_Note_Number,""));
                 			error_row.put("sales_voucher_number",ifnull(credit_rec.Display_Name_Sales_Voucher,""));
                 			error_row.put("message",backfill_error.toString());
                 			failure_details.add(error_row);
                 		}
                 	}
                 	// =====================================================
                 	// RESULT
                 	// =====================================================
                 	result.put("ok",failed_count == 0);
                 	result.put("message","Unpaid Credit Note payment backfill completed.");
                 	result.put("loaded_unpaid",loaded_count);
                 	result.put("processed",processed_count);
                 	result.put("payment_details_updated",payment_details_updated);
                 	result.put("credit_notes_updated",credit_notes_updated);
                 	result.put("sales_vouchers_updated",sales_vouchers_updated);
                 	result.put("missing_payment_detail",missing_payment_detail);
                 	result.put("missing_credit_amount",missing_credit_amount);
                 	result.put("failed",failed_count);
                 	result.put("failure_details",failure_details);
                 	info result;
                 	return result;
                 }
				 map backfillCreditNoteSalesVoucherLookup()
                 {
                 	result = Map();
                 	start_from = 3000;
                 	batch_size = 1500;
                 	end_at = start_from + batch_size - 1;
                 	loaded = 0;
                 	updated = 0;
                 	already_filled = 0;
                 	blank_display_name = 0;
                 	not_found = 0;
                 	failed = 0;
                 	not_found_details = List();
                 	failure_details = List();
                 	for each  credit_rec in Credit_Note[ID != 0] range from start_from to end_at
                 	{
                 		loaded = loaded + 1;
                 		if(credit_rec.Sales_Voucher != null)
                 		{
                 			already_filled = already_filled + 1;
                 			continue;
                 		}
                 		sales_voucher_no = ifnull(credit_rec.Display_Name_Sales_Voucher,"").trim();
                 		if(sales_voucher_no == "")
                 		{
                 			blank_display_name = blank_display_name + 1;
                 			continue;
                 		}
                 		try 
                 		{
                 			sales_rec = Sales_Voucher[Sales_Voucher_Number == sales_voucher_no];
                 			if(sales_rec.ID != null)
                 			{
                 				credit_rec.Sales_Voucher=sales_rec.ID;
                 				updated = updated + 1;
                 			}
                 			else
                 			{
                 				not_found = not_found + 1;
                 				not_found_row = Map();
                 				not_found_row.put("credit_note_id",credit_rec.ID);
                 				not_found_row.put("credit_note_number",ifnull(credit_rec.Credit_Note_Number,""));
                 				not_found_row.put("sales_voucher_number",sales_voucher_no);
                 				not_found_details.add(not_found_row);
                 			}
                 		}		catch (backfill_error)
                 		{
                 			failed = failed + 1;
                 			error_row = Map();
                 			error_row.put("credit_note_id",credit_rec.ID);
                 			error_row.put("credit_note_number",ifnull(credit_rec.Credit_Note_Number,""));
                 			error_row.put("sales_voucher_number",sales_voucher_no);
                 			error_row.put("message",backfill_error.toString());
                 			failure_details.add(error_row);
                 		}
                 	}
                 	result.put("ok",failed == 0);
                 	result.put("message","Credit Note Sales Voucher lookup backfill completed.");
                 	result.put("start_from",start_from);
                 	result.put("next_start",start_from + loaded);
                 	result.put("loaded",loaded);
                 	result.put("updated",updated);
                 	result.put("already_filled",already_filled);
                 	result.put("blank_display_name",blank_display_name);
                 	result.put("not_found",not_found);
                 	result.put("failed",failed);
                 	result.put("not_found_details",not_found_details);
                 	result.put("failure_details",failure_details);
                 	info result;
                 	return result;
                 }
				 map backfillCreditNoteVoucherLookup()
                 {
                 	result = Map();
                 	start_from = 5200;
                 	batch_size = 1200;
                 	end_at = start_from + batch_size - 1;
                 	loaded = 0;
                 	updated = 0;
                 	already_filled = 0;
                 	blank = 0;
                 	not_found = 0;
                 	not_found_details = List();
                 	for each  rec in Payment_Receipt_Details[ID != 0] range from start_from to end_at
                 	{
                 		loaded = loaded + 1;
                 		if(ifnull(rec.Payment_Type,"").trim() != "Credit")
                 		{
                 			continue;
                 		}
                 		if(rec.Credit_Note_Voucher != null)
                 		{
                 			already_filled = already_filled + 1;
                 			continue;
                 		}
                 		credit_note_no = ifnull(rec.Display_Name_Voucher,"").trim();
                 		if(credit_note_no == "")
                 		{
                 			blank = blank + 1;
                 			continue;
                 		}
                 		credit_note_rec = Credit_Note[Credit_Note_Number == credit_note_no];
                 		if(credit_note_rec.ID != null)
                 		{
                 			rec.Credit_Note_Voucher=credit_note_rec.ID;
                 			updated = updated + 1;
                 		}
                 		else
                 		{
                 			not_found = not_found + 1;
                 			not_found_row = Map();
                 			not_found_row.put("payment_receipt_detail_id",rec.ID);
                 			not_found_row.put("credit_note_number",credit_note_no);
                 			not_found_details.add(not_found_row);
                 		}
                 	}
                 	result.put("ok",true);
                 	result.put("message","Credit Note Voucher lookup backfill completed.");
                 	result.put("start_from",start_from);
                 	result.put("next_start",start_from + loaded);
                 	result.put("loaded",loaded);
                 	result.put("updated",updated);
                 	result.put("already_filled",already_filled);
                 	result.put("blank",blank);
                 	result.put("not_found",not_found);
                 	result.put("not_found_details",not_found_details);
                 	info result;
                 	return result;
                 }
				 map backfillEmployeeMonthlyDailyBillingBatch()
                 {
                 	result = Map();
                 	// =====================================================
                 	// BATCH SETTINGS
                 	//
                 	// RUN:
                 	// 5700
                 	// 5710
                 	// 5720
                 	// 5730
                 	// ...
                 	// =====================================================
                 	start_from = 6600;
                 	batch_size = 20;
                 	end_at = start_from + batch_size - 1;
                 	// =====================================================
                 	// COUNTERS
                 	// =====================================================
                 	loaded = 0;
                 	processed = 0;
                 	skipped = 0;
                 	failed = 0;
                 	employee_days_processed = 0;
                 	special_site_days_processed = 0;
                 	monthly_bills_created = 0;
                 	monthly_bills_found = 0;
                 	monthly_details_created = 0;
                 	monthly_details_updated = 0;
                 	special_monthly_details_created = 0;
                 	special_monthly_details_updated = 0;
                 	failed_details = List();
                 	// =====================================================
                 	// PREVENT REPEATING SAME GROUP INSIDE THIS BATCH
                 	// =====================================================
                 	processed_employee_days = List();
                 	processed_special_site_days = List();
                 	// =====================================================
                 	// LOAD CURRENT BATCH
                 	// =====================================================
                 	for each  rec in Voucher_Register[Employee != null] sort by ID asc range from start_from to end_at
                 	{
                 		loaded = loaded + 1;
                 		record_ready = false;
                 		record_failed = false;
                 		try 
                 		{
                 			// =================================================
                 			// 1. REQUIRE EMPLOYEE + DATE
                 			// =================================================
                 			if(rec.Employee != null && rec.Date_Time_In != null)
                 			{
                 				vDate = rec.Date_Time_In.toDate();
                 				employee_id = rec.Employee.ID;
                 				// =================================================
                 				// 2. EMPLOYEE + DATE KEY
                 				// =================================================
                 				employeeDayKey = employee_id.toString() + "|" + vDate.toString("yyyy-MM-dd");
                 				if(!processed_employee_days.contains(employeeDayKey))
                 				{
                 					processed_employee_days.add(employeeDayKey);
                 					employee_days_processed = employee_days_processed + 1;
                 					// =================================================
                 					// 3. BASIC VALUES
                 					// =================================================
                 					voucherType = ifnull(rec.Display_Name_Voucher_Type,"").trim();
                 					sourceVal = ifnull(rec.Display_Name_Employee,"").trim();
                 					siteVal = ifnull(rec.Display_Name_Site,"").trim();
                 					accountVal = siteVal;
                 					if(accountVal == "")
                 					{
                 						accountVal = "Unassigned Account";
                 					}
                 					// =================================================
                 					// 4. EMPLOYEE DETAILS
                 					// =================================================
                 					empName = ifnull(rec.Employee.Employee_Name,"").trim();
                 					empNumber = "";
                 					employee_number_value = 0;
                 					if(rec.Employee.Employee_Number != null)
                 					{
                 						employee_number_value = rec.Employee.Employee_Number;
                 						empNumber = employee_number_value.toString();
                 					}
                 					displayVendorName = empName;
                 					if(empNumber != "")
                 					{
                 						displayVendorName = empName + " - " + empNumber;
                 					}
                 					billName = displayVendorName;
                 					// =================================================
                 					// 5. GET MONTHLY SALARY
                 					// =================================================
                 					monthlySalary = 0.0;
                 					allowanceInput = Map();
                 					allowanceInput.put("Employee_ID",employee_id);
                 					allowanceResp = employee_management.getEmployeeActiveAllowance(allowanceInput);
                 					if(allowanceResp != null)
                 					{
                 						monthlySalary = ifnull(allowanceResp.get("Monthly_Salary"),0.0);
                 					}
                 					// =================================================
                 					// ONLY MONTHLY EMPLOYEES
                 					// =================================================
                 					if(monthlySalary > 0)
                 					{
                 						// =================================================
                 						// 6. SPECIAL EMPLOYEE?
                 						//
                 						// 10000 - 20000
                 						// =================================================
                 						specialMonthlyEmployee = false;
                 						if(employee_number_value >= 10000 && employee_number_value <= 20000)
                 						{
                 							specialMonthlyEmployee = true;
                 						}
                 						// =================================================
                 						// 7. NORMAL MONTHLY EMPLOYEE
                 						// =================================================
                 						if(specialMonthlyEmployee == false)
                 						{
                 							// =============================================
                 							// BUILD ALL VOUCHERS USED BY THIS EMPLOYEE
                 							// ON THIS DATE
                 							// =============================================
                 							dailyVoucherReference = "";
                 							dailyVoucherDetails = "";
                 							employeeVouchers = Voucher_Register[Employee == employee_id];
                 							for each  dayRec in employeeVouchers
                 							{
                 								if(dayRec.Date_Time_In != null)
                 								{
                 									if(dayRec.Date_Time_In.toDate() == vDate)
                 									{
                 										dayVoucherNumber = ifnull(dayRec.Voucher_Number,"").trim();
                 										dayVoucherType = ifnull(dayRec.Display_Name_Voucher_Type,"").trim();
                 										if(dayVoucherNumber != "")
                 										{
                 											// =================================
                 											// REFERENCE
                 											// =================================
                 											if(dailyVoucherReference == "")
                 											{
                 												dailyVoucherReference = dayVoucherNumber;
                 											}
                 											else
                 											{
                 												if(!dailyVoucherReference.contains(dayVoucherNumber))
                 												{
                 													dailyVoucherReference = dailyVoucherReference + ", " + dayVoucherNumber;
                 												}
                 											}
                 											// =================================
                 											// DETAILS
                 											// =================================
                 											voucherLine = dayVoucherNumber;
                 											if(dayVoucherType != "")
                 											{
                 												voucherLine = voucherLine + " - " + dayVoucherType;
                 											}
                 											if(dailyVoucherDetails == "")
                 											{
                 												dailyVoucherDetails = voucherLine;
                 											}
                 											else
                 											{
                 												if(!dailyVoucherDetails.contains(voucherLine))
                 												{
                 													dailyVoucherDetails = dailyVoucherDetails + "\n" + voucherLine;
                 												}
                 											}
                 										}
                 									}
                 								}
                 							}
                 							// =============================================
                 							// FALLBACK
                 							// =============================================
                 							if(dailyVoucherReference == "")
                 							{
                 								dailyVoucherReference = ifnull(rec.Voucher_Number,"");
                 							}
                 							if(dailyVoucherDetails == "")
                 							{
                 								dailyVoucherDetails = ifnull(rec.Voucher_Number,"");
                 								if(voucherType != "")
                 								{
                 									dailyVoucherDetails = dailyVoucherDetails + " - " + voucherType;
                 								}
                 							}
                 							// =================================================
                 							// 8. GET MONTHLY PERIOD
                 							// =================================================
                 							monthlyPeriodResp = thisapp.billing.getEmployeeBillPeriod(vDate,"Monthly Payment");
                 							monthlyBillDate = monthlyPeriodResp.get("Bill_Date");
                 							monthlyReference = monthlyPeriodResp.get("Bill_Number");
                 							// =================================================
                 							// 9. FIND / CREATE MONTHLY BILL
                 							// =================================================
                 							existingMonthlyBill = Bill[Employee_Vendor == employee_id && Bill_Number == monthlyReference && Bill_Type == "Employee Bill"];
                 							monthlyBillID = null;
                 							if(existingMonthlyBill.ID != null)
                 							{
                 								monthlyBillID = existingMonthlyBill.ID;
                 								monthly_bills_found = monthly_bills_found + 1;
                 								existingMonthlyBill.Bill_Date=monthlyBillDate;
                 								existingMonthlyBill.Bill_Type="Employee Bill";
                 								existingMonthlyBill.Employee_Vendor=employee_id;
                 								existingMonthlyBill.Display_Name_Vendor=displayVendorName;
                 								existingMonthlyBill.Bill_Name=billName;
                 								existingMonthlyBill.Bill_Number=monthlyReference;
                 							}
                 							else
                 							{
                 								monthlyBillID = insert into Bill
                 								[
                 									Bill_Date=monthlyBillDate
                 									Bill_Type="Employee Bill"
                 									Employee_Vendor=employee_id
                 									Display_Name_Vendor=displayVendorName
                 									Bill_Name=billName
                 									Bill_Number=monthlyReference
                 									Bill_Status="Draft"
                 									Payment_Status="Not Paid"
                 									Added_User=zoho.loginuser
                 								];
                 								if(monthlyBillID != null)
                 								{
                 									monthly_bills_created = monthly_bills_created + 1;
                 								}
                 							}
                 							// =================================================
                 							// 10. ONE MONTHLY DETAIL PER EMPLOYEE PER DAY
                 							// =================================================
                 							if(monthlyBillID != null)
                 							{
                 								monthlyDetailText = "";
                 								monthlyDetailText = "Date: " + vDate.toString("dd-MMM-yyyy");
                 								monthlyDetailText = monthlyDetailText + "\nEmployee: " + displayVendorName;
                 								monthlyDetailText = monthlyDetailText + "\nSite: " + siteVal;
                 								monthlyDetailText = monthlyDetailText + "\nMonth: " + monthlyReference;
                 								monthlyDetailText = monthlyDetailText + "\nMonthly Salary: " + monthlySalary.toString();
                 								monthlyDetailText = monthlyDetailText + "\n\nVouchers:";
                 								monthlyDetailText = monthlyDetailText + "\n" + dailyVoucherDetails;
                 								// =============================================
                 								// UNIQUE:
                 								// BILL + DATE + MONTHLY PAYMENT
                 								// =============================================
                 								existingMonthlyDetail = Bill_Details[Bill == monthlyBillID && Details_Date == vDate && Expense_Type == "Monthly Payment" && Source_Form == "Masaka Site Management - Voucher Register"];
                 								if(existingMonthlyDetail.count() == 0)
                 								{
                 									newMonthlyDetailID = insert into Bill_Details
                 									[
                 										Bill=monthlyBillID
                 										Display_Name_Bill=billName + " - " + monthlyReference
                 										Details_Date=vDate
                 										Source=sourceVal
                 										Reference=dailyVoucherReference
                 										Details=monthlyDetailText
                 										Expense_Type="Monthly Payment"
                 										Quantity=1.00
                 										Account=accountVal
                 										Current_Site=siteVal
                 										Source_Record_ID=rec.ID
                 										Source_Form="Masaka Site Management - Voucher Register"
                 										Bill_Details_Status="Draft"
                 										Added_User=zoho.loginuser
                 									];
                 									if(newMonthlyDetailID != null)
                 									{
                 										monthly_details_created = monthly_details_created + 1;
                 										record_ready = true;
                 									}
                 								}
                 								else
                 								{
                 									for each  monthlyBD in existingMonthlyDetail
                 									{
                 										monthlyBD.Display_Name_Bill=billName + " - " + monthlyReference;
                 										monthlyBD.Source=sourceVal;
                 										monthlyBD.Reference=dailyVoucherReference;
                 										monthlyBD.Details=monthlyDetailText;
                 										monthlyBD.Quantity=1.00;
                 										monthlyBD.Account=accountVal;
                 										monthlyBD.Current_Site=siteVal;
                 										monthly_details_updated = monthly_details_updated + 1;
                 										record_ready = true;
                 										break;
                 									}
                 								}
                 							}
                 							else
                 							{
                 								record_failed = true;
                 								fail_map = Map();
                 								fail_map.put("Voucher_ID",rec.ID);
                 								fail_map.put("Voucher_Number",ifnull(rec.Voucher_Number,""));
                 								fail_map.put("Reason","Monthly Bill could not be created or found.");
                 								failed_details.add(fail_map);
                 							}
                 						}
                 						// =================================================
                 						// 11. SPECIAL MONTHLY EMPLOYEES
                 						//
                 						// EMPLOYEE NUMBER 10000 - 20000
                 						//
                 						// DO NOT CREATE MONTHLY BILL
                 						//
                 						// ONE MONTHLY DETAIL:
                 						// SITE + DATE
                 						// =================================================
                 						else
                 						{
                 							if(siteVal != "")
                 							{
                 								specialSiteDayKey = siteVal + "|" + vDate.toString("yyyy-MM-dd");
                 								// =============================================
                 								// PROCESS SITE/DAY ONLY ONCE IN THIS BATCH
                 								// =============================================
                 								if(!processed_special_site_days.contains(specialSiteDayKey))
                 								{
                 									processed_special_site_days.add(specialSiteDayKey);
                 									special_site_days_processed = special_site_days_processed + 1;
                 									specialEmployees = List();
                 									specialSupervisorVouchers = List();
                 									specialEmployeeCount = 0;
                 									specialDetailsText = "";
                 									// =============================================
                 									// GET ALL VOUCHERS AT THIS SITE
                 									// =============================================
                 									siteVouchers = Voucher_Register[Display_Name_Site == siteVal];
                 									for each  siteVr in siteVouchers
                 									{
                 										if(siteVr.Employee != null && siteVr.Date_Time_In != null)
                 										{
                 											if(siteVr.Date_Time_In.toDate() == vDate)
                 											{
                 												siteEmpNo = 0;
                 												if(siteVr.Employee.Employee_Number != null)
                 												{
                 													siteEmpNo = siteVr.Employee.Employee_Number;
                 												}
                 												// =================================
                 												// SPECIAL RANGE
                 												// =================================
                 												if(siteEmpNo >= 10000 && siteEmpNo <= 20000)
                 												{
                 													siteEmployeeID = siteVr.Employee.ID;
                 													// =================================
                 													// CHECK MONTHLY SALARY
                 													// =================================
                 													siteAllowanceInput = Map();
                 													siteAllowanceInput.put("Employee_ID",siteEmployeeID);
                 													siteAllowanceResp = employee_management.getEmployeeActiveAllowance(siteAllowanceInput);
                 													siteMonthlySalary = 0.0;
                 													if(siteAllowanceResp != null)
                 													{
                 														siteMonthlySalary = ifnull(siteAllowanceResp.get("Monthly_Salary"),0.0);
                 													}
                 													if(siteMonthlySalary > 0)
                 													{
                 														siteEmployeeKey = siteEmployeeID.toString();
                 														siteEmployeeName = ifnull(siteVr.Employee.Employee_Name,"").trim();
                 														siteEmployeeDisplay = siteEmployeeName;
                 														if(siteEmpNo > 0)
                 														{
                 															siteEmployeeDisplay = siteEmployeeName + " - " + siteEmpNo.toString();
                 														}
                 														// =================================
                 														// EMPLOYEE HEADING ONCE
                 														// =================================
                 														if(!specialEmployees.contains(siteEmployeeKey))
                 														{
                 															specialEmployees.add(siteEmployeeKey);
                 															specialEmployeeCount = specialEmployeeCount + 1;
                 															if(specialDetailsText != "")
                 															{
                 																specialDetailsText = specialDetailsText + "\n";
                 															}
                 															specialDetailsText = specialDetailsText + "\n" + siteEmployeeDisplay;
                 														}
                 														// =================================
                 														// VOUCHER
                 														// =================================
                 														siteVoucherNo = ifnull(siteVr.Voucher_Number,"").trim();
                 														siteVoucherType = ifnull(siteVr.Display_Name_Voucher_Type,"").trim();
                 														if(siteVoucherNo != "")
                 														{
                 															siteVoucherLine = "  - " + siteVoucherNo;
                 															if(siteVoucherType != "")
                 															{
                 																siteVoucherLine = siteVoucherLine + " - " + siteVoucherType;
                 															}
                 															if(!specialDetailsText.contains(siteVoucherLine))
                 															{
                 																specialDetailsText = specialDetailsText + "\n" + siteVoucherLine;
                 															}
                 														}
                 														// =================================
                 														// SUPERVISOR VOUCHER
                 														// =================================
                 														supervisorVoucher = ifnull(siteVr.Display_Name_Issued_By,"").trim();
                 														if(supervisorVoucher != "")
                 														{
                 															if(!specialSupervisorVouchers.contains(supervisorVoucher))
                 															{
                 																specialSupervisorVouchers.add(supervisorVoucher);
                 															}
                 														}
                 													}
                 												}
                 											}
                 										}
                 									}
                 									// =============================================
                 									// BUILD REFERENCE
                 									// =============================================
                 									specialReference = "";
                 									for each  supVoucher in specialSupervisorVouchers
                 									{
                 										if(specialReference == "")
                 										{
                 											specialReference = supVoucher;
                 										}
                 										else
                 										{
                 											specialReference = specialReference + ", " + supVoucher;
                 										}
                 									}
                 									// =============================================
                 									// CREATE / UPDATE SITE DAILY MONTHLY DETAIL
                 									// =============================================
                 									if(specialEmployeeCount > 0)
                 									{
                 										specialMonthlyText = "";
                 										specialMonthlyText = "Date: " + vDate.toString("dd-MMM-yyyy");
                 										specialMonthlyText = specialMonthlyText + "\nSite: " + siteVal;
                 										specialMonthlyText = specialMonthlyText + "\nEmployees: " + specialEmployeeCount.toString();
                 										specialMonthlyText = specialMonthlyText + "\n\nEmployees / Vouchers:";
                 										specialMonthlyText = specialMonthlyText + specialDetailsText;
                 										// =========================================
                 										// USE A DIFFERENT SOURCE FORM
                 										// SO IT CANNOT MIX WITH NORMAL EMPLOYEE
                 										// MONTHLY DETAILS
                 										// =========================================
                 										existingSpecialDetail = Bill_Details[Details_Date == vDate && Current_Site == siteVal && Expense_Type == "Monthly Payment" && Source_Form == "Masaka Site Management - Site Daily Monthly Employees"];
                 										if(existingSpecialDetail.count() == 0)
                 										{
                 											newSpecialDetailID = insert into Bill_Details
                 											[
                 												Details_Date=vDate
                 												Source=siteVal
                 												Reference=specialReference
                 												Details=specialMonthlyText
                 												Expense_Type="Monthly Payment"
                 												Quantity=specialEmployeeCount
                 												Account=accountVal
                 												Current_Site=siteVal
                 												Source_Record_ID=rec.ID
                 												Source_Form="Masaka Site Management - Site Daily Monthly Employees"
                 												Bill_Details_Status="Draft"
                 												Added_User=zoho.loginuser
                 											];
                 											if(newSpecialDetailID != null)
                 											{
                 												special_monthly_details_created = special_monthly_details_created + 1;
                 												record_ready = true;
                 											}
                 										}
                 										else
                 										{
                 											for each  specialBD in existingSpecialDetail
                 											{
                 												specialBD.Source=siteVal;
                 												specialBD.Reference=specialReference;
                 												specialBD.Details=specialMonthlyText;
                 												specialBD.Quantity=specialEmployeeCount;
                 												specialBD.Account=accountVal;
                 												specialBD.Current_Site=siteVal;
                 												special_monthly_details_updated = special_monthly_details_updated + 1;
                 												record_ready = true;
                 												break;
                 											}
                 										}
                 									}
                 								}
                 								else
                 								{
                 									// Same special site/date already
                 									// processed in this batch
                 									record_ready = true;
                 								}
                 							}
                 						}
                 					}
                 					else
                 					{
                 						// =============================================
                 						// NO MONTHLY SALARY
                 						// =============================================
                 						skipped = skipped + 1;
                 					}
                 					// =================================================
                 					// 12. RESULT FOR THIS EMPLOYEE/DAY
                 					// =================================================
                 					if(record_failed == true)
                 					{
                 						failed = failed + 1;
                 					}
                 					if(record_ready == true)
                 					{
                 						processed = processed + 1;
                 					}
                 				}
                 				else
                 				{
                 					// =============================================
                 					// SAME EMPLOYEE + DATE ALREADY PROCESSED
                 					// =============================================
                 					skipped = skipped + 1;
                 				}
                 			}
                 			else
                 			{
                 				skipped = skipped + 1;
                 			}
                 		}		catch (e)
                 		{
                 			failed = failed + 1;
                 			fail_map = Map();
                 			fail_map.put("Voucher_ID",rec.ID);
                 			fail_map.put("Voucher_Number",ifnull(rec.Voucher_Number,""));
                 			fail_map.put("Reason",e.toString());
                 			failed_details.add(fail_map);
                 		}
                 	}
                 	// =====================================================
                 	// RESULT
                 	// =====================================================
                 	result.put("start_from",start_from);
                 	result.put("end_at",end_at);
                 	result.put("batch_size",batch_size);
                 	result.put("loaded",loaded);
                 	result.put("employee_days_processed",employee_days_processed);
                 	result.put("special_site_days_processed",special_site_days_processed);
                 	result.put("processed",processed);
                 	result.put("skipped",skipped);
                 	result.put("failed",failed);
                 	// =====================================================
                 	// NORMAL MONTHLY
                 	// =====================================================
                 	result.put("monthly_bills_created",monthly_bills_created);
                 	result.put("monthly_bills_found",monthly_bills_found);
                 	result.put("monthly_details_created",monthly_details_created);
                 	result.put("monthly_details_updated",monthly_details_updated);
                 	// =====================================================
                 	// SPECIAL MONTHLY
                 	// =====================================================
                 	result.put("special_monthly_details_created",special_monthly_details_created);
                 	result.put("special_monthly_details_updated",special_monthly_details_updated);
                 	// =====================================================
                 	// FAILURES
                 	// =====================================================
                 	result.put("failed_details",failed_details);
                 	// =====================================================
                 	// LAST BATCH
                 	// =====================================================
                 	if(loaded < batch_size)
                 	{
                 		result.put("last_batch",true);
                 	}
                 	else
                 	{
                 		result.put("last_batch",false);
                 	}
                 	info result;
                 	return result;
                 }
				 map backfillInvoiceDetailsDateAndVoucherLookup()
                 {
                 	result = Map();
                 	loaded = 0;
                 	updated = 0;
                 	skipped = 0;
                 	failed = 0;
                 	skipped_records = List();
                 	failed_records = List();
                 	for each  inv in Invoice_Details[Source_Form == "Sales Voucher" && Details_Date == null || Sales_Voucher == null]
                 	{
                 		loaded = loaded + 1;
                 		try 
                 		{
                 			voucher_number = ifnull(inv.Display_Name_Voucher,"").trim();
                 			if(voucher_number == "")
                 			{
                 				skipped = skipped + 1;
                 				skip_info = Map();
                 				skip_info.put("Invoice_Details_ID",inv.ID);
                 				skip_info.put("Reason","Display Name Voucher is empty.");
                 				skipped_records.add(skip_info);
                 				continue;
                 			}
                 			changed = false;
                 			// =====================================================
                 			// 1. FIND SALES VOUCHER BY VOUCHER NUMBER
                 			// Used to backfill Details Date.
                 			// =====================================================
                 			sv = Sales_Voucher[Sales_Voucher_Number == voucher_number];
                 			if(sv.ID != null)
                 			{
                 				if(inv.Details_Date == null && sv.Sales_Voucher_Date != null)
                 				{
                 					inv.Details_Date=sv.Sales_Voucher_Date;
                 					changed = true;
                 				}
                 			}
                 			// =====================================================
                 			// 2. FIND PAYMENT RECEIPT DETAIL
                 			// Sales_Voucher lookup in Invoice_Details points here.
                 			// =====================================================
                 			prd = Payment_Receipt_Details[Payment_Document == "Sales Voucher" && Display_Name_Invoice_Voucher == voucher_number] sort by ID desc;
                 			if(inv.Sales_Voucher == null && prd.ID != null)
                 			{
                 				// Assign Payment Receipt Details ID to the lookup.
                 				inv.Sales_Voucher=prd.ID;
                 				changed = true;
                 			}
                 			if(changed)
                 			{
                 				updated = updated + 1;
                 			}
                 			else
                 			{
                 				skipped = skipped + 1;
                 				reason = "";
                 				if(sv.ID == null && prd.ID == null)
                 				{
                 					reason = "No matching Sales Voucher or Payment Receipt Detail found.";
                 				}
                 				else if(prd.ID == null && inv.Sales_Voucher == null)
                 				{
                 					reason = "No matching Payment Receipt Detail found for the lookup.";
                 				}
                 				else if(sv.ID == null && inv.Details_Date == null)
                 				{
                 					reason = "No matching Sales Voucher found for Details Date.";
                 				}
                 				else
                 				{
                 					reason = "Required values were already filled.";
                 				}
                 				skip_info = Map();
                 				skip_info.put("Invoice_Details_ID",inv.ID);
                 				skip_info.put("Display_Name_Voucher",voucher_number);
                 				skip_info.put("Reason",reason);
                 				skipped_records.add(skip_info);
                 			}
                 		}		catch (e)
                 		{
                 			failed = failed + 1;
                 			failure = Map();
                 			failure.put("Invoice_Details_ID",inv.ID);
                 			failure.put("Display_Name_Voucher",ifnull(inv.Display_Name_Voucher,""));
                 			failure.put("Error",e.toString());
                 			failed_records.add(failure);
                 		}
                 	}
                 	result.put("ok",true);
                 	result.put("loaded",loaded);
                 	result.put("updated",updated);
                 	result.put("skipped",skipped);
                 	result.put("failed",failed);
                 	result.put("skipped_records",skipped_records);
                 	result.put("failed_records",failed_records);
                 	return result;
                 }
				 void backfillInvoiceDetailsNumberPlate()
                 {
                 	updated_count = 0;
                 	skipped_count = 0;
                 	error_count = 0;
                 	invoice_rows = Invoice_Details[Source_Form == "Sales Voucher" && Source_Record_ID != null];
                 	for each  inv in invoice_rows
                 	{
                 		try 
                 		{
                 			sales_voucher_id = inv.Source_Record_ID.toLong();
                 			sv_rec = Sales_Voucher[ID == sales_voucher_id];
                 			if(sv_rec.ID != null)
                 			{
                 				number_plate_text = ifnull(sv_rec.Display_Name_Number_Plate,"").trim();
                 				if(number_plate_text != "")
                 				{
                 					old_item_text = ifnull(inv.Item,"").trim();
                 					// Prevent adding the number plate more than once
                 					if(!old_item_text.startsWith("Number Plate:"))
                 					{
                 						inv.Item="Number Plate: " + number_plate_text + if(old_item_text != "","\n" + old_item_text,"");
                 						updated_count = updated_count + 1;
                 					}
                 					else
                 					{
                 						skipped_count = skipped_count + 1;
                 					}
                 				}
                 				else
                 				{
                 					skipped_count = skipped_count + 1;
                 					info "Skipped Invoice Detail " + inv.ID + ": Sales Voucher has no number plate.";
                 				}
                 			}
                 			else
                 			{
                 				error_count = error_count + 1;
                 				info "Sales Voucher not found for Invoice Detail: " + inv.ID;
                 			}
                 		}		catch (e)
                 		{
                 			error_count = error_count + 1;
                 			info "Error on Invoice Detail " + inv.ID + ": " + e.toString();
                 		}
                 	}
                 	info "NUMBER PLATE BACKFILL COMPLETED";
                 	info "Updated: " + updated_count;
                 	info "Skipped: " + skipped_count;
                 	info "Errors: " + error_count;
                 }
				 map backfillMasakaSalesVoucherBusinessDivisionDetails()
                 {
                 	result = Map();
                 	// ==================================================
                 	// BATCH SETTINGS
                 	// start_from is the record position, not the record ID
                 	// Examples: 0, 500, 1000, 1500...
                 	// ==================================================
                 	start_from = 13000;
                 	batch_size = 500;
                 	end_at = start_from + batch_size - 1;
                 	source_ids = List();
                 	total_loaded = 0;
                 	// ==================================================
                 	// FIRST LOOP: COLLECT SALES VOUCHER RECORD IDS
                 	// ==================================================
                 	for each  sales_rec in Sales_Voucher[ID != 0] sort by ID asc range from start_from to end_at
                 	{
                 		total_loaded = total_loaded + 1;
                 		if(sales_rec.ID != null)
                 		{
                 			source_ids.add(sales_rec.ID.toLong());
                 		}
                 	}
                 	// ==================================================
                 	// EMPTY BATCH
                 	// ==================================================
                 	if(total_loaded == 0)
                 	{
                 		result.put("ok",true);
                 		result.put("message","No Sales Voucher records were found in this batch.");
                 		result.put("start_from",start_from);
                 		result.put("end_at",end_at);
                 		result.put("next_start_from",start_from);
                 		result.put("loaded",0);
                 		result.put("created",0);
                 		result.put("updated",0);
                 		result.put("failed",0);
                 		result.put("last_batch",true);
                 		result.put("failure_details",List());
                 		info result;
                 		return result;
                 	}
                 	// ==================================================
                 	// CHECK WHICH SOURCE IDS ALREADY EXIST
                 	// ==================================================
                 	check_resp = grapes_group.masakasite.getExistingMasakaSalesVoucherIDs(source_ids);
                 	existing_ids = List();
                 	if(check_resp != null && ifnull(check_resp.get("ok"),false) == true)
                 	{
                 		returned_ids = check_resp.get("existing_ids");
                 		if(returned_ids != null)
                 		{
                 			for each  returned_id in returned_ids
                 			{
                 				if(returned_id != null && returned_id.toString().trim() != "")
                 				{
                 					existing_ids.add(returned_id.toString().toLong());
                 				}
                 			}
                 		}
                 	}
                 	else
                 	{
                 		result.put("ok",false);
                 		result.put("message","Could not check existing Business Division Details.");
                 		result.put("start_from",start_from);
                 		result.put("end_at",end_at);
                 		result.put("loaded",total_loaded);
                 		result.put("response",check_resp);
                 		info result;
                 		return result;
                 	}
                 	created_count = 0;
                 	updated_count = 0;
                 	failed_count = 0;
                 	failure_details = List();
                 	// ==================================================
                 	// SECOND LOOP: CREATE OR UPDATE EVERY RECORD
                 	// ==================================================
                 	for each  sales_rec in Sales_Voucher[ID != 0] sort by ID asc range from start_from to end_at
                 	{
                 		source_record_id = sales_rec.ID.toLong();
                 		was_existing = existing_ids.contains(source_record_id);
                 		voucher_number = ifnull(sales_rec.Sales_Voucher_Number,"").toString().trim();
                 		grand_total = round(ifnull(sales_rec.Grand_Total,0.0),2);
                 		transaction_date = zoho.currentdate;
                 		if(sales_rec.Sales_Voucher_Date != null)
                 		{
                 			transaction_date = sales_rec.Sales_Voucher_Date;
                 		}
                 		post = Map();
                 		// ------------------------------------------------
                 		// Source tracking
                 		// ------------------------------------------------
                 		post.put("Display_Name_Application","Masaka Site Management");
                 		post.put("Source_Form","Sales Voucher");
                 		post.put("Source_Record_ID",source_record_id);
                 		// Grapes Group lookup to Masaka Sales Voucher
                 		post.put("MSM_Sales_Voucher",source_record_id);
                 		post.put("Voucher_Number",voucher_number);
                 		// ------------------------------------------------
                 		// Transaction details
                 		// ------------------------------------------------
                 		post.put("Transaction_Date",transaction_date);
                 		post.put("Business_Division",null);
                 		post.put("Display_Name_Business_Division","");
                 		// ------------------------------------------------
                 		// Receivable totals
                 		// ------------------------------------------------
                 		post.put("Amount_To_Receive",grand_total);
                 		post.put("Amount_Received",0.0);
                 		post.put("Amount_Not_Received",grand_total);
                 		// ------------------------------------------------
                 		// Payable totals
                 		// ------------------------------------------------
                 		post.put("Amount_To_Pay",0.0);
                 		post.put("Amount_Paid",0.0);
                 		post.put("Amount_Not_Paid",0.0);
                 		try 
                 		{
                 			sync_resp = grapes_group.masakasite.postBusinessDivisionDetail(post);
                 			if(sync_resp != null && ifnull(sync_resp.get("ok"),false) == true)
                 			{
                 				if(was_existing)
                 				{
                 					updated_count = updated_count + 1;
                 				}
                 				else
                 				{
                 					created_count = created_count + 1;
                 				}
                 			}
                 			else
                 			{
                 				failed_count = failed_count + 1;
                 				error_row = Map();
                 				error_row.put("source_record_id",source_record_id);
                 				error_row.put("voucher_number",voucher_number);
                 				error_row.put("grand_total",grand_total);
                 				if(sync_resp != null)
                 				{
                 					error_row.put("message",ifnull(sync_resp.get("msg"),"Unknown synchronization error."));
                 					error_row.put("response",sync_resp);
                 				}
                 				else
                 				{
                 					error_row.put("message","No response received from Grapes Group.");
                 				}
                 				failure_details.add(error_row);
                 			}
                 		}		catch (sync_error)
                 		{
                 			failed_count = failed_count + 1;
                 			error_row = Map();
                 			error_row.put("source_record_id",source_record_id);
                 			error_row.put("voucher_number",voucher_number);
                 			error_row.put("grand_total",grand_total);
                 			error_row.put("message",sync_error.toString());
                 			failure_details.add(error_row);
                 		}
                 	}
                 	// ==================================================
                 	// RESULT
                 	// ==================================================
                 	next_start_from = start_from + batch_size;
                 	result.put("ok",failed_count == 0);
                 	result.put("message","Masaka Sales Voucher backfill batch completed.");
                 	result.put("start_from",start_from);
                 	result.put("end_at",end_at);
                 	result.put("next_start_from",next_start_from);
                 	result.put("loaded",total_loaded);
                 	result.put("created",created_count);
                 	result.put("updated",updated_count);
                 	result.put("failed",failed_count);
                 	result.put("failure_details",failure_details);
                 	if(total_loaded < batch_size)
                 	{
                 		result.put("last_batch",true);
                 	}
                 	else
                 	{
                 		result.put("last_batch",false);
                 	}
                 	info result;
                 	return result;
                 }
				 map backfillMissingPaymentReceipts()
                 {
                 	result = Map();
                 	start_from = 12000;
                 	batch_size = 1000;
                 	end_at = start_from + batch_size - 1;
                 	source_ids = List();
                 	total_loaded = 0;
                 	// ========================================
                 	// FIRST LOOP: COLLECT SOURCE RECORD IDS
                 	// ========================================
                 	for each  receipt_rec in Payment_Receipt_Voucher[ID != 0] range from start_from to end_at
                 	{
                 		total_loaded = total_loaded + 1;
                 		if(receipt_rec.ID != null)
                 		{
                 			source_ids.add(receipt_rec.ID.toLong());
                 		}
                 	}
                 	if(total_loaded == 0)
                 	{
                 		result.put("ok",true);
                 		result.put("message","No payment receipt records were found.");
                 		result.put("loaded",0);
                 		result.put("created",0);
                 		result.put("already_existing",0);
                 		result.put("failed",0);
                 		info result;
                 		return result;
                 	}
                 	// ========================================
                 	// CHECK WHICH RECORDS ALREADY EXIST
                 	// ========================================
                 	check_resp = payment_management.getExistingFreedomCityManagementPaymentReceiptIDs(source_ids);
                 	existing_ids = List();
                 	if(check_resp != null && ifnull(check_resp.get("ok"),false) == true)
                 	{
                 		returned_ids = check_resp.get("existing_ids");
                 		if(returned_ids != null)
                 		{
                 			for each  returned_id in returned_ids
                 			{
                 				if(returned_id != null)
                 				{
                 					existing_ids.add(returned_id.toLong());
                 				}
                 			}
                 		}
                 	}
                 	else
                 	{
                 		result.put("ok",false);
                 		result.put("message","Could not check existing Payment Management records.");
                 		result.put("response",check_resp);
                 		info result;
                 		return result;
                 	}
                 	created_count = 0;
                 	existing_count = 0;
                 	failed_count = 0;
                 	failure_details = List();
                 	// ========================================
                 	// SECOND LOOP: SYNC ONLY MISSING RECORDS
                 	// ========================================
                 	for each  receipt_rec in Payment_Receipt_Voucher[ID != 0] range from start_from to end_at
                 	{
                 		source_record_id = receipt_rec.ID.toLong();
                 		if(existing_ids.contains(source_record_id))
                 		{
                 			existing_count = existing_count + 1;
                 			continue;
                 		}
                 		receipt_datetime_txt = "";
                 		receipt_date_txt = "";
                 		if(receipt_rec.Payment_Receipt_Date != null)
                 		{
                 			receipt_datetime_txt = receipt_rec.Payment_Receipt_Date.toString("yyyy-MM-dd HH:mm:ss");
                 			receipt_date_txt = receipt_rec.Payment_Receipt_Date.toString("yyyy-MM-dd");
                 		}
                 		created_time_txt = "";
                 		if(receipt_rec.Created_By_Time != null)
                 		{
                 			created_time_txt = receipt_rec.Created_By_Time.toString("yyyy-MM-dd HH:mm:ss");
                 		}
                 		updated_time_txt = "";
                 		if(receipt_rec.Updated_By_Time != null)
                 		{
                 			updated_time_txt = receipt_rec.Updated_By_Time.toString("yyyy-MM-dd HH:mm:ss");
                 		}
                 		payload = Map();
                 		payload.put("Transaction_Type","Debit");
                 		payload.put("Account",receipt_rec.Receiving_Account);
                 		payload.put("Display_Name_Account",ifnull(receipt_rec.Display_Name_Receiving_Account,""));
                 		payload.put("Payment_Number",ifnull(receipt_rec.Payment_Receipt_Number,""));
                 		payload.put("Payment_Date",receipt_date_txt);
                 		payload.put("Payment_Date_Time",receipt_datetime_txt);
                 		payload.put("Description",ifnull(receipt_rec.Display_Name_Customer,""));
                 		payload.put("Total_Amount_Received",ifnull(receipt_rec.Total_Amount_Received,0.0));
                 		payload.put("Total_Amount_Paid",0.0);
                 		payload.put("Payment_Voucher_Status","Draft");
                 		payload.put("Application","Masaka Site Management");
                 		payload.put("Transaction_Date",receipt_date_txt);
                 		payload.put("Source_Form","Payment Receipt Voucher");
                 		payload.put("Source_Record_ID",source_record_id);
                 		payload.put("Voucher_Number",ifnull(receipt_rec.Payment_Receipt_Number,""));
                 		payload.put("User_Name",ifnull(receipt_rec.User_Name,""));
                 		payload.put("User_Email",ifnull(receipt_rec.User_Email,""));
                 		payload.put("User_Role",ifnull(receipt_rec.User_Role,""));
                 		payload.put("Created_By_Name",ifnull(receipt_rec.Created_By_Name,""));
                 		payload.put("Created_By_Email",ifnull(receipt_rec.Created_By_Email,""));
                 		payload.put("Created_By_Time",created_time_txt);
                 		payload.put("Updated_By_Name",ifnull(receipt_rec.Updated_By_Name,""));
                 		payload.put("Updated_By_Email",ifnull(receipt_rec.Updated_By_Email,""));
                 		payload.put("Updated_By_Time",updated_time_txt);
                 		try 
                 		{
                 			sync_resp = payment_management.syncPaymentVoucherFromMasakaSiteManagement(payload);
                 			if(sync_resp != null && ifnull(sync_resp.get("ok"),false) == true)
                 			{
                 				created_count = created_count + 1;
                 			}
                 			else
                 			{
                 				failed_count = failed_count + 1;
                 				error_row = Map();
                 				error_row.put("source_record_id",source_record_id);
                 				error_row.put("payment_number",ifnull(receipt_rec.Payment_Receipt_Number,""));
                 				if(sync_resp != null)
                 				{
                 					error_row.put("message",ifnull(sync_resp.get("message"),"Unknown synchronization error."));
                 				}
                 				else
                 				{
                 					error_row.put("message","No response received from Payment Management.");
                 				}
                 				failure_details.add(error_row);
                 			}
                 		}		catch (sync_error)
                 		{
                 			failed_count = failed_count + 1;
                 			error_row = Map();
                 			error_row.put("source_record_id",source_record_id);
                 			error_row.put("payment_number",ifnull(receipt_rec.Payment_Receipt_Number,""));
                 			error_row.put("message",sync_error.toString());
                 			failure_details.add(error_row);
                 		}
                 	}
                 	result.put("ok",failed_count == 0);
                 	result.put("message","Payment receipt backfill completed.");
                 	result.put("loaded",total_loaded);
                 	result.put("created",created_count);
                 	result.put("already_existing",existing_count);
                 	result.put("failed",failed_count);
                 	result.put("failure_details",failure_details);
                 	info result;
                 	return result;
                 }
				 map backfillMissingPaymentReceiptTransactionLogs()
                 {
                 	result = Map();
                 	// Change this after every successful execution:
                 	// 0, 20, 40, 60, 80...
                 	start_from = 9000;
                 	batch_size = 500;
                 	end_at = start_from + batch_size - 1;
                 	source_ids = List();
                 	total_loaded = 0;
                 	// ========================================
                 	// FIRST LOOP: COLLECT SOURCE RECORD IDS
                 	// ========================================
                 	for each  receipt_rec in Payment_Receipt_Voucher[ID != 0] range from start_from to end_at
                 	{
                 		total_loaded = total_loaded + 1;
                 		if(receipt_rec.ID != null)
                 		{
                 			source_ids.add(receipt_rec.ID.toLong());
                 		}
                 	}
                 	if(total_loaded == 0)
                 	{
                 		result.put("ok",true);
                 		result.put("message","No more payment receipt vouchers were found.");
                 		result.put("start_from",start_from);
                 		result.put("loaded",0);
                 		result.put("created",0);
                 		result.put("already_existing",0);
                 		result.put("failed",0);
                 		info result;
                 		return result;
                 	}
                 	// ========================================
                 	// CHECK EXISTING TRANSACTION LOGS
                 	// ========================================
                 	check_resp = payment_management.getExistingMasakaReceiptTransactionLogIDs(source_ids);
                 	existing_ids = List();
                 	if(check_resp != null && ifnull(check_resp.get("ok"),false) == true)
                 	{
                 		returned_ids = check_resp.get("existing_ids");
                 		if(returned_ids != null)
                 		{
                 			for each  returned_id in returned_ids
                 			{
                 				if(returned_id != null)
                 				{
                 					existing_ids.add(returned_id.toLong());
                 				}
                 			}
                 		}
                 	}
                 	else
                 	{
                 		result.put("ok",false);
                 		result.put("message","Could not check existing account transaction logs.");
                 		result.put("response",check_resp);
                 		info result;
                 		return result;
                 	}
                 	created_count = 0;
                 	updated_count = 0;
                 	existing_count = 0;
                 	failed_count = 0;
                 	failure_details = List();
                 	// ========================================
                 	// SECOND LOOP: CREATE ONLY MISSING LOGS
                 	// ========================================
                 	for each  receipt_rec in Payment_Receipt_Voucher[ID != 0] range from start_from to end_at
                 	{
                 		source_record_id = receipt_rec.ID.toLong();
                 		if(existing_ids.contains(source_record_id))
                 		{
                 			existing_count = existing_count + 1;
                 			continue;
                 		}
                 		receipt_dt = receipt_rec.Payment_Receipt_Date;
                 		if(receipt_dt == null)
                 		{
                 			receipt_dt = receipt_rec.Created_By_Time;
                 		}
                 		if(receipt_dt == null)
                 		{
                 			receipt_dt = zoho.currenttime;
                 		}
                 		created_time_val = receipt_rec.Created_By_Time;
                 		if(created_time_val == null)
                 		{
                 			created_time_val = receipt_dt;
                 		}
                 		updated_time_val = receipt_rec.Updated_By_Time;
                 		if(updated_time_val == null)
                 		{
                 			updated_time_val = zoho.currenttime;
                 		}
                 		txn = Map();
                 		txn.put("Transaction_Date",receipt_dt);
                 		txn.put("Transaction_Date_Time",receipt_dt);
                 		txn.put("Account",receipt_rec.Receiving_Account);
                 		txn.put("Display_Name_Account",ifnull(receipt_rec.Display_Name_Receiving_Account,""));
                 		txn.put("Transaction_Type","Debit");
                 		txn.put("Amount",ifnull(receipt_rec.Total_Amount_Received,0.0));
                 		txn.put("Reference_Type","Payment Receipt Voucher");
                 		txn.put("Reference_Number",ifnull(receipt_rec.Payment_Receipt_Number,""));
                 		txn.put("Application","Masaka Site Management");
                 		txn.put("Source_Form","Payment Receipt Voucher");
                 		txn.put("Source_Record_ID",source_record_id);
                 		txn.put("Notes",ifnull(receipt_rec.Display_Name_Customer,""));
                 		txn.put("User_Name",ifnull(receipt_rec.User_Name,""));
                 		txn.put("User_Email",ifnull(receipt_rec.User_Email,""));
                 		txn.put("User_Role",ifnull(receipt_rec.User_Role,""));
                 		txn.put("Created_By_Name",ifnull(receipt_rec.Created_By_Name,""));
                 		txn.put("Created_By_Email",ifnull(receipt_rec.Created_By_Email,""));
                 		txn.put("Created_By_Time",created_time_val);
                 		txn.put("Updated_By_Name",ifnull(receipt_rec.Updated_By_Name,""));
                 		txn.put("Updated_By_Email",ifnull(receipt_rec.Updated_By_Email,""));
                 		txn.put("Updated_By_Time",updated_time_val);
                 		try 
                 		{
                 			txn_resp = payment_management.createOrUpdateAccountTransactionLog(txn);
                 			if(txn_resp != null && ifnull(txn_resp.get("ok"),false) == true)
                 			{
                 				if(ifnull(txn_resp.get("created"),false) == true)
                 				{
                 					created_count = created_count + 1;
                 				}
                 				else
                 				{
                 					updated_count = updated_count + 1;
                 				}
                 			}
                 			else
                 			{
                 				failed_count = failed_count + 1;
                 				error_row = Map();
                 				error_row.put("source_record_id",source_record_id);
                 				error_row.put("payment_receipt_number",ifnull(receipt_rec.Payment_Receipt_Number,""));
                 				if(txn_resp != null)
                 				{
                 					error_row.put("message",ifnull(txn_resp.get("message"),"Unknown transaction log error."));
                 				}
                 				else
                 				{
                 					error_row.put("message","No response received from Payment Management.");
                 				}
                 				failure_details.add(error_row);
                 			}
                 		}		catch (sync_error)
                 		{
                 			failed_count = failed_count + 1;
                 			error_row = Map();
                 			error_row.put("source_record_id",source_record_id);
                 			error_row.put("payment_receipt_number",ifnull(receipt_rec.Payment_Receipt_Number,""));
                 			error_row.put("message",sync_error.toString());
                 			failure_details.add(error_row);
                 		}
                 	}
                 	result.put("ok",failed_count == 0);
                 	result.put("message","Account transaction log backfill batch completed.");
                 	result.put("start_from",start_from);
                 	result.put("next_start",start_from + total_loaded);
                 	result.put("loaded",total_loaded);
                 	result.put("created",created_count);
                 	result.put("updated",updated_count);
                 	result.put("already_existing",existing_count);
                 	result.put("failed",failed_count);
                 	result.put("failure_details",failure_details);
                 	info result;
                 	return result;
                 }
				 map backfillPaymentReceiptDetails()
                 {
                 	result = Map();
                 	start_from = 0;
                 	batch_size = 500;
                 	end_at = start_from + batch_size - 1;
                 	loaded_count = 0;
                 	synced_count = 0;
                 	skipped_non_cash = 0;
                 	missing_voucher_count = 0;
                 	failed_count = 0;
                 	failure_details = List();
                 	for each  receipt_det in Payment_Receipt_Details[ID != 0] range from start_from to end_at
                 	{
                 		loaded_count = loaded_count + 1;
                 		// Only synchronize cash payment details
                 		if(ifnull(receipt_det.Payment_Type,"").trim() != "Cash")
                 		{
                 			skipped_non_cash = skipped_non_cash + 1;
                 			continue;
                 		}
                 		if(receipt_det.Payment_Receipt_Voucher == null)
                 		{
                 			missing_voucher_count = missing_voucher_count + 1;
                 			continue;
                 		}
                 		try 
                 		{
                 			// ==========================================
                 			// BUILD DESCRIPTION
                 			// ==========================================
                 			description = "";
                 			doc_name = "";
                 			if(ifnull(receipt_det.Display_Name_Invoice_Voucher,"") != "")
                 			{
                 				doc_name = ifnull(receipt_det.Display_Name_Invoice_Voucher,"");
                 				if(doc_name.contains(" - "))
                 				{
                 					doc_name = doc_name.getPrefix(" - ");
                 				}
                 			}
                 			if(ifnull(receipt_det.Payment_Document,"") != "")
                 			{
                 				description = ifnull(receipt_det.Payment_Document,"");
                 			}
                 			if(doc_name != "")
                 			{
                 				if(description != "")
                 				{
                 					description = description + " - ";
                 				}
                 				description = description + doc_name;
                 			}
                 			// ==========================================
                 			// AMOUNT TO SYNCHRONIZE
                 			// ==========================================
                 			sync_amount = ifnull(receipt_det.Amount_Allocated,0.0);
                 			if(receipt_det.Payment_Document == "Cash Deposit" && sync_amount <= 0)
                 			{
                 				sync_amount = ifnull(receipt_det.Amount_Not_Allocated,0.0);
                 			}
                 			// ==========================================
                 			// TRANSACTION DATE
                 			// ==========================================
                 			transaction_date_txt = "";
                 			if(receipt_det.Payment_Receipt_Voucher.Payment_Receipt_Date != null)
                 			{
                 				transaction_date_txt = receipt_det.Payment_Receipt_Voucher.Payment_Receipt_Date.toString("yyyy-MM-dd HH:mm:ss");
                 			}
                 			// ==========================================
                 			// CREATED AND UPDATED TIMES
                 			// ==========================================
                 			created_time_txt = "";
                 			if(receipt_det.Created_By_Time != null)
                 			{
                 				created_time_txt = receipt_det.Created_By_Time.toString("yyyy-MM-dd HH:mm:ss");
                 			}
                 			updated_time_txt = "";
                 			if(receipt_det.Updated_By_Time != null)
                 			{
                 				updated_time_txt = receipt_det.Updated_By_Time.toString("yyyy-MM-dd HH:mm:ss");
                 			}
                 			// ==========================================
                 			// BUILD PAYLOAD
                 			// ==========================================
                 			payload = Map();
                 			payload.put("Payment_Voucher_Source_ID",receipt_det.Payment_Receipt_Voucher.ID.toLong());
                 			payload.put("Display_Name_Payment_Voucher",ifnull(receipt_det.Display_Name_Voucher,""));
                 			payload.put("Line_Number",receipt_det.Line_Number);
                 			payload.put("Description",description);
                 			payload.put("Amount_Allocated",sync_amount);
                 			payload.put("Application","Masaka Site Management");
                 			payload.put("Transaction_Date",transaction_date_txt);
                 			payload.put("Source_Form","Payment Receipt Details");
                 			payload.put("Source_Record_ID",receipt_det.ID.toLong());
                 			payload.put("Voucher_Number",ifnull(receipt_det.Payment_Receipt_Voucher.Payment_Receipt_Number,""));
                 			payload.put("User_Name",ifnull(receipt_det.User_Name,""));
                 			payload.put("User_Email",ifnull(receipt_det.User_Email,""));
                 			payload.put("User_Role",ifnull(receipt_det.User_Role,""));
                 			payload.put("Created_By_Name",ifnull(receipt_det.Created_By_Name,""));
                 			payload.put("Created_By_Email",ifnull(receipt_det.Created_By_Email,""));
                 			payload.put("Created_By_Time",created_time_txt);
                 			payload.put("Updated_By_Name",ifnull(receipt_det.Updated_By_Name,""));
                 			payload.put("Updated_By_Email",ifnull(receipt_det.Updated_By_Email,""));
                 			payload.put("Updated_By_Time",updated_time_txt);
                 			// ==========================================
                 			// SYNCHRONIZE
                 			// ==========================================
                 			sync_resp = payment_management.syncPaymentDetailsFromMasakaSiteManagement(payload);
                 			if(sync_resp != null && ifnull(sync_resp.get("ok"),false) == true)
                 			{
                 				synced_count = synced_count + 1;
                 			}
                 			else
                 			{
                 				failed_count = failed_count + 1;
                 				error_row = Map();
                 				error_row.put("payment_receipt_detail_id",receipt_det.ID);
                 				error_row.put("voucher_number",ifnull(receipt_det.Payment_Receipt_Voucher.Payment_Receipt_Number,""));
                 				if(sync_resp != null)
                 				{
                 					error_row.put("message",ifnull(sync_resp.get("message"),"Unknown synchronization error."));
                 				}
                 				else
                 				{
                 					error_row.put("message","No response received from Payment Management.");
                 				}
                 				failure_details.add(error_row);
                 			}
                 		}		catch (sync_error)
                 		{
                 			failed_count = failed_count + 1;
                 			error_row = Map();
                 			error_row.put("payment_receipt_detail_id",receipt_det.ID);
                 			error_row.put("message",sync_error.toString());
                 			failure_details.add(error_row);
                 		}
                 	}
                 	result.put("ok",failed_count == 0);
                 	result.put("message","Payment Receipt Details backfill completed.");
                 	result.put("start_from",start_from);
                 	result.put("next_start",start_from + loaded_count);
                 	result.put("loaded",loaded_count);
                 	result.put("synced",synced_count);
                 	result.put("skipped_non_cash",skipped_non_cash);
                 	result.put("missing_voucher",missing_voucher_count);
                 	result.put("failed",failed_count);
                 	result.put("failure_details",failure_details);
                 	info result;
                 	return result;
                 }
				 map backfillPaymentReceiptVoucherTotals()
                 {
                 	result = Map();
                 	start_from = 0;
                 	batch_size = 500;
                 	end_at = start_from + batch_size - 1;
                 	loaded_count = 0;
                 	updated_count = 0;
                 	failed_count = 0;
                 	failure_details = List();
                 	// Only process Unassigned Payment Receipt Vouchers
                 	for each  receipt in Payment_Receipt_Voucher[ID != 0 && Payment_Receipt_Voucher_Status == "Unassigned"] range from start_from to end_at
                 	{
                 		loaded_count = loaded_count + 1;
                 		try 
                 		{
                 			total_received = ifnull(receipt.Total_Amount_Received,0.0);
                 			// Keep existing charges (if they are entered on the header)
                 			total_charges = ifnull(receipt.Total_Charges,0.0);
                 			total_allocated = 0.0;
                 			for each  det in Payment_Receipt_Details[Payment_Receipt_Voucher == receipt.ID]
                 			{
                 				total_allocated = total_allocated + ifnull(det.Amount_Allocated,0.0);
                 			}
                 			total_not_allocated = total_received - total_charges - total_allocated;
                 			if(total_not_allocated < 0)
                 			{
                 				total_not_allocated = 0.0;
                 			}
                 			// Determine status
                 			new_status = "Assigned";
                 			if(total_allocated <= 0)
                 			{
                 				new_status = "Assigned";
                 			}
                 			else if(total_not_allocated > 0)
                 			{
                 				new_status = "Partially Assigned";
                 			}
                 			else
                 			{
                 				new_status = "Fully Assigned";
                 			}
                 			receipt.Total_Amount_Allocated=total_allocated;
                 			receipt.Total_Amount_Not_Allocated=total_not_allocated;
                 			receipt.Payment_Receipt_Voucher_Status=new_status;
                 			updated_count = updated_count + 1;
                 		}		catch (backfill_error)
                 		{
                 			failed_count = failed_count + 1;
                 			error_row = Map();
                 			error_row.put("payment_receipt_voucher_id",receipt.ID);
                 			error_row.put("payment_receipt_number",ifnull(receipt.Payment_Receipt_Number,""));
                 			error_row.put("message",backfill_error.toString());
                 			failure_details.add(error_row);
                 		}
                 	}
                 	result.put("ok",failed_count == 0);
                 	result.put("message","Unassigned Payment Receipt Voucher totals backfilled.");
                 	result.put("start_from",start_from);
                 	result.put("next_start",start_from + loaded_count);
                 	result.put("loaded",loaded_count);
                 	result.put("updated",updated_count);
                 	result.put("failed",failed_count);
                 	result.put("failure_details",failure_details);
                 	info result;
                 	return result;
                 }
				 map backfillSalesVoucherLookup()
                 {
                 	result = Map();
                 	start_from = 0;
                 	batch_size = 1000;
                 	end_at = start_from + batch_size - 1;
                 	loaded_count = 0;
                 	updated_count = 0;
                 	blank_reference_count = 0;
                 	not_found_count = 0;
                 	not_unpaid_count = 0;
                 	failed_count = 0;
                 	not_found_details = List();
                 	not_unpaid_details = List();
                 	failure_details = List();
                 	// Only load Sales Voucher rows whose lookup is empty
                 	for each  receipt_det in Payment_Receipt_Details[ID != 0 && Sales_Voucher == null && Payment_Document == "Sales Voucher"] range from start_from to end_at
                 	{
                 		loaded_count = loaded_count + 1;
                 		match_value = ifnull(receipt_det.Display_Name_Invoice_Voucher,"").trim();
                 		if(match_value == "")
                 		{
                 			blank_reference_count = blank_reference_count + 1;
                 			continue;
                 		}
                 		try 
                 		{
                 			sales_rec = Sales_Voucher[Sales_Voucher_Number == match_value];
                 			if(sales_rec.ID == null)
                 			{
                 				not_found_count = not_found_count + 1;
                 				not_found_row = Map();
                 				not_found_row.put("payment_receipt_detail_id",receipt_det.ID);
                 				not_found_row.put("sales_voucher_number",match_value);
                 				not_found_row.put("reason","Sales Voucher not found.");
                 				not_found_details.add(not_found_row);
                 				continue;
                 			}
                 			// Only backfill unpaid Sales Vouchers
                 			payment_status = ifnull(sales_rec.Payment_Status,"").trim();
                 			if(payment_status != "Draft" && payment_status != "Unpaid")
                 			{
                 				not_unpaid_count = not_unpaid_count + 1;
                 				status_row = Map();
                 				status_row.put("payment_receipt_detail_id",receipt_det.ID);
                 				status_row.put("sales_voucher_number",match_value);
                 				status_row.put("payment_status",payment_status);
                 				status_row.put("reason","Sales Voucher is not Unpaid.");
                 				not_unpaid_details.add(status_row);
                 				continue;
                 			}
                 			// Fill the empty lookup
                 			receipt_det.Sales_Voucher=sales_rec.ID;
                 			// Copy Sales Voucher details
                 			receipt_det.Payment_Document="Sales Voucher";
                 			receipt_det.Display_Name_Invoice_Voucher=ifnull(sales_rec.Sales_Voucher_Number,"");
                 			receipt_det.Customer=ifnull(sales_rec.Display_Name_Customer,"");
                 			receipt_det.Amount_Due=ifnull(sales_rec.Balance_Due,0.0);
                 			calculated_balance = ifnull(receipt_det.Amount_Due,0.0) - ifnull(receipt_det.Amount_Allocated,0.0);
                 			if(calculated_balance < 0)
                 			{
                 				calculated_balance = 0.0;
                 			}
                 			receipt_det.Balance_Due=calculated_balance;
                 			// Copy Delivery Note only when required
                 			if(sales_rec.Customer != null && sales_rec.Customer.Delivery_Note_Required == true)
                 			{
                 				receipt_det.Delivery_Note=sales_rec.Delivery_Note;
                 			}
                 			else
                 			{
                 				receipt_det.Delivery_Note=null;
                 			}
                 			updated_count = updated_count + 1;
                 		}		catch (backfill_error)
                 		{
                 			failed_count = failed_count + 1;
                 			error_row = Map();
                 			error_row.put("payment_receipt_detail_id",receipt_det.ID);
                 			error_row.put("sales_voucher_number",match_value);
                 			error_row.put("message",backfill_error.toString());
                 			failure_details.add(error_row);
                 		}
                 	}
                 	result.put("ok",failed_count == 0);
                 	result.put("message","Empty unpaid Sales Voucher lookups backfilled.");
                 	result.put("start_from",start_from);
                 	result.put("next_start",start_from + loaded_count);
                 	result.put("loaded",loaded_count);
                 	result.put("updated",updated_count);
                 	result.put("blank_reference",blank_reference_count);
                 	result.put("not_found",not_found_count);
                 	result.put("not_unpaid",not_unpaid_count);
                 	result.put("failed",failed_count);
                 	result.put("not_found_details",not_found_details);
                 	result.put("not_unpaid_details",not_unpaid_details);
                 	result.put("failure_details",failure_details);
                 	info result;
                 	return result;
                 }
				 map backfillTruckMovementServiceProcessingBatch()
                 {
                 	result = Map();
                 	// =====================================================
                 	// CHANGE THIS FOR EACH BATCH
                 	// 0, 500, 1000, 1500...
                 	// =====================================================
                 	start_from = 0;
                 	batch_size = 500;
                 	end_at = start_from + batch_size - 1;
                 	loaded = 0;
                 	processed = 0;
                 	skipped = 0;
                 	failed = 0;
                 	piece_rate_processed = 0;
                 	piece_rate_rows_updated = 0;
                 	piece_rate_bill_missing = 0;
                 	weigh_bridge_processed = 0;
                 	weigh_bridge_failed = 0;
                 	weigh_bridge_skipped = 0;
                 	labour_processed = 0;
                 	labour_failed = 0;
                 	descriptions_updated = 0;
                 	bills_recalculated = 0;
                 	failed_details = List();
                 	// =====================================================
                 	// GET HAMID ONCE FOR THIS BATCH
                 	// =====================================================
                 	hamid_employee_id = null;
                 	hamid_result = employee_management.employee.get_employee_by_display_name("Hamid Ssenoga - 50");
                 	if(hamid_result != null && ifnull(hamid_result.get("ok"),false) == true && hamid_result.get("employee_id") != null)
                 	{
                 		hamid_employee_id = hamid_result.get("employee_id");
                 	}
                 	// =====================================================
                 	// LOAD TRUCK MOVEMENT VOUCHERS
                 	// =====================================================
                 	for each  rec in Truck_Movement_Voucher[Truck_Movement_Voucher_Status == "Delivered" || Truck_Movement_Voucher_Status == "Completed"] sort by ID asc range from start_from to end_at
                 	{
                 		loaded = loaded + 1;
                 		record_ready = false;
                 		record_failed = false;
                 		try 
                 		{
                 			// =================================================
                 			// A. BASIC VALUES
                 			// =================================================
                 			movement_date = zoho.currentdate;
                 			if(rec.Time_Start != null)
                 			{
                 				movement_date = rec.Time_Start.toDate();
                 			}
                 			employee_display = ifnull(rec.Display_Name_Employee,"").trim();
                 			movement_display = ifnull(rec.Display_Name_Voucher,"").trim();
                 			truck_movement_display = movement_display;
                 			if(rec.Line_Number != null)
                 			{
                 				if(truck_movement_display != "")
                 				{
                 					truck_movement_display = truck_movement_display + " - " + rec.Line_Number.toString();
                 				}
                 				else
                 				{
                 					truck_movement_display = rec.Line_Number.toString();
                 				}
                 			}
                 			// =================================================
                 			// B. DETECT SERVICES
                 			// =================================================
                 			has_piece_rate = false;
                 			has_weigh_bridge = false;
                 			for each  srv in rec.Services
                 			{
                 				if(srv.Service != null)
                 				{
                 					service_name = ifnull(srv.Service.Service_Name,"").trim();
                 					if(service_name == "Employee Piece Rate")
                 					{
                 						has_piece_rate = true;
                 					}
                 					if(service_name == "Weigh Bridge")
                 					{
                 						has_weigh_bridge = true;
                 					}
                 				}
                 			}
                 			// =================================================
                 			// C. EMPLOYEE PIECE RATE
                 			// =================================================
                 			if(has_piece_rate == true && rec.Voucher != null && rec.Voucher.Employee != null)
                 			{
                 				employee_id = rec.Voucher.Employee.ID;
                 				// =============================================
                 				// WEEK NUMBER
                 				// =============================================
                 				day_number = movement_date.getDayOfWeek();
                 				if(day_number == 1)
                 				{
                 					days_to_monday = -6;
                 				}
                 				else
                 				{
                 					days_to_monday = 2 - day_number;
                 				}
                 				week_date = movement_date.addDay(days_to_monday);
                 				week_number = week_date.getWeekOfYear();
                 				week_text = week_number.toString();
                 				if(week_number < 10)
                 				{
                 					week_text = "0" + week_text;
                 				}
                 				weekly_bill_number = week_date.getYear().toString() + " Week " + week_text;
                 				// =============================================
                 				// FIND EXISTING WEEKLY EMPLOYEE BILL
                 				// =============================================
                 				employee_weekly_bill = Bill[Employee_Vendor == employee_id && Bill_Number == weekly_bill_number && Bill_Type == "Employee Bill"];
                 				if(employee_weekly_bill.ID == null)
                 				{
                 					piece_rate_bill_missing = piece_rate_bill_missing + 1;
                 					record_failed = true;
                 					fail_map = Map();
                 					fail_map.put("Truck_Movement_Voucher_ID",rec.ID);
                 					fail_map.put("Voucher",truck_movement_display);
                 					fail_map.put("Reason","Employee Piece Rate weekly bill not found: " + weekly_bill_number);
                 					failed_details.add(fail_map);
                 				}
                 				else
                 				{
                 					piece_rate_rows = 0;
                 					// =========================================
                 					// LINK PIECE RATE SERVICE ROWS
                 					// =========================================
                 					for each  srv in rec.Services
                 					{
                 						if(srv.Service != null && ifnull(srv.Service.Service_Name,"").trim() == "Employee Piece Rate")
                 						{
                 							current_amount = round(ifnull(srv.Line_Total,0.0),2);
                 							srv.Bill=employee_weekly_bill.ID;
                 							srv.Display_Name_Bill=employee_display + " - " + weekly_bill_number;
                 							srv.Truck_Movement_Voucher=rec.ID;
                 							srv.Display_Name_Voucher=truck_movement_display;
                 							srv.Last_Synced_Group_ID=employee_weekly_bill.ID;
                 							srv.Last_Synced_Group_Amount=current_amount;
                 							piece_rate_rows = piece_rate_rows + 1;
                 							piece_rate_rows_updated = piece_rate_rows_updated + 1;
                 						}
                 					}
                 					if(piece_rate_rows > 0)
                 					{
                 						piece_rate_processed = piece_rate_processed + 1;
                 						record_ready = true;
                 					}
                 				}
                 			}
                 			// =================================================
                 			// D. WEIGH BRIDGE
                 			// =================================================
                 			if(has_weigh_bridge == true)
                 			{
                 				truck_plate = ifnull(rec.Number_Plate_Truck_Register,"").trim();
                 				if(rec.Time_Start == null)
                 				{
                 					weigh_bridge_failed = weigh_bridge_failed + 1;
                 					record_failed = true;
                 					fail_map = Map();
                 					fail_map.put("Truck_Movement_Voucher_ID",rec.ID);
                 					fail_map.put("Voucher",truck_movement_display);
                 					fail_map.put("Reason","Weigh Bridge failed: Time Start is empty.");
                 					failed_details.add(fail_map);
                 				}
                 				else if(truck_plate == "")
                 				{
                 					weigh_bridge_failed = weigh_bridge_failed + 1;
                 					record_failed = true;
                 					fail_map = Map();
                 					fail_map.put("Truck_Movement_Voucher_ID",rec.ID);
                 					fail_map.put("Voucher",truck_movement_display);
                 					fail_map.put("Reason","Weigh Bridge failed: Truck Number Plate is empty.");
                 					failed_details.add(fail_map);
                 				}
                 				else if(hamid_employee_id == null)
                 				{
                 					weigh_bridge_failed = weigh_bridge_failed + 1;
                 					record_failed = true;
                 					fail_map = Map();
                 					fail_map.put("Truck_Movement_Voucher_ID",rec.ID);
                 					fail_map.put("Voucher",truck_movement_display);
                 					fail_map.put("Reason","Hamid Ssenoga - 50 was not found.");
                 					failed_details.add(fail_map);
                 				}
                 				else
                 				{
                 					weigh_bridge_result = thisapp.services.recalculate_weekly_weigh_bridge(hamid_employee_id,rec.Time_Start.toDate(),truck_plate);
                 					info weigh_bridge_result;
                 					if(weigh_bridge_result != null && ifnull(weigh_bridge_result.get("ok"),false) == true)
                 					{
                 						weigh_bridge_processed = weigh_bridge_processed + 1;
                 						record_ready = true;
                 					}
                 					else
                 					{
                 						weigh_bridge_failed = weigh_bridge_failed + 1;
                 						record_failed = true;
                 						fail_map = Map();
                 						fail_map.put("Truck_Movement_Voucher_ID",rec.ID);
                 						fail_map.put("Voucher",truck_movement_display);
                 						if(weigh_bridge_result != null)
                 						{
                 							fail_map.put("Reason","Weigh Bridge recalculation failed: " + ifnull(weigh_bridge_result.get("message"),ifnull(weigh_bridge_result.get("msg"),"Unknown error")));
                 						}
                 						else
                 						{
                 							fail_map.put("Reason","Weigh Bridge recalculation returned null.");
                 						}
                 						failed_details.add(fail_map);
                 					}
                 				}
                 			}
                 			else
                 			{
                 				weigh_bridge_skipped = weigh_bridge_skipped + 1;
                 			}
                 			// =================================================
                 			// E. LABOUR RECALCULATION
                 			// =================================================
                 			if(rec.Voucher != null && rec.Voucher.Employee != null)
                 			{
                 				work_date = zoho.currentdate;
                 				if(rec.Time_Start != null)
                 				{
                 					work_date = rec.Time_Start.toDate();
                 				}
                 				employee_display_name = ifnull(rec.Display_Name_Employee,"").trim();
                 				labour_result = thisapp.labour.recalculate_truck_movement_labour(rec.Voucher.Employee.ID,employee_display_name,work_date);
                 				info labour_result;
                 				if(labour_result != null && ifnull(labour_result.get("ok"),false) == true)
                 				{
                 					labour_processed = labour_processed + 1;
                 					record_ready = true;
                 				}
                 				else
                 				{
                 					labour_failed = labour_failed + 1;
                 					record_failed = true;
                 					fail_map = Map();
                 					fail_map.put("Truck_Movement_Voucher_ID",rec.ID);
                 					fail_map.put("Voucher",truck_movement_display);
                 					if(labour_result != null)
                 					{
                 						fail_map.put("Reason","Labour recalculation failed: " + ifnull(labour_result.get("message"),ifnull(labour_result.get("msg"),"Unknown error")));
                 					}
                 					else
                 					{
                 						fail_map.put("Reason","Labour recalculation returned null.");
                 					}
                 					failed_details.add(fail_map);
                 				}
                 			}
                 			// =================================================
                 			// F. BUILD DESCRIPTION FOR ALL SERVICE DETAILS
                 			// =================================================
                 			truck_plate = ifnull(rec.Number_Plate_Truck_Register,"").trim();
                 			employee_display = ifnull(rec.Display_Name_Employee,"").trim();
                 			pickup_from = ifnull(rec.Pick_Up_From,"").trim();
                 			delivery_to = ifnull(rec.Delivery_To,"").trim();
                 			job_display = "";
                 			if(rec.Job != null)
                 			{
                 				job_name_text = ifnull(rec.Job.Job_Name,"").trim();
                 				job_number_text = ifnull(rec.Job.Job_No,"").trim();
                 				if(job_name_text != "")
                 				{
                 					job_display = job_name_text;
                 				}
                 				else
                 				{
                 					job_display = job_number_text;
                 				}
                 			}
                 			for each  srv in rec.Services
                 			{
                 				if(srv.Service != null)
                 				{
                 					description_text = "";
                 					if(movement_display != "")
                 					{
                 						description_text = "Truck Movement Voucher: " + movement_display;
                 					}
                 					else
                 					{
                 						description_text = "Truck Movement Voucher: " + rec.ID.toString();
                 					}
                 					if(rec.Line_Number != null)
                 					{
                 						description_text = description_text + "\nMovement Line Number: " + rec.Line_Number.toString();
                 					}
                 					description_text = description_text + "\nMovement Date: " + movement_date.toString("dd-MMM-yyyy");
                 					if(job_display != "")
                 					{
                 						description_text = description_text + "\nJob: " + job_display;
                 					}
                 					if(truck_plate != "")
                 					{
                 						description_text = description_text + "\nTruck Number Plate: " + truck_plate;
                 					}
                 					if(employee_display != "")
                 					{
                 						description_text = description_text + "\nEmployee: " + employee_display;
                 					}
                 					if(pickup_from != "")
                 					{
                 						description_text = description_text + "\nPick Up From: " + pickup_from;
                 					}
                 					if(delivery_to != "")
                 					{
                 						description_text = description_text + "\nDelivery To: " + delivery_to;
                 					}
                 					srv.Description=description_text;
                 					descriptions_updated = descriptions_updated + 1;
                 					record_ready = true;
                 				}
                 			}
                 			// =================================================
                 			// G. COLLECT ALL BILLS LINKED TO THESE SERVICES
                 			// =================================================
                 			bill_ids_to_recalculate = List();
                 			for each  srv in rec.Services
                 			{
                 				if(srv.Bill != null)
                 				{
                 					bill_id = srv.Bill.ID;
                 					if(!bill_ids_to_recalculate.contains(bill_id))
                 					{
                 						bill_ids_to_recalculate.add(bill_id);
                 					}
                 				}
                 			}
                 			// =================================================
                 			// H. RECALCULATE BILL TOTAL FROM ACTUAL DETAILS
                 			// =================================================
                 			for each  bill_id in bill_ids_to_recalculate
                 			{
                 				service_total = 0.0;
                 				bill_detail_total = 0.0;
                 				// =============================================
                 				// SERVICE DETAILS
                 				// =============================================
                 				service_rows = Service_Details[Bill == bill_id];
                 				for each  sd in service_rows
                 				{
                 					service_total = service_total + round(ifnull(sd.Line_Total,0.0),2);
                 				}
                 				service_total = round(service_total,2);
                 				// =============================================
                 				// BILL DETAILS
                 				// =============================================
                 				bill_detail_rows = Bill_Details[Bill == bill_id];
                 				for each  bd in bill_detail_rows
                 				{
                 					bill_detail_total = bill_detail_total + round(ifnull(bd.Line_Total,0.0),2);
                 				}
                 				bill_detail_total = round(bill_detail_total,2);
                 				// =============================================
                 				// GRAND TOTAL
                 				// =============================================
                 				grand_bill_total = round(service_total + bill_detail_total,2);
                 				// =============================================
                 				// UPDATE BILL HEADER
                 				// =============================================
                 				bill_rec = Bill[ID == bill_id];
                 				if(bill_rec.ID != null)
                 				{
                 					bill_rec.Services_Total=service_total;
                 					bill_rec.Bill_Total=grand_bill_total;
                 					bill_rec.Total_Amount=grand_bill_total;
                 					bill_rec.Amount_Due=grand_bill_total;
                 					amount_paid = ifnull(bill_rec.Amount_Paid,0.0);
                 					new_balance = grand_bill_total - amount_paid;
                 					if(new_balance < 0)
                 					{
                 						new_balance = 0.0;
                 					}
                 					bill_rec.Balance_Due=round(new_balance,2);
                 					if(amount_paid <= 0)
                 					{
                 						bill_rec.Payment_Status="Not Paid";
                 					}
                 					else if(new_balance <= 0)
                 					{
                 						bill_rec.Payment_Status="Paid";
                 					}
                 					else
                 					{
                 						bill_rec.Payment_Status="Partially Paid";
                 					}
                 					bills_recalculated = bills_recalculated + 1;
                 				}
                 			}
                 			// =================================================
                 			// I. RESULT FOR RECORD
                 			// =================================================
                 			if(record_failed == true)
                 			{
                 				failed = failed + 1;
                 			}
                 			if(record_ready == true)
                 			{
                 				processed = processed + 1;
                 			}
                 			else if(record_failed == false)
                 			{
                 				skipped = skipped + 1;
                 			}
                 		}		catch (e)
                 		{
                 			failed = failed + 1;
                 			fail_map = Map();
                 			fail_map.put("Truck_Movement_Voucher_ID",rec.ID);
                 			fail_map.put("Voucher",ifnull(rec.Display_Name_Voucher,""));
                 			fail_map.put("Reason",e.toString());
                 			failed_details.add(fail_map);
                 		}
                 	}
                 	// =====================================================
                 	// BATCH RESULT
                 	// =====================================================
                 	result.put("start_from",start_from);
                 	result.put("end_at",end_at);
                 	result.put("batch_size",batch_size);
                 	result.put("loaded",loaded);
                 	result.put("processed",processed);
                 	result.put("skipped",skipped);
                 	result.put("failed",failed);
                 	result.put("piece_rate_processed",piece_rate_processed);
                 	result.put("piece_rate_rows_updated",piece_rate_rows_updated);
                 	result.put("piece_rate_bill_missing",piece_rate_bill_missing);
                 	result.put("weigh_bridge_processed",weigh_bridge_processed);
                 	result.put("weigh_bridge_failed",weigh_bridge_failed);
                 	result.put("weigh_bridge_skipped",weigh_bridge_skipped);
                 	result.put("labour_processed",labour_processed);
                 	result.put("labour_failed",labour_failed);
                 	result.put("descriptions_updated",descriptions_updated);
                 	result.put("bills_recalculated",bills_recalculated);
                 	result.put("failed_details",failed_details);
                 	if(loaded < batch_size)
                 	{
                 		result.put("last_batch",true);
                 	}
                 	else
                 	{
                 		result.put("last_batch",false);
                 	}
                 	info result;
                 	return result;
                 }
				 map backfill_missing_credit_sales_invoice_details()
                 {
                 	result = Map();
                 	failed_records = List();
                 	skipped_records = List();
                 	processed_count = 0;
                 	generated_voucher_count = 0;
                 	generated_line_count = 0;
                 	already_existing_count = 0;
                 	skipped_count = 0;
                 	failed_count = 0;
                 	target_site = "Gomba Site - ARA075";
                 	batch_size = 500;
                 	/*
                 	 * Count Invoice Details already created for eligible
                 	 * Gomba Site Sand Sales vouchers.
                 	 */
                 	existing_invoice_count = Invoice_Details[Source_Form == "Sales Voucher" && Sales_Voucher.Sales_Type == "Sand Sales" && Sales_Voucher.Display_Name_Site == target_site].count();
                 	start_index = existing_invoice_count + 1;
                 	end_index = start_index + batch_size - 1;
                 	/*
                 	 * Select only eligible Payment Receipt Details records.
                 	 *
                 	 * A Credit Note and Sales Voucher must both be present.
                 	 */
                 	payment_receipt_batch = Payment_Receipt_Details[Payment_Type == "Credit" && Payment_Document == "Sales Voucher" && Sales_Voucher != null && Credit_Note_Voucher != null && Sales_Voucher.Sales_Type == "Sand Sales" && Sales_Voucher.Display_Name_Site == target_site] sort by ID range from start_index to end_index;
                 	for each  payment_record in payment_receipt_batch
                 	{
                 		processed_count = processed_count + 1;
                 		try 
                 		{
                 			sales_voucher_id = payment_record.Sales_Voucher.ID;
                 			voucher_reference = ifnull(payment_record.Sales_Voucher.Sales_Voucher_Number,sales_voucher_id.toString());
                 			/*
                 			 * If this Sales Voucher is already found in
                 			 * Invoice Details, do not create it again.
                 			 */
                 			existing_invoice = Invoice_Details[Source_Record_ID == sales_voucher_id && Source_Form == "Sales Voucher"];
                 			if(existing_invoice.count() > 0)
                 			{
                 				already_existing_count = already_existing_count + 1;
                 			}
                 			else
                 			{
                 				sv2 = Sales_Voucher[ID == sales_voucher_id];
                 				if(sv2.ID == null)
                 				{
                 					skipped_count = skipped_count + 1;
                 					skipped_records.add("Payment Receipt Details record " + payment_record.ID.toString() + " skipped. Sales Voucher was not found.");
                 				}
                 				else
                 				{
                 					credit_note_no = "";
                 					if(payment_record.Credit_Note_Voucher != null)
                 					{
                 						credit_note_no = ifnull(payment_record.Credit_Note_Voucher.Credit_Note_Number,"");
                 					}
                 					/*
                 					 * Do not create Invoice Details without an
                 					 * actual Credit Note number.
                 					 */
                 					if(credit_note_no == "")
                 					{
                 						skipped_count = skipped_count + 1;
                 						skipped_records.add("Sales Voucher " + voucher_reference + " skipped. Credit Note number is empty.");
                 					}
                 					else
                 					{
                 						delivery_note_no = "";
                 						if(sv2.Delivery_Note != null)
                 						{
                 							delivery_note_no = ifnull(sv2.Delivery_Note.Delivery_Note_Number,"");
                 						}
                 						number_plate_text = ifnull(sv2.Display_Name_Number_Plate,"");
                 						voucher_date_text = "";
                 						if(sv2.Sales_Voucher_Date != null)
                 						{
                 							voucher_date_text = sv2.Sales_Voucher_Date.toString("dd-MMM-yyyy");
                 						}
                 						line_no = 1;
                 						product_count = 0;
                 						lines_created_for_voucher = 0;
                 						for each  p in sv2.Product_Details
                 						{
                 							product_count = product_count + 1;
                 							/*
                 							 * Additional line-level protection.
                 							 */
                 							existing_line = Invoice_Details[Source_Record_ID == sv2.ID && Source_Form == "Sales Voucher" && Line_Number == line_no];
                 							if(existing_line.count() == 0)
                 							{
                 								item_text = "Number Plate: " + number_plate_text + "\nItem: " + ifnull(p.Display_Name_Item,"") + "\nQuantity: " + ifnull(p.Quantity,0).toString() + "\nUnit Of Measure: " + ifnull(p.Display_Name_Base_Unit_Of_Measure,"");
                 								details_text = "Sales Voucher Number: " + ifnull(sv2.Sales_Voucher_Number,"") + "\nSales Voucher Date: " + voucher_date_text + "\nCustomer: " + ifnull(sv2.Display_Name_Customer,"") + "\nCredit Note: " + credit_note_no;
                 								if(delivery_note_no != "")
                 								{
                 									details_text = details_text + "\nDelivery Note: " + delivery_note_no;
                 								}
                 								new_invoice_detail_id = insert into Invoice_Details
                 								[
                 									Sales_Voucher=sv2.ID
                 									Display_Name_Voucher=ifnull(sv2.Sales_Voucher_Number,"")
                 									Details_Date=zoho.currentdate
                 									Line_Number=line_no
                 									Item=item_text
                 									Details=details_text
                 									Quantity=1
                 									Site=sv2.Display_Name_Site
                 									Account=sv2.Display_Name_Site
                 									Source_Record_ID=sv2.ID
                 									Source_Form="Sales Voucher"
                 									Invoice_Details_Status="Draft"
                 									Added_User=zoho.loginuser
                 								];
                 								if(new_invoice_detail_id != null)
                 								{
                 									generated_line_count = generated_line_count + 1;
                 									lines_created_for_voucher = lines_created_for_voucher + 1;
                 								}
                 								else
                 								{
                 									failed_count = failed_count + 1;
                 									failed_records.add("Sales Voucher " + voucher_reference + ", line " + line_no.toString() + ": insert returned no ID.");
                 								}
                 							}
                 							line_no = line_no + 1;
                 						}
                 						if(lines_created_for_voucher > 0)
                 						{
                 							generated_voucher_count = generated_voucher_count + 1;
                 						}
                 						else if(product_count == 0)
                 						{
                 							skipped_count = skipped_count + 1;
                 							skipped_records.add("Sales Voucher " + voucher_reference + " skipped. No Product Details were found.");
                 						}
                 					}
                 				}
                 			}
                 		}		catch (e)
                 		{
                 			failed_count = failed_count + 1;
                 			failed_records.add("Payment Receipt Details record " + payment_record.ID.toString() + ": " + e.toString());
                 		}
                 	}
                 	/*
                 	 * Count the total eligible Payment Receipt Details records.
                 	 */
                 	total_eligible_payment_records = Payment_Receipt_Details[Payment_Type == "Credit" && Payment_Document == "Sales Voucher" && Sales_Voucher != null && Credit_Note_Voucher != null && Sales_Voucher.Sales_Type == "Sand Sales" && Sales_Voucher.Display_Name_Site == target_site].count();
                 	/*
                 	 * This is informational only.
                 	 *
                 	 * Do not use this count to calculate remaining payment
                 	 * records because several payment records may point to
                 	 * Sales Vouchers already represented in Invoice Details.
                 	 */
                 	updated_invoice_count = Invoice_Details[Source_Form == "Sales Voucher" && Sales_Voucher.Sales_Type == "Sand Sales" && Sales_Voucher.Display_Name_Site == target_site].count();
                 	/*
                 	 * Calculate how far the Payment Receipt Details report
                 	 * has been scanned.
                 	 */
                 	scanned_through_index = end_index;
                 	if(scanned_through_index > total_eligible_payment_records)
                 	{
                 		scanned_through_index = total_eligible_payment_records;
                 	}
                 	/*
                 	 * Calculate unscanned Payment Receipt Details positions.
                 	 */
                 	remaining_count = total_eligible_payment_records - scanned_through_index;
                 	if(remaining_count < 0)
                 	{
                 		remaining_count = 0;
                 	}
                 	has_more = remaining_count > 0;
                 	result.put("ok",failed_count == 0);
                 	result.put("site",target_site);
                 	result.put("batch_size",batch_size);
                 	result.put("start_index",start_index);
                 	result.put("end_index",end_index);
                 	result.put("scanned_through_index",scanned_through_index);
                 	result.put("processed_count",processed_count);
                 	result.put("generated_voucher_count",generated_voucher_count);
                 	result.put("generated_line_count",generated_line_count);
                 	result.put("already_existing_count",already_existing_count);
                 	result.put("skipped_count",skipped_count);
                 	result.put("failed_count",failed_count);
                 	result.put("total_eligible_payment_records",total_eligible_payment_records);
                 	result.put("existing_invoice_count",updated_invoice_count);
                 	result.put("remaining_count",remaining_count);
                 	result.put("has_more",has_more);
                 	result.put("skipped_records",skipped_records);
                 	result.put("failed_records",failed_records);
                 	if(failed_count > 0)
                 	{
                 		result.put("message","Backfill batch completed with failures. Review failed_records.");
                 	}
                 	else if(skipped_count > 0)
                 	{
                 		result.put("message","Backfill batch completed. Some records were skipped.");
                 	}
                 	else if(has_more == true)
                 	{
                 		result.put("message","Backfill batch completed successfully. Execute the function again.");
                 	}
                 	else
                 	{
                 		result.put("message","Backfill completed. All eligible Gomba Site credit Sales Vouchers were checked.");
                 	}
                 	info result;
                 	return result;
                 }
				 map backfill_sales_voucher_stock_fields()
                 {
                 	result = Map();
                 	failed_records = List();
                 	processed_count = 0;
                 	updated_count = 0;
                 	failed_count = 0;
                 	// Fully populated reference voucher: FA705
                 	reference_voucher_id = 4273992000008395147;
                 	reference_voucher = Sales_Voucher[ID == reference_voucher_id];
                 	if(reference_voucher.ID == null)
                 	{
                 		result.put("ok",false);
                 		result.put("message","Reference Sales Voucher FA705 was not found.");
                 		return result;
                 	}
                 	if(reference_voucher.Item == null || reference_voucher.Unit_Of_Measure == null || reference_voucher.Store == null || reference_voucher.Store_Item_Stock == null)
                 	{
                 		result.put("ok",false);
                 		result.put("message","FA705 is missing Item, Unit Of Measure, Store, or Store Item Stock.");
                 		return result;
                 	}
                 	// Sales Voucher.Item is a Product Price Register lookup.
                 	reference_product_price_id = reference_voucher.Item;
                 	// Store Item Stock.Item is the actual Items Register lookup required
                 	// by Store Management stock functions.
                 	reference_stock_item_id = reference_voucher.Store_Item_Stock.Item;
                 	reference_uom_id = reference_voucher.Unit_Of_Measure;
                 	reference_store_id = reference_voucher.Store;
                 	reference_display_item = ifnull(reference_voucher.Display_Name_Item,"Washed Sand - BMT-0016");
                 	reference_display_uom = ifnull(reference_voucher.Display_Name_Unit_Of_Measure,"Cubic meters");
                 	reference_display_store = ifnull(reference_voucher.Display_Name_Store,"Gomba Drager Area 1 Sand Pit A - ARB861");
                 	if(reference_stock_item_id == null)
                 	{
                 		result.put("ok",false);
                 		result.put("message","FA705 Store Item Stock does not contain an Item lookup.");
                 		return result;
                 	}
                 	ledger_cache = Map();
                 	quantity_cache = Map();
                 	// Process 200 incomplete vouchers per execution.
                 	target_vouchers = Sales_Voucher[Sales_Type == "Sand Sales" && Item == null || Unit_Of_Measure == null || Store_Item_Stock == null || Store == null || Quantity_Available == null || Display_Name_Item == "" || Display_Name_Unit_Of_Measure == "" || Display_Name_Store == ""] sort by ID range from 1 to 500;
                 	for each  sales_voucher in target_vouchers
                 	{
                 		processed_count = processed_count + 1;
                 		try 
                 		{
                 			record_changed = false;
                 			// -------------------------------------------------
                 			// 1. PRODUCT PRICE REGISTER ITEM
                 			// -------------------------------------------------
                 			if(sales_voucher.Item == null)
                 			{
                 				sales_voucher.Item=reference_product_price_id;
                 				record_changed = true;
                 			}
                 			if(ifnull(sales_voucher.Display_Name_Item,"").trim() == "")
                 			{
                 				sales_voucher.Display_Name_Item=reference_display_item;
                 				record_changed = true;
                 			}
                 			// -------------------------------------------------
                 			// 2. UNIT OF MEASURE
                 			// -------------------------------------------------
                 			if(sales_voucher.Unit_Of_Measure == null)
                 			{
                 				sales_voucher.Unit_Of_Measure=reference_uom_id;
                 				record_changed = true;
                 			}
                 			if(ifnull(sales_voucher.Display_Name_Unit_Of_Measure,"").trim() == "")
                 			{
                 				sales_voucher.Display_Name_Unit_Of_Measure=reference_display_uom;
                 				record_changed = true;
                 			}
                 			// -------------------------------------------------
                 			// 3. STORE
                 			// Preserve Clean Sand Pit or any existing Store.
                 			// Only blank stores receive the FA705 store.
                 			// -------------------------------------------------
                 			store_id = sales_voucher.Store;
                 			if(store_id == null)
                 			{
                 				store_id = reference_store_id;
                 				sales_voucher.Store=store_id;
                 				record_changed = true;
                 			}
                 			if(ifnull(sales_voucher.Display_Name_Store,"").trim() == "")
                 			{
                 				sales_voucher.Display_Name_Store=reference_display_store;
                 				record_changed = true;
                 			}
                 			// -------------------------------------------------
                 			// 4. STORE ITEM STOCK AND AVAILABLE QUANTITY
                 			// -------------------------------------------------
                 			if(reference_stock_item_id != null && store_id != null)
                 			{
                 				cache_key = reference_stock_item_id.toString() + "|" + store_id.toString();
                 				// Resolve the correct ledger for the voucher's Store.
                 				if(sales_voucher.Store_Item_Stock == null)
                 				{
                 					ledger_id = ledger_cache.get(cache_key);
                 					if(ledger_id == null)
                 					{
                 						ledger_id = store_management.get_or_create_store_item_stock(reference_stock_item_id,store_id,"New");
                 						if(ledger_id != null)
                 						{
                 							ledger_cache.put(cache_key,ledger_id);
                 						}
                 					}
                 					if(ledger_id == null)
                 					{
                 						throw "No Store Item Stock found for Item " + reference_stock_item_id.toString() + " and Store " + store_id.toString() + ".";
                 					}
                 					sales_voucher.Store_Item_Stock=ledger_id;
                 					record_changed = true;
                 				}
                 				// Fill Quantity Available only when blank.
                 				if(sales_voucher.Quantity_Available == null)
                 				{
                 					quantity_available = quantity_cache.get(cache_key);
                 					if(quantity_available == null)
                 					{
                 						stock_summary = store_management.stock.get_stock_summary(reference_stock_item_id,store_id,"New");
                 						quantity_available = ifnull(stock_summary.get("store_stock"),0.0);
                 						quantity_cache.put(cache_key,quantity_available);
                 					}
                 					sales_voucher.Quantity_Available=quantity_available;
                 					record_changed = true;
                 				}
                 			}
                 			if(record_changed == true)
                 			{
                 				updated_count = updated_count + 1;
                 			}
                 		}		catch (e)
                 		{
                 			failed_count = failed_count + 1;
                 			failed_records.add("ID " + sales_voucher.ID.toString() + ": " + e.toString());
                 		}
                 	}
                 	remaining_count = Sales_Voucher[Sales_Type == "Sand Sales" && Item == null || Unit_Of_Measure == null || Store_Item_Stock == null || Store == null || Quantity_Available == null || Display_Name_Item == "" || Display_Name_Unit_Of_Measure == "" || Display_Name_Store == ""].count();
                 	result.put("ok",failed_count == 0);
                 	result.put("processed_count",processed_count);
                 	result.put("updated_count",updated_count);
                 	result.put("failed_count",failed_count);
                 	result.put("remaining_count",remaining_count);
                 	result.put("failed_records",failed_records);
                 	if(remaining_count == 0)
                 	{
                 		result.put("message","Backfill completed. No incomplete Sand Sales vouchers remain.");
                 	}
                 	else
                 	{
                 		result.put("message","Batch completed. Run the function again.");
                 	}
                 	info result;
                 	return result;
                 }
				 void create_asset_issue_from_asset_management_payload(map payload)
                 {
                 	info "Masaka Sites payload received: " + payload;
                 	source_id = payload.get("Source_Record_ID");
                 	if(source_id == null)
                 	{
                 		info "Masaka Sites sync stopped: Source_Record_ID is null";
                 		return;
                 	}
                 	source_id = source_id.toLong();
                 	existing = Asset_Issues[Source_Record_ID == source_id && Source_Form == "Asset Management Asset Issues"];
                 	if(existing.count() > 0)
                 	{
                 		info "Masaka Sites sync skipped: issue already exists for Source_Record_ID " + source_id;
                 		return;
                 	}
                 	insert into Asset_Issues
                 	[
                 		Source_Record_ID=source_id
                 		Source_Form="Asset Management Asset Issues"
                 		Issue_Number=payload.get("Issue_Number")
                 		Asset=payload.get("Asset")
                 		Display_Name_Asset=payload.get("Display_Name_Asset")
                 		Current_Site=payload.get("Current_Site")
                 		Current_Custodian=payload.get("Current_Custodian")
                 		Odometer_Reading=payload.get("Odometer_Reading")
                 		Reported_Date=payload.get("Reported_Date")
                 		Issue=payload.get("Issue")
                 		Issue_Description=payload.get("Issue_Description")
                 		Severity=payload.get("Severity")
                 		Issue_Status="Open"
                 		Added_User=zoho.loginuser
                 	]
                 	info "Masaka Sites sync inserted issue: " + payload.get("Issue_Number");
                 }
				 void fix_sales_vouchers_from_invoice(int invoice_id)
                 {
                 	inv = Invoice[ID == invoice_id];
                 	if(inv.ID == null)
                 	{
                 		return;
                 	}
                 	total_invoice_paid = 0.0;
                 	for each  p in Payment_Receipt_Details[Payment_Document == "Invoice" && Invoice == inv.ID]
                 	{
                 		total_invoice_paid = total_invoice_paid + ifnull(p.Amount_Allocated,0.0);
                 	}
                 	remaining_paid = total_invoice_paid;
                 	for each  d in Invoice_Details[Invoice == inv.ID && Source_Form == "Sales Voucher"]
                 	{
                 		sv = Sales_Voucher[ID == d.Source_Record_ID];
                 		if(sv.ID != null)
                 		{
                 			sv_total = ifnull(sv.Grand_Total,0.0);
                 			current_credit = ifnull(sv.Amount_Credited,0.0);
                 			pay_for_this_sv = 0.0;
                 			if(remaining_paid >= sv_total)
                 			{
                 				pay_for_this_sv = sv_total;
                 			}
                 			else if(remaining_paid > 0)
                 			{
                 				pay_for_this_sv = remaining_paid;
                 			}
                 			remaining_paid = remaining_paid - pay_for_this_sv;
                 			bal = sv_total - pay_for_this_sv - current_credit;
                 			if(bal < 0)
                 			{
                 				bal = 0.0;
                 			}
                 			update Sales_Voucher[ID == sv.ID]
                 			[
                 				Amount_Paid=pay_for_this_sv
                 				Amount_Credited=current_credit
                 				Balance_Due=bal
                 				Payment_Status=if(bal <= 0,"Paid",if(pay_for_this_sv > 0,"Partially Paid",if(current_credit > 0,"Partially Credited","Unpaid")))
                 			];
                 		}
                 	}
                 }
				 map generate_missing_sales_voucher_details()
                 {
                 	result = Map();
                 	failed_records = List();
                 	skipped_records = List();
                 	item_cache = Map();
                 	processed_count = 0;
                 	generated_count = 0;
                 	already_existing_count = 0;
                 	skipped_count = 0;
                 	failed_count = 0;
                 	target_site = "Gomba Site - ARA075";
                 	batch_size = 100;
                 	/*
                 	 * Count existing Gomba Site Sand Sales detail lines.
                 	 *
                 	 * Because the system uses one detail line per Sand Sales
                 	 * voucher, this count becomes the automatic cursor.
                 	 */
                 	existing_gomba_details = Sales_Voucher_Details[Sales_Voucher.Sales_Type == "Sand Sales" && Sales_Voucher.Display_Name_Site == target_site].count();
                 	start_index = existing_gomba_details + 1;
                 	end_index = start_index + batch_size - 1;
                 	/*
                 	 * Retrieve the next Gomba Site batch.
                 	 *
                 	 * Basic mandatory fields are included in the criteria so
                 	 * the function does not spend its batch on clearly
                 	 * incomplete vouchers.
                 	 */
                 	voucher_batch = Sales_Voucher[Sales_Type == "Sand Sales" && Display_Name_Site == target_site && Item != null && Store_Item_Stock != null && Store != null && Unit_Of_Measure != null] sort by ID range from start_index to end_index;
                 	for each  sales_voucher in voucher_batch
                 	{
                 		processed_count = processed_count + 1;
                 		try 
                 		{
                 			voucher_reference = ifnull(sales_voucher.Sales_Voucher_Number,sales_voucher.ID.toString());
                 			/*
                 			 * Safety check against accidental duplicates.
                 			 */
                 			existing_lines = Sales_Voucher_Details[Sales_Voucher == sales_voucher.ID];
                 			if(existing_lines.count() > 0)
                 			{
                 				already_existing_count = already_existing_count + 1;
                 			}
                 			else
                 			{
                 				actual_item_id = null;
                 				/*
                 				 * Sales_Voucher.Item points to
                 				 * Product_Price_Register.
                 				 */
                 				if(sales_voucher.Item != null)
                 				{
                 					product_price_key = sales_voucher.Item.toString();
                 					actual_item_id = item_cache.get(product_price_key);
                 					if(actual_item_id == null)
                 					{
                 						product_price_records = Product_Price_Register[ID == sales_voucher.Item];
                 						if(product_price_records.count() > 0)
                 						{
                 							product_price_rec = product_price_records;
                 							if(product_price_rec.Item != null)
                 							{
                 								actual_item_id = product_price_rec.Item;
                 								item_cache.put(product_price_key,actual_item_id);
                 							}
                 						}
                 					}
                 				}
                 				if(actual_item_id == null)
                 				{
                 					skipped_count = skipped_count + 1;
                 					skipped_records.add("Voucher " + voucher_reference + " skipped. Product Price Register has no linked inventory Item.");
                 				}
                 				else
                 				{
                 					quantity_value = ifnull(sales_voucher.Truck_CBM,0.0);
                 					unit_price_value = ifnull(sales_voucher.Rate_per_CBM,0.0);
                 					line_total_value = round(quantity_value * unit_price_value,2);
                 					new_detail_id = insert into Sales_Voucher_Details
                 					[
                 						Sales_Voucher=sales_voucher.ID
                 						Display_Name_Sales_Voucher=ifnull(sales_voucher.Sales_Voucher_Number,"")
                 						Line_Number=1
                 						Store_Item_Stock=sales_voucher.Store_Item_Stock
                 						Store=sales_voucher.Store
                 						Display_Name_Store=ifnull(sales_voucher.Display_Name_Store,"")
                 						Quantity_Available=ifnull(sales_voucher.Quantity_Available,0.0)
                 						Item=actual_item_id
                 						Display_Name_Item=ifnull(sales_voucher.Display_Name_Item,"")
                 						Base_Unit_Of_Measure=sales_voucher.Unit_Of_Measure
                 						Display_Name_Base_Unit_Of_Measure=ifnull(sales_voucher.Display_Name_Unit_Of_Measure,"")
                 						Quantity=quantity_value
                 						Quantity_in_Base_Unit_Of_Measure=quantity_value
                 						Quantity_Issued_in_Base_Unit_Of_Measure=0.0
                 						Quantity_Not_Issued_in_Base_Unit_Of_Measure=quantity_value
                 						Issue_Status="Not Issued"
                 						Unit_Price=unit_price_value
                 						Line_Total=line_total_value
                 						Tax_Amount=0.0
                 						Added_User=zoho.loginuser
                 					];
                 					if(new_detail_id != null)
                 					{
                 						generated_count = generated_count + 1;
                 					}
                 					else
                 					{
                 						failed_count = failed_count + 1;
                 						failed_records.add("Voucher " + voucher_reference + ": insert returned no ID.");
                 					}
                 				}
                 			}
                 		}		catch (e)
                 		{
                 			failed_count = failed_count + 1;
                 			voucher_reference = ifnull(sales_voucher.Sales_Voucher_Number,sales_voucher.ID.toString());
                 			failed_records.add("Voucher " + voucher_reference + ": " + e.toString());
                 		}
                 	}
                 	total_eligible_gomba_vouchers = Sales_Voucher[Sales_Type == "Sand Sales" && Display_Name_Site == target_site && Item != null && Store_Item_Stock != null && Store != null && Unit_Of_Measure != null].count();
                 	updated_existing_gomba_details = Sales_Voucher_Details[Sales_Voucher.Sales_Type == "Sand Sales" && Sales_Voucher.Display_Name_Site == target_site].count();
                 	remaining_count = total_eligible_gomba_vouchers - updated_existing_gomba_details;
                 	if(remaining_count < 0)
                 	{
                 		remaining_count = 0;
                 	}
                 	has_more = remaining_count > 0;
                 	result.put("ok",failed_count == 0);
                 	result.put("site",target_site);
                 	result.put("batch_size",batch_size);
                 	result.put("start_index",start_index);
                 	result.put("end_index",end_index);
                 	result.put("processed_count",processed_count);
                 	result.put("generated_count",generated_count);
                 	result.put("already_existing_count",already_existing_count);
                 	result.put("skipped_count",skipped_count);
                 	result.put("failed_count",failed_count);
                 	result.put("total_eligible_gomba_vouchers",total_eligible_gomba_vouchers);
                 	result.put("existing_gomba_details",updated_existing_gomba_details);
                 	result.put("remaining_count",remaining_count);
                 	result.put("has_more",has_more);
                 	result.put("skipped_records",skipped_records);
                 	result.put("failed_records",failed_records);
                 	if(failed_count > 0)
                 	{
                 		result.put("message","Batch completed with failures. Review failed_records.");
                 	}
                 	else if(skipped_count > 0)
                 	{
                 		result.put("message","Batch completed. Some Product Price records have no linked inventory Item.");
                 	}
                 	else if(has_more == true)
                 	{
                 		result.put("message","Batch completed successfully. Execute the function again for the next Gomba Site batch.");
                 	}
                 	else
                 	{
                 		result.put("message","Backfill completed. All eligible Gomba Site Sand Sales vouchers have details.");
                 	}
                 	info result;
                 	return result;
                 }
				 string Generate_Voucher_Number(int documentKeyId)
                 {
                 	dk = Document_Key[ID == documentKeyId];
                 	if(dk == null)
                 	{
                 		return "";
                 	}
                 	// ---- Prefix: EXACTLY 3 letters ----
                 	prefix = ifnull(dk.Prefix,"").trim().toUpperCase();
                 	if(!prefix.matches("^[A-Z]{3}$"))
                 	{
                 		return "";
                 	}
                 	// ---- Next number ----
                 	nextNo = ifnull(dk.Next_Number,0);
                 	if(nextNo <= 0)
                 	{
                 		nextNo = 1;
                 	}
                 	// ---- HARD STOP at 999 ----
                 	if(nextNo > 999)
                 	{
                 		return "LIMIT_REACHED";
                 	}
                 	// ---- Pad to 3 digits ----
                 	numStr = nextNo.toString();
                 	if(numStr.length() == 1)
                 	{
                 		numStr = "00" + numStr;
                 	}
                 	else if(numStr.length() == 2)
                 	{
                 		numStr = "0" + numStr;
                 	}
                 	voucherNo = prefix + numStr;
                 	// ---- Increment counter ----
                 	dk.Next_Number=nextNo + 1;
                 	return voucherNo;
                 }
				 map rebuildDraftSalesVoucherPaymentStatuses()
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	batch_size = 200;
                 	processed_count = 0;
                 	success_count = 0;
                 	error_count = 0;
                 	last_processed_id = 0;
                 	try 
                 	{
                 		// =====================================================
                 		// FETCH NEXT 200 DRAFT SALES VOUCHERS
                 		// =====================================================
                 		draft_sales_vouchers = Sales_Voucher[Payment_Status == "Draft"] sort by ID range from 0 to 199;
                 		records_found = draft_sales_vouchers.count();
                 		// =====================================================
                 		// NO DRAFT RECORDS REMAIN
                 		// =====================================================
                 		if(records_found == 0)
                 		{
                 			response.put("ok",true);
                 			response.put("completed",true);
                 			response.put("message","No Draft Sales Vouchers remain.");
                 			response.put("processed_count",0);
                 			response.put("success_count",0);
                 			response.put("error_count",0);
                 			return response;
                 		}
                 		// =====================================================
                 		// PROCESS DRAFT RECORDS
                 		// =====================================================
                 		for each  sales_voucher_rec in draft_sales_vouchers
                 		{
                 			processed_count = processed_count + 1;
                 			last_processed_id = sales_voucher_rec.ID;
                 			try 
                 			{
                 				result = thisapp.rebuildSalesVoucherPaymentStatus(sales_voucher_rec.ID);
                 				if(ifnull(result.get("ok"),false) == true)
                 				{
                 					success_count = success_count + 1;
                 				}
                 				else
                 				{
                 					error_count = error_count + 1;
                 					info "Sales Voucher rebuild failed.";
                 					info "Sales Voucher ID: " + sales_voucher_rec.ID;
                 					info result;
                 				}
                 			}			catch (record_error)
                 			{
                 				error_count = error_count + 1;
                 				info "Sales Voucher rebuild error.";
                 				info "Sales Voucher ID: " + sales_voucher_rec.ID;
                 				info record_error.toString();
                 			}
                 		}
                 		// =====================================================
                 		// COUNT REMAINING DRAFT RECORDS
                 		// =====================================================
                 		remaining_draft_count = Sales_Voucher[Payment_Status == "Draft"].count();
                 		// =====================================================
                 		// RETURN BATCH SUMMARY
                 		// =====================================================
                 		response.put("ok",true);
                 		response.put("completed",remaining_draft_count == 0);
                 		response.put("message","Draft Sales Voucher batch completed.");
                 		response.put("batch_size",batch_size);
                 		response.put("records_found",records_found);
                 		response.put("processed_count",processed_count);
                 		response.put("success_count",success_count);
                 		response.put("error_count",error_count);
                 		response.put("remaining_draft_count",remaining_draft_count);
                 		response.put("last_processed_id",last_processed_id);
                 	}	catch (e)
                 	{
                 		response.put("message","Unable to process the Draft Sales Voucher batch.");
                 		response.put("error",e.toString());
                 		response.put("processed_count",processed_count);
                 		response.put("success_count",success_count);
                 		response.put("error_count",error_count);
                 	}
                 	return response;
                 }
				 map rebuildSalesVoucherPaymentStatus(INT sales_voucher_id)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	response.put("sales_voucher_id",sales_voucher_id);
                 	try 
                 	{
                 		// =====================================================
                 		// GET SALES VOUCHER
                 		// =====================================================
                 		sales_voucher_rec = Sales_Voucher[ID == sales_voucher_id];
                 		if(sales_voucher_rec.ID == null)
                 		{
                 			response.put("message","Sales Voucher was not found.");
                 			return response;
                 		}
                 		// =====================================================
                 		// CANCELLED VOUCHER
                 		// =====================================================
                 		if(ifnull(sales_voucher_rec.Cancel_Voucher,false) == true)
                 		{
                 			sales_voucher_rec.Amount_Paid=0.0;
                 			sales_voucher_rec.Amount_Credited=0.0;
                 			sales_voucher_rec.Balance_Due=0.0;
                 			sales_voucher_rec.Payment_Status="Cancelled";
                 			response.put("ok",true);
                 			response.put("message","Cancelled Sales Voucher updated.");
                 			response.put("payment_status","Cancelled");
                 			return response;
                 		}
                 		// =====================================================
                 		// INITIALISE TOTALS
                 		// =====================================================
                 		grand_total = ifnull(sales_voucher_rec.Grand_Total,0.0);
                 		total_amount_paid = 0.0;
                 		total_amount_credited = 0.0;
                 		payment_detail_count = 0;
                 		// =====================================================
                 		// GET PAYMENT RECEIPT DETAILS
                 		// =====================================================
                 		payment_details = Payment_Receipt_Details[Sales_Voucher == sales_voucher_id && Payment_Document == "Sales Voucher"];
                 		for each  payment_detail_rec in payment_details
                 		{
                 			total_amount_paid = total_amount_paid + ifnull(payment_detail_rec.Amount_Allocated,0.0);
                 			total_amount_credited = total_amount_credited + ifnull(payment_detail_rec.Amount_Credited,0.0);
                 			payment_detail_count = payment_detail_count + 1;
                 		}
                 		// =====================================================
                 		// PREVENT NEGATIVE PAYMENT VALUES
                 		// =====================================================
                 		if(total_amount_paid < 0)
                 		{
                 			total_amount_paid = 0.0;
                 		}
                 		if(total_amount_credited < 0)
                 		{
                 			total_amount_credited = 0.0;
                 		}
                 		// =====================================================
                 		// CALCULATE BALANCE
                 		// =====================================================
                 		total_settled = total_amount_paid + total_amount_credited;
                 		balance_due = grand_total - total_settled;
                 		// Allow for very small decimal rounding differences.
                 		if(balance_due > -0.01 && balance_due < 0.01)
                 		{
                 			balance_due = 0.0;
                 		}
                 		// A Sales Voucher should not normally display a
                 		// negative outstanding balance.
                 		if(balance_due < 0)
                 		{
                 			balance_due = 0.0;
                 		}
                 		// =====================================================
                 		// DETERMINE PAYMENT STATUS
                 		// =====================================================
                 		payment_status = "Unpaid";
                 		if(grand_total <= 0)
                 		{
                 			payment_status = "Paid";
                 		}
                 		else if(balance_due <= 0)
                 		{
                 			// Fully settled using credit only.
                 			if(total_amount_paid <= 0 && total_amount_credited > 0)
                 			{
                 				payment_status = "Credit";
                 			}
                 			else
                 			{
                 				// Fully settled by cash or a combination of
                 				// cash and credit.
                 				payment_status = "Paid";
                 			}
                 		}
                 		else if(total_amount_paid > 0)
                 		{
                 			// Cash has priority where both cash and credit
                 			// have partially settled the voucher.
                 			payment_status = "Partially Paid";
                 		}
                 		else if(total_amount_credited > 0)
                 		{
                 			payment_status = "Partially Credited";
                 		}
                 		else
                 		{
                 			payment_status = "Unpaid";
                 		}
                 		// =====================================================
                 		// UPDATE SALES VOUCHER
                 		// =====================================================
                 		sales_voucher_rec.Amount_Paid=total_amount_paid;
                 		sales_voucher_rec.Amount_Credited=total_amount_credited;
                 		sales_voucher_rec.Balance_Due=balance_due;
                 		sales_voucher_rec.Payment_Status=payment_status;
                 		// =====================================================
                 		// RETURN RESULT
                 		// =====================================================
                 		response.put("ok",true);
                 		response.put("message","Sales Voucher payment totals and status rebuilt successfully.");
                 		response.put("sales_voucher_number",sales_voucher_rec.Sales_Voucher_Number);
                 		response.put("grand_total",grand_total);
                 		response.put("amount_paid",total_amount_paid);
                 		response.put("amount_credited",total_amount_credited);
                 		response.put("total_settled",total_settled);
                 		response.put("balance_due",balance_due);
                 		response.put("payment_status",payment_status);
                 		response.put("payment_detail_count",payment_detail_count);
                 		response.put("ok",true);
                 	}	catch (e)
                 	{
                 		response.put("message",e.toString());
                 	}
                 	return response;
                 }
				 void rebuildSalesVoucherPaymentStatusBatch(INT start_index, INT batch_size)
                 {
                 	// =====================================================
                 	// VALIDATE INPUTS
                 	// =====================================================
                 	if(start_index == null || start_index < 0)
                 	{
                 		start_index = 0;
                 	}
                 	if(batch_size == null || batch_size <= 0)
                 	{
                 		batch_size = 100;
                 	}
                 	// Keep the batch controlled.
                 	if(batch_size > 200)
                 	{
                 		batch_size = 200;
                 	}
                 	end_index = start_index + batch_size - 1;
                 	// =====================================================
                 	// INITIALISE COUNTERS
                 	// =====================================================
                 	processed_count = 0;
                 	success_count = 0;
                 	error_count = 0;
                 	// =====================================================
                 	// FETCH SALES VOUCHERS
                 	// =====================================================
                 	sales_voucher_records = Sales_Voucher[ID != 0] sort by ID range from start_index to end_index;
                 	// =====================================================
                 	// PROCESS BATCH
                 	// =====================================================
                 	for each  sales_voucher_rec in sales_voucher_records
                 	{
                 		processed_count = processed_count + 1;
                 		try 
                 		{
                 			result = thisapp.rebuildSalesVoucherPaymentStatus(sales_voucher_rec.ID);
                 			if(ifnull(result.get("ok"),false) == true)
                 			{
                 				success_count = success_count + 1;
                 			}
                 			else
                 			{
                 				error_count = error_count + 1;
                 				info "Sales Voucher rebuild failed:";
                 				info result;
                 			}
                 		}		catch (e)
                 		{
                 			error_count = error_count + 1;
                 			info "Sales Voucher ID: " + sales_voucher_rec.ID;
                 			info "Batch error: " + e.toString();
                 		}
                 	}
                 	// =====================================================
                 	// BATCH SUMMARY
                 	// =====================================================
                 	info "========================================";
                 	info "SALES VOUCHER PAYMENT REBUILD BATCH";
                 	info "Start index: " + start_index;
                 	info "End index: " + end_index;
                 	info "Batch size requested: " + batch_size;
                 	info "Records processed: " + processed_count;
                 	info "Successful: " + success_count;
                 	info "Errors: " + error_count;
                 	info "Next start index: " + (end_index + 1);
                 	info "========================================";
                 }
				 void recalculatePaymentVoucher(int voucherID)
                 {
                 	voucher = Payment_Made_Voucher[ID == voucherID];
                 	if(voucher.ID == null)
                 	{
                 		return;
                 	}
                 	total_allocated = 0.0;
                 	for each  md in Payment_Made_Details[Payment_Made_Voucher == voucher.ID]
                 	{
                 		total_allocated = total_allocated + ifnull(md.Amount_Allocated,0.0);
                 	}
                 	total_paid = ifnull(voucher.Total_Amount_Paid,0.0);
                 	not_allocated = total_paid - total_allocated;
                 	if(not_allocated < 0)
                 	{
                 		not_allocated = 0.0;
                 	}
                 	voucher.Total_Amount_Allocated=round(total_allocated,2);
                 	voucher.Total_Amount_Not_Allocated=round(not_allocated,2);
                 	if(total_allocated <= 0)
                 	{
                 		voucher.Payment_Made_Voucher_Status="Unassigned";
                 	}
                 	else if(not_allocated > 0)
                 	{
                 		voucher.Payment_Made_Voucher_Status="Partially Assigned";
                 	}
                 	else
                 	{
                 		voucher.Payment_Made_Voucher_Status="Assigned";
                 	}
                 }
				 void recalculateVoucherMaterialsCost(int voucher_id)
                 {
                 	if(voucher_id == null)
                 	{
                 		return;
                 	}
                 	v = Voucher_Register[ID == voucher_id];
                 	if(v.ID == null)
                 	{
                 		return;
                 	}
                 	total_cost = 0.0;
                 	// Item Issuing Details
                 	item_rows = Voucher_Issuing_Details[Voucher == voucher_id];
                 	for each  r in item_rows
                 	{
                 		total_cost = total_cost + ifnull(r.Quantity,0.0) * ifnull(r.Cost,0.0);
                 	}
                 	// Employee Issuing Details
                 	emp_rows = Employee_Issuing_Details[Voucher == voucher_id];
                 	for each  er in emp_rows
                 	{
                 		total_cost = total_cost + ifnull(er.Quantity,0.0) * ifnull(er.Cost,0.0);
                 	}
                 	v.Voucher_Cost=round(total_cost,2);
                 }
				 map syncVoucherFromEmployee(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	if(payload == null)
                 	{
                 		resp.put("message","Payload is null.");
                 		return resp;
                 	}
                 	concrete_id = payload.get("Concrete_Record_ID");
                 	if(concrete_id == null)
                 	{
                 		resp.put("message","Concrete Record ID missing.");
                 		return resp;
                 	}
                 	rec = Voucher_Register[ID == concrete_id];
                 	if(rec.ID == null)
                 	{
                 		resp.put("message","Concrete voucher not found.");
                 		return resp;
                 	}
                 	date_time_out_val = null;
                 	end_time_val = null;
                 	manager_time_val = null;
                 	time_checked_val = null;
                 	hr_time_checked_val = null;
                 	if(ifnull(payload.get("Date_Time_Out"),"") != "")
                 	{
                 		date_time_out_val = payload.get("Date_Time_Out").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("End_Time"),"") != "")
                 	{
                 		end_time_val = payload.get("End_Time").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Manager_Time"),"") != "")
                 	{
                 		manager_time_val = payload.get("Manager_Time").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Time_Checked"),"") != "")
                 	{
                 		time_checked_val = payload.get("Time_Checked").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	if(ifnull(payload.get("Hr_Time_Checked"),"") != "")
                 	{
                 		hr_time_checked_val = payload.get("Hr_Time_Checked").toDateTime("dd-MMM-yyyy HH:mm:ss");
                 	}
                 	voucher_status_val = ifnull(payload.get("Voucher_Status"),"");
                 	rec.Date_Time_Out=date_time_out_val;
                 	rec.Hours_Worked=payload.get("Hours_Worked");
                 	if(voucher_status_val != "")
                 	{
                 		rec.Voucher_Status=voucher_status_val;
                 	}
                 	rec.End_Time=end_time_val;
                 	rec.Odometer_End=payload.get("Odometer_End");
                 	rec.Fuel_End_Level=payload.get("Fuel_End_Level");
                 	rec.Manager_Time=manager_time_val;
                 	rec.Cancel_Voucher=payload.get("Cancel_Voucher");
                 	rec.Cancellation_Reason=ifnull(payload.get("Cancellation_Reason"),"");
                 	rec.Seen=payload.get("Seen");
                 	rec.Reason_for_not_Seen=ifnull(payload.get("Reason_for_not_Seen"),"");
                 	rec.Time_Checked=time_checked_val;
                 	rec.Hr_Time_Checked=hr_time_checked_val;
                 	resp.put("ok",true);
                 	resp.put("message","Concrete voucher updated from Employee Management.");
                 	resp.put("id",rec.ID);
                 	return resp;
                 }
				 map updateAssetIssueStatusFromAssetManagement(map p)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	source_record_id_text = ifnull(p.get("Source_Record_ID"),"").toString().trim();
                 	source_form = ifnull(p.get("Source_Form"),"").toString().trim();
                 	if(source_record_id_text == "")
                 	{
                 		resp.put("message","Source_Record_ID is required.");
                 		return resp;
                 	}
                 	if(source_form != "Masaka Site Management - Asset Issues")
                 	{
                 		resp.put("message","The Asset Issue is not linked to Masaka Site Management.");
                 		return resp;
                 	}
                 	source_record_id = source_record_id_text.toLong();
                 	freedom_issue = Asset_Issues[ID == source_record_id];
                 	if(freedom_issue.ID == null)
                 	{
                 		resp.put("message","The corresponding Masaka Site Management Asset Issue was not found.");
                 		return resp;
                 	}
                 	freedom_issue.Issue_Status="Open";
                 	resp.put("ok",true);
                 	resp.put("message","Masaka Site Management Asset Issue changed to Open.");
                 	resp.put("Source_Record_ID",freedom_issue.ID);
                 	return resp;
                 }
				 map updatePaymentMadeStatusFromPayment(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	resp.put("message","");
                 	if(payload == null)
                 	{
                 		resp.put("message","Payload is null.");
                 		return resp;
                 	}
                 	source_record_id = ifnull(payload.get("Source_Record_ID"),0).toLong();
                 	voucher_number = ifnull(payload.get("Voucher_Number"),"");
                 	new_status = ifnull(payload.get("Payment_Made_Voucher_Status"),"");
                 	if(source_record_id == 0 && voucher_number == "")
                 	{
                 		resp.put("message","Source Record ID or Voucher Number missing.");
                 		return resp;
                 	}
                 	if(new_status == "")
                 	{
                 		resp.put("message","Payment Made Voucher Status missing.");
                 		return resp;
                 	}
                 	found = false;
                 	if(source_record_id != 0)
                 	{
                 		for each  rec in Payment_Made_Voucher[ID == source_record_id]
                 		{
                 			found = true;
                 			rec.Payment_Made_Voucher_Status=new_status;
                 			resp.put("ok",true);
                 			resp.put("message","Payment Made Voucher status updated.");
                 			resp.put("id",rec.ID);
                 			resp.put("status",new_status);
                 			break;
                 		}
                 	}
                 	if(found == false && voucher_number != "")
                 	{
                 		for each  rec in Payment_Made_Voucher[Payment_Made_Number == voucher_number]
                 		{
                 			found = true;
                 			rec.Payment_Made_Voucher_Status=new_status;
                 			resp.put("ok",true);
                 			resp.put("message","Payment Made Voucher status updated.");
                 			resp.put("id",rec.ID);
                 			resp.put("status",new_status);
                 			break;
                 		}
                 	}
                 	if(found == false)
                 	{
                 		resp.put("message","Payment Made Voucher not found.");
                 	}
                 	return resp;
                 }
				 map updatePaymentReceiptStatusFromPayment(map payload)
                 {
                 	resp = Map();
                 	resp.put("ok",false);
                 	source_record_id = payload.get("Source_Record_ID");
                 	new_status = ifnull(payload.get("Payment_Receipt_Voucher_Status"),"");
                 	if(source_record_id == null)
                 	{
                 		resp.put("message","Source Record ID is missing.");
                 		return resp;
                 	}
                 	if(new_status != "Pending" && new_status != "Confirmed")
                 	{
                 		resp.put("message","Invalid Payment Receipt Voucher status.");
                 		return resp;
                 	}
                 	receipt_rec = Payment_Receipt_Voucher[ID == source_record_id];
                 	if(receipt_rec.ID == null)
                 	{
                 		resp.put("message","Payment Receipt Voucher was not found.");
                 		return resp;
                 	}
                 	receipt_rec.Payment_Receipt_Voucher_Status=new_status;
                 	resp.put("ok",true);
                 	resp.put("status",new_status);
                 	resp.put("message","Payment Receipt Voucher status updated.");
                 	return resp;
                 }
				 void updateVoucherQuantityCreated(int voucher_id)
                 {
                 	v = Voucher_Register[ID == voucher_id];
                 	if(v.ID != null)
                 	{
                 		total_qty_received = 0.0;
                 		if(v.Display_Name_Voucher_Type == "Stock Receiving Note" || v.Display_Name_Voucher_Type == "Stock Bundling Note")
                 		{
                 			for each  rec in v.Employee_Receiving_Details
                 			{
                 				total_qty_received = total_qty_received + ifnull(rec.Quantity,0.0);
                 			}
                 		}
                 		v.Quantity_Created=total_qty_received;
                 	}
                 }
				 void update_invoice_payment(int invoice_id)
                 {
                 	total_allocated = 0.0;
                 	for each  rec in Payment_Receipt_Details[Invoice == invoice_id]
                 	{
                 		total_allocated = total_allocated + ifnull(rec.Amount_Allocated,0.0);
                 	}
                 	inv = Invoice[ID == invoice_id];
                 	if(inv.ID != null)
                 	{
                 		inv.Amount_Paid=total_allocated;
                 		inv.Balance_Due=ifnull(inv.Grand_Total,0.0) - total_allocated;
                 		if(inv.Balance_Due < 0)
                 		{
                 			inv.Balance_Due=0.0;
                 		}
                 		if(total_allocated <= 0)
                 		{
                 			inv.Payment_Status="Not Paid";
                 		}
                 		else if(inv.Balance_Due > 0)
                 		{
                 			inv.Payment_Status="Partially Paid";
                 		}
                 		else
                 		{
                 			inv.Payment_Status="Paid";
                 		}
                 	}
                 }
				 void update_voucher_status(BIGINT voucher_id, STRING new_status)
                 {
                 	voucher_rec = Voucher_Register[ID == voucher_id];
                 	if(voucher_rec.count() > 0)
                 	{
                 		voucher_rec.Voucher_Status=new_status;
                 	}
                 }
				 float asset_calc.asset_calc_grand_total(float parts_total, float labour_total)
                 {
                 	p = ifnull(parts_total,0.0);
                 	l = ifnull(labour_total,0.0);
                 	return round(p + l,2);
                 }
				 float asset_calc.asset_calc_labour_total(list parts_rows)
                 {
                 	total = 0.0;
                 	for each  rmap in parts_rows
                 	{
                 		qty = ifnull(rmap.get("Quantity"),0.0);
                 		rate = ifnull(rmap.get("Unit_Cost"),0.0);
                 		total = total + qty * rate;
                 	}
                 	return round(total,2);
                 }
				 float asset_calc.asset_calc_line_total(float base_qty, float base_rate)
                 {
                 	q = ifnull(base_qty,0.0);
                 	r = ifnull(base_rate,0.0);
                 	if(q < 0)
                 	{
                 		q = 0;
                 	}
                 	if(r < 0)
                 	{
                 		r = 0;
                 	}
                 	return (q * r).round(2);
                 }
				 float asset_calc.asset_calc_parts_total(list parts_rows)
                 {
                 	total = 0.0;
                 	for each  rmap in parts_rows
                 	{
                 		item_val = rmap.get("Item");
                 		qty_base = ifnull(rmap.get("Quantity In Base Unit"),0.0);
                 		base_rate = ifnull(rmap.get("Unit Cost"),0.0);
                 		if(item_val != null && qty_base > 0 && base_rate >= 0)
                 		{
                 			total = total + qty_base * base_rate;
                 		}
                 	}
                 	return total.round(2);
                 }
				 void asset_issues.asset_issues_update_summary(bigint issue_id)
                 {
                 	if(issue_id == null)
                 	{
                 		return;
                 	}
                 	issue_rec = Asset_Issues[ID == issue_id];
                 	if(issue_rec.ID == null)
                 	{
                 		return;
                 	}
                 	work_order_task_count = 0;
                 	labour_total = 0.0;
                 	parts_total = 0.0;
                 	total_service_task_cost = 0.0;
                 	tasks = Work_Order_Tasks[Issue == issue_id];
                 	for each  t in tasks
                 	{
                 		work_order_task_count = work_order_task_count + 1;
                 		labour_total = labour_total + ifnull(t.Labour_Total,0.0);
                 		parts_total = parts_total + ifnull(t.Parts_Total,0.0);
                 		total_service_task_cost = total_service_task_cost + ifnull(t.Grand_Total,0.0);
                 	}
                 	issue_rec.Number_Of_Work_Order_Tasks=work_order_task_count;
                 	issue_rec.Labour_Total=round(labour_total,2);
                 	issue_rec.Parts_Total=round(parts_total,2);
                 	issue_rec.Total_Service_Task_Cost=round(total_service_task_cost,2);
                 }
				 map audit.getLoginAuditInfo()
                 {
                 	info = Map();
                 	info.put("name",zoho.loginuser);
                 	info.put("email",zoho.loginuserid);
                 	// role is optional (in case you add it later)
                 	try 
                 	{
                 		info.put("role",thisapp.permissions.roleForUser(zoho.loginuserid));
                 	}	catch (e)
                 	{
                 		info.put("role",thisapp.permissions.loginUserProfile());
                 	}
                 	return info;
                 }
				 void bill.update_parts_consumables_status(int bill_detail_id)
                 {
                 	// =====================================================
                 	// 1) VALIDATE BILL DETAIL ID
                 	// =====================================================
                 	if(bill_detail_id == null || bill_detail_id <= 0)
                 	{
                 		info "Bill Detail ID is required.";
                 		return;
                 	}
                 	// =====================================================
                 	// 2) LOAD BILL DETAILS RECORD
                 	// =====================================================
                 	bd = Bill_Details[ID == bill_detail_id];
                 	if(bd.ID == null)
                 	{
                 		info "Bill Details record was not found.";
                 		return;
                 	}
                 	// =====================================================
                 	// 3) ONLY RUN WHEN PARTS & CONSUMABLES IS SELECTED
                 	// =====================================================
                 	if(bd.Parts_Consumables == null)
                 	{
                 		info "No Parts & Consumables selected. Nothing to update.";
                 		return;
                 	}
                 	// =====================================================
                 	// 4) LOAD PARTS & CONSUMABLES RECORD
                 	// =====================================================
                 	pc = Parts_Consumables[ID == bd.Parts_Consumables];
                 	if(pc.ID == null)
                 	{
                 		info "Parts & Consumables record was not found.";
                 		return;
                 	}
                 	// =====================================================
                 	// 5) UPDATE PARTS & CONSUMABLES STATUS
                 	// =====================================================
                 	if(bd.Bill != null)
                 	{
                 		pc.Item_Status="Billed";
                 	}
                 	else
                 	{
                 		pc.Item_Status="Issued";
                 	}
                 	info "Parts & Consumables ID: " + pc.ID;
                 	info "Parts & Consumables status: " + pc.Item_Status;
                 	// =====================================================
                 	// 6) UPDATE LINKED WORK ORDER TASK
                 	// =====================================================
                 	if(pc.Work_Order_Task_Number == null)
                 	{
                 		info "Parts & Consumables has no linked Work Order Task.";
                 		return;
                 	}
                 	wot = Work_Order_Tasks[ID == pc.Work_Order_Task_Number];
                 	if(wot.ID == null)
                 	{
                 		info "Linked Work Order Task was not found.";
                 		return;
                 	}
                 	info "Work Order Task ID: " + wot.ID;
                 	info "Work Order Task status before: " + wot.Work_Order_Task_Status;
                 	// Only move to Invoiced when the Bill is selected
                 	if(bd.Bill != null)
                 	{
                 		wot.Work_Order_Task_Status="Invoiced";
                 		info "Work Order Task updated to Invoiced.";
                 	}
                 	else
                 	{
                 		// Restore it when the Bill is removed
                 		if(wot.Work_Order_Task_Status == "Invoiced")
                 		{
                 			wot.Work_Order_Task_Status="Invoicing";
                 			info "Work Order Task restored to Invoicing.";
                 		}
                 	}
                 }
				 map billing.backfillEmployeeBillDetailsBatch()
                 {
                 	result = Map();
                 	// =====================================================
                 	// CHANGE THIS AFTER EACH SUCCESSFUL BATCH
                 	// 1, 51, 101, 151, 201...
                 	// =====================================================
                 	start_from = 7213;
                 	batch_size = 40;
                 	end_at = start_from + batch_size - 1;
                 	loaded = 0;
                 	repaired = 0;
                 	no_bill_required = 0;
                 	failed = 0;
                 	last_voucher_id = 0;
                 	failed_vouchers = List();
                 	vouchersToProcess = Voucher_Register[Employee != null && Date_Time_In != null] sort by ID asc range from start_from to end_at;
                 	for each  voucherRecord in vouchersToProcess
                 	{
                 		loaded = loaded + 1;
                 		last_voucher_id = voucherRecord.ID;
                 		try 
                 		{
                 			syncResult = thisapp.billing.syncEmployeeBilling(voucherRecord.ID);
                 			if(syncResult != null && ifnull(syncResult.get("ok"),false) == true)
                 			{
                 				if(ifnull(syncResult.get("bill_record_ready"),false) == true)
                 				{
                 					repaired = repaired + 1;
                 				}
                 				else
                 				{
                 					no_bill_required = no_bill_required + 1;
                 				}
                 			}
                 			else
                 			{
                 				failed = failed + 1;
                 				failure = Map();
                 				failure.put("Voucher_ID",voucherRecord.ID);
                 				failure.put("Voucher_Number",ifnull(voucherRecord.Voucher_Number,""));
                 				if(syncResult != null)
                 				{
                 					failure.put("Message",ifnull(syncResult.get("message"),"Synchronization failed."));
                 				}
                 				else
                 				{
                 					failure.put("Message","No response was returned.");
                 				}
                 				failed_vouchers.add(failure);
                 			}
                 		}		catch (syncError)
                 		{
                 			failed = failed + 1;
                 			failure = Map();
                 			failure.put("Voucher_ID",voucherRecord.ID);
                 			failure.put("Voucher_Number",ifnull(voucherRecord.Voucher_Number,""));
                 			failure.put("Error",syncError.toString());
                 			failed_vouchers.add(failure);
                 		}
                 	}
                 	result.put("ok",true);
                 	result.put("message","Employee Bill Details repair batch completed.");
                 	result.put("start_from",start_from);
                 	result.put("end_at",end_at);
                 	result.put("batch_size",batch_size);
                 	result.put("loaded",loaded);
                 	result.put("repaired",repaired);
                 	result.put("no_bill_required",no_bill_required);
                 	result.put("failed",failed);
                 	result.put("last_voucher_id",last_voucher_id);
                 	result.put("next_start_from",start_from + batch_size);
                 	result.put("last_batch",loaded < batch_size);
                 	result.put("failed_vouchers",failed_vouchers);
                 	info result;
                 	return result;
                 }
				 map billing.backfillEmployeeBillTotalsBatch()
                 {
                 	result = Map();
                 	// =====================================================
                 	// CHANGE THIS FOR EACH BATCH
                 	// First batch:  1
                 	// Second batch: 201
                 	// Third batch:  401
                 	// =====================================================
                 	start_from = 501;
                 	batch_size = 500;
                 	end_at = start_from + batch_size - 1;
                 	loaded = 0;
                 	updated = 0;
                 	failed = 0;
                 	failed_bills = List();
                 	billsToProcess = Bill[Bill_Type == "Employee Bill"] sort by ID asc range from start_from to end_at;
                 	for each  billRecord in billsToProcess
                 	{
                 		loaded = loaded + 1;
                 		try 
                 		{
                 			totalResult = thisapp.billing.recalculateBillTotals(billRecord.ID);
                 			if(totalResult != null && ifnull(totalResult.get("ok"),false) == true)
                 			{
                 				updated = updated + 1;
                 			}
                 			else
                 			{
                 				failed = failed + 1;
                 				failure = Map();
                 				failure.put("Bill_ID",billRecord.ID);
                 				failure.put("Bill_Number",ifnull(billRecord.Bill_Number,""));
                 				failure.put("Response",totalResult);
                 				failed_bills.add(failure);
                 			}
                 		}		catch (totalError)
                 		{
                 			failed = failed + 1;
                 			failure = Map();
                 			failure.put("Bill_ID",billRecord.ID);
                 			failure.put("Bill_Number",ifnull(billRecord.Bill_Number,""));
                 			failure.put("Error",totalError.toString());
                 			failed_bills.add(failure);
                 		}
                 	}
                 	result.put("ok",true);
                 	result.put("message","Employee Bill totals batch completed.");
                 	result.put("start_from",start_from);
                 	result.put("end_at",end_at);
                 	result.put("batch_size",batch_size);
                 	result.put("loaded",loaded);
                 	result.put("updated",updated);
                 	result.put("failed",failed);
                 	result.put("failed_bills",failed_bills);
                 	result.put("next_start_from",start_from + batch_size);
                 	result.put("last_batch",loaded < batch_size);
                 	info result;
                 	return result;
                 }
				 map billing.getEmployeeBillPeriod(date work_date, string payment_type)
                 {
                 	result = Map();
                 	billDate = null;
                 	billNumber = "";
                 	// ============================================================
                 	// WEEKLY PAYMENT
                 	//
                 	// Bill Number = ACTUAL WEEK WORKED
                 	// Bill Date   = MONDAY AFTER THAT WEEK
                 	//
                 	// Example:
                 	// Work: 03-Aug-2026 to 09-Aug-2026
                 	// Bill Number: 2026 Week 32
                 	// Bill Date: 10-Aug-2026
                 	// ============================================================
                 	if(payment_type == "Weekly Payment")
                 	{
                 		dayNum = work_date.getDayOfWeek();
                 		if(dayNum == 1)
                 		{
                 			// Sunday -> Monday was 6 days earlier
                 			daysToMonday = -6;
                 		}
                 		else
                 		{
                 			daysToMonday = 2 - dayNum;
                 		}
                 		// Monday of ACTUAL work week
                 		currentWeekMonday = work_date.addDay(daysToMonday);
                 		// Thursday determines ISO week-year correctly
                 		// This handles year boundaries such as:
                 		// 29-Dec-2025 -> 04-Jan-2026 = 2026 Week 01
                 		workWeekThursday = currentWeekMonday.addDay(3);
                 		weekNo = workWeekThursday.getWeekOfYear();
                 		weekYear = workWeekThursday.getYear();
                 		weekTxt = weekNo.toString();
                 		if(weekNo < 10)
                 		{
                 			weekTxt = "0" + weekTxt;
                 		}
                 		// Bill Number represents ACTUAL WORK WEEK
                 		billNumber = weekYear.toString() + " Week " + weekTxt;
                 		// Bill Date is NEXT Monday
                 		billDate = currentWeekMonday.addDay(7);
                 	}
                 	// ============================================================
                 	// MONTHLY PAYMENT
                 	//
                 	// Bill Number = ACTUAL MONTH WORKED
                 	// Bill Date   = 1ST OF FOLLOWING MONTH
                 	//
                 	// Example:
                 	// Work: August 2026
                 	// Bill Number: 2026 Month 08
                 	// Bill Date: 01-Sep-2026
                 	// ============================================================
                 	if(payment_type == "Monthly Payment")
                 	{
                 		workMonthTxt = work_date.toString("MM");
                 		workYearTxt = work_date.toString("yyyy");
                 		// Bill Number represents actual month worked
                 		billNumber = workYearTxt + " Month " + workMonthTxt;
                 		// First day of actual work month
                 		currentMonthStart = work_date.toString("01-MM-yyyy").toDate("dd-MM-yyyy");
                 		// Bill Date = first day of following month
                 		billDate = currentMonthStart.addMonth(1);
                 	}
                 	// ============================================================
                 	// RETURN
                 	// ============================================================
                 	result.put("Bill_Date",billDate);
                 	result.put("Bill_Number",billNumber);
                 	return result;
                 }
				 map billing.recalculateBillTotals(int bill_id)
                 {
                 	totalResponse = Map();
                 	totalResponse.put("ok",false);
                 	totalResponse.put("bill_id",bill_id);
                 	if(bill_id == null)
                 	{
                 		totalResponse.put("message","Bill ID is required.");
                 		return totalResponse;
                 	}
                 	billRecord = Bill[ID == bill_id];
                 	if(billRecord.ID == null)
                 	{
                 		totalResponse.put("message","Bill record was not found.");
                 		return totalResponse;
                 	}
                 	recalculatedBillTotal = ifnull(Bill_Details[Bill == bill_id].sum(Line_Total),0.0);
                 	if(recalculatedBillTotal == 0)
                 	{
                 		fallbackBillTotal = 0.0;
                 		fallbackLines = Bill_Details[Bill == bill_id];
                 		for each  fallbackLine in fallbackLines
                 		{
                 			fallbackQuantity = ifnull(fallbackLine.Quantity,0.0);
                 			fallbackRate = ifnull(fallbackLine.Rate,0.0);
                 			fallbackBillTotal = fallbackBillTotal + fallbackQuantity * fallbackRate;
                 		}
                 		if(fallbackBillTotal > 0)
                 		{
                 			recalculatedBillTotal = fallbackBillTotal;
                 		}
                 	}
                 	servicesTotal = ifnull(billRecord.Services_Total,0.0);
                 	taxAmount = ifnull(billRecord.Tax_Amount,0.0);
                 	discountAmount = ifnull(billRecord.Discount_Amount,0.0);
                 	amountPaid = ifnull(billRecord.Amount_Paid,0.0);
                 	totalAmount = recalculatedBillTotal + servicesTotal + taxAmount - discountAmount;
                 	if(totalAmount < 0)
                 	{
                 		totalAmount = 0.0;
                 	}
                 	amountDue = totalAmount;
                 	balanceDue = amountDue - amountPaid;
                 	if(balanceDue < 0)
                 	{
                 		balanceDue = 0.0;
                 	}
                 	update Bill[ID == bill_id]
                 	[
                 		Bill_Total=recalculatedBillTotal
                 		Services_Total=servicesTotal
                 		Tax_Amount=taxAmount
                 		Discount_Amount=discountAmount
                 		Total_Amount=totalAmount
                 		Amount_Due=amountDue
                 		Amount_Paid=amountPaid
                 		Balance_Due=balanceDue
                 	];
                 	totalResponse.put("ok",true);
                 	totalResponse.put("message","Bill totals recalculated successfully.");
                 	totalResponse.put("bill_total",recalculatedBillTotal);
                 	totalResponse.put("services_total",servicesTotal);
                 	totalResponse.put("tax_amount",taxAmount);
                 	totalResponse.put("discount_amount",discountAmount);
                 	totalResponse.put("total_amount",totalAmount);
                 	totalResponse.put("amount_paid",amountPaid);
                 	totalResponse.put("balance_due",balanceDue);
                 	return totalResponse;
                 }
				 map billing.syncEmployeeBilling(int voucher_id)
                 {
                 	syncResponse = Map();
                 	syncResponse.put("ok",false);
                 	syncResponse.put("message","Employee billing was not processed.");
                 	bill_record_ready = false;
                 	voucherRecord = Voucher_Register[ID == voucher_id];
                 	if(voucherRecord.ID != null)
                 	{
                 		if(voucherRecord.Employee != null)
                 		{
                 			vDate = zoho.currentdate;
                 			if(voucherRecord.Date_Time_In != null)
                 			{
                 				vDate = voucherRecord.Date_Time_In.toDate();
                 			}
                 			sourceVal = ifnull(voucherRecord.Display_Name_Employee,"").trim();
                 			accountVal = ifnull(voucherRecord.Display_Name_Site,"").trim();
                 			siteVal = ifnull(voucherRecord.Display_Name_Site,"").trim();
                 			if(accountVal == "")
                 			{
                 				accountVal = "Unassigned Account";
                 			}
                 			employee_id = voucherRecord.Employee.ID;
                 			empName = ifnull(voucherRecord.Employee.Employee_Name,"").trim();
                 			empNumber = "";
                 			employee_number_value = 0;
                 			if(voucherRecord.Employee.Employee_Number != null)
                 			{
                 				empNumber = voucherRecord.Employee.Employee_Number.toString();
                 				employee_number_value = voucherRecord.Employee.Employee_Number;
                 			}
                 			displayVendorName = empName;
                 			if(empNumber != "")
                 			{
                 				displayVendorName = empName + " - " + empNumber;
                 			}
                 			billName = displayVendorName;
                 			dailyAllowance = 0.0;
                 			weeklyAllowance = 0.0;
                 			monthlySalary = 0.0;
                 			allowanceInput = Map();
                 			allowanceInput.put("Employee_ID",employee_id);
                 			allowanceResp = employee_management.getEmployeeActiveAllowance(allowanceInput);
                 			if(allowanceResp != null)
                 			{
                 				dailyAllowance = ifnull(allowanceResp.get("Daily_Allowance"),0.0);
                 				weeklyAllowance = ifnull(allowanceResp.get("Weekly_Allowance"),0.0);
                 				monthlySalary = ifnull(allowanceResp.get("Monthly_Salary"),0.0);
                 			}
                 			dailyVoucherReference = "";
                 			dailyVoucherDetails = "";
                 			nextVoucherDate = vDate.addDay(1);
                 			employeeDayVouchers = Voucher_Register[Employee == employee_id && Date_Time_In >= vDate && Date_Time_In < nextVoucherDate];
                 			for each  vr in employeeDayVouchers
                 			{
                 				includeVoucher = false;
                 				if(vr.Date_Time_In != null)
                 				{
                 					if(vr.Date_Time_In.toDate() == vDate)
                 					{
                 						includeVoucher = true;
                 					}
                 				}
                 				if(includeVoucher == true)
                 				{
                 					vrNumber = ifnull(vr.Voucher_Number,"").trim();
                 					vrType = "";
                 					if(vr.Voucher_Type != null)
                 					{
                 						vrType = ifnull(vr.Voucher_Type.Voucher_Type,"").trim();
                 					}
                 					if(vrType == "")
                 					{
                 						vrType = ifnull(vr.Display_Name_Voucher_Type,"").trim();
                 					}
                 					if(vrNumber != "")
                 					{
                 						if(dailyVoucherReference == "")
                 						{
                 							dailyVoucherReference = vrNumber;
                 						}
                 						else
                 						{
                 							if(!dailyVoucherReference.contains(vrNumber))
                 							{
                 								dailyVoucherReference = dailyVoucherReference + ", " + vrNumber;
                 							}
                 						}
                 						voucherLine = vrNumber;
                 						if(vrType != "")
                 						{
                 							voucherLine = voucherLine + " - " + vrType;
                 						}
                 						if(dailyVoucherDetails == "")
                 						{
                 							dailyVoucherDetails = voucherLine;
                 						}
                 						else
                 						{
                 							if(!dailyVoucherDetails.contains(voucherLine))
                 							{
                 								dailyVoucherDetails = dailyVoucherDetails + "\n" + voucherLine;
                 							}
                 						}
                 					}
                 				}
                 			}
                 			if(dailyVoucherReference == "")
                 			{
                 				dailyVoucherReference = ifnull(voucherRecord.Voucher_Number,"");
                 			}
                 			if(dailyVoucherDetails == "")
                 			{
                 				dailyVoucherDetails = ifnull(voucherRecord.Voucher_Number,"");
                 				currentVoucherType = "";
                 				if(voucherRecord.Voucher_Type != null)
                 				{
                 					currentVoucherType = ifnull(voucherRecord.Voucher_Type.Voucher_Type,"").trim();
                 				}
                 				if(currentVoucherType == "")
                 				{
                 					currentVoucherType = ifnull(voucherRecord.Display_Name_Voucher_Type,"").trim();
                 				}
                 				if(currentVoucherType != "")
                 				{
                 					dailyVoucherDetails = dailyVoucherDetails + " - " + currentVoucherType;
                 				}
                 			}
                 			if(dailyAllowance > 0 || weeklyAllowance > 0)
                 			{
                 				periodResp = thisapp.billing.getEmployeeBillPeriod(vDate,"Weekly Payment");
                 				billDate = periodResp.get("Bill_Date");
                 				billNumber = periodResp.get("Bill_Number");
                 				existingBill = Bill[Employee_Vendor == employee_id && Bill_Number == billNumber && Bill_Type == "Employee Bill"];
                 				employeeBillID = null;
                 				if(existingBill.ID != null)
                 				{
                 					employeeBillID = existingBill.ID;
                 					existingBill.Bill_Date=billDate;
                 					existingBill.Bill_Name=billName;
                 					existingBill.Display_Name_Vendor=displayVendorName;
                 					existingBill.Employee_Vendor=employee_id;
                 					existingBill.Bill_Type="Employee Bill";
                 				}
                 				else
                 				{
                 					employeeBillID = insert into Bill
                 					[
                 						Bill_Date=billDate
                 						Bill_Type="Employee Bill"
                 						Employee_Vendor=employee_id
                 						Display_Name_Vendor=displayVendorName
                 						Bill_Name=billName
                 						Bill_Number=billNumber
                 						Bill_Status="Draft"
                 						Payment_Status="Not Paid"
                 						Added_User=zoho.loginuser
                 					];
                 				}
                 				if(employeeBillID != null)
                 				{
                 					weekDateKeys = List();
                 					weekDates = List();
                 					weekVoucherReference = "";
                 					weekVoucherDetails = "";
                 					weekStartDate = billDate.addDay(-7);
                 					weekEndDate = billDate;
                 					employeeWeekVouchers = Voucher_Register[Employee == employee_id && Date_Time_In >= weekStartDate && Date_Time_In < weekEndDate];
                 					for each  weekVoucher in employeeWeekVouchers
                 					{
                 						if(weekVoucher.Date_Time_In != null)
                 						{
                 							weekVoucherDate = weekVoucher.Date_Time_In.toDate();
                 							weekDateKey = weekVoucherDate.toString("yyyy-MM-dd");
                 							if(!weekDateKeys.contains(weekDateKey))
                 							{
                 								weekDateKeys.add(weekDateKey);
                 								weekDates.add(weekVoucherDate);
                 							}
                 							weekVoucherNumber = ifnull(weekVoucher.Voucher_Number,"").trim();
                 							weekVoucherType = "";
                 							if(weekVoucher.Voucher_Type != null)
                 							{
                 								weekVoucherType = ifnull(weekVoucher.Voucher_Type.Voucher_Type,"").trim();
                 							}
                 							if(weekVoucherType == "")
                 							{
                 								weekVoucherType = ifnull(weekVoucher.Display_Name_Voucher_Type,"").trim();
                 							}
                 							if(weekVoucherNumber != "")
                 							{
                 								if(weekVoucherReference == "")
                 								{
                 									weekVoucherReference = weekVoucherNumber;
                 								}
                 								else if(!weekVoucherReference.contains(weekVoucherNumber))
                 								{
                 									weekVoucherReference = weekVoucherReference + ", " + weekVoucherNumber;
                 								}
                 								weekVoucherLine = weekVoucherDate.toString("dd-MMM-yyyy") + " - " + weekVoucherNumber;
                 								if(weekVoucherType != "")
                 								{
                 									weekVoucherLine = weekVoucherLine + " - " + weekVoucherType;
                 								}
                 								if(weekVoucherDetails == "")
                 								{
                 									weekVoucherDetails = weekVoucherLine;
                 								}
                 								else if(!weekVoucherDetails.contains(weekVoucherLine))
                 								{
                 									weekVoucherDetails = weekVoucherDetails + "\n" + weekVoucherLine;
                 								}
                 							}
                 						}
                 					}
                 					qualifyingDateCount = weekDateKeys.size();
                 					if(dailyAllowance > 0)
                 					{
                 						for each  workDate in weekDates
                 						{
                 							workDateVoucherReference = "";
                 							workDateVoucherDetails = "";
                 							workDateSource = sourceVal;
                 							workDateAccount = accountVal;
                 							workDateSite = siteVal;
                 							workDateSourceRecordID = voucherRecord.ID;
                 							for each  dateVoucher in employeeWeekVouchers
                 							{
                 								if(dateVoucher.Date_Time_In != null && dateVoucher.Date_Time_In.toDate() == workDate)
                 								{
                 									dateVoucherNumber = ifnull(dateVoucher.Voucher_Number,"").trim();
                 									dateVoucherType = "";
                 									if(dateVoucher.Voucher_Type != null)
                 									{
                 										dateVoucherType = ifnull(dateVoucher.Voucher_Type.Voucher_Type,"").trim();
                 									}
                 									if(dateVoucherType == "")
                 									{
                 										dateVoucherType = ifnull(dateVoucher.Display_Name_Voucher_Type,"").trim();
                 									}
                 									if(dateVoucherNumber != "")
                 									{
                 										if(workDateVoucherReference == "")
                 										{
                 											workDateVoucherReference = dateVoucherNumber;
                 										}
                 										else if(!workDateVoucherReference.contains(dateVoucherNumber))
                 										{
                 											workDateVoucherReference = workDateVoucherReference + ", " + dateVoucherNumber;
                 										}
                 										dateVoucherLine = dateVoucherNumber;
                 										if(dateVoucherType != "")
                 										{
                 											dateVoucherLine = dateVoucherLine + " - " + dateVoucherType;
                 										}
                 										if(workDateVoucherDetails == "")
                 										{
                 											workDateVoucherDetails = dateVoucherLine;
                 										}
                 										else if(!workDateVoucherDetails.contains(dateVoucherLine))
                 										{
                 											workDateVoucherDetails = workDateVoucherDetails + "\n" + dateVoucherLine;
                 										}
                 									}
                 									workDateSource = ifnull(dateVoucher.Display_Name_Employee,"").trim();
                 									workDateSite = ifnull(dateVoucher.Display_Name_Site,"").trim();
                 									workDateAccount = workDateSite;
                 									if(workDateAccount == "")
                 									{
                 										workDateAccount = "Unassigned Account";
                 									}
                 									workDateSourceRecordID = dateVoucher.ID;
                 								}
                 							}
                 							dailyAllowanceText = "Allowance Type: Daily Allowance";
                 							dailyAllowanceText = dailyAllowanceText + "\nDate: " + workDate.toString("dd-MMM-yyyy");
                 							dailyAllowanceText = dailyAllowanceText + "\nEmployee: " + displayVendorName;
                 							dailyAllowanceText = dailyAllowanceText + "\nSite: " + workDateSite;
                 							dailyAllowanceText = dailyAllowanceText + "\nWeek: " + billNumber;
                 							dailyAllowanceText = dailyAllowanceText + "\nDaily Allowance: " + dailyAllowance.toString();
                 							dailyAllowanceText = dailyAllowanceText + "\n\nVouchers:";
                 							dailyAllowanceText = dailyAllowanceText + "\n" + workDateVoucherDetails;
                 							existingDateDetails = Bill_Details[Bill == employeeBillID && Details_Date == workDate && Expense_Type == "Weekly Payment"];
                 							dailyDetailFound = false;
                 							for each  dateBD in existingDateDetails
                 							{
                 								dateBDText = ifnull(dateBD.Details,"");
                 								if(dateBDText.contains("Allowance Type: Weekly Allowance") == false && dailyDetailFound == false)
                 								{
                 									dateBD.Reference=workDateVoucherReference;
                 									dateBD.Details=dailyAllowanceText;
                 									dateBD.Quantity=1.00;
                 									dateBD.Rate=dailyAllowance;
                 									dateBD.Source=workDateSource;
                 									dateBD.Account=workDateAccount;
                 									dateBD.Current_Site=workDateSite;
                 									dateBD.Source_Record_ID=workDateSourceRecordID;
                 									dateBD.Display_Name_Bill=billName + " - " + billNumber;
                 									dailyDetailFound = true;
                 									bill_record_ready = true;
                 								}
                 							}
                 							if(dailyDetailFound == false)
                 							{
                 								newDailyDetailID = insert into Bill_Details
                 								[
                 									Bill=employeeBillID
                 									Display_Name_Bill=billName + " - " + billNumber
                 									Details_Date=workDate
                 									Source=workDateSource
                 									Reference=workDateVoucherReference
                 									Details=dailyAllowanceText
                 									Expense_Type="Weekly Payment"
                 									Quantity=1.00
                 									Rate=dailyAllowance
                 									Account=workDateAccount
                 									Current_Site=workDateSite
                 									Source_Record_ID=workDateSourceRecordID
                 									Source_Form="Masaka Site Management - Voucher Register"
                 									Bill_Details_Status="Draft"
                 									Added_User=zoho.loginuser
                 								];
                 								if(newDailyDetailID != null)
                 								{
                 									bill_record_ready = true;
                 								}
                 							}
                 						}
                 					}
                 					if(weeklyAllowance > 0 && qualifyingDateCount > 0)
                 					{
                 						weeklyCalculatedRate = weeklyAllowance / qualifyingDateCount;
                 						weeklyAllowanceText = "Allowance Type: Weekly Allowance";
                 						weeklyAllowanceText = weeklyAllowanceText + "\nEmployee: " + displayVendorName;
                 						weeklyAllowanceText = weeklyAllowanceText + "\nWeek: " + billNumber;
                 						weeklyAllowanceText = weeklyAllowanceText + "\nQualifying Dates: " + qualifyingDateCount.toString();
                 						weeklyAllowanceText = weeklyAllowanceText + "\nFixed Weekly Allowance: " + weeklyAllowance.toString();
                 						weeklyAllowanceText = weeklyAllowanceText + "\n\nDaily Records / Vouchers:";
                 						weeklyAllowanceText = weeklyAllowanceText + "\n" + weekVoucherDetails;
                 						allWeeklyPaymentDetails = Bill_Details[Bill == employeeBillID && Expense_Type == "Weekly Payment"];
                 						weeklyAllowanceFound = false;
                 						for each  weeklyAllowanceBD in allWeeklyPaymentDetails
                 						{
                 							weeklyAllowanceBDText = ifnull(weeklyAllowanceBD.Details,"");
                 							if(weeklyAllowanceBDText.contains("Allowance Type: Weekly Allowance") && weeklyAllowanceFound == false)
                 							{
                 								weeklyAllowanceBD.Details_Date=billDate;
                 								weeklyAllowanceBD.Reference=weekVoucherReference;
                 								weeklyAllowanceBD.Details=weeklyAllowanceText;
                 								weeklyAllowanceBD.Quantity=qualifyingDateCount;
                 								weeklyAllowanceBD.Rate=weeklyCalculatedRate;
                 								weeklyAllowanceBD.Source=sourceVal;
                 								weeklyAllowanceBD.Account=accountVal;
                 								weeklyAllowanceBD.Current_Site=siteVal;
                 								weeklyAllowanceBD.Source_Record_ID=voucherRecord.ID;
                 								weeklyAllowanceBD.Display_Name_Bill=billName + " - " + billNumber;
                 								weeklyAllowanceFound = true;
                 								bill_record_ready = true;
                 							}
                 						}
                 						if(weeklyAllowanceFound == false)
                 						{
                 							newWeeklyAllowanceDetailID = insert into Bill_Details
                 							[
                 								Bill=employeeBillID
                 								Display_Name_Bill=billName + " - " + billNumber
                 								Details_Date=billDate
                 								Source=sourceVal
                 								Reference=weekVoucherReference
                 								Details=weeklyAllowanceText
                 								Expense_Type="Weekly Payment"
                 								Quantity=qualifyingDateCount
                 								Rate=weeklyCalculatedRate
                 								Account=accountVal
                 								Current_Site=siteVal
                 								Source_Record_ID=voucherRecord.ID
                 								Source_Form="Masaka Site Management - Voucher Register"
                 								Bill_Details_Status="Draft"
                 								Added_User=zoho.loginuser
                 							];
                 							if(newWeeklyAllowanceDetailID != null)
                 							{
                 								bill_record_ready = true;
                 							}
                 						}
                 					}
                 					totalsResp = thisapp.billing.recalculateBillTotals(employeeBillID);
                 					info totalsResp;
                 				}
                 			}
                 			specialMonthlyEmployee = false;
                 			if(employee_number_value >= 10000 && employee_number_value <= 20000)
                 			{
                 				specialMonthlyEmployee = true;
                 			}
                 			if(monthlySalary > 0 && specialMonthlyEmployee == false)
                 			{
                 				monthlyPeriodResp = thisapp.billing.getEmployeeBillPeriod(vDate,"Monthly Payment");
                 				monthlyBillDate = monthlyPeriodResp.get("Bill_Date");
                 				monthlyReference = monthlyPeriodResp.get("Bill_Number");
                 				existingMonthlyBill = Bill[Employee_Vendor == employee_id && Bill_Number == monthlyReference && Bill_Type == "Employee Bill"];
                 				monthlyBillID = null;
                 				if(existingMonthlyBill.ID != null)
                 				{
                 					monthlyBillID = existingMonthlyBill.ID;
                 					existingMonthlyBill.Bill_Date=monthlyBillDate;
                 					existingMonthlyBill.Bill_Type="Employee Bill";
                 					existingMonthlyBill.Employee_Vendor=employee_id;
                 					existingMonthlyBill.Display_Name_Vendor=displayVendorName;
                 					existingMonthlyBill.Bill_Name=billName;
                 					existingMonthlyBill.Bill_Number=monthlyReference;
                 				}
                 				else
                 				{
                 					monthlyBillID = insert into Bill
                 					[
                 						Bill_Date=monthlyBillDate
                 						Bill_Type="Employee Bill"
                 						Employee_Vendor=employee_id
                 						Display_Name_Vendor=displayVendorName
                 						Bill_Name=billName
                 						Bill_Number=monthlyReference
                 						Bill_Status="Draft"
                 						Payment_Status="Not Paid"
                 						Added_User=zoho.loginuser
                 					];
                 				}
                 				if(monthlyBillID != null)
                 				{
                 					existingDailyMonthly = Bill_Details[Bill == monthlyBillID && Details_Date == vDate && Expense_Type == "Monthly Payment"];
                 					monthlyDetailText = "";
                 					monthlyDetailText = "Date: " + vDate.toString("dd-MMM-yyyy");
                 					monthlyDetailText = monthlyDetailText + "\nEmployee: " + displayVendorName;
                 					monthlyDetailText = monthlyDetailText + "\nSite: " + siteVal;
                 					monthlyDetailText = monthlyDetailText + "\nMonth: " + monthlyReference;
                 					monthlyDetailText = monthlyDetailText + "\nMonthly Salary: " + monthlySalary.toString();
                 					monthlyDetailText = monthlyDetailText + "\n\nVouchers:";
                 					monthlyDetailText = monthlyDetailText + "\n" + dailyVoucherDetails;
                 					if(existingDailyMonthly.count() == 0)
                 					{
                 						newMonthlyDetailID = insert into Bill_Details
                 						[
                 							Bill=monthlyBillID
                 							Display_Name_Bill=billName + " - " + monthlyReference
                 							Details_Date=vDate
                 							Source=sourceVal
                 							Reference=dailyVoucherReference
                 							Details=monthlyDetailText
                 							Expense_Type="Monthly Payment"
                 							Quantity=1.00
                 							Account=accountVal
                 							Current_Site=siteVal
                 							Source_Record_ID=voucherRecord.ID
                 							Source_Form="Masaka Site Management - Voucher Register"
                 							Bill_Details_Status="Draft"
                 							Added_User=zoho.loginuser
                 						];
                 						if(newMonthlyDetailID != null)
                 						{
                 							bill_record_ready = true;
                 						}
                 					}
                 					else
                 					{
                 						for each  monthlyBD in existingDailyMonthly
                 						{
                 							monthlyBD.Reference=dailyVoucherReference;
                 							monthlyBD.Details=monthlyDetailText;
                 							monthlyBD.Quantity=1.00;
                 							monthlyBD.Source=sourceVal;
                 							monthlyBD.Account=accountVal;
                 							monthlyBD.Current_Site=siteVal;
                 							monthlyBD.Display_Name_Bill=billName + " - " + monthlyReference;
                 							bill_record_ready = true;
                 							break;
                 						}
                 					}
                 				}
                 			}
                 			if(monthlySalary > 0 && specialMonthlyEmployee == true)
                 			{
                 				specialEmployees = List();
                 				supervisorVoucherList = List();
                 				specialDetailText = "";
                 				specialEmployeeCount = 0;
                 				checkedSpecialEmployees = List();
                 				specialSalaryCache = Map();
                 				// Read only this site's vouchers for the current date.
                 				siteVouchers = Voucher_Register[Display_Name_Site == siteVal && Date_Time_In >= vDate && Date_Time_In < nextVoucherDate];
                 				for each  siteVoucher in siteVouchers
                 				{
                 					isSameDay = false;
                 					if(siteVoucher.Date_Time_In != null)
                 					{
                 						if(siteVoucher.Date_Time_In.toDate() == vDate)
                 						{
                 							isSameDay = true;
                 						}
                 					}
                 					if(isSameDay == true && siteVoucher.Employee != null)
                 					{
                 						thisEmployeeNumber = 0;
                 						if(siteVoucher.Employee.Employee_Number != null)
                 						{
                 							thisEmployeeNumber = siteVoucher.Employee.Employee_Number;
                 						}
                 						if(thisEmployeeNumber >= 10000 && thisEmployeeNumber <= 20000)
                 						{
                 							thisEmployeeID = siteVoucher.Employee.ID;
                 							thisEmployeeKey = thisEmployeeID.toString();
                 							thisMonthlySalary = 0.0;
                 							if(!checkedSpecialEmployees.contains(thisEmployeeKey))
                 							{
                 								checkedSpecialEmployees.add(thisEmployeeKey);
                 								thisAllowanceInput = Map();
                 								thisAllowanceInput.put("Employee_ID",thisEmployeeID);
                 								thisAllowanceResp = employee_management.getEmployeeActiveAllowance(thisAllowanceInput);
                 								if(thisAllowanceResp != null)
                 								{
                 									thisMonthlySalary = ifnull(thisAllowanceResp.get("Monthly_Salary"),0.0);
                 								}
                 								specialSalaryCache.put(thisEmployeeKey,thisMonthlySalary);
                 							}
                 							else
                 							{
                 								thisMonthlySalary = ifnull(specialSalaryCache.get(thisEmployeeKey),0.0);
                 							}
                 							if(thisMonthlySalary > 0)
                 							{
                 								thisEmployeeName = ifnull(siteVoucher.Employee.Employee_Name,"").trim();
                 								thisEmployeeDisplay = thisEmployeeName;
                 								if(thisEmployeeNumber > 0)
                 								{
                 									thisEmployeeDisplay = thisEmployeeName + " - " + thisEmployeeNumber.toString();
                 								}
                 								if(!specialEmployees.contains(thisEmployeeKey))
                 								{
                 									specialEmployees.add(thisEmployeeKey);
                 									specialEmployeeCount = specialEmployeeCount + 1;
                 									if(specialDetailText != "")
                 									{
                 										specialDetailText = specialDetailText + "\n";
                 									}
                 									specialDetailText = specialDetailText + "\n" + thisEmployeeDisplay;
                 								}
                 								thisVoucherNumber = ifnull(siteVoucher.Voucher_Number,"").trim();
                 								thisVoucherType = "";
                 								if(siteVoucher.Voucher_Type != null)
                 								{
                 									thisVoucherType = ifnull(siteVoucher.Voucher_Type.Voucher_Type,"").trim();
                 								}
                 								if(thisVoucherType == "")
                 								{
                 									thisVoucherType = ifnull(siteVoucher.Display_Name_Voucher_Type,"").trim();
                 								}
                 								if(thisVoucherNumber != "")
                 								{
                 									thisVoucherLine = "  - " + thisVoucherNumber;
                 									if(thisVoucherType != "")
                 									{
                 										thisVoucherLine = thisVoucherLine + " - " + thisVoucherType;
                 									}
                 									if(!specialDetailText.contains(thisVoucherLine))
                 									{
                 										specialDetailText = specialDetailText + "\n" + thisVoucherLine;
                 									}
                 								}
                 								thisSupervisorVoucher = ifnull(siteVoucher.Display_Name_Issued_By,"").trim();
                 								if(thisSupervisorVoucher != "")
                 								{
                 									if(!supervisorVoucherList.contains(thisSupervisorVoucher))
                 									{
                 										supervisorVoucherList.add(thisSupervisorVoucher);
                 									}
                 								}
                 							}
                 						}
                 					}
                 				}
                 				specialReference = "";
                 				for each  supervisorVoucher in supervisorVoucherList
                 				{
                 					if(specialReference == "")
                 					{
                 						specialReference = supervisorVoucher;
                 					}
                 					else
                 					{
                 						specialReference = specialReference + ", " + supervisorVoucher;
                 					}
                 				}
                 				if(specialEmployeeCount > 0)
                 				{
                 					specialMonthlyText = "";
                 					specialMonthlyText = "Date: " + vDate.toString("dd-MMM-yyyy");
                 					specialMonthlyText = specialMonthlyText + "\nSite: " + siteVal;
                 					specialMonthlyText = specialMonthlyText + "\nEmployees: " + specialEmployeeCount.toString();
                 					specialMonthlyText = specialMonthlyText + "\n\nEmployees / Vouchers:";
                 					specialMonthlyText = specialMonthlyText + specialDetailText;
                 					existingSpecialMonthly = Bill_Details[Details_Date == vDate && Current_Site == siteVal && Expense_Type == "Monthly Payment" && Source_Form == "Masaka Site Management - Voucher Register"];
                 					if(existingSpecialMonthly.count() == 0)
                 					{
                 						newSpecialMonthlyDetailID = insert into Bill_Details
                 						[
                 							Details_Date=vDate
                 							Source=siteVal
                 							Reference=specialReference
                 							Details=specialMonthlyText
                 							Expense_Type="Monthly Payment"
                 							Quantity=specialEmployeeCount
                 							Account=accountVal
                 							Current_Site=siteVal
                 							Source_Record_ID=voucherRecord.ID
                 							Source_Form="Masaka Site Management - Voucher Register"
                 							Bill_Details_Status="Draft"
                 							Added_User=zoho.loginuser
                 						];
                 						if(newSpecialMonthlyDetailID != null)
                 						{
                 							bill_record_ready = true;
                 						}
                 					}
                 					else
                 					{
                 						for each  specialBD in existingSpecialMonthly
                 						{
                 							specialBD.Reference=specialReference;
                 							specialBD.Details=specialMonthlyText;
                 							specialBD.Quantity=specialEmployeeCount;
                 							specialBD.Account=accountVal;
                 							specialBD.Current_Site=siteVal;
                 							specialBD.Source=siteVal;
                 							bill_record_ready = true;
                 							break;
                 						}
                 					}
                 				}
                 			}
                 		}
                 	}
                 	syncResponse.put("bill_record_ready",bill_record_ready);
                 	if(voucherRecord.ID == null)
                 	{
                 		syncResponse.put("message","Voucher Register record was not found.");
                 	}
                 	else if(voucherRecord.Employee == null)
                 	{
                 		syncResponse.put("message","The voucher has no employee.");
                 	}
                 	else
                 	{
                 		syncResponse.put("ok",true);
                 		syncResponse.put("message","Employee billing synchronized successfully.");
                 		syncResponse.put("voucher_id",voucher_id);
                 	}
                 	return syncResponse;
                 }
				 void card.generate_sand_sales_card(int sales_voucher_id)
                 {
                 	if(sales_voucher_id == null || sales_voucher_id <= 0)
                 	{
                 		info "FAILED: Sales Voucher ID is required.";
                 		return;
                 	}
                 	sales_rec = Sales_Voucher[ID == sales_voucher_id];
                 	if(sales_rec.ID == null)
                 	{
                 		info "FAILED: Sales Voucher record was not found.";
                 		return;
                 	}
                 	sales_type = ifnull(sales_rec.Sales_Type,"").trim();
                 	if(sales_type != "Sand Sales")
                 	{
                 		info "SKIPPED: Sales Type is " + sales_type;
                 		return;
                 	}
                 	current_card_number = ifnull(sales_rec.Card_Number,"").trim();
                 	if(current_card_number != "")
                 	{
                 		info "SKIPPED: Card Number already exists: " + current_card_number;
                 		return;
                 	}
                 	site_display = ifnull(sales_rec.Display_Name_Site,"").trim();
                 	info "Sales Voucher Site: " + site_display;
                 	if(site_display == "")
                 	{
                 		info "FAILED: Display Name Site is empty on Sales Voucher.";
                 		return;
                 	}
                 	seq = Card_Sequence[Display_Name_Site == site_display && Card_Status == "Active"];
                 	if(seq.ID == null)
                 	{
                 		info "FAILED: No active Card Sequence found for: " + site_display;
                 		return;
                 	}
                 	info "Card Sequence found: " + seq.ID;
                 	prefix_txt = ifnull(seq.Prefix,"").trim().toUpperCase();
                 	next_no = ifnull(seq.Next_Number,1);
                 	rate_cbm = ifnull(seq.Rate_per_CBM,0.0);
                 	if(prefix_txt == "")
                 	{
                 		info "FAILED: Card Sequence Prefix is empty.";
                 		return;
                 	}
                 	if(next_no <= 0)
                 	{
                 		next_no = 1;
                 	}
                 	if(next_no > 999)
                 	{
                 		info "FAILED: Card Sequence has exceeded 999.";
                 		return;
                 	}
                 	// 001 to 999
                 	num_txt = next_no.toString();
                 	if(next_no < 10)
                 	{
                 		num_txt = "00" + num_txt;
                 	}
                 	else if(next_no < 100)
                 	{
                 		num_txt = "0" + num_txt;
                 	}
                 	card_no = prefix_txt + num_txt;
                 	existing_card = Sales_Voucher[Card_Number == card_no && ID != sales_rec.ID];
                 	if(existing_card.ID != null)
                 	{
                 		info "FAILED: Card Number already exists: " + card_no;
                 		return;
                 	}
                 	sales_rec.Card_Number=card_no;
                 	sales_rec.Sales_Voucher_Number=card_no;
                 	seq.Next_Number=next_no + 1;
                 	info "SUCCESS: Card Number generated: " + card_no;
                 	info "Rate per CBM: " + rate_cbm;
                 	info "Next Number is now: " + seq.Next_Number;
                 }
				 void customer.update_customer_performance(int customer_id)
                 {
                 	if(customer_id == null)
                 	{
                 		return;
                 	}
                 	customer_rec = Customer_Register[ID == customer_id];
                 	if(customer_rec.ID == null)
                 	{
                 		return;
                 	}
                 	valid_sales = Sales_Voucher[Customer == customer_id && Cancel_Voucher != true && Payment_Status != "Cancelled"];
                 	total_sales_orders = valid_sales.count();
                 	total_revenue = ifnull(valid_sales.sum(Grand_Total),0.0);
                 	last_purchase_date = valid_sales.maximum(Sales_Voucher_Date);
                 	valid_payments = Payment_Receipt_Voucher[Customer == customer_id && Payment_Receipt_Voucher_Status != "Cancelled"];
                 	total_paid = ifnull(valid_payments.sum(Total_Amount_Received),0.0);
                 	credit_sales = Sales_Voucher[Customer == customer_id && Payment_Status == "Credit" && Cancel_Voucher != true];
                 	outstanding_balance = ifnull(credit_sales.sum(Grand_Total),0.0);
                 	if(outstanding_balance < 0)
                 	{
                 		outstanding_balance = 0.0;
                 	}
                 	credit_limit = ifnull(customer_rec.Credit_Limit,0.0);
                 	available_credit = credit_limit - outstanding_balance;
                 	if(available_credit < 0)
                 	{
                 		available_credit = 0.0;
                 	}
                 	credit_status = "Not Applicable";
                 	if(ifnull(customer_rec.Customer_Type,"") == "Credit")
                 	{
                 		if(customer_rec.Credit_Allowed != true)
                 		{
                 			credit_status = "On Hold";
                 		}
                 		else if(credit_limit > 0 && outstanding_balance >= credit_limit)
                 		{
                 			credit_status = "Limit Reached";
                 		}
                 		else
                 		{
                 			credit_status = "Good Standing";
                 		}
                 	}
                 	customer_rec.Total_Sales_Orders=total_sales_orders;
                 	customer_rec.Total_Revenue=total_revenue;
                 	customer_rec.Total_Paid=total_paid;
                 	customer_rec.Outstanding_Balance=outstanding_balance;
                 	customer_rec.Current_Outstanding_Balance=outstanding_balance;
                 	customer_rec.Last_Purchase_Date=last_purchase_date;
                 	customer_rec.Available_Credit=available_credit;
                 	customer_rec.Credit_Status=credit_status;
                 }
				 map labour.recalculate_truck_movement_labour(int employee_id, string employee_display_name, date work_date)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("message","");
                 	result.put("employee_id",employee_id);
                 	result.put("employee",employee_display_name);
                 	result.put("monthly_salary",0.0);
                 	result.put("working_days",0);
                 	result.put("daily_labour",0.0);
                 	result.put("trip_lines_updated",0);
                 	result.put("calculated_labour_total",0.0);
                 	if(employee_id == null)
                 	{
                 		result.put("message","Employee ID is required.");
                 		return result;
                 	}
                 	employee_display_name = ifnull(employee_display_name,"").trim();
                 	if(work_date == null)
                 	{
                 		work_date = zoho.currentdate;
                 	}
                 	salary_result = employee_management.employee.get_employee_salary_details(employee_id,work_date);
                 	if(salary_result == null)
                 	{
                 		result.put("message","Employee Management returned no salary information.");
                 		return result;
                 	}
                 	if(ifnull(salary_result.get("ok"),false) != true)
                 	{
                 		result.put("message",ifnull(salary_result.get("message"),"Employee salary could not be retrieved."));
                 		return result;
                 	}
                 	monthly_salary = ifnull(salary_result.get("monthly_salary"),0.0);
                 	if(monthly_salary <= 0)
                 	{
                 		result.put("message","The employee monthly salary must be greater than zero.");
                 		return result;
                 	}
                 	result.put("monthly_salary",monthly_salary);
                 	month_number = work_date.getMonth();
                 	year_number = work_date.getYear();
                 	month_text = month_number.toString();
                 	if(month_number < 10)
                 	{
                 		month_text = "0" + month_number;
                 	}
                 	month_start_text = "01-" + month_text + "-" + year_number.toString();
                 	month_start = month_start_text.toDate("dd-MM-yyyy");
                 	next_month_start = month_start.addMonth(1);
                 	result.put("month_start",month_start);
                 	result.put("next_month_start",next_month_start);
                 	month_trips = Truck_Movement_Voucher[Voucher.Employee == employee_id && Time_Start >= month_start && Time_Start < next_month_start && Cancel_Voucher != true];
                 	if(month_trips.count() <= 0)
                 	{
                 		result.put("message","No truck movements were found for the employee in this month.");
                 		return result;
                 	}
                 	trips_per_day = Map();
                 	working_dates = List();
                 	for each  trip_rec in month_trips
                 	{
                 		if(trip_rec.Time_Start != null)
                 		{
                 			movement_date = trip_rec.Time_Start.toDate();
                 			day_key = movement_date.toString("yyyy-MM-dd");
                 			if(!working_dates.contains(day_key))
                 			{
                 				working_dates.add(day_key);
                 			}
                 			day_trip_count = 0;
                 			if(trips_per_day.containKey(day_key))
                 			{
                 				day_trip_count = ifnull(trips_per_day.get(day_key),0);
                 			}
                 			trips_per_day.put(day_key,day_trip_count + 1);
                 		}
                 	}
                 	working_days = working_dates.size();
                 	if(working_days <= 0)
                 	{
                 		result.put("message","No valid working dates were found.");
                 		return result;
                 	}
                 	daily_labour = round(monthly_salary / working_days,2);
                 	result.put("working_days",working_days);
                 	result.put("daily_labour",daily_labour);
                 	updated_count = 0;
                 	calculated_total = 0.0;
                 	for each  trip_rec in month_trips
                 	{
                 		if(trip_rec.Time_Start != null)
                 		{
                 			day_key = trip_rec.Time_Start.toDate().toString("yyyy-MM-dd");
                 			trips_that_day = ifnull(trips_per_day.get(day_key),0);
                 			if(trips_that_day > 0)
                 			{
                 				labour_per_trip = round(daily_labour / trips_that_day,2);
                 				trip_rec.Labour_Cost=labour_per_trip;
                 				calculated_total = calculated_total + labour_per_trip;
                 				updated_count = updated_count + 1;
                 			}
                 		}
                 	}
                 	result.put("trip_lines_updated",updated_count);
                 	result.put("calculated_labour_total",round(calculated_total,2));
                 	result.put("ok",true);
                 	result.put("message","Truck movement labour was recalculated successfully.");
                 	return result;
                 }
				 map po.push_po_status_to_store(int po_id)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("message","");
                 	if(po_id == null)
                 	{
                 		result.put("message","Purchase Order ID is required.");
                 		return result;
                 	}
                 	po_rec = Purchase_Order[ID == po_id];
                 	if(po_rec.ID == null)
                 	{
                 		result.put("message","Masaka Purchase Order not found.");
                 		return result;
                 	}
                 	po_number = ifnull(po_rec.PO_Number,"").trim();
                 	employee_voucher = ifnull(po_rec.Employee_Voucher,"").trim();
                 	po_status = ifnull(po_rec.PO_Status,"").trim();
                 	if(po_number == "")
                 	{
                 		result.put("message","PO Number is missing.");
                 		return result;
                 	}
                 	if(po_rec.PO_Date == null)
                 	{
                 		result.put("message","PO Date is missing.");
                 		return result;
                 	}
                 	if(employee_voucher == "")
                 	{
                 		result.put("message","Employee Voucher is missing.");
                 		return result;
                 	}
                 	if(po_status == "")
                 	{
                 		result.put("message","PO Status is missing.");
                 		return result;
                 	}
                 	sync_resp = store_management.po.sync_po_status_from_concrete(po_number,po_rec.PO_Date,employee_voucher,po_status);
                 	return sync_resp;
                 }
				 map po.sync_po_status_from_store(string source_record_id_text, string po_status)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("message","");
                 	source_record_id_text = ifnull(source_record_id_text,"").trim();
                 	po_status = ifnull(po_status,"").trim();
                 	if(source_record_id_text == "")
                 	{
                 		result.put("message","Source Record ID is required.");
                 		return result;
                 	}
                 	if(po_status == "")
                 	{
                 		result.put("message","PO Status is required.");
                 		return result;
                 	}
                 	source_record_id = source_record_id_text.toLong();
                 	po_rec = Purchase_Order[ID == source_record_id];
                 	if(po_rec.ID == null)
                 	{
                 		result.put("message","Masaka Purchase Order not found for ID " + source_record_id_text);
                 		return result;
                 	}
                 	po_rec.PO_Status=po_status;
                 	result.put("ok",true);
                 	result.put("message","Masaka Purchase Order status updated to " + po_status);
                 	return result;
                 }
				 void po.update_all_po_bill_status()
                 {
                 	po_list = Purchase_Order[ID != null];
                 	for each  po_rec in po_list
                 	{
                 		det_list = Purchase_Order_Details[Purchase_Order == po_rec.ID];
                 		has_lines = false;
                 		po_billed_total = 0.0;
                 		for each  det in det_list
                 		{
                 			has_lines = true;
                 			bill_rows = Bill_Details[Item == det.ID];
                 			for each  bd in bill_rows
                 			{
                 				po_billed_total = po_billed_total + ifnull(bd.Line_Total,0.0);
                 			}
                 		}
                 		po_rec.PO_Billed_Total=round(po_billed_total,2);
                 		po_total = round(ifnull(po_rec.PO_Total,0.0),2);
                 		if(has_lines == false || po_rec.PO_Billed_Total <= 0)
                 		{
                 			po_rec.Bill_Status="Not Billed";
                 		}
                 		else if(po_total > 0 && po_rec.PO_Billed_Total < po_total)
                 		{
                 			po_rec.Bill_Status="Partially Billed";
                 		}
                 		else
                 		{
                 			po_rec.Bill_Status="Billed";
                 		}
                 	}
                 }
				 void po.update_po_receiving_status(int po_id)
                 {
                 	if(po_id == null)
                 	{
                 		return;
                 	}
                 	po_rec = Purchase_Order[ID == po_id];
                 	if(po_rec.ID == null)
                 	{
                 		return;
                 	}
                 	det_list = Purchase_Order_Details[Purchase_Order == po_id];
                 	has_lines = false;
                 	any_received = false;
                 	all_fully_received = true;
                 	any_billed = false;
                 	all_fully_billed = true;
                 	po_billed_total = 0.0;
                 	po_total_paid = 0.0;
                 	related_bill_map = Map();
                 	for each  det in det_list
                 	{
                 		has_lines = true;
                 		rec_status = ifnull(det.Receiving_Status,"Not Received").trim();
                 		if(rec_status == "Fully Received" || rec_status == "Partially Received")
                 		{
                 			any_received = true;
                 		}
                 		if(rec_status != "Fully Received")
                 		{
                 			all_fully_received = false;
                 		}
                 		line_value = round(ifnull(det.Line_Total,0.0),2);
                 		if(line_value <= 0)
                 		{
                 			line_value = round(ifnull(det.Quantity_Ordered,0.0) * ifnull(det.Unit_Cost,0.0),2);
                 		}
                 		bill_status = ifnull(det.Billing_Status,"Not Billed").trim();
                 		if(line_value <= 0)
                 		{
                 			any_billed = true;
                 		}
                 		else
                 		{
                 			if(bill_status == "Fully Billed" || bill_status == "Partially Billed")
                 			{
                 				any_billed = true;
                 			}
                 			if(bill_status != "Fully Billed")
                 			{
                 				all_fully_billed = false;
                 			}
                 		}
                 	}
                 	if(has_lines == false)
                 	{
                 		po_rec.Receive_Status="Not Received";
                 		po_rec.Bill_Status="Not Billed";
                 		po_rec.PO_Billed_Total=0.0;
                 		po_rec.PO_Total_Paid=0.0;
                 		po_rec.Payment_Status="Not Paid";
                 		if(po_rec.PO_Status != "Cancelled")
                 		{
                 			po_rec.PO_Status="Open";
                 		}
                 		sync_resp = thisapp.po.push_po_status_to_store(po_rec.ID);
                 		info sync_resp;
                 		return;
                 	}
                 	if(all_fully_received == true)
                 	{
                 		po_rec.Receive_Status="Fully Received";
                 	}
                 	else if(any_received == true)
                 	{
                 		po_rec.Receive_Status="Partially Received";
                 	}
                 	else
                 	{
                 		po_rec.Receive_Status="Not Received";
                 	}
                 	if(all_fully_billed == true)
                 	{
                 		po_rec.Bill_Status="Billed";
                 	}
                 	else if(any_billed == true)
                 	{
                 		po_rec.Bill_Status="Partially Billed";
                 	}
                 	else
                 	{
                 		po_rec.Bill_Status="Not Billed";
                 	}
                 	po_bill_rows = Bill_Details[Item.Purchase_Order == po_rec.ID];
                 	for each  po_bd in po_bill_rows
                 	{
                 		po_line_total = round(ifnull(po_bd.Line_Total,0.0),2);
                 		po_billed_total = round(po_billed_total + po_line_total,2);
                 		if(po_bd.Bill != null)
                 		{
                 			bill_id = po_bd.Bill.ID;
                 			bill_key = bill_id.toString();
                 			if(related_bill_map.get(bill_key) == null)
                 			{
                 				related_bill_map.put(bill_key,bill_id);
                 			}
                 		}
                 	}
                 	po_rec.PO_Billed_Total=round(po_billed_total,2);
                 	for each  bill_key in related_bill_map.keys()
                 	{
                 		bill_id = related_bill_map.get(bill_key);
                 		bill_rec = Bill[ID == bill_id];
                 		if(bill_rec.ID != null)
                 		{
                 			bill_paid = round(ifnull(bill_rec.Amount_Paid,0.0),2);
                 			if(bill_paid > 0)
                 			{
                 				bill_po_lines_total = 0.0;
                 				this_po_bill_total = 0.0;
                 				all_bill_rows = Bill_Details[Bill == bill_id];
                 				for each  bill_line in all_bill_rows
                 				{
                 					line_total = round(ifnull(bill_line.Line_Total,0.0),2);
                 					if(bill_line.Item != null)
                 					{
                 						po_detail_rec = Purchase_Order_Details[ID == bill_line.Item.ID];
                 						if(po_detail_rec.ID != null && po_detail_rec.Purchase_Order != null)
                 						{
                 							bill_po_lines_total = round(bill_po_lines_total + line_total,2);
                 							if(po_detail_rec.Purchase_Order.ID == po_rec.ID)
                 							{
                 								this_po_bill_total = round(this_po_bill_total + line_total,2);
                 							}
                 						}
                 					}
                 				}
                 				if(bill_po_lines_total > 0 && this_po_bill_total > 0)
                 				{
                 					allocated_payment = round(bill_paid * this_po_bill_total / bill_po_lines_total,2);
                 					if(allocated_payment > this_po_bill_total)
                 					{
                 						allocated_payment = this_po_bill_total;
                 					}
                 					po_total_paid = round(po_total_paid + allocated_payment,2);
                 				}
                 			}
                 		}
                 	}
                 	po_rec.PO_Total_Paid=round(po_total_paid,2);
                 	po_total = round(ifnull(po_rec.PO_Total,0.0),2);
                 	if(po_total <= 0)
                 	{
                 		po_rec.Payment_Status="Not Payable";
                 	}
                 	else if(po_total_paid <= 0)
                 	{
                 		po_rec.Payment_Status="Not Paid";
                 	}
                 	else if(po_total_paid < po_total)
                 	{
                 		po_rec.Payment_Status="Partially Paid";
                 	}
                 	else
                 	{
                 		po_rec.Payment_Status="Paid";
                 	}
                 	if(po_rec.PO_Status != "Cancelled")
                 	{
                 		payment_complete = false;
                 		if(po_rec.Payment_Status == "Paid")
                 		{
                 			payment_complete = true;
                 		}
                 		else if(po_rec.Payment_Status == "Not Payable")
                 		{
                 			payment_complete = true;
                 		}
                 		if(all_fully_received == true && all_fully_billed == true && payment_complete == true)
                 		{
                 			po_rec.PO_Status="Closed";
                 		}
                 		else
                 		{
                 			po_rec.PO_Status="Open";
                 		}
                 	}
                 	sync_resp = thisapp.po.push_po_status_to_store(po_rec.ID);
                 	info sync_resp;
                 }
				 map services.recalculate_weekly_weigh_bridge(int employee_vendor_id, date work_date, string truck_plate)
                 {
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("message","");
                 	result.put("weekly_total",1000000.0);
                 	result.put("trip_count",0);
                 	result.put("rate_per_trip",0.0);
                 	result.put("lines_updated",0);
                 	result.put("bill_id",null);
                 	result.put("distributed_total",0.0);
                 	// =====================================================
                 	// 1. VALIDATE PARAMETERS
                 	// =====================================================
                 	if(employee_vendor_id == null)
                 	{
                 		result.put("message","Hamid Ssenoga employee vendor ID is required.");
                 		return result;
                 	}
                 	if(work_date == null)
                 	{
                 		work_date = zoho.currentdate;
                 	}
                 	truck_plate = ifnull(truck_plate,"").trim();
                 	if(truck_plate == "")
                 	{
                 		result.put("message","Number Plate - Truck Register is required.");
                 		return result;
                 	}
                 	weekly_total = 1000000.0;
                 	// =====================================================
                 	// 2. CALCULATE MONDAY TO NEXT MONDAY
                 	// =====================================================
                 	day_number = work_date.getDayOfWeek();
                 	if(day_number == 1)
                 	{
                 		// Sunday belongs to the week beginning six days earlier
                 		days_to_monday = -6;
                 	}
                 	else
                 	{
                 		days_to_monday = 2 - day_number;
                 	}
                 	week_start = work_date.addDay(days_to_monday);
                 	next_week_start = week_start.addDay(7);
                 	week_number = week_start.getWeekOfYear();
                 	week_text = week_number.toString();
                 	if(week_number < 10)
                 	{
                 		week_text = "0" + week_text;
                 	}
                 	week_identifier = week_start.getYear().toString() + " Week " + week_text;
                 	// Bill Number now identifies both truck and week
                 	weekly_bill_number = truck_plate + " - " + week_identifier;
                 	result.put("week_start",week_start);
                 	result.put("next_week_start",next_week_start);
                 	result.put("truck_plate",truck_plate);
                 	result.put("week_identifier",week_identifier);
                 	result.put("bill_number",weekly_bill_number);
                 	// =====================================================
                 	// 3. LOAD VALID MOVEMENTS FOR THIS TRUCK AND THIS WEEK
                 	// =====================================================
                 	week_movements = Truck_Movement_Voucher[Time_Start >= week_start && Time_Start < next_week_start && Number_Plate_Truck_Register == truck_plate && Cancel_Voucher != true && Truck_Movement_Voucher_Status != "Cancelled"];
                 	if(week_movements.count() <= 0)
                 	{
                 		result.put("message","No Truck Movement records were found for truck " + truck_plate + " in " + week_identifier + ".");
                 		return result;
                 	}
                 	// =====================================================
                 	// 4. COUNT WEIGH BRIDGE TRIPS FOR THIS TRUCK ONLY
                 	// =====================================================
                 	weigh_bridge_trip_count = 0;
                 	for each  movement_rec in week_movements
                 	{
                 		for each  srv in movement_rec.Services
                 		{
                 			if(srv.Service != null)
                 			{
                 				service_name = ifnull(srv.Service.Service_Name,"").trim();
                 				if(service_name == "Weigh Bridge")
                 				{
                 					weigh_bridge_trip_count = weigh_bridge_trip_count + 1;
                 				}
                 			}
                 		}
                 	}
                 	if(weigh_bridge_trip_count <= 0)
                 	{
                 		result.put("message","No Weigh Bridge service rows were found for truck " + truck_plate + " in " + week_identifier + ".");
                 		return result;
                 	}
                 	// =====================================================
                 	// 5. CALCULATE RATE PER TRIP
                 	// =====================================================
                 	rate_per_trip = round(weekly_total / weigh_bridge_trip_count,2);
                 	result.put("trip_count",weigh_bridge_trip_count);
                 	result.put("rate_per_trip",rate_per_trip);
                 	// =====================================================
                 	// 6. FIND EXISTING BILL FOR THIS TRUCK AND THIS WEEK
                 	// =====================================================
                 	weigh_bridge_bill = Bill[Employee_Vendor == employee_vendor_id && Bill_Name == "Weigh Bridge" && Bill_Number == weekly_bill_number && Bill_Type == "Employee Bill"];
                 	bill_id = null;
                 	if(weigh_bridge_bill.ID != null)
                 	{
                 		bill_id = weigh_bridge_bill.ID;
                 	}
                 	else
                 	{
                 		// =================================================
                 		// 7. CREATE A BILL FOR THIS TRUCK AND THIS WEEK
                 		// =================================================
                 		bill_id = insert into Bill
                 		[
                 			Bill_Date=week_start
                 			Bill_Type="Employee Bill"
                 			Employee_Vendor=employee_vendor_id
                 			Display_Name_Vendor="Hamid Ssenoga - 50"
                 			Bill_Name="Weigh Bridge"
                 			Bill_Number=weekly_bill_number
                 			Bill_Total=weekly_total
                 			Services_Total=weekly_total
                 			Total_Amount=weekly_total
                 			Amount_Due=weekly_total
                 			Amount_Paid=0.0
                 			Balance_Due=weekly_total
                 			Bill_Status="Draft"
                 			Payment_Status="Not Paid"
                 			Added_User=zoho.loginuser
                 		];
                 		if(bill_id != null)
                 		{
                 			weigh_bridge_bill = Bill[ID == bill_id];
                 		}
                 	}
                 	if(weigh_bridge_bill.ID == null)
                 	{
                 		result.put("message","The weekly Weigh Bridge Employee Bill for truck " + truck_plate + " could not be created.");
                 		return result;
                 	}
                 	// =====================================================
                 	// 8. KEEP THIS TRUCK'S WEEKLY BILL AT 1,000,000
                 	// =====================================================
                 	paid_amount = ifnull(weigh_bridge_bill.Amount_Paid,0.0);
                 	balance_amount = weekly_total - paid_amount;
                 	if(balance_amount < 0)
                 	{
                 		balance_amount = 0.0;
                 	}
                 	weigh_bridge_bill.Bill_Date=week_start;
                 	weigh_bridge_bill.Bill_Type="Employee Bill";
                 	weigh_bridge_bill.Employee_Vendor=employee_vendor_id;
                 	weigh_bridge_bill.Display_Name_Vendor="Hamid Ssenoga - 50";
                 	weigh_bridge_bill.Bill_Name="Weigh Bridge";
                 	weigh_bridge_bill.Bill_Number=weekly_bill_number;
                 	weigh_bridge_bill.Bill_Total=weekly_total;
                 	weigh_bridge_bill.Services_Total=weekly_total;
                 	weigh_bridge_bill.Total_Amount=weekly_total;
                 	weigh_bridge_bill.Amount_Due=weekly_total;
                 	weigh_bridge_bill.Balance_Due=round(balance_amount,2);
                 	weigh_bridge_bill.Bill_Status="Draft";
                 	if(paid_amount <= 0)
                 	{
                 		weigh_bridge_bill.Payment_Status="Not Paid";
                 	}
                 	else if(balance_amount <= 0)
                 	{
                 		weigh_bridge_bill.Payment_Status="Paid";
                 	}
                 	else
                 	{
                 		weigh_bridge_bill.Payment_Status="Partially Paid";
                 	}
                 	bill_id = weigh_bridge_bill.ID;
                 	// =====================================================
                 	// 9. DISTRIBUTE 1,000,000 AMONG THIS TRUCK'S TRIPS
                 	// =====================================================
                 	updated_count = 0;
                 	distributed_total = 0.0;
                 	current_trip_number = 0;
                 	for each  movement_rec in week_movements
                 	{
                 		movement_has_weigh_bridge = false;
                 		movement_services_total = 0.0;
                 		movement_display = ifnull(movement_rec.Display_Name_Voucher,"").trim();
                 		if(movement_rec.Line_Number != null)
                 		{
                 			if(movement_display != "")
                 			{
                 				movement_display = movement_display + " - " + movement_rec.Line_Number.toString();
                 			}
                 			else
                 			{
                 				movement_display = movement_rec.Line_Number.toString();
                 			}
                 		}
                 		for each  srv in movement_rec.Services
                 		{
                 			if(srv.Service != null)
                 			{
                 				service_name = ifnull(srv.Service.Service_Name,"").trim();
                 				if(service_name == "Weigh Bridge")
                 				{
                 					movement_has_weigh_bridge = true;
                 					current_trip_number = current_trip_number + 1;
                 					line_rate = rate_per_trip;
                 					if(current_trip_number == weigh_bridge_trip_count)
                 					{
                 						line_rate = round(weekly_total - distributed_total,2);
                 					}
                 					srv.Quantity=1.0;
                 					srv.Rate=line_rate;
                 					srv.Bill=bill_id;
                 					srv.Display_Name_Bill="Weigh Bridge - " + weekly_bill_number;
                 					srv.Truck_Movement_Voucher=movement_rec.ID;
                 					srv.Display_Name_Voucher=movement_display;
                 					srv.Last_Synced_Group_ID=bill_id;
                 					srv.Last_Synced_Group_Amount=line_rate;
                 					movement_services_total = movement_services_total + line_rate;
                 					distributed_total = distributed_total + line_rate;
                 					updated_count = updated_count + 1;
                 				}
                 				else
                 				{
                 					movement_services_total = movement_services_total + ifnull(srv.Line_Total,0.0);
                 				}
                 			}
                 			else
                 			{
                 				movement_services_total = movement_services_total + ifnull(srv.Line_Total,0.0);
                 			}
                 		}
                 		// =================================================
                 		// 10. RECALCULATE PARENT MOVEMENT TOTALS
                 		// =================================================
                 		if(movement_has_weigh_bridge == true)
                 		{
                 			movement_rec.Service_Cost=round(movement_services_total,2);
                 			movement_rec.Line_Total=round(ifnull(movement_rec.Material_Cost,0.0) + ifnull(movement_rec.Service_Cost,0.0) + ifnull(movement_rec.Fuel_Cost,0.0) + ifnull(movement_rec.Labour_Cost,0.0),2);
                 			distance = ifnull(movement_rec.Line_Distance_Travelled,0.0);
                 			if(distance > 0)
                 			{
                 				movement_rec.Cost_Per_Odometer=round(movement_rec.Line_Total / distance,2);
                 			}
                 			else
                 			{
                 				movement_rec.Cost_Per_Odometer=0.0;
                 			}
                 		}
                 	}
                 	// =====================================================
                 	// 11. VERIFY DISTRIBUTION
                 	// =====================================================
                 	distributed_total = round(distributed_total,2);
                 	if(distributed_total != weekly_total)
                 	{
                 		result.put("message","Weigh Bridge distribution for truck " + truck_plate + " does not equal UGX 1,000,000.");
                 		result.put("distributed_total",distributed_total);
                 		return result;
                 	}
                 	// =====================================================
                 	// 12. RETURN RESULTS
                 	// =====================================================
                 	result.put("bill_id",bill_id);
                 	result.put("lines_updated",updated_count);
                 	result.put("distributed_total",distributed_total);
                 	result.put("ok",true);
                 	result.put("message","Weekly Weigh Bridge bill for truck " + truck_plate + " was recalculated successfully.");
                 	return result;
                 }
				 map truck.compute_sizes(decimal l, decimal w, decimal h1, decimal h2)
                 {
                 	// null-safe
                 	l = ifnull(l,0.0);
                 	w = ifnull(w,0.0);
                 	h1 = ifnull(h1,0.0);
                 	h2 = ifnull(h2,0.0);
                 	out = Map();
                 	out.put("size1",(l * w * h1).round(3));
                 	out.put("size2",(l * w * (h1 + h2)).round(3));
                 	return out;
                 }
				 void voucher.update_supervisor_voucher_summary(int voucher_id)
                 {
                 	if(voucher_id != null && voucher_id > 0)
                 	{
                 		current_voucher = Voucher_Register[ID == voucher_id];
                 		if(current_voucher.ID != null)
                 		{
                 			supervisor_ids = List();
                 			current_type = ifnull(current_voucher.Display_Name_Voucher_Type,"");
                 			// Current record may itself be a supervisor voucher
                 			if(current_type.contains("Supervisor Voucher"))
                 			{
                 				supervisor_ids.add(current_voucher.ID);
                 			}
                 			// Supervisor who issued the current voucher
                 			if(current_voucher.Issued_By != null)
                 			{
                 				issued_supervisor_id = current_voucher.Issued_By.ID;
                 				if(issued_supervisor_id != null && !supervisor_ids.contains(issued_supervisor_id))
                 				{
                 					supervisor_ids.add(issued_supervisor_id);
                 				}
                 			}
                 			// Supervisor who received the returned voucher
                 			if(current_voucher.Received_By != null)
                 			{
                 				received_supervisor_id = current_voucher.Received_By.ID;
                 				if(received_supervisor_id != null && !supervisor_ids.contains(received_supervisor_id))
                 				{
                 					supervisor_ids.add(received_supervisor_id);
                 				}
                 			}
                 			for each  supervisor_id in supervisor_ids
                 			{
                 				supervisor_voucher = Voucher_Register[ID == supervisor_id];
                 				if(supervisor_voucher.ID != null)
                 				{
                 					supervisor_type = ifnull(supervisor_voucher.Display_Name_Voucher_Type,"");
                 					if(supervisor_type.contains("Supervisor Voucher"))
                 					{
                 						// =============================================
                 						// CURRENT SUPERVISOR COUNTS
                 						// =============================================
                 						issued_count = Voucher_Register[Issued_By == supervisor_id].count();
                 						returned_count = Voucher_Register[Received_By == supervisor_id].count();
                 						// =============================================
                 						// FIND IMMEDIATELY PREVIOUS SUPERVISOR VOUCHER
                 						// =============================================
                 						opening_count = 0;
                 						latest_previous_id = 0;
                 						latest_previous_time = null;
                 						if(supervisor_voucher.Employee != null && supervisor_voucher.Date_Time_In != null)
                 						{
                 							previous_supervisors = Voucher_Register[Employee == supervisor_voucher.Employee && Date_Time_In < supervisor_voucher.Date_Time_In];
                 							for each  previous_sv in previous_supervisors
                 							{
                 								previous_type = ifnull(previous_sv.Display_Name_Voucher_Type,"");
                 								if(previous_type.contains("Supervisor Voucher") && previous_sv.Date_Time_In != null)
                 								{
                 									if(latest_previous_time == null || previous_sv.Date_Time_In > latest_previous_time)
                 									{
                 										latest_previous_time = previous_sv.Date_Time_In;
                 										latest_previous_id = previous_sv.ID;
                 									}
                 								}
                 							}
                 							if(latest_previous_id > 0)
                 							{
                 								latest_previous = Voucher_Register[ID == latest_previous_id];
                 								if(latest_previous.ID != null)
                 								{
                 									opening_count = ifnull(latest_previous.Outstanding_Vouchers,0);
                 								}
                 							}
                 						}
                 						if(opening_count < 0)
                 						{
                 							opening_count = 0;
                 						}
                 						// =============================================
                 						// OUTSTANDING BALANCE
                 						// =============================================
                 						outstanding_count = opening_count + issued_count - returned_count;
                 						if(outstanding_count < 0)
                 						{
                 							outstanding_count = 0;
                 						}
                 						// =============================================
                 						// UPDATE SUPERVISOR VOUCHER
                 						// =============================================
                 						supervisor_voucher.Opening_Vouchers=opening_count;
                 						supervisor_voucher.Vouchers_Issued=issued_count;
                 						supervisor_voucher.Vouchers_Returned=returned_count;
                 						supervisor_voucher.Outstanding_Vouchers=outstanding_count;
                 						info "Supervisor Voucher: " + ifnull(supervisor_voucher.Voucher_Number,"");
                 						info "Opening: " + opening_count + ", Issued: " + issued_count + ", Returned: " + returned_count + ", Outstanding: " + outstanding_count;
                 					}
                 				}
                 			}
                 		}
                 	}
                 }
			 }
		 }


		workflow
		{
		form
		{
			On_Customer_Name_Selected as "On Customer Name Selected"
			{
				type =  form
				form = Customer_Register

				record event = on add or edit

				on user input of Customer_Name
				{
					actions 
					{
						custom deluge script
						(
											if(input.Customer_Name != null)
										{
											input.Display_Name_Customer = input.Customer_Name;
										}
										else
										{
											input.Display_Name_Customer = "";
										}
						)
					}
				}

			}
			On_Customer_Selected as "On Customer Selected"
			{
				type =  form
				form = Customer_Register

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											if(input.Customer_Name != null)
										{
											input.Display_Name_Customer = input.Customer_Name;
										}
										else
										{
											input.Display_Name_Customer = "";
										}
						)
					}
				}

			}
			Full_Validation as "Full Validation"
			{
				type =  form
				form = Customer_Register

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Customer Type required
										if(input.Customer_Type == null || input.Customer_Type == "")
										{
											alert "Please select Customer Type.";
											cancel submit;
										}
										// Cash customer validation
										if(input.Customer_Type == "Cash")
										{
											if(input.Customer_Name == null || input.Customer_Name.trim() == "")
											{
												alert "Please enter Customer Name.";
												cancel submit;
											}
											input.Customer = null;
											input.Credit_Allowed = false;
											input.Credit_Limit = 0;
											input.Credit_Days_Allowed = 0;
											input.Current_Outstanding_Balance = 0;
											input.Available_Credit = 0;
											input.Credit_Status = "Good Standing";
											// Customer Code generation - Cash only
											if(input.Customer_Code == null || input.Customer_Code == "")
											{
												count = Customer_Register.count();
												next_no = count + 1;
												if(next_no < 10)
												{
													num_text = "00" + next_no;
												}
												else if(next_no < 100)
												{
													num_text = "0" + next_no;
												}
												else
												{
													num_text = "" + next_no;
												}
												input.Customer_Code = "CP" + num_text;
											}
										}
										// Credit customer validation
										if(input.Customer_Type == "Credit")
										{
											if(input.Customer == null)
											{
												alert "Please select Customer.";
												cancel submit;
											}
											input.Customer_Name = input.Customer.Party_Name_ID;
											input.Display_Name_Customer = input.Customer.Party_Name_ID;
											// Credit customers must not have Customer Code
											input.Customer_Code = "";
										}
										// Display Name Customer
										if(input.Customer_Type == "Cash")
										{
											input.Display_Name_Customer = input.Customer_Name + " - " + input.Customer_Code;
										}
										else if(input.Customer_Type == "Credit")
										{
											input.Display_Name_Customer = input.Customer_Name;
										}
										// Tax Invoice validation
										if(input.Tax_Invoice_Required == true)
										{
											if(input.TIN_Number == null || input.TIN_Number.trim() == "")
											{
												alert "Please enter TIN Number because Tax Invoice is required.";
												cancel submit;
											}
										}
										else
										{
											input.TIN_Number = "";
										}
										// Credit calculations
										input.Current_Outstanding_Balance = ifnull(input.Current_Outstanding_Balance,0);
										input.Credit_Limit = ifnull(input.Credit_Limit,0);
										input.Available_Credit = input.Credit_Limit - input.Current_Outstanding_Balance;
										if(input.Credit_Allowed == true)
										{
											if(input.Current_Outstanding_Balance > input.Credit_Limit)
											{
												input.Credit_Status = "Over Limit";
											}
											else
											{
												input.Credit_Status = "Good Standing";
											}
										}
										else
										{
											input.Credit_Status = "On Hold";
										}
						)
					}
				}

			}
