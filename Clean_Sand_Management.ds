										resp = payment_management.deletePaymentVoucherFromCleanSand(payload);
										info resp;
										payload = Map();
										payload.put("Source_Form","Payment Made Voucher");
										payload.put("Source_Record_ID",input.ID);
										resp = payment_management.deleteAccountTransactionLog(payload);
										info resp;
