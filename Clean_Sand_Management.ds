			Full_Validation15 as "Full Validation"
			{
				type =  form
				form = Truck_Register

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										if(input.Number_Plate == null || input.Number_Plate.trim() == "")
										{
											errors = errors + "\n• Number Plate is required.";
										}
										else
										{
											np = input.Number_Plate.trim();
											dup = Truck_Register[Number_Plate == np && ID != input.ID];
											if(dup.count() > 0)
											{
												errors = errors + "\n• This Number Plate already exists.";
											}
										}
										if(input.Truck_Type == null)
										{
											errors = errors + "\n• Truck Type is required.";
										}
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
