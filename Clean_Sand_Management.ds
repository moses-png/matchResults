												{
													input.Voucher = startRec.Voucher.ID;
													input.Display_Name_Voucher = ifnull(startRec.Display_Name_Voucher,"");
													input.Display_Name_Employee = ifnull(startRec.Display_Name_Employee,"");
													input.Display_Name_Site = ifnull(startRec.Display_Name_Site,"");
												}
												if(startRec.Asset != null)
												{
													assetName = ifnull(startRec.Asset.Asset_Name,"").trim();
													assetID = "";
													if(startRec.Asset.Asset_ID != null)
													{
														assetID = startRec.Asset.Asset_ID.toString().trim();
													}
													if(assetName != "" && assetID != "")
													{
														input.Display_Name_Asset = assetName + " - " + assetID;
													}
													else if(assetName != "")
													{
														input.Display_Name_Asset = assetName;
													}
													else if(assetID != "")
													{
														input.Display_Name_Asset = assetID;
													}
													else
													{
														input.Display_Name_Asset = null;
													}
													input.Number_Plate_Truck_Register = assetName;
												}
											}
										}
						)
					}
				}

			}
			Full_Validation_On_Delete2 as "Full Validation On Delete"
			{
				type =  form
