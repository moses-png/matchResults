			Full_Validation_On_Create1 as "Full Validation On Create"
			{
				type =  form
				form = Truck_Register

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											seq = Sequences[Sequence_Key == "TSF" && Is_Active == true];
										if(seq.ID == null)
										{
											alert "TSF sequence not found.";
											cancel submit;
										}
										next_no = ifnull(seq.Next_Number,1);
										max_no = ifnull(seq.Max_Number,9999);
										if(next_no > max_no)
										{
											alert "TSF Next Number has reached the Max Number.";
											cancel submit;
										}
										if(next_no < 10)
										{
											num_str = "000" + next_no;
										}
										else if(next_no < 100)
										{
											num_str = "00" + next_no;
										}
										else if(next_no < 1000)
										{
											num_str = "0" + next_no;
										}
										else
										{
											num_str = "" + next_no;
										}
										input.TSF_Number = "TSF" + num_str;
										seq.Next_Number=next_no + 1;
						)
					}
				}

			}
			Full_Validation19 as "Full Validation"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										if(input.Sales_Type == null || input.Sales_Type == "")
										{
											errors = errors + "\n• Sales Type is required.";
										}
										if(errors != "")
										{
											alert errors;
											cancel submit;
										}
										// -------------------------------
										// Voucher Validation
										// -------------------------------
										if(input.Voucher == null)
										{
											errors = errors + "\n• Voucher is required.";
										}
										// -------------------------------
										// Customer Validation
										// -------------------------------
										if(input.Customer == null)
										{
											errors = errors + "\n• Customer is required.";
										}
										// -------------------------------
										// Delivery Note Validation
										// -------------------------------
										if(input.Customer != null)
										{
											if(input.Customer.Delivery_Note_Required == true)
											{
												if(input.Delivery_Note == null)
												{
													errors = errors + "\n• Delivery Note is required for this customer.";
												}
											}
										}
										if(input.Sales_Type == "Item Sales")
										{
											for each  row in input.Product_Details
											{
												if(row.Item == null)
												{
													alert "Please select Item on line " + row.Line_Number;
													cancel submit;
												}
												if(row.Store_Item_Stock == null)
												{
													alert "Please select Store Item Stock on line " + row.Line_Number;
													cancel submit;
												}
												if(row.Unit_Of_Measure == null)
												{
													alert "Please select Unit Of Measure on line " + row.Line_Number;
													cancel submit;
												}
												if(row.Quantity == null || row.Quantity <= 0)
												{
													alert "Please enter Quantity greater than 0 on line " + row.Line_Number;
													cancel submit;
												}
											}
										}
										// -------------------------------
										// SAND SALES VALIDATION
										// -------------------------------
										if(input.Sales_Type == "Sand Sales")
										{
											if(input.Item == null)
											{
												errors = errors + "\n• Item is required for Sand Sales.";
											}
											if(input.Unit_Of_Measure == null)
											{
												errors = errors + "\n• Unit Of Measure is required for Sand Sales.";
											}
											if(input.Store_Item_Stock == null)
											{
												errors = errors + "\n• Store Item Stock is required for Sand Sales.";
											}
											if(input.Number_Plate == null)
											{
												errors = errors + "\n• Number Plate is required for Sand Sales.";
											}
											if(input.Truck_Measurement == null)
											{
												errors = errors + "\n• Truck Measurement is required for Sand Sales.";
											}
											if(input.Truck_Size == null || input.Truck_Size == "")
											{
												errors = errors + "\n• Truck Size is required for Sand Sales.";
											}
											if(ifnull(input.Truck_CBM,0.0) <= 0)
											{
												errors = errors + "\n• Truck CBM must be greater than 0.";
											}
											if(ifnull(input.Rate_per_CBM,0.0) <= 0)
											{
												errors = errors + "\n• Rate per CBM must be greater than 0.";
											}
											if(ifnull(input.Quantity_Available,0.0) < ifnull(input.Truck_CBM,0.0))
											{
												errors = errors + "\n• Quantity Available is less than Truck CBM.";
											}
										}
										// -------------------------------
										// FINAL ERROR
										// -------------------------------
										if(errors != "")
										{
											alert errors;
											cancel submit;
										}
						)
					}
				}

			}
			Full_Validation20 as "Full Validation"
			{
				type =  form
				form = Truck_Type

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										if(input.Truck_Type_Name == null || input.Truck_Type_Name.trim() == "")
										{
											errors = errors + "\n• Truck Type Name is required.";
										}
										else
										{
											name = input.Truck_Type_Name.trim();
											dup = Truck_Type[Truck_Type_Name == name && ID != input.ID];
											if(dup.count() > 0)
											{
												errors = errors + "\n• Truck Type Name already exists.";
											}
										}
										if(input.Truck_Type_Status == null || input.Truck_Type_Status == "")
										{
											errors = errors + "\n• Truck Type Status is required.";
										}
										if(errors != "")
										{
											alert errors;
											cancel submit;
										}
						)
					}
				}

			}
