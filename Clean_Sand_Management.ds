				type = section
				displayname = "Receiving Section"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Stock_Created
			(
				type = picklist	
				displayname = "Stock Created"
				values  = Stock_Bundling_Note[Voucher.Voucher_Number == input.Voucher.Voucher_Number && Stock_Status == "Pending"].ID
    			displayformat = [Display_Name_Item + " - " + Quantity_To_Be_Created]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Item
			(
				type = picklist	
				values  = Purchase_Order_Details[Display_Name_Purchase_Order == input.Display_Name_Voucher && Receiving_Status != "Fully Received" && Quantity_Remaining > 0 && Purchase_Order.PO_Status == "Open"].ID
    			displayformat = [Display_Name_Item + " - " + Quantity_Remaining]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
