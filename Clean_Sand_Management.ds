											hide Cancel_Work_Order;
											hide Reason_Why_Cancelled;
											hide Issue_Status1;
										}
										else
										{
											input.Issue_Status = "Open";
											input.Reason_Why_Resolved = "";
											hide Reason_Why_Resolved;
											show Work_Order_Number;
											show Work_Order_Date;
											show Work_Order_Odometer_Reading;
											show Work_Order_in_Charge_Of;
											show Work_Order_Status;
											show Cancel_Work_Order;
											show Issue_Status1;
										}
						)
					}
				}

			}
