				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Services
			(
				type = grid
				values  = Service_Details.ID
    			bidirectional = Bill
	 			row = 2
	 			column = 1   
				width = medium
			)
			Bill_Details
			(
				type = grid
				displayname = "Bill Details"
				values  = Bill_Details.ID
