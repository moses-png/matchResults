			Set_Up_Form6 as "Set Up Form"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//HIDE FIELDS
										//Voucher Details
										//hide Sales_Voucher_Number;
										hide Sales_Voucher_Date;
										hide Display_Name_Customer;
										hide Display_Name_Site;
										hide Display_Name_Voucher;
										hide Display_Name_Employee;
										hide Display_Name_Item;
										hide Display_Name_Unit_Of_Measure;
										hide Display_Name_Store;
										hide Store;
										hide Display_Name_Delivery_Note;
										hide Card_Number;
										hide Cancel_Voucher;
										hide Bill;
										hide Truck_Movement_Details;
										hide Tractor_Work_Details;
										//Totals Section
										hide Discount_Percentage;
										hide Discount_Amount;
										hide Reason_Why_Cancelled;
										hide Settling_Section;
										//Back_End;
										hide Back_End;
										//SUBFORMS
										//Product Details
										hide Product_Details.Display_Name_Sales_Voucher;
										hide Product_Details.Display_Name_Item;
										hide Product_Details.Store;
										hide Product_Details.Display_Name_Store;
										hide Product_Details.Display_Name_Unit_Of_Measure;
										hide Product_Details.Quantity_in_Base_Unit_Of_Measure;
										hide Product_Details.Base_Unit_Of_Measure;
										hide Product_Details.Display_Name_Base_Unit_Of_Measure;
										hide Product_Details.Display_Name_Division;
										hide Product_Details.Display_Name_Business_Site;
										hide Product_Details.Business_Division;
										hide Product_Details.Display_Name_Business_Division;
										hide Product_Details.Quantity_Not_Issued_in_Base_Unit_Of_Measure;
										hide Product_Details.Quantity_Issued_in_Base_Unit_Of_Measure;
										hide Product_Details.Issue_Status;
										disable Product_Details.Display_Name_Division;
										disable Product_Details.Display_Name_Business_Site;
										disable Product_Details.Display_Name_Business_Division;
										//Item Issuing Details
										hide Item_Issuing_Details;
										//Payment Receipt Details
										hide Payment_Receipt_Details;
										//DISABLE FIELDS
										disable Sales_Voucher_Number;
										disable Sales_Voucher_Date;
										disable Display_Name_Customer;
										disable Sub_Total;
										disable Tax_Amount;
										disable Discount_Percentage;
										disable Discount_Amount;
										disable Amount_Paid;
										disable Amount_Credited;
										disable Grand_Total;
										disable Balance_Due;
										disable Truck_Size_2;
										disable Truck_Size_1;
										disable Truck_Type;
										disable Payment_Status;
										disable Truck_CBM;
										disable Quantity_Available;
										disable Card_Number;
										disable Product_Details.Display_Name_Sales_Voucher;
										disable Product_Details.Display_Name_Item;
										disable Product_Details.Display_Name_Store;
										disable Product_Details.Display_Name_Unit_Of_Measure;
										disable Product_Details.Quantity_Available;
										disable Product_Details.Line_Total;
										disable Product_Details.Tax_Amount;
										//SUBFORMS
										//Product Details
										disable Product_Details.Display_Name_Sales_Voucher;
										disable Product_Details.Line_Number;
										disable Product_Details.Display_Name_Item;
										disable Product_Details.Store;
										disable Product_Details.Display_Name_Store;
										disable Product_Details.Quantity_Available;
										disable Product_Details.Display_Name_Unit_Of_Measure;
										disable Product_Details.Base_Unit_Of_Measure;
										disable Product_Details.Display_Name_Base_Unit_Of_Measure;
										disable Product_Details.Line_Total;
										disable Product_Details.Tax_Amount;
										if(input.ID == null)
										{
											input.Payment_Status = "Unpaid";
											input.Sales_Voucher_Date = zoho.currentdate;
											input.Sub_Total = 0;
											input.Tax_Amount = 0;
											input.Discount_Amount = 0;
											input.Grand_Total = 0;
											input.Balance_Due = 0;
										}
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										//Sand Sales
										hide Sand_Sales;
										hide Delivery_Note;
										hide Number_Plate;
										hide Display_Name_Number_Plate;
										hide Truck_Type;
										hide Truck_Measurement;
										hide Truck_Size_1;
										hide Truck_Size_2;
										hide Truck_Size;
										hide Truck_CBM;
										if(input.Sales_Type == "Sand Sales")
										{
											show Sand_Sales;
											show Number_Plate;
											show Truck_Type;
											show Card_Number;
											show Truck_Measurement;
											show Truck_Size_1;
											show Truck_Size_2;
											show Truck_Size;
											show Truck_CBM;
											show Item;
											show Unit_Of_Measure;
											show Store_Item_Stock;
											show Quantity_Available;
											hide Product_Details;
										}
										else
										{
											hide Sand_Sales;
											hide Number_Plate;
											hide Delivery_Note;
											hide Truck_Type;
											hide Card_Number;
											hide Truck_Measurement;
											hide Truck_Size_1;
											hide Truck_Size_2;
											hide Truck_Size;
											hide Truck_CBM;
											hide Item;
											hide Unit_Of_Measure;
											hide Store_Item_Stock;
											hide Quantity_Available;
											show Product_Details;
										}
										// =====================================================
										// LOCK PAID SALES VOUCHERS
										// =====================================================
										if(input.Payment_Status == "Paid")
										{
											disable Customer;
											disable Sales_Type;
											disable Voucher;
											//disable Item;
											//disable Unit_Of_Measure;
											//disable Store_Item_Stock;
											//disable Quantity_Available;
											//disable Delivery_Note;
											//disable Number_Plate;
											//disable Truck_Type;
											//disable Truck_Measurement;
											//disable Truck_Size_1;
											//disable Truck_Size_2;
											//disable Truck_Size;
											//disable Truck_CBM;
											//disable Discount_Type;
											//disable Sand_Sales;
											// Product Details subform
											disable Product_Details.Line_Number;
											disable Product_Details.Item;
											disable Product_Details.Store_Item_Stock;
											disable Product_Details.Quantity_Available;
											disable Product_Details.Unit_Of_Measure;
											disable Product_Details.Quantity;
											disable Product_Details.Unit_Price;
											disable Product_Details.Line_Total;
											disable Product_Details.Tax_Amount;
											disable Product_Details.Tax_Type;
											disable Payment_Status;
										}
										// =====================================
										// SERVICES SUBFORM
										// =====================================
										hide Services.Bill;
										hide Services.Display_Name_Voucher;
										hide Services.Display_Name_Service;
										hide Services.Last_Synced_Group_Amount;
										hide Services.Last_Synced_Group_ID;
										hide Services.Display_Name_Bill;
										hide Services.Invoice;
										hide Services.User_Name;
										hide Services.User_Email;
										hide Services.User_Role;
										hide Services.Created_By_Name;
										hide Services.Created_By_Email;
										hide Services.Created_By_Time;
										hide Services.Updated_By_Name;
										hide Services.Updated_By_Email;
										hide Services.Updated_By_Time;
										hide Services.Back_End;
						)
					}
				}

			}
