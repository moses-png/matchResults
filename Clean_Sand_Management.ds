			Finalize as "Finalize"
			{
				type =  form
				form = Asset_Issues

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// CONCRETE PRODUCTS - ASSET ISSUE FINALIZE
										// =====================================================
										current_issue_status = ifnull(input.Issue_Status,"").toString().trim();
										current_work_order_status = ifnull(input.Work_Order_Status,"").toString().trim();
										has_work_order = false;
										if(input.Work_Order_Number != null && input.Work_Order_Number.toString().trim() != "")
										{
											has_work_order = true;
										}
										if(input.Asset != null && input.ID != null)
										{
											mile_resp = asset_management.logMileageFromConcrete(input.Asset.ID,ifnull(input.Odometer_Reading,0.0),input.Reported_Date,ifnull(input.Issue_Number,""),"Asset Issues",input.ID.toString());
											info "CONCRETE PRODUCTS ASSET ISSUE MILEAGE RESPONSE:";
											info mile_resp;
										}
										else if(input.Asset == null)
										{
											info "Mileage log skipped because Asset is unavailable.";
										}
										else
										{
											info "Mileage log skipped because Source Record ID is unavailable.";
										}
										if(input.Resolve_Issue == true)
										{
											input.Issue_Status = "Resolved";
											input.Work_Order_Status = "Cancelled";
										}
										else if(input.Cancel_Work_Order == true)
										{
											input.Issue_Status = "Cancelled";
											input.Work_Order_Status = "Cancelled";
										}
										else if(has_work_order == true)
										{
											if(current_issue_status != "Resolved" && current_issue_status != "Cancelled")
											{
												input.Issue_Status = "In Progress";
											}
											else
											{
												input.Issue_Status = current_issue_status;
											}
											if(current_work_order_status == "" || current_work_order_status == "Draft")
											{
												input.Work_Order_Status = "Pending";
											}
											else
											{
												input.Work_Order_Status = current_work_order_status;
											}
										}
										else
										{
											if(current_issue_status == "")
											{
												input.Issue_Status = "Draft";
											}
											else
											{
												input.Issue_Status = current_issue_status;
											}
											if(current_work_order_status == "")
											{
												input.Work_Order_Status = "Draft";
											}
											else
											{
												input.Work_Order_Status = current_work_order_status;
											}
										}
										status_to_sync = ifnull(input.Issue_Status,"").toString().trim();
										if(status_to_sync == "")
										{
											status_to_sync = "Draft";
											input.Issue_Status = "Draft";
										}
										if(input.ID != null)
										{
											asset_issue_payload = Map();
											asset_issue_payload.put("Source_Record_ID",input.ID.toString());
											asset_issue_payload.put("Source_Form","Concrete Products Management - Asset Issues");
											asset_issue_payload.put("Voucher",input.Voucher);
											asset_issue_payload.put("Reported_By",input.Reported_By);
											asset_issue_payload.put("Site",input.Site);
											asset_issue_payload.put("Issue_Number",input.Issue_Number);
											asset_issue_payload.put("Asset",input.Asset);
											asset_issue_payload.put("Display_Name_Asset",input.Display_Name_Asset);
											asset_issue_payload.put("Current_Site",input.Current_Site);
											asset_issue_payload.put("Current_Custodian",input.Current_Custodian);
											asset_issue_payload.put("Odometer_Reading",ifnull(input.Odometer_Reading,0.0));
											asset_issue_payload.put("Reported_Date",input.Reported_Date);
											asset_issue_payload.put("Issue",input.Issue);
											asset_issue_payload.put("Issue_Description",input.Issue_Description);
											asset_issue_payload.put("Severity",input.Severity);
											asset_issue_payload.put("Status",status_to_sync);
											asset_issue_response = asset_management.syncAssetIssueFromConcreteProducts(asset_issue_payload);
											info "CONCRETE PRODUCTS ASSET ISSUE SYNC RESPONSE:";
											info asset_issue_response;
										}
										else
										{
											info "Asset Issue sync skipped because Source Record ID is unavailable.";
										}
						)
					}
				}

			}
			Finalize8 as "Finalize"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------------------------------------
										// BACK END AUDIT INFO - CORRECTED FINAL-TASK CLOSURE
										// ------------------------------------------------------------
										u = thisapp.audit.getLoginAuditInfo();
										user_name_val = u.get("name");
										user_email_val = u.get("email");
										user_role_val = u.get("role");
										// ------------------------------------------------------------
										// Calculate Parts_Consumables rows
										// ------------------------------------------------------------
										labour_total = 0.0;
										parts_total = 0.0;
										if(input.Parts_Consumables != null && input.Parts_Consumables.count() > 0)
										{
											for each  r in input.Parts_Consumables
											{
												r.Display_Name_Work_Order_Task_Number=ifnull(input.Work_Order_Task_Number,"");
												if(r.Labour != null)
												{
													r.Line_Total=thisapp.asset_calc.asset_calc_line_total(ifnull(r.Quantity,0.0),ifnull(r.Unit_Cost,0.0));
													labour_total = labour_total + ifnull(r.Line_Total,0.0);
												}
												else if(r.Item != null)
												{
													r.Line_Total=thisapp.asset_calc.asset_calc_line_total(ifnull(r.Quantity_In_Base_Unit,0.0),ifnull(r.Unit_Cost,0.0));
													parts_total = parts_total + ifnull(r.Line_Total,0.0);
												}
												else
												{
													r.Line_Total=0.0;
												}
											}
										}
										input.Labour_Total = round(labour_total,2);
										input.Parts_Total = round(parts_total,2);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Labour_Total,input.Parts_Total);
										// Put this after task creation/update success
										if(input.Issue != null)
										{
											issue_rec = Asset_Issues[ID == input.Issue.ID];
											if(issue_rec.ID != null)
											{
												task_count = 0;
												labour_total = 0.0;
												parts_total = 0.0;
												service_total = 0.0;
												start_date = null;
												start_odo = null;
												task_list = Work_Order_Tasks[Issue == issue_rec.ID];
												for each  t in task_list
												{
													task_count = task_count + 1;
													labour_total = labour_total + ifnull(t.Labour_Total,0.0);
													parts_total = parts_total + ifnull(t.Parts_Total,0.0);
													service_total = service_total + ifnull(t.Grand_Total,0.0);
													if(start_date == null && t.Date_Time_Approved != null)
													{
														start_date = t.Date_Time_Approved;
													}
													if(start_odo == null && t.Odometer_Reading_Approved != null)
													{
														start_odo = t.Odometer_Reading_Approved;
													}
												}
												issue_rec.Number_Of_Work_Order_Tasks=task_count;
												issue_rec.Labour_Total=labour_total;
												issue_rec.Parts_Total=parts_total;
												issue_rec.Total_Service_Task_Cost=service_total;
												if(task_count > 0 && ifnull(issue_rec.Work_Order_Status,"") != "Completed")
												{
													issue_rec.Work_Order_Status="In Progress";
													if(issue_rec.Overall_Start_Date == null)
													{
														issue_rec.Overall_Start_Date=ifnull(start_date,zoho.currenttime);
													}
													if(issue_rec.Odometer_Reading_Started == null)
													{
														issue_rec.Odometer_Reading_Started=ifnull(start_odo,issue_rec.Odometer_Reading);
													}
												}
											}
										}
										// ------------------------------------------------------------
										// Skip new unsaved records
										// ------------------------------------------------------------
										if(input.ID == null)
										{
											if(input.Issue != null)
											{
												thisapp.asset_issues.asset_issues_update_summary(input.Issue.ID);
											}
											return;
										}
										// ------------------------------------------------------------
										// Cancel Work Order
										// ------------------------------------------------------------
										if(input.Cancel_This_Work_Order == true)
										{
											input.Work_Order_Task_Status = "Cancelled";
											input.Date_Time_Approved = zoho.currenttime;
											input.Approved_By_Email = user_email_val;
											if(input.Issue != null)
											{
												thisapp.asset_issues.asset_issues_update_summary(input.Issue.ID);
											}
											return;
										}
										current_status = ifnull(input.Work_Order_Task_Status,"Requested").trim();
										// ------------------------------------------------------------
										// 1) Requested -> Repairing
										// ------------------------------------------------------------
										if(current_status == "" || current_status == "Requested")
										{
											if(input.Odometer_Reading_Approved != null)
											{
												input.Work_Order_Task_Status = "Repairing";
												input.Date_Time_Approved = zoho.currenttime;
												input.Approved_By_Email = user_email_val;
												if(input.Asset != null)
												{
													mile_resp_start = asset_management.logMileageFromConcrete(input.Asset,ifnull(input.Odometer_Reading_Approved,0.0),input.Date_Time_Approved,ifnull(input.Work_Order_Task_Number,""),"Concrete Products - Work Order Task Start",input.ID.toString());
													info mile_resp_start;
												}
												if(input.Parts_Consumables != null && input.Parts_Consumables.count() > 0)
												{
													for each  pc_row in input.Parts_Consumables
													{
														if(pc_row.ID != null)
														{
															qty_val = ifnull(pc_row.Quantity,0.0);
															rate_val = ifnull(pc_row.Unit_Cost,0.0);
															account_text = "";
															current_site_text = "";
															if(input.Asset != null)
															{
																account_text = ifnull(input.Asset.Asset_Name,"") + " - " + ifnull(input.Asset.Asset_ID,"");
																current_site_text = ifnull(input.Asset.Current_Site,"");
															}
															task_number = ifnull(input.Work_Order_Task_Number,"");
															line_number = ifnull(pc_row.Line_Number,0);
															reference_text = task_number;
															if(line_number > 0)
															{
																if(reference_text != "")
																{
																	reference_text = reference_text + " - " + line_number;
																}
																else
																{
																	reference_text = "" + line_number;
																}
															}
															existing_bd = Bill_Details[Parts_Consumables == pc_row.ID && Source_Record_ID == input.ID && Source_Form == "Concrete Products Management - Work Order Tasks"];
															if(existing_bd.count() > 0)
															{
																for each  bd in existing_bd
																{
																	bd.Parts_Consumables=pc_row.ID;
																	bd.Line_Number=pc_row.Line_Number;
																	bd.Reference=reference_text;
																	bd.Display_Name_Item=ifnull(pc_row.Display_Name_Item_Labour,"");
																	bd.Details=ifnull(pc_row.Description,"");
																	bd.Details_Date=zoho.currentdate;
																	bd.Quantity=qty_val;
																	bd.Rate=rate_val;
																	bd.Account=account_text;
																	bd.Current_Site=current_site_text;
																	bd.Source_Record_ID=input.ID;
																	bd.Source_Form="Concrete Products Management - Work Order Tasks";
																	bd.Bill_Details_Status="Draft";
																	break;
																}
															}
															else
															{
																insert into Bill_Details
																[
																	Line_Number=pc_row.Line_Number
																	Reference=reference_text
																	Details_Date=zoho.currentdate
																	Parts_Consumables=pc_row.ID
																	Display_Name_Item=ifnull(pc_row.Display_Name_Item_Labour,"")
																	Details=ifnull(pc_row.Description,"")
																	Quantity=qty_val
																	Rate=rate_val
																	Account=account_text
																	Current_Site=current_site_text
																	Source_Record_ID=input.ID
																	Source_Form="Concrete Products Management - Work Order Tasks"
																	Bill_Details_Status="Draft"
																	Added_User=zoho.loginuser
																]
															}
															pc_row.Item_Status="Billed";
														}
													}
												}
											}
										}
										// ------------------------------------------------------------
										// 2) Repairing -> Checking
										// ------------------------------------------------------------
										else if(current_status == "Repairing")
										{
											if(input.Odometer_Reading_Completed != null)
											{
												input.Work_Order_Task_Status = "Checking";
												input.Date_Time_Work_Completed = zoho.currenttime;
												input.Completed_By_Email = user_email_val;
												if(input.Asset != null)
												{
													mile_resp_completed = asset_management.logMileageFromConcrete(input.Asset,ifnull(input.Odometer_Reading_Completed,0.0),input.Date_Time_Work_Completed,ifnull(input.Work_Order_Task_Number,""),"Concrete Products - Work Order Task Completed",input.ID.toString());
													info mile_resp_completed;
												}
											}
										}
										// ------------------------------------------------------------
										// 3) Checking -> Invoicing
										// ------------------------------------------------------------
										else if(current_status == "Checking")
										{
											if(input.Odometer_Reading_Checked != null && input.Service_Task_Checkbox != null && input.Service_Task_Checkbox.size() == 3)
											{
												input.Work_Order_Task_Status = "Invoicing";
												input.Date_Time_Work_Checked = zoho.currenttime;
												input.Checked_By_Email = user_email_val;
												if(input.Asset != null)
												{
													mile_resp_checked = asset_management.logMileageFromConcrete(input.Asset,ifnull(input.Odometer_Reading_Checked,0.0),input.Date_Time_Work_Checked,ifnull(input.Work_Order_Task_Number,""),"Concrete Products - Work Order Task Checked",input.ID.toString());
													info mile_resp_checked;
													cost_resp = asset_management.updateAssetCostSummaryFromConcrete(input.Asset.ID,input.Labour_Total,input.Parts_Total);
													info cost_resp;
												}
												if(input.Parts_Consumables != null && input.Parts_Consumables.count() > 0)
												{
													for each  pc_row in input.Parts_Consumables
													{
														if(pc_row.ID != null)
														{
															qty_val = ifnull(pc_row.Quantity,0.0);
															rate_val = ifnull(pc_row.Unit_Cost,0.0);
															account_text = "";
															current_site_text = "";
															if(input.Asset != null)
															{
																account_text = ifnull(input.Asset.Asset_Name,"") + " - " + ifnull(input.Asset.Asset_ID,"");
																current_site_text = ifnull(input.Asset.Current_Site,"");
															}
															task_number = ifnull(input.Work_Order_Task_Number,"");
															line_number = ifnull(pc_row.Line_Number,0);
															reference_text = task_number;
															reference_text = task_number;
															if(line_number > 0)
															{
																if(reference_text != "")
																{
																	reference_text = reference_text + " - " + line_number;
																}
																else
																{
																	reference_text = "" + line_number;
																}
															}
															existing_bd = Bill_Details[Parts_Consumables == pc_row.ID && Source_Record_ID == input.ID && Source_Form == "Concrete Products Management - Work Order Tasks"];
															if(existing_bd.count() > 0)
															{
																for each  bd in existing_bd
																{
																	bd.Parts_Consumables=pc_row.ID;
																	bd.Line_Number=pc_row.Line_Number;
																	bd.Reference=reference_text;
																	bd.Display_Name_Item=ifnull(pc_row.Display_Name_Item_Labour,"");
																	bd.Details=ifnull(pc_row.Description,"");
																	bd.Details_Date=zoho.currentdate;
																	bd.Quantity=qty_val;
																	bd.Rate=rate_val;
																	bd.Account=account_text;
																	bd.Current_Site=current_site_text;
																	bd.Source_Record_ID=input.ID;
																	bd.Source_Form="Concrete Products Management - Work Order Tasks";
																	bd.Bill_Details_Status="Draft";
																	break;
																}
															}
															else
															{
																insert into Bill_Details
																[
																	Line_Number=pc_row.Line_Number
																	Reference=reference_text
																	Details_Date=zoho.currentdate
																	Parts_Consumables=pc_row.ID
																	Display_Name_Item=ifnull(pc_row.Display_Name_Item_Labour,"")
																	Details=ifnull(pc_row.Description,"")
																	Quantity=qty_val
																	Rate=rate_val
																	Account=account_text
																	Current_Site=current_site_text
																	Source_Record_ID=input.ID
																	Source_Form="Concrete Products Management - Work Order Tasks"
																	Bill_Details_Status="Draft"
																	Added_User=zoho.loginuser
																]
															}
															pc_row.Item_Status="Billed";
														}
													}
												}
												if(input.Issue != null)
												{
													issue_id_val = input.Issue.ID;
													issue_tasks = Work_Order_Tasks[Issue == issue_id_val];
													total_tasks = 0;
													open_task_found = false;
													for each  task_rec in issue_tasks
													{
														total_tasks = total_tasks + 1;
														task_status = ifnull(task_rec.Work_Order_Task_Status,"").trim();
														if(task_rec.ID == input.ID)
														{
															task_status = "Invoicing";
														}
														if(task_status != "Invoicing" && task_status != "Invoiced" && task_status != "Cancelled")
														{
															open_task_found = true;
														}
													}
													if(total_tasks > 0 && open_task_found == false)
													{
														issue_rec = Asset_Issues[ID == issue_id_val];
														if(issue_rec.ID != null)
														{
															issue_rec.Issue_Status="Closed";
															issue_rec.Odometer_Reading=input.Odometer_Reading_Checked;
															issue_rec.Work_Order_Status="Completed";
															issue_rec.Overall_End_Date=zoho.currenttime;
															if(input.Odometer_Reading_Checked != null)
															{
																issue_rec.Odometer_Reading_Ended=input.Odometer_Reading_Checked;
															}
														}
														routine_payload = Map();
														routine_payload.put("Concrete_Issue_ID",issue_id_val);
														routine_payload.put("Issue_Number",ifnull(input.Issue.Issue_Number,""));
														routine_payload.put("Concrete_Work_Order_Task_ID",input.ID);
														if(input.Asset != null)
														{
															routine_payload.put("Asset",input.Asset.ID);
														}
														else
														{
															routine_payload.put("Asset",null);
														}
														routine_payload.put("Odometer_Reading_Checked",ifnull(input.Odometer_Reading_Checked,0.0));
														routine_payload.put("Work_Order_Task_Status",ifnull(input.Work_Order_Task_Status,""));
														parts_list_for_routine = List();
														if(input.Parts_Consumables != null && input.Parts_Consumables.count() > 0)
														{
															for each  pc_row2 in input.Parts_Consumables
															{
																if(pc_row2.Labour != null)
																{
																	pc_map2 = Map();
																	pc_map2.put("Labour",pc_row2.Labour.ID);
																	parts_list_for_routine.add(pc_map2);
																}
															}
														}
														routine_payload.put("Parts_Consumables",parts_list_for_routine);
														info routine_payload;
														asset_management.closeIssueAndUpdateRoutineFromConcrete(routine_payload);
														info "All Concrete tasks finished: issue closed and work order completed.";
														if(input.Asset != null)
														{
															amount_val = ifnull(input.Grand_Total,0.0);
															desc_text = "";
															desc_text = desc_text + "Work Order: " + ifnull(input.Work_Order.Work_Order_Number,"") + "\n";
															desc_text = desc_text + "Work Order Task: " + ifnull(input.Work_Order_Task_Number,"") + "\n";
															desc_text = desc_text + "Issue: " + ifnull(input.Issue.Issue_Number,"") + "\n";
															desc_text = desc_text + "Vendor Service Type: " + ifnull(input.Vendor_Service_Type,"") + "\n";
															desc_text = desc_text + "Labour Total: " + ifnull(input.Labour_Total,0.0).toString() + "\n";
															desc_text = desc_text + "Parts Total: " + ifnull(input.Parts_Total,0.0).toString() + "\n";
															desc_text = desc_text + "Grand Total: " + amount_val.toString();
															payload = Map();
															payload.put("Transaction_Date",ifnull(input.Date_Time_Work_Checked,zoho.currenttime));
															payload.put("Transaction_Status","Draft");
															payload.put("Transaction_Description",desc_text);
															payload.put("Asset",input.Asset.ID);
															payload.put("Display_Name_Asset",ifnull(input.Display_Name_Asset,""));
															payload.put("Transaction_Direction","Expense");
															payload.put("Amount",amount_val);
															payload.put("Income",0.0);
															payload.put("Expenses",amount_val);
															payload.put("Application","Concrete Products Management");
															payload.put("Source_Form","Work Order Tasks");
															payload.put("Source_Record_ID",input.ID);
															payload.put("Notes",ifnull(input.Work_Order_Task_Number,""));
															asset_txn_resp = asset_management.createOrUpdateAssetTransactionLog(payload);
															info asset_txn_resp;
														}
													}
												}
											}
										}
						)
					}
				}

			}
			Full_Validation12 as "Full Validation"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Work Order Tasks — Full Validation (Create + Edit)
										errors = "";
										is_create = input.ID == null;
										status = ifnull(input.Work_Order_Task_Status,"").trim();
										vst = ifnull(input.Vendor_Service_Type,"").trim();
										apply_required = false;
										if(is_create)
										{
											apply_required = true;
										}
										else if(status == "" || status == "Requested")
										{
											apply_required = true;
										}
										// 1) Cancel rule
										if(input.Cancel_This_Work_Order == true)
										{
											if(ifnull(input.Notes_Why_Cancelled,"").trim() == "")
											{
												errors = errors + "\n• Notes why Cancelled is required when Cancel This Work Order is checked.";
											}
										}
										// 2) Approved odometer on edit
										if(input.ID != null)
										{
											if(input.Odometer_Reading_Approved == null)
											{
												errors = errors + "\n• Odometer Reading Approved is required on edit.";
											}
											else if(input.Odometer_Reading_Approved < 0)
											{
												errors = errors + "\n• Odometer Reading Approved cannot be negative.";
											}
										}
										// 3) Completed odometer
										if(input.ID != null && status == "Repairing")
										{
											if(input.Odometer_Reading_Completed == null)
											{
												errors = errors + "\n• Odometer Reading Completed is required when status is Repairing.";
											}
											else if(input.Odometer_Reading_Completed < 0)
											{
												errors = errors + "\n• Odometer Reading Completed cannot be negative.";
											}
										}
										// 4) Checking rules
										if(input.ID != null && status == "Checking")
										{
											if(input.Odometer_Reading_Checked == null)
											{
												errors = errors + "\n• Odometer Reading Checked is required when status is Checking.";
											}
											stc = input.Service_Task_Checkbox;
											if(stc == null || stc.size() != 3)
											{
												errors = errors + "\n• Service Task Checkbox: all items must be checked.";
											}
										}
										// 5) Required fields
										if(apply_required)
										{
											if(input.Asset == null)
											{
												errors = errors + "\n• Asset is required.";
											}
											if(input.Work_Order == null)
											{
												errors = errors + "\n• Work Order is required.";
											}
											if(vst == "")
											{
												errors = errors + "\n• Vendor Service Type is required.";
											}
											if(vst == "Items Only" && input.Store_Manager == null)
											{
												errors = errors + "\n• Store Manager is required.";
											}
											if(input.Odometer_Reading_Requested == null)
											{
												errors = errors + "\n• Odometer Reading Requested is required.";
											}
											if(vst == "Labour Only")
											{
												valid_labour_rows = 0;
												for each  r in input.Parts_Consumables
												{
													if(r.Labour != null)
													{
														valid_labour_rows = valid_labour_rows + 1;
													}
												}
												if(valid_labour_rows == 0)
												{
													errors = errors + "\n• At least one Labour row is required.";
												}
											}
										}
										// 6) Subform validation
										if(apply_required)
										{
											row_no = 0;
											for each  r in input.Parts_Consumables
											{
												row_no = row_no + 1;
												if(vst == "Items Only")
												{
													if(r.Item == null && r.Labour == null && r.Quantity == null && r.Unit_Cost == null && ifnull(r.Description,"").trim() == "")
													{
														continue;
													}
													if(r.Item == null)
													{
														errors = errors + "\n• Row " + row_no + ": Item is required (Items Only).";
													}
													if(r.Quantity == null)
													{
														errors = errors + "\n• Row " + row_no + ": Quantity is required (Items Only).";
													}
													else if(r.Quantity <= 0)
													{
														errors = errors + "\n• Row " + row_no + ": Quantity must be greater than 0 (Items Only).";
													}
													if(status != "Requested")
													{
														if(r.Unit_Cost == null)
														{
															errors = errors + "\n• Row " + row_no + ": Unit Cost is required (Items Only).";
														}
													}
													if(r.Unit_Cost != null && r.Unit_Cost < 0)
													{
														errors = errors + "\n• Row " + row_no + ": Unit Cost cannot be negative (Items Only).";
													}
												}
												else if(vst == "Labour Only")
												{
													if(r.Item == null && r.Labour == null && r.Quantity == null && r.Unit_Cost == null && ifnull(r.Description,"").trim() == "")
													{
														continue;
													}
													if(r.Labour == null)
													{
														errors = errors + "\n• Row " + row_no + ": Labour is required (Labour Only).";
													}
													if(r.Quantity == null)
													{
														errors = errors + "\n• Row " + row_no + ": Quantity is required (Labour Only).";
													}
													else if(r.Quantity <= 0)
													{
														errors = errors + "\n• Row " + row_no + ": Quantity must be greater than 0 (Labour Only).";
													}
													if(status != "Requested")
													{
														if(r.Unit_Cost == null)
														{
															errors = errors + "\n• Row " + row_no + ": Unit Cost is required (Labour Only).";
														}
													}
													if(r.Unit_Cost != null && r.Unit_Cost < 0)
													{
														errors = errors + "\n• Row " + row_no + ": Unit Cost cannot be negative (Labour Only).";
													}
												}
											}
										}
										// 7) Auto-calc totals
										parts_rows = List();
										for each  r in input.Parts_Consumables
										{
											if(r.Item != null || r.Labour != null && r.Quantity != null && r.Unit_Cost != null && r.Quantity > 0 && r.Unit_Cost >= 0)
											{
												r.Line_Total=thisapp.asset_calc.asset_calc_line_total(r.Quantity,r.Unit_Cost);
											}
											else
											{
												r.Line_Total=null;
											}
											m = Map();
											m.put("Item",r.Item);
											m.put("Labour",r.Labour);
											m.put("Quantity",r.Quantity);
											m.put("Unit Cost",r.Unit_Cost);
											parts_rows.add(m);
										}
										input.Parts_Total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
										input.Labour_Total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Parts_Total,input.Labour_Total);
										//====================================================
										// 8) Odometer timeline validation
										//====================================================
										if(input.Asset != null)
										{
											recorded_time = zoho.currenttime;
											if(input.Date_Time_Approved != null)
											{
												recorded_time = input.Date_Time_Approved;
											}
											else if(input.Date_Time_Work_Completed != null)
											{
												recorded_time = input.Date_Time_Work_Completed;
											}
											odo_val = null;
											if(input.Odometer_Reading_Approved != null)
											{
												odo_val = input.Odometer_Reading_Approved;
											}
											else if(input.Odometer_Reading_Completed != null)
											{
												odo_val = input.Odometer_Reading_Completed;
											}
											else if(input.Odometer_Reading_Requested != null)
											{
												odo_val = input.Odometer_Reading_Requested;
											}
											if(odo_val != null)
											{
												resp = asset_management.validateAssetMileage(input.Asset.ID,odo_val,recorded_time,"Work Order Tasks",input.ID.toString());
												if(resp.get("ok") != true)
												{
													errors = errors + "\n• " + resp.get("message");
												}
											}
										}
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize_On_Delete4 as "Finalize On Delete"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											mile_delete_resp = asset_management.deleteMileageLogFromConcrete("Concrete Products - Work Order Task Start",input.ID.toString());
										info mile_delete_resp;
										mile_delete_resp2 = asset_management.deleteMileageLogFromConcrete("Concrete Products - Work Order Task Completed",input.ID.toString());
										info mile_delete_resp2;
										mile_delete_resp3 = asset_management.deleteMileageLogFromConcrete("Concrete Products - Work Order Task Checked",input.ID.toString());
										info mile_delete_resp3;
										if(input.Asset != null)
										{
											asset_id_val = input.Asset;
											cost_resp = asset_management.updateAssetCostSummaryFromConcrete(asset_id_val,0.0,0.0);
											info cost_resp;
										}
						)
					}
				}

			}
			Set_Up_Form7 as "Set Up Form"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// WORK ORDER TASKS -> SET UP FORM / ON LOAD
										// =====================================================
										isLabourService = false;
										isItemsService = false;
										if(input.Vendor_Service_Type == "Labour Only" || input.Vendor_Service_Type == "Tractor Work Report" || input.Vendor_Service_Type == "Truck Movement Voucher")
										{
											isLabourService = true;
										}
										if(input.Vendor_Service_Type == "Items Only")
										{
											isItemsService = true;
										}
										hide Back_End;
										//hide Back_End;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// -------------------------
										// HIDE FIELDS DEFAULT
										// -------------------------
										hide Display_Name_Asset;
										hide Display_Name_Work_Order;
										hide Parts_Consumables;
										hide Parts_Consumables.Display_Name_Work_Order_Task_Number;
										hide Parts_Consumables.Display_Name_Item_Labour;
										hide Parts_Consumables.Line_Number;
										hide Parts_Consumables.Item_Issuing;
										hide Parts_Consumables.Bill_Details;
										hide Parts_Consumables.Item_Status;
										hide Parts_Consumables.Source_Record_ID;
										hide Parts_Consumables.Source_Form;
										hide Approved_Task_Status;
										hide After_Repair_Section;
										hide Checked_Section;
										hide Labour_Total;
										hide Parts_Total;
										hide Grand_Total;
										hide Store_Manager;
										hide Display_Name_Store_Manager;
										hide Parts_Consumables.Quantity_In_Base_Unit;
										hide Parts_Consumables.Rate_In_Base_Unit;
										// ======================================
										// HIDE AUDIT FIELDS
										// ======================================
										hide Parts_Consumables.User_Name;
										hide Parts_Consumables.User_Email;
										hide Parts_Consumables.User_Role;
										hide Parts_Consumables.Created_By_Name;
										hide Parts_Consumables.Created_By_Email;
										hide Parts_Consumables.Created_By_Time;
										hide Parts_Consumables.Updated_By_Name;
										hide Parts_Consumables.Updated_By_Email;
										hide Parts_Consumables.Updated_By_Time;
										// -------------------------
										// DISABLE FIELDS DEFAULT
										// -------------------------
										disable Labour_Total;
										disable Parts_Total;
										disable Grand_Total;
										disable Issue;
										disable Parts_Consumables.Item;
										disable Parts_Consumables.Line_Total;
										disable Parts_Consumables.Display_Name_Item_Labour;
										disable Parts_Consumables.Unit_Of_Measure;
										disable Parts_Consumables.Bill_Details;
										disable Parts_Consumables.Item_Status;
										disable Parts_Consumables.Source_Record_ID;
										disable Parts_Consumables.Source_Form;
										disable Notes_Why_Cancelled;
										disable Date_Time_Approved;
										disable Approved_By_Email;
										disable Work_Order_Task_Number;
										disable Work_Order_Task_Status;
										disable Display_Name_Store_Manager;
										// -------------------------
										// MODE / STATUS
										// -------------------------
										status = ifnull(input.Work_Order_Task_Status,"");
										is_create = input.ID == null;
										if(is_create)
										{
											hide Cancel_This_Work_Order;
											hide Notes_Why_Cancelled;
											hide Odometer_Reading_Approved;
											hide Date_Time_Approved;
											hide Approved_By_Email;
											if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												show Display_Name_Store_Manager;
												enable Store_Manager;
											}
											else if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
												input.Store_Manager = null;
												input.Display_Name_Store_Manager = "";
											}
										}
										// =====================================================
										// A) REQUESTED
										// =====================================================
										if((!is_create && status == "") || (!is_create && status == "Requested"))
										{
											disable Work_Order_Task_Number;
											disable Asset;
											disable Before_Image;
											disable Odometer_Reading_Requested;
											disable Work_Order;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												disable Parts_Consumables.Unit_Cost;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
												input.Store_Manager = null;
												input.Display_Name_Store_Manager = "";
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												enable Store_Manager;
											}
											show Approved_Task_Status;
											show Cancel_This_Work_Order;
											show Notes_Why_Cancelled;
											show Odometer_Reading_Approved;
											show Date_Time_Approved;
											show Approved_By_Email;
										}
										// =====================================================
										// B) CANCELLED
										// =====================================================
										else if(!is_create && status == "Cancelled")
										{
											disable Asset;
											disable Odometer_Reading_Requested;
											disable Work_Order;
											disable Vendor_Service_Type;
											disable Parts_Consumables.Item;
											disable Parts_Consumables.Labour;
											disable Parts_Consumables.Description;
											disable Parts_Consumables.Quantity;
											disable Parts_Consumables.Unit_Cost;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												disable Store_Manager;
											}
											disable Work_Order_Task_Status;
											show Approved_Task_Status;
											show Cancel_This_Work_Order;
											show Notes_Why_Cancelled;
											disable Odometer_Reading_Approved;
										}
										// =====================================================
										// C) REPAIRING
										// =====================================================
										else if(status == "Repairing")
										{
											disable Asset;
											hide Odometer_Reading_Requested;
											disable Before_Image;
											disable Task_Description;
											disable Work_Order;
											disable Parts_Consumables.Item;
											disable Parts_Consumables.Labour;
											disable Parts_Consumables.Description;
											disable Parts_Consumables.Quantity;
											hide Parts_Consumables.Unit_Cost;
											hide Parts_Consumables.Line_Total;
											disable Vendor_Service_Type;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												show Parts_Consumables.Unit_Cost;
												show Parts_Consumables.Line_Total;
												disable Parts_Consumables.Unit_Cost;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												disable Store_Manager;
											}
											show After_Repair_Section;
											disable Date_Time_Work_Completed;
											disable Completed_By_Email;
										}
										// =====================================================
										// D) CHECKING
										// =====================================================
										else if(status == "Checking")
										{
											disable Asset;
											hide Odometer_Reading_Requested;
											disable Work_Order;
											disable Parts_Consumables.Item;
											disable Parts_Consumables.Labour;
											disable Parts_Consumables.Description;
											disable Parts_Consumables.Quantity;
											hide Parts_Consumables.Unit_Cost;
											hide Parts_Consumables.Line_Total;
											disable Vendor_Service_Type;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												show Parts_Consumables.Unit_Cost;
												enable Parts_Consumables.Unit_Cost;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Consumables.Line_Total;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												disable Store_Manager;
											}
											show Checked_Section;
											disable Date_Time_Work_Checked;
											disable Checked_By_Email;
										}
										// =====================================================
										// E) INVOICING
										// =====================================================
										else if(status == "Invoicing")
										{
											disable Asset;
											hide Odometer_Reading_Requested;
											disable Parts_Consumables.Item;
											disable Parts_Consumables.Labour;
											disable Parts_Consumables.Description;
											disable Vendor_Service_Type;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												show Parts_Consumables.Unit_Cost;
												enable Parts_Consumables.Unit_Cost;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												disable Parts_Consumables.Quantity;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												disable Store_Manager;
											}
										}
										// =====================================================
										// F) INVOICED
										// =====================================================
										else if(status == "Invoiced")
										{
											disable Asset;
											disable Odometer_Reading_Requested;
											disable Work_Order;
											disable Vendor_Service_Type;
											show Parts_Consumables;
											hide Parts_Consumables.Item;
											hide Parts_Consumables.Labour;
											show Parts_Consumables.Display_Name_Item_Labour;
											disable Parts_Consumables.Description;
											disable Parts_Consumables.Quantity;
											disable Parts_Consumables.Unit_Cost;
											show Labour_Total;
											show Parts_Total;
											show Grand_Total;
											if(isItemsService)
											{
												show Store_Manager;
												show Display_Name_Store_Manager;
												disable Store_Manager;
											}
											else
											{
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											show Approved_Task_Status;
											disable Cancel_This_Work_Order;
											disable Notes_Why_Cancelled;
											disable Odometer_Reading_Approved;
											show After_Repair_Section;
											disable Date_Time_Work_Completed;
											disable Completed_By_Email;
											disable Odometer_Reading_Completed;
											show Checked_Section;
											disable Odometer_Reading_Checked;
											disable Date_Time_Work_Checked;
											disable Service_Task_Checkbox;
											disable Checked_By_Email;
										}
										// =====================================================
										// G) ADMIN
										// =====================================================
										else if(status == "Admin")
										{
											enable Asset;
											enable Odometer_Reading_Requested;
											enable Work_Order;
											enable Task_Description;
											enable Odometer_Reading_Approved;
											show Approved_Task_Status;
											show Odometer_Reading_Approved;
											if(isLabourService)
											{
												show Parts_Consumables;
												hide Parts_Consumables.Item;
												show Parts_Consumables.Labour;
												hide Parts_Total;
												show Labour_Total;
												show Grand_Total;
												hide Store_Manager;
												hide Display_Name_Store_Manager;
											}
											else if(isItemsService)
											{
												show Parts_Consumables;
												show Parts_Consumables.Item;
												hide Parts_Consumables.Labour;
												show Parts_Total;
												hide Labour_Total;
												show Grand_Total;
												show Store_Manager;
												enable Store_Manager;
											}
										}
										// =====================================================
										// DISPLAY NAME STORE MANAGER
										// =====================================================
										if(input.Store_Manager != null)
										{
											input.Display_Name_Store_Manager = input.Store_Manager.Employee_Name + " - " + ifnull(input.Store_Manager.Employee_Number,"");
										}
										else
										{
											input.Display_Name_Store_Manager = "";
										}
										// =====================================================
										// DAYS ODOMETER AUTO-FILL
										// =====================================================
										status = ifnull(input.Work_Order_Task_Status,"Requested").trim();
										if(input.Asset != null && input.Asset.Odometer_Unit_Of_Measure == "days")
										{
											odo_today = ifnull(input.Asset.Odometer_Reading,0.0);
											if(status == "Requested")
											{
												if(input.Odometer_Reading_Approved == null)
												{
													input.Odometer_Reading_Approved = odo_today;
												}
												disable Odometer_Reading_Approved;
											}
											else if(status == "Repairing")
											{
												if(input.Odometer_Reading_Completed == null)
												{
													input.Odometer_Reading_Completed = odo_today;
												}
												disable Odometer_Reading_Completed;
											}
											else if(status == "Checking")
											{
												if(input.Odometer_Reading_Checked == null)
												{
													input.Odometer_Reading_Checked = odo_today;
												}
												disable Odometer_Reading_Checked;
											}
										}
						)
					}
				}

			}
