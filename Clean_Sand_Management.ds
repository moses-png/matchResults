			Full_Validation27 as "Full Validation"
			{
				type =  form
				form = Truck_Measurement

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										is_create = input.ID == null;
										// =====================================================
										// 1) CREATE MODE — REQUIRED FIELDS
										// =====================================================
										if(is_create)
										{
											if(input.Voucher == null)
											{
												errors = errors + "\n• Voucher is required.";
											}
											if(input.Number_Plate == null)
											{
												errors = errors + "\n• Number Plate is required.";
											}
											if(input.Truck_Type == null)
											{
												errors = errors + "\n• Truck Type is required.";
											}
											if(input.Number_of_Tyres == null)
											{
												errors = errors + "\n• Number of Tyres is required.";
											}
											if(input.Front_Image == null)
											{
												errors = errors + "\n• Front Image is required.";
											}
											if(input.Front_Side_Image == null)
											{
												errors = errors + "\n• Front Side Image is required.";
											}
											if(input.Bed_Length == null)
											{
												errors = errors + "\n• Bed Length is required.";
											}
											if(input.Bed_Width == null)
											{
												errors = errors + "\n• Bed Width is required.";
											}
											if(input.Bed_Height == null)
											{
												errors = errors + "\n• Bed Height is required.";
											}
											if(input.Bed_Height_2 == null)
											{
												errors = errors + "\n• Bed Height 2 is required.";
											}
										}
										// =====================================================
										// 2) EDIT MODE — MANAGER STAGE REQUIRED FIELDS
										// =====================================================
										if(!is_create && input.Document_Stage == "Draft")
										{
											if(input.Bed_Length_Confirmed == null)
											{
												errors = errors + "\n• Bed Length Confirmed is required.";
											}
											if(input.Bed_Width_Confirmed == null)
											{
												errors = errors + "\n• Bed Width Confirmed is required .";
											}
											if(input.Bed_Height_Confirmed == null)
											{
												errors = errors + "\n• Bed Height Confirmed is required (.";
											}
											if(input.Bed_Height_2_Confirmed == null)
											{
												errors = errors + "\n• Bed Height 2 Confirmed is required.";
											}
										}
										// =====================================================
										// 3) EDIT MODE — HEAD OFFICE RULES
										// =====================================================
										if(!is_create && input.Document_Stage == "Draft")
										{
											if(input.Measurement_Status == null)
											{
												errors = errors + "\n• Measurement Status is required.";
											}
											if(input.Measurement_Status == "Pending")
											{
												errors = errors + "\n• Change Measurement Status from Pending to Active or Inactive.";
											}
											// =================================================
											// IF STATUS = ACTIVE
											// =================================================
											if(input.Measurement_Status == "Active")
											{
												chk_str = "";
												if(input.Measurement_Checkbox != null)
												{
													chk_str = input.Measurement_Checkbox.toString();
												}
												chk_str = ifnull(chk_str,"").trim();
												if(chk_str == "" || chk_str == "[]")
												{
													errors = errors + "\n• Measurement Checkbox is required when status is Active.";
												}
												required_checks = List();
												required_checks.add("Front Image Correct");
												required_checks.add("Front Side Image Correct");
												required_checks.add("Truck Type Correct");
												required_checks.add("Number of Tyres Correct");
												required_checks.add("Truck Size 1 Correct");
												required_checks.add("Truck Size 2 Correct");
												missingText = "";
												for each  c in required_checks
												{
													if(chk_str == "" || !chk_str.contains(c))
													{
														if(missingText == "")
														{
															missingText = c;
														}
														else
														{
															missingText = missingText + ", " + c;
														}
													}
												}
												if(missingText != "")
												{
													errors = errors + "\n• Cannot set status to Active unless ALL checks are ticked." + "\n  Missing: " + missingText;
												}
												if(input.Number_Plate != null)
												{
													hasDup = false;
													msg = "";
													firstVoucher = "";
													firstLine = "";
													dups = Truck_Measurement[Number_Plate == input.Number_Plate && Measurement_Status == "Active" && ID != input.ID];
													for each  r in dups
													{
														hasDup = true;
														if(firstVoucher == "")
														{
															firstVoucher = ifnull(r.Display_Name_Voucher,"N/A");
															firstLine = ifnull(r.Line_Number,0).toString();
														}
														msg = msg + "\n - Voucher: " + ifnull(r.Display_Name_Voucher,"N/A") + " | Line: " + ifnull(r.Line_Number,0) + " | Size1: " + ifnull(r.Truck_Size_1,0.0) + " | Size2: " + ifnull(r.Truck_Size_2,0.0);
													}
													if(hasDup)
													{
														trying = "\n - Voucher: " + ifnull(input.Display_Name_Voucher,"N/A") + " | Line: " + ifnull(input.Line_Number,0) + " | Size1: " + ifnull(input.Truck_Size_1,0.0) + " | Size2: " + ifnull(input.Truck_Size_2,0.0);
														errors = errors + "\n• You are trying to set this record to ACTIVE:" + "\n• But this truck already has an ACTIVE measurement record." + "\n• Only ONE Active record is allowed per truck." + "\nExisting Active record:" + msg + "\nWhat you want to make Active:" + trying + "\n• You may change this record to Inactive instead." + "\n• Go to " + firstVoucher + " Line " + firstLine + " and make it Inactive first";
													}
												}
											}
										}
										if(input.Number_Plate != null)
										{
											dup = Truck_Measurement[Number_Plate == input.Number_Plate && ID != input.ID && Measurement_Status != "Inactive"];
											if(dup.count() > 0)
											{
												alert "This Truck was already Measured.";
												cancel submit;
											}
										}
										// =====================================================
										// FINAL BLOCK
										// =====================================================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize21 as "Finalize"
			{
				type =  form
				form = Truck_Measurement

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											now_ts = zoho.currenttime;
										// -------------------------------------------------
										// Detect CREATE vs EDIT
										// -------------------------------------------------
										is_create = input.Time_Measured == null;
										// =====================================================
										// 1) ON CREATE
										// =====================================================
										if(is_create)
										{
											input.Time_Measured = now_ts;
											input.Document_Stage = "Draft";
											if(input.Voucher != null && input.Display_Name_Site != null && input.Display_Name_Site.trim() != "")
											{
												maxLine = 0;
												rows = Truck_Measurement[Voucher == input.Voucher && Display_Name_Site == input.Display_Name_Site && ID != input.ID];
												for each  r in rows
												{
													if(r.Line_Number != null && r.Line_Number > maxLine)
													{
														maxLine = r.Line_Number;
													}
												}
												input.Line_Number = maxLine + 1;
											}
										}
										// =====================================================
										// 2) FIRST FINALIZE
										// =====================================================
										else if(input.Document_Stage == "Draft" && input.Time_Confirmed == null)
										{
											input.Time_Confirmed = now_ts;
											input.Document_Stage = "Draft";
										}
										// =====================================================
										// 3) SECOND FINALIZE
										// =====================================================
										else if(input.Document_Stage == "Draft" && input.Time_Confirmed != null)
										{
											input.Document_Stage = "Confirmed";
										}
						)
					}
				}

			}
			Full_Validation_On_Create9 as "Full Validation On Create"
			{
				type =  form
				form = Truck_Register

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											docKey = Document_Key[Voucher_Type == "Truck Size Form" && Document_Key_Status == "Active"];
										if(docKey.ID == null)
										{
											alert "Document Key for TSF not found or inactive.";
											cancel submit;
										}
										next_no = ifnull(docKey.Next_Number,1);
										if(next_no < 10)
										{
											num_str = "000" + next_no;
										}
										else if(next_no < 100)
										{
											num_str = "00" + next_no;
										}
										else if(next_no < 1000)
										{
											num_str = "0" + next_no;
										}
										else
										{
											num_str = next_no.toString();
										}
										input.TSF_Number = ifnull(docKey.Prefix,"TSF") + num_str;
										docKey.Next_Number=next_no + 1;
						)
					}
				}

			}
