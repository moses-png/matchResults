			Full_Validation_On_Delete1 as "Full Validation On Delete"
			{
				type =  form
				form = Purchase_Order

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ===============================================
										// PURCHASE ORDER – FULL VALIDATION ON DELETE
										// ===============================================
										if(input.Receive_Status == "Partially Received" || input.Receive_Status == "Fully Received")
										{
											alert "This Purchase Order cannot be deleted because it is already " + input.Receive_Status + ".";
											cancel delete;
										}
										for each  po_det in Purchase_Order_Details[Purchase_Order == input.ID]
										{
											if(ifnull(po_det.Quantity_Received,0.0) > 0)
											{
												alert "This Purchase Order cannot be deleted because one or more items have already been received.";
												cancel delete;
											}
										}
										srd_count = Stock_Receiving_Details[Purchase_Order == input.ID].count();
										if(srd_count > 0)
										{
											alert "This Purchase Order cannot be deleted because stock receiving records already exist for it.";
											cancel delete;
										}
						)
					}
				}

			}
