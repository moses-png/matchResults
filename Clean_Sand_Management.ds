			On_Addition_Of_Row as "On Addition Of Row"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on add row of Stock_Bundling_Note
				{
					actions 
					{
						custom deluge script
						(
											lineNo = 1;
										for each  row_sb in input.Stock_Bundling_Note
										{
											// Auto number
											row_sb.Line_Number=lineNo;
											lineNo = lineNo + 1;
