														hide Tractor_Work_Report;
														hide Truck_Movement_Voucher;
														hide Task_Location;
														hide Small_Notes;
														show Site_From;
														show Site_Location_From;
														disable Site_From;
														disable Site_Location_From;
														hide Party_From;
														hide Party_Location_From;
														show Delivery_Location;
														enable Delivery_Location;
														show Odometer_End;
														show Time_End;
														show Delivery_To_Image;
														if(input.Delivery_Location == "Company Sites")
														{
															show Site_To;
															show Site_Location_To;
															enable Site_To;
															enable Site_Location_To;
															hide Party_To;
															hide Party_Location_To;
														}
														else if(input.Delivery_Location == "Suppliers")
														{
															show Party_To;
															show Party_Location_To;
															enable Party_To;
															enable Party_Location_To;
															hide Site_To;
															hide Site_Location_To;
														}
														else
														{
															hide Site_To;
															hide Site_Location_To;
															hide Party_To;
															hide Party_Location_To;
														}
													}
													else if(jobNo2 == "TJS02")
													{
														hide Delivery_Location;
														show Work_Order_Task;
														disable Work_Order_Task;
														show Task_Location;
														disable Task_Location;
														show Small_Notes;
														disable Small_Notes;
														if(input.Task_Location == "Suppliers")
														{
															show Party_From;
															show Party_Location_From;
															disable Party_From;
															disable Party_Location_From;
															hide Site_From;
															hide Site_Location_From;
														}
														else
														{
															show Site_From;
															show Site_Location_From;
															disable Site_From;
															disable Site_Location_From;
															hide Party_From;
															hide Party_Location_From;
														}
														show Site_To;
														show Site_Location_To;
														enable Site_To;
														enable Site_Location_To;
														hide Party_To;
														hide Party_Location_To;
													}
													else if(jobNo2 == "TJS03")
													{
														hide Delivery_Location;
