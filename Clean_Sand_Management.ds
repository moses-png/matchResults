			On_Sales_Voucher_Selected4 as "On Sales Voucher Selected"
			{
				type =  form
				form = Bill

				record event = on add or edit

				on user input of Sales_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Sales_Voucher != null)
										{
											input.Bill_Name = "Sales Voucher";
											input.Bill_Number = input.Sales_Voucher.Sales_Voucher_Number;
											disable Bill_Name;
											disable Bill_Number;
											disable Display_Name_Vendor;
										}
										else
										{
											input.Bill_Name = "";
											input.Bill_Number = "";
											input.Display_Name_Vendor = "";
											enable Bill_Name;
											enable Bill_Number;
											enable Display_Name_Vendor;
										}
						)
					}
				}

