			Set_Up_Form53 as "Set Up Form"
			{
				type =  form
				form = Delivery_Note

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ==================================================
										// ON CREATE — SHOW ONLY DELIVERY NOTE HEADER FIELDS
										// ==================================================
										if(input.ID == null)
										{
											show Receipt_Officer_Daily_Voucher;
											show Site;
											show Delivery_Note_Date;
											show Delivery_Note_Number;
											hide Customer;
											hide Display_Name_Customer;
											hide Customer_Location;
											hide Customer_Purchase_Order;
											hide Display_Name_Purchase_Order;
											hide Customer_Purchase_Order_Details;
											hide Display_Name_Site;
											hide Received_By;
											hide Number_Plate;
											hide Truck_Type;
											hide TSF_Number;
											hide Cashier_Section;
											hide Customer_Details;
											hide Truck_Details;
											hide Driver_Name;
											hide Turn_Boy_Name;
											hide Receipt_Officer;
											hide Prepared_By;
											hide Sales_Voucher;
											hide Status_Details;
											hide Cancel_Voucher;
											hide Reason_Why_Cancelled;
											hide Delivery_Note_Status;
											hide Display_Name_Receipt_Officer_Daily_Voucher;
											hide Display_Name_Prepared_By;
											hide Notes;
											hide Back_End;
										}
										else
										{
											hide Display_Name_Receipt_Officer_Daily_Voucher;
											hide Display_Name_Site;
											hide Display_Name_Customer;
											hide Display_Name_Purchase_Order;
											hide Display_Name_Prepared_By;
											hide Display_Name_Sales_Voucher;
											hide Back_End;
											hide Reason_Why_Cancelled;
											disable Receipt_Officer_Daily_Voucher;
											disable Site;
											disable Delivery_Note_Date;
											disable Delivery_Note_Number;
											disable Customer;
											disable Number_Plate;
											disable Truck_Type;
											disable TSF_Number;
											disable Sales_Voucher;
											//disable Payment_Receipt;
											disable Delivery_Note_Status;
										}
										// ==================================================
										// CUSTOMER OVERRIDE — ON EDIT ONLY
										// ==================================================
										if(input.ID != null && input.Customer != null)
										{
											custName = ifnull(input.Customer.Display_Name_Customer,"").trim();
											if(custName == "Mrsand - 20" || custName == "Grapes Trucks - 18")
											{
												hide Customer_Purchase_Order;
												hide Customer_Purchase_Order_Details;
												hide Customer_Location;
												hide Delivery_Note_Date;
											}
											else
											{
												show Customer_Purchase_Order;
												show Customer_Purchase_Order_Details;
												show Customer_Location;
												show Delivery_Note_Date;
											}
										}
						)
					}
				}

			}
