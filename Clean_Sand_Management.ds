										hide Truck_Movement_Details.Updated_By_Name;
										hide Truck_Movement_Details.Updated_By_Email;
										hide Truck_Movement_Details.Updated_By_Time;
										//Fuel Receiving Details
										hide Fuel_Issuing_Details;
										//Machine Start Of Day Details
										hide Machine_Start_Of_Day_Details;
										hide Truck_Measurement;
										//Meter readings
										hide Meter_Reading_Details;
										//Special Tasks Done
										hide Special_Tasks_Details;
										// ------------------------------
										// 2) ALWAYS HIDE
										// ------------------------------
										hide Issued_By;
										hide Display_Name_Issued_By;
										hide Display_Name_Voucher_Type;
										hide Display_Name_Employee;
										hide Date_Time_In;
										hide Site;
										hide Display_Name_Site;
										hide Voucher_Return;
										hide Display_Name_Received_By;
										hide Date_Time_Out;
										hide Hours_Worked;
										hide Shift;
										hide Voucher_Status;
										hide Shift_Voucher_Summary;
										hide Opening_Vouchers;
										hide Vouchers_Issued;
										hide Vouchers_Returned;
										hide Outstanding_Vouchers;
										hide Voucher_Header;
										hide Management_Location;
										hide Asset;
										hide Machine_Start_of_Day;
										hide Start_Time;
										hide Odometer_Start;
										hide Fuel_Start_Level;
										hide Voucher_Footer;
										hide Employee_Cost;
										hide Voucher_Cost;
										hide End_Time;
										hide Quantity_Created;
										hide Odometer_End;
										hide Fuel_End_Level;
										hide Manager_Section;
										hide Manager_Time;
										hide Cancel_Voucher;
										hide Cancellation_Reason;
										hide Employee_Taking_To_Head_Office;
										hide How_to_Take_to_Head_Office;
										hide Time_Sent_to_Head_Office;
										hide Case_Number;
										hide Head_Office;
										hide Seen;
										hide Reason_for_not_Seen;
										hide Time_Checked;
										hide Human_Resource;
										hide Hr_Time_Checked;
										hide Back_End;
										// ------------------------------
										// 3) DOCUMENT TYPE TOGGLE
										// ------------------------------
										if(input.Document_Type == "Physical Voucher")
										{
											show Voucher_Type;
											enable Voucher_Type;
											enable Voucher_Number;
										}
										else if(input.Document_Type == "Digital Voucher")
										{
											show Voucher_Type;
											enable Voucher_Type;
											disable Voucher_Number;
										}
										else
										{
											hide Voucher_Type;
											input.Voucher_Type = null;
											input.Voucher_Number = null;
										}
										// ------------------------------
										// 4) MODE + STATUS
										// ------------------------------
										is_create = input.ID == null;
										st = ifnull(input.Voucher_Status,"Issued");
										if(is_create && input.Voucher_Status == null)
										{
											input.Voucher_Status = "Issued";
											st = "Issued";
										}
										// =====================================================
										// ON CREATE
										// =====================================================
										if(is_create)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											enable Issued_By;
											enable Document_Type;
											enable Voucher_Type;
											enable Voucher_Number;
											enable Employee;
										}
										// =====================================================
										// ON EDIT + ISSUED
										// =====================================================
										else if(!is_create && st == "Issued")
										{
											show Issued_By;
											show Site;
											show Voucher_Return;
											show Received_By;
											enable Received_By;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											disable Issued_By;
											disable Site;
											disable Document_Type;
											disable Voucher_Number;
											disable Employee;
											disable Date_Time_In;
											disable Voucher_Type;
											if(voucherType == "Item Issuing Form")
											{
												show Asset;
												show Voucher_Issuing_Details;
											}
											if(voucherType == "Occurency Report")
											{
												show Voucher_Header;
												show Management_Location;
												enable Management_Location;
												show Incident_Details;
												enable Incident_Details.Time;
												enable Incident_Details.Incident_Type;
												enable Incident_Details.Incident;
											}
											if(voucherType == "Daily Cleaners Report")
											{
												show Voucher_Header;
												show Management_Location;
												enable Management_Location;
												show Special_Tasks_Details;
												enable Special_Tasks_Details.Management_Location;
												enable Special_Tasks_Details.Task_Name;
												enable Special_Tasks_Details.Description;
											}
											if(voucherType == "Store Receiving Book")
											{
												show Asset;
												show Voucher_Receiving_Details;
											}
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Display_Name_Issued_By;
												hide Received_By;
												hide Display_Name_Received_By;
												show Voucher_Return;
												show Date_Time_Out;
												show Hours_Worked;
												show Shift;
												enable Shift;
											}
										}
										// =====================================================
										// ON EDIT + CLOSED
										// =====================================================
										else if(!is_create && st == "Closed")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Display_Name_Issued_By;
												hide Received_By;
												hide Display_Name_Received_By;
												show Manager_Section;
												show Manager_Time;
												show Cancel_Voucher;
												show Case_Number;
												show Employee_Taking_To_Head_Office;
												show How_to_Take_to_Head_Office;
												show Time_Sent_to_Head_Office;
												enable Case_Number;
												enable Employee_Taking_To_Head_Office;
												enable How_to_Take_to_Head_Office;
												enable Cancel_Voucher;
												if(input.Cancel_Voucher == true)
												{
													show Cancellation_Reason;
													enable Cancellation_Reason;
												}
											}
										}
										// =====================================================
										// ON EDIT + RETURNED
										// =====================================================
										else if(!is_create && st == "Returned")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Received_By;
												hide Display_Name_Received_By;
											}
											show Issued_By;
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											if(voucherType == "Cashier Envelope")
											{
												hide Voucher_Header;
												hide Voucher_Footer;
											}
											if(voucherType == "Item Issuing Form")
											{
												hide Employee_Issuing_Details;
												show Voucher_Issuing_Details;
												hide Voucher_Issuing_Details.Display_Name_Voucher;
												hide Voucher_Issuing_Details.Source_Record_ID;
												hide Voucher_Issuing_Details.Source_Form;
												show Voucher_Footer;
												show Voucher_Cost;
											}
											if(voucherType == "Occurency Report")
											{
												show Voucher_Header;
												show Management_Location;
												show Incident_Details;
												enable Incident_Details.Time;
												enable Incident_Details.Incident_Type;
												enable Incident_Details.Incident;
											}
											if(voucherType == "Store Receiving Book")
											{
												hide Employee_Issuing_Details;
												show Voucher_Receiving_Details;
												hide Voucher_Receiving_Details.Display_Name_Voucher;
												hide Voucher_Receiving_Details.Source_Record_ID;
												hide Voucher_Receiving_Details.Source_Form;
											}
											show Manager_Section;
											show Cancel_Voucher;
											enable Cancel_Voucher;
										}
										// =====================================================
										// ON EDIT + HEAD OFFICE
										// =====================================================
										else if(!is_create && st == "Head Office")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											show Manager_Section;
											show Cancel_Voucher;
											if(input.Cancel_Voucher == true)
											{
												show Cancellation_Reason;
											}
											show Head_Office;
											show Seen;
											enable Seen;
										}
										// =====================================================
										// ON EDIT + HUMAN RESOURCE
										// =====================================================
										else if(!is_create && st == "Human Resource")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											enable Document_Type;
											show Voucher_Type;
											enable Voucher_Type;
											show Voucher_Number;
											enable Voucher_Number;
											show Employee;
											show Date_Time_In;
											enable Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											enable Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Employee_Issuing_Details;
											show Manager_Section;
											show Cancel_Voucher;
											enable Cancel_Voucher;
										}
										// =====================================================
										// ON EDIT + AUDITED
										// =====================================================
										else if(!is_create && st == "Audited")
										{
											if(voucherType == "Supervisor Voucher")
											{
												hide Issued_By;
												hide Received_By;
											}
											else
											{
												show Issued_By;
												show Received_By;
											}
											show Site;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											enable Voucher_Status;
											show Voucher_Cost;
											show End_Time;
											show Odometer_End;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											if(input.Cancel_Voucher == true)
											{
												show Cancellation_Reason;
											}
											show Head_Office;
											show Seen;
											if(input.Seen == true)
											{
												hide Reason_for_not_Seen;
											}
											else
											{
												show Reason_for_not_Seen;
											}
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
											show Back_End;
											show User_Name;
											show User_Email;
											show User_Role;
											show Created_By_Name;
											show Created_By_Email;
											show Created_By_Time;
											show Updated_By_Name;
											show Updated_By_Email;
											show Updated_By_Time;
										}
										// =====================================================
										// ON EDIT + CLEARED
										// =====================================================
										else if(!is_create && st == "Cleared")
										{
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											show Site;
											show Voucher_Return;
											show Date_Time_Out;
											show Hours_Worked;
											show Shift;
											show Voucher_Status;
											show Shift_Voucher_Summary;
											show Opening_Vouchers;
											show Vouchers_Issued;
											show Vouchers_Returned;
											show Outstanding_Vouchers;
											show Manager_Section;
											show Manager_Time;
											show Cancel_Voucher;
											show Head_Office;
											show Seen;
											show Time_Checked;
											show Human_Resource;
											show Hr_Time_Checked;
											show Back_End;
										}
										// =====================================
										// FORCE SHOW EXISTING DETAILS
										// =====================================
										if(input.Employee_Issuing_Details.count() > 0)
										{
											show Employee_Issuing_Details;
										}
										if(input.Voucher_Issuing_Details.count() > 0)
										{
											show Voucher_Issuing_Details;
										}
										if(input.Voucher_Receiving_Details.count() > 0)
										{
											show Voucher_Receiving_Details;
										}
						)
					}
				}

			}
			On_Cancel_Voucher_Selecte4 as "On Cancel Voucher Selected"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on user input of Cancel_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_Voucher == true)
										{
											show Cancellation_Reason;
										}
										else
										{
											hide Cancellation_Reason;
											input.Cancellation_Reason = "";
										}
						)
					}
				}

			}
			On_Date_Time_In_Selected as "On Date-Time In Selected"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on user input of Date_Time_In
				{
					actions 
					{
						custom deluge script
						(
											// ---- CONFIGURE DAY WINDOW HERE ----
										START_DAY_HOUR = 6;
										END_DAY_HOUR = 18;
										if(input.Date_Time_In == null)
										{
											input.Shift = null;
											input.Hours_Worked = null;
										}
										else
										{
											// -------------------------
											// 1) Shift
											// -------------------------
											hr = input.Date_Time_In.toString("HH").toLong();
											if(hr >= START_DAY_HOUR && hr < END_DAY_HOUR)
											{
												input.Shift = "Day Shift";
											}
											else
											{
												input.Shift = "Night Shift";
											}
											// -------------------------
											// 2) Hours Worked 
											// -------------------------
											if(input.Date_Time_Out != null)
											{
												if(input.Date_Time_Out < input.Date_Time_In)
												{
													alert "Date-Time Out cannot be earlier than Date-Time In.";
													input.Date_Time_Out = null;
													input.Hours_Worked = null;
												}
												else
												{
													ms = input.Date_Time_Out.toLong() - input.Date_Time_In.toLong();
													input.Hours_Worked = (ms / (1000.0 * 60.0 * 60.0)).round(2);
												}
											}
											else
											{
												input.Hours_Worked = null;
											}
										}
						)
					}
				}

			}
			On_Date_Time_Out_Selected as "On Date-Time Out Selected"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on user input of Date_Time_Out
				{
					actions 
					{
						custom deluge script
						(
											// Voucher → On Date_Time_Out
										if(input.Date_Time_Out == null)
										{
											input.Hours_Worked = null;
											return;
										}
										if(input.Date_Time_In == null)
										{
											alert "Please enter Date-Time In first.";
											input.Date_Time_Out = null;
											input.Hours_Worked = null;
											return;
										}
										if(input.Date_Time_Out < input.Date_Time_In)
										{
											alert "Date-Time Out cannot be earlier than Date-Time In.";
											input.Date_Time_Out = null;
											input.Hours_Worked = null;
											return;
										}
										ms = input.Date_Time_Out.toLong() - input.Date_Time_In.toLong();
										input.Hours_Worked = (ms / (1000.0 * 60.0 * 60.0)).round(2);
						)
					}
				}

			}
			On_Document_Type_Selected as "On Document Type Selected"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on user input of Document_Type
				{
					actions 
					{
						custom deluge script
						(
											dt = ifnull(input.Document_Type,"").trim();
										if(dt == "Physical Voucher")
										{
											show Voucher_Type;
											enable Voucher_Type;
											enable Voucher_Number;
											input.Voucher_Type = null;
											input.Display_Name_Voucher_Type = null;
											input.Voucher_Number = null;
										}
										else if(dt == "Digital Voucher")
										{
											show Voucher_Type;
											enable Voucher_Type;
											disable Voucher_Number;
											input.Voucher_Type = null;
											input.Display_Name_Voucher_Type = null;
											input.Voucher_Number = null;
										}
										else
										{
											hide Voucher_Type;
											disable Voucher_Number;
											input.Voucher_Type = null;
											input.Display_Name_Voucher_Type = null;
											input.Voucher_Number = null;
										}
						)
					}
				}

			}
