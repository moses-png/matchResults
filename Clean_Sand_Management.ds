			Finalize_On_Create16 as "Finalize On Create"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// CONCRETE ITEM ISSUING DETAILS - FINALIZE ON CREATE
										// =====================================================
										// =====================================================
										// 1) AUDIT + DEFAULT RETURNS
										// =====================================================
										u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
										input.Quantity_Returned = 0.0;
										input.Quantity_Returned_in_Base_Unit_Of_Measure = 0.0;
										// =====================================================
										// 2) NON-ISSUING REQUEST TYPES
										// =====================================================
										if(input.Request_Voucher_Type != "Employee Voucher" && input.Request_Voucher_Type != "Sales Voucher" && input.Request_Voucher_Type != "Internal Transfer")
										{
											input.Status = "Draft";
											if(input.Item != null && input.Unit_Of_Measure != null && input.Quantity != null && input.Quantity > 0)
											{
												base_qty_create = store_management.po.convert_to_base_qty_from_concrete(input.Item,input.Unit_Of_Measure,input.Quantity);
												if(base_qty_create != null && base_qty_create > 0)
												{
													input.Quantity_in_Base_Unit_Of_Measure = base_qty_create;
													input.Line_Total = (base_qty_create * ifnull(input.Cost,0.0)).round(2);
												}
											}
											info "Created as Draft. Request Type does not issue stock.";
											return;
										}
										// =====================================================
										// 3) REQUIRED FIELD CHECKS
										// =====================================================
										if(input.Issuing_Voucher == null)
										{
											info "Issuing Voucher is required.";
											return;
										}
										if(input.Request_Voucher_Type == "Employee Voucher" && input.Employee_Voucher == null)
										{
											info "Employee Voucher is required.";
											return;
										}
										if(input.Request_Voucher_Type == "Sales Voucher")
										{
											if(input.Sales_Voucher == null)
											{
												info "Sales Voucher is required.";
												return;
											}
											if(input.Item_Taken == null)
											{
												info "Item Taken is required.";
												return;
											}
										}
										if(input.Item == null || input.Unit_Of_Measure == null || input.Quantity == null || input.Quantity <= 0)
										{
											info "Item, Unit of Measure and Quantity are required.";
											return;
										}
										// =====================================================
										// 4) LOAD ISSUING HEADER + STORE
										// =====================================================
										hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
										if(hdr.ID == null || hdr.Store == null)
										{
											info "Header missing or Store missing.";
											return;
										}
										store_id = hdr.Store;
										// =====================================================
										// 5) STOCK CONDITION
										// =====================================================
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = "New";
										}
										// =====================================================
										// 6) REFERENCE NUMBER
										// =====================================================
										ref_no = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim();
										if(ref_no == "")
										{
											ref_no = hdr.ID.toString();
										}
										// =====================================================
										// 7) UOM CHECK + BASE QUANTITY
										// =====================================================
										check = store_management.po.check_uom_conversion_from_concrete(input.Item,input.Unit_Of_Measure);
										if(check == null || check.get("ok") != true)
										{
											info ifnull(check.get("message"),"UOM conversion failed.");
											return;
										}
										base_qty = store_management.po.convert_to_base_qty_from_concrete(input.Item,input.Unit_Of_Measure,input.Quantity);
										if(base_qty == null || base_qty <= 0)
										{
											info "Invalid base quantity.";
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure = base_qty;
										// =====================================================
										// 8) LINE TOTAL
										// =====================================================
										line_total_val = (base_qty * ifnull(input.Cost,0.0)).round(2);
										input.Line_Total = line_total_val;
										// =====================================================
										// 9) TOOL CHECK + FINAL STATUS
										// =====================================================
										is_tool_item = false;
										if(input.Item != null && input.Item.Is_Tool == true)
										{
											is_tool_item = true;
										}
										if(is_tool_item == true)
										{
											input.Status = "Borrowed";
										}
										else
										{
											input.Status = "Issued";
											input.Expected_Return_Date = null;
										}
										// =====================================================
										// 10) ISSUE STOCK IN STORE MANAGEMENT
										// =====================================================
										stock_resp = store_management.stock.issue_stock_from_concrete(input.Item,store_id,input.Quantity,input.Unit_Of_Measure,cond,line_total_val,ref_no,input.ID);
										info stock_resp;
										if(stock_resp == null || stock_resp.get("ok") != true)
										{
											input.Status = "Draft";
											info "Stock issue failed: " + ifnull(stock_resp.get("message"),"No response from Store Management.");
											return;
										}
										// =====================================================
										// 11) UPDATE STOCK PREVIEW FROM RESPONSE
										// =====================================================
										input.Quantity_in_Base_Unit_Of_Measure = ifnull(stock_resp.get("base_qty"),base_qty);
										input.Store_Available_Stock = ifnull(stock_resp.get("store_stock"),0.0);
										input.Global_Available_Stock = ifnull(stock_resp.get("global_stock"),0.0);
										// =====================================================
										// 12) INTERNAL TRANSFER ONLY
										// =====================================================
										if(input.Request_Voucher_Type == "Internal Transfer")
										{
											transfer_payload = Map();
											transfer_payload.put("Source_Record_ID",input.ID);
											transfer_payload.put("Source_Form","Item Issuing Details");
											transfer_payload.put("Source_Application","Concrete Products Management");
											transfer_payload.put("Transfer_Number",ifnull(input.Item_Issuing_Number,""));
											transfer_payload.put("Transfer_Date",zoho.currentdate);
											transfer_payload.put("Issuing_Store",input.Store);
											transfer_payload.put("Item",input.Item);
											transfer_payload.put("Display_Name_Item",ifnull(input.Display_Name_Item,""));
											transfer_payload.put("Quantity",ifnull(input.Quantity,0.0));
											transfer_payload.put("Unit_Of_Measure",input.Unit_Of_Measure);
											transfer_payload.put("Display_Name_Unit_Of_Measure",ifnull(input.Display_Name_Unit_Of_Measure,""));
											transfer_payload.put("Quantity_in_Base_Unit_Of_Measure",ifnull(input.Quantity_in_Base_Unit_Of_Measure,0.0));
											transfer_payload.put("Issued_By",ifnull(input.Display_Name_Issued_By,""));
											transfer_payload.put("Stock_Condition",cond);
											transfer_payload.put("Unit_Cost",ifnull(input.Cost,0.0));
											transfer_payload.put("Transfer_Status","Not Received");
											transfer_resp = store_management.stock_transfer.create_transfer_from_item_issuing(transfer_payload);
											info transfer_resp;
											if(transfer_resp == null || transfer_resp.get("ok") != true)
											{
												info "Stock was deducted, but Stock Transfer creation failed: " + ifnull(transfer_resp.get("message"),"No response from Store Management.");
												return;
											}
										}
										// =====================================================
										// 12) UPDATE SALES VOUCHER DETAILS ISSUE STATUS
										// =====================================================
										if(input.Request_Voucher_Type == "Sales Voucher" && input.Item_Taken != null)
										{
											svd = Sales_Voucher_Details[ID == input.Item_Taken];
											if(svd.ID != null)
											{
												total_issued_base = 0.0;
												for each  issue in Item_Issuing_Details[Item_Taken == svd.ID]
												{
													total_issued_base = total_issued_base + ifnull(issue.Quantity_in_Base_Unit_Of_Measure,0.0);
												}
												required_base = ifnull(svd.Quantity_in_Base_Unit_Of_Measure,0.0);
												svd.Quantity_Issued_in_Base_Unit_Of_Measure=total_issued_base;
												not_issued_base = required_base - total_issued_base;
												if(not_issued_base < 0)
												{
													not_issued_base = 0.0;
												}
												svd.Quantity_Not_Issued_in_Base_Unit_Of_Measure=not_issued_base;
												if(total_issued_base <= 0)
												{
													svd.Issue_Status="Not Issued";
												}
												else if(total_issued_base >= required_base)
												{
													svd.Issue_Status="Fully Issued";
												}
												else
												{
													svd.Issue_Status="Partially Issued";
												}
											}
										}
										// =====================================================
										// 13) CREATE / UPDATE EMPLOYEE ISSUING DETAILS
										// =====================================================
										source_form_val = "Concrete Products - Item Issuing Details";
										if(input.Request_Voucher_Type == "Employee Voucher" && input.Employee_Voucher != null)
										{
											existing_eid = Employee_Issuing_Details[Source_Record_ID == input.ID && Source_Form == source_form_val];
											if(existing_eid.ID != null)
											{
												existing_eid.Voucher=input.Employee_Voucher;
												existing_eid.Display_Name_Voucher=input.Request_Voucher;
												existing_eid.Line_Number=input.Line_Number;
												existing_eid.Display_Name_Item=input.Display_Name_Item;
												existing_eid.Quantity=input.Quantity;
												existing_eid.Cost=input.Cost;
												existing_eid.Item_Issuing_Detail=input.Item_Issuing_Number;
												existing_eid.Source_Record_ID=input.ID;
												existing_eid.Source_Form=source_form_val;
											}
											else
											{
												insert into Employee_Issuing_Details
												[
													Voucher=input.Employee_Voucher
													Display_Name_Voucher=input.Request_Voucher
													Line_Number=input.Line_Number
													Display_Name_Item=input.Display_Name_Item
													Quantity=input.Quantity
													Cost=input.Cost
													Item_Issuing_Detail=input.Item_Issuing_Number
													Source_Record_ID=input.ID
													Source_Form=source_form_val
													Added_User=zoho.loginuser
												]
											}
										}
										// =====================================================
										// 14) CREATE / UPDATE VOUCHER ISSUING DETAILS
										// =====================================================
										if(input.Issuing_Voucher != null)
										{
											voucher_id = null;
											voucher_display = "";
											iiv = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(iiv.ID != null)
											{
												voucher_id = iiv.Item_Issuing_Voucher;
												voucher_display = ifnull(iiv.Display_Name_Item_Issuing_Voucher,"").trim();
												if(voucher_display == "" && iiv.Item_Issuing_Voucher != null)
												{
													voucher_display = ifnull(iiv.Item_Issuing_Voucher.Voucher_Number,"");
												}
											}
											if(voucher_id != null)
											{
												existing_vid = Voucher_Issuing_Details[Source_Record_ID == input.ID && Source_Form == source_form_val];
												if(existing_vid.ID != null)
												{
													existing_vid.Voucher=voucher_id;
													existing_vid.Display_Name_Voucher=voucher_display;
													existing_vid.Line_Number=input.Line_Number;
													existing_vid.Display_Name_Item=input.Display_Name_Item;
													existing_vid.Quantity=input.Quantity;
													existing_vid.Cost=input.Cost;
													existing_vid.Item_Issuing_Detail=input.Item_Issuing_Number;
													existing_vid.Source_Record_ID=input.ID;
													existing_vid.Source_Form=source_form_val;
												}
												else
												{
													insert into Voucher_Issuing_Details
													[
														Voucher=voucher_id
														Display_Name_Voucher=voucher_display
														Line_Number=input.Line_Number
														Display_Name_Item=input.Display_Name_Item
														Quantity=input.Quantity
														Cost=input.Cost
														Item_Issuing_Detail=input.Item_Issuing_Number
														Source_Record_ID=input.ID
														Source_Form=source_form_val
														Added_User=zoho.loginuser
													]
												}
											}
										}
										// =====================================================
										// 15) DONE
										// =====================================================
										info "Item Issuing Details finalized on create. Final Status = " + input.Status;
						)
					}
				}

			}
			Finalize_On_Edit13 as "Finalize On Edit"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// CONCRETE ITEM ISSUING DETAILS - FINALIZE ON EDIT
										// =====================================================
										// 1) LOAD SAVED RECORD
										saved_rec = Item_Issuing_Details[ID == input.ID];
										if(saved_rec.ID == null)
										{
											info "Saved Item Issuing Details not found.";
											return;
										}
										saved_status = ifnull(saved_rec.Status,"").trim();
										current_status = ifnull(input.Status,"").trim();
										// 2) EDIT AUDIT
										u = thisapp.audit.getLoginAuditInfo();
										input.Updated_By_Name = u.get("name");
										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
										// 3) CANCEL LINE
										if(input.Cancel_This_Line_Item == true)
										{
											input.Status = "Cancelled";
											info "Line item cancelled. No stock change.";
											return;
										}
										// 4) PRESERVE IMPORTANT FIELDS
										if(input.Item == null)
										{
											input.Item = saved_rec.Item;
										}
										if(input.Display_Name_Item == null || input.Display_Name_Item.trim() == "")
										{
											input.Display_Name_Item = saved_rec.Display_Name_Item;
										}
										if(input.Unit_Of_Measure == null)
										{
											input.Unit_Of_Measure = saved_rec.Unit_Of_Measure;
										}
										if(input.Display_Name_Unit_Of_Measure == null || input.Display_Name_Unit_Of_Measure.trim() == "")
										{
											input.Display_Name_Unit_Of_Measure = saved_rec.Display_Name_Unit_Of_Measure;
										}
										if(input.Quantity == null)
										{
											input.Quantity = saved_rec.Quantity;
										}
										if(input.Cost == null)
										{
											input.Cost = ifnull(saved_rec.Cost,0.0);
										}
										if(input.Stock_Condition == null || input.Stock_Condition.trim() == "")
										{
											input.Stock_Condition = ifnull(saved_rec.Stock_Condition,"New");
										}
										if(input.Request_Voucher_Type == null || input.Request_Voucher_Type.trim() == "")
										{
											input.Request_Voucher_Type = ifnull(saved_rec.Request_Voucher_Type,"");
										}
										if(input.Employee_Voucher == null)
										{
											input.Employee_Voucher = saved_rec.Employee_Voucher;
										}
										if(input.Work_Order_Task == null)
										{
											input.Work_Order_Task = saved_rec.Work_Order_Task;
										}
										if(input.Line_Number == null)
										{
											input.Line_Number = saved_rec.Line_Number;
										}
										if(input.Item_Issuing_Number == null || input.Item_Issuing_Number.trim() == "")
										{
											input.Item_Issuing_Number = saved_rec.Item_Issuing_Number;
										}
										if(input.Quantity_Returned == null)
										{
											input.Quantity_Returned = ifnull(saved_rec.Quantity_Returned,0.0);
										}
										if(input.Quantity_Returned_in_Base_Unit_Of_Measure == null)
										{
											input.Quantity_Returned_in_Base_Unit_Of_Measure = ifnull(saved_rec.Quantity_Returned_in_Base_Unit_Of_Measure,0.0);
										}
										// 5) NON-EMPLOYEE VOUCHER TYPES
										// Draft/blank -> Approved without stock deduction
										// Approved -> Issued with stock deduction
										if(input.Request_Voucher_Type != "Employee Voucher")
										{
											if(current_status == "Draft" || current_status == "")
											{
												input.Status = "Approved";
												info "Draft moved to Approved. No stock deducted.";
												return;
											}
											if(current_status == "Approved")
											{
												input.Status = "Issued";
												current_status = "Issued";
											}
											else if(current_status != "Issued")
											{
												info "No activities run. Status is " + current_status;
												return;
											}
											if(input.Issuing_Voucher == null)
											{
												info "Issuing Voucher is required.";
												return;
											}
											if(input.Item == null || input.Unit_Of_Measure == null || input.Quantity == null || input.Quantity <= 0)
											{
												info "Item, Unit of Measure and Quantity are required.";
												return;
											}
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID == null || hdr.Store == null)
											{
												info "Header missing or Store missing.";
												return;
											}
											store_id = hdr.Store;
											cond = ifnull(input.Stock_Condition,"New").trim();
											if(cond == "")
											{
												cond = "New";
												input.Stock_Condition = "New";
											}
											check = store_management.po.check_uom_conversion_from_concrete(input.Item,input.Unit_Of_Measure);
											if(check == null || check.get("ok") != true)
											{
												info ifnull(check.get("message"),"UOM conversion failed.");
												return;
											}
											base_qty_create = store_management.po.convert_to_base_qty_from_concrete(input.Item,input.Unit_Of_Measure,input.Quantity);
											if(base_qty_create == null || base_qty_create <= 0)
											{
												info "Invalid base quantity.";
												return;
											}
											input.Quantity_in_Base_Unit_Of_Measure = base_qty_create;
											line_total_val = (base_qty_create * ifnull(input.Cost,0.0)).round(2);
											input.Line_Total = line_total_val;
											// Deduct stock only when moving Approved -> Issued
											if(saved_status == "Approved" && input.Status == "Issued")
											{
												ref_no = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim();
												if(ref_no == "")
												{
													ref_no = hdr.ID.toString();
												}
												stock_resp = store_management.stock.issue_stock_from_concrete(input.Item,store_id,input.Quantity,input.Unit_Of_Measure,cond,line_total_val,ref_no,input.ID);
												info stock_resp;
												if(stock_resp == null || stock_resp.get("ok") != true)
												{
													input.Status = saved_status;
													info "Stock issue failed: " + ifnull(stock_resp.get("message"),"No response from Store Management.");
													return;
												}
												input.Quantity_in_Base_Unit_Of_Measure = ifnull(stock_resp.get("base_qty"),base_qty_create);
												input.Store_Available_Stock = ifnull(stock_resp.get("store_stock"),0.0);
												input.Global_Available_Stock = ifnull(stock_resp.get("global_stock"),0.0);
											}
											else
											{
												info "No stock deduction. Stock only deducts when saved status is Approved and final status becomes Issued.";
											}
											if(input.Request_Voucher_Type == "Work Order Task" && input.Work_Order_Task != null)
											{
												qty_selected = ifnull(input.Quantity,0.0);
												qty_base = ifnull(input.Quantity_in_Base_Unit_Of_Measure,0.0);
												line_total_val = ifnull(input.Line_Total,0.0);
												unit_cost_selected = ifnull(input.Cost,0.0);
												rate_base = 0.0;
												if(qty_base > 0 && line_total_val > 0)
												{
													rate_base = (line_total_val / qty_base).round(2);
												}
												pc_exists = false;
												for each  pc_chk in Parts_Consumables[Source_Record_ID == input.ID.toString() && Source_Form == "Concrete Products - Item Issuing Details"]
												{
													pc_exists = true;
													pc_chk.Work_Order_Task_Number=input.Work_Order_Task;
													pc_chk.Display_Name_Work_Order_Task_Number=ifnull(input.Work_Order_Task.Work_Order_Task_Number,"");
													pc_chk.Line_Number=input.Line_Number;
													pc_chk.Item=input.Item;
													pc_chk.Display_Name_Item_Labour=ifnull(input.Display_Name_Item,"");
													pc_chk.Quantity=qty_selected;
													pc_chk.Quantity_In_Base_Unit=qty_base;
													pc_chk.Unit_Of_Measure=ifnull(input.Display_Name_Unit_Of_Measure,"");
													pc_chk.Unit_Cost=unit_cost_selected;
													pc_chk.Rate_In_Base_Unit=rate_base;
													pc_chk.Line_Total=line_total_val;
													pc_chk.Item_Issuing=input.ID;
													pc_chk.Item_Status=input.Status;
													break;
												}
												if(pc_exists == false)
												{
													insert into Parts_Consumables
													[
														Work_Order_Task_Number=input.Work_Order_Task
														Display_Name_Work_Order_Task_Number=ifnull(input.Work_Order_Task.Work_Order_Task_Number,"")
														Line_Number=input.Line_Number
														Item=input.Item
														Display_Name_Item_Labour=ifnull(input.Display_Name_Item,"")
														Quantity=qty_selected
														Quantity_In_Base_Unit=qty_base
														Unit_Of_Measure=ifnull(input.Display_Name_Unit_Of_Measure,"")
														Unit_Cost=unit_cost_selected
														Rate_In_Base_Unit=rate_base
														Line_Total=line_total_val
														Item_Issuing=input.ID
														Item_Status=input.Status
														Source_Record_ID=input.ID.toString()
														Source_Form="Concrete Products - Item Issuing Details"
														Added_User=zoho.loginuser
													]
												}
											}
											info "Concrete non-employee request finalized. Final status = " + input.Status;
											return;
										}
										// 6) EMPLOYEE VOUCHER REQUIRED FIELDS
										if(input.Issuing_Voucher == null)
										{
											info "Issuing Voucher is required.";
											return;
										}
										if(input.Employee_Voucher == null)
										{
											info "Employee Voucher is required.";
											return;
										}
										if(input.Item == null || input.Unit_Of_Measure == null || input.Quantity == null || input.Quantity <= 0)
										{
											info "Item, Unit of Measure and Quantity are required.";
											return;
										}
										// 7) LOAD ISSUING HEADER + STORE
										hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
										if(hdr.ID == null || hdr.Store == null)
										{
											info "Header missing or Store missing.";
											return;
										}
										store_id = hdr.Store;
										// 8) STOCK CONDITION
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = "New";
										}
										// 9) UOM CHECK + BASE QUANTITY
										check = store_management.po.check_uom_conversion_from_concrete(input.Item,input.Unit_Of_Measure);
										if(check == null || check.get("ok") != true)
										{
											info ifnull(check.get("message"),"UOM conversion failed.");
											return;
										}
										base_qty = store_management.po.convert_to_base_qty_from_concrete(input.Item,input.Unit_Of_Measure,input.Quantity);
										if(base_qty == null || base_qty <= 0)
										{
											info "Invalid base quantity.";
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure = base_qty;
										// 10) LINE TOTAL
										line_total_val = (base_qty * ifnull(input.Cost,0.0)).round(2);
										input.Line_Total = line_total_val;
										// 11) TOOL CHECK + FINAL STATUS
										is_tool_item = false;
										if(input.Item != null && input.Item.Is_Tool == true)
										{
											is_tool_item = true;
										}
										if(is_tool_item == true)
										{
											if(input.Didn_t_Come_Back == true)
											{
												input.Status = "Out of Service";
												input.Expected_Return_Date = null;
											}
											else
											{
												issued_base = ifnull(input.Quantity_in_Base_Unit_Of_Measure,0.0);
												returned_base = ifnull(input.Quantity_Returned_in_Base_Unit_Of_Measure,0.0);
												if(issued_base > 0 && returned_base >= issued_base)
												{
													input.Status = "Returned";
													input.Expected_Return_Date = null;
												}
												else
												{
													input.Status = "Borrowed";
												}
											}
										}
										else
										{
											input.Status = "Issued";
											input.Expected_Return_Date = null;
										}
										// 12) REFERENCE NUMBER
										ref_no = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim();
										if(ref_no == "")
										{
											ref_no = hdr.ID.toString();
										}
										// 13) ISSUE STOCK IN STORE MANAGEMENT
										stock_resp = store_management.stock.issue_stock_from_concrete(input.Item,store_id,input.Quantity,input.Unit_Of_Measure,cond,line_total_val,ref_no,input.ID);
										info stock_resp;
										if(stock_resp == null || stock_resp.get("ok") != true)
										{
											input.Status = saved_status;
											info "Stock issue failed: " + ifnull(stock_resp.get("message"),"No response from Store Management.");
											return;
										}
										// 14) UPDATE STOCK PREVIEW FROM RESPONSE
										input.Quantity_in_Base_Unit_Of_Measure = ifnull(stock_resp.get("base_qty"),base_qty);
										input.Store_Available_Stock = ifnull(stock_resp.get("store_stock"),0.0);
										input.Global_Available_Stock = ifnull(stock_resp.get("global_stock"),0.0);
										// 15) LOCAL EMPLOYEE ISSUING DETAILS
										if(input.Employee_Voucher != null)
										{
											eid_exists = false;
											for each  e_chk in Employee_Issuing_Details[Source_Record_ID == input.ID && Source_Form == "Item Issuing Details"]
											{
												eid_exists = true;
												e_chk.Voucher=input.Employee_Voucher;
												e_chk.Display_Name_Voucher=input.Request_Voucher;
												e_chk.Line_Number=input.Line_Number;
												e_chk.Display_Name_Item=input.Display_Name_Item;
												e_chk.Quantity=input.Quantity;
												e_chk.Cost=input.Cost;
												e_chk.Item_Issuing_Detail=input.Item_Issuing_Number;
												break;
											}
											if(eid_exists == false)
											{
												insert into Employee_Issuing_Details
												[
													Voucher=input.Employee_Voucher
													Display_Name_Voucher=input.Request_Voucher
													Line_Number=input.Line_Number
													Display_Name_Item=input.Display_Name_Item
													Quantity=input.Quantity
													Cost=input.Cost
													Item_Issuing_Detail=input.Item_Issuing_Number
													Source_Record_ID=input.ID
													Source_Form="Item Issuing Details"
													Added_User=zoho.loginuser
												]
											}
										}
										// 16) DONE
										info "Concrete Item Issuing Details finalized on edit. Final status = " + input.Status;
						)
					}
				}

			}
			On_Receiving_Account_Sele as "On Receiving Account Selected"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on user input of Receiving_Account
				{
					actions 
					{
						custom deluge script
						(
											if(input.Receiving_Account != null)
										{
											input.Display_Name_Receiving_Account = input.Receiving_Account.Account_Name;
										}
										else
										{
											input.Display_Name_Receiving_Account = null;
										}
						)
					}
				}

			}
			On_Customer_Selected2 as "On Customer Selected"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											// ON CUSTOMER SELECTED
										if(input.Customer != null)
										{
											input.Display_Name_Customer = ifnull(input.Customer.Display_Name_Customer,"");
										}
										else
										{
											input.Display_Name_Customer = null;
										}
						)
					}
				}

			}
			Set_Up_Form18 as "Set Up Form"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//HIDE FIELDS
										//Receipt Details
										hide Display_Name_Receiving_Account;
										//Customer Details
										hide Display_Name_Customer;
										//Receipt Amount Details
										//Back End
										hide Back_End;
										hide Payment_Receipt_Details;
										//SUB FORMS
										hide Charge_Details.Transaction_Type;
										hide Charge_Details.Display_Name_Payment_Voucher;
										hide Charge_Details.User_Name;
										hide Charge_Details.User_Email;
										hide Charge_Details.User_Role;
										hide Charge_Details.Created_By_Name;
										hide Charge_Details.Created_By_Email;
										hide Charge_Details.Created_By_Time;
										hide Charge_Details.Updated_By_Name;
										hide Charge_Details.Updated_By_Email;
										hide Charge_Details.Updated_By_Time;
										//DISABLE FIELDS
										//Receipt Details
										disable Display_Name_Receiving_Account;
										//disable Payment_Receipt_Date;
										//Customer Details
										disable Display_Name_Customer;
										//Receipt Amount Details
										disable Total_Charges;
										disable Total_Amount_Allocated;
										disable Total_Amount_Not_Allocated;
										disable Payment_Receipt_Voucher_Status;
										//Back End
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										//SUBFORMS
										//Charge Details
										disable Charge_Details.Transaction_Type;
										disable Charge_Details.Display_Name_Payment_Voucher;
										disable Charge_Details.Line_Number;
										disable Charge_Details.User_Name;
										disable Charge_Details.User_Email;
										disable Charge_Details.User_Role;
										disable Charge_Details.Created_By_Name;
										disable Charge_Details.Created_By_Email;
										disable Charge_Details.Created_By_Time;
										disable Charge_Details.Updated_By_Name;
										disable Charge_Details.Updated_By_Email;
										disable Charge_Details.Updated_By_Time;
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
						)
					}
				}

			}
			Finalize_On_Create18 as "Finalize On Create"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
						)
					}
				}

			}
			Finalize_On_Edit15 as "Finalize On Edit"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											u = thisapp.audit.getLoginAuditInfo();
										input.Updated_By_Name = u.get("name");
										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
						)
					}
				}

			}
			Finalize4 as "Finalize"
			{
				type =  form
				form = Payment_Receipt_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											rec = Payment_Receipt_Voucher[ID == input.ID];
										if(rec.ID != null)
										{
											if(rec.Payment_Receipt_Date == null)
											{
												rec.Payment_Receipt_Date=zoho.currenttime;
											}
											total_charges = 0.0;
											for each  chg in rec.Charge_Details
											{
												total_charges = total_charges + ifnull(chg.Amount,0);
											}
											rec.Total_Charges=total_charges;
											total_allocated = 0.0;
											for each  det in Payment_Receipt_Details[Payment_Receipt_Voucher == rec.ID]
											{
												total_allocated = total_allocated + ifnull(det.Amount_Allocated,0);
											}
											rec.Total_Amount_Allocated=total_allocated;
											rec.Total_Amount_Not_Allocated=ifnull(rec.Total_Amount_Received,0) - ifnull(rec.Total_Charges,0) - ifnull(rec.Total_Amount_Allocated,0);
											if(rec.Total_Amount_Not_Allocated < 0)
											{
												rec.Total_Amount_Not_Allocated=0;
											}
											// Status
											if(ifnull(rec.Total_Amount_Allocated,0) == 0)
											{
												rec.Payment_Receipt_Voucher_Status="Unassigned";
											}
											else if(rec.Total_Amount_Not_Allocated > 0)
											{
												rec.Payment_Receipt_Voucher_Status="Partially Assigned";
											}
											else
											{
												rec.Payment_Receipt_Voucher_Status="Fully Assigned";
											}
										}
										if(input.ID != null)
										{
											receipt_datetime_txt = "";
											receipt_date_txt = "";
											if(input.Payment_Receipt_Date != null)
											{
												receipt_datetime_txt = input.Payment_Receipt_Date.toString("yyyy-MM-dd HH:mm:ss");
												receipt_date_txt = input.Payment_Receipt_Date.toString("yyyy-MM-dd");
											}
											created_time_txt = "";
											if(input.Created_By_Time != null)
											{
												created_time_txt = input.Created_By_Time.toString("yyyy-MM-dd HH:mm:ss");
											}
											updated_time_txt = "";
											if(input.Updated_By_Time != null)
											{
												updated_time_txt = input.Updated_By_Time.toString("yyyy-MM-dd HH:mm:ss");
											}
											// ==============================
											// SYNC PAYMENT VOUCHER
											// ==============================
											payload = Map();
											payload.put("Transaction_Type","Debit");
											payload.put("Account",input.Receiving_Account);
											payload.put("Display_Name_Account",ifnull(input.Display_Name_Receiving_Account,""));
											payload.put("Payment_Number",ifnull(input.Payment_Receipt_Number,""));
											payload.put("Payment_Date",receipt_date_txt);
											payload.put("Payment_Date_Time",receipt_datetime_txt);
											payload.put("Description",ifnull(input.Display_Name_Customer,""));
											payload.put("Total_Amount_Received",ifnull(input.Total_Amount_Received,0.0));
											payload.put("Total_Amount_Paid",0.0);
											payload.put("Payment_Voucher_Status","Draft");
											payload.put("Application","Concrete Products Management");
											payload.put("Transaction_Date",receipt_date_txt);
											payload.put("Source_Form","Payment Receipt Voucher");
											payload.put("Source_Record_ID",input.ID.toLong());
											payload.put("Voucher_Number",ifnull(input.Payment_Receipt_Number,""));
											payload.put("User_Name",ifnull(input.User_Name,""));
											payload.put("User_Email",ifnull(input.User_Email,""));
											payload.put("User_Role",ifnull(input.User_Role,""));
											payload.put("Created_By_Name",ifnull(input.Created_By_Name,""));
											payload.put("Created_By_Email",ifnull(input.Created_By_Email,""));
											payload.put("Created_By_Time",created_time_txt);
											payload.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
											payload.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
											payload.put("Updated_By_Time",updated_time_txt);
											sync_resp = payment_management.syncPaymentVoucherFromConcrete(payload);
											info sync_resp;
											// ==============================
											// ACCOUNT TRANSACTION LOG
											// ==============================
											receipt_dt = input.Payment_Receipt_Date;
											if(receipt_dt == null)
											{
												receipt_dt = zoho.currenttime;
											}
											txn = Map();
											txn.put("Transaction_Date",receipt_dt);
											txn.put("Account",input.Receiving_Account);
											txn.put("Display_Name_Account",ifnull(input.Display_Name_Receiving_Account,""));
											txn.put("Transaction_Type","Debit");
											txn.put("Amount",ifnull(input.Total_Amount_Received,0.0));
											txn.put("Reference_Type","Payment Receipt Voucher");
											txn.put("Reference_Number",ifnull(input.Payment_Receipt_Number,""));
											txn.put("Application","Concrete Products Management");
											txn.put("Source_Form","Payment Receipt Voucher");
											txn.put("Source_Record_ID",input.ID);
											txn.put("Notes",ifnull(input.Display_Name_Customer,""));
											txn.put("User_Name",ifnull(input.User_Name,""));
											txn.put("User_Email",ifnull(input.User_Email,""));
											txn.put("User_Role",ifnull(input.User_Role,""));
											txn.put("Created_By_Name",ifnull(input.Created_By_Name,""));
											txn.put("Created_By_Email",ifnull(input.Created_By_Email,""));
											txn.put("Created_By_Time",input.Created_By_Time);
											txn.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
											txn.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
											txn.put("Updated_By_Time",zoho.currenttime);
											txn_resp = payment_management.createOrUpdateAccountTransactionLog(txn);
											info txn_resp;
											payment_management.Recalculate_Unconfirmed_Account_Totals();
										}
										// ==============================
										// OPEN PAYMENT DETAILS FORM
										// ==============================
										if(input.Total_Amount_Not_Allocated > 0)
										{
											openUrl("#Form:Payment_Receipt_Details","same window");
										}
										// =====================================================
										// UPDATE CUSTOMER PERFORMANCE
										// =====================================================
										if(input.Customer != null)
										{
											thisapp.customer.update_customer_performance(input.Customer);
										}
						)
					}
				}

			}
			On_Payment_Receipt_Vouche as "On Payment Receipt Voucher Selected"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on user input of Payment_Receipt_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Payment_Receipt_Voucher != null)
										{
											input.Display_Name_Voucher = input.Payment_Receipt_Voucher.Payment_Receipt_Number;
											last_line = Payment_Receipt_Details[Payment_Receipt_Voucher == input.Payment_Receipt_Voucher].count();
											input.Line_Number = last_line + 1;
											input.Amount_Not_Allocated = ifnull(input.Payment_Receipt_Voucher.Total_Amount_Not_Allocated,0.0);
										}
										else
										{
											input.Display_Name_Voucher = null;
