			Set_Up_Form33 as "Set Up Form"
			{
				type =  form
				form = Customer_Purchase_Order

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//DISABLE FIELDS
										disable Display_Name_Customer;
										disable Sand_Purchase_Order_Details.Display_Name_Purchase_Order;
										disable Sand_Purchase_Order_Details.Line_Number;
										disable Sand_Purchase_Order_Details.Display_Name_Item;
										disable Sand_Purchase_Order_Details.Line_Total;
										disable Sand_Purchase_Order_Details.Quantity_Ordered_to_CBM;
										disable Sand_Purchase_Order_Details.Quantity_Delivered;
										disable Sand_Purchase_Order_Details.Quantity_Remaining;
										//HIDE FIELDS
										hide Display_Name_Customer;
										hide Sand_Purchase_Order_Details.Display_Name_Customer;
										hide Sand_Purchase_Order_Details.Display_Name_Purchase_Order;
										hide Sand_Purchase_Order_Details.Display_Name_Item;
										disable Sand_Purchase_Order_Details.Line_Total;
										hide Back_End;
						)
					}
				}

			}
			Full_Validation17 as "Full Validation"
			{
				type =  form
				form = Customer_Purchase_Order

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ===============================
										// Full Validation – Sand Purchase Order
										// ===============================
										// 1) Customer required
										if(input.Customer == null)
										{
											alert "Customer is required.";
											cancel submit;
										}
										// 2) Purchase Order Number required
										if(input.Purchase_Order_Number == null || input.Purchase_Order_Number.trim() == "")
										{
											alert "Purchase Order Number is required.";
											cancel submit;
										}
										// 3) Purchase Order Number no duplicates (exclude current record when editing)
										dupPO = Customer_Purchase_Order[Purchase_Order_Number == input.Purchase_Order_Number && ID != input.ID];
										if(dupPO.count() > 0)
										{
											alert "Purchase Order Number already exists. Please use a unique number.";
											cancel submit;
										}
										// 4) Purchase Order Date required and cannot be future
										if(input.Purchase_Order_Date == null)
										{
											alert "Purchase Order Date is required.";
											cancel submit;
										}
										if(input.Purchase_Order_Date > zoho.currentdate)
										{
											alert "Purchase Order Date cannot be in the future.";
											cancel submit;
										}
										// 5) At least one record in the subform (use count(), not size())
										if(input.Sand_Purchase_Order_Details == null || input.Sand_Purchase_Order_Details.count() == 0)
										{
											alert "Please add at least one item in Purchase Order Details.";
											cancel submit;
										}
										// 6) Subform row validations
										rowIndex = 1;
										for each  poRow in input.Sand_Purchase_Order_Details
										{
											// Item required
											if(poRow.Item == null)
											{
												alert "Row " + rowIndex + ": Item is required.";
												cancel submit;
											}
											// Quantity Ordered required and cannot be negative
											if(poRow.Quantity_Ordered == null)
											{
												alert "Row " + rowIndex + ": Quantity Ordered is required.";
												cancel submit;
											}
											if(poRow.Quantity_Ordered < 0)
											{
												alert "Row " + rowIndex + ": Quantity Ordered cannot be negative.";
												cancel submit;
											}
											// Unit Of Measure required
											if(poRow.Unit_Of_Measure == null)
											{
												alert "Row " + rowIndex + ": Unit Of Measure is required.";
												cancel submit;
											}
											// Rate required
											if(poRow.Rate == null)
											{
												alert "Row " + rowIndex + ": Rate is required.";
												cancel submit;
											}
											rowIndex = rowIndex + 1;
										}
						)
					}
				}

			}
