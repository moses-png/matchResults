
 application ""
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Africa/Kampala"
 	time format = "24-hr"

 	forms
	{
		form Asset_Issues
		{
			displayname = "Asset Issues"
			success message = "Data Added Successfully!"
			Asset_Issue_Details
			(
				type = section
				displayname = "Asset Issue Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Employee_Voucher
			(
				type = picklist	
				displayname = "Employee Voucher"
				values  = Voucher_Register[Voucher_Status == "Issued"].ID
    			displayformat = [Voucher_Number + " - " + Display_Name_Employee]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Voucher
			(
    			type = text
				displayname = "Voucher "
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reported_By
			(
    			type = text
				displayname = "Reported By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Site
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Number
			(
    			type = text
				displayname = "Issue Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Asset
			(
				type = picklist	
				values  = asset_management.Asset_List.ID
    			displayformat = [Asset_Name + " - " + Asset_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Asset
			(
    			type = text
				displayname = "Display Name Asset"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Site
			(
    			type = text
				displayname = "Current Site"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Custodian
			(
    			type = text
				displayname = "Current Custodian"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Odometer_Reading
			(
				type = decimal
				displayname = "Odometer Reading                "
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reported_Date
			(
    			type = datetime
				displayname = "Reported Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Description
			(
    			type = textarea
				displayname = "Issue Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Severity
			(
				type = picklist
				maxchar = 100
				values = {"Low","Medium","High","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Status
			(
				type = picklist
				displayname = "Issue Status"
				maxchar = 100
				values = {"Draft","Open","In Progress","Resolved","Closed","Cancelled"}
				initial value = "Draft"
	 			row = 1
	 			column = 1   
				width = medium
			)
			attachments
			(
    			type = upload file
				displayname = "Attachments"
    			file count = 10
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Labour_Total
			(
				displayname = "Labour Total"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Parts_Total
			(
				displayname = "Parts Total"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Service_Task_Cost
			(
				displayname = "Total Service Task Cost"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Number_Of_Work_Order_Tasks
			(
				type = number
				displayname = "Number Of Work Order Tasks"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Work_Order
			(
				type = section
				displayname = "Work Order"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Resolve_Issue
			(
    			type = checkbox
				displayname = "Resolve Issue"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Reason_Why_Resolved
			(
    			type = textarea
				displayname = "Reason Why Resolved"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Order_Number
			(
    			type = text
				displayname = "Work Order Number"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Order_Date
			(
    			type = datetime
				displayname = "Work Order Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Order_Odometer_Reading
			(
				type = decimal
				displayname = "Work Order Odometer Reading"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Order_in_Charge_Of
			(
				type = picklist	
				displayname = "Work Order in Charge Of"
				values  = employee_management.Employee_Register.ID
    			displayformat = [Employee_Name + " - " + Employee_Number]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Display_Name_Work_Order_in_Charge_Of
			(
    			type = text
				displayname = "Display Name Work Order in Charge Of"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Order_Status
			(
				type = picklist
				displayname = "Work Order Status"
				maxchar = 100
				values = {"Draft","Pending","In Progress","Completed","Cancelled"}
				initial value = "Draft"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Cancel_Work_Order
			(
    			type = checkbox
				displayname = "Cancel Work Order"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Reason_Why_Cancelled
			(
    			type = textarea
				displayname = "Reason Why Cancelled"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Issue_Stats
			(
				type = section
				displayname = "Issue Stats"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Overall_Start_Date
			(
    			type = datetime
				displayname = "Overall Start Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Odometer_Reading_Started
			(
				type = decimal
				displayname = "Odometer Reading Started"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Overall_End_Date
			(
    			type = datetime
				displayname = "Overall End Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Odometer_Reading_Ended
			(
				type = decimal
				displayname = "Odometer Reading Ended"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Work_Order_Tasks
			(
				type = grid
				displayname = "Work Order Tasks"
				values  = Work_Order_Tasks.ID
    			bidirectional = Work_Order
	 			row = 4
	 			column = 1   
				width = medium
			)
			Sync_Details
			(
				type = section
				displayname = "Sync Details"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Source_Form
			(
    			type = text
				displayname = "Source Form"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Source_Record_ID
			(
				type = number
				displayname = "Source Record ID"
				maxchar = 19
	 			row = 5
	 			column = 1   
				width = medium
			)
			Back_End
			(
				type = section
				displayname = "Back  End"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 6
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 6
	 			column = 1   
				width = medium
				personal data = true
			)
			User_Role
			(
    			type = text
				displayname = "User Role"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Created_By_Name
			(
    			type = text
				displayname = "Created By Name"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Created_By_Email
			(
    			type = email
				displayname = "Created By Email"
				maxchar = 80
	 			row = 6
	 			column = 1   
				width = medium
				personal data = true
			)
			Created_By_Time
			(
    			type = datetime
				displayname = "Created By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 1   
				width = medium
			)
			Updated_By_Name
			(
    			type = text
				displayname = "Updated By Name"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Updated_By_Email
			(
    			type = email
				displayname = "Updated By Email"
				maxchar = 80
	 			row = 6
	 			column = 1   
				width = medium
				personal data = true
			)
			Updated_By_Time
			(
    			type = datetime
				displayname = "Updated By  Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Bill
		{
			success message = "Data Added Successfully!"
			Bill
			(
				type = section
				displayname = "Bill "
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Bill_Date
			(
    			type = date
				displayname = "Bill Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Bill_Type
			(
				type = picklist
				displayname = "Bill Type"
				maxchar = 100
				values = {"Store Bill","Invoice Bill","Employee Bill","Sales Voucher Bill"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vendor
			(
				type = picklist	
				values  = vendor_and_client_management.Business_Partners_Register.ID
    			displayformat = [Party_Name + " - " + Party_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee_Vendor
			(
				type = picklist	
				displayname = "Employee Vendor"
				values  = employee_management.Employee_Register.ID
    			displayformat = [Employee_Name + " - " + Employee_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sales_Voucher
			(
				type = picklist	
				displayname = "Sales Voucher"
				values  = Sales_Voucher.ID
    			bidirectional = Bill
    			displayformat = [Sales_Voucher_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Invoice
			(
				type = picklist	
				values  = Invoice.ID
    			bidirectional = Bill
    			displayformat = [Invoice_Number + " - " + Display_Name_Customer]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer
			(
				type = picklist	
				values  = Customer_Register.ID
    			displayformat = [Customer_Name + " - " + Customer_Code]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Vendor
			(
    			type = text
				displayname = "Display Name Vendor"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Bill_Name
			(
    			type = text
				displayname = "Bill Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Bill_Number
			(
    			type = text
				displayname = "Bill Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Bill_Total
			(
				displayname = "Bill Total"
				type = UGX
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Services
			(
				type = grid
				values  = Service_Details.ID
    			bidirectional = Bill
	 			row = 2
	 			column = 1   
				width = medium
			)
			Bill_Details
			(
				type = grid
				displayname = "Bill Details"
				values  = Bill_Details.ID
    			bidirectional = Bill
	 			row = 3
	 			column = 1   
				width = medium
			)
			Payment_Made_Details
			(
				type = grid
				displayname = "Payment Made Details"
				values  = Payment_Made_Details.ID
    			bidirectional = Bill
	 			row = 4
	 			column = 1   
				width = medium
			)
			Document_Footer
			(
				type = section
				displayname = "Document Footer"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Services_Total
			(
				displayname = "Services Total"
				type = UGX
				format = commadotwestern
	 			row = 5
	 			column = 1   
				width = medium
			)
			Total_Amount
			(
				displayname = "Total Amount"
				type = UGX
				format = commadotwestern
	 			row = 5
	 			column = 1   
				width = medium
			)
			Tax_Amount
			(
				displayname = "Tax Amount"
				type = UGX
				format = commadotwestern
	 			row = 5
	 			column = 1   
				width = medium
			)
			Discount_Amount
			(
				displayname = "Discount Amount"
				type = UGX
				format = commadotwestern
	 			row = 5
	 			column = 1   
				width = medium
			)
			Amount_Due
			(
				displayname = "Amount Due"
				type = UGX
				format = commadotwestern
	 			row = 5
	 			column = 1   
				width = medium
			)
			Amount_Paid
			(
				displayname = "Amount Paid"
				type = UGX
				format = commadotwestern
	 			row = 5
	 			column = 1   
				width = medium
			)
			Balance_Due
			(
				displayname = "Balance Due"
				type = UGX
				format = commadotwestern
	 			row = 5
	 			column = 1   
				width = medium
			)
			Bill_Status
			(
				type = picklist
				displayname = "Bill Status"
				maxchar = 100
				values = {"Draft","Billed","Cancelled"}
				initial value = "Draft"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Payment_Status
			(
				type = picklist
				displayname = "Payment Status"
				maxchar = 100
				values = {"Not Paid","Partially Paid","Paid"}
				initial value = "Not Paid"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Back_End
			(
				type = section
				displayname = "Back End"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 6
	 			column = 1   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 6
	 			column = 1   
				width = medium
				personal data = true
			)
			User_Role
			(
    			type = text
				displayname = "User Role"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Created_By_Name
			(
    			type = text
				displayname = "Created By Name"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Created_By_Email
			(
    			type = email
				displayname = "Created By Email "
				maxchar = 80
	 			row = 6
	 			column = 1   
				width = medium
				personal data = true
			)
			Created_By_Time
			(
    			type = datetime
				displayname = "Created By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 1   
				width = medium
			)
			Updated_By_Name
			(
    			type = text
				displayname = "Updated By Name"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Updated_By_Email
			(
    			type = email
				displayname = "Updated By Email"
				maxchar = 80
	 			row = 6
	 			column = 1   
				width = medium
				personal data = true
			)
			Updated_By_Time
			(
    			type = datetime
				displayname = "Updated By Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Bill_Details
		{
			displayname = "Bill Details"
			success message = "Data Added Successfully!"
			Bill_Details
			(
				type = section
				displayname = "Bill Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Stock_Receiving_Details
			(
				type = picklist	
				displayname = "Stock Receiving Details"
				values  = Stock_Receiving_Details.ID
    			displayformat = [Stock_Receiving_Voucher_and_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Bill
			(
				type = picklist	
				values  = Bill[Payment_Status != "Paid"].ID
    			bidirectional = Bill_Details
    			displayformat = [Bill_Name + " - " + Bill_Number]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Bill
			(
    			type = text
				displayname = "Display Name Bill"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Details_Date
			(
    			type = date
				displayname = "Details Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Line_Number
			(
				type = number
				displayname = "Line Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reference
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Parts_Consumables
			(
				type = picklist	
				displayname = "Parts & Consumables"
				values  = Parts_Consumables.ID
    			bidirectional = Bill_Details
    			displayformat = [Display_Name_Item_Labour + " - " + Display_Name_Work_Order_Task_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Item
			(
				type = picklist	
				values  = Purchase_Order_Details[Quantity_Billable > 0].ID
    			displayformat = [Display_Name_Item + " - " + Quantity_Billable]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Display_Name_Item
			(
    			type = text
				displayname = "Display Name Item"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expense_Type
