			On_Payment_Made_Voucher_S1 as "On Payment Made Voucher Selected"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on user input of Payment_Made_Voucher
				{
					actions 
					{
						custom deluge script
						(
											if(input.Payment_Made_Voucher != null)
										{
											input.Display_Name_Payment_Made_Voucher = input.Payment_Made_Voucher.Payment_Made_Number;
											input.Display_Name_Vendor = input.Payment_Made_Voucher.Display_Name_Vendor;
											// Pull amount not allocated
											input.Amount_Not_Allocated = ifnull(input.Payment_Made_Voucher.Total_Amount_Not_Allocated,0);
											// Line number
											line_no = 1;
											rows = Payment_Made_Details[Payment_Made_Voucher == input.Payment_Made_Voucher];
											if(rows.count() > 0)
											{
												line_no = rows.count() + 1;
											}
											input.Line_Number = line_no;
										}
										else
										{
											input.Display_Name_Payment_Made_Voucher = "";
											input.Display_Name_Vendor = "";
											input.Amount_Not_Allocated = 0;
											input.Line_Number = null;
										}
						)
					}
				}

			}
			On_Item_Selected6 as "On Item Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Parts_Consumables.Item
				{
					actions 
					{
						custom deluge script
						(
											// ===== ITEM SELECTED =====
										if(row.Item != null)
										{
											row.Labour=null;
											row.Display_Name_Item_Labour=ifnull(row.Item.Item_Name,"") + " - " + ifnull(row.Item.SKU,"");
											row.Unit_Cost=ifnull(row.Item.Default_Cost,0);
											row.Unit_Of_Measure=ifnull(row.Item.Display_Name_Base_Unit_Of_Measure,"");
											row.Quantity=null;
											row.Line_Total=null;
										}
										else
										{
											row.Unit_Cost=null;
											row.Unit_Of_Measure="";
											row.Quantity=null;
											row.Line_Total=null;
											if(row.Labour == null)
											{
												row.Display_Name_Item_Labour="";
											}
										}
										// ===== RECALCULATE TOTALS =====
										parts_rows = List();
										for each  r in input.Parts_Consumables
										{
											m = Map();
											m.put("Item",r.Item);
											m.put("Labour",r.Labour);
											m.put("Quantity",r.Quantity);
											m.put("Unit Cost",r.Unit_Cost);
											parts_rows.add(m);
										}
										input.Parts_Total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
										input.Labour_Total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Parts_Total,input.Labour_Total);
						)
					}
				}

			}
			On_Labour_Selected as "On Labour Selected"
			{
				type =  form
				form = Work_Order_Tasks

				record event = on add or edit

				on user input of Parts_Consumables.Labour
				{
					actions 
					{
						custom deluge script
						(
											// ===== LABOUR SELECTED: make row a Labour row, reset amounts =====
										if(row.Labour != null)
										{
											row.Item=null;
											row.Display_Name_Item_Labour=row.Labour.Labour_Name;
											row.Quantity=null;
											row.Unit_Cost=null;
											row.Line_Total=null;
										}
										else
										{
											if(row.Item == null)
											{
												row.Display_Name_Item_Labour="";
											}
										}
										parts_rows = List();
										for each  r in input.Parts_Consumables
										{
											m = Map();
											m.put("Item",r.Item);
											m.put("Labour",r.Labour);
											m.put("Quantity",r.Quantity);
											m.put("Unit Cost",r.Unit_Cost);
											parts_rows.add(m);
										}
										input.Parts_Total = thisapp.asset_calc.asset_calc_parts_total(parts_rows);
										input.Labour_Total = thisapp.asset_calc.asset_calc_labour_total(parts_rows);
										input.Grand_Total = thisapp.asset_calc.asset_calc_grand_total(input.Parts_Total,input.Labour_Total);
						)
					}
				}

			}
			Finalize10 as "Finalize"
			{
				type =  form
				form = Payment_Made_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// PAYMENT MADE DETAILS — FINALIZE
										// ======================================================
										if(input.Payment_Made_Voucher != null)
										{
											rec = Payment_Made_Voucher[ID == input.Payment_Made_Voucher.ID];
											if(rec.ID != null)
											{
												input.Amount_Allocated = ifnull(input.Amount_Paid,0.0);
												// Update Bill
												if(input.Bill != null)
												{
													bill_rec = Bill[ID == input.Bill.ID];
													if(bill_rec.ID != null)
													{
														total_paid_for_bill = 0.0;
														for each  pmv in Payment_Made_Voucher[ID != null]
														{
															for each  row2 in pmv.Made_Details
															{
																if(row2.Bill != null && row2.Bill.ID == bill_rec.ID)
																{
																	total_paid_for_bill = total_paid_for_bill + ifnull(row2.Amount_Paid,0.0);
																}
															}
														}
														original_bill_amount = ifnull(bill_rec.Total_Amount,0.0);
														new_due = original_bill_amount - total_paid_for_bill;
														if(new_due < 0)
														{
															new_due = 0.0;
														}
														bill_rec.Amount_Paid=total_paid_for_bill;
														bill_rec.Amount_Due=new_due;
														bill_rec.Balance_Due=new_due;
														if(new_due <= 0)
														{
															bill_rec.Payment_Status="Paid";
														}
														else if(total_paid_for_bill > 0)
														{
															bill_rec.Payment_Status="Partially Paid";
														}
														else
														{
															bill_rec.Payment_Status="Unpaid";
														}
													}
												}
												total_charges = 0.0;
												for each  ch in rec.Charge_Details
												{
													total_charges = total_charges + ifnull(ch.Amount,0.0);
												}
												total_allocated = 0.0;
												for each  det in rec.Made_Details
												{
													total_allocated = total_allocated + ifnull(det.Amount_Paid,0.0);
												}
												rec.Total_Charges=total_charges;
												rec.Total_Amount_Allocated=total_allocated;
												rec.Total_Amount_Not_Allocated=ifnull(rec.Total_Amount_Paid,0.0) - total_charges - total_allocated;
												if(rec.Total_Amount_Not_Allocated < 0)
												{
													rec.Total_Amount_Not_Allocated=0.0;
												}
												if(total_allocated == 0)
												{
													rec.Payment_Made_Voucher_Status="Unassigned";
												}
												else if(rec.Total_Amount_Not_Allocated > 0)
												{
													rec.Payment_Made_Voucher_Status="Partially Assigned";
												}
												else
												{
													rec.Payment_Made_Voucher_Status="Fully Assigned";
												}
												if(ifnull(input.Amount_Paid,0.0) > 0)
												{
													post = Map();
													post.put("Display_Name_Application","Masaka Site Management");
													post.put("Source_Form","Payment Made Details");
													post.put("Source_Record_ID",input.ID.toString());
													post.put("Voucher_Number",ifnull(rec.Payment_Made_Number,""));
													post.put("Transaction_Date",rec.Payment_Made_Date);
													post.put("Business_Division",null);
													post.put("Display_Name_Business_Division","");
													post.put("Amount_To_Receive",0.0);
													post.put("Amount_Received",0.0);
													post.put("Amount_Not_Received",0.0);
													post.put("Amount_To_Pay",0.0);
													post.put("Amount_Paid",ifnull(input.Amount_Paid,0.0));
													post.put("Amount_Not_Paid",ifnull(input.Amount_Paid,0.0) * -1);
													grapes_group.cleansandmanagement.postBusinessDivisionDetail(post);
												}
												if(input.ID != null && input.Payment_Type == "Cash")
												{
													description = "";
													doc_name = "";
													if(ifnull(input.Display_Name_Voucher,"") != "")
													{
														doc_name = input.Display_Name_Voucher;
														if(doc_name.contains(" - "))
														{
															doc_name = doc_name.getPrefix(" - ");
														}
													}
													if(ifnull(input.Payment_Document,"") != "")
													{
														description = input.Payment_Document;
													}
													if(doc_name != "")
													{
														if(description != "")
														{
															description = description + " - ";
														}
														description = description + doc_name;
													}
													transaction_date_txt = "";
													if(rec.Payment_Made_Date != null)
													{
														transaction_date_txt = rec.Payment_Made_Date.toString("dd-MMM-yyyy");
													}
													created_time_txt = "";
													if(input.Created_By_Time != null)
													{
														created_time_txt = input.Created_By_Time.toString("dd-MMM-yyyy HH:mm:ss");
													}
													updated_time_txt = "";
													if(input.Updated_By_Time != null)
													{
														updated_time_txt = input.Updated_By_Time.toString("dd-MMM-yyyy HH:mm:ss");
													}
													payload = Map();
													payload.put("Payment_Voucher_Source_ID",rec.ID.toLong());
													payload.put("Display_Name_Payment_Voucher",ifnull(input.Display_Name_Payment_Made_Voucher,""));
													payload.put("Line_Number",input.Line_Number);
													payload.put("Description",description);
													payload.put("Amount_Allocated",ifnull(input.Amount_Allocated,0.0));
													payload.put("Application","Clean Sand Management");
													payload.put("Transaction_Date",transaction_date_txt);
													payload.put("Source_Form","Payment Made Details");
													payload.put("Source_Record_ID",input.ID.toLong());
													payload.put("Voucher_Number",ifnull(rec.Payment_Made_Number,""));
													payload.put("User_Name",ifnull(input.User_Name,""));
													payload.put("User_Email",ifnull(input.User_Email,""));
													payload.put("User_Role",ifnull(input.User_Role,""));
													payload.put("Created_By_Name",ifnull(input.Created_By_Name,""));
													payload.put("Created_By_Email",ifnull(input.Created_By_Email,""));
													payload.put("Created_By_Time",created_time_txt);
													payload.put("Updated_By_Name",ifnull(input.Updated_By_Name,""));
													payload.put("Updated_By_Email",ifnull(input.Updated_By_Email,""));
													payload.put("Updated_By_Time",updated_time_txt);
													sync_resp = payment_management.syncPaymentMadeDetailsFromCleanSand2(payload);
													info sync_resp;
													if(sync_resp != null && sync_resp.get("ok") == true)
													{
														account_id_val = sync_resp.get("account_id");
														if(account_id_val != null)
														{
															refresh_resp = payment_management.refreshAccountTransactionLog(account_id_val.toLong());
															info refresh_resp;
														}
													}
												}
											}
										}
										// ==========================================
										// UPDATE PURCHASE ORDER AFTER PAYMENT CHANGE
										// ==========================================
										if(input.Bill != null)
										{
											bill_id = input.Bill.ID;
											po_ids = List();
											bill_detail_rows = Bill_Details[Bill == bill_id];
											for each  bd in bill_detail_rows
											{
												if(bd.Item != null)
												{
													po_det = Purchase_Order_Details[ID == bd.Item.ID];
													if(po_det.ID != null && po_det.Purchase_Order != null)
													{
														po_id = po_det.Purchase_Order.ID;
														if(!po_ids.contains(po_id))
														{
															po_ids.add(po_id);
														}
													}
												}
											}
											for each  po_id in po_ids
											{
												thisapp.po.update_po_receiving_status(po_id);
											}
										}
										if(input.Payment_Document == "Sales Voucher" && input.Sales_Voucher != null)
										{
											sales_voucher_id = input.Sales_Voucher;
											sales_voucher_record = Sales_Voucher[ID == sales_voucher_id];
											if(sales_voucher_record.ID != null)
											{
												// =============================================
												// 1. RECALCULATE GROSS CUSTOMER PAYMENTS
												// =============================================
												gross_amount_paid = 0.0;
												gross_amount_credited = 0.0;
												for each  receipt in Payment_Receipt_Details[Sales_Voucher == sales_voucher_id]
												{
													gross_amount_paid = gross_amount_paid + ifnull(receipt.Amount_Allocated,0.0);
													gross_amount_credited = gross_amount_credited + ifnull(receipt.Amount_Credited,0.0);
												}
												gross_amount_paid = round(gross_amount_paid,2);
												gross_amount_credited = round(gross_amount_credited,2);
												// =============================================
												// 2. RECALCULATE ALL REFUNDS
												// =============================================
												amount_returned_total = 0.0;
												for each  refund in Payment_Made_Details[Payment_Document == "Sales Voucher" && Sales_Voucher == sales_voucher_id]
												{
													amount_returned_total = amount_returned_total + ifnull(refund.Amount_Paid,0.0);
												}
												amount_returned_total = round(amount_returned_total,2);
												// =============================================
												// 3. APPLY REFUND AGAINST CASH PAYMENT
												// =============================================
												refund_against_paid = 0.0;
												if(amount_returned_total <= gross_amount_paid)
												{
													refund_against_paid = amount_returned_total;
												}
												else
												{
													refund_against_paid = gross_amount_paid;
												}
												net_amount_paid = round(gross_amount_paid - refund_against_paid,2);
												remaining_refund = round(amount_returned_total - refund_against_paid,2);
												net_amount_credited = round(gross_amount_credited - remaining_refund,2);
												if(net_amount_credited < 0)
												{
													net_amount_credited = 0.0;
												}
												sales_voucher_record.Amount_Paid=net_amount_paid;
												sales_voucher_record.Amount_Credited=net_amount_credited;
												sales_voucher_record.Amount_Returned=amount_returned_total;
												sales_voucher_balance = round(ifnull(sales_voucher_record.Grand_Total,0.0) - net_amount_paid - net_amount_credited,2);
												sales_voucher_record.Balance_Due=sales_voucher_balance;
												if(sales_voucher_record.Cancel_Voucher == true)
												{
													sales_voucher_record.Payment_Status="Cancelled";
												}
												else if(sales_voucher_balance < 0)
												{
													sales_voucher_record.Payment_Status="Over Paid";
												}
												else if(sales_voucher_balance == 0)
												{
													sales_voucher_record.Payment_Status="Paid";
												}
												else if(net_amount_paid > 0)
												{
													sales_voucher_record.Payment_Status="Partially Paid";
												}
												else if(net_amount_credited > 0)
												{
													sales_voucher_record.Payment_Status="Partially Credited";
												}
												else
												{
													sales_voucher_record.Payment_Status="Unpaid";
												}
											}
										}
						)
					}
				}

			}
			On_Quantity_Selected4 as "On Quantity Selected"
