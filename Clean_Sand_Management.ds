										hide Display_Name_Received_By;
										hide Date_Time_Out;
										hide Hours_Worked;
										hide Shift;
										hide Voucher_Status;
										hide Notes;
										hide Not_Created;
										hide Reason_Why_Not_Created;
										disable Reason_Why_Not_Created;
										hide Shift_Voucher_Summary;
										hide Opening_Vouchers;
										hide Vouchers_Issued;
										hide Vouchers_Returned;
										hide Outstanding_Vouchers;
										hide Voucher_Header;
										hide Management_Location;
										hide Asset;
										hide Machine_Start_Of_Day;
										hide Start_Time;
										hide Odometer_Start;
										hide Fuel_Start_Level;
										hide Item;
										hide Display_Name_Item;
										hide Quantity_To_Be_Created;
										hide Voucher_Footer;
										hide Employee_Cost;
										hide Voucher_Cost;
										hide End_Time;
										hide Quantity_Created;
										hide Odometer_End;
										hide Fuel_End_Level;
										hide Manager_Section;
										hide Manager_Time;
										hide Cancel_Voucher;
										hide Cancellation_Reason;
										hide Employee_Taking_To_Head_Office;
										hide How_to_Take_to_Head_Office;
										hide Time_Sent_to_Head_Office;
										hide Case_Number;
										hide Allow_Excess_Material_Issued;
										hide Reason_Why_Material_Issued_Exceeded_Formula;
										hide Head_Office;
										hide Seen;
										hide Reason_for_not_Seen;
										hide Time_Checked;
										hide Human_Resource;
										hide Hr_Time_Checked;
										hide Back_End;
										// ------------------------------
										// 3) DOCUMENT TYPE TOGGLE
										// ------------------------------
										if(input.Document_Type == "Physical Voucher")
										{
											show Voucher_Type;
											enable Voucher_Type;
											enable Voucher_Number;
										}
										else if(input.Document_Type == "Digital Voucher")
										{
											show Voucher_Type;
											enable Voucher_Type;
											disable Voucher_Number;
										}
										else
										{
											hide Voucher_Type;
											input.Voucher_Type = null;
											input.Voucher_Number = null;
										}
										// ------------------------------
										// 4) MODE + STATUS
										// ------------------------------
										is_create = input.ID == null;
										st = ifnull(input.Voucher_Status,"Issued");
										if(is_create && input.Voucher_Status == null)
										{
											input.Voucher_Status = "Issued";
											st = "Issued";
										}
										// =====================================================
										// ON CREATE
										// =====================================================
										if(is_create)
										{
											u = thisapp.audit.getLoginAuditInfo();
											input.User_Name = u.get("name");
											input.User_Email = u.get("email");
											input.User_Role = u.get("role");
											enable Issued_By;
											enable Document_Type;
											enable Voucher_Type;
											enable Voucher_Number;
											enable Employee;
										}
										// =====================================================
										// ON EDIT + ISSUED
										// =====================================================
										else if(!is_create && st == "Issued")
										{
											show Issued_By;
											show Site;
											show Voucher_Return;
											show Received_By;
											enable Received_By;
											show Voucher_Issue;
											show Document_Type;
											show Voucher_Type;
											show Voucher_Number;
											show Employee;
											show Date_Time_In;
											disable Issued_By;
											disable Site;
											disable Document_Type;
											disable Voucher_Number;
											disable Employee;
											disable Date_Time_In;
											disable Voucher_Type;
											if(voucherType == "Kitchen Voucher")
											{
												show Kitchen_Voucher_Details;
												disable Kitchen_Voucher_Details.Line_Number;
											}
											if(voucherType == "Item Issuing Form")
											{
												show Asset;
												show Voucher_Issuing_Details;
												hide Stock_Bundling_Note;
											}
											if(voucherType == "Occurency Report")
											{
												show Voucher_Header;
												show Management_Location;
												enable Management_Location;
												show Incident_Details;
												enable Incident_Details.Time;
												enable Incident_Details.Incident_Type;
												enable Incident_Details.Incident;
											}
