					}
				}

			}
			Finalize14 as "Finalize"
			{
				type =  form
				form = Invoice_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ==============================
										// UPDATE INVOICE DETAILS STATUS
										// ==============================
										if(input.Invoice != null)
										{
											if(input.Invoice_Details_Status == null || input.Invoice_Details_Status == "Draft")
											{
												input.Invoice_Details_Status = "Invoiced";
											}
										}
										if(input.Invoice != null)
										{
											inv = Invoice[ID == input.Invoice];
											if(inv.ID != null)
											{
												sub_total = 0.0;
												total_tax = 0.0;
												for each  d in Invoice_Details[Invoice == inv.ID]
												{
													line_sub_total = round(ifnull(d.Quantity,0.0) * ifnull(d.Rate,0.0),2);
													sub_total = sub_total + line_sub_total;
													total_tax = total_tax + ifnull(d.Tax_Amount,0.0);
												}
												for each  s in inv.Services
												{
													sub_total = sub_total + ifnull(s.Line_Total,0.0);
												}
												sub_total = round(sub_total,2);
												total_tax = round(total_tax,2);
												inv.Sub_Total=sub_total;
												inv.Tax_Amount=total_tax;
												if(inv.Discount_Amount == null)
												{
													inv.Discount_Amount=0.0;
												}
												if(inv.Discount_Percentage == null)
												{
													inv.Discount_Percentage=0.0;
												}
												if(inv.Amount_Paid == null)
												{
													inv.Amount_Paid=0.0;
												}
												discount_amt = 0.0;
												if(inv.Discount_Type == "Percentage")
												{
													discount_amt = sub_total * inv.Discount_Percentage / 100;
													discount_amt = round(discount_amt,2);
													inv.Discount_Amount=discount_amt;
												}
												else if(inv.Discount_Type == "Amount")
												{
													discount_amt = ifnull(inv.Discount_Amount,0.0);
													if(discount_amt > sub_total)
													{
														discount_amt = sub_total;
														inv.Discount_Amount=sub_total;
													}
												}
												else
												{
													discount_amt = 0.0;
													inv.Discount_Amount=0.0;
													inv.Discount_Percentage=0.0;
												}
												grand_total = sub_total - discount_amt + total_tax;
												if(grand_total < 0)
												{
													grand_total = 0.0;
												}
												inv.Grand_Total=round(grand_total,2);
												balance_due = grand_total - ifnull(inv.Amount_Paid,0.0);
												if(balance_due < 0)
												{
													balance_due = 0.0;
												}
												inv.Balance_Due=round(balance_due,2);
											}
										}
										// =====================================================
										// INSERT OR UPDATE TAX LINE IN BILL DETAILS
										// =====================================================
										tax_amount = ifnull(input.Tax_Amount,0.0);
										if(tax_amount > 0)
										{
											// Find the Bill linked to this Invoice
											related_bill = Bill[Invoice == input.Invoice];
											if(related_bill.ID != null)
											{
												bill_id = related_bill.ID;
												invoice_display = ifnull(input.Display_Name_Invoice,"").trim();
												line_number = ifnull(input.Line_Number,0);
												tax_reference = invoice_display + " - " + line_number;
												item_display = "";
												if(input.Item != null)
												{
													item_display = input.Item.toString();
												}
												// Check whether this Invoice Detail already created a Bill Detail tax row
												existing_tax = Bill_Details[Source_Form == "Invoice Details" && Source_Record_ID == input.ID];
												if(existing_tax.ID == null)
												{
													insert into Bill_Details
													[
														Bill=bill_id
														Line_Number=input.Line_Number
														Source="Invoice Details"
														Reference=tax_reference
														Display_Name_Item=item_display
														Details=ifnull(input.Details,"")
														Quantity=1
														Rate=tax_amount
														Account=ifnull(input.Account,"")
														Current_Site=ifnull(input.Site,"")
														Source_Form="Invoice Details"
														Source_Record_ID=input.ID
														Bill_Details_Status="Draft"
														Details_Date=zoho.currentdate
														Added_User=zoho.loginuser
													]
												}
												else
												{
													existing_tax.Bill=bill_id;
													existing_tax.Line_Number=input.Line_Number;
													existing_tax.Source="Invoice Details";
													existing_tax.Reference=tax_reference;
													existing_tax.Display_Name_Item=item_display;
													existing_tax.Details=ifnull(input.Details,"");
													existing_tax.Quantity=1;
													existing_tax.Rate=tax_amount;
													existing_tax.Account=ifnull(input.Account,"");
													existing_tax.Current_Site=ifnull(input.Site,"");
													existing_tax.Source_Form="Invoice Details";
													existing_tax.Source_Record_ID=input.ID;
													existing_tax.Bill_Details_Status="Draft";
													existing_tax.Details_Date=zoho.currentdate;
												}
											}
											else
											{
												info "No Bill record found for Invoice ID: " + input.Invoice;
											}
										}
										else
										{
											// Tax was removed or changed to zero.
											// Remove any previously generated Bill Detail tax row.
											old_tax_rows = Bill_Details[Source_Form == "Invoice Details" && Source_Record_ID == input.ID];
											for each  old_tax in old_tax_rows
											{
												delete from Bill_Details[ID == old_tax.ID];
											}
										}
										// =====================================================
										// UPDATE SALES VOUCHER BUSINESS DIVISION FROM INVOICE
										// =====================================================
										if(input.Sales_Voucher != null)
										{
											sales_voucher_id = input.Sales_Voucher.ID;
											sv = Sales_Voucher[ID == sales_voucher_id];
											if(sv.ID != null)
											{
												invoice_amount = round(ifnull(input.Line_Total,0.0),2);
												post = Map();
												post.put("MSM_Sales_Voucher",sv.ID);
												post.put("MSM_Invoice_Details",input.ID);
												post.put("Voucher_Number",input.Invoice);
												post.put("Transaction_Date",input.Details_Date);
												post.put("Invoice_Amount",invoice_amount);
												invoice_sync_resp = grapes_group.masakasite.updateSalesVoucherFromInvoiceDetail(post);
												info invoice_sync_resp;
											}
											else
											{
												info "Sales Voucher record was not found.";
											}
										}
										else
										{
											info "Invoice Details has no Sales Voucher lookup.";
										}
						)
					}
				}

			}
			Finalize_On_Delete10 as "Finalize On Delete"
			{
				type =  form
				form = Invoice_Details

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											inv = Invoice[ID == input.Invoice];
										if(inv.ID != null)
										{
											sub_total = 0.0;
											for each  d in Invoice_Details[Invoice == inv.ID]
											{
												sub_total = sub_total + ifnull(d.Line_Total,0.0);
											}
											inv.Sub_Total=sub_total;
											inv.Grand_Total=sub_total;
											inv.Balance_Due=sub_total - ifnull(inv.Amount_Paid,0.0);
											if(sub_total > 0)
											{
												inv.Invoice_Status="Invoiced";
											}
											else
											{
												inv.Invoice_Status="Draft";
											}
										}
						)
					}
				}

			}
			Finalize15 as "Finalize"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_Invoice == true)
										{
											input.Invoice_Status = "Cancelled";
										}
										else if(input.Send_Invoice == true)
										{
											input.Invoice_Status = "Invoiced";
											if(input.Date_Sent == null)
											{
												input.Date_Sent = zoho.currentdate;
											}
										}
										else
										{
											input.Invoice_Status = "Draft";
										}
										// ==============================
										// INVOICE FINALIZE TOTALS
										// ==============================
										sub_total = 0.0;
										// Invoice Details - use pre-tax amount
										for each  d in Invoice_Details[Invoice == input.ID]
										{
											line_sub_total = round(ifnull(d.Quantity,0.0) * ifnull(d.Rate,0.0),2);
											sub_total = sub_total + line_sub_total;
										}
										// Services
										for each  s in input.Services
										{
											if(input.Invoice_Number != null && input.Invoice_Number != "")
											{
												s.Display_Name_Voucher=input.Invoice_Number;
											}
											sub_total = sub_total + ifnull(s.Line_Total,0.0);
										}
										sub_total = round(sub_total,2);
										input.Sub_Total = sub_total;
										// ==============================
										// DISCOUNT
										// ==============================
										discount_amt = ifnull(input.Discount_Amount,0.0);
										if(input.Discount_Type == "Percentage")
										{
											discount_amt = sub_total * ifnull(input.Discount_Percentage,0.0) / 100;
											discount_amt = round(discount_amt,2);
											input.Discount_Amount = discount_amt;
										}
										else if(input.Discount_Type == "Amount")
										{
											if(discount_amt > sub_total)
											{
												discount_amt = sub_total;
												input.Discount_Amount = sub_total;
											}
										}
										else
										{
											discount_amt = 0.0;
											input.Discount_Amount = 0.0;
											input.Discount_Percentage = 0.0;
										}
										// ==============================
										// GRAND TOTAL
										// ==============================
										grand_total = sub_total - discount_amt + ifnull(input.Tax_Amount,0.0);
										if(grand_total < 0)
										{
											grand_total = 0.0;
										}
										input.Grand_Total = round(grand_total,2);
										// ==============================
										// BALANCE DUE
										// ==============================
										balance_due = grand_total - ifnull(input.Amount_Paid,0.0);
										if(balance_due < 0)
										{
											balance_due = 0.0;
										}
										input.Balance_Due = round(balance_due,2);
						)
					}
				}

			}
