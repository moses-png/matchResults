			On_Store_Item_Stock_Selec as "On Store Item Stock Selected"
			{
				type =  form
				form = Sales_Voucher_Details

				record event = on add or edit

				on user input of Store_Item_Stock
				{
					actions 
					{
						custom deluge script
						(
											if(input.Store_Item_Stock != null)
										{
											input.Store = input.Store_Item_Stock.Store;
											input.Display_Name_Store = input.Store.Asset_Name + " - " + input.Store.Asset_ID;
											input.Quantity_Available = input.Store_Item_Stock.Qty_On_Hand;
										}
										else
										{
											input.Store = null;
											input.Display_Name_Store = "";
											input.Quantity_Available = 0;
										}
						)
					}
