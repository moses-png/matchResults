			Set_Up_Form29 as "Set Up Form"
			{
				type =  form
				form = Product_Formula_Register

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// PRODUCT FORMULA REGISTER - SET UP FORM
										// =====================================================
										// =====================================================
										// 1. HIDE SECTIONS
										// =====================================================
										hide Back_End;
										// =====================================================
										// 2. USER SESSION DETAILS
										// =====================================================
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// =====================================================
										// 3. DISABLE BACK END FIELDS
										// =====================================================
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// =====================================================
										// 4. DISABLE CALCULATED TOTALS
										// =====================================================
										disable Total_Material_Cost;
										disable Total_Quantity;
										disable Effective_Date;
										// =====================================================
										// 5. DISABLE MATERIAL DETAILS CALCULATED FIELDS
										// =====================================================
										disable Material_Details.Unit_Cost;
										disable Material_Details.Line_Number;
										disable Material_Details.Total_Cost;
										// =====================================================
										// 6. HIDE MAIN FORM DISPLAY FIELDS
										// =====================================================
										hide Display_Name_Item;
										// =====================================================
										// 7. HIDE MATERIAL DETAILS BACK-END / AUTO FIELDS
										// =====================================================
										hide Material_Details.Display_Name_Item;
										hide Material_Details.Display_Name_Product;
										hide Material_Details.Display_Name_Material;
										hide Material_Details.Display_Name_Unit_Of_Measure;
										hide Material_Details.Quantity_in_Base_Unit_Of_Measure;
										hide Material_Details.Quantity_Including_Wastage;
										// =====================================================
										// 8. HIDE OPTIONAL MATERIAL DETAILS FIELDS
										// =====================================================
										hide Material_Details.Wastage_Percentage;
						)
					}
				}

			}
			On_Addition_Of_Row5 as "On Addition Of Row"
			{
				type =  form
				form = Product_Formula_Register

				record event = on add or edit

				on add row of Material_Details
				{
					actions 
					{
						custom deluge script
						(
											// Populate the new row from the parent record
										row.Display_Name_Product=input.Display_Name_Item;
										row.Display_Name_Item=input.Display_Name_Item;
										// Default values
										row.Quantity_Required=0;
										row.Unit_Cost=0;
										row.Total_Cost=0;
										row.Wastage_Percentage=0;
										row.Quantity_Including_Wastage=0;
										// Generate the next line number
										lineNo = 1;
										for each  r in input.Material_Details
										{
											if(ifnull(r.Line_Number,0) >= lineNo)
											{
												lineNo = r.Line_Number + 1;
											}
										}
										row.Line_Number=lineNo;
						)
					}
				}

			}
			On_Material_Selected as "On Material Selected"
			{
				type =  form
				form = Product_Formula_Register

				record event = on add or edit

				on user input of Material_Details.Material
				{
					actions 
					{
						custom deluge script
						(
											for each  mat in input.Material_Details
										{
											if(mat.Material != null)
											{
												name = ifnull(mat.Material.Item_Name,"").trim();
												sku = ifnull(mat.Material.SKU,"").trim();
												mat.Display_Name_Material=if(sku != "",name + " - " + sku,name);
												if(mat.Unit_Of_Measure == null)
												{
													mat.Unit_Of_Measure=mat.Material.Base_Unit_Of_Measure;
												}
												mat.Unit_Cost=ifnull(mat.Material.Default_Cost,0.0);
											}
											else
											{
												mat.Display_Name_Material="";
												mat.Unit_Of_Measure=null;
												mat.Display_Name_Unit_Of_Measure="";
												mat.Unit_Cost=null;
												mat.Quantity_Required=null;
												mat.Quantity_in_Base_Unit_Of_Measure=null;
												mat.Wastage_Percentage=null;
												mat.Quantity_Including_Wastage=null;
												mat.Total_Cost=null;
												continue;
											}
											if(mat.Material != null && mat.Unit_Of_Measure != null)
											{
												check = store_management.po.check_uom_conversion_from_concrete(mat.Material,mat.Unit_Of_Measure);
												if(check.get("ok") != true)
												{
													alert check.get("message");
													mat.Unit_Of_Measure=null;
													mat.Display_Name_Unit_Of_Measure="";
													mat.Quantity_in_Base_Unit_Of_Measure=null;
													mat.Quantity_Including_Wastage=null;
													mat.Total_Cost=null;
												}
												else
												{
													resp = store_management.po.recalculate_po_detail_line_from_concrete(mat.Material,mat.Unit_Of_Measure,mat.Quantity_Required,mat.Unit_Cost);
													qty = ifnull(mat.Quantity_Required,0.0);
													wastage = ifnull(mat.Wastage_Percentage,0.0);
													mat.Display_Name_Unit_Of_Measure=resp.get("display_uom_name");
													mat.Quantity_in_Base_Unit_Of_Measure=resp.get("qty_in_base");
													mat.Quantity_Including_Wastage=qty + qty * wastage / 100;
													mat.Total_Cost=ifnull(mat.Quantity_in_Base_Unit_Of_Measure,0.0) * ifnull(mat.Unit_Cost,0.0);
												}
											}
										}
						)
					}
				}

			}
			On_Unit_Of_Measure_Select7 as "On Unit Of Measure Selected"
			{
				type =  form
				form = Product_Formula_Register

				record event = on add or edit

				on user input of Material_Details.Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											// PRODUCT FORMULA REGISTER – Material Details: On Unit Of Measure Selected
										for each  mat in input.Material_Details
										{
											if(mat.Unit_Of_Measure == null || mat.Material == null)
											{
												mat.Display_Name_Unit_Of_Measure="";
												mat.Quantity_in_Base_Unit_Of_Measure=null;
												mat.Unit_Cost=null;
												mat.Quantity_Including_Wastage=null;
												mat.Total_Cost=null;
												continue;
											}
											check = store_management.po.check_uom_conversion_from_concrete(mat.Material,mat.Unit_Of_Measure);
											if(check.get("ok") != true)
											{
												alert check.get("message");
												mat.Unit_Of_Measure=null;
												mat.Display_Name_Unit_Of_Measure="";
												mat.Quantity_in_Base_Unit_Of_Measure=null;
												mat.Unit_Cost=null;
												mat.Quantity_Including_Wastage=null;
												mat.Total_Cost=null;
												continue;
											}
											resp = store_management.po.recalculate_po_detail_line_from_concrete(mat.Material,mat.Unit_Of_Measure,mat.Quantity_Required,mat.Material.Default_Cost);
											// Populate conversion results
											mat.Display_Name_Unit_Of_Measure=resp.get("display_uom_name");
											mat.Quantity_in_Base_Unit_Of_Measure=ifnull(resp.get("qty_in_base"),0.0);
											// Base Unit Cost
											mat.Unit_Cost=ifnull(mat.Material.Default_Cost,0.0);
											// Quantity including wastage (in base units)
											wastage = ifnull(mat.Wastage_Percentage,0.0);
											mat.Quantity_Including_Wastage=mat.Quantity_in_Base_Unit_Of_Measure + mat.Quantity_in_Base_Unit_Of_Measure * wastage / 100;
											// Total Cost
											mat.Total_Cost=mat.Quantity_Including_Wastage * mat.Unit_Cost;
										}
										// Recalculate parent totals
										total_qty = 0.0;
										total_material_cost = 0.0;
										for each  mat_total in input.Material_Details
										{
											total_qty = total_qty + ifnull(mat_total.Quantity_in_Base_Unit_Of_Measure,0.0);
											total_material_cost = total_material_cost + ifnull(mat_total.Total_Cost,0.0);
										}
										input.Total_Quantity = total_qty;
										input.Total_Material_Cost = total_material_cost;
						)
					}
				}

			}
			On_Quantity_Required_Sele as "On Quantity Required Selected"
			{
				type =  form
				form = Product_Formula_Register

				record event = on add or edit

				on user input of Material_Details.Quantity_Required
				{
					actions 
					{
						custom deluge script
						(
											for each  mat in input.Material_Details
										{
											if(mat.Material == null || mat.Unit_Of_Measure == null)
											{
												mat.Quantity_in_Base_Unit_Of_Measure=null;
												mat.Quantity_Including_Wastage=null;
												mat.Total_Cost=null;
												continue;
											}
											resp = store_management.po.recalculate_po_detail_line_from_concrete(mat.Material,mat.Unit_Of_Measure,mat.Quantity_Required,mat.Unit_Cost);
											qty = ifnull(mat.Quantity_Required,0.0);
											wastage = ifnull(mat.Wastage_Percentage,0.0);
											mat.Quantity_in_Base_Unit_Of_Measure=resp.get("qty_in_base");
											mat.Quantity_Including_Wastage=qty + qty * wastage / 100;
											mat.Total_Cost=ifnull(mat.Quantity_in_Base_Unit_Of_Measure,0.0) * ifnull(mat.Unit_Cost,0.0);
										}
										// Recalculate Material Totals
										total_qty = 0.0;
										total_material_cost = 0.0;
										for each  mat_total in input.Material_Details
										{
											total_qty = total_qty + ifnull(mat_total.Quantity_in_Base_Unit_Of_Measure,0.0);
											total_material_cost = total_material_cost + ifnull(mat_total.Total_Cost,0.0);
										}
										input.Total_Quantity = total_qty;
										input.Total_Material_Cost = total_material_cost;
						)
					}
				}

			}
			On_Deletion_Of_Row3 as "On Deletion Of Row"
			{
				type =  form
				form = Product_Formula_Register

				record event = on add or edit

				on delete row of Material_Details
				{
					actions 
					{
						custom deluge script
						(
											// PRODUCT FORMULA REGISTER – Material Details: On Delete Row
										total_qty = 0.0;
										total_material_cost = 0.0;
										for each  mat in input.Material_Details
										{
											total_qty = total_qty + ifnull(mat.Quantity_in_Base_Unit_Of_Measure,0.0);
											total_material_cost = total_material_cost + ifnull(mat.Total_Cost,0.0);
										}
										input.Total_Quantity = total_qty;
										input.Total_Material_Cost = total_material_cost;
						)
					}
				}

			}
			Finalize_On_Delete9 as "Finalize On Delete"
			{
				type =  form
				form = Product_Formula_Register

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											parent_id = input.ID;
										parent_name = ifnull(input.Display_Name_Item,"").trim();
										if(parent_id != null)
										{
											delete from Product_Formula_Details[Product == parent_id];
										}
										if(parent_name != "")
										{
											delete from Product_Formula_Details[Display_Name_Product == parent_name || Display_Name_Item == parent_name];
										}
						)
					}
				}

			}
			Full_Validation13 as "Full Validation"
			{
				type =  form
				form = Payment_Receipt_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// PAYMENT RECEIPT DETAILS VALIDATION
										// =====================================
										if(input.Payment_Type == null || input.Payment_Type == "")
										{
											alert "Please select Payment Type.";
											cancel submit;
										}
										if(input.Payment_Document == null || input.Payment_Document == "")
										{
											alert "Please select Payment Document.";
											cancel submit;
										}
										// =====================================
										// PAYMENT TYPE VALIDATION
										// =====================================
										if(input.Payment_Type == "Cash")
										{
											if(input.Payment_Receipt_Voucher == null)
											{
												alert "Please select Payment Receipt Voucher.";
												cancel submit;
											}
											if(input.Payment_Document != "Cash Deposit")
											{
												if(input.Amount_Allocated == null || input.Amount_Allocated <= 0)
												{
													alert "Amount Allocated is required and must be greater than zero.";
													cancel submit;
												}
											}
										}
										else if(input.Payment_Type == "Credit")
										{
											if(input.Credit_Note_Voucher == null)
											{
												alert "Please select Credit Note Voucher.";
												cancel submit;
											}
											if(input.Amount_Credited == null || input.Amount_Credited <= 0)
											{
												alert "Amount Credited is required and must be greater than zero.";
												cancel submit;
											}
										}
										else if(input.Payment_Type == "Cash Deposit")
										{
											if(input.Customer_Deposit_Voucher == null)
											{
												alert "Please select Customer Deposit Voucher.";
												cancel submit;
											}
											if(input.Amount_Allocated == null || input.Amount_Allocated <= 0)
											{
												alert "Amount Allocated is required and must be greater than zero.";
												cancel submit;
											}
											if(input.Amount_Allocated > ifnull(input.Amount_Not_Allocated,0.0))
											{
												alert "Amount Allocated cannot exceed Amount Not Allocated.";
												cancel submit;
											}
										}
										// =====================================
										// PAYMENT DOCUMENT VALIDATION
										// =====================================
										if(input.Payment_Document == "Sales Voucher")
										{
											if(input.Sales_Voucher == null)
											{
												alert "Please select Sales Voucher.";
												cancel submit;
											}
										}
										else if(input.Payment_Document == "Invoice")
										{
											if(input.Invoice == null)
											{
												alert "Please select Invoice.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Full_Validation14 as "Full Validation"
			{
				type =  form
				form = Voucher_Register

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// VOUCHER REGISTER VALIDATION + STATUS MOVEMENT
										// =====================================================
										errors = "";
										is_create = input.ID == null;
										now_ts = zoho.currenttime;
										ADMIN_EMAIL = "xenotime15@gmail.com";
										is_admin = zoho.loginuser == ADMIN_EMAIL;
										// =====================================================
										// 1. GET VOUCHER TYPE
										// =====================================================
										voucherType = "";
										if(input.Voucher_Type != null)
										{
											voucherType = ifnull(input.Voucher_Type.Voucher_Type,"").trim();
										}
										input.Display_Name_Voucher_Type = voucherType;
										// =====================================================
										// 2. LOAD OLD RECORD DETAILS
										// =====================================================
										oldRec = null;
										original_status = "Issued";
										old_stock_bundle_count = 0;
										new_stock_bundle_count = 0;
										stock_bundle_row_add_only = false;
										if(!is_create)
										{
											oldRec = Voucher_Register[ID == input.ID];
											if(oldRec.ID != null)
											{
												original_status = ifnull(oldRec.Voucher_Status,"Issued");
											}
											if(voucherType == "Stock Bundling Note")
											{
												old_stock_bundle_count = Stock_Bundling_Note[Voucher == input.ID].count();
												new_stock_bundle_count = input.Stock_Bundling_Note.count();
												if(new_stock_bundle_count > old_stock_bundle_count && original_status == input.Voucher_Status)
												{
													stock_bundle_row_add_only = true;
												}
											}
										}
										if(original_status == "Issued" && input.Voucher_Status == "Returned" && stock_bundle_row_add_only == false)
										{
											bad_rows = Stock_Bundling_Note[Voucher == input.ID && Stock_Status == "Pending" || Stock_Status == "Partially Received"];
											if(bad_rows.count() > 0)
											{
												if(input.Not_Created != true)
												{
													errors = errors + "\n• Some bundled items are still Pending or Partially Received. Tick Not Created to continue.";
												}
												else
												{
													reason_txt2 = ifnull(input.Reason_Why_Not_Created,"").trim();
													if(reason_txt2 == "")
													{
														errors = errors + "\n• Reason Why Not Created is required.";
													}
													else if(reason_txt2.length() < 30)
													{
														errors = errors + "\n• Reason Why Not Created must be at least 30 characters.";
													}
												}
											}
										}
										// =====================================================
										// 3. BASIC VALIDATIONS
										// =====================================================
										if(!is_admin)
										{
											if(input.Site == null)
											{
												errors = errors + "\n• Site is required.";
											}
											if(input.Document_Type == null || input.Document_Type.trim() == "")
											{
												errors = errors + "\n• Document Type is required.";
											}
											if(input.Voucher_Type == null)
											{
												errors = errors + "\n• Voucher Type is required.";
											}
											if(input.Employee == null)
											{
												errors = errors + "\n• Employee is required.";
											}
											if(is_create && voucherType != "Supervisor Voucher")
											{
												if(input.Issued_By == null)
												{
													errors = errors + "\n• Issued By is required.";
												}
											}
										}
										// =====================================================
										// 4. PHYSICAL VOUCHER PREFIX VALIDATION
										// =====================================================
										if(input.Document_Type == "Physical Voucher" && input.Voucher_Type != null)
										{
											expectedPrefix = ifnull(input.Voucher_Type.Prefix,"").trim().toUpperCase();
											voucherTypeName = ifnull(input.Voucher_Type.Voucher_Type,"");
											voucherNo = ifnull(input.Voucher_Number,"").trim().toUpperCase();
											if(expectedPrefix != "" && !voucherNo.startsWith(expectedPrefix))
											{
												errors = errors + "\n• Voucher Number for '" + voucherTypeName + "' must start with '" + expectedPrefix + "'.";
											}
										}
										// =====================================================
										// 5. DATE VALIDATION
										// =====================================================
										if(!is_create && input.Date_Time_Out != null)
										{
											if(input.Date_Time_In != null && input.Date_Time_In > input.Date_Time_Out)
											{
												errors = errors + "\n• Date-Time In cannot be greater than Date-Time Out.";
											}
											if(input.Date_Time_Out > now_ts)
											{
												errors = errors + "\n• Date-Time Out cannot be in the future.";
											}
										}
										// =====================================================
										// 6. STATUS-BASED VALIDATIONS
										// =====================================================
										st = ifnull(input.Voucher_Status,"Issued");
										if(!is_create && st == "Issued" && voucherType != "Supervisor Voucher")
										{
											if(input.Received_By == null)
											{
												errors = errors + "\n• Received By is required.";
											}
										}
										if(!is_create && voucherType == "Supervisor Voucher" && st == "Closed")
										{
											if(input.Employee_Taking_To_Head_Office == null)
											{
												errors = errors + "\n• Employee Taking To Head Office is required.";
											}
											if(input.How_to_Take_to_Head_Office == null || input.How_to_Take_to_Head_Office.trim() == "")
											{
												errors = errors + "\n• How To Take To Head Office is required.";
											}
											case_no = ifnull(input.Case_Number,"").trim();
											if(case_no == "")
											{
												errors = errors + "\n• Case Number is required.";
											}
											else
											{
												new_transport_date = zoho.currentdate;
												if(input.Time_Sent_to_Head_Office != null)
												{
													new_transport_date = input.Time_Sent_to_Head_Office.toDate();
												}
												case_data = Map();
												case_data.put("case_no",case_no);
												case_data.put("transport_date",new_transport_date);
												case_check = employee_management.checkVoucherTransferCase(case_data);
												if(case_check != null && case_check.get("ok") == false)
												{
													errors = errors + "\n• " + case_check.get("message");
												}
											}
										}
										if(!is_create && st == "Issued" && voucherType == "Daily Cleaners Report")
										{
											if(input.Management_Location == null)
											{
												errors = errors + "\n• Management Location is required.";
											}
										}
										if(!is_create && st == "Issued" && voucherType == "Occurency Report")
										{
											if(input.Management_Location == null)
											{
												errors = errors + "\n• Management Location is required.";
											}
											if(input.Incident_Details == null || input.Incident_Details.count() < 2)
											{
												errors = errors + "\n• Add at least TWO Incident Details records.";
											}
										}
										if(st == "Head Office")
										{
											if(input.Seen == null)
											{
												errors = errors + "\n• Seen is required.";
											}
											else if(input.Seen == false && input.Reason_for_not_Seen == null || input.Reason_for_not_Seen.trim() == "")
											{
												errors = errors + "\n• Reason for not Seen is required.";
											}
											else if(input.Seen == true && input.Reason_for_not_Seen != null && input.Reason_for_not_Seen.trim() != "")
											{
												errors = errors + "\n• Reason for not Seen must be empty.";
											}
										}
										// =====================================================
										// 7. CANCELLATION VALIDATION
										// =====================================================
										if(input.Cancel_Voucher == true)
										{
											if(input.Cancellation_Reason == null || input.Cancellation_Reason.trim() == "")
											{
												errors = errors + "\n• Cancellation Reason is required.";
											}
										}
										else
										{
											input.Cancellation_Reason = "";
										}
										// =====================================================
										// 8. STOCK BUNDLING NOTE VALIDATIONS
										// =====================================================
										if(!is_create && voucherType == "Stock Bundling Note")
										{
											if(oldRec.ID != null && oldRec.Voucher_Status == "Returned" && input.Voucher_Status != "Returned")
											{
												for each  bundle in input.Stock_Bundling_Note
												{
													if(bundle.Item == null)
													{
														errors = errors + "\n• Stock Bundling Note has a row without Item.";
														continue;
													}
													qty_created = ifnull(bundle.Quantity_Created,0.0);
													if(qty_created <= 0)
													{
														errors = errors + "\n• Quantity Created is required for " + ifnull(bundle.Display_Name_Item,"") + ".";
														continue;
													}
													formula = Product_Formula_Register[Item == bundle.Item && Status == "Active"];
													if(formula.ID == null)
													{
														errors = errors + "\n• No active Product Formula found for " + ifnull(bundle.Display_Name_Item,"") + ".";
														continue;
													}
													for each  fm in Product_Formula_Details[Product == formula.ID]
													{
														required_qty = ifnull(fm.Quantity_in_Base_Unit_Of_Measure,0.0) * qty_created;
														issued_qty = 0.0;
														for each  issue in Item_Issuing_Details[Issuing_Voucher == input.ID]
														{
															if(issue.Item != null && issue.Item == fm.Material)
															{
																issued_qty = issued_qty + ifnull(issue.Quantity_in_Base_Unit_Of_Measure,0.0);
															}
														}
														if(issued_qty > required_qty)
														{
															if(input.Allow_Excess_Material_Issued != true)
															{
																errors = errors + "\n• Too much material issued for " + ifnull(fm.Display_Name_Material,"") + ". Required by formula: " + required_qty + ", Issued: " + issued_qty + ". Tick Allow Excess Material Issued Against Product Formula to continue.";
															}
															else
															{
																reason_txt = ifnull(input.Reason_Why_Material_Issued_Exceeded_Formula,"").trim();
																if(reason_txt == "")
																{
																	errors = errors + "\n• Reason Why Excess Material Was Issued Against Product Formula is required.";
																}
																else if(reason_txt.length() < 30)
																{
																	errors = errors + "\n• Reason Why Excess Material Was Issued Against Product Formula must be at least 30 characters.";
																}
															}
														}
													}
												}
											}
										}
										// =====================================================
										// 9. STATUS MOVEMENT BEFORE SAVE
										// =====================================================
										if(errors == "")
										{
											if(is_create)
											{
												input.Voucher_Status = "Issued";
												if(input.Date_Time_In == null)
												{
													input.Date_Time_In = now_ts;
												}
											}
											else if(stock_bundle_row_add_only == false)
											{
												if(original_status != "Cancelled")
												{
													if(original_status == "Issued")
													{
														if(input.Date_Time_Out == null)
														{
															input.Date_Time_Out = now_ts;
														}
														if(input.Date_Time_In != null && input.Date_Time_Out != null)
														{
															ms = input.Date_Time_Out.toLong() - input.Date_Time_In.toLong();
															if(ms >= 0)
															{
																input.Hours_Worked = (ms / (1000.0 * 60.0 * 60.0)).round(2);
															}
															else
															{
																input.Hours_Worked = null;
															}
														}
														if(voucherType == "Supervisor Voucher")
														{
															input.Voucher_Status = "Closed";
														}
														else
														{
															input.Voucher_Status = "Returned";
														}
													}
													else if(original_status == "Closed")
													{
														if(input.Cancel_Voucher == true)
														{
															input.Voucher_Status = "Cancelled";
														}
														else if(voucherType == "Supervisor Voucher")
														{
															if(input.Manager_Time == null)
															{
																input.Manager_Time = now_ts;
															}
															if(input.Time_Sent_to_Head_Office == null)
															{
																input.Time_Sent_to_Head_Office = now_ts;
															}
															input.Voucher_Status = "Head Office";
														}
													}
													else if(original_status == "Returned")
													{
														if(input.Cancel_Voucher == true)
														{
															input.Voucher_Status = "Cancelled";
														}
														else
														{
															if(input.Manager_Time == null)
															{
																input.Manager_Time = now_ts;
															}
															input.Voucher_Status = "Head Office";
														}
													}
													else if(original_status == "Head Office")
													{
														if(input.Time_Checked == null)
														{
															input.Time_Checked = now_ts;
														}
														if(input.Seen == true)
														{
															input.Reason_for_not_Seen = "";
															input.Voucher_Status = "Human Resource";
														}
														else
														{
															if(input.Reason_for_not_Seen != null && input.Reason_for_not_Seen.trim() != "")
															{
																input.Voucher_Status = "Human Resource";
															}
															else
															{
																input.Voucher_Status = "Head Office";
															}
														}
													}
													else if(original_status == "Human Resource")
													{
														if(input.Hr_Time_Checked == null)
														{
															input.Hr_Time_Checked = now_ts;
														}
														input.Voucher_Status = "Audited";
													}
												}
											}
										}
										// =====================================================
										// 10. FINAL GATE
										// =====================================================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
