			On_Previous_Reading_Selec as "On Previous Reading Selected"
			{
				type =  form
				form = Meter_Reading

				record event = on add or edit

				on user input of Previous_Reading
				{
					actions 
					{
						custom deluge script
						(
											// ======================================
										// METER READING -> ON PREVIOUS READING SELECTED
										// ======================================
										if(input.Current_Reading != null)
										{
											if(input.Previous_Reading == null)
											{
												input.Previous_Reading = 0;
											}
											if(input.Current_Reading < input.Previous_Reading)
											{
												alert "Current Reading cannot be less than Previous Reading.";
												input.Consumption = null;
											}
											else
											{
												baseConsumption = input.Current_Reading - input.Previous_Reading;
												finalConsumption = baseConsumption;
												if(input.Unit_Of_Measure != null && input.Unit_Of_Measure.contains("CT Ratio"))
												{
													parts = input.Unit_Of_Measure.toList(" ");
													if(parts.size() >= 3)
													{
														ctRatioText = parts.get(2);
														if(ctRatioText != null && ctRatioText != "")
														{
															finalConsumption = baseConsumption * ctRatioText.toDecimal();
														}
													}
												}
												input.Consumption = finalConsumption;
											}
										}
										else
										{
											input.Consumption = null;
										}
						)
					}
				}

			}
