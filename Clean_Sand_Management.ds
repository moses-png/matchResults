			On_Unit_Of_Measure_Select as "On Unit Of Measure Selected"
			{
				type =  form
				form = Sales_Voucher_Details

				record event = on add or edit

				on user input of Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											if(input.Unit_Of_Measure != null)
										{
											input.Display_Name_Unit_Of_Measure = input.Unit_Of_Measure.Display_Name_Alternate_Unit_Of_Measure;
											if(input.Item != null && input.Quantity != null)
											{
												base_qty = store_management.uom.convert_to_base_qty(input.Item,input.Unit_Of_Measure.Alternate_Unit_Of_Measure,input.Quantity);
												if(base_qty != null)
												{
													input.Quantity_in_Base_Unit_Of_Measure = base_qty;
												}
												else
												{
													input.Quantity_in_Base_Unit_Of_Measure = input.Quantity;
												}
											}
											else
											{
												input.Quantity_in_Base_Unit_Of_Measure = 0;
											}
											price = Product_Price_Register[Item == input.Item && Unit_Of_Measure == input.Unit_Of_Measure && Status == "Active"];
											if(price.ID != null)
											{
												input.Unit_Price = price.Unit_Price;
											}
											else
											{
												input.Unit_Price = 0;
											}
											input.Line_Total = ifnull(input.Quantity,0) * ifnull(input.Unit_Price,0);
										}
										else
										{
											input.Display_Name_Unit_Of_Measure = "";
											input.Quantity_in_Base_Unit_Of_Measure = 0;
											input.Unit_Price = 0;
											input.Line_Total = 0;
										}
						)
					}
				}

			}
			On_Unit_Of_Measure_Select3 as "On Unit Of Measure Selected"
			{
				type =  form
				form = Product_Price_Register

				record event = on add or edit

				on user input of Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											if(input.Unit_Of_Measure != null)
										{
											input.Display_Name_Unit_Of_Measure = input.Unit_Of_Measure.Display_Name_Alternate_Unit_Of_Measure;
										}
										else
										{
											input.Display_Name_Unit_Of_Measure = "";
										}
						)
					}
				}

			}
			Set_Up_Form17 as "Set Up Form"
			{
				type =  form
				form = Sales_Voucher_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//DISABLE FIELDS
										//Sales Voucher Details
										disable Display_Name_Sales_Voucher;
										disable Line_Number;
										//Item Details
										disable Display_Name_Item;
										disable Quantity_Available;
										disable Display_Name_Unit_Of_Measure;
										disable Quantity_in_Base_Unit_Of_Measure;
										disable Base_Unit_Of_Measure;
										disable Display_Name_Base_Unit_Of_Measure;
										//Store Details
										disable Store;
										disable Display_Name_Store;
										//Pricing Details
										disable Line_Total;
										//Tax Details
										disable Tax_Amount;
						)
					}
				}

			}
			Delete_Row_Product_Detail as "Delete Row Product Details"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on delete row of Product_Details
				{
					actions 
					{
						custom deluge script
						(
											line_no = 1;
										sub_total = 0;
										tax_total = 0;
										for each  r in input.Product_Details
										{
											r.Line_Number=line_no;
											line_no = line_no + 1;
											sub_total = sub_total + ifnull(r.Line_Total,0);
											tax_total = tax_total + ifnull(r.Tax_Amount,0);
										}
										input.Sub_Total = sub_total;
										input.Tax_Amount = tax_total;
										input.Grand_Total = input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0);
										input.Balance_Due = input.Grand_Total - ifnull(input.Amount_Paid,0) - ifnull(input.Amount_Credited,0);
						)
					}
				}

			}
			On_Unit_Of_Measure_Select5 as "On Unit Of Measure Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Product_Details.Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											if(row.Unit_Of_Measure != null)
										{
											row.Display_Name_Unit_Of_Measure=row.Unit_Of_Measure.Display_Name_Alternate_Unit_Of_Measure;
											conversion_factor = ifnull(row.Unit_Of_Measure.Conversion_Factor,1);
											// Quantity Available in selected UOM
											if(row.Store_Item_Stock != null)
											{
												row.Quantity_Available=ifnull(row.Store_Item_Stock.Qty_On_Hand,0) / conversion_factor;
											}
											else if(row.Item != null)
											{
												row.Quantity_Available=ifnull(row.Item.Stock_On_Hand,0) / conversion_factor;
											}
											else
											{
												row.Quantity_Available=0;
											}
											// Quantity in Base UOM
											if(row.Quantity != null)
											{
												row.Quantity_in_Base_Unit_Of_Measure=row.Quantity * conversion_factor;
											}
											else
											{
												row.Quantity_in_Base_Unit_Of_Measure=0;
											}
											price = Product_Price_Register[Item == row.Item && Unit_Of_Measure == row.Unit_Of_Measure && Status == "Active"];
											if(price.ID != null)
											{
												row.Unit_Price=price.Unit_Price;
											}
											else
											{
												row.Unit_Price=0;
											}
											row.Line_Total=ifnull(row.Quantity,0) * ifnull(row.Unit_Price,0);
										}
										else
										{
											row.Display_Name_Unit_Of_Measure="";
											row.Quantity_Available=0;
											row.Quantity_in_Base_Unit_Of_Measure=0;
											row.Unit_Price=0;
											row.Line_Total=0;
										}
						)
					}
				}

			}
