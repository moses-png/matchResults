			Full_Validation32 as "Full Validation"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// TRUCK MOVEMENT VOUCHER
										// FULL VALIDATION - CREATE OR EDIT
										// =====================================================
										errors = "";
										// =======================
										// 1. JOB REQUIRED
										// =======================
										if(input.Job == null)
										{
											errors = errors + "\n• Job is required.";
										}
										else
										{
											jobNo = input.Job.Job_No;
											if(jobNo == "TJS01")
											{
												if(input.Card == null)
												{
													errors = errors + "\n• Card is required for Card Sales.";
												}
											}
											else if(jobNo == "TJS02")
											{
												if(input.Work_Order_Task == null)
												{
													errors = errors + "\n• Work Order Task is required for Service Task.";
												}
												if(input.Task_Location == null || input.Task_Location.trim() == "")
												{
													errors = errors + "\n• Task Location is required for Service Task.";
												}
												if(input.Small_Notes == null || input.Small_Notes.trim() == "")
												{
													errors = errors + "\n• Small Notes is required for Service Task.";
												}
											}
											else if(jobNo == "TJS03")
											{
												if(input.Batch_Number_From == null)
												{
													errors = errors + "\n• Stock Production is required for Stock Production.";
												}
											}
											else if(jobNo == "TJS04")
											{
												if(input.Truck_Movement_Voucher == null)
												{
													errors = errors + "\n• Truck Movement Voucher is required for Return Truck To Site.";
												}
												if(input.Small_Notes == null || input.Small_Notes.trim() == "")
												{
													errors = errors + "\n• Small Notes is required for Return Truck To Site.";
												}
											}
										}
										// =======================
										// 2. PICKUP REQUIRED
										// =======================
										if(input.Job != null && input.Job.Job_No == "TJS02" && input.Task_Location == "Suppliers")
										{
											if(input.Party_From == null)
											{
												errors = errors + "\n• Party From is required.";
											}
											if(input.Party_Location_From == null)
											{
												errors = errors + "\n• Party Location From is required.";
											}
										}
										else
										{
											if(input.Site_From == null)
											{
												errors = errors + "\n• Site From is required.";
											}
											if(input.Site_Location_From == null)
											{
												errors = errors + "\n• Site Location From is required.";
											}
										}
										if(input.Odometer_Start == null)
										{
											errors = errors + "\n• Odometer Start is required.";
										}
										if(isNull(input.Pick_Up_Image))
										{
											errors = errors + "\n• Pick Up Image is required.";
										}
										// =======================
										// 3. CANCEL VALIDATION
										// =======================
										if(input.Cancel_Voucher == true)
										{
											if(input.Reason_Why_Cancelled == null || input.Reason_Why_Cancelled.trim() == "")
											{
												errors = errors + "\n• Reason Why Cancelled is required.";
											}
										}
										// =====================================================
										// 4. DELIVERY VALIDATION
										// RUN ONLY WHEN STATUS IS DELIVERED
										// =====================================================
										if(input.Truck_Movement_Voucher_Status == "Delivered" && input.Cancel_Voucher != true)
										{
											if(input.Job != null && input.Job.Job_No == "TJS04")
											{
												if(input.Site_To == null)
												{
													errors = errors + "\n• Site To is required for Return Truck To Site.";
												}
												if(input.Site_Location_To == null)
												{
													errors = errors + "\n• Site Location To is required for Return Truck To Site.";
												}
											}
											else
											{
												if(input.Party_To == null && input.Site_To == null)
												{
													errors = errors + "\n• Delivery destination is required.";
												}
												if(input.Site_To != null && input.Site_Location_To == null)
												{
													errors = errors + "\n• Site Location To is required.";
												}
												if(input.Party_To != null && input.Party_Location_To == null)
												{
													errors = errors + "\n• Party Location To is required.";
												}
											}
											if(input.Odometer_End == null)
											{
												errors = errors + "\n• Odometer End is required.";
											}
											if(isNull(input.Delivery_To_Image))
											{
												errors = errors + "\n• Delivery To Image is required.";
											}
											if(input.Odometer_Start != null && input.Odometer_End != null)
											{
												if(input.Odometer_End < input.Odometer_Start)
												{
													errors = errors + "\n• Odometer End cannot be less than Odometer Start.";
												}
											}
											if(input.Time_Start != null && input.Time_End != null)
											{
												if(input.Time_End < input.Time_Start)
												{
													errors = errors + "\n• Time End cannot be before Time Start.";
												}
											}
										}
										// =======================
										// 5. STOP SUBMISSION
										// =======================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			On_Machine_Start_Of_Day_S as "On Machine Start Of Day Selected"
			{
				type =  form
				form = Truck_Movement_Voucher

				record event = on add or edit

				on user input of Machine_Start_Of_Day
				{
					actions 
