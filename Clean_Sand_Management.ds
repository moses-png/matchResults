			On_Customer_Selected4 as "On Customer Selected"
			{
				type =  form
				form = Customer_Purchase_Order

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											if(input.Customer == null)
										{
											// Clear parent display name
											input.Display_Name_Customer = null;
											// Clear subform display names
											for each  row in input.Sand_Purchase_Order_Details
											{
												row.Display_Name_Customer=null;
											}
											return;
										}
										// Auto-fill display name from the selected customer record (parent)
										input.Display_Name_Customer = input.Customer.Display_Name_Customer;
										// Push customer display name into subform rows
										for each  row in input.Sand_Purchase_Order_Details
										{
											row.Display_Name_Customer=input.Display_Name_Customer;
										}
						)
					}
				}

			}
			Sand_Purchase_Order_Detai1 as "Sand Purchase Order Details.On Item Selected"
			{
				type =  form
				form = Customer_Purchase_Order

				record event = on add or edit

				on user input of Sand_Purchase_Order_Details.Item
				{
					actions 
					{
						custom deluge script
						(
											for each  poRow in input.Sand_Purchase_Order_Details
										{
											if(poRow.Item != null)
											{
												poRow.Display_Name_Item=poRow.Item.Item_Name + " - " + poRow.Item.SKU;
											}
											else
											{
												poRow.Display_Name_Item="";
											}
										}
						)
					}
				}

			}
			Sand_Purchase_On_Quantity as "Sand Purchase On Quantity Ordered Selected"
			{
				type =  form
				form = Customer_Purchase_Order

				record event = on add or edit

				on user input of Sand_Purchase_Order_Details.Quantity_Ordered
				{
					actions 
					{
						custom deluge script
						(
											for each  poRow in input.Sand_Purchase_Order_Details
										{
											if(poRow.Quantity_Ordered != null && poRow.Unit_Of_Measure != null)
											{
												uomName = poRow.Unit_Of_Measure.Unit_Of_Measure_Name;
												if(uomName == "Cubic meters")
												{
													poRow.Quantity_Ordered_to_CBM=poRow.Quantity_Ordered;
												}
												else if(uomName == "Tonnes")
												{
													poRow.Quantity_Ordered_to_CBM=poRow.Quantity_Ordered / 1.6;
												}
												if(poRow.Rate != null)
												{
													poRow.Line_Total=poRow.Quantity_Ordered * poRow.Rate;
												}
												poRow.Quantity_Delivered=ifnull(poRow.Quantity_Delivered,0);
												poRow.Quantity_Remaining=poRow.Quantity_Ordered_to_CBM - poRow.Quantity_Delivered;
											}
										}
						)
					}
				}

			}
			On_Rate_Selected2 as "On Rate Selected"
			{
				type =  form
				form = Customer_Purchase_Order

				record event = on add or edit

				on user input of Sand_Purchase_Order_Details.Rate
				{
					actions 
					{
						custom deluge script
						(
											for each  poRow in input.Sand_Purchase_Order_Details
										{
											if(poRow.Rate != null && poRow.Quantity_Ordered != null)
											{
												// Line Total = Quantity Ordered * Rate
												poRow.Line_Total=poRow.Quantity_Ordered * poRow.Rate;
											}
											else
											{
												// If either is missing, clear the total
												poRow.Line_Total=null;
											}
											// Keep Remaining consistent (optional but useful)
											if(poRow.Quantity_Ordered != null)
											{
												poRow.Quantity_Delivered=ifnull(poRow.Quantity_Delivered,0);
												poRow.Quantity_Remaining=poRow.Quantity_Ordered_to_CBM - poRow.Quantity_Delivered;
											}
										}
						)
					}
				}

			}
			On_Unit_Of_Measure_Select8 as "On Unit Of Measure Selected"
			{
				type =  form
				form = Customer_Purchase_Order

				record event = on add or edit

				on user input of Sand_Purchase_Order_Details.Unit_Of_Measure
				{
					actions 
					{
						custom deluge script
						(
											for each  poRow in input.Sand_Purchase_Order_Details
										{
											if(poRow.Unit_Of_Measure != null && poRow.Quantity_Ordered != null)
											{
												// Because Unit_Of_Measure is a LOOKUP, use its display/name field
												uomName = poRow.Unit_Of_Measure.Unit_Of_Measure_Name;
												// change this if your name field link is different
												// Convert Quantity Ordered to CBM
												if(uomName == "Cubic meters")
												{
													poRow.Quantity_Ordered_to_CBM=poRow.Quantity_Ordered;
												}
												else if(uomName == "Tonnes")
												{
													poRow.Quantity_Ordered_to_CBM=poRow.Quantity_Ordered / 1.6;
												}
												else
												{
													// If other UOM types exist, clear or leave as-is (I suggest clear)
													poRow.Quantity_Ordered_to_CBM=null;
												}
												// Recalculate Line Total if Rate exists
												if(poRow.Rate != null)
												{
													poRow.Line_Total=poRow.Quantity_Ordered * poRow.Rate;
												}
												// Update remaining
												poRow.Quantity_Delivered=ifnull(poRow.Quantity_Delivered,0);
												poRow.Quantity_Remaining=poRow.Quantity_Ordered_to_CBM - poRow.Quantity_Delivered;
											}
										}
						)
					}
				}

			}
			On_Purchase_Order_Number_ as "On Purchase Order Number Selected"
			{
				type =  form
				form = Customer_Purchase_Order

				record event = on add or edit

				on user input of Purchase_Order_Number
				{
					actions 
					{
						custom deluge script
						(
											// When Purchase Order Number changes, copy it into the subform rows
										for each  row in input.Sand_Purchase_Order_Details
										{
											row.Display_Name_Purchase_Order=input.Purchase_Order_Number;
										}
						)
					}
				}

			}
			On_Addition_Of_Row6 as "On Addition Of Row"
			{
				type =  form
				form = Customer_Purchase_Order

				record event = on add or edit

				on add row of Sand_Purchase_Order_Details
				{
					actions 
					{
						custom deluge script
						(
											lineNo = 1;
										for each  poRow in input.Sand_Purchase_Order_Details
										{
											// Auto-fill Display Name Purchase Order
											poRow.Display_Name_Purchase_Order=input.Purchase_Order_Number;
											// Auto-fill Display Name Customer
											poRow.Display_Name_Customer=input.Display_Name_Customer;
											// Auto-fill Line Number
											poRow.Line_Number=lineNo;
											lineNo = lineNo + 1;
										}
						)
					}
				}

			}
			On_Deletion_Of_Row4 as "On Deletion Of Row"
			{
				type =  form
				form = Customer_Purchase_Order

				record event = on add or edit

				on delete row of Sand_Purchase_Order_Details
				{
					actions 
					{
						custom deluge script
						(
											lineNo = 1;
										for each  poRow in input.Sand_Purchase_Order_Details
										{
											// Auto-fill Display Name Purchase Order
											poRow.Display_Name_Purchase_Order=input.Purchase_Order_Number;
											// Auto-fill Line Number
											poRow.Line_Number=lineNo;
											lineNo = lineNo + 1;
										}
						)
					}
				}

			}
