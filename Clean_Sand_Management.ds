			On_Truck_Measurement_Sele as "On Truck Measurement Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Truck_Measurement
				{
					actions 
					{
						custom deluge script
						(
											// Sales Voucher -> On Truck Measurement Selected
										recalculate_totals = false;
										if(input.Truck_Measurement == null)
										{
											if(input.Truck_Size_1 != null || input.Truck_Size_2 != null || input.Truck_CBM != null)
											{
												recalculate_totals = true;
											}
											input.Truck_Size_1 = null;
											input.Truck_Size_2 = null;
											input.Truck_Size = null;
											input.Truck_CBM = null;
										}
										else
										{
											old_size_1 = input.Truck_Size_1;
											old_size_2 = input.Truck_Size_2;
											old_cbm = input.Truck_CBM;
											input.Truck_Size_1 = input.Truck_Measurement.Truck_Size_1;
											input.Truck_Size_2 = input.Truck_Measurement.Truck_Size_2;
											new_cbm = 0.0;
											if(input.Truck_Size == "Truck Size 1")
											{
												new_cbm = ifnull(input.Truck_Size_1,0.0);
											}
											else if(input.Truck_Size == "Truck Size 2")
											{
												new_cbm = ifnull(input.Truck_Size_2,0.0);
											}
											else
											{
												input.Truck_CBM = null;
											}
											if(input.Truck_Size == "Truck Size 1" || input.Truck_Size == "Truck Size 2")
											{
												input.Truck_CBM = round(new_cbm,1);
											}
											if(old_size_1 != input.Truck_Size_1 || old_size_2 != input.Truck_Size_2 || old_cbm != input.Truck_CBM)
											{
												recalculate_totals = true;
											}
										}
										if(recalculate_totals == true)
										{
											input.Sub_Total = round(ifnull(input.Truck_CBM,0.0) * ifnull(input.Rate_per_CBM,0.0),2);
											input.Tax_Amount = ifnull(input.Tax_Amount,0.0);
											if(input.Discount_Type == "None" || input.Discount_Type == null)
											{
												input.Discount_Amount = 0.0;
											}
											input.Grand_Total = round(input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0.0),2);
											if(input.Grand_Total < 0)
											{
												input.Grand_Total = 0.0;
											}
											input.Balance_Due = round(input.Grand_Total - ifnull(input.Amount_Paid,0.0) - ifnull(input.Amount_Credited,0.0),2);
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0.0;
											}
											if(input.Grand_Total <= 0)
											{
												input.Payment_Status = "Unpaid";
											}
											else if(input.Balance_Due <= 0)
											{
												input.Payment_Status = "Paid";
											}
											else if(ifnull(input.Amount_Paid,0.0) + ifnull(input.Amount_Credited,0.0) > 0)
											{
												input.Payment_Status = "Partially Paid";
											}
											else
											{
												input.Payment_Status = "Unpaid";
											}
										}
						)
					}
				}

			}
			On_Truck_Size_Selected as "On Truck Size Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Truck_Size
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// Sales Voucher -> Truck Size On User Input
										// =====================================================
										old_cbm = input.Truck_CBM;
										recalculate_totals = false;
										if(input.Truck_Size == null || input.Truck_Size == "")
										{
											if(input.Truck_CBM != null)
											{
												recalculate_totals = true;
											}
											input.Truck_CBM = null;
										}
										else
										{
											cbm = 0.0;
											if(input.Truck_Size == "Truck Size 1")
											{
												cbm = ifnull(input.Truck_Size_1,0.0);
											}
											else if(input.Truck_Size == "Truck Size 2")
											{
												cbm = ifnull(input.Truck_Size_2,0.0);
											}
											input.Truck_CBM = round(cbm,1);
											if(old_cbm != input.Truck_CBM)
											{
												recalculate_totals = true;
											}
										}
										if(recalculate_totals == true)
										{
											if(input.Truck_CBM != null && input.Truck_CBM > 0 && input.Rate_per_CBM != null && input.Rate_per_CBM > 0)
											{
												initial_payment_val = round(input.Truck_CBM * input.Rate_per_CBM,2);
												input.Initial_Payment = initial_payment_val;
												input.Sub_Total = initial_payment_val;
											}
											else
											{
												input.Initial_Payment = 0.0;
												input.Sub_Total = 0.0;
											}
											input.Tax_Amount = ifnull(input.Tax_Amount,0.0);
											if(input.Discount_Type == "None" || input.Discount_Type == null)
											{
												input.Discount_Amount = 0.0;
											}
											input.Grand_Total = round(input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0.0),2);
											if(input.Grand_Total < 0)
											{
												input.Grand_Total = 0.0;
											}
											input.Balance_Due = round(input.Grand_Total - ifnull(input.Amount_Paid,0.0) - ifnull(input.Amount_Credited,0.0),2);
											if(input.Balance_Due < 0)
											{
												input.Balance_Due = 0.0;
											}
											if(input.Grand_Total <= 0)
											{
												input.Payment_Status = "Unpaid";
											}
											else if(input.Balance_Due <= 0)
											{
												input.Payment_Status = "Paid";
											}
											else if(ifnull(input.Amount_Paid,0.0) + ifnull(input.Amount_Credited,0.0) > 0)
											{
												input.Payment_Status = "Partially Paid";
											}
											else
											{
												input.Payment_Status = "Unpaid";
											}
										}
						)
					}
				}

			}
