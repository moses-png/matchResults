			Full_Validation6 as "Full Validation"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											errors = "";
										// =============================
										// 1) REQUIRED MAIN FIELDS
										// =============================
										if(input.Issued_By == null)
										{
											errors = errors + "\n• Please select Issued By.";
										}
										if(input.Asset == null)
										{
											errors = errors + "\n• Asset is required.";
										}
										if(input.Fuel_Issuing_Time == null)
										{
											errors = errors + "\n• Fuel Issuing Time is required.";
										}
										if(input.Odometer == null)
										{
											errors = errors + "\n• Odometer is required.";
										}
										else if(input.Odometer < 0)
										{
											errors = errors + "\n• Odometer cannot be negative.";
										}
										if(input.Quantity == null)
										{
											errors = errors + "\n• Quantity is required.";
										}
										else if(input.Quantity <= 0)
										{
											errors = errors + "\n• Quantity must be greater than 0.";
										}
										// =============================
										// 3) CONDITIONAL RULES
										// =============================
										if(input.Issued_By == "Vendor")
										{
											if(input.Vendor == null)
											{
												errors = errors + "\n• Please select a Vendor.";
											}
											if(input.Store != null)
											{
												errors = errors + "\n• Store must be empty when Issued By is Vendor.";
											}
											if(input.Item_Issuing_Detail != null)
											{
												errors = errors + "\n• Item Issuing Details must be empty when Issued By is Vendor.";
											}
										}
										else if(input.Issued_By == "Fuel Tank")
										{
											if(input.Store == null)
											{
												errors = errors + "\n• Please select a Store.";
											}
											if(input.Item_Issuing_Detail == null)
											{
												errors = errors + "\n• Please select Item Issuing Details.";
											}
											if(input.Vendor != null)
											{
												errors = errors + "\n• Vendor must be empty when Issued By is Fuel Tank.";
											}
										}
										resp = asset_management.validateAssetMileage(input.Asset.ID,input.Odometer,"Fuel Receiving Voucher",input.ID.toString());
										if(resp.get("ok") != true)
										{
											alert resp.get("message");
											cancel submit;
										}
										// =============================
										// 4) FINAL GATE
										// =============================
										if(errors != "")
										{
											alert "Please fix the following:" + errors;
											cancel submit;
										}
						)
					}
				}

			}
			Finalize2 as "Finalize"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ====================================================
										// 1) Auto-fill Fuel Issuing Time
										// ====================================================
										if(input.ID == null)
										{
											if(input.Fuel_Issuing_Time == null)
											{
												input.Fuel_Issuing_Time = zoho.currenttime;
											}
										}
										// ====================================================
										// 2)Bill Details
										// ====================================================
										account_text = "";
										current_site_text = "";
										description_text = "";
										if(input.Asset != null)
										{
											account_text = ifnull(input.Asset.Asset_Name,"") + " - " + ifnull(input.Asset.Asset_ID,"");
											current_site_text = ifnull(input.Asset.Current_Site,"");
										}
										if(input.Fuel_Issuing_Time != null)
										{
											description_text = input.Fuel_Issuing_Time.toString();
										}
										// ====================================================
										// 3) Create or Update Bill Details
										// ====================================================
										source_text = input.Fuel_Receiving_Voucher + " - Fuel Receiving Voucher";
										existing_bd = Bill_Details[Reference == input.Fuel_Receiving_Voucher && Source == source_text];
										for each  bd in existing_bd
										{
											bd.Source=source_text;
											bd.Reference=input.Fuel_Receiving_Voucher;
											bd.Display_Name_Item="Fuel";
											bd.Details=description_text;
											bd.Quantity=ifnull(input.Quantity,0);
											bd.Rate=ifnull(input.Rate,0);
											bd.Account=account_text;
											bd.Current_Site=current_site_text;
											break;
										}
										if(existing_bd.count() == 0)
										{
											insert into Bill_Details
											[
												Source=source_text
												Reference=input.Fuel_Receiving_Voucher
												Display_Name_Item="Fuel"
												Details=description_text
												Quantity=ifnull(input.Quantity,0)
												Rate=ifnull(input.Rate,0)
												Account=account_text
												Current_Site=current_site_text
												Added_User=zoho.loginuser
											]
										}
										// ====================================================
										// 4) CREATE / UPDATE ASSET MILEAGE LOG IN ASSET MANAGEMENT
										// ====================================================
										if(input.Asset != null && input.Fuel_Issuing_Time != null && input.Odometer != null)
										{
											mileage_resp = asset_management.logMileageFromCleanSand(input.Asset.ID,ifnull(input.Odometer,0.0),input.Fuel_Issuing_Time,ifnull(input.Fuel_Receiving_Voucher,""),"Fuel Receiving Voucher",input.ID.toString());
											info mileage_resp;
										}
										// ====================================================
										// 4) CREATE / UPDATE Totals ASSET MANAGEMENT
										// ====================================================
										if(input.Asset != null)
										{
											//fuel_resp = asset_management.recalculateFuelCosts(input.Asset.ID);
											//info fuel_resp;
											asset_management.asset.refresh_asset_costs(input.Asset.toLong());
										}
										if(input.Asset != null)
										{
											amount_val = 0.0;
											income_val = 0.0;
											expense_val = 0.0;
											issued_by_text = ifnull(input.Issued_By,"");
											supplied_by_text = ifnull(input.Supplied_By,"");
											voucher_text = ifnull(input.Fuel_Receiving_Voucher,"");
											desc_text = "";
											desc_text = desc_text + "Issued By: " + issued_by_text + "\n";
											desc_text = desc_text + "Supplied By: " + supplied_by_text + "\n";
											desc_text = desc_text + "Voucher: " + voucher_text + "\n";
											desc_text = desc_text + "Odometer: " + ifnull(input.Odometer,0.0).toString() + "\n";
											desc_text = desc_text + "Quantity: " + ifnull(input.Quantity,0.0).toString();
											payload = Map();
											payload.put("Transaction_Date",ifnull(input.Fuel_Issuing_Time,zoho.currenttime));
											payload.put("Transaction_Status","Draft");
											payload.put("Transaction_Description",desc_text);
											payload.put("Asset",input.Asset.ID);
											payload.put("Display_Name_Asset",ifnull(input.Display_Name_Asset,""));
											payload.put("Transaction_Direction","Expense");
											payload.put("Amount",amount_val);
											payload.put("Income",income_val);
											payload.put("Expenses",expense_val);
											payload.put("Application","Asset Management");
											payload.put("Source_Form","Fuel Receiving Voucher");
											payload.put("Source_Record_ID",input.ID);
											payload.put("Notes",voucher_text);
											resp = asset_management.createOrUpdateAssetTransactionLog(payload);
											info resp;
										}
						)
					}
				}

			}
			Finalize_On_Delete as "Finalize On Delete"
			{
				type =  form
				form = Fuel_Receiving_Voucher

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ====================================================
										// 1) Delete linked Bill Details
										// ====================================================
										if(input.Fuel_Receiving_Voucher != null && input.Fuel_Receiving_Voucher != "")
										{
											bill_rows = Bill_Details[Source == "Fuel Receiving Voucher" && Reference == input.Fuel_Receiving_Voucher];
											for each  bd in bill_rows
											{
												delete from Bill_Details[ID == bd.ID];
											}
										}
										// ====================================================
										// 2) Delete linked Asset Mileage Log
										// ====================================================
										mile_delete_resp = asset_management.deleteMileageLogFromCleanSand("Fuel Receiving Voucher",input.ID.toString());
										info mile_delete_resp;
										if(input.Asset != null)
										{
											asset_id = input.Asset.toLong();
											asset_management.asset.refresh_asset_costs(asset_id);
										}
						)
					}
				}

			}
			Finalize_On_Create13 as "Finalize On Create"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ITEM ISSUING DETAILS - FINALIZE ON CREATE
										// =====================================================
										// =====================================================
										// 1) AUDIT + DEFAULT RETURNS
										// =====================================================
										u = thisapp.audit.getLoginAuditInfo();
										input.Created_By_Name = u.get("name");
										input.Created_By_Email = u.get("email");
										input.Created_By_Time = zoho.currenttime;
										input.Quantity_Returned = 0.0;
										input.Quantity_Returned_in_Base_Unit_Of_Measure = 0.0;
										// =====================================================
										// 2) NON-ISSUING REQUEST TYPES
										// =====================================================
										if(input.Request_Voucher_Type != "Employee Voucher" && input.Request_Voucher_Type != "Sales Voucher" && input.Request_Voucher_Type != "Internal Transfer")
										{
											input.Status = "Draft";
											if(input.Item != null && input.Unit_Of_Measure != null && input.Quantity != null && input.Quantity > 0)
											{
												base_qty_create = store_management.po.convert_to_base_qty_from_masaka_site_management(input.Item,input.Unit_Of_Measure,input.Quantity);
												if(base_qty_create != null && base_qty_create > 0)
												{
													input.Quantity_in_Base_Unit_Of_Measure = base_qty_create;
													input.Line_Total = (base_qty_create * ifnull(input.Cost,0.0)).round(2);
												}
											}
											info "Created as Draft. Request Type does not issue stock.";
											return;
										}
										// =====================================================
										// 3) REQUIRED FIELD CHECKS
										// =====================================================
										if(input.Issuing_Voucher == null)
										{
											info "Issuing Voucher is required.";
											return;
										}
										if(input.Request_Voucher_Type == "Employee Voucher" && input.Employee_Voucher == null)
										{
											info "Employee Voucher is required.";
											return;
										}
										if(input.Request_Voucher_Type == "Sales Voucher")
										{
											if(input.Sales_Voucher == null)
											{
												info "Sales Voucher is required.";
												return;
											}
											if(input.Item_Taken == null)
											{
												info "Item Taken is required.";
												return;
											}
										}
										if(input.Item == null || input.Unit_Of_Measure == null || input.Quantity == null || input.Quantity <= 0)
										{
											info "Item, Unit of Measure and Quantity are required.";
											return;
										}
										// =====================================================
										// 4) LOAD ISSUING HEADER + STORE
										// =====================================================
										hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
										if(hdr.ID == null || hdr.Store == null)
										{
											info "Header missing or Store missing.";
											return;
										}
										store_id = hdr.Store;
										// =====================================================
										// 5) STOCK CONDITION
										// =====================================================
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = "New";
										}
										// =====================================================
										// 6) REFERENCE NUMBER
										// =====================================================
										ref_no = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim();
										if(ref_no == "")
										{
											ref_no = hdr.ID.toString();
										}
										// =====================================================
										// 7) UOM CHECK + BASE QUANTITY
										// =====================================================
										check = store_management.po.check_uom_conversion_from_masaka_site_management(input.Item,input.Unit_Of_Measure);
										if(check == null || check.get("ok") != true)
										{
											info ifnull(check.get("message"),"UOM conversion failed.");
											return;
										}
										base_qty = store_management.po.convert_to_base_qty_from_masaka_site_management(input.Item,input.Unit_Of_Measure,input.Quantity);
										if(base_qty == null || base_qty <= 0)
										{
											info "Invalid base quantity.";
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure = base_qty;
										// =====================================================
										// 8) LINE TOTAL
										// =====================================================
										line_total_val = (base_qty * ifnull(input.Cost,0.0)).round(2);
										input.Line_Total = line_total_val;
										// =====================================================
										// 9) TOOL CHECK + FINAL STATUS
										// =====================================================
										is_tool_item = false;
										if(input.Item != null && input.Item.Is_Tool == true)
										{
											is_tool_item = true;
										}
										if(is_tool_item == true)
										{
											input.Status = "Borrowed";
										}
										else
										{
											input.Status = "Issued";
											input.Expected_Return_Date = null;
										}
										// =====================================================
										// 10) ISSUE STOCK IN STORE MANAGEMENT
										// =====================================================
										stock_resp = store_management.stock.issue_stock_from_CleanSand(input.Item,store_id,input.Quantity,input.Unit_Of_Measure,cond,line_total_val,ref_no,input.ID);
										info stock_resp;
										if(stock_resp == null || stock_resp.get("ok") != true)
										{
											input.Status = "Draft";
											info "Stock issue failed: " + ifnull(stock_resp.get("message"),"No response from Store Management.");
											return;
										}
										// =====================================================
										// 11) UPDATE STOCK PREVIEW FROM RESPONSE
										// =====================================================
										input.Quantity_in_Base_Unit_Of_Measure = ifnull(stock_resp.get("base_qty"),base_qty);
										input.Store_Available_Stock = ifnull(stock_resp.get("store_stock"),0.0);
										input.Global_Available_Stock = ifnull(stock_resp.get("global_stock"),0.0);
										// =====================================================
										// 12) INTERNAL TRANSFER ONLY
										// =====================================================
										if(input.Request_Voucher_Type == "Internal Transfer")
										{
											transfer_payload = Map();
											transfer_payload.put("Source_Record_ID",input.ID);
											transfer_payload.put("Source_Form","Item Issuing Details");
											transfer_payload.put("Source_Application","Clean Sand Management");
											transfer_payload.put("Transfer_Number",ifnull(input.Item_Issuing_Number,""));
											transfer_payload.put("Transfer_Date",zoho.currentdate);
											transfer_payload.put("Issuing_Store",input.Store);
											transfer_payload.put("Item",input.Item);
											transfer_payload.put("Display_Name_Item",ifnull(input.Display_Name_Item,""));
											transfer_payload.put("Quantity",ifnull(input.Quantity,0.0));
											transfer_payload.put("Unit_Of_Measure",input.Unit_Of_Measure);
											transfer_payload.put("Display_Name_Unit_Of_Measure",ifnull(input.Display_Name_Unit_Of_Measure,""));
											transfer_payload.put("Quantity_in_Base_Unit_Of_Measure",ifnull(input.Quantity_in_Base_Unit_Of_Measure,0.0));
											transfer_payload.put("Issued_By",ifnull(input.Display_Name_Issued_By,""));
											transfer_payload.put("Stock_Condition",cond);
											transfer_payload.put("Unit_Cost",ifnull(input.Cost,0.0));
											transfer_payload.put("Transfer_Status","Not Received");
											transfer_resp = store_management.stock_transfer.create_transfer_from_item_issuing(transfer_payload);
											info transfer_resp;
											if(transfer_resp == null || transfer_resp.get("ok") != true)
											{
												info "Stock was deducted, but Stock Transfer creation failed: " + ifnull(transfer_resp.get("message"),"No response from Store Management.");
												return;
											}
										}
										// =====================================================
										// 12) UPDATE SALES VOUCHER DETAILS ISSUE STATUS
										// =====================================================
										if(input.Request_Voucher_Type == "Sales Voucher" && input.Item_Taken != null)
										{
											svd = Sales_Voucher_Details[ID == input.Item_Taken];
											if(svd.ID != null)
											{
												total_issued_base = 0.0;
												for each  issue in Item_Issuing_Details[Item_Taken == svd.ID]
												{
													total_issued_base = total_issued_base + ifnull(issue.Quantity_in_Base_Unit_Of_Measure,0.0);
												}
												required_base = ifnull(svd.Quantity_in_Base_Unit_Of_Measure,0.0);
												svd.Quantity_Issued_in_Base_Unit_Of_Measure=total_issued_base;
												not_issued_base = required_base - total_issued_base;
												if(not_issued_base < 0)
												{
													not_issued_base = 0.0;
												}
												svd.Quantity_Not_Issued_in_Base_Unit_Of_Measure=not_issued_base;
												if(total_issued_base <= 0)
												{
													svd.Issue_Status="Not Issued";
												}
												else if(total_issued_base >= required_base)
												{
													svd.Issue_Status="Fully Issued";
												}
												else
												{
													svd.Issue_Status="Partially Issued";
												}
											}
										}
										// =====================================================
										// 13) CREATE / UPDATE EMPLOYEE ISSUING DETAILS
										// =====================================================
										source_form_val = "Item Issuing Details";
										if(input.Request_Voucher_Type == "Employee Voucher" && input.Employee_Voucher != null)
										{
											existing_eid = Employee_Issuing_Details[Source_Record_ID == input.ID && Source_Form == source_form_val];
											if(existing_eid.ID != null)
											{
												existing_eid.Voucher=input.Employee_Voucher;
												existing_eid.Display_Name_Voucher=ifnull(input.Request_Voucher,"");
												existing_eid.Line_Number=input.Line_Number;
												existing_eid.Display_Name_Item=ifnull(input.Display_Name_Item,"");
												existing_eid.Quantity=ifnull(input.Quantity,0.0);
												existing_eid.Cost=ifnull(input.Cost,0.0);
												existing_eid.Item_Issuing_Detail=input.ID;
												existing_eid.Source_Record_ID=input.ID;
												existing_eid.Source_Form=source_form_val;
											}
											else
											{
												insert into Employee_Issuing_Details
												[
													Voucher=input.Employee_Voucher
													Display_Name_Voucher=ifnull(input.Request_Voucher,"")
													Line_Number=input.Line_Number
													Display_Name_Item=ifnull(input.Display_Name_Item,"")
													Quantity=ifnull(input.Quantity,0.0)
													Cost=ifnull(input.Cost,0.0)
													Item_Issuing_Detail=input.ID
													Source_Record_ID=input.ID
													Source_Form=source_form_val
													Added_User=zoho.loginuser
												]
											}
										}
										// =====================================================
										// 14) CREATE / UPDATE VOUCHER ISSUING DETAILS
										// =====================================================
										if(input.Issuing_Voucher != null)
										{
											voucher_id = null;
											voucher_display = "";
											iiv = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(iiv.ID != null)
											{
												voucher_id = iiv.Item_Issuing_Voucher;
												voucher_display = ifnull(iiv.Display_Name_Item_Issuing_Voucher,"").trim();
												if(voucher_display == "" && iiv.Item_Issuing_Voucher != null)
												{
													voucher_display = ifnull(iiv.Item_Issuing_Voucher.Voucher_Number,"");
												}
											}
											if(voucher_id != null)
											{
												existing_vid = Voucher_Issuing_Details[Source_Record_ID == input.ID && Source_Form == source_form_val];
												if(existing_vid.ID != null)
												{
													existing_vid.Voucher=voucher_id;
													existing_vid.Display_Name_Voucher=voucher_display;
													existing_vid.Line_Number=input.Line_Number;
													existing_vid.Display_Name_Item=ifnull(input.Display_Name_Item,"");
													existing_vid.Quantity=ifnull(input.Quantity,0.0);
													existing_vid.Cost=ifnull(input.Cost,0.0);
													existing_vid.Item_Issuing_Detail=input.ID;
													existing_vid.Source_Record_ID=input.ID;
													existing_vid.Source_Form=source_form_val;
												}
												else
												{
													insert into Voucher_Issuing_Details
													[
														Voucher=voucher_id
														Display_Name_Voucher=voucher_display
														Line_Number=input.Line_Number
														Display_Name_Item=ifnull(input.Display_Name_Item,"")
														Quantity=ifnull(input.Quantity,0.0)
														Cost=ifnull(input.Cost,0.0)
														Item_Issuing_Detail=input.ID
														Source_Record_ID=input.ID
														Source_Form=source_form_val
														Added_User=zoho.loginuser
													]
												}
											}
										}
										// =====================================================
										// 15) DONE
										// =====================================================
										info "Item Issuing Details finalized on create. Final Status = " + input.Status;
						)
					}
				}

			}
			Finalize_On_Edit13 as "Finalize On Edit"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================================
										// ITEM ISSUING DETAILS - FINALIZE ON EDIT
										// CLEAN SAND MANAGEMENT
										// =====================================================
										// =====================================================
										// 1) LOAD SAVED RECORD
										// =====================================================
										saved_rec = Item_Issuing_Details[ID == input.ID];
										if(saved_rec.ID == null)
										{
											info "Saved Item Issuing Details not found.";
											return;
										}
										saved_status = ifnull(saved_rec.Status,"").trim();
										current_status = ifnull(input.Status,"").trim();
										// =====================================================
										// 2) EDIT AUDIT
										// =====================================================
										u = thisapp.audit.getLoginAuditInfo();
										input.Updated_By_Name = u.get("name");
										input.Updated_By_Email = u.get("email");
										input.Updated_By_Time = zoho.currenttime;
										// =====================================================
										// 3) CANCEL LINE
										// =====================================================
										if(input.Cancel_This_Line_Item == true)
										{
											input.Status = "Cancelled";
											info "Line item cancelled. No stock change.";
											return;
										}
										// =====================================================
										// 4) PRESERVE IMPORTANT FIELDS
										// =====================================================
										if(input.Item == null)
										{
											input.Item = saved_rec.Item;
										}
										if(input.Display_Name_Item == null || input.Display_Name_Item.trim() == "")
										{
											input.Display_Name_Item = saved_rec.Display_Name_Item;
										}
										if(input.Unit_Of_Measure == null)
										{
											input.Unit_Of_Measure = saved_rec.Unit_Of_Measure;
										}
										if(input.Display_Name_Unit_Of_Measure == null || input.Display_Name_Unit_Of_Measure.trim() == "")
										{
											input.Display_Name_Unit_Of_Measure = saved_rec.Display_Name_Unit_Of_Measure;
										}
										if(input.Quantity == null)
										{
											input.Quantity = saved_rec.Quantity;
										}
										if(input.Cost == null)
										{
											input.Cost = ifnull(saved_rec.Cost,0.0);
										}
										if(input.Stock_Condition == null || input.Stock_Condition.trim() == "")
										{
											input.Stock_Condition = ifnull(saved_rec.Stock_Condition,"New");
										}
										if(input.Request_Voucher_Type == null || input.Request_Voucher_Type.trim() == "")
										{
											input.Request_Voucher_Type = ifnull(saved_rec.Request_Voucher_Type,"");
										}
										if(input.Employee_Voucher == null)
										{
											input.Employee_Voucher = saved_rec.Employee_Voucher;
										}
										if(input.Work_Order_Task == null)
										{
											input.Work_Order_Task = saved_rec.Work_Order_Task;
										}
										if(input.Line_Number == null)
										{
											input.Line_Number = saved_rec.Line_Number;
										}
										if(input.Item_Issuing_Number == null || input.Item_Issuing_Number.trim() == "")
										{
											input.Item_Issuing_Number = saved_rec.Item_Issuing_Number;
										}
										if(input.Quantity_Returned == null)
										{
											input.Quantity_Returned = ifnull(saved_rec.Quantity_Returned,0.0);
										}
										if(input.Quantity_Returned_in_Base_Unit_Of_Measure == null)
										{
											input.Quantity_Returned_in_Base_Unit_Of_Measure = ifnull(saved_rec.Quantity_Returned_in_Base_Unit_Of_Measure,0.0);
										}
										// =====================================================
										// 5) NON-EMPLOYEE VOUCHER TYPES
										// =====================================================
										if(input.Request_Voucher_Type != "Employee Voucher")
										{
											if(current_status == "Draft" || current_status == "")
											{
												input.Status = "Approved";
												info "Draft moved to Approved. No stock deducted.";
												return;
											}
											if(current_status == "Approved")
											{
												input.Status = "Issued";
												current_status = "Issued";
											}
											else if(current_status != "Issued")
											{
												info "No activities run. Status is " + current_status;
												return;
											}
											if(input.Issuing_Voucher == null)
											{
												info "Issuing Voucher is required.";
												return;
											}
											if(input.Item == null || input.Unit_Of_Measure == null || input.Quantity == null || input.Quantity <= 0)
											{
												info "Item, Unit of Measure and Quantity are required.";
												return;
											}
											hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
											if(hdr.ID == null || hdr.Store == null)
											{
												info "Header missing or Store missing.";
												return;
											}
											store_id = hdr.Store;
											cond = ifnull(input.Stock_Condition,"New").trim();
											if(cond == "")
											{
												cond = "New";
												input.Stock_Condition = "New";
											}
											check = store_management.po.check_uom_conversion_from_masaka_site_management(input.Item,input.Unit_Of_Measure);
											if(check == null || check.get("ok") != true)
											{
												error_message = "UOM conversion failed.";
												if(check != null)
												{
													error_message = ifnull(check.get("message"),error_message);
												}
												info error_message;
												return;
											}
											base_qty_create = store_management.po.convert_to_base_qty_from_masaka_site_management(input.Item,input.Unit_Of_Measure,input.Quantity);
											if(base_qty_create == null || base_qty_create <= 0)
											{
												info "Invalid base quantity.";
												return;
											}
											input.Quantity_in_Base_Unit_Of_Measure = base_qty_create;
											line_total_val = (base_qty_create * ifnull(input.Cost,0.0)).round(2);
											input.Line_Total = line_total_val;
											if(saved_status == "Approved" && input.Status == "Issued")
											{
												ref_no = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim();
												if(ref_no == "")
												{
													ref_no = hdr.ID.toString();
												}
												stock_resp = store_management.stock.issue_stock_from_CleanSand(input.Item,store_id,input.Quantity,input.Unit_Of_Measure,cond,line_total_val,ref_no,input.ID);
												info stock_resp;
												if(stock_resp == null || stock_resp.get("ok") != true)
												{
													input.Status = saved_status;
													stock_error = "No response from Store Management.";
													if(stock_resp != null)
													{
														stock_error = ifnull(stock_resp.get("message"),stock_error);
													}
													info "Stock issue failed: " + stock_error;
													return;
												}
												input.Quantity_in_Base_Unit_Of_Measure = ifnull(stock_resp.get("base_qty"),base_qty_create);
												input.Store_Available_Stock = ifnull(stock_resp.get("store_stock"),0.0);
												input.Global_Available_Stock = ifnull(stock_resp.get("global_stock"),0.0);
											}
											else
											{
												info "No stock deduction. Stock only deducts when saved status is Approved and final status becomes Issued.";
											}
											// =================================================
											// WORK ORDER TASK - PARTS AND CONSUMABLES
											// =================================================
											if(input.Request_Voucher_Type == "Work Order Task" && input.Work_Order_Task != null)
											{
												qty_selected = ifnull(input.Quantity,0.0);
												qty_base = ifnull(input.Quantity_in_Base_Unit_Of_Measure,0.0);
												base_unit_cost = ifnull(input.Cost,0.0);
												selected_uom_name = ifnull(input.Display_Name_Unit_Of_Measure,"");
												if(qty_base <= 0)
												{
													qty_base = base_qty_create;
													input.Quantity_in_Base_Unit_Of_Measure = qty_base;
												}
												rate_base = base_unit_cost;
												line_total_val = (qty_base * base_unit_cost).round(2);
												input.Line_Total = line_total_val;
												description_txt = "";
												description_txt = description_txt + "Issued By: " + ifnull(input.Display_Name_Issued_By,"");
												description_txt = description_txt + "\nStore: " + ifnull(input.Store,"");
												description_txt = description_txt + "\nItem Issuing Number: " + ifnull(input.Item_Issuing_Number,"");
												description_txt = description_txt + "\nTaken By: " + ifnull(input.Display_Name_Taken_By,"");
												description_txt = description_txt + "\nIssued Quantity: " + qty_selected + " " + selected_uom_name;
												pc_exists = false;
												for each  pc_chk in Parts_Consumables[Source_Record_ID == input.ID && Source_Form == "Item Issuing Details"]
												{
													pc_exists = true;
													pc_chk.Work_Order_Task_Number=input.Work_Order_Task;
													pc_chk.Display_Name_Work_Order_Task_Number=ifnull(input.Work_Order_Task.Work_Order_Task_Number,"");
													pc_chk.Line_Number=input.Line_Number;
													pc_chk.Item=input.Item;
													pc_chk.Display_Name_Item_Labour=ifnull(input.Display_Name_Item,"");
													pc_chk.Description=description_txt;
													pc_chk.Quantity=qty_selected;
													pc_chk.Quantity_In_Base_Unit=qty_base;
													pc_chk.Unit_Of_Measure=selected_uom_name;
													pc_chk.Unit_Cost=base_unit_cost;
													pc_chk.Rate_In_Base_Unit=base_unit_cost;
													pc_chk.Line_Total=line_total_val;
													pc_chk.Item_Issuing_Detail=input.ID;
													pc_chk.Item_Status=input.Status;
													break;
												}
												if(pc_exists == false)
												{
													insert into Parts_Consumables
													[
														Work_Order_Task_Number=input.Work_Order_Task
														Display_Name_Work_Order_Task_Number=ifnull(input.Work_Order_Task.Work_Order_Task_Number,"")
														Line_Number=input.Line_Number
														Item=input.Item
														Display_Name_Item_Labour=ifnull(input.Display_Name_Item,"")
														Description=description_txt
														Quantity=qty_selected
														Quantity_In_Base_Unit=qty_base
														Unit_Of_Measure=selected_uom_name
														Unit_Cost=base_unit_cost
														Rate_In_Base_Unit=base_unit_cost
														Line_Total=line_total_val
														Item_Issuing_Detail=input.ID
														Item_Status=input.Status
														Source_Record_ID=input.ID.toString()
														Source_Form="Item Issuing Details"
														Added_User=zoho.loginuser
													]
												}
											}
											info "Clean Sand non-employee request finalized. Final status = " + input.Status;
											return;
										}
										// =====================================================
										// 6) EMPLOYEE VOUCHER REQUIRED FIELDS
										// =====================================================
										if(input.Issuing_Voucher == null)
										{
											info "Issuing Voucher is required.";
											return;
										}
										if(input.Employee_Voucher == null)
										{
											info "Employee Voucher is required.";
											return;
										}
										if(input.Item == null || input.Unit_Of_Measure == null || input.Quantity == null || input.Quantity <= 0)
										{
											info "Item, Unit of Measure and Quantity are required.";
											return;
										}
										// =====================================================
										// 7) LOAD ISSUING HEADER AND STORE
										// =====================================================
										hdr = Item_Issuing_Voucher[ID == input.Issuing_Voucher];
										if(hdr.ID == null || hdr.Store == null)
										{
											info "Header missing or Store missing.";
											return;
										}
										store_id = hdr.Store;
										// =====================================================
										// 8) STOCK CONDITION
										// =====================================================
										cond = ifnull(input.Stock_Condition,"New").trim();
										if(cond == "")
										{
											cond = "New";
											input.Stock_Condition = "New";
										}
										// =====================================================
										// 9) UOM CHECK AND BASE QUANTITY
										// =====================================================
										check = store_management.po.check_uom_conversion_from_masaka_site_management(input.Item,input.Unit_Of_Measure);
										if(check == null || check.get("ok") != true)
										{
											error_message = "UOM conversion failed.";
											if(check != null)
											{
												error_message = ifnull(check.get("message"),error_message);
											}
											info error_message;
											return;
										}
										base_qty = store_management.po.convert_to_base_qty_from_masaka_site_management(input.Item,input.Unit_Of_Measure,input.Quantity);
										if(base_qty == null || base_qty <= 0)
										{
											info "Invalid base quantity.";
											return;
										}
										input.Quantity_in_Base_Unit_Of_Measure = base_qty;
										// =====================================================
										// 10) LINE TOTAL
										// =====================================================
										line_total_val = (base_qty * ifnull(input.Cost,0.0)).round(2);
										input.Line_Total = line_total_val;
										// =====================================================
										// 11) TOOL CHECK AND FINAL STATUS
										// =====================================================
										is_tool_item = false;
										if(input.Item != null && input.Item.Is_Tool == true)
										{
											is_tool_item = true;
										}
										if(is_tool_item == true)
										{
											if(input.Didn_t_Come_Back == true)
											{
												input.Status = "Out of Service";
												input.Expected_Return_Date = null;
											}
											else
											{
												issued_base = ifnull(input.Quantity_in_Base_Unit_Of_Measure,0.0);
												returned_base = ifnull(input.Quantity_Returned_in_Base_Unit_Of_Measure,0.0);
												if(issued_base > 0 && returned_base >= issued_base)
												{
													input.Status = "Returned";
													input.Expected_Return_Date = null;
												}
												else
												{
													input.Status = "Borrowed";
												}
											}
										}
										else
										{
											input.Status = "Issued";
											input.Expected_Return_Date = null;
										}
										// =====================================================
										// 12) REFERENCE NUMBER
										// =====================================================
										ref_no = ifnull(hdr.Display_Name_Item_Issuing_Voucher,"").trim();
										if(ref_no == "")
										{
											ref_no = hdr.ID.toString();
										}
										// =====================================================
										// 13) ISSUE STOCK IN STORE MANAGEMENT
										// =====================================================
										stock_resp = store_management.stock.issue_stock_from_CleanSand(input.Item,store_id,input.Quantity,input.Unit_Of_Measure,cond,line_total_val,ref_no,input.ID);
										info stock_resp;
										if(stock_resp == null || stock_resp.get("ok") != true)
										{
											input.Status = saved_status;
											stock_error = "No response from Store Management.";
											if(stock_resp != null)
											{
												stock_error = ifnull(stock_resp.get("message"),stock_error);
											}
											info "Stock issue failed: " + stock_error;
											return;
										}
										// =====================================================
										// 14) UPDATE STOCK PREVIEW
										// =====================================================
										input.Quantity_in_Base_Unit_Of_Measure = ifnull(stock_resp.get("base_qty"),base_qty);
										input.Store_Available_Stock = ifnull(stock_resp.get("store_stock"),0.0);
										input.Global_Available_Stock = ifnull(stock_resp.get("global_stock"),0.0);
										// =====================================================
										// 15) LOCAL EMPLOYEE ISSUING DETAILS
										// =====================================================
										if(input.Employee_Voucher != null)
										{
											eid_exists = false;
											for each  e_chk in Employee_Issuing_Details[Source_Record_ID == input.ID && Source_Form == "Item Issuing Details"]
											{
												eid_exists = true;
												e_chk.Voucher=input.Employee_Voucher;
												e_chk.Display_Name_Voucher=ifnull(input.Request_Voucher,"");
												e_chk.Line_Number=input.Line_Number;
												e_chk.Display_Name_Item=ifnull(input.Display_Name_Item,"");
												e_chk.Quantity=ifnull(input.Quantity,0.0);
												e_chk.Cost=ifnull(input.Cost,0.0);
												e_chk.Source_Record_ID=input.ID;
												e_chk.Source_Form="Item Issuing Details";
												break;
											}
											if(eid_exists == false)
											{
												insert into Employee_Issuing_Details
												[
													Voucher=input.Employee_Voucher
													Display_Name_Voucher=ifnull(input.Request_Voucher,"")
													Line_Number=input.Line_Number
													Display_Name_Item=ifnull(input.Display_Name_Item,"")
													Quantity=ifnull(input.Quantity,0.0)
													Cost=ifnull(input.Cost,0.0)
													Source_Record_ID=input.ID
													Source_Form="Item Issuing Details"
													Added_User=zoho.loginuser
												]
											}
										}
										// =====================================================
										// 16) DONE
										// =====================================================
										info "Clean Sand Item Issuing Details finalized on edit. Final status = " + input.Status;
						)
					}
				}

			}
			Set_Up_Form13 as "Set Up Form"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =============================================
										// Item Issuing Details -> Set Up Form
										// =============================================
										// BACK END
										hide Back_End;
										disable User_Name;
										disable User_Email;
										disable User_Role;
										disable Created_By_Name;
										disable Created_By_Email;
										disable Created_By_Time;
										disable Updated_By_Name;
										disable Updated_By_Email;
										disable Updated_By_Time;
										// Logged-in user info only
										u = thisapp.audit.getLoginAuditInfo();
										input.User_Name = u.get("name");
										input.User_Email = u.get("email");
										input.User_Role = u.get("role");
										// =============================================
										// Hide display/helper fields
										// =============================================
										hide Display_Name_Issuing_Voucher;
										hide Display_Name_Item;
										hide Display_Name_Taken_By;
										hide Display_Name_Unit_Of_Measure;
										hide Quantity_Returned;
										hide Quantity_Returned_in_Base_Unit_Of_Measure;
										hide Display_Name_Issued_By;
										hide Status;
										hide Notes;
										hide Status_Details;
										hide Items_Image;
										// =============================================
										// Disable system fields
										// =============================================
										disable Global_Available_Stock;
										disable Store_Available_Stock;
										disable Quantity_in_Base_Unit_Of_Measure;
										disable Item_Issuing_Number;
										disable Line_Total;
										disable Store;
										disable Request_Voucher;
										disable Cost;
										disable Status;
										// =============================================
										// Request source fields
										// =============================================
										req_type = ifnull(input.Request_Voucher_Type,"").trim();
										hide Employee_Voucher;
										hide Work_Order_Task;
										hide Sales_Voucher;
										hide Item_Taken;
										show Item;
										if(req_type == "Employee Voucher")
										{
											show Employee_Voucher;
										}
										else if(req_type == "Work Order Task")
										{
											show Work_Order_Task;
										}
										else if(req_type == "Sales Voucher")
										{
											show Sales_Voucher;
											show Item_Taken;
											show Items_Image;
											hide Item;
											input.Employee_Voucher = null;
											input.Work_Order_Task = null;
										}
										else if(req_type == "Internal Transfer")
										{
											input.Request_Voucher = ifnull(input.Item_Issuing_Number,"");
											input.Employee_Voucher = null;
											input.Work_Order_Task = null;
											input.Sales_Voucher = null;
											input.Item_Taken = null;
										}
										else
										{
											input.Request_Voucher = "";
											input.Employee_Voucher = null;
											input.Work_Order_Task = null;
											input.Sales_Voucher = null;
											input.Item_Taken = null;
										}
										// =============================================
										// Cancel 
										// =============================================
										hide Cancel_This_Line_Item;
										hide Reason_Why_Cancelled;
										hide Didn_t_Come_Back;
										hide Why;
										hide Reason_Why_Didn_t_Come_Back;
										if(input.ID != null)
										{
											show Didn_t_Come_Back;
											show Cancel_This_Line_Item;
											if(input.Cancel_This_Line_Item == true)
											{
												show Reason_Why_Cancelled;
											}
											if(input.Didn_t_Come_Back == true)
											{
												show Why;
												show Reason_Why_Didn_t_Come_Back;
											}
										}
										// =============================================
										// Expected return date
										// =============================================
										hide Expected_Return_Date;
										// =============================================
										// Draft edit lock
										// =============================================
										if(input.ID != null && input.Status == "Draft")
										{
											disable Issuing_Voucher;
											disable Line_Number;
											disable Request_Voucher_Type;
											disable Employee_Voucher;
											disable Work_Order_Task;
											hide Issuing_Voucher;
											hide Store;
											hide Line_Number;
											hide Taken_By;
											hide Didn_t_Come_Back;
											show Cancel_This_Line_Item;
										}
						)
					}
				}

			}
			On_Cancel_This_Line_Item_ as "On Cancel This Line Item Selected"
			{
				type =  form
				form = Item_Issuing_Details

				record event = on add or edit

				on user input of Cancel_This_Line_Item
				{
					actions 
					{
						custom deluge script
						(
											if(input.Cancel_This_Line_Item == true)
										{
											show Reason_Why_Cancelled;
											input.Status = "Cancelled";
										}
										else
										{
											hide Reason_Why_Cancelled;
											input.Reason_Why_Cancelled = "";
										}
						)
					}
				}

			}
