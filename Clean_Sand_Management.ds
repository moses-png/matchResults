				Display_Name_Vendor as "Display Name Vendor"
			)
			group by
			(
				Bill_Name ascending
			)
			sort by
			(
				Bill_Date ascending
				Bill_Number ascending
			)
			conditional formatting
			(
				"Draft Bills"
				{
				condition = (Bill_Status == "Draft")
				fields = [Bill_Date, Bill_Type]
				format = "color:#c516ef;background-color:#ffffff;"
				}
			)
		}
