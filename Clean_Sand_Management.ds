			Add_Row_Product_Details as "Add Row Product Details"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on add row of Product_Details
				{
					actions 
					{
						custom deluge script
						(
											row.Line_Number=input.Product_Details.count();
										if(input.Sales_Voucher_Number != null)
										{
											row.Display_Name_Sales_Voucher=input.Sales_Voucher_Number;
										}
										else
										{
											row.Display_Name_Sales_Voucher="";
										}
										row.Line_Total=0;
										row.Tax_Amount=0;
										row.Quantity_Available=0;
										row.Quantity_in_Base_Unit_Of_Measure=0;
										row.Unit_Price=0;
										row.Display_Name_Item="";
										row.Display_Name_Unit_Of_Measure="";
										row.Display_Name_Base_Unit_Of_Measure="";
										row.Display_Name_Store="";
										row.Quantity=0;
						)
					}
				}

			}
			On_Quantity_Selected1 as "On Quantity Selected"
			{
				type =  form
				form = Sales_Voucher

				record event = on add or edit

				on user input of Product_Details.Quantity
				{
					actions 
					{
						custom deluge script
						(
											if(row.Quantity != null && row.Quantity_Available != null)
										{
											if(row.Quantity > row.Quantity_Available)
											{
												alert "Quantity cannot be greater than Quantity Available.";
												row.Quantity=null;
												row.Quantity_in_Base_Unit_Of_Measure=0;
												row.Quantity_Issued_in_Base_Unit_Of_Measure=0;
												row.Quantity_Not_Issued_in_Base_Unit_Of_Measure=0;
												row.Issue_Status="Not Issued";
												row.Line_Total=0;
												row.Tax_Amount=0;
												return;
											}
										}
										if(row.Item != null && row.Unit_Of_Measure != null && row.Quantity != null)
										{
											base_qty = store_management.uom.convert_to_base_qty(row.Item,row.Unit_Of_Measure.Alternate_Unit_Of_Measure,row.Quantity);
											if(base_qty != null)
											{
												row.Quantity_in_Base_Unit_Of_Measure=base_qty;
											}
											else
											{
												row.Quantity_in_Base_Unit_Of_Measure=row.Quantity * ifnull(row.Unit_Of_Measure.Conversion_Factor,1);
											}
										}
										else
										{
											row.Quantity_in_Base_Unit_Of_Measure=0;
										}
										row.Quantity_Issued_in_Base_Unit_Of_Measure=0.0;
										row.Quantity_Not_Issued_in_Base_Unit_Of_Measure=ifnull(row.Quantity_in_Base_Unit_Of_Measure,0.0);
										row.Issue_Status="Not Issued";
										row.Line_Total=ifnull(row.Quantity,0) * ifnull(row.Unit_Price,0);
										if(row.Tax_Type != null)
										{
											row.Tax_Amount=row.Line_Total * ifnull(row.Tax_Type.Tax_Rate,0) / 100;
										}
										else
										{
											row.Tax_Amount=0;
										}
										sub_total = 0;
										tax_total = 0;
										for each  r in input.Product_Details
										{
											sub_total = sub_total + ifnull(r.Line_Total,0);
											tax_total = tax_total + ifnull(r.Tax_Amount,0);
										}
										input.Sub_Total = sub_total;
										input.Tax_Amount = tax_total;
										input.Grand_Total = input.Sub_Total + input.Tax_Amount - ifnull(input.Discount_Amount,0);
										input.Balance_Due = input.Grand_Total - ifnull(input.Amount_Paid,0) - ifnull(input.Amount_Credited,0);
										//if(input.Balance_Due < 0)
										//{
										//input.Balance_Due = 0;
										//}
						)
					}
				}

			}
